(*!
<summary>Provides workflow node creation, transition validation, topology checks and configuration helpers.</summary>
<description>
Public facade delegating element creation and type description to WorkflowElementFactory, state-transition and
attachment validation to WorkflowElementHelper, and configuration serialization helpers to
WorkflowConfigurationSerializer.
Defines the canonical transition table for WORKFLOW_ELEMENT_STATE. Fresh starts require PASSIVE_READY,
resuming requires PASSIVE_SUSPENDED, and completed, halted, cancelled or failed elements must pass through
ACTIVE_RESETTING before returning to PASSIVE_READY.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM Workflows
VAR CONSTANT
	//! <summary>No activity or branch is selected; never pass this value to a nonnegative index input.</summary>
	//! <description>
	//! SequenceActivity and WaitAndPickActivity expose this DINT sentinel while selection is absent.
	//! </description>
	NO_SELECTED_ACTIVITY_INDEX : DINT := -1;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{84931a7b-3d4a-4632-9cb1-e5d7a8f192b4}" />
    <Property Name="ClassName" Id="{481cf308-45d8-4e8a-9beb-4d74c6f3cadc}">
      <Declaration><![CDATA[(*!
<summary>Returns the program name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d4104013-1803-475d-a0e1-512983ee4a03}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConfigurationTypeName" Id="{e19b9cf7-a009-4705-aacb-39f7d6d97cc6}">
      <Declaration><![CDATA[(*!
<summary>Returns the elementary IEC spelling used in configuration documents.</summary>
<description>String capacities exclude the terminator. Unsupported types raise before writing the value.</description>
*)
METHOD ConfigurationTypeName : STRING
VAR_INPUT
	typeClass : __SYSTEM.TYPE_CLASS;
	size : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ConfigurationTypeName := WorkflowElementFactory.ConfigurationTypeName(
	typeClass := typeClass,
	size := size
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigurationValueType" Id="{b888840e-ea36-4c5a-b4fa-e0d8dd9a7b2a}">
      <Declaration><![CDATA[(*!
<summary>Maps an elementary IEC type class to its CONFIGURATION_VALUE_TYPE enum.</summary>
<description>Unsupported type classes raise a configuration exception.</description>
<param name="typeClass">Type class from __SYSTEM.TYPE_CLASS.</param>
*)
METHOD ConfigurationValueType : TOF_Core.CONFIGURATION_VALUE_TYPE
VAR_INPUT
	typeClass : __SYSTEM.TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ConfigurationValueType := WorkflowElementFactory.ConfigurationValueType(
	typeClass := typeClass
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateElement" Id="{693894bc-56da-47d7-b359-9e37c1dedefe}">
      <Declaration><![CDATA[(*!
<summary>Creates a dynamic workflow element and returns it after ownership registration.</summary>
<description>Requires a live ready workflow in its owning task. Built-in qualified names are handled first, then the
optional application factory. Unknown names raise a configuration exception. A successful element is borrowed
until workflow disposal; configuration and attachment are separate operations. Registration failures propagate
under the RegisterChild cleanup contract. Call outside lifecycle methods and without reentry.</description>
<param name="typeName">Case-sensitive qualified PLC type.</param>
<param name="workflow">Owner of the resulting element.</param>
<param name="factory">Optional application type factory.</param>
*)
METHOD CreateElement : IWorkflowElement
VAR_INPUT
	typeName : STRING(255);
	workflow : IWorkflow;
	factory : IWorkflowElementFactory := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CreateElement := WorkflowElementFactory.CreateElement(
	typeName := typeName,
	workflow := workflow,
	factory := factory
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetValueDescriptor" Id="{4fae6f9f-c8bd-454e-aa6a-dfa4443d6513}">
      <Declaration><![CDATA[(*!
<summary>Borrows an IEC variable as a typed initial element descriptor.</summary>
<description>Keep the source alive and unchanged through DeclareArray. The descriptor carries the exact IEC category
and full storage width. No allocation or ownership transfer occurs.</description>
<param name="value">Live typed PLC variable.</param>
*)
METHOD GetValueDescriptor : __SYSTEM.AnyType
VAR_INPUT
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetValueDescriptor := value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParseTypeDescriptor" Id="{bed09c9b-1f24-4dbb-9ac1-8c3c77270d19}">
      <Declaration><![CDATA[(*!
<summary>Resolves an exact elementary type and storage capacity.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
*)
METHOD ParseTypeDescriptor : __SYSTEM.AnyType
VAR_INPUT
	typeName : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ParseTypeDescriptor := WorkflowElementFactory.ParseTypeDescriptor(typeName := typeName);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetAllowedTransitionNames" Id="{41bf9062-9c5f-4633-8ce3-cbe75b618334}">
      <Declaration><![CDATA[(*!
<summary>Returns a comma-separated list of target states permitted from the given state.</summary>
<description>
Lists targets accepted by ValidateTransition in diagnostic display order.
</description>
<param name="currentState">Current state of the workflow element.</param>
*)
METHOD GetAllowedTransitionNames : STRING(255)
VAR_INPUT
	currentState : WORKFLOW_ELEMENT_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetAllowedTransitionNames := WorkflowElementHelper.GetAllowedTransitionNames(
	currentState := currentState
);]]></ST>
      </Implementation>
    </Method>
