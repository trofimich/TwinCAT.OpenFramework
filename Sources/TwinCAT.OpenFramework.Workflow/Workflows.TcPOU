    <Method Name="ReadConfigurationHeader" Id="{c18d4e92-3a7b-4f60-85c1-92d4e6b8a0f3}">
      <Declaration><![CDATA[(*!
<summary>Reads local variable declarations and the display name for a named workflow object.</summary>
<description>Restores local declarations into scope and reads the 'name' field into target.Name.
Use within one synchronous load.</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration object node.</param>
<param name="target">Named workflow object receiving the restored display name.</param>
<param name="scope">Declaration container receiving local variable declarations.</param>
*)
METHOD ReadConfigurationHeader
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	target : TOF_Core.INamed;
	scope : IDeclaredVariableContainer;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WorkflowConfigurationSerializer.ReadConfigurationHeader(
	reader := reader,
	node := node,
	target := target,
	scope := scope
);]]></ST>
      </Implementation>
    </Method>
