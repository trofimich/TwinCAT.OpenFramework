    <Method Name="ValidateElementAttachment" Id="{39a48f34-ab25-4bc8-a7ce-16ed935b5b85}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Validates a borrowed parent-child link before any graph mutation.</summary>
<description>
Rejects nulls, self or ancestor cycles, a different existing parent, non-ready activity ancestors or children,
and a non-ready owning workflow. A child with a known workflow requires a parent with that same known owner;
an unassociated subtree may inherit its owner after attachment. This prevents hiding associated descendants
inside an unassociated subtree. Configure may reuse a link to this parent; append APIs separately reject any
occupied child slot. Does not detach, transfer ownership or mutate either operand. Caller callbacks and
metadata must obey their single-task, no-reentry and lifetime contracts.
</description>
<param name="parent">Live prospective parent.</param>
<param name="child">Live child candidate whose link is being validated.</param>
*)
METHOD INTERNAL ValidateElementAttachment
VAR_INPUT
	parent : IWorkflowElement;
	child : IWorkflowElement;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WorkflowElementHelper.ValidateElementAttachment(
	parent := parent,
	child := child
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ValidateTransition" Id="{bc368e59-28e8-40f0-ada3-0cec58c2ed3a}">
      <Declaration><![CDATA[(*!
<summary>Reports whether transitioning from currentState to newState is permitted.</summary>
<description>
Does not mutate state or raise exceptions. Callers use this predicate before changing state or validating
external requests.
</description>
<param name="currentState">Current state of the workflow element.</param>
<param name="newState">Requested target state.</param>
*)
METHOD ValidateTransition : BOOL
VAR_INPUT
	currentState : WORKFLOW_ELEMENT_STATE;
	newState : WORKFLOW_ELEMENT_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ValidateTransition := WorkflowElementHelper.ValidateTransition(
	currentState := currentState,
	newState := newState
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteConfigurationHeader" Id="{636274aa-4460-45bb-b93e-ab61e0c5c633}">
      <Declaration><![CDATA[(*!
<summary>Writes qualified type, display name and local declarations for one node.</summary>
<description>Call once per node before writing its configuration fields. Only owned declarations are enumerated.</description>
*)
METHOD WriteConfigurationHeader
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	source : TOF_Core.IObject;
	displayName : WSTRING;
	scope : IDeclaredVariableContainer;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WorkflowConfigurationSerializer.WriteConfigurationHeader(
	writer := writer,
	source := source,
	displayName := displayName,
	scope := scope
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteConfigurationLiteral" Id="{6e4854ec-3314-41e0-a392-502ce654358b}">
      <Declaration><![CDATA[(*!
<summary>Writes the type and value of a configured literal operand.</summary>
<description>The source descriptor is borrowed for this call. Unsupported types raise.</description>
*)
METHOD WriteConfigurationLiteral
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	name : STRING;
	value : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WorkflowConfigurationSerializer.WriteConfigurationLiteral(
	writer := writer,
	name := name,
	value := value
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteConfigurationObject" Id="{b5a855d9-a98e-4518-b7a1-32b28d730a95}">
      <Declaration><![CDATA[(*!
<summary>Writes a nested configuration under the supplied role.</summary>
<description>
The object must implement the serialization interface. Null mandatory objects and unsupported objects raise.
</description>
*)
METHOD WriteConfigurationObject
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	name : STRING;
	source : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WorkflowConfigurationSerializer.WriteConfigurationObject(
	writer := writer,
	name := name,
	source := source
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteDependency" Id="{ba1e2d68-647b-4258-ba55-41eaae9d44b5}">
      <Declaration><![CDATA[(*!
<summary>Writes one embedded configuration or one stable external key.</summary>
<description>
An unspecified binding raises with the node name. Borrowed objects need no serialization interface.
</description>
*)
METHOD WriteDependency
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	role : STRING;
	kind : DEPENDENCY_BINDING_KIND;
	key : STRING;
	dependency : TOF_Core.IObject;
	nodeName : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WorkflowConfigurationSerializer.WriteDependency(
	writer := writer,
	role := role,
	kind := kind,
	key := key,
	dependency := dependency,
	nodeName := nodeName
);]]></ST>
      </Implementation>
    </Method>
