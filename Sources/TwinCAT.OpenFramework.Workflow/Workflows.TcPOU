<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Workflows" Id="{09179207-e85a-4ce9-a60e-213a99d7b743}" SpecialFunc="None">
    <Declaration><![CDATA[(*
