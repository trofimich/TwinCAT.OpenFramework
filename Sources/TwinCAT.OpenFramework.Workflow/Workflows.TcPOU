(*!
<summary>Provides state transition validation and allowed-transition formatting for workflow elements.</summary>
<description>
Defines the canonical transition table for WORKFLOW_ELEMENT_STATE. Fresh starts require PASSIVE_READY,
resuming requires PASSIVE_SUSPENDED, and completed, halted, cancelled or failed elements must pass through
ACTIVE_RESETTING before returning to PASSIVE_READY.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM Workflows
VAR CONSTANT
	//! <summary>No activity or branch is selected; never pass this value to a nonnegative index input.</summary>
	//! <description>
	//! SequenceActivity and WaitAndPickActivity expose this DINT sentinel while selection is absent.
	//! </description>
	NO_SELECTED_ACTIVITY_INDEX : DINT := -1;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{481cf308-45d8-4e8a-9beb-4d74c6f3cadc}">
      <Declaration><![CDATA[(*!
<summary>Returns the program name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d4104013-1803-475d-a0e1-512983ee4a03}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetAllowedTransitionNames" Id="{41bf9062-9c5f-4633-8ce3-cbe75b618334}">
      <Declaration><![CDATA[(*!
<summary>Returns a comma-separated list of target states permitted from the given state.</summary>
<description>
Matches the transitions accepted by ValidateTransition. The newState parameter is retained for signature
compatibility and does not filter the result.
</description>
<param name="currentState">Current state of the workflow element.</param>
<param name="newState">Unused target state parameter retained for compatibility.</param>
*)
METHOD GetAllowedTransitionNames : STRING(255)
VAR_INPUT
	currentState : WORKFLOW_ELEMENT_STATE;
	newState : WORKFLOW_ELEMENT_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE currentState OF
	WORKFLOW_ELEMENT_STATE.PASSIVE_READY: // can be changed to ACTIVE_RUNNING (with RequestStart)
		GetAllowedTransitionNames := TO_STRING(WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING);

	WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED, // can be changed to ACTIVE_RESETTING (with RequestReset)
	WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED, // can be changed to ACTIVE_RESETTING (with RequestReset)
	WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED, // can be changed to ACTIVE_RESETTING (with RequestReset)
	WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED: // can be changed to ACTIVE_RESETTING (with RequestReset)
		GetAllowedTransitionNames := TO_STRING(WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING);

	WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED: // can be changed to ACTIVE_RUNNING (with RequestStart) or ACTIVE_CANCELLING (with RequestCancel)
		GetAllowedTransitionNames := TOF_Core.Strings.Concat255(
			TO_STRING(WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING));

	// Can be changed to PASSIVE_COMPLETED (internally) or ACTIVE_SUSPENDING (RequestSuspend)
	// or ACTIVE_CANCELLING (RequestCancel) or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)
	WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING:
		GetAllowedTransitionNames := TOF_Core.Strings.Concat255(
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED));

	// Can be changed to PASSIVE_CANCELLED (internally) or PASSIVE_COMPLETED (internally)
	// or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)
	WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING:
		GetAllowedTransitionNames := TOF_Core.Strings.Concat255(
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED));

	// Can be changed to PASSIVE_SUSPENDED (internally) or PASSIVE_COMPLETED (internally)
	// or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)
	WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING:
		GetAllowedTransitionNames := TOF_Core.Strings.Concat255(
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED));

	WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING: // can be changed to PASSIVE_READY (internally) or PASSIVE_FAILED (internally)
		GetAllowedTransitionNames := TOF_Core.Strings.Concat255(
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_READY),
			',',
			TO_STRING(WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED));
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{f189a98d-babc-4b35-b814-9f960e872687}">
      <Declaration><![CDATA[(*!
<summary>Returns the library namespace name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7cc74d8e-6055-476f-8cf2-6211037db96f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ValidateTransition" Id="{bc368e59-28e8-40f0-ada3-0cec58c2ed3a}">
      <Declaration><![CDATA[(*!
<summary>Reports whether transitioning from currentState to newState is permitted.</summary>
<description>
Does not mutate state or raise exceptions. Callers use this predicate before changing state or validating
external requests.
</description>
<param name="currentState">Current state of the workflow element.</param>
<param name="newState">Requested target state.</param>
*)
METHOD ValidateTransition : BOOL
VAR_INPUT
	currentState : WORKFLOW_ELEMENT_STATE;
	newState : WORKFLOW_ELEMENT_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE currentState OF
	WORKFLOW_ELEMENT_STATE.PASSIVE_READY: // can be changed to ACTIVE_RUNNING (with RequestStart)
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING;

	WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED, // can be changed to ACTIVE_RESETTING (with RequestReset)
	WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED, // can be changed to ACTIVE_RESETTING (with RequestReset)
	WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED, // can be changed to ACTIVE_RESETTING (with RequestReset)
	WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED: // can be changed to ACTIVE_RESETTING (with RequestReset)
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING;

	WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED: // can be changed to ACTIVE_RUNNING (with RequestStart) or ACTIVE_CANCELLING (with RequestCancel)
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING;

	// Can be changed to PASSIVE_COMPLETED (internally) or ACTIVE_SUSPENDING (RequestSuspend)
	// or ACTIVE_CANCELLING (RequestCancel) or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)
	WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING:
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED;

	// Can be changed to PASSIVE_CANCELLED (internally) or PASSIVE_COMPLETED (internally)
	// or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)
	WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING:
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED;

	// Can be changed to PASSIVE_SUSPENDED (internally) or PASSIVE_COMPLETED (internally)
	// or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)
	WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING:
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED;

	WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING: // can be changed to PASSIVE_READY (internally) or PASSIVE_FAILED (internally)
		ValidateTransition := newState = WORKFLOW_ELEMENT_STATE.PASSIVE_READY
			OR_ELSE newState = WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ValidateElementAttachment" Id="{39a48f34-ab25-4bc8-a7ce-16ed935b5b85}">
      <Declaration><![CDATA[(*!
<summary>Validates a borrowed parent-child link before any graph mutation.</summary>
<description>
Rejects nulls, self or ancestor cycles, a different existing parent, non-ready activity ancestors or children,
and a non-ready owning workflow. A child with a known workflow requires a parent with that same known owner;
an unassociated subtree may inherit its owner after attachment. This prevents hiding associated descendants
inside an unassociated subtree. Configure may reuse a link to this parent; append APIs separately reject any
occupied child slot. Does not detach, transfer ownership or mutate either operand. Caller callbacks and
metadata must obey their single-task, no-reentry and lifetime contracts.
</description>
<param name="parent">Live prospective parent.</param>
<param name="child">Live child candidate whose link is being validated.</param>
*)
METHOD INTERNAL ValidateElementAttachment
VAR_INPUT
	parent : IWorkflowElement;
	child : IWorkflowElement;
END_VAR
VAR
	ancestor : IWorkflowElement;
	ancestorActivity : IActivity;
	childActivity : IActivity;
	parentWorkflow : IWorkflow;
	childWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF parent = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'parent'
	);
END_IF

IF child = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'child'
	);
END_IF

ancestor := parent;

WHILE ancestor <> 0 DO

	IF ancestor.SelfAddress = child.SelfAddress THEN
		WorkflowExceptions.ThrowWorkflowAttachment(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Cannot attach an element to itself or its descendant"
		);
	END_IF

	IF __QUERYINTERFACE(ancestor, ancestorActivity)
		AND_THEN ancestorActivity.State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY
	THEN
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Cannot change a workflow tree outside PASSIVE_READY"
		);
	END_IF

	ancestor := ancestor.Parent;
END_WHILE

IF child.Parent <> 0 AND_THEN child.Parent.SelfAddress <> parent.SelfAddress THEN
	WorkflowExceptions.ThrowWorkflowAttachment(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Child element is already attached to another parent"
	);
END_IF

IF __QUERYINTERFACE(child, childActivity)
	AND_THEN childActivity.State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Only a PASSIVE_READY child can be attached"
	);
END_IF

parentWorkflow := parent.Workflow;
childWorkflow := child.Workflow;

IF parentWorkflow <> 0 AND_THEN parentWorkflow.State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot configure elements while their workflow is not PASSIVE_READY"
	);
END_IF

IF childWorkflow <> 0 THEN

	IF parentWorkflow = 0 OR_ELSE childWorkflow.SelfAddress <> parentWorkflow.SelfAddress THEN
		WorkflowExceptions.ThrowWorkflowAttachment(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "An associated child requires a parent from the same workflow"
		);
	END_IF

	IF childWorkflow.RootActivity <> 0
		AND_THEN childWorkflow.RootActivity.SelfAddress = child.SelfAddress
	THEN
		WorkflowExceptions.ThrowWorkflowAttachment(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "A workflow root cannot be attached as a child"
		);
	END_IF

END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>