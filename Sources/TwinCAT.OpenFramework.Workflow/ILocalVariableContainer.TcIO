(*!
<summary>Exposes direct bindings separately from hierarchical variable resolution.</summary>
<description>
Optional capability for custom workflow elements that participate in lexical condition evaluation.
Standard Activity and Condition implement it. Without this capability, an element retains its opaque
TryGetVariable policy as a fallback after all discoverable local scopes and before workflow fallback.
Activity/Condition descendants with custom bindings must override TryGetLocalVariable to expose those
bindings; overriding only their hierarchical TryGetVariable does not change direct-scope lookup.
</description>
*)
INTERFACE ILocalVariableContainer EXTENDS TOF_Core.IObject]]></Declaration>
    <Method Name="TryGetLocalVariable" Id="{9fc8cb73-81ba-43d9-b560-511d4eb81e8c}">
      <Declaration><![CDATA[(*!
<summary>Attempts to find a binding registered directly on this instance.</summary>
<description>
Does not inspect parents or workflow fallback. Returns a borrowed descriptor only on TRUE.
Returns FALSE for absence, callback exceptions or terminal allocation failure without clearing the fatal latch.
The owner keeps the registered PLC storage alive; use one task without concurrent reconfiguration.
</description>
<param name="name">Case-sensitive name registered directly on this instance.</param>
<param name="variable">Borrowed binding descriptor, usable only on TRUE.</param>
*)
METHOD TryGetLocalVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
