(*!
<summary>Exposes compiler-initialized namespace storage to library objects.</summary>
<description>
The internal extractor supplies the namespace of this library. Returned references borrow program-owned
storage while the provider is live and must not be modified. Reacquire them after reinitialization or
relocation. No lazy initialization or allocation occurs.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM INTERNAL CurrentNamespace
VAR
	{attribute 'hide'} 
	_NamespaceExtractor : NamespaceExtractor;

	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Name" Id="{7cbbb419-2ca8-4daf-a0f2-920d8419554e}">
      <Declaration><![CDATA[(*!
<summary>Borrows the library namespace string.</summary>
<description>
Storage belongs to the internal program. Callers must not mutate it or retain it across application unloading.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Name : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{50d77bfb-1d4f-44a3-b3a6-73039375ff9c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name REF= _NamespaceExtractor.CurrentNamespace;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{2ebd4d8d-68eb-4b0a-bcb4-ec3e1a8d2258}">
      <Declaration><![CDATA[(*!
<summary>Borrows the diagnostic name of this internal program.</summary>
<description>
Returns program-owned read-only storage; does not initialize or allocate another object.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bdc41251-97be-4ace-ac04-b0895b8868ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f68b9c38-865d-4cff-97ec-b1dccffff72b}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized namespace of this library.</summary>
<description>
Returns the same storage as Name without recursion or ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{20a98e82-9c34-46f2-8ac9-0eae5731c9d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceExtractor.CurrentNamespace;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>