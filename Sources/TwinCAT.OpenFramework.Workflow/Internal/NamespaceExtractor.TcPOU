(*!
<summary>Receives this library namespace from the TwinCAT compiler.</summary>
<description>
The init_namespace attribute initializes CurrentNamespace before ordinary library calls. This passive
internal helper performs no cyclic work and owns no dynamic resources. Its namespace output is read-only
by contract and remains valid while the containing instance is alive.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK INTERNAL NamespaceExtractor
VAR_OUTPUT
	//! <summary>Compiler-initialized namespace; callers borrow this storage without modifying it.</summary>
	{attribute 'init_namespace'} 
	CurrentNamespace : STRING; 	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>