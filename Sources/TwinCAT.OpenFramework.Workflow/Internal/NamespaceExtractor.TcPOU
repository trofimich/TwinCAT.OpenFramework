<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="NamespaceExtractor" Id="{24cd2545-f1b6-4072-926d-c02c3a970344}" SpecialFunc="None">
    <Declaration><![CDATA[(*
