(*!
<summary>Reports the outcome of a single running step in Activity.OnRunning.</summary>
<description>
WORK_IN_PROGRESS keeps the activity in ACTIVE_RUNNING for subsequent Execute calls.
WORK_COMPLETED transitions the activity to PASSIVE_COMPLETED.
WORK_HALTED transitions the activity to PASSIVE_HALTED and requires a non-whitespace haltReason output.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE ACTIVITY_RUNNING_STATE :
(
	WORK_IN_PROGRESS := 0,
	WORK_COMPLETED,
	WORK_HALTED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>