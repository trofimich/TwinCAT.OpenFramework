(*!
<summary>Defines the completion policy for parallel composite activities.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE PARALLEL_JOIN_MODE :
(
	//! <summary>All parallel branches must reach PASSIVE_COMPLETED before the parallel activity completes.</summary>
	WAIT_ALL := 0,
	//!<summary>
	//! The first branch to reach PASSIVE_COMPLETED completes the parallel activity and cancels all other active
	//! branches.
	//! </summary>
	WAIT_ANY := 1
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
