(*!
<summary>Defines relational and equality comparison operators for workflow conditions.</summary>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE COMPARISON_OPERATOR :
(
	EQUAL := 0,
	NOT_EQUAL := 1,
	LESS_THAN := 2,
	LESS_THAN_OR_EQUAL := 3,
	GREATER_THAN := 4,
	GREATER_THAN_OR_EQUAL := 5
) BYTE;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
