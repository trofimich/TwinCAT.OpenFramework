(*!
<summary>Reports the outcome of a single stopping step in Activity.OnStopping during suspend or cancel.</summary>
<description>
WORK_IN_PROGRESS keeps the activity in ACTIVE_SUSPENDING or ACTIVE_CANCELLING for subsequent Execute calls.
WORK_STOPPED transitions the activity to PASSIVE_SUSPENDED or PASSIVE_CANCELLED according to the active request.
WORK_COMPLETED transitions the activity to PASSIVE_COMPLETED when work finishes while stopping.
WORK_HALTED transitions the activity to PASSIVE_HALTED and requires a non-whitespace haltReason output.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE ACTIVITY_STOPPING_STATE :
(
	WORK_IN_PROGRESS := 0,
	WORK_STOPPED,
	WORK_COMPLETED,
	WORK_HALTED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>