<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="WORKFLOW_ELEMENT_STATE" Id="{745c9025-8e53-49e0-b61d-0b4a6781230d}">
    <Declaration><![CDATA[(*
