<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="WORKFLOW_ELEMENT_STATE" Id="{745c9025-8e53-49e0-b61d-0b4a6781230d}">
    <Declaration><![CDATA[//!<param name="PASSIVE_INITIAL">initial state, can be changed to ACTIVE_RUNNING (with RequestStart)</param>

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE WORKFLOW_ELEMENT_STATE :
(
	PASSIVE_INITIAL := 0, 
	PASSIVE_COMPLETED, (*!<description>work completed, can be changed to ACTIVE_RUNNING (with RequestStart)</description>*)
	PASSIVE_HALTED, (*!<description>work halted by internal logic, can be switched to ACTIVE_RUNNING (with RequestStart)</description>*)
	PASSIVE_CANCELLED, (*!<description>work cancelled by external command, can be changed to ACTIVE_RUNNING (with RequestStart)</description>*)
	PASSIVE_FAILED, (*!<description>error cccured in active state, can be changed to ACTIVE_RUNNING (with RequestStart)</description>*)
	PASSIVE_SUSPENDED, (*!<description>work suspended for further resuming, can be changed to ACTIVE_RUNNING (with RequestResume)</description>*)

	ACTIVE_RUNNING, (*!<description>normal work, can be changed to PASSIVE_COMPLETED (internally) or ACTIVE_SUSPENDING (RequestSuspend) or ACTIVE_CANCELLING (RequestCancel) or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)</description>*)
	ACTIVE_CANCELLING,	(*!<description>cancelling process, can be changed to PASSIVE_CANCELLED (internally) or PASSIVE_COMPLETED (internally) or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)</description>*)
	ACTIVE_SUSPENDING (*!<description>suspendng process, can be changed to PASSIVE_SUSPENDED (internally) or PASSIVE_COMPLETED (internally) or PASSIVE_HALTED (internally) or PASSIVE_FAILED (internally)</description>*)
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>