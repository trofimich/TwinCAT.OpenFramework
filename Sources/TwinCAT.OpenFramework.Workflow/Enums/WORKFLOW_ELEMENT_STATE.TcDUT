(*!
<summary>Defines passive and active lifecycle states of a workflow element.</summary>
<description>
PASSIVE_READY is the initial and post-reset state ready for a fresh start via RequestStart.
PASSIVE_COMPLETED, PASSIVE_HALTED, PASSIVE_CANCELLED and PASSIVE_FAILED represent finished runs whose diagnostics remain available until RequestReset initiates ACTIVE_RESETTING.
PASSIVE_SUSPENDED represents a paused run that can be resumed via RequestStart or cancelled via RequestCancel.
ACTIVE_RUNNING, ACTIVE_CANCELLING, ACTIVE_SUSPENDING and ACTIVE_RESETTING are active states advanced by cyclic Execute calls while Busy is TRUE.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE WORKFLOW_ELEMENT_STATE :
(
	PASSIVE_READY := 0, (*!<description>Ready for a fresh start via RequestStart.</description>*)
	PASSIVE_COMPLETED, (*!<description>Work completed; transitions to ACTIVE_RESETTING via RequestReset.</description>*)
	PASSIVE_HALTED, (*!<description>Work halted by internal logic; transitions to ACTIVE_RESETTING via RequestReset.</description>*)
	PASSIVE_CANCELLED, (*!<description>Work cancelled by external command; transitions to ACTIVE_RESETTING via RequestReset.</description>*)
	PASSIVE_FAILED, (*!<description>Error occurred during execution; transitions to ACTIVE_RESETTING via RequestReset.</description>*)
	PASSIVE_SUSPENDED, (*!<description>Work suspended; transitions to ACTIVE_RUNNING via RequestStart or ACTIVE_CANCELLING via RequestCancel.</description>*)

	ACTIVE_RUNNING, (*!<description>Normal execution; transitions to PASSIVE_COMPLETED, PASSIVE_HALTED, PASSIVE_FAILED, ACTIVE_SUSPENDING or ACTIVE_CANCELLING.</description>*)
	ACTIVE_CANCELLING, (*!<description>Cancellation in progress; transitions to PASSIVE_CANCELLED, PASSIVE_COMPLETED, PASSIVE_HALTED or PASSIVE_FAILED.</description>*)
	ACTIVE_SUSPENDING, (*!<description>Suspension in progress; transitions to PASSIVE_SUSPENDED, PASSIVE_COMPLETED, PASSIVE_HALTED or PASSIVE_FAILED.</description>*)
	ACTIVE_RESETTING (*!<description>Resetting in progress; transitions to PASSIVE_READY or PASSIVE_FAILED.</description>*)
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>