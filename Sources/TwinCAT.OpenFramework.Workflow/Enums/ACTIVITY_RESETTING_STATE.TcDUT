<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ACTIVITY_RESETTING_STATE" Id="{45c6b6ea-37c2-4989-9311-5693c5f83e7c}">
    <Declaration><![CDATA[(*
