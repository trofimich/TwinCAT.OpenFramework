(*!
<summary>Reports the outcome of a single resetting step in Activity.OnResetting.</summary>
<description>
WORK_IN_PROGRESS keeps the activity in ACTIVE_RESETTING so subsequent Execute calls continue resetting.
WORK_RESET completes resetting, clears stored run diagnostics and transitions the activity to PASSIVE_READY.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE ACTIVITY_RESETTING_STATE :
(
	WORK_IN_PROGRESS := 0,
	WORK_RESET
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
