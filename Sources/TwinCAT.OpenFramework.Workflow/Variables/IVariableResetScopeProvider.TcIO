(*!
<summary>Provides an embedded variable reset scope for child condition attachment.</summary>
*)
{attribute 'hide'}
INTERFACE IVariableResetScopeProvider EXTENDS TOF_Core.IObject]]></Declaration>
    <Method Name="GetResetScope" Id="{ccb26761-efc3-472a-affa-9a148448d3a5}">
      <Declaration><![CDATA[(*!
<summary>Borrows the variable reset scope embedded in this parent for condition attachment.</summary>
<description>Returns live storage for the lifetime of the parent. Used by the validated parent setter
in its owning task. The caller must not delete, copy or independently reconfigure the scope.</description>
*)
METHOD GetResetScope : IVariableResetScope]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
