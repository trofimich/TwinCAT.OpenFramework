(*
Tracks an activity or condition and its attached condition scopes for reset.

Embedded instances have stable addresses, are non-copyable and operate in one owning task.
The owner supplies its local dictionary after the first declaration. Links borrow scopes and never own nodes.
Activity children reset independently through their lifecycle.
*)

{attribute 'hide'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK INTERNAL VariableResetScope EXTENDS TOF_Core.Object IMPLEMENTS IVariableResetScope
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Bindings : TOF_Collections.IDictionary;
	_Parent : POINTER TO VariableResetScope;
	_FirstChild : POINTER TO VariableResetScope;
	_NextSibling : POINTER TO VariableResetScope;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{3a817429-0fa1-41b2-bf58-9a3b2167fa91}" />
    <Method Name="Attach" Id="{65b08852-57e4-4804-94a7-972de15e34a0}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Links a validated fresh child to its immediate condition-reset owner.

Caller enforces fresh, acyclic parentage. A missing parent scope raises before mutation.
Linking allocates no memory.
parent — Live standard activity or condition reset scope interface.
*)
METHOD INTERNAL Attach
VAR_INPUT
	parent : IVariableResetScope;
END_VAR
VAR
	parentScope : POINTER TO VariableResetScope;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF parent = 0 OR_ELSE NOT __QUERYPOINTER(parent, parentScope) OR_ELSE parentScope = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := CurrentNamespace.Name,
		sourceClassName := _ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'parent'
	);
END_IF

_Parent := parentScope;
_NextSibling := parentScope^._FirstChild;
parentScope^._FirstChild := THIS;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{8a4e2c19-3f7b-4d60-91e2-54b8d3c6a0f2}">
      <Declaration><![CDATA[(* Borrows the initialized class name used in diagnostics. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9b5f3d20-4a8c-4e71-82f3-65c9e4d7b1a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{d1c0790d-9d88-4b98-ac4d-f4e6b2792854}">
      <Declaration><![CDATA[(*
Unlinks this scope and its direct children before their storage can be reclaimed.

Either destruction order is supported. Does not access binding storage or invoke callbacks.
bInCopyCode — TwinCAT online change indicator.
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
END_VAR
VAR
	previous : POINTER TO VariableResetScope;
	child : POINTER TO VariableResetScope;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bInCopyCode THEN
	RETURN;
END_IF

IF _Parent <> 0 THEN
	IF _Parent^._FirstChild = THIS THEN
		_Parent^._FirstChild := _NextSibling;
	ELSE
		previous := _Parent^._FirstChild;

		WHILE previous <> 0 AND_THEN previous^._NextSibling <> THIS DO
			previous := previous^._NextSibling;
		END_WHILE

		IF previous <> 0 THEN
			previous^._NextSibling := _NextSibling;
		END_IF
	END_IF
END_IF

WHILE _FirstChild <> 0 DO
	child := _FirstChild;
	_FirstChild := child^._NextSibling;
	child^._Parent := 0;
	child^._NextSibling := 0;
END_WHILE

_Parent := 0;
_NextSibling := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{1d7b5f42-6c0e-4a93-84b5-87e1a6f9d3c5}">
      <Declaration><![CDATA[(* Borrows the compiler-initialized library namespace. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2e8c6a53-7d1f-4b04-95c6-98f2b7a0e4d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Restore" Id="{4e5dba4e-5abd-410e-8610-f9cd0a188ec9}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Restores declarations in this scope and all condition scopes below it.

Iterates stable owner links in one task. Does not visit siblings of the starting scope.
No callbacks, allocations or activity-state transitions are needed.
*)
METHOD INTERNAL Restore
VAR
	current : POINTER TO VariableResetScope;
	i : DINT;
	entry : REFERENCE TO TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[current := THIS;

REPEAT
	IF current^._Bindings <> 0 THEN
		FOR i := 0 TO current^._Bindings.Length - 1 DO
			entry REF= current^._Bindings.GetKeyValuePairByIndex(index := i);

			IF entry.Value.IsMemoryOwner THEN
				Tc2_System.MEMCPY(
					destAddr := entry.Value.Address,
					srcAddr := entry.Value.Address + TO_UDINT(entry.Value.Size),
					n := TO_UDINT(entry.Value.Size)
				);
			END_IF
		END_FOR
	END_IF

	IF current^._FirstChild <> 0 THEN
		current := current^._FirstChild;
	ELSE
		WHILE current <> THIS AND_THEN current^._NextSibling = 0 DO
			current := current^._Parent;
		END_WHILE

		IF current = THIS THEN
			RETURN;
		END_IF

		current := current^._NextSibling;
	END_IF
UNTIL FALSE
END_REPEAT]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBindings" Id="{849926ad-8ea6-415c-8f8c-c655eb32e247}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Sets the borrowed binding store of this scope.
bindings — Borrowed binding store, available after variable declaration.
*)
METHOD INTERNAL SetBindings
VAR_INPUT
	bindings : TOF_Collections.IDictionary;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Bindings := bindings;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{3f9d7b64-8e2a-4c15-86d7-09a3c8b1f5e7}">
      <Declaration><![CDATA[(* Reports the size of this function block instance in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4a0e8c75-9f3b-4d26-97e8-10b4d9c2a6f8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
