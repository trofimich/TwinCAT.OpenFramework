<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="VariableScope" Id="{c84e29a1-7b3d-4f60-92e1-53a8d4c6b2f0}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Encapsulates local PLC variable bindings and owned variable declarations for a workflow scope.

Manages the per-scope dictionary of borrowed PLC references and owned scalar/array declarations with reset images.
Instances own dynamic dictionary storage, are non-copyable, and must be used within a single task.
*)

{attribute 'hide'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK INTERNAL VariableScope
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Variables : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{88b71d49-47c0-482a-a9e1-253198de7422}" />
    <Property Name="Bindings" Id="{1f8c4a29-3e7b-4d50-8a61-92c4e6b8d0f1}">
      <Declaration><![CDATA[(* Borrows the underlying dictionary of variable bindings and declarations. *)
{attribute 'monitoring' := 'call'}
PROPERTY Bindings : TOF_Collections.IDictionary]]></Declaration>
      <Get Name="Get" Id="{2a9d5b30-4f8c-4e61-9b72-03d5f7c9e1a2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Bindings := _Variables;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{3b0e6c41-5a9d-4f72-8c83-14e6a8d0f2b3}">
      <Declaration><![CDATA[(* Returns the function block name for diagnostic reporting. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4c1f7d52-6b0e-4a83-9d94-25f7b9e1a3c4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{5d2a8e63-7c1f-4b94-8e05-36a8c0f2b4d5}">
      <Declaration><![CDATA[(* Removes all registered bindings and owned variable declarations from this scope. *)
METHOD Clear]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Variables.Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopyInitialElement" Id="{6e3b9f74-8d2a-4c05-9f16-47b9d1a3c5e6}">
      <Declaration><![CDATA[(*
Copies one initial element into caller-owned storage.

Reads the reset image even after the live value changes. The writable destination must have the exact
IEC type and storage size of the element. Invalid names, indices and incompatible destinations raise before copying.
name — Local declaration name.
index — Zero-based element index, zero for a scalar.
destination — Writable live PLC variable of the declared element type and size.
*)
METHOD CopyInitialElement
VAR_INPUT
	name : STRING;
	index : DINT;
	destination : __SYSTEM.AnyType;
END_VAR
VAR
	address : POINTER TO BYTE;
	declaration : VARIABLE_DECLARATION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[address := getElementAddress(
	name := name,
	index := index,
	initial := TRUE,
	declaration => declaration
);

IF destination.pValue = 0
	OR_ELSE destination.TypeClass <> declaration.ElementType
	OR_ELSE destination.diSize <> TO_DINT(declaration.ElementSize)
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Initial value destination type or storage size does not match"
	);
END_IF

Tc2_System.MEMCPY(destAddr := destination.pValue, srcAddr := address, n := declaration.ElementSize);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeclareArray" Id="{7f4c0a85-9e3b-4d16-8a27-58c0e2b4d6f7}">
      <Declaration><![CDATA[(*
Declares a nonempty one-dimensional array of elementary IEC values in this scope.
name — Unique local binding name.
initialValues — Typed initial element descriptors from Workflows.GetValueDescriptor.
elementCount — Number of readable contiguous descriptors.
busy — Whether configuration is currently disallowed.
*)
METHOD DeclareArray
VAR_INPUT
	name : STRING;
	initialValues : POINTER TO __SYSTEM.AnyType;
	elementCount : DINT;
	busy : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[declareLocalVariable(
	busy := busy,
	name := name,
	isArray := TRUE,
	initialValues := initialValues,
	elementCount := elementCount
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeclareConfigurationVariable" Id="{8a5d1b96-0f4c-4e27-9b38-69d1f3c5e7a8}">
      <Declaration><![CDATA[(*
Stores one decoded declaration with live bytes, reset image and original IEC shape.

Pass elementCount = 0 for a scalar variable, or a positive count for an array.
Validates inputs before allocation. Stored layout contains live payload, reset image and metadata trailer.
Exceptions release untransferred storage.
busy — Whether configuration is disallowed.
name — Unique local name.
typeName — Elementary IEC type name.
initialData — Contiguous readable decoded bytes.
elementCount — 0 for a scalar variable, or positive count for an array.
*)
METHOD DeclareConfigurationVariable
VAR_INPUT
	busy : BOOL;
	name : STRING;
	typeName : STRING;
	initialData : PVOID;
	elementCount : DINT;
END_VAR
VAR
	key : TOF_Core.GENERIC_VALUE;
	value : TOF_Core.GENERIC_VALUE;
	category : TOF_Core.GENERIC_TYPE_CLASS;
	supported : BOOL;
	describedType : __SYSTEM.AnyType;
	declaration : VARIABLE_DECLARATION;
	payloadSize : ULINT;
	allocationSize : ULINT;
	storage : POINTER TO BYTE;
	size : UDINT;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

IF busy OR_ELSE name = '' OR_ELSE _Variables.GetKeyPosition(key := name) >= 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot declare a variable in a busy scope or with an empty or duplicate name"
	);
END_IF

IF elementCount < 0 OR_ELSE initialData = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "A declaration requires valid initial data and nonnegative element count"
	);
END_IF

describedType := WorkflowElementFactory.ParseTypeDescriptor(typeName := typeName);
supported := TOF_Core.GenericTypeClassConvertor.TryGetGenericTypeClassBySystemTypeClass(
	typeClass := describedType.TypeClass,
	dataSize := describedType.diSize,
	genericTypeClass => category
);

IF NOT supported
	OR_ELSE category = TOF_Core.GENERIC_TYPE_CLASS.UNSPECIFIED
	OR_ELSE category = TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED
	OR_ELSE category = TOF_Core.GENERIC_TYPE_CLASS.POINTER_TO
	OR_ELSE describedType.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_ENUM
	OR_ELSE describedType.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_SUBRANGE
	OR_ELSE describedType.diSize <= 0
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "A declaration requires an elementary IEC element type"
	);
END_IF

declaration.ElementType := describedType.TypeClass;
declaration.ElementSize := TO_UDINT(describedType.diSize);

IF elementCount = 0 THEN
	declaration.IsArray := FALSE;
	declaration.ElementCount := 1;
ELSE
	declaration.IsArray := TRUE;
	declaration.ElementCount := elementCount;
END_IF

payloadSize := TO_ULINT(declaration.ElementSize) * TO_ULINT(declaration.ElementCount);
// Two payload regions precede an unaligned metadata trailer, always accessed with MEMCPY.
allocationSize := payloadSize * ULINT#2 + XSIZEOF(declaration);

IF allocationSize > TO_ULINT(TOF_Core.UnsignedInt32.MAX_VALUE) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Declared variable exceeds the allocation size limit"
	);
END_IF

size := TO_UDINT(payloadSize);
key := TOF_Core.GenericValueFactory.FromStringValue(value := name);

__TRY
	storage := __NEW(BYTE, TO_UDINT(allocationSize));

	IF storage = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	// This private entry describes a compound allocation, including its reset image and declaration.
	value := TOF_Core.GenericValueFactory.FromParts(
		genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED,
		address := storage,
		size := size,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
	);

	Tc2_System.MEMCPY(
		destAddr := storage,
		srcAddr := initialData,
		n := size
	);

	Tc2_System.MEMCPY(destAddr := storage + size, srcAddr := storage, n := size);
	Tc2_System.MEMCPY(destAddr := storage + size + size, srcAddr := ADR(declaration), n := SIZEOF(declaration));
	_Variables.SetGeneric(key := key, value := value);
	key.Reset();
	value.Reset();
__CATCH(exceptionCode)
	value.Release();
	key.Release();

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="declareLocalVariable" Id="{9b6e2c07-1a5d-4f38-8c49-70e2a4d6f8b9}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Stores one local declaration with live bytes, reset image and original IEC shape.

Validates every input before allocation. The dictionary accepts one allocation with two equal-sized payloads
and a metadata trailer. Exceptions release untransferred storage. A scalar uses a one-element input sequence.
busy — Whether configuration is disallowed.
name — Unique local name.
isArray — TRUE distinguishes an array, including one element, from a scalar.
initialValues — Live contiguous elementary descriptors in source order.
elementCount — Number of readable contiguous descriptors; positive and fixed at creation.
*)
METHOD PRIVATE declareLocalVariable
VAR_INPUT
	busy : BOOL;
	name : STRING;
	isArray : BOOL;
	initialValues : POINTER TO __SYSTEM.AnyType;
	elementCount : DINT;
END_VAR
VAR
	key : TOF_Core.GENERIC_VALUE;
	value : TOF_Core.GENERIC_VALUE;
	category : TOF_Core.GENERIC_TYPE_CLASS;
	supported : BOOL;
	declaration : VARIABLE_DECLARATION;
	element : __SYSTEM.AnyType;
	payloadSize : ULINT;
	allocationSize : ULINT;
	storage : POINTER TO BYTE;
	size : UDINT;
	i : DINT;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

IF busy OR_ELSE name = '' OR_ELSE _Variables.GetKeyPosition(key := name) >= 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot declare a variable in a busy scope or with an empty or duplicate name"
	);
END_IF

IF elementCount <= 0 OR_ELSE initialValues = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "A declaration requires a nonempty representable element sequence"
	);
END_IF

element := initialValues[0];
supported := TOF_Core.GenericTypeClassConvertor.TryGetGenericTypeClassBySystemTypeClass(
	typeClass := element.TypeClass,
	dataSize := element.diSize,
	genericTypeClass => category
);

IF NOT supported
	OR_ELSE category = TOF_Core.GENERIC_TYPE_CLASS.UNSPECIFIED
	OR_ELSE category = TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED
	OR_ELSE category = TOF_Core.GENERIC_TYPE_CLASS.POINTER_TO
	OR_ELSE element.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_ENUM
	OR_ELSE element.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_SUBRANGE
	OR_ELSE element.diSize <= 0
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "A declaration requires an elementary IEC element type"
	);
END_IF

declaration.ElementType := element.TypeClass;
declaration.ElementSize := TO_UDINT(element.diSize);
declaration.ElementCount := elementCount;
declaration.IsArray := isArray;
payloadSize := TO_ULINT(declaration.ElementSize) * TO_ULINT(elementCount);
// Two payload regions precede an unaligned metadata trailer, always accessed with MEMCPY.
allocationSize := payloadSize * ULINT#2 + XSIZEOF(declaration);

IF allocationSize > TO_ULINT(TOF_Core.UnsignedInt32.MAX_VALUE)
	OR_ELSE TO_ULINT(elementCount) * XSIZEOF(element) > TO_ULINT(TOF_Core.UnsignedInt32.MAX_VALUE)
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Declared variable exceeds the allocation size limit"
	);
END_IF

FOR i := 0 TO declaration.ElementCount - 1 DO
	element := initialValues[i];

	IF element.pValue = 0
		OR_ELSE element.TypeClass <> declaration.ElementType
		OR_ELSE element.diSize <> TO_DINT(declaration.ElementSize)
	THEN
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Every initial element must have the same IEC type and storage size"
		);
	END_IF
END_FOR

size := TO_UDINT(payloadSize);
key := TOF_Core.GenericValueFactory.FromStringValue(value := name);

__TRY
	storage := __NEW(BYTE, TO_UDINT(allocationSize));

	IF storage = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	// This private entry describes a compound allocation, including its reset image and declaration.
	value := TOF_Core.GenericValueFactory.FromParts(
		genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED,
		address := storage,
		size := size,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
	);

	FOR i := 0 TO declaration.ElementCount - 1 DO
		Tc2_System.MEMCPY(
			destAddr := storage + TO_UDINT(i) * declaration.ElementSize,
			srcAddr := initialValues[i].pValue,
			n := declaration.ElementSize
		);
	END_FOR

	Tc2_System.MEMCPY(destAddr := storage + size, srcAddr := storage, n := size);
	Tc2_System.MEMCPY(destAddr := storage + size + size, srcAddr := ADR(declaration), n := SIZEOF(declaration));
	_Variables.SetGeneric(key := key, value := value);
	key.Reset();
	value.Reset();
__CATCH(exceptionCode)
	value.Release();
	key.Release();

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeclareVariable" Id="{0c7f3d18-2b6e-4a49-9d50-81f3b5e7a9c0}">
      <Declaration><![CDATA[(*
Declares a writable scalar value and copies its initial contents into this scope.
name — Case-sensitive local name.
initialValue — Typed initial contents descriptor.
busy — Whether configuration is currently disallowed.
*)
METHOD DeclareVariable
VAR_INPUT
	name : STRING;
	initialValue : __SYSTEM.AnyType;
	busy : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[declareLocalVariable(
	busy := busy,
	name := name,
	isArray := FALSE,
	initialValues := ADR(initialValue),
	elementCount := 1
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDeclaredElement" Id="{1d8a4e29-3c7f-4b50-8e61-92a4c6f8b0d1}">
      <Declaration><![CDATA[(*
Borrows one writable element of a local declaration.

Indices start at zero. Scalar declarations accept index zero. Missing declarations, borrowed bindings
and out-of-range indices raise. The element remains at the same address through reset. Use in the owning task
only while the declaration exists.
name — Local declaration name.
index — Zero-based element index.
*)
METHOD GetDeclaredElement : TOF_Core.GENERIC_VALUE
VAR_INPUT
	name : STRING;
	index : DINT;
END_VAR
VAR
	address : POINTER TO BYTE;
	declaration : VARIABLE_DECLARATION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[address := getElementAddress(
	name := name,
	index := index,
	initial := FALSE,
	declaration => declaration
);

GetDeclaredElement := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GenericTypeClassConvertor.GetGenericTypeClassBySystemTypeClass(
		typeClass := declaration.ElementType,
		dataSize := TO_DINT(declaration.ElementSize)
	),
	address := address,
	size := declaration.ElementSize,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="getElementAddress" Id="{2e9b5f30-4d8a-4c61-9f72-03b5d7a9c1e2}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Locates a checked element of a local owned declaration.

Returns the live or initial element address. Missing or borrowed bindings and invalid indices raise
before pointer arithmetic. The owner task keeps the storage live.
name — Local name.
index — Zero-based index.
initial — Selects the reset image.
declaration — Validated declaration metadata.
*)
METHOD PRIVATE getElementAddress : POINTER TO BYTE
VAR_INPUT
	name : STRING;
	index : DINT;
	initial : BOOL;
END_VAR
VAR_OUTPUT
	declaration : VARIABLE_DECLARATION;
END_VAR
VAR
	position : DINT;
	entry : REFERENCE TO TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[position := _Variables.GetKeyPosition(key := name);

IF position < 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unknown local declaration"
	);
END_IF

entry REF= _Variables.GetKeyValuePairByIndex(index := position);

IF NOT entry.Value.IsMemoryOwner THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "A borrowed binding has no owned declaration"
	);
END_IF

declaration := readDeclaration(value := entry.Value);

IF index < 0 OR_ELSE index >= declaration.ElementCount THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Declaration element index is out of range"
	);
END_IF

getElementAddress := entry.Value.Address + TO_UDINT(index) * declaration.ElementSize;

IF initial THEN
	getElementAddress := getElementAddress + TO_UDINT(entry.Value.Size);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Length" Id="{3f0c6a41-5e9b-4d72-8a83-14c6e8b0d2f3}">
      <Declaration><![CDATA[(* Returns the number of bindings and declarations currently stored in this scope. *)
{attribute 'monitoring' := 'call'}
PROPERTY Length : DINT]]></Declaration>
      <Get Name="Get" Id="{4a1d7b52-6f0c-4e83-9b94-25d7f9c1e3a4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Length := _Variables.Length;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5b2e8c63-7a1d-4f94-8c05-36e8a0d2f4b5}">
      <Declaration><![CDATA[(* Returns the library namespace name for diagnostic reporting. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6c3f9d74-8b2e-4a05-9d16-47f9b1e3a5c6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReadNextDeclaration" Id="{7d4a0e85-9c3f-4b16-8e27-58a0c2f4b6d7}">
      <Declaration><![CDATA[(*
Enumerates owned declarations local to this node.

Start position at zero. TRUE supplies one declaration and advances the position; FALSE marks the end.
Borrowed PLC bindings are skipped. The scope must stay live and unchanged for the enumeration.
A negative position raises. Order follows dictionary storage and is not a serialization guarantee.
position — Next dictionary slot to scan.
name — Local name on TRUE.
declaration — IEC element type, storage width, shape and extent on TRUE.
*)
METHOD ReadNextDeclaration : BOOL
VAR_IN_OUT
	position : DINT;
END_VAR
VAR_OUTPUT
	name : STRING;
	declaration : VARIABLE_DECLARATION;
END_VAR
VAR
	entry : REFERENCE TO TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF position < 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Declaration position must be nonnegative"
	);
END_IF

WHILE position < _Variables.Length DO
	entry REF= _Variables.GetKeyValuePairByIndex(index := position);
	position := position + 1;

	IF entry.Value.IsMemoryOwner THEN
		name := entry.Key.AsStringReference();
		declaration := readDeclaration(value := entry.Value);
		ReadNextDeclaration := TRUE;
		RETURN;
	END_IF
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="readDeclaration" Id="{8e5b1f96-0d4a-4c27-9f38-69b1d3a5c7e8}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Copies declaration metadata from the trailer of a standard owned binding.

The compound storage tag distinguishes this layout from older elementary declarations without metadata.
Legacy exact-type inspection raises before accessing the trailer. MEMCPY handles any alignment.
value — Owned dictionary entry value created by DefineLocalVariable.
*)
METHOD PRIVATE readDeclaration : VARIABLE_DECLARATION
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	size : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value.TypeClass <> TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Rebuild this legacy declaration to inspect its original IEC type"
	);
END_IF

size := TO_UDINT(value.Size);
Tc2_System.MEMCPY(
	destAddr := ADR(readDeclaration),
	srcAddr := value.Address + size + size,
	n := SIZEOF(readDeclaration)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindPlcVariable" Id="{9f6c2a07-1e5b-4d38-8a49-70c2e4b6d8f9}">
      <Declaration><![CDATA[(*
Binds a named PLC variable reference in this scope.

Stores a borrowed reference to the supplied PLC variable in the scope variable dictionary under a unique name.
Fails if the scope is busy, the name is empty, the name already exists in this scope, or the variable resides
in stack memory.
Type mapping precedes allocation of the owned name key. Failure before dictionary acceptance releases
that key and propagates the exception; successful binding transfers key ownership to the dictionary.
The variable storage remains borrowed and must outlive its binding.

name — Unique non-empty variable name.
plcVariable — PLC variable descriptor to bind (instance field or global variable).
plcVariableIsObject — TRUE if the variable is an FB instance implementing IObject.
busy — TRUE if the owning scope or workflow is currently busy.
ownerKind — Diagnostic owner kind ('activity', 'workflow', or 'condition').
busyOwnerKind — Diagnostic busy owner kind ('activity' or 'workflow').
ownerName — Diagnostic display name of the owning element.
sourceClassName — Diagnostic class name of the caller.
sourcePOUName — Diagnostic POU name of the caller.
*)
METHOD BindPlcVariable : BOOL
VAR_INPUT
	name : STRING;
	plcVariable : __SYSTEM.AnyType;
	plcVariableIsObject : BOOL;
	busy : BOOL;
	ownerKind : STRING;
	busyOwnerKind : STRING;
	ownerName : WSTRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
	variableKey : TOF_Core.GENERIC_VALUE;
	variableValue : TOF_Core.GENERIC_VALUE;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF name = '' THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := sourceClassName,
		sourcePOUName := sourcePOUName,
		sourcePosition := __POSITION(),
		message := "Variable name cannot be empty"
	);
END_IF

IF busy THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Unable to register variable '",
		TO_WSTRING(name),
		"' in ",
		TO_WSTRING(ownerKind),
		" '",
		ownerName,
		"': ",
		TO_WSTRING(busyOwnerKind),
		" is busy"
	);

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := sourceClassName,
		sourcePOUName := sourcePOUName,
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF TOF_Core.Memory.IsStackData(dataAddress := plcVariable.pValue, dataSize := TO_UDINT(plcVariable.diSize)) THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Unable to register variable '",
		TO_WSTRING(name),
		"' in ",
		TO_WSTRING(ownerKind),
		" '",
		ownerName,
		"': variable resides in stack memory"
	);

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := sourceClassName,
		sourcePOUName := sourcePOUName,
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF _Variables.GetKeyPosition(key := name) >= 0 THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Variable with name '",
		TO_WSTRING(name),
		"' is already registered in ",
		TO_WSTRING(ownerKind),
		" '",
		ownerName,
		"'"
	);

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := sourceClassName,
		sourcePOUName := sourcePOUName,
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

variableValue := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GenericTypeClassConvertor.GetGenericTypeClassBySystemAnyType(
		systemAnyType := plcVariable,
		isObject := plcVariableIsObject
	),
	address := plcVariable.pValue,
	size := TO_ULINT(plcVariable.diSize),
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);

variableKey := TOF_Core.GenericValueFactory.FromStringValue(value := name);

// The dictionary accepts key ownership only after validation and storage growth succeed.

__TRY
	_Variables.SetGeneric(key := variableKey, value := variableValue);
__CATCH(exceptionCode)
	variableKey.Release();

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := sourcePOUName,
		catchPointPosition := __POSITION()
	);
__ENDTRY

variableKey.Reset();

BindPlcVariable := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restore" Id="{0a7d3b18-2f6c-4e49-9b50-81d3f5c7e9a0}">
      <Declaration><![CDATA[(*
Restores complete scalar and array payloads in place from their reset images.

Performs no allocation or callbacks on values and preserves their addresses.
*)
METHOD Restore
VAR
	i : DINT;
	entry : REFERENCE TO TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO _Variables.Length - 1 DO
	entry REF= _Variables.GetKeyValuePairByIndex(index := i);

	IF entry.Value.IsMemoryOwner THEN
		Tc2_System.MEMCPY(
			destAddr := entry.Value.Address,
			srcAddr := entry.Value.Address + TO_UDINT(entry.Value.Size),
			n := TO_UDINT(entry.Value.Size)
		);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="RollbackToLength" Id="{1b8e4c29-3a7d-4f50-8c61-92e4a6d8f0b1}">
      <Declaration><![CDATA[(*
Removes bindings appended after initialLength.
initialLength — Dictionary length to restore.
*)
METHOD RollbackToLength
VAR_INPUT
	initialLength : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WHILE _Variables.Length > initialLength DO
	_Variables.RemoveAt(index := _Variables.Length - 1);
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetLocalVariable" Id="{2c9f5d30-4b8e-4a61-9d72-03f5b7e9a1c2}">
      <Declaration><![CDATA[(*
Looks up a local binding and exposes only borrowed storage on success.

Discards ownership in the returned descriptor so callers can never release declared storage. Returns FALSE
and resets the output descriptor on absence, exception or terminal allocation failure. Use the output only on TRUE.

name — Case-sensitive local binding name.
variable — Borrowed current storage.
*)
METHOD TryGetLocalVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	declaration : VARIABLE_DECLARATION;
	category : TOF_Core.GENERIC_TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	RETURN;
END_IF

__TRY
	TryGetLocalVariable := _Variables.TryGetValueByKey(key := name, value => variable);

	IF TryGetLocalVariable AND_THEN variable.IsMemoryOwner THEN
		category := variable.TypeClass;

		IF category = TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED THEN
			declaration := readDeclaration(value := variable);

			IF NOT declaration.IsArray THEN
				category := TOF_Core.GenericTypeClassConvertor.GetGenericTypeClassBySystemTypeClass(
					typeClass := declaration.ElementType,
					dataSize := TO_DINT(declaration.ElementSize)
				);
			END_IF
		END_IF

		variable := TOF_Core.GenericValueFactory.FromParts(
			genericTypeClass := category,
			address := variable.Address,
			size := variable.Size,
			memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
		);
	END_IF
__CATCH
	variable.Reset();
	TryGetLocalVariable := FALSE;
__ENDTRY

IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	variable.Reset();
	TryGetLocalVariable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

