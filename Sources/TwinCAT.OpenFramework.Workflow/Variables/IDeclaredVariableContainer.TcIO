<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IDeclaredVariableContainer" Id="{4de3aeb5-6b25-445a-8c76-2908673970bf}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Declares and inspects local scalar values and fixed-length arrays of elementary IEC values.</summary>
*)
INTERFACE IDeclaredVariableContainer EXTENDS TOF_Core.IObject]]></Declaration>
    <Method Name="DeclareArray" Id="{eaa6fdbb-d5e5-40b6-989d-6d82d918ad45}">
      <Declaration><![CDATA[(*!
<summary>Declares a nonempty one-dimensional array of elementary IEC values.</summary>
<description>Copies every element in source order into independent zero-based storage of fixed length.
Descriptors must borrow live, readable variables throughout the call and have identical IEC types and sizes,
including string capacity. Duplicate names, unsupported shapes and busy scopes raise before insertion.
Use in the owning task. Reset restores the complete initial sequence in place.</description>
<param name="name">Unique local binding name.</param>
<param name="initialValues">Typed initial element descriptors from Workflows.GetValueDescriptor,
live for this call.</param>
<param name="elementCount">Number of readable contiguous descriptors; positive and fixed at creation.</param>
*)
METHOD DeclareArray
VAR_INPUT
	name : STRING;
	initialValues : POINTER TO __SYSTEM.AnyType;
	elementCount : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="DeclareConfigurationVariable" Id="{1af4c946-6a17-4d2d-8476-cc5f8541ef8f}">
      <Declaration><![CDATA[(*!
<summary>Copies a decoded scalar or fixed one-dimensional array into local storage.</summary>
<description>Pass elementCount = 0 for a scalar variable, or a positive count for an array.
Initial data is copied into local storage.</description>
<param name="name">Unique local binding name.</param>
<param name="typeName">Elementary IEC type name.</param>
<param name="initialData">Pointer to contiguous decoded initial bytes.</param>
<param name="elementCount">0 for a scalar variable, or positive count for an array.</param>
*)
METHOD DeclareConfigurationVariable
VAR_INPUT
	name : STRING;
	typeName : STRING;
	initialData : PVOID;
	elementCount : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="DeclareVariable" Id="{50f4755c-9896-4e77-b426-51786c7982e9}">
      <Declaration><![CDATA[(*!
<summary>Declares a writable named value and copies its initial contents into this scope.</summary>
<description>Use during idle configuration in one owning task. The name must be nonempty and unique among local
bindings and declarations. Accepts elementary numeric, bit, date/time and string variables. Both copies retain
the supplied storage size. Lookup borrows the current value until scope disposal. Successful owner reset
restores it in place. Invalid declarations raise without replacing a binding. Terminal allocation failure propagates.
</description>
<param name="name">Case-sensitive local name.</param>
<param name="initialValue">Typed initial contents, including the full declared string capacity.</param>
*)
METHOD DeclareVariable
VAR_INPUT
	name : STRING;
	initialValue : ANY;
END_VAR]]></Declaration>
    </Method>
    <Method Name="NextDeclaration" Id="{907f8277-0879-4efa-9aa1-f7b2c391f47f}">
      <Declaration><![CDATA[(*!
<summary>Enumerates owned declarations local to this node.</summary>
<description>Start position at zero. TRUE supplies one declaration and advances the position; FALSE marks the end.
Borrowed PLC bindings are skipped. The scope must stay live and unchanged for the enumeration.
A negative position raises. Order follows dictionary storage and is not a serialization guarantee.</description>
<param name="position">Next dictionary slot to scan.</param>
<param name="name">Local name on TRUE.</param>
<param name="declaration">IEC element type, storage width, shape and extent on TRUE.</param>
*)
METHOD NextDeclaration : BOOL
VAR_IN_OUT
	position : DINT;
END_VAR
VAR_OUTPUT
	name : STRING;
	declaration : VARIABLE_DECLARATION;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetDeclaredElement" Id="{ecacb28e-6b59-40b9-99c8-3ec1c30e8ae2}">
      <Declaration><![CDATA[(*!
<summary>Borrows one writable element of a local declaration.</summary>
<description>Indices start at zero. Scalar declarations accept index zero. Missing declarations, borrowed bindings
and out-of-range indices raise. The element remains at the same address through reset. Use in the owning task
only while the declaration exists.</description>
<param name="name">Local declaration name.</param>
<param name="index">Zero-based element index.</param>
*)
METHOD GetDeclaredElement : TOF_Core.GENERIC_VALUE
VAR_INPUT
	name : STRING;
	index : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="CopyInitialElement" Id="{da5f5c08-9c53-443d-ae68-54fe5ae8eff4}">
      <Declaration><![CDATA[(*!
<summary>Copies one initial element into caller-owned storage.</summary>
<description>
Reads the reset image even after the live value changes. The writable destination must have the exact
IEC type and storage size of the element. Invalid names, indices and incompatible destinations raise
before copying.
</description>
<param name="name">Local declaration name.</param>
<param name="index">Zero-based element index, zero for a scalar.</param>
<param name="destination">Descriptor of writable storage with the declared IEC type and capacity.
Pass GetValueDescriptor for a PLC variable.</param>
*)
METHOD CopyInitialElement
VAR_INPUT
	name : STRING;
	index : DINT;
	destination : __SYSTEM.AnyType;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
