<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IVariableBinder" Id="{e93da1e4-9b0b-449f-85ca-e035dd61813b}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Binds external PLC variables to local variable storage.</summary>
*)
INTERFACE IVariableBinder EXTENDS TOF_Core.IObject
]]></Declaration>
    <Method Name="BindPlcVariable" Id="{9d023779-0a31-4e32-984e-e05f407dca08}">
      <Declaration><![CDATA[(*!
<summary>Binds a named PLC variable reference in this container.</summary>
<description>
Stores a borrowed reference to the supplied PLC variable under a unique case-sensitive name.
The variable must reside in static or dynamic memory; passing stack-allocated variables is not permitted.
Binding is only allowed during configuration while the container is not busy.
</description>
<param name="name">Unique non-empty variable name.</param>
<param name="plcVariable">PLC variable to bind (instance field or global variable).</param>
<param name="plcVariableIsObject">TRUE if the variable is an FB instance implementing IObject.</param>
*)
METHOD BindPlcVariable : BOOL
VAR_INPUT
	name : STRING;
	plcVariable : ANY;
	plcVariableIsObject : BOOL := FALSE;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
