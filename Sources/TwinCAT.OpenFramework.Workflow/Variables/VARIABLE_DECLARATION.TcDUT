(*!
<summary>Describes the original IEC type and shape of one owned declaration.</summary>
<description>ElementSize includes the terminator and full capacity for STRING or WSTRING. ElementCount is always positive.
IsArray distinguishes a scalar from a single-element array.</description>
*)
TYPE VARIABLE_DECLARATION :
STRUCT
	ElementType : __SYSTEM.TYPE_CLASS;
	ElementSize : UDINT;
	ElementCount : DINT;
	IsArray : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
