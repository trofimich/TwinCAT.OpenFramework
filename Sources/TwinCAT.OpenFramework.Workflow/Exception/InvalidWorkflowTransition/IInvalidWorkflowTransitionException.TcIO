<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IInvalidWorkflowTransitionException" Id="{7340e873-0fee-42d6-bda3-e9bfd586f0f4}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Represents an exception raised when an invalid workflow state transition is requested or attempted.</summary>
<description>
Instances are task-scoped diagnostic objects; do not retain references across PLC task cycles.
</description>
*)

INTERFACE IInvalidWorkflowTransitionException EXTENDS TOF_Core.IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{6c679139-20ab-4061-b94a-4c6f3303172c}">
      <Declaration><![CDATA[(*!
<summary>Formats the invalid state transition diagnostic and raises this exception.</summary>
<description>
Releases any temporary builder storage before unwinding. Does not return normally.
</description>
<param name="sourceNamespaceName">Namespace of the POU raising the exception.</param>
<param name="sourceClassName">Class name of the workflow element where the transition was rejected.</param>
<param name="sourcePOUName">Method or property name where the transition was attempted.</param>
<param name="sourcePosition">Source position identifier.</param>
<param name="fromState">Current state of the workflow element.</param>
<param name="toState">Rejected target state.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	fromState : WORKFLOW_ELEMENT_STATE;
	toState : WORKFLOW_ELEMENT_STATE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>