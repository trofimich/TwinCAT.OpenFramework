<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowVariableNotFoundException" Id="{1674d248-436c-44ec-b891-13f726ac50cb}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes diagnostics for a missing workflow variable.</summary>
<description>Reports caller-detected missing workflow variable errors using the GeneralException lifetime and throw rules.</description>
*)
INTERFACE IWorkflowVariableNotFoundException EXTENDS TOF_Core.IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{affcbfce-617e-4f74-82d0-63620887900f}">
      <Declaration><![CDATA[(*!
<summary>Raises an exception describing the missing workflow variable.</summary>
<description>Borrows message read-only for this call and formats diagnostic text without heap allocation.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
