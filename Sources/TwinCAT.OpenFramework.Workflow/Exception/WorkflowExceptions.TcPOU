<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowExceptions" Id="{66dc72bd-64d8-44a5-91d6-25d539c474f9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
