(*!
<summary>Provides static helper methods for throwing Workflow-specific exceptions.</summary>
<description>Constructs stack-local template exceptions, formats diagnostics without heap allocation and propagates them through ExceptionManager.</description>
*)

PROGRAM WorkflowExceptions
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ThrowInvalidNestedWorkflowState" Id="{dac3b225-92f2-4a39-b79e-295c66611eb1}">
      <Declaration><![CDATA[(*!
<summary>Raises an InvalidNestedWorkflowStateException without requiring a caller-owned exception variable.</summary>
<description>Constructs a temporary stack template and delegates to InvalidNestedWorkflowStateException.Throw.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="nestedActivityState">Observed child workflow element state.</param>
*)
METHOD ThrowInvalidNestedWorkflowState
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	nestedActivityState : WORKFLOW_ELEMENT_STATE;
END_VAR
VAR
	exception : InvalidNestedWorkflowStateException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, nestedActivityState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ThrowInvalidWorkflowTransition" Id="{07c7d49c-38ae-4a44-8d11-c642759b13f3}">
      <Declaration><![CDATA[(*!
<summary>Raises an InvalidWorkflowTransitionException without requiring a caller-owned exception variable.</summary>
<description>Constructs a temporary stack template and delegates to InvalidWorkflowTransitionException.Throw.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="fromState">Current state of the workflow element.</param>
<param name="toState">Rejected target state.</param>
*)
METHOD ThrowInvalidWorkflowTransition
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	fromState : WORKFLOW_ELEMENT_STATE;
	toState : WORKFLOW_ELEMENT_STATE;
END_VAR
VAR
	exception : InvalidWorkflowTransitionException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, fromState, toState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ThrowWorkflowConfiguration" Id="{a4f608c3-b8cb-48fe-aab5-91a8b16211ab}">
      <Declaration><![CDATA[(*!
<summary>Raises a WorkflowConfigurationException without requiring a caller-owned exception variable.</summary>
<description>Constructs a temporary stack template and delegates to WorkflowConfigurationException.Throw.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
*)
METHOD ThrowWorkflowConfiguration
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	exception : WorkflowConfigurationException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message);]]></ST>
      </Implementation>
    </Method>
