    </Method>
    <Method Name="ThrowWorkflowVariableNotFound" Id="{b28ba92d-2541-49f3-a377-42842d826a53}">
      <Declaration><![CDATA[(*!
<summary>Raises a WorkflowVariableNotFoundException without requiring a caller-owned exception variable.</summary>
