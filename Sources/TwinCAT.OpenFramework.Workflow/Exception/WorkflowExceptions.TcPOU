      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{794c93b6-fce0-4f75-9f7c-6316342f9fad}">
      <Declaration><![CDATA[(*!
<summary>Returns the diagnostic name stored by this program.</summary>
<description>
Borrows program-owned storage. Treat the returned reference as read-only and do not use it to change metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{efc5ea2e-5a89-4198-aacb-5f6eb07151b0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{639a2c56-6e40-4746-aa3c-483445eb911c}">
      <Declaration><![CDATA[(*!
<summary>Returns the compiler-initialized library namespace.</summary>
<description>
Borrows shared read-only namespace storage; no allocation or ownership transfer occurs.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{64a8399f-a360-4fce-ac79-db6fc38b2520}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
