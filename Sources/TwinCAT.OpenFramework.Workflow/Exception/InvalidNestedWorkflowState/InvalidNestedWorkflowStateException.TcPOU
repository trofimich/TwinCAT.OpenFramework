<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="InvalidNestedWorkflowStateException" Id="{058fa525-4a76-4579-8c8d-73a0011e222d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Represents an exception raised when a composite activity observes an unexpected child state.</summary>
<description>
Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.
</description>
*)

{attribute 'enable_dynamic_creation'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK InvalidNestedWorkflowStateException EXTENDS TOF_Core.GeneralException IMPLEMENTS IInvalidNestedWorkflowStateException
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{f957b6f8-5c63-4eb2-8e9d-1db31f202b42}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{03ce65ad-b9ee-4675-8eed-8732775d6b3d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{ff7ed493-92b3-4b7a-acd1-6efb44d9be7a}">
      <Declaration><![CDATA[(*!
<summary>Creates a task-owned copy of this exception and its diagnostic payload.</summary>
<description>Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence. The returned reference is borrowed until task cleanup and must not be deleted by the caller.</description>
*)
METHOD Clone : TOF_Core.IObject
VAR
	exceptionClone : POINTER TO InvalidNestedWorkflowStateException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(InvalidNestedWorkflowStateException);

IF exceptionClone = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

TOF_Core.DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{8b8745b7-f17c-4690-9204-7e7fa6625024}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5cd90cc8-d424-4357-94d1-a02cc64834c0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b8e67476-bc30-4e39-9367-3d78d7a7d7be}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ed6c8d4e-4992-4962-9138-7554dc3f8f59}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{b27a6b14-dced-49a0-b3c8-efc38047b527}">
      <Declaration><![CDATA[(*!
<summary>Formats the invalid nested state diagnostic and raises this exception.</summary>
<description>
Formats the diagnostic without heap allocation during message preparation and propagates the exception.
</description>
<param name="sourceNamespaceName">Namespace of the POU raising the exception.</param>
<param name="sourceClassName">Class name of the composite activity observing the invalid state.</param>
<param name="sourcePOUName">Method or property name where the state was observed.</param>
<param name="sourcePosition">Source position identifier.</param>
<param name="nestedActivityState">Observed child workflow element state that is invalid in the current context.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	nestedActivityState : WORKFLOW_ELEMENT_STATE;
END_VAR
VAR
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[message := TOF_Core.WideStrings.Concat255(
	"Invalid nested activity state '",
	TO_WSTRING(nestedActivityState),
	"'");

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>