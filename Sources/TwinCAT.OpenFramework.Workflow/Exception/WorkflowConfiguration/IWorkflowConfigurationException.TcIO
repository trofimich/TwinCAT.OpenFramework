<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowConfigurationException" Id="{dd16b64d-ee5e-4a91-8861-d615ff72f610}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes diagnostics for an invalid workflow element configuration.</summary>
<description>Reports caller-detected workflow element configuration errors using the GeneralException lifetime and throw rules.</description>
*)
INTERFACE IWorkflowConfigurationException EXTENDS TOF_Core.IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{7367f724-3d9a-4384-9c72-848343979e32}">
      <Declaration><![CDATA[(*!
<summary>Raises an exception describing the workflow configuration failure.</summary>
<description>Borrows message read-only for this call and formats diagnostic text without heap allocation.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
