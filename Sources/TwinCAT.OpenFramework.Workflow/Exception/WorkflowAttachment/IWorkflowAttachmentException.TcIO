<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowAttachmentException" Id="{30807c3e-f59e-46a8-90dc-6f510b68b7a5}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes diagnostics for an invalid workflow element hierarchy attachment.</summary>
<description>Reports caller-detected hierarchy attachment errors (cycles, multiple parents) using the GeneralException lifetime and throw rules.</description>
*)
INTERFACE IWorkflowAttachmentException EXTENDS TOF_Core.IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{ce482c13-0fde-4ad9-9a86-9d7b4a5d9f2a}">
      <Declaration><![CDATA[(*!
<summary>Raises an exception describing the workflow hierarchy attachment failure.</summary>
<description>Borrows message read-only for this call and formats diagnostic text without heap allocation.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
