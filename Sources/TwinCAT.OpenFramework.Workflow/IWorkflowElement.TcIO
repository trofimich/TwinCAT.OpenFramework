(*!
<summary>Common base interface for workflow activities and conditions participating in a workflow hierarchy.</summary>
*)

INTERFACE IWorkflowElement EXTENDS IVariableContainer, TOF_Core.INamed
]]></Declaration>
    <Property Name="Parent" Id="{cfa98d13-c681-4820-8998-f8a3411bc85d}">
      <Declaration><![CDATA[(*!
<summary>Returns the parent workflow element in the hierarchy, or 0 for a root element.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Parent : IWorkflowElement]]></Declaration>
      <Get Name="Get" Id="{7ec43eb9-38c8-4405-b62f-59911e7d0170}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Workflow" Id="{1d31faa1-77cb-4600-b9ac-1ebaa9abd2ff}">
      <Declaration><![CDATA[(*!
<summary>Returns the workflow that hosts this element, or 0 when not associated with a workflow.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Workflow : IWorkflow]]></Declaration>
      <Get Name="Get" Id="{7fde95c5-a31e-46bf-a4f2-cad5094ce479}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
