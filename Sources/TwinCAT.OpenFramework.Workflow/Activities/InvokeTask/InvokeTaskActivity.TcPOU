(*!
<summary>Executes an asynchronous ITask from TwinCAT.OpenFramework.Tasks within a workflow.</summary>
<description>
Starts the task on entry, cyclically executes it while RUNNING, and coordinates cancellation and resetting.
When the task completes with WORK_DONE, this activity completes. When the task aborts or cancels, it
transitions to PASSIVE_HALTED with the task's stop message. When the task terminates with FAILURE, it raises a
standard exception. Explicit dependency bindings persist either an embedded configuration or an external key.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK InvokeTaskActivity EXTENDS Activity IMPLEMENTS IInvokeTaskActivity, TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_Task : TOF_Tasks.ITask;
	_BindingKind : DEPENDENCY_BINDING_KIND;
	_ExternalKey : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_Configured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{719a842b-e51c-4394-bb92-491cba05f421}" />
    <Property Name="ClassName" Id="{535d0327-a4db-4687-8471-79785ff04224}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e0df0140-9afe-4cb4-8e00-b2e01c649db3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{642b10ff-0e02-445d-822a-c8b541f41f12}">
      <Declaration><![CDATA[(*!
<summary>Configures the task to be executed.</summary>
<description>
Requires a nonzero task instance and PASSIVE_READY. Validation precedes mutation; rejection preserves the
previous dependency and its execution. The task remains borrowed and must stay alive until cleanup completes.
This execution-only binding requires an explicit role before serialization.
Reset the activity before replacing the dependency after a finished run; no hot replacement is performed.
</description>
<param name="task">The task instance to execute.</param>
*)
METHOD Configure
VAR_INPUT
	task : TOF_Tasks.ITask;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF task = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'task'
	);
END_IF

IF State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot configure InvokeTaskActivity outside PASSIVE_READY"
	);
END_IF

_Configured := FALSE;

_Task := task;
_BindingKind := DEPENDENCY_BINDING_KIND.UNSPECIFIED;
_ExternalKey := '';

_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Configured" Id="{4ee4913e-e9b5-4082-827c-d4bf7a9953d1}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the task activity has been configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{577b11b5-7ed0-44cf-b0b6-3e751d86d539}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _Configured;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2139b150-41de-4351-bbcc-e69724ff224a}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{18ab3231-1812-4adb-9361-24254a945427}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnFail" Id="{15e3e2ba-cf2d-4b9f-b585-b21dd25c7dfc}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Requests cancellation of the running task when this activity fails.</summary>
<description>
Requests cancellation without waiting for STOPPED. Task ownership and pending cleanup remain with the owner;
OnResetting can advance the task later. Catch handlers must not infer resource release from this hook.
</description>
<param name="exception">Caught exception that caused the failure.</param>
*)
METHOD PROTECTED OnFail
VAR_INPUT
	exception : TOF_Core.IException;
END_VAR
VAR
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Configured AND_THEN _Task <> 0 AND_THEN _Task.State.Running THEN
	_Task.Cancel(refuseReason => refuseReason);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnResetting" Id="{fc8824f6-0635-4038-8338-6908a83b9dda}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resets the underlying task and completes resetting when the task reaches READY.</summary>
<param name="startResetting">TRUE on the initial call from RequestReset.</param>
*)
METHOD PROTECTED OnResetting : ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR
VAR
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Configured THEN
	OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;
	RETURN;
END_IF

IF _Task.State.Stopped THEN
	IF _Task.Reset(refuseReason => refuseReason) THEN
		OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;
	END_IF
ELSIF _Task.State.Ready THEN
	OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;
ELSIF _Task.State.Running THEN
	_Task.Cancel(refuseReason => refuseReason);
	_Task.Execute();

	IF _Task.State.Stopped AND_THEN _Task.Reset(refuseReason => refuseReason) THEN
		OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{daa8b942-4160-4730-8ecd-7d466d9d1fc2}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Starts and cyclically executes the configured task until completion, halting or failure.</summary>
<param name="startRunning">TRUE on the initial call of a fresh start.</param>
<param name="startResuming">TRUE when resuming execution after suspension.</param>
<param name="haltReason">Halt reason output when the task aborts or cancels.</param>
*)
METHOD PROTECTED OnRunning : ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
	taskRefuseReason : TOF_Core.ERROR_MESSAGE;
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Configured THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Activity is not configured"
	);
END_IF

IF startRunning THEN
	IF _Task.State.Ready THEN
		IF NOT _Task.Start(refuseReason => taskRefuseReason) THEN
			formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
				"Failed to start task '",
				_Task.Name,
				"': ",
				taskRefuseReason
			);
			WorkflowExceptions.ThrowWorkflowConfiguration(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := formattedExceptionMessage
			);
		END_IF
	ELSIF _Task.State.Stopped THEN
		IF NOT _Task.Reset(refuseReason => taskRefuseReason) THEN
			formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
				"Failed to reset task '",
				_Task.Name,
				"': ",
				taskRefuseReason
			);
			WorkflowExceptions.ThrowWorkflowConfiguration(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := formattedExceptionMessage
			);
		END_IF

		IF NOT _Task.Start(refuseReason => taskRefuseReason) THEN
			formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
				"Failed to start task '",
				_Task.Name,
				"': ",
				taskRefuseReason
			);
			WorkflowExceptions.ThrowWorkflowConfiguration(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := formattedExceptionMessage
			);
		END_IF
	END_IF
END_IF

_Task.Execute();

IF _Task.State.Stopped THEN
	CASE _Task.FinalStopReason.Value OF
		TOF_Tasks.TASK_STOP_REASON.WORK_DONE:
			OnRunning := ACTIVITY_RUNNING_STATE.WORK_COMPLETED;

		TOF_Tasks.TASK_STOP_REASON.INTERNAL_ABORT,
		TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL:
			haltReason := _Task.FinalStopReason.Message;
			OnRunning := ACTIVITY_RUNNING_STATE.WORK_HALTED;

		TOF_Tasks.TASK_STOP_REASON.FAILURE:
			formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
				"Task '",
				_Task.Name,
				"' failed: ",
				_Task.FinalStopReason.Message
			);
			TOF_Core.Exceptions.ThrowStandard(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := formattedExceptionMessage
			);
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{4046a63a-9467-4603-b5c9-9c196f6321b4}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Drives task stopping and translates its final outcome without hiding failures.</summary>
<description>
Cancellation requests Cancel once; suspension keeps advancing the task without requesting cancellation.
WORK_DONE completes the activity, INTERNAL_ABORT halts it with the task message, EXTERNAL_CANCEL completes
the requested stop, and FAILURE propagates a StandardException to activity failure handling. Cleanup remains
cyclic until the task reaches STOPPED; suspension is not a pause of the task's internal work.
</description>
<param name="startCancelling">TRUE when stopping due to cancellation.</param>
<param name="startSuspending">TRUE when stopping due to suspension.</param>
<param name="haltReason">Receives the task diagnostic on INTERNAL_ABORT.</param>
*)
METHOD PROTECTED OnStopping : ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
	taskRefuseReason : TOF_Core.ERROR_MESSAGE;
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Configured THEN
	OnStopping := ACTIVITY_STOPPING_STATE.WORK_STOPPED;
	RETURN;
END_IF

IF startCancelling AND_THEN _Task.State.Running THEN
	_Task.Cancel(refuseReason => taskRefuseReason);
END_IF

IF _Task.State.Running THEN
	_Task.Execute();
END_IF

IF _Task.State.Stopped THEN
	CASE _Task.FinalStopReason.Value OF
		TOF_Tasks.TASK_STOP_REASON.WORK_DONE:
			OnStopping := ACTIVITY_STOPPING_STATE.WORK_COMPLETED;

		TOF_Tasks.TASK_STOP_REASON.INTERNAL_ABORT:
			haltReason := _Task.FinalStopReason.Message;
			OnStopping := ACTIVITY_STOPPING_STATE.WORK_HALTED;

		TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL:
			OnStopping := ACTIVITY_STOPPING_STATE.WORK_STOPPED;

		TOF_Tasks.TASK_STOP_REASON.FAILURE:
			formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
				"Task '",
				_Task.Name,
				"' failed: ",
				_Task.FinalStopReason.Message
			);

			TOF_Core.Exceptions.ThrowStandard(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := formattedExceptionMessage
			);
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{cb67ecf2-c298-4211-a9bc-cf4579b49edf}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9b2f2569-44f4-46b5-8b74-908ef0568d68}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Task" Id="{f4475b16-41ef-4101-803e-4db5ae6d2efc}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured task instance, or 0 before configuration.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Task : TOF_Tasks.ITask]]></Declaration>
      <Get Name="Get" Id="{3c2b4606-85b3-4db5-873c-60b262728dd6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Task := _Task;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConfigureEmbeddedTask" Id="{ad46853c-8808-4e69-91f7-1549d17fdd55}">
      <Declaration><![CDATA[(*!
<summary>Adopts a fresh workflow-owned task.</summary>
<description>Requires a ready node in a workflow and a dynamic serializable instance available for exclusive transfer.
The workflow owns it on success. A duplicate in the same workflow raises before changing this node.</description>
*)
METHOD ConfigureEmbeddedTask
VAR_INPUT
	task : TOF_Tasks.ITask;
END_VAR
VAR
	owner : IEmbeddedDependencyOwner;
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

IF State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY
	OR_ELSE (ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy)
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot change the binding during execution"
	);
END_IF

IF ownerWorkflow = 0 OR_ELSE NOT __QUERYINTERFACE(ownerWorkflow, owner) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow does not accept embedded dependencies"
	);
END_IF

owner.AttachEmbeddedDependency(dependency := task, node := THIS^);

_Task := task;
_BindingKind := DEPENDENCY_BINDING_KIND.EMBEDDED;
_ExternalKey := '';
_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigureExternalTask" Id="{aab9db27-f8c8-4560-98d6-ea267cddaa22}">
      <Declaration><![CDATA[(*!
<summary>Binds an externally owned task.</summary>
<description>Requires a live dependency and a nonempty stable key. Several nodes may borrow the same external instance.
The provider keeps it alive. Rejection preserves the previous binding.</description>
*)
METHOD ConfigureExternalTask
VAR_INPUT
	task : TOF_Tasks.ITask;
	key : STRING;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

IF State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY
	OR_ELSE (ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy)
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot change the binding during execution"
	);
END_IF

IF task = 0 OR_ELSE key = '' THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "External binding requires a live dependency and a key"
	);
END_IF

_Task := task;
_BindingKind := DEPENDENCY_BINDING_KIND.EXTERNAL_KEY;
_ExternalKey := key;
_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Serialize" Id="{c830f548-196a-4d2b-8dc5-8a2bec6f0c39}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
Workflows.WriteDependency(
	writer := writer,
	role := 'task',
	kind := _BindingKind,
	key := _ExternalKey,
	dependency := _Task,
	nodeName := Name
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{abb6c1cc-abe4-442f-9e98-a8eeee2bb29b}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and deserialization context are borrowed for this call.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Active configuration deserialization context providing workflow reconstruction services.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[loader := WorkflowConfigurationSerializer.ResolveWorkflowLoader(context := context);
Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

loader.BindDependency(node := reader.GetField(node := node, name := 'task'), target := THIS^, isTask := TRUE);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>