<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IInvokeTaskActivity" Id="{4aac828c-d9ae-42b7-9869-9d06d2ade0db}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>
Defines the contract for an activity that executes an asynchronous task from TwinCAT.OpenFramework.Tasks.
</summary>
<description>
Starts the task on entry, cyclically executes it while RUNNING, translates stop reasons (WORK_DONE to
completion, INTERNAL_ABORT or EXTERNAL_CANCEL to halted, FAILURE to exception) and propagates cancellation
requests to the task. While suspending, the task keeps executing until it stops. A task failure during
stopping is still an activity failure; work completion completes the activity rather than reporting a pause.
</description>
*)

INTERFACE IInvokeTaskActivity EXTENDS IActivity
]]></Declaration>
    <Property Name="Configured" Id="{63c9557d-c850-4108-9577-a1cd7c46f917}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the task activity has been configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{39040bea-bdba-45ec-b518-391fda404504}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{50813f6f-26e0-49ce-b6ea-95a18a7ae48d}">
      <Declaration><![CDATA[(*!
<summary>Configures the task to be executed.</summary>
<description>
Requires a nonzero task instance and PASSIVE_READY. The task is borrowed until stopping and reset finish.
Rejected configuration preserves the previous dependency; active task replacement is not supported.
</description>
<param name="task">The task instance to execute.</param>
*)
METHOD Configure
VAR_INPUT
	task : TOF_Tasks.ITask;
END_VAR]]></Declaration>
    </Method>
    <Property Name="Task" Id="{6398fb34-b12e-4a05-96cb-c420effe02dc}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured task instance, or 0 before configuration.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Task : TOF_Tasks.ITask]]></Declaration>
      <Get Name="Get" Id="{3dd712d4-b118-4b87-9656-e8027540988b}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>

