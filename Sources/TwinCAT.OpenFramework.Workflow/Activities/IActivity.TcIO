<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IActivity" Id="{46a777dc-cb17-44a1-8b27-cee98703fc49}">
    <Declaration><![CDATA[(*
