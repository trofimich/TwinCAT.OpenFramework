(*!
<summary>Defines the hierarchy and activity-specific contract for a workflow activity.</summary>
<description>
Activities participate in the workflow execution hierarchy as elements of a workflow tree.
Inherits the lifecycle state machine, error snapshot and control commands from IWorkflowLifecycle.
</description>
*)

INTERFACE IActivity EXTENDS IWorkflowElement, IWorkflowLifecycle]]></Declaration>
    <Property Name="ParentActivity" Id="{034897b8-541d-4ed2-8850-1607960d899f}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the borrowed parent composite activity in the workflow tree.</summary>
<description>
The standard implementation validates cycles, fixed workflow association and PASSIVE_READY before a new
link is stored. Existing parent links cannot be detached or replaced; an unchanged link is a no-op.
Parents are borrowed for the tree lifetime and do not transfer ownership. Configuration is single-task
without reentry; a child with a known owner requires a parent from that same known workflow.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ParentActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{d0588bdd-b395-45c7-9cdd-d5fbed714620}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{31581cf2-d552-4ef7-b669-28ce3db47b89}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Set>
    </Property>
  </Itf>
</TcPlcObject>
