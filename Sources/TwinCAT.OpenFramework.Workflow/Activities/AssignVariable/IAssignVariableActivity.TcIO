<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IAssignVariableActivity" Id="{d785b048-7617-4b45-83dd-43f519a3b75c}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines the contract for an activity that sets or copies the value of a workflow variable.</summary>
<description>
Completes in a single execution step by copying a literal value or the value of another workflow variable
into the configured target variable.
</description>
*)

INTERFACE IAssignVariableActivity EXTENDS IActivity
]]></Declaration>
    <Property Name="Configured" Id="{03682fc2-07ea-4db0-a70c-ca78b6d2bafe}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the assignment activity has been configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{1eab35be-1d3e-4f47-b4fa-5d91ba855533}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{6c827d01-3d32-4e73-a57c-70906f96b904}">
      <Declaration><![CDATA[(*!
<summary>Configures the activity to assign a literal or constant value to the target variable.</summary>
<description>
Requires a non-empty target variable name and a valid value. An internal snapshot of the value
is cloned into owned storage and released upon destruction.
</description>
<param name="targetVariableName">Non-empty name of the target workflow variable.</param>
<param name="value">Value to copy into the target variable.</param>
*)
METHOD Configure
VAR_INPUT
	targetVariableName : STRING;
	value : ANY;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ConfigureFromVariable" Id="{6463d6f0-cd9c-4594-b817-f7eaab21e46a}">
      <Declaration><![CDATA[(*!
<summary>Configures the activity to copy the value from a source workflow variable into the target variable.</summary>
<description>
Requires non-empty source and target variable names. Both variables are resolved in the workflow hierarchy
when the activity executes.
</description>
<param name="targetVariableName">Non-empty name of the target workflow variable.</param>
<param name="sourceVariableName">Non-empty name of the source workflow variable.</param>
*)
METHOD ConfigureFromVariable
VAR_INPUT
	targetVariableName : STRING;
	sourceVariableName : STRING;
END_VAR]]></Declaration>
    </Method>
    <Property Name="SourceVariableName" Id="{9f35287b-b36e-4f09-a378-b772deab135c}">
      <Declaration><![CDATA[(*!
<summary>Returns the source variable name if configured for variable-to-variable copy, or an empty string.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SourceVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{07548d46-548b-48e2-af68-637a1aaa1dae}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="TargetVariableName" Id="{779a3b01-bc10-44f0-8671-167881545b68}">
      <Declaration><![CDATA[(*!
<summary>Returns the target variable name to be assigned.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY TargetVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{76c54293-e5b9-48d2-8220-ce14b41e8264}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>

