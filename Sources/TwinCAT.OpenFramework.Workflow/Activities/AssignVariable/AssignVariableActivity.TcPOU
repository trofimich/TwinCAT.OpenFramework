<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssignVariableActivity" Id="{32a165d9-60ff-40be-8f8a-539a0f50eb72}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Assigns a literal value or copies from another workflow variable in a single execution step.</summary>
<description>
Configured either via Configure with a literal value (cloned into owned memory) or via ConfigureFromVariable
with another workflow variable name. Resolves target and source variables through the workflow hierarchy
during execution and updates the target storage with type compatibility checks.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK AssignVariableActivity EXTENDS Activity IMPLEMENTS IAssignVariableActivity
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_TargetVariableName : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_SourceVariableName : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_AssignedValue : TOF_Core.GENERIC_VALUE;

	{attribute 'OPC.UA.DA' := '0'}
	_Configured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{a0718470-ec87-4179-8f55-bd00be796833}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{068cde88-382f-47ab-be2a-c6446b35275b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{97391146-73e1-43b0-bb33-18a020d4d0b5}">
      <Declaration><![CDATA[(*!
<summary>Configures the activity to assign a literal or constant value to the target variable.</summary>
<description>
Requires a non-empty target variable name and a valid value. An internal snapshot of the value is cloned into
owned storage and released upon destruction.
</description>
<param name="targetVariableName">Non-empty name of the target workflow variable.</param>
<param name="value">Value to copy into the target variable.</param>
*)
METHOD Configure
VAR_INPUT
	targetVariableName : STRING;
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'targetVariableName',
		argumentValue := targetVariableName
	);
END_IF

IF value.pValue = TOF_Core.Memory.NULL_ADDRESS OR_ELSE value.diSize = TOF_Core.SignedInt32.ZERO THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'value'
	);
END_IF

_Configured := FALSE;

_AssignedValue.Release();
_AssignedValue := TOF_Core.GenericValueFactory.FromAnyType(
		value := value,
		isObject := FALSE,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY
	);

_TargetVariableName := targetVariableName;
_SourceVariableName := '';

_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Configured" Id="{fdc15444-eea1-490d-914f-0f479d8637f4}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the assignment activity has been configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{427421e6-e58f-485e-bf7e-f7d0d7a2066f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _Configured;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConfigureFromVariable" Id="{ba12af3c-7c03-4df4-a22a-cf73d93aadff}">
      <Declaration><![CDATA[(*!
<summary>Configures the activity to copy the value from a source workflow variable into the target variable.</summary>
<description>
Requires non-empty source and target variable names. Both variables are resolved in the workflow hierarchy
when the activity executes.
</description>
<param name="targetVariableName">Non-empty name of the target workflow variable.</param>
<param name="sourceVariableName">Non-empty name of the source workflow variable.</param>
*)
METHOD ConfigureFromVariable
VAR_INPUT
	targetVariableName : STRING;
	sourceVariableName : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'targetVariableName',
		argumentValue := targetVariableName
	);
END_IF

IF sourceVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'sourceVariableName',
		argumentValue := sourceVariableName
	);
END_IF

_Configured := FALSE;

_AssignedValue.Release();

_TargetVariableName := targetVariableName;
_SourceVariableName := sourceVariableName;

_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{c11cbc39-198e-4ffc-ba11-d0b9843df8a1}">
      <Declaration><![CDATA[(*!
<summary>Releases the owned assignment literal snapshot during destruction.</summary>
<description>
Uses GENERIC_VALUE.Release and completes without exceptions under its cleanup contract. Borrowed aliases
to the released snapshot become invalid. This destructor does not establish an online-change relocation
protocol or preserve aliases across copy-code destruction; use an explicitly supported owner procedure.
</description>
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AssignedValue.Release();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{3e9bfff2-525d-4074-8842-99e6141e22b6}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ff9dce42-5b48-4b1f-a8b1-95dc3fceb713}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnResetting" Id="{7387fd59-0ec5-41b8-9da6-70db88d548b0}">
      <Declaration><![CDATA[(*!
<summary>Completes resetting in a single step.</summary>
<param name="startResetting">TRUE on the initial call from RequestReset.</param>
*)
METHOD PROTECTED OnResetting : ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{0e8dbe1d-2057-4c8e-84fe-f660b1c4d37a}">
      <Declaration><![CDATA[(*!
<summary>Assigns or copies the configured value to the target variable and completes immediately.</summary>
<param name="startRunning">TRUE on the initial call of a fresh start.</param>
<param name="startResuming">TRUE when resuming execution after suspension.</param>
<param name="haltReason">Unused halt reason output.</param>
*)
METHOD PROTECTED OnRunning : ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
	variableFound : BOOL;
	targetVariable : TOF_Core.GENERIC_VALUE;
	sourceVariable : TOF_Core.GENERIC_VALUE;
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Configured THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Activity is not configured"
	);
END_IF

variableFound := TryGetVariable(name := _TargetVariableName, variable => targetVariable);

IF NOT variableFound THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Activity '",
		Name,
		"' target variable '",
		TO_WSTRING(_TargetVariableName),
		"' not found"
	);
	WorkflowExceptions.ThrowWorkflowVariableNotFound(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF _SourceVariableName <> '' THEN
	variableFound := TryGetVariable(name := _SourceVariableName, variable => sourceVariable);

	IF NOT variableFound THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
			"Activity '",
			Name,
			"' source variable '",
			TO_WSTRING(_SourceVariableName),
			"' not found"
		);
		WorkflowExceptions.ThrowWorkflowVariableNotFound(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := formattedExceptionMessage
		);
	END_IF

	targetVariable.ChangeValueByAnyType(value := sourceVariable.AsAnyType(), isObject := FALSE);
ELSE
	targetVariable.ChangeValueByAnyType(value := _AssignedValue.AsAnyType(), isObject := FALSE);
END_IF

OnRunning := ACTIVITY_RUNNING_STATE.WORK_COMPLETED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{cc70d4e0-e6c6-4d38-adb5-6a7926af8bfe}">
      <Declaration><![CDATA[(*!
<summary>Completes stopping immediately on cancel or suspend.</summary>
<param name="startCancelling">TRUE when stopping due to cancellation.</param>
<param name="startSuspending">TRUE when stopping due to suspension.</param>
<param name="haltReason">Unused halt reason output.</param>
*)
METHOD PROTECTED OnStopping : ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnStopping := ACTIVITY_STOPPING_STATE.WORK_STOPPED;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{f299346a-639b-4c19-9cff-fe903bd07683}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f90920ff-cab9-4d8f-a624-0804348b7f93}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SourceVariableName" Id="{ec160556-07aa-469f-abb8-c2af96a7b8d2}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured source variable name, or an empty string.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SourceVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{8188cda9-6e01-4f72-8274-ebd3cef30174}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SourceVariableName := _SourceVariableName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TargetVariableName" Id="{d74028ad-8f88-4588-812e-94b03e485549}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured target variable name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY TargetVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{f678f310-685a-4975-bcbe-16b52180fc52}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[TargetVariableName := _TargetVariableName;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>