<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Activity" Id="{ab48bd8b-e561-4a48-ba30-d8d6aa6a3a44}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides the base lifecycle, state transitions, variable lookup and failure handling for workflow activities.</summary>
<description>
Activities start from PASSIVE_READY, pause into PASSIVE_SUSPENDED, finish in PASSIVE_COMPLETED, PASSIVE_HALTED,
PASSIVE_CANCELLED or PASSIVE_FAILED, and return to PASSIVE_READY through ACTIVE_RESETTING via RequestReset.
Any uncaught exception in Execute, RequestStart, RequestSuspend, RequestCancel or RequestReset transitions the
activity to PASSIVE_FAILED, copies diagnostics into FailError, invokes OnFail once and rethrows the exception
to the caller. FB_init stores the workflow association only; dynamic instances require explicit RegisterChild
after construction, while static instances remain caller-owned.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ABSTRACT Activity EXTENDS TOF_Core.Object IMPLEMENTS IActivity
VAR
	{attribute 'hide'} 
	_Name : WSTRING;
	
	_Workflow : IWorkflow;
	
	_ParentActivity : IActivity;

	_Variables : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
	
	_State : WORKFLOW_ELEMENT_STATE;
	_PreviousState : WORKFLOW_ELEMENT_STATE;
	_StateChanged : BOOL;
	
	_FailError : TOF_Core.ERROR;
	_CancelReason : WSTRING(255);
	_HaltReason : WSTRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal methods" Id="{d209e4cb-f636-4994-9756-8ec05d532d51}" />
    <Folder Name="Methods to override" Id="{e7dec774-a925-4c60-82fb-0de6b314c0cf}" />
    <Property Name="Busy" Id="{4a27e4a6-049e-423b-bd5e-9b17f40d26c7}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the activity is in an active state requiring cyclic Execute calls.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{051f0622-8617-4132-bb68-a981920bece1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _State = WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING 
	OR_ELSE _State = WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING
	OR_ELSE _State = WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING
	OR_ELSE _State = WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CancelReason" Id="{e2bc3f04-4677-4d3c-9357-f54296f5e5c8}">
      <Declaration><![CDATA[(*!
<summary>Returns the reason recorded for the most recent cancellation request.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CancelReason : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{df206a6b-d527-4e14-aba8-68798b8c9d03}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CancelReason REF= _CancelReason;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{be6fc6c1-8eae-4046-84ea-8d4eaff4bdc8}">
      <Declaration><![CDATA[(*!
<summary>Advances the current active state by one step and propagates failures.</summary>
<description>
Dispatches ACTIVE_RUNNING to OnRunning, ACTIVE_CANCELLING and ACTIVE_SUSPENDING to OnStopping, and
ACTIVE_RESETTING to OnResetting. No-op in passive states. When an exception occurs, transitions to
PASSIVE_FAILED, populates FailError, calls OnFail once and rethrows the exception.
</description>
*)
METHOD FINAL Execute
VAR
	runningState : ACTIVITY_RUNNING_STATE;
	stoppingState : ACTIVITY_STOPPING_STATE;
	resettingState : ACTIVITY_RESETTING_STATE;
	
	haltReason : WSTRING(255);
	
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StateChanged := FALSE;

__TRY	
	CASE _State OF
		WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING:
			runningState := OnRunning(FALSE, FALSE, haltReason => haltReason);
	
			CASE runningState OF
				ACTIVITY_RUNNING_STATE.WORK_COMPLETED:
					SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED);
					
				ACTIVITY_RUNNING_STATE.WORK_HALTED:
					_HaltReason := haltReason;
					SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED);
			END_CASE
		
		WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING, WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING:
			stoppingState := OnStopping(FALSE, FALSE, haltReason => haltReason); 
		
			CASE stoppingState OF
				ACTIVITY_STOPPING_STATE.WORK_STOPPED:
					IF _State = WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING THEN
						SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED);
					ELSE 
						SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED);
					END_IF
					
				ACTIVITY_STOPPING_STATE.WORK_COMPLETED:
					SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED);
					
				ACTIVITY_STOPPING_STATE.WORK_HALTED:
					_HaltReason := haltReason;
					SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED);
			END_CASE

		WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING:
			resettingState := OnResetting(FALSE);

			IF resettingState = ACTIVITY_RESETTING_STATE.WORK_RESET THEN
				_FailError.Clear();
				_CancelReason := "";
				_HaltReason := "";
				SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_READY);
			END_IF
	END_CASE
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="FailError" Id="{487ced16-7528-4ca7-b275-2962ec89e588}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the durable error snapshot captured when the activity failed.</summary>
<description>
Populated when an exception transitions the activity to PASSIVE_FAILED and cleared when resetting completes
or a new run starts. Callers must not mutate the returned ERROR instance.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL FailError : REFERENCE TO TOF_Core.ERROR]]></Declaration>
      <Get Name="Get" Id="{388e0c13-041e-488c-a343-649e016470b2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FailError REF= _FailError;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{ffd89157-0584-4da6-8b2f-193481b5613d}">
      <Declaration><![CDATA[(*!
<summary>Stores the borrowed workflow association and initializes the default activity name.</summary>
<description>
Does not allocate registry storage. The creator must call workflow.RegisterChild after __NEW succeeds,
outside lifecycle methods, if the workflow is to own this dynamic instance.
</description>
<param name="bInitRetains">if TRUE, the retain variables are initialized (warm start / cold start)</param>
<param name="bInCopyCode">if TRUE, the instance afterwards gets moved into the copy code (online change)</param>
<param name="workflow">Workflow that hosts this activity, or 0 when attached later.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL;
	bInCopyCode : BOOL;
	workflow : IWorkflow;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := GetDefaultName();

_Workflow := workflow;]]></ST>
      </Implementation>
    </Method>
    <Property Name="HaltReason" Id="{07437ef7-469f-4431-94a0-8d23aebd0d97}">
      <Declaration><![CDATA[(*!
<summary>Returns the diagnostic reason reported when the activity halted its work internally.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL HaltReason : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{f06593a6-8dcc-4d84-a248-9dce2650988b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[HaltReason REF= _HaltReason;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="handleException" Id="{a2f46e54-8b11-4431-a8d7-849983a96601}" FolderPath="Internal methods\">
      <Declaration><![CDATA[(*!
<summary>Transitions the activity to PASSIVE_FAILED, records FailError, invokes OnFail and rethrows the exception.</summary>
<description>
Clones static native exception wrappers before invoking ToError or OnFail so nested exceptions cannot overwrite
the original payload. Preserves terminal allocation failure priority before rethrowing.
</description>
<param name="exceptionCode">Caught system exception code.</param>
<param name="catchPointPOUName">Method name where the exception was caught.</param>
<param name="catchPointPosition">Source position where the exception was caught.</param>
*)
METHOD PRIVATE handleException
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	catchPointPOUName : STRING(255);
	catchPointPosition : STRING(255);
END_VAR
VAR
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, catchPointPOUName, catchPointPosition);

// Keep the native wrapper stable while callbacks may handle another exception.
IF NOT exception.IsDynamicInstance THEN
	__QUERYINTERFACE(exception.Clone(), exception);
END_IF

SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED);

_FailError.Clear();

__TRY
	exception.ToError(_FailError, TOF_Core.ERROR_SEVERITY.ERROR);
__CATCH
	_FailError.Clear();
__ENDTRY

__TRY
	OnFail(exception);
__CATCH
__ENDTRY

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

TOF_Core.ExceptionManager.Throw(exception);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{4ab9bbf7-e87b-4c87-bc17-1da2b3393057}">
      <Declaration><![CDATA[(*!
<summary>Returns a reference to the activity diagnostic name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Name : REFERENCE TO WSTRING]]></Declaration>
      <Get Name="Get" Id="{1f523989-83ef-4516-813c-be024b8169a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name REF= _Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnFail" Id="{86d98c43-34b6-41e3-a2de-bfa6e2663324}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Invoked synchronously once when an uncaught exception transitions the activity to PASSIVE_FAILED.</summary>
<description>
Override to perform immediate local stop actions (such as deactivating a timer trigger). Implementations must
not raise exceptions or retain the task-scoped exception reference after returning. Multi-cycle reset work
belongs in OnResetting.
</description>
<param name="exception">Caught exception that caused the failure.</param>
*)
METHOD PROTECTED OnFail
VAR_INPUT
	exception : TOF_Core.IException;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnResetting" Id="{d4c17a91-67e5-4d91-9e12-54c3b886e712}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Performs one step of resetting the activity back to PASSIVE_READY.</summary>
<description>
Called with startResetting := TRUE from RequestReset and with startResetting := FALSE on subsequent Execute
calls while in ACTIVE_RESETTING. Return WORK_RESET when internal state, cursors and child activities are
ready for a fresh start, or WORK_IN_PROGRESS when additional Execute cycles are required. The default
implementation returns WORK_RESET immediately.
</description>
<param name="startResetting">TRUE on the initial call from RequestReset; FALSE on cyclic Execute calls.</param>
*)
METHOD PROTECTED OnResetting : ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{ff3568b9-81d7-45c0-aad6-1ecbde24ba04}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Performs one step of activity execution in ACTIVE_RUNNING.</summary>
<description>
Called with startRunning := TRUE on a fresh start from PASSIVE_READY, with startResuming := TRUE when resuming
from PASSIVE_SUSPENDED, and with both flags FALSE on subsequent cyclic Execute calls. Return WORK_IN_PROGRESS
to continue running, WORK_COMPLETED when finished, or WORK_HALTED with haltReason when stopped by internal logic.
</description>
<param name="startRunning">TRUE on the initial call of a fresh start from PASSIVE_READY.</param>
<param name="startResuming">TRUE on the initial call when resuming from PASSIVE_SUSPENDED.</param>
<param name="haltReason">Diagnostic reason when returning WORK_HALTED.</param>
*)
METHOD PROTECTED ABSTRACT OnRunning : ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{0f732c8a-9e9a-4779-80c6-a3e254a4c94f}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Performs one step of cooperative stopping in ACTIVE_CANCELLING or ACTIVE_SUSPENDING.</summary>
<description>
Called with startCancelling := TRUE from RequestCancel, startSuspending := TRUE from RequestSuspend, and with
both flags FALSE on subsequent cyclic Execute calls. Return WORK_IN_PROGRESS while stopping continues,
WORK_STOPPED when the requested cancel or suspend state is reached, WORK_COMPLETED if work completed during
stopping, or WORK_HALTED with haltReason.
</description>
<param name="startCancelling">TRUE on the initial call from RequestCancel.</param>
<param name="startSuspending">TRUE on the initial call from RequestSuspend.</param>
<param name="haltReason">Diagnostic reason when returning WORK_HALTED.</param>
*)
METHOD PROTECTED ABSTRACT OnStopping : ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Parent" Id="{d42ed62d-e5ae-493d-a21e-c03f60e3c88f}">
      <Declaration><![CDATA[(*!
<summary>Returns the parent workflow element in the hierarchy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Parent : IWorkflowElement]]></Declaration>
      <Get Name="Get" Id="{765fc5b2-4f23-4c68-98f4-2352c4c6e3f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Parent := _ParentActivity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ParentActivity" Id="{7746eee7-81b2-4cc8-b04b-86aaff99c3e3}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the borrowed parent composite activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ParentActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{c910d929-401b-4d62-9e02-b489beb98812}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ParentActivity := _ParentActivity;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{45312744-e8d0-4156-ae50-a2d68cc6dcc8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ParentActivity := ParentActivity;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="RequestCancel" Id="{b3ceac03-f171-4dc0-9de1-bd85e0183af2}">
      <Declaration><![CDATA[(*!
<summary>Requests cooperative cancellation of the activity and runs the initial stopping step.</summary>
<description>
No-op when the current state cannot transition to ACTIVE_CANCELLING. Stores the cancellation reason, transitions
to ACTIVE_CANCELLING and invokes OnStopping(TRUE, FALSE). Transitions immediately to PASSIVE_CANCELLED,
PASSIVE_COMPLETED or PASSIVE_HALTED when stopping finishes in one step. On exception, transitions to
PASSIVE_FAILED, populates FailError, calls OnFail and rethrows.
</description>
<param name="reason">Diagnostic reason for cancellation.</param>
*)
METHOD FINAL RequestCancel
VAR_INPUT
	reason : WSTRING(255);
END_VAR
VAR
	formattedLogMessage : WSTRING(255);

	exceptionCode : __SYSTEM.ExceptionCode;
	
	stoppingState : ACTIVITY_STOPPING_STATE;
	haltReason : WSTRING(255);
END_VAR
VAR CONSTANT
	targetState : WORKFLOW_ELEMENT_STATE := WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Cancel requested for activity '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, "Activity", "ActivityRequest", "ActivityRequestCancel");

IF NOT Workflows.ValidateTransition(_State, targetState) THEN
	RETURN;
END_IF

SetNewState(targetState);
_CancelReason := reason;

__TRY	
	stoppingState := OnStopping(TRUE, FALSE, haltReason => haltReason); 

	CASE stoppingState OF
		ACTIVITY_STOPPING_STATE.WORK_STOPPED:
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED);
			
		ACTIVITY_STOPPING_STATE.WORK_COMPLETED:
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED);
			
		ACTIVITY_STOPPING_STATE.WORK_HALTED:
			_HaltReason := haltReason;
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED);
	END_CASE
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{b882054b-41a4-4a62-9946-6bd084653f81}">
      <Declaration><![CDATA[(*!
<summary>Requests resetting from a finished passive state and runs the initial resetting step.</summary>
<description>
Permitted from PASSIVE_COMPLETED, PASSIVE_HALTED, PASSIVE_CANCELLED and PASSIVE_FAILED; no-op in other states.
Transitions to ACTIVE_RESETTING and invokes OnResetting(TRUE). When WORK_RESET is returned immediately, clears
FailError, CancelReason and HaltReason and transitions to PASSIVE_READY in the same call. On exception,
transitions to PASSIVE_FAILED, populates FailError, calls OnFail and rethrows.
</description>
*)
METHOD FINAL RequestReset
VAR
	formattedLogMessage : WSTRING(255);
	
	exceptionCode : __SYSTEM.ExceptionCode;
	resettingState : ACTIVITY_RESETTING_STATE;
END_VAR
VAR CONSTANT
	targetState : WORKFLOW_ELEMENT_STATE := WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Reset requested for activity '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, "Activity", "ActivityRequest", "ActivityRequestReset");

IF NOT Workflows.ValidateTransition(_State, targetState) THEN
	RETURN;
END_IF

SetNewState(targetState);

__TRY
	resettingState := OnResetting(TRUE);

	IF resettingState = ACTIVITY_RESETTING_STATE.WORK_RESET THEN
		_FailError.Clear();
		_CancelReason := "";
		_HaltReason := "";
		SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_READY);
	END_IF
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{09722d60-5a50-4ba0-834d-aa751d69d95a}">
      <Declaration><![CDATA[(*!
<summary>Requests a fresh start from PASSIVE_READY or resumes from PASSIVE_SUSPENDED and runs the initial step.</summary>
<description>
No-op when the current state cannot transition to ACTIVE_RUNNING. Clears prior run diagnostics, transitions to
ACTIVE_RUNNING and invokes OnRunning. Transitions immediately to PASSIVE_COMPLETED or PASSIVE_HALTED if finished
in one step. On exception, transitions to PASSIVE_FAILED, populates FailError, calls OnFail and rethrows.
</description>
*)
METHOD FINAL RequestStart
VAR
	formattedLogMessage : WSTRING(255);

	resuming : BOOL;
	
	exceptionCode : __SYSTEM.ExceptionCode;
	
	runningState : ACTIVITY_RUNNING_STATE;
	haltReason : WSTRING(255);
END_VAR
VAR CONSTANT
	targetState : WORKFLOW_ELEMENT_STATE := WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Start requested for activity '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, "Activity", "ActivityRequest", "ActivityRequestStart");

IF NOT Workflows.ValidateTransition(_State, targetState) THEN
	RETURN;
END_IF

resuming := _State = WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED;

SetNewState(targetState);

_FailError.Clear();
_CancelReason := "";
_HaltReason := "";

__TRY
	runningState := OnRunning(NOT resuming, resuming, haltReason => haltReason); 

	CASE runningState OF
		ACTIVITY_RUNNING_STATE.WORK_COMPLETED:
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED);
			
		ACTIVITY_RUNNING_STATE.WORK_HALTED:
			_HaltReason := haltReason;
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED);
	END_CASE
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestSuspend" Id="{2ed6294f-7e81-48bb-96fc-22593c00015d}">
      <Declaration><![CDATA[(*!
<summary>Requests cooperative suspension from ACTIVE_RUNNING and runs the initial stopping step.</summary>
<description>
No-op when the current state cannot transition to ACTIVE_SUSPENDING. Transitions to ACTIVE_SUSPENDING and
invokes OnStopping(FALSE, TRUE). Transitions immediately to PASSIVE_SUSPENDED, PASSIVE_COMPLETED or
PASSIVE_HALTED if stopping finishes in one step. On exception, transitions to PASSIVE_FAILED, populates
FailError, calls OnFail and rethrows.
</description>
*)
METHOD FINAL RequestSuspend
VAR
	formattedLogMessage : WSTRING(255);

	exceptionCode : __SYSTEM.ExceptionCode;
	
	stoppingState : ACTIVITY_STOPPING_STATE;
	haltReason : WSTRING(255);
END_VAR
VAR CONSTANT
	targetState : WORKFLOW_ELEMENT_STATE := WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Suspend requested for activity '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, "Activity", "ActivityRequest", "ActivityRequestSuspend");

IF NOT Workflows.ValidateTransition(_State, targetState) THEN
	RETURN;
END_IF

SetNewState(targetState);

__TRY	
	stoppingState := OnStopping(FALSE, TRUE, haltReason => haltReason); 

	CASE stoppingState OF
		ACTIVITY_STOPPING_STATE.WORK_STOPPED:
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED);
			
		ACTIVITY_STOPPING_STATE.WORK_COMPLETED:
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED);
			
		ACTIVITY_STOPPING_STATE.WORK_HALTED:
			_HaltReason := haltReason;
			SetNewState(WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED);
	END_CASE
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetNewState" Id="{7af2da96-4196-4a37-93e6-687784f94a02}" FolderPath="Internal methods\">
      <Declaration><![CDATA[(*!
<summary>Updates the activity state, records the transition flag and logs the state change.</summary>
<description>
No-op when newState equals the current state.
</description>
<param name="newState">New workflow element state to assign.</param>
*)
METHOD PROTECTED FINAL SetNewState
VAR_INPUT
	newState : WORKFLOW_ELEMENT_STATE;
END_VAR
VAR
	formattedLogMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _State = newState THEN
	RETURN;
END_IF

formattedLogMessage := TOF_Core.WideStrings.Concat255("Activity '", Name, "' state changed from '", TO_WSTRING(_State), "' to '", TO_WSTRING(newState), "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, "Activity", "ActivitySetNewState");

_PreviousState := _State;
_State := newState;
_StateChanged := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{201c6b82-3a53-42a5-a4be-54bc270d67ef}">
      <Declaration><![CDATA[(*!
<summary>Returns the current lifecycle state of the activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL State : WORKFLOW_ELEMENT_STATE]]></Declaration>
      <Get Name="Get" Id="{a6a927b4-af82-407a-901f-2a288505a083}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[State := _State;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryGetVariable" Id="{7404742e-521b-4644-b536-622820cce67b}">
      <Declaration><![CDATA[(*!
<summary>Attempts to resolve a named variable from this activity, its ancestor activities or the workflow.</summary>
<description>
Returns FALSE when resolution fails or a nested call raises an exception. Use the output only when TRUE is
returned. Does not propagate exceptions or clear terminal allocation state.
</description>
<param name="name">Case-sensitive variable name to look up.</param>
<param name="variable">Resolved variable value when TRUE is returned.</param>
*)
METHOD TryGetVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryGetVariable := _Variables.TryGetValueByKey(name, value => variable);

	IF NOT TryGetVariable AND_THEN _ParentActivity <> 0 THEN
		TryGetVariable := _ParentActivity.TryGetVariable(name, variable => variable);
	END_IF

	IF NOT TryGetVariable AND_THEN _Workflow <> 0 THEN
		TryGetVariable := _Workflow.TryGetVariable(name, variable => variable);
	END_IF
__CATCH
	TryGetVariable := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="Workflow" Id="{5b9f0838-cfd8-4e68-96b0-62c7d023998f}">
      <Declaration><![CDATA[(*!
<summary>Returns the workflow associated with this activity or inherited from its parent activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Workflow : IWorkflow]]></Declaration>
      <Get Name="Get" Id="{82ce28f2-8424-4b0f-9ba1-3ba80b3f14e7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Workflow <> 0 THEN
	Workflow := _Workflow;
ELSIF _ParentActivity <> 0 THEN
	Workflow := _ParentActivity.Workflow;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>