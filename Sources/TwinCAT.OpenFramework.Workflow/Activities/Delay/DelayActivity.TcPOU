<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DelayActivity" Id="{94699601-e9ed-4592-833c-e4e6759ce03e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Waits for the configured Interval using an internal TON timer before completing.</summary>
<description>
Only active running time counts toward Interval. Suspension snapshots the elapsed active segment and
deactivates the timer; resuming waits for the remaining duration. Repeated pauses preserve accumulated time.
A fresh start, cancellation, failure or reset clears accumulated time without changing Interval.
Use one owner task without reentry; timing is observed on cooperative calls at native TON precision.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK DelayActivity EXTENDS Activity IMPLEMENTS IDelayActivity, TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Timer : Tc2_Standard.TON;

	// Configured total active duration, independent of the current timer segment.
	_Interval : TIME;
	// Active time retained from completed segments before suspension.
	_ElapsedBeforeSegment : TIME;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{8f495b21-4328-485c-a5b8-5d15a9939e76}" />
    <Folder Name="Service methods" Id="{39478f12-70be-4d92-bb8a-115f7918a994}" />
    <Property Name="ClassName" Id="{99031060-eb4d-44c6-bf8d-9db6d8f4facd}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7b66933e-2fad-4721-b44b-551fae9394b7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Interval" Id="{daabaad1-5c20-4f74-afaa-15249ee65d86}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the total active duration.</summary>
<description>
Changing Interval changes the target for accumulated active time, including after suspension.
The new target is applied on the next running or stopping call. Suspended wall time is excluded.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Interval : TIME]]></Declaration>
      <Get Name="Get" Id="{1abcca3c-4b5b-4e4d-a54a-fa4c23acf5bf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Interval := _Interval;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{ef745e0e-2a9d-4737-820c-34f86af7494d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Interval := Interval;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{74cc9664-6f44-4467-967e-c02431fb9266}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0e2b87df-357b-4365-b650-6deb72911a5c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnFail" Id="{a31f42e8-5241-48d9-9e77-86a3109f4c15}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Deactivates the internal timer when the activity fails.</summary>
<param name="exception">Caught exception that caused the failure.</param>
*)
METHOD PROTECTED OnFail
VAR_INPUT
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ElapsedBeforeSegment := TOF_Core.Times.MIN_VALUE;
_Timer(IN := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnResetting" Id="{b69e2170-12a4-4f63-91b8-63497c0512a0}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resets the internal timer and completes resetting in a single step.</summary>
<param name="startResetting">TRUE on the initial call from RequestReset.</param>
*)
METHOD PROTECTED OnResetting : ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ElapsedBeforeSegment := TOF_Core.Times.MIN_VALUE;
_Timer(IN := FALSE);

OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{4cc3a8ee-0e87-4b89-9f30-39f8aec06adb}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Advances the delay timer and completes when the configured interval elapses.</summary>
<param name="startRunning">TRUE on the initial call of a fresh start.</param>
<param name="startResuming">TRUE on the initial call when resuming from suspension.</param>
<param name="haltReason">Unused halt reason output.</param>
*)
METHOD PROTECTED OnRunning : ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF startRunning THEN
	_ElapsedBeforeSegment := TOF_Core.Times.MIN_VALUE;
	_Timer(IN := FALSE);
END_IF

advanceTimer();

IF _Timer.Q THEN
	OnRunning := ACTIVITY_RUNNING_STATE.WORK_COMPLETED;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{94638f0f-931e-47a0-91a7-8200eee6e478}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Snapshots active elapsed time for suspension or clears it for cancellation.</summary>
<description>
An expired segment is retained as a zero remainder; resume then completes on its first observation.
The snapshot is clamped to the current segment target so accumulated TIME cannot overflow.
</description>
<param name="startCancelling">TRUE when stopping due to cancellation.</param>
<param name="startSuspending">TRUE when stopping due to suspension.</param>
<param name="haltReason">Unused halt reason output.</param>
*)
METHOD PROTECTED OnStopping : ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF startSuspending THEN
	advanceTimer();
	_ElapsedBeforeSegment := _ElapsedBeforeSegment + MIN(_Timer.ET, _Timer.PT);
ELSIF startCancelling THEN
	_ElapsedBeforeSegment := TOF_Core.Times.MIN_VALUE;
END_IF

_Timer(IN := FALSE);

OnStopping := ACTIVITY_STOPPING_STATE.WORK_STOPPED;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{ad9a3f84-13f9-40de-a533-562bb92a2b3c}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8276e7d1-1622-45cb-a22e-0bf694631cef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="advanceTimer" Id="{5fbf51dc-64be-4493-9eea-d2559b48d6da}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Advances one active timer segment against the remaining configured duration.

Subtracts only time retained from earlier active segments. PT is zero when the retained time
already meets the current target, so the next running observation can complete immediately.
*)
METHOD PRIVATE advanceTimer
VAR
	remainingInterval : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ElapsedBeforeSegment < _Interval THEN
	remainingInterval := _Interval - _ElapsedBeforeSegment;
ELSE
	remainingInterval := TOF_Core.Times.MIN_VALUE;
END_IF

_Timer(IN := TRUE, PT := remainingInterval);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Serialize" Id="{314498d9-2801-418c-902e-5c210fdd48c0}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
writer.WriteValue(
	name := 'interval',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TIME,
	data := ADR(_Interval),
	size := SIZEOF(_Interval)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{50138a7c-2a4a-470c-8b10-ce501fce96c7}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader and document node are borrowed for this call. On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Configuration deserialization context; ignored by this context-free element.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

reader.ReadValue(
	node := reader.GetField(node := node, name := 'interval'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TIME,
	data := ADR(_Interval),
	size := SIZEOF(_Interval)
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>