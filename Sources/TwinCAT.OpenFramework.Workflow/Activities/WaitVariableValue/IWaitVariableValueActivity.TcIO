<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWaitVariableValueActivity" Id="{bd87ac38-223d-42cd-a17d-53721728f7d5}">
    <Declaration><![CDATA[(*!
<summary>Configures an activity that waits for a workflow variable to match a reference value.</summary>
<description>Configure must succeed before execution. The standard implementation creates its workflow-owned condition on first Configure and reuses it thereafter.</description>
*)
INTERFACE IWaitVariableValueActivity EXTENDS IActivity]]></Declaration>
    <Method Name="Configure" Id="{90209635-4608-461f-9642-5e45e21cd302}">
      <Declaration><![CDATA[(*!
<summary>Prepares the variable comparison outside lifecycle initialization.</summary>
<description>Requires an associated live workflow. Allocation, registration and configuration failures propagate. Failed condition configuration leaves the standard activity unconfigured; a registered condition remains owned by the workflow.</description>
*)
METHOD Configure
VAR_INPUT
	monitoredVariableName : STRING;
	referenceValue : ANY; 
END_VAR]]></Declaration>
    </Method>
    <Property Name="MonitoredVariableName" Id="{f2b786aa-ed05-447a-b723-9472d0a9eed9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Returns the monitored variable name, or empty text before the condition exists.</summary>
*)
PROPERTY MonitoredVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{b4ef17a7-4b5d-4711-b229-7562bf4d97e0}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="ReferenceValue" Id="{5659c8e6-e1ea-4d0a-b25b-bee4b290af96}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Returns the borrowed comparison value, or a null reference before the condition exists.</summary>
<description>The reference does not transfer ownership and expires when the condition is disposed.</description>
*)
PROPERTY ReferenceValue : REFERENCE TO TOF_Core.GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{c4d70835-0306-472e-be4e-4502ed11a9f2}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>