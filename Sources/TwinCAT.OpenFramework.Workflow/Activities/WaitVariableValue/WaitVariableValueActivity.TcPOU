<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WaitVariableValueActivity" Id="{9ae865c9-381c-4131-8577-ff22adc6b1cb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Waits until a workflow variable matches a configured value.</summary>
<description>
Its internal condition is created and registered on first Configure, not in FB_init. Configure must succeed
before execution. The condition is workflow-owned; repeated Configure calls reuse it. Before creation,
MonitoredVariableName is empty and ReferenceValue is null.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK WaitVariableValueActivity EXTENDS Activity
	IMPLEMENTS IWaitVariableValueActivity, TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_Condition : IVariableHasValueCondition;
	
	{attribute 'OPC.UA.DA' := '0'}
	_Configured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{8412ec91-76db-482a-a924-118e69d7a5b3}" />
    <Property Name="ClassName" Id="{5c1e7de8-a73a-4579-86b9-30ac60fa937d}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a92381e9-5ead-4d5c-ab57-a136eefe5cae}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{7d435cb4-1a46-4754-a63c-ac457cf11689}">
      <Declaration><![CDATA[(*!
<summary>Creates the internal condition on first use and configures the value to wait for.</summary>
<description>
Requires an associated live workflow. Registers the condition before configuring it; the workflow owns it
until disposal. Later calls reuse the condition. A failed condition configuration leaves this activity
unconfigured. Allocation and configuration failures propagate from this ordinary method, never from FB_init.
</description>
<param name="monitoredVariableName">Non-empty name of the variable to monitor.</param>
<param name="referenceValue">Non-empty reference value to compare against.</param>
*)
METHOD Configure
VAR_INPUT
	monitoredVariableName : STRING;
	referenceValue : ANY; 
END_VAR
VAR
	ownerWorkflow : IWorkflow;

	condition : POINTER TO VariableHasValueCondition; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF monitoredVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'monitoredVariableName',
		argumentValue := monitoredVariableName
	);
END_IF

IF referenceValue.pValue = TOF_Core.Memory.NULL_ADDRESS OR_ELSE referenceValue.diSize = TOF_Core.SignedInt32.ZERO THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'referenceValue'
	);
END_IF

ownerWorkflow := Workflow;

IF ownerWorkflow = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'Workflow'
	);
END_IF

IF State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY OR_ELSE ownerWorkflow.Busy THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot configure activity outside PASSIVE_READY"
	);
END_IF

_Configured := FALSE;

IF _Condition = 0 THEN
	condition := __NEW(VariableHasValueCondition(workflow := ownerWorkflow));

	IF condition = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	ownerWorkflow.RegisterChild(child := condition^);
	condition^.ParentActivity := THIS^;
	_Condition := condition^;
END_IF

_Condition.Configure(monitoredVariableName := monitoredVariableName, referenceValue := referenceValue);

_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="MonitoredVariableName" Id="{1d438d91-52fe-4f5c-94af-3d961ae45a4b}">
      <Declaration><![CDATA[(*!
<summary>Returns the monitored variable name, or an empty string before the condition is created.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY MonitoredVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{7e079cbe-d346-42a9-a0e0-28dfd64715e9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Condition <> 0 THEN
	MonitoredVariableName := _Condition.MonitoredVariableName;
ELSE
	MonitoredVariableName := '';
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0eca60f1-3ad0-45f4-9350-48fe6eeb70ab}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3db6f1bc-e1fe-47de-b6d8-6402ce4cd8f9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnRunning" Id="{7256e873-ad90-40ce-9bfb-e8e3b6c4fdf7}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Evaluates the internal variable condition and completes when it becomes TRUE.</summary>
<param name="startRunning">TRUE on the initial call of a fresh start.</param>
<param name="startResuming">TRUE on the initial call when resuming from suspension.</param>
<param name="haltReason">Unused halt reason output.</param>
*)
METHOD PROTECTED OnRunning : ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Configured THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Activity is not configured"
	);
END_IF

IF _Condition.Evaluate(activity := THIS^) THEN
	OnRunning := ACTIVITY_RUNNING_STATE.WORK_COMPLETED;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{cb35b0b4-7e4b-4f21-962e-9df35e5ede20}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Stops waiting immediately on cancel or suspend.</summary>
<param name="startCancelling">TRUE when stopping due to cancellation.</param>
<param name="startSuspending">TRUE when stopping due to suspension.</param>
<param name="haltReason">Unused halt reason output.</param>
*)
METHOD PROTECTED OnStopping : ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnStopping := ACTIVITY_STOPPING_STATE.WORK_STOPPED;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ReferenceValue" Id="{dc6c9824-324d-4558-96e2-a00d3db704a7}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed reference to the configured comparison value.</summary>
<description>
Returns a null reference before the condition is created. The reference does not transfer ownership and
expires when the workflow disposes the condition. It does not make GENERIC_VALUE immutable; callers must
not mutate, release or reset the borrowed descriptor. Reconfiguration may replace its referenced payload.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ReferenceValue : REFERENCE TO TOF_Core.GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{0bc02602-5ac3-40ea-858c-396fd965ca04}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Condition <> 0 THEN
	ReferenceValue REF= _Condition.ReferenceValue;
ELSE
	ReferenceValue REF= 0;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3f5f0120-d7c8-4add-9536-e28f1761d2c8}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3527654b-3ddf-4158-95e1-bba81c3a40b2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Serialize" Id="{7cada42d-e6a0-4826-b6cd-e9c00b08cf5d}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
Workflows.WriteConfigurationObject(writer := writer, name := 'condition', source := _Condition);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{43b2cbf5-b442-4130-a1af-02370066edad}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and deserialization context are borrowed for this call.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Active configuration deserialization context providing workflow reconstruction services.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[loader := WorkflowConfigurationSerializer.ResolveWorkflowLoader(context := context);
Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

_Condition := Workflows.ReadVariableHasValueCondition(
	loader := loader,
	node := reader.GetField(node := node, name := 'condition')
);
Workflows.ValidateElementAttachment(parent := THIS^, child := _Condition);
_Condition.ParentActivity := THIS^;
_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>