<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWaitConditionActivity" Id="{0cefaf0d-4ae9-47b9-8f8d-e636a560d87a}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines the contract for an activity that waits until an arbitrary workflow condition evaluates to TRUE.</summary>
<description>
Advances cyclic execution until the associated condition evaluates to TRUE, then transitions to PASSIVE_COMPLETED.
Accepts simple, variable-based, composite (AND/OR), or custom condition implementations.
</description>
*)

INTERFACE IWaitConditionActivity EXTENDS IActivity
]]></Declaration>
    <Property Name="Condition" Id="{960bfa25-ba1a-4222-80a3-1359b946b290}">
      <Declaration><![CDATA[(*!
<summary>Returns the condition being evaluated, or 0 before configuration.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{4a9d6524-357e-4744-aaba-474fc163ec8b}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Configured" Id="{0ace7a5a-e627-4c38-8a84-290f9229d0de}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the condition has been configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{db3ddcb3-657c-4070-be26-7ddb756d1f28}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{142fa54f-1e2c-4c26-afda-45aa5107564f}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to wait for.</summary>
<description>
Validates that the condition is live, unattached to another parent, and establishes the parent link.
</description>
<param name="condition">Condition to evaluate during execution.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>

