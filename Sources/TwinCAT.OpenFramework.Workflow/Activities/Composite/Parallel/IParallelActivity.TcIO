<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IParallelActivity" Id="{99ef2618-3f5c-4a3d-969a-e66547637f2d}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines the contract for a composite activity that coordinates multiple child activities in parallel.</summary>
<description>
Child activities are advanced concurrently in each cyclic execution step according to the configured Mode
(WAIT_ALL or WAIT_ANY). Propagates cancellation, suspension and resetting across all active branches.
</description>
*)

INTERFACE IParallelActivity EXTENDS ICompositeActivity
]]></Declaration>
    <Method Name="AddChildActivity" Id="{a0c02063-95f5-429e-a2b1-fb41ef37290a}">
      <Declaration><![CDATA[(*!
<summary>Appends a child activity to be executed in parallel and returns its zero-based index.</summary>
<description>
Permitted only in PASSIVE_READY. Validates that the activity belongs to the same workflow, is not already
attached, and does not form an ancestor cycle.
The standard implementation also rejects duplicate slots, validates fixed workflow association and requires
the parent chain and owning workflow to be PASSIVE_READY before mutation. Child storage remains borrowed.
</description>
<param name="activity">Child activity to execute concurrently.</param>
*)
METHOD AddChildActivity : DINT
VAR_INPUT
	activity : IActivity;
END_VAR]]></Declaration>
    </Method>
    <Property Name="ChildCount" Id="{7f9ecacc-5e9f-4150-a5ad-ad7b8406e424}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of child activities registered for parallel execution.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ChildCount : DINT]]></Declaration>
      <Get Name="Get" Id="{b9e5bd17-d7cb-4553-87e7-dc7587cac9d8}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="GetChildActivity" Id="{ed4278e2-1f12-470b-b1dc-15b0d128eec4}">
      <Declaration><![CDATA[(*!
<summary>Returns the child activity at the specified zero-based index, or 0 if the index is out of bounds.</summary>
<param name="index">Zero-based index of the child activity.</param>
*)
METHOD GetChildActivity : IActivity
VAR_INPUT
	index : DINT;
END_VAR]]></Declaration>
    </Method>
    <Property Name="Mode" Id="{e6adfbd9-2ac7-4de2-9013-c0b1b5d39bdc}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the join completion mode (WAIT_ALL or WAIT_ANY).</summary>
<description>
Can only be modified while the activity is in PASSIVE_READY.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Mode : PARALLEL_JOIN_MODE]]></Declaration>
      <Get Name="Get" Id="{1fd99a44-29a9-4b6d-b225-bead49f914a6}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{6a830a89-0c1c-48fc-95c0-fd83b318b512}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
  </Itf>
</TcPlcObject>
