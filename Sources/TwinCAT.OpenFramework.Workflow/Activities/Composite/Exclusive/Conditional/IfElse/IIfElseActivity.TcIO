<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IIfElseActivity" Id="{16178d2f-3332-4efd-9137-c92499576b3d}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a conditional composite activity that selects between TrueActivity and FalseActivity based on Condition.</summary>
*)

INTERFACE IIfElseActivity EXTENDS IExclusiveCompositeActivity]]></Declaration>
    <Property Name="Condition" Id="{6022379b-e762-487a-b202-ef98227acc54}">
      <Declaration><![CDATA[(*!
<summary>Returns the branching condition configured for this activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{97ac08d1-4c48-4205-99dc-a466a2da90ff}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{c6c70909-4317-4fc7-a63f-e21924dbbf3f}">
      <Declaration><![CDATA[(*!
<summary>Configures the required branching condition and optional true/false branch activities.</summary>
<description>
Permitted only in PASSIVE_READY. Condition is required; trueActivity and falseActivity are optional (0 completes
immediately when that branch is selected). Assigns THIS^ as ParentActivity of all non-null arguments.
</description>
<param name="condition">Required branching condition.</param>
<param name="trueActivity">Activity executed when condition evaluates to TRUE, or 0 for no action.</param>
<param name="falseActivity">Activity executed when condition evaluates to FALSE, or 0 for no action.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition; 
	trueActivity : IActivity;
	falseActivity : IActivity;
END_VAR]]></Declaration>
    </Method>
    <Property Name="FalseActivity" Id="{68759ad4-444a-491f-804f-0356aa5c7c25}">
      <Declaration><![CDATA[(*!
<summary>Returns the optional branch activity executed when Condition evaluates to FALSE.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FalseActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{ca2105be-b58c-48bb-a4b7-c0a379d825b2}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="TrueActivity" Id="{93aee4f4-c6f4-4d2e-926e-53ab0d43d05c}">
      <Declaration><![CDATA[(*!
<summary>Returns the optional branch activity executed when Condition evaluates to TRUE.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY TrueActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{bafa0510-d2c3-45b0-b482-c7d14c272063}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>