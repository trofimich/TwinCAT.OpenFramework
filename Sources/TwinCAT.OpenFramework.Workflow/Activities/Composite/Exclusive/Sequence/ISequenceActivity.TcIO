<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ISequenceActivity" Id="{3eb944e8-a267-4a3d-8fea-2b3b93b26903}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a composite activity that executes its child activities sequentially in registration order.</summary>
*)

INTERFACE ISequenceActivity EXTENDS IExclusiveCompositeActivity]]></Declaration>
    <Method Name="AddChildActivity" Id="{04f72df1-a772-44a1-b34a-c7d842113158}">
      <Declaration><![CDATA[(*!
<summary>Appends a child activity to the end of the execution sequence.</summary>
<description>
Permitted only in PASSIVE_READY. Rejects null references, cycles and children already attached to another parent.
</description>
<param name="activity">Child activity to append.</param>
*)
METHOD AddChildActivity
VAR_INPUT
	activity : IActivity;
END_VAR]]></Declaration>
    </Method>
    <Property Name="CurrentActivityIndex" Id="{d35c1b33-4eab-46e1-92b2-ee79dc6e6f94}">
      <Declaration><![CDATA[(*!
<summary>Returns the zero-based index of the currently selected child activity, or -1 when none is selected.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY CurrentActivityIndex : DINT]]></Declaration>
      <Get Name="Get" Id="{6c5f20b4-e1d8-4bb9-b688-37a7566e6b01}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>