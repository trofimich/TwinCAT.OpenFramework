<TcPlcObject Version="1.1.0.1">
  <POU Name="ExclusiveCompositeActivity" Id="{13ce720f-cc4b-4c1a-8e26-2a31330dfb74}" SpecialFunc="None">
    <Declaration><![CDATA[(*
