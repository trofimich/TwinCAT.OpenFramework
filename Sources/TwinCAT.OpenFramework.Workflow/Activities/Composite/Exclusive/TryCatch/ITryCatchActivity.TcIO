<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITryCatchActivity" Id="{1bca1e03-10ec-417e-93ae-501fabcf9ba7}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a composite activity that runs TryActivity and transitions to an optional CatchActivity on exception.</summary>
*)

INTERFACE ITryCatchActivity EXTENDS IExclusiveCompositeActivity]]></Declaration>
    <Property Name="CatchActivity" Id="{b348b41c-ecce-4d30-90d2-ed9892f02a83}">
      <Declaration><![CDATA[(*!
<summary>Returns the optional recovery activity executed when TryActivity raises an exception.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY CatchActivity : ICatchActivity]]></Declaration>
      <Get Name="Get" Id="{60f3de0b-9831-4729-ab66-ea77e083be6d}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{63764e91-9a98-466a-841e-f64ae503d707}">
      <Declaration><![CDATA[(*!
<summary>Configures the required TryActivity and optional CatchActivity.</summary>
<description>
Permitted only in PASSIVE_READY. TryActivity is required; CatchActivity is optional (when 0, exceptions from
TryActivity propagate directly to the parent). Assigns THIS^ as ParentActivity of supplied activities.
</description>
<param name="tryActivity">Required primary activity to execute.</param>
<param name="catchActivity">Optional recovery activity invoked when tryActivity fails, or 0.</param>
*)
METHOD Configure
VAR_INPUT
	tryActivity : IActivity;
	catchActivity : ICatchActivity;
END_VAR]]></Declaration>
    </Method>
    <Property Name="TryActivity" Id="{209431fa-76e0-4f67-94da-023526611134}">
      <Declaration><![CDATA[(*!
<summary>Returns the primary activity executed by this composite.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY TryActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{66ee0b5d-146e-471c-ab8f-68349b611974}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>