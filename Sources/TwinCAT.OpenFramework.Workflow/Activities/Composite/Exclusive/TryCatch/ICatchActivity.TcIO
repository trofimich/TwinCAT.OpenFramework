(*!
<summary>Defines a recovery activity that captures diagnostics from a caught exception before starting.</summary>
<description>
Implementations must copy any required diagnostic data synchronously inside CaptureException and must not
retain the task-scoped exception interface reference across PLC cycles.
</description>
*)

INTERFACE ICatchActivity EXTENDS IActivity]]></Declaration>
    <Method Name="CaptureException" Id="{a6a91d52-24f4-4c8d-9338-3f24472c8529}">
      <Declaration><![CDATA[(*!
<summary>Copies diagnostic information from the caught exception before recovery starts.</summary>
<description>
The exception reference is borrowed only for the duration of this call; implementations must copy diagnostic
fields into durable storage such as TOF_Core.ERROR and must not store the interface reference.
</description>
<param name="exception">Caught exception from the failed try branch.</param>
*)
METHOD CaptureException
VAR_INPUT
	exception : TOF_Core.IReadOnlyException;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>