<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ICatchActivity" Id="{bf83e861-7199-4d36-97c5-f986b856fb57}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a recovery activity that captures diagnostics from a caught exception before starting.</summary>
<description>
Implementations copy required diagnostic data synchronously inside CaptureException without retaining
task-scoped exception references across PLC cycles. May execute an optional recovery activity.
</description>
*)

INTERFACE ICatchActivity EXTENDS IExclusiveCompositeActivity]]></Declaration>
    <Property Name="Error" Id="{5a0d24ae-6aa2-4154-b5ec-f69e686f63d3}">
      <Declaration><![CDATA[(*!
<summary>Exposes a borrowed read-only view of the captured recovery diagnostics.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Error : REFERENCE TO TOF_Core.ERROR]]></Declaration>
      <Get Name="Get" Id="{52f39ac3-8ae3-48a3-87b5-7f9d50afa8b7}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="RecoveryActivity" Id="{4c6da190-17dc-48b3-a06e-aa6ba1c3664b}">
      <Declaration><![CDATA[(*!
<summary>Returns the optional recovery activity executed upon exception, or 0.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY RecoveryActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{748e882d-8fb7-4988-90aa-6735865f29b9}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="CaptureException" Id="{a6a91d52-24f4-4c8d-9338-3f24472c8529}">
      <Declaration><![CDATA[(*!
<summary>Copies diagnostic information from the caught exception before recovery starts.</summary>
<description>
The exception reference is borrowed only for the duration of this call; implementations must copy diagnostic
fields into durable storage such as TOF_Core.ERROR and must not store the interface reference.
</description>
<param name="exception">Caught exception from the failed try branch.</param>
*)
METHOD CaptureException
VAR_INPUT
	exception : TOF_Core.IReadOnlyException;
END_VAR]]></Declaration>
    </Method>
    <Method Name="Configure" Id="{f0daec18-afa8-4762-af92-1bf3f68d775d}">
      <Declaration><![CDATA[(*!
<summary>Configures the optional recovery activity executed after an exception is caught.</summary>
<description>
Permitted only in PASSIVE_READY. When recoveryActivity is 0, the catch block captures exception diagnostics
and completes immediately with WORK_COMPLETED. Assigns THIS^ as ParentActivity of recoveryActivity.
</description>
<param name="recoveryActivity">Optional recovery activity to execute, or 0.</param>
*)
METHOD Configure
VAR_INPUT
	recoveryActivity : IActivity;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>