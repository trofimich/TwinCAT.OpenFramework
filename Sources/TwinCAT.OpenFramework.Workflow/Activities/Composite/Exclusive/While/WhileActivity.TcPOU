(*!
<summary>Repeats its body activity while the configured Condition evaluates to TRUE.</summary>
<description>
Evaluates Condition before starting the first iteration and at the boundary after each completed body
iteration. Before starting a subsequent iteration, resets the completed body child back to PASSIVE_READY via
ResetChildActivity. An empty body with a TRUE condition remains in ACTIVE_RUNNING and re-evaluates Condition
once per Execute call.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK WhileActivity EXTENDS ExclusiveCompositeActivity
	IMPLEMENTS IWhileActivity, TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_Condition : ICondition;

	{attribute 'OPC.UA.DA' := '0'}
	_Body : IActivity;

	{attribute 'OPC.UA.DA' := '0'}
	_CurrentActivity : IActivity;

	{attribute 'OPC.UA.DA' := '0'}
	_ResettingBodyBetweenIterations : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{3a846102-1275-47f2-95f8-2c49e0a298d1}" />
    <Property Name="Body" Id="{fa7258ea-4392-4132-adce-c58b4750d291}">
      <Declaration><![CDATA[(*!
<summary>Returns the body activity executed by this loop, or 0 when no body is configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Body : IActivity]]></Declaration>
      <Get Name="Get" Id="{49890a1c-4740-458e-9012-fab58d54288a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Body := _Body;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{e8c310a9-25a5-40fb-af06-20c97f669e26}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9c476135-c2c6-4e6b-963b-cf0d4c8a0c66}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Condition" Id="{1569931e-587f-4563-a5bc-90730247f2a7}">
      <Declaration><![CDATA[(*!
<summary>Returns the loop continuation condition configured for this activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{99562b20-36d6-457b-8c31-a7b8437d4df1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Condition := _Condition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{977f0425-c37b-4e6b-8b39-b78bbd4d800a}">
      <Declaration><![CDATA[(*!
<summary>Configures the required loop condition and optional body activity.</summary>
<description>
Permitted only in PASSIVE_READY. Condition is required; body is optional (when 0, evaluates condition
cyclically without advancing a body activity). Validates readiness, cycles and fixed workflow association.
Reusing the same dependency is permitted. Replaced dependencies retain their existing parent links.
Dependencies remain borrowed.
</description>
<param name="condition">Condition evaluated before each iteration.</param>
<param name="body">Activity executed repeatedly while condition evaluates to TRUE, or 0.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition;
	body : IActivity;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'condition'
	);
END_IF

IF State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot configure WhileActivity outside PASSIVE_READY"
	);
END_IF

Workflows.ValidateElementAttachment(parent := THIS^, child := condition);

IF body <> 0 THEN
	ValidateChildActivityAttachment(childActivity := body, argumentName := 'body');
END_IF

_Condition := condition;
_Condition.ParentActivity := THIS^;

_Body := body;

IF _Body <> 0 THEN
	_Body.ParentActivity := THIS^;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="CurrentActivity" Id="{ddb547c6-759a-42be-a54c-4381ef8a677e}">
      <Declaration><![CDATA[(*!
<summary>Returns the currently executing body activity, or 0 when at iteration boundary or idle.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CurrentActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{0b9c8683-9105-4105-9dc6-cdab8264bd50}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentActivity := _CurrentActivity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{86bb5599-d10e-42fb-95c9-1264df59ae02}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8a7a6027-3e8c-4f60-888c-7717a6b92a11}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnResetting" Id="{39e8d779-269c-49d0-821a-8cf503e6b215}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resets the body activity back to PASSIVE_READY and clears loop execution state.</summary>
<param name="startResetting">TRUE on the initial call from RequestReset.</param>
*)
METHOD PROTECTED OnResetting : ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Body <> 0 AND_THEN _Body.State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
	IF ResetChildActivity(childActivity := _Body) = ACTIVITY_RESETTING_STATE.WORK_IN_PROGRESS THEN
		OnResetting := ACTIVITY_RESETTING_STATE.WORK_IN_PROGRESS;
		RETURN;
	END_IF
END_IF

_ResettingBodyBetweenIterations := FALSE;
_CurrentActivity := 0;

OnResetting := ACTIVITY_RESETTING_STATE.WORK_RESET;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{f271eeb4-f3d7-4733-877e-04b96312cb2b}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>
Evaluates Condition at iteration boundaries, resets completed body activity and advances body step per call.
</summary>
<param name="startRunning">TRUE on the initial call of a fresh start.</param>
<param name="startResuming">TRUE on the initial call when resuming from suspension.</param>
<param name="haltReason">Receives the body child's HaltReason when halted.</param>
*)
METHOD PROTECTED OnRunning : ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Condition = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'Condition'
	);
END_IF

IF startRunning THEN
	_ResettingBodyBetweenIterations := FALSE;
	_CurrentActivity := 0;
END_IF

IF _ResettingBodyBetweenIterations THEN
	IF _Body <> 0 AND_THEN ResetChildActivity(childActivity := _Body) = ACTIVITY_RESETTING_STATE.WORK_IN_PROGRESS THEN
		OnRunning := ACTIVITY_RUNNING_STATE.WORK_IN_PROGRESS;
		RETURN;
	END_IF

	_ResettingBodyBetweenIterations := FALSE;
END_IF

IF startRunning OR_ELSE _CurrentActivity = 0 THEN
	IF NOT _Condition.Evaluate(activity := THIS^) THEN
		_CurrentActivity := 0;
		OnRunning := ACTIVITY_RUNNING_STATE.WORK_COMPLETED;
		RETURN;
	END_IF

	IF _Body = 0 THEN
		OnRunning := ACTIVITY_RUNNING_STATE.WORK_IN_PROGRESS;
		RETURN;
	END_IF

	IF NOT startRunning AND_THEN NOT startResuming THEN
		IF ResetChildActivity(childActivity := _Body) = ACTIVITY_RESETTING_STATE.WORK_IN_PROGRESS THEN
			_ResettingBodyBetweenIterations := TRUE;
			OnRunning := ACTIVITY_RUNNING_STATE.WORK_IN_PROGRESS;
			RETURN;
		END_IF
	END_IF

	_CurrentActivity := _Body;
	_CurrentActivity.RequestStart();
	OnRunning := ACTIVITY_RUNNING_STATE.WORK_IN_PROGRESS;
	RETURN;
END_IF

IF _CurrentActivity <> 0 THEN
	IF startResuming THEN
		_CurrentActivity.RequestStart();
	ELSE
		_CurrentActivity.Execute();
	END_IF

	OnRunning := MapChildRunningState(childState := _CurrentActivity.State);

	IF OnRunning = ACTIVITY_RUNNING_STATE.WORK_HALTED THEN
		haltReason := _CurrentActivity.HaltReason;
	ELSIF OnRunning = ACTIVITY_RUNNING_STATE.WORK_COMPLETED THEN
		_CurrentActivity := 0;
		OnRunning := ACTIVITY_RUNNING_STATE.WORK_IN_PROGRESS;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{89d79cf2-96d5-45e4-988a-74b92e158601}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>
Stops the loop immediately at an iteration boundary, or delegates stopping to the active body activity.
</summary>
<param name="startCancelling">TRUE on the initial call from RequestCancel.</param>
<param name="startSuspending">TRUE on the initial call from RequestSuspend.</param>
<param name="haltReason">Receives the body child's HaltReason if it halts while stopping.</param>
*)
METHOD PROTECTED OnStopping : ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ResettingBodyBetweenIterations THEN
	IF _Body <> 0 AND_THEN ResetChildActivity(childActivity := _Body) = ACTIVITY_RESETTING_STATE.WORK_IN_PROGRESS THEN
		OnStopping := ACTIVITY_STOPPING_STATE.WORK_IN_PROGRESS;
		RETURN;
	END_IF

	_ResettingBodyBetweenIterations := FALSE;
END_IF

IF _CurrentActivity = 0 THEN
	OnStopping := ACTIVITY_STOPPING_STATE.WORK_STOPPED;
	RETURN;
END_IF

IF NOT _CurrentActivity.Busy THEN
	IF startCancelling AND_THEN _CurrentActivity.State = WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED THEN
		_CurrentActivity.RequestCancel(reason := _CancelReason);
	END_IF

	OnStopping := MapChildStoppingState(childState := _CurrentActivity.State);

	IF OnStopping = ACTIVITY_STOPPING_STATE.WORK_HALTED THEN
		haltReason := _CurrentActivity.HaltReason;
	END_IF

	RETURN;
END_IF

IF startCancelling THEN
	_CurrentActivity.RequestCancel(reason := _CancelReason);
ELSIF startSuspending THEN
	_CurrentActivity.RequestSuspend();
END_IF

_CurrentActivity.Execute();

OnStopping := MapChildStoppingState(childState := _CurrentActivity.State);

IF OnStopping = ACTIVITY_STOPPING_STATE.WORK_HALTED THEN
	haltReason := _CurrentActivity.HaltReason;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{2c9eb82d-325f-4688-b541-736efe376418}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9f76a8d8-910f-4548-8eb4-705d5ff59a56}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Serialize" Id="{0c96facf-005f-405c-b739-b08a499fc2bf}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
<param name="writer">Target configuration writer receiving serialized state.</param>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
Workflows.WriteConfigurationObject(writer := writer, name := 'condition', source := _Condition);

IF _Body <> 0 THEN
	Workflows.WriteConfigurationObject(writer := writer, name := 'body', source := _Body);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{94864ff5-6ba6-4924-946a-389fd6d819e8}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and deserialization context are borrowed for this call.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration node for this activity.</param>
<param name="context">Active configuration deserialization context providing workflow reconstruction services.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[loader := WorkflowConfigurationSerializer.ResolveWorkflowLoader(context := context);
Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

Configure(
	condition := Workflows.ReadCondition(loader := loader, node := reader.GetField(node := node, name := 'condition')),
	body := Workflows.ReadActivity(loader := loader, node := reader.FindField(node := node, name := 'body'))
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>