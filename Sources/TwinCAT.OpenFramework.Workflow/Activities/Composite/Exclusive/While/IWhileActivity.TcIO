<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWhileActivity" Id="{48afd1de-38c9-486e-a527-23b68379f379}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>
Defines a loop composite activity that repeats its body activity while its Condition evaluates to TRUE.
</summary>
*)

INTERFACE IWhileActivity EXTENDS IExclusiveCompositeActivity]]></Declaration>
    <Property Name="Body" Id="{b5e98de3-41de-46f4-b227-f9a8b9545985}">
      <Declaration><![CDATA[(*!
<summary>Returns the body activity executed by this loop, or 0 when no body is configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Body : IActivity]]></Declaration>
      <Get Name="Get" Id="{fdec2897-ad2d-4267-821c-cd9a495ee9b5}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Condition" Id="{121e9e17-db69-4d58-a344-e6e8a3a42d4b}">
      <Declaration><![CDATA[(*!
<summary>Returns the loop continuation condition configured for this activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{9c48afd2-d45d-4366-84e1-f61bd2c6adc9}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{1073bb11-2516-4e4a-b056-d98e3143c9fd}">
      <Declaration><![CDATA[(*!
<summary>Configures the required loop condition and optional body activity.</summary>
<description>
Permitted only in PASSIVE_READY. Condition is required; body is optional (when 0, evaluates condition
cyclically without advancing a body activity). Assigns THIS^ as ParentActivity of supplied elements.
</description>
<param name="condition">Condition evaluated before each iteration.</param>
<param name="body">Activity executed repeatedly while condition evaluates to TRUE, or 0.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition;
	body : IActivity;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>