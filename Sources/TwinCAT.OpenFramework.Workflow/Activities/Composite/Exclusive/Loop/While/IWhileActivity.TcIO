<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWhileActivity" Id="{48afd1de-38c9-486e-a527-23b68379f379}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a loop composite activity that repeats its sequential body while its Condition evaluates to TRUE.</summary>
*)

INTERFACE IWhileActivity EXTENDS ISequenceActivity]]></Declaration>
    <Property Name="Condition" Id="{121e9e17-db69-4d58-a344-e6e8a3a42d4b}">
      <Declaration><![CDATA[(*!
<summary>Returns the loop continuation condition configured for this activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{9c48afd2-d45d-4366-84e1-f61bd2c6adc9}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{1073bb11-2516-4e4a-b056-d98e3143c9fd}">
      <Declaration><![CDATA[(*!
<summary>Assigns the required loop condition and binds its ParentActivity.</summary>
<description>
Permitted only in PASSIVE_READY. Rejects a null condition.
</description>
<param name="condition">Condition evaluated before each iteration.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition; 
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>