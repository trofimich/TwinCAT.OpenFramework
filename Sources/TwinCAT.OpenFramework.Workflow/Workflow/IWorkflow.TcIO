(*!
<summary>Coordinates execution, variable storage, naming and dynamic child ownership of a workflow.</summary>
<description>
Root coordinator that hosts a workflow execution tree via RootActivity.
Inherits the lifecycle state machine and execution control from IWorkflowLifecycle,
and variable management from IVariableLookup and IVariableBinder.
</description>
*)

INTERFACE IWorkflow EXTENDS IWorkflowLifecycle, IVariableLookup, IVariableBinder]]></Declaration>
    <Property Name="RootActivity" Id="{0e5d0a1e-7434-4faa-80fe-c6362efb5ea0}">
      <Declaration><![CDATA[(*!
<summary>Gets the root activity of the workflow, or zero if not configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY RootActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{502bd1df-aa85-4d47-af3c-569e04d047dc}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="RegisterChild" Id="{daa93ef1-488d-4258-915c-978eb1acbd9e}">
      <Declaration><![CDATA[(*!
<summary>Accepts ownership of a constructed dynamic workflow element.</summary>
<description>
Call after successful __NEW, outside FB_init/FB_exit/FB_reinit, before configuring or exposing the child. Null
and static children are ignored. Requires a live child exclusively owned by the caller and associated with
this workflow. On success the workflow owns the child until DisposeDynamicChildren or destruction; callers
only borrow it. Duplicate addresses are ignored; distinct addresses are retained regardless of payload
equality. Before ownership transfer, a registration exception triggers an attempt to delete the child and is
propagated; the caller must not reuse its pointer. Destructors must not raise. Post-registration diagnostic
failures do not undo ownership. Registration and disposal must not run concurrently or reenter this workflow.
</description>
<param name="child">Constructed workflow element to register.</param>
*)
METHOD RegisterChild
VAR_INPUT
	child : IWorkflowElement;
END_VAR]]></Declaration>
    </Method>
    <Method Name="SetRootActivity" Id="{f5f43f5f-59be-4ac4-a3f8-50bd5d2a40e8}">
      <Declaration><![CDATA[(*!
<summary>Assigns the root activity of the workflow and initializes workflow variables on first assignment.</summary>
<description>
Cannot be called while Busy is TRUE. Requires a nonzero rootActivity to have no parent activity and to already
belong to this workflow.
An unassociated root is rejected; association is not inferred or transferred by this call. On failed initial
variable registration, the standard implementation removes only newly appended bindings, preserves earlier
bindings and the previous root, and permits retry; subclass side effects are not rolled back.
</description>
<param name="rootActivity">Root activity to assign, or zero to detach.</param>
*)
METHOD SetRootActivity
VAR_INPUT
	rootActivity : IActivity;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
