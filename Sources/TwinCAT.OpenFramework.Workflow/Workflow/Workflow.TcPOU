    <Method Name="RegisterChild" Id="{d5ebe690-8ae4-4f6f-8bba-5616c293b52c}">
      <Declaration><![CDATA[(*!
<summary>Accepts ownership of a constructed dynamic workflow element.</summary>
<description>Call after successful __NEW, outside FB_init/FB_exit/FB_reinit, before configuring or exposing the child. Null and static children are ignored. Requires a live child exclusively owned by the caller and associated with this workflow. On success the workflow owns the child until DisposeDynamicChildren or destruction; callers only borrow it. Duplicate addresses are ignored; distinct addresses are retained regardless of payload equality. Before ownership transfer, a registration exception triggers an attempt to delete the child and is propagated; the caller must not reuse its pointer. Destructors must not raise. Post-registration diagnostic failures do not undo ownership. Registration and disposal must not run concurrently or reenter this workflow.</description>
<param name="child">Constructed workflow element to register.</param>
*)
METHOD FINAL RegisterChild
VAR_INPUT
	child : IWorkflowElement;
END_VAR
VAR
	formattedLogMessage : WSTRING(255);

	childObject : TOF_Core.IObject;
	childAddress : PVOID;
	i : DINT;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF child = 0 THEN
	RETURN;
END_IF

childObject := child;

__TRY
	IF NOT child.IsDynamicInstance THEN
		RETURN;
	END_IF

	childAddress := child.SelfAddress;

	FOR i := 0 TO _DynamicChildren.Length - 1 DO
		IF _DynamicChildren.Get(i).Address = childAddress THEN
			RETURN;
		END_IF
	END_FOR

	_DynamicChildren.AppendGeneric(TOF_Core.GenericValueFactory.FromParts(TOF_Core.GENERIC_TYPE_CLASS.OBJECT, childAddress, child.SelfSize, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY));
__CATCH(exceptionCode)
	TOF_Core.Memory.TryReleaseDynamicObject(childObject);

	TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
__ENDTRY

__TRY
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Dynamic child with address #", TO_WSTRING(Tc2_Utilities.PVOID_TO_HEXSTR(childAddress, SIZEOF(PVOID) * 2, FALSE)), " registered in workflow '", Name, "'");

	TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));
__CATCH
	// Diagnostic failure does not undo the completed ownership transfer.
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestCancel" Id="{e9e3f3d2-fd31-4599-91c9-ed64362dfc36}">
      <Declaration><![CDATA[(*!
<summary>Requests cancellation of the root activity when permitted in the current state.</summary>
<description>
Throws DataMemberNotSpecifiedException when RootActivity is not configured. Non-terminal exceptions from
OnRootActivityRequestCancel or RootActivity.RequestCancel are caught, recorded in FailError and logged.
</description>
<param name="reason">Diagnostic reason for cancellation.</param>
*)
METHOD FINAL RequestCancel : BOOL
VAR_INPUT
	reason : WSTRING(255);
END_VAR
VAR
	formattedLogMessage : WSTRING(255);

	cancelRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
	rootActivityNotSpecifiedException : TOF_Core.DataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Cancel requested for workflow '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING) THEN
		__TRY
			OnRootActivityRequestCancel(cancelRequest => cancelRequest);
			
			IF NOT cancelRequest THEN
				_RootActivity.RequestCancel(reason);
			
				RequestCancel := TRUE;
			ELSE
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request cancel for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()), "Cancelled");	
			END_IF
		__CATCH(exceptionCode)
			handleException(exceptionCode, __POUNAME(), __POSITION());
		__ENDTRY
	END_IF
ELSE
	rootActivityNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'RootActivity');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{124b6f2b-6165-4e5c-803c-4a849401ae4a}">
      <Declaration><![CDATA[(*!
<summary>Requests resetting of the root activity from a finished passive state.</summary>
<description>
Throws DataMemberNotSpecifiedException when RootActivity is not configured. Validates transition to ACTIVE_RESETTING,
invokes OnRootActivityRequestReset and forwards RequestReset to RootActivity. Clears FailError when accepted.
Non-terminal exceptions from the hook or root activity are caught, recorded in FailError and logged.
</description>
*)
METHOD FINAL RequestReset : BOOL
VAR
	formattedLogMessage : WSTRING(255);

	cancelRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
	rootActivityNotSpecifiedException : TOF_Core.DataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Reset requested for workflow '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING) THEN
		__TRY
			OnRootActivityRequestReset(cancelRequest => cancelRequest);
			
			IF NOT cancelRequest THEN
				_FailError.Clear();
				_RootActivity.RequestReset();
			
				RequestReset := TRUE;
			ELSE
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request reset for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()), "Cancelled");	
			END_IF
		__CATCH(exceptionCode)
			handleException(exceptionCode, __POUNAME(), __POSITION());
		__ENDTRY
	END_IF
ELSE
	rootActivityNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'RootActivity');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{8bafec37-0963-43f8-ba1c-3151d45bcb5a}">
      <Declaration><![CDATA[(*!
<summary>Requests starting or resuming of the root activity when permitted in the current state.</summary>
<description>
Throws DataMemberNotSpecifiedException when RootActivity is not configured. Non-terminal exceptions from
OnRootActivityRequestStart or RootActivity.RequestStart are caught, recorded in FailError and logged.
</description>
*)
METHOD FINAL RequestStart : BOOL
VAR
	formattedLogMessage : WSTRING(255);

	cancelRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
	rootActivityNotSpecifiedException : TOF_Core.DataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Start requested for workflow '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING) THEN
		__TRY
			OnRootActivityRequestStart(cancelRequest => cancelRequest);
			
			IF NOT cancelRequest THEN
				_FailError.Clear();
				_RootActivity.RequestStart();
			
				RequestStart := TRUE;
			ELSE
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request start for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()), "Cancelled");
			END_IF
		__CATCH(exceptionCode)
			handleException(exceptionCode, __POUNAME(), __POSITION());
		__ENDTRY
	END_IF
ELSE
	rootActivityNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'RootActivity');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestSuspend" Id="{d3ff2a73-061d-479e-8566-a8cc52ec948c}">
      <Declaration><![CDATA[(*!
<summary>Requests suspension of the root activity when permitted in the current state.</summary>
<description>
Throws DataMemberNotSpecifiedException when RootActivity is not configured. Non-terminal exceptions from
OnRootActivityRequestSuspend or RootActivity.RequestSuspend are caught, recorded in FailError and logged.
</description>
*)
METHOD FINAL RequestSuspend : BOOL
VAR
	formattedLogMessage : WSTRING(255);

	cancelRequest : BOOL;
	
	exceptionCode : __SYSTEM.ExceptionCode;
	rootActivityNotSpecifiedException : TOF_Core.DataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Request suspend for workflow '", Name, "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING) THEN
		__TRY
			OnRootActivityRequestSuspend(cancelRequest => cancelRequest);
			
			IF NOT cancelRequest THEN
				_RootActivity.RequestSuspend();
			
				RequestSuspend := TRUE;
			ELSE
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request suspend for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()), "Cancelled");
			END_IF
		__CATCH(exceptionCode)
			handleException(exceptionCode, __POUNAME(), __POSITION());
		__ENDTRY
	END_IF
ELSE
	rootActivityNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'RootActivity');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResettingAllowed" Id="{7f3a18d2-5b64-4c91-8e20-1d4f6a9c3b82}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestReset is permitted in the current workflow state.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResettingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{9c1b4e73-2a85-4d19-b630-5e8f2a1d7c94}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResettingAllowed := _RootActivity <> 0 AND_THEN Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RootActivity" Id="{142ff0bb-9cbe-49d5-8b58-eabad1dc6713}">
      <Declaration><![CDATA[(*!
<summary>Gets the root activity of the workflow, or zero if not configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL RootActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{bda62c52-93af-4541-b8a0-25e42cace2f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RootActivity := _RootActivity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetRootActivity" Id="{c98e2b1c-fc8c-4d20-ba30-5596dcd42dcd}">
      <Declaration><![CDATA[(*!
<summary>Assigns the root activity of the workflow and initializes workflow variables on first assignment.</summary>
<description>
Throws StandardException when the workflow is busy, when rootActivity already has a parent or belongs to another
workflow, or when CreateVariables returns an empty or duplicate variable name. On variable initialization failure,
releases any unaccepted key and clears partial dictionary state before propagating the exception.
</description>
<param name="rootActivity">Root activity to assign, or zero to detach.</param>
*)
METHOD FINAL SetRootActivity
VAR_INPUT
	rootActivity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	workflowBusyException : TOF_Core.StandardException; 
	workflowVariableException : TOF_Core.StandardException;

	variables : ARRAY [0..VariableCount - 1] OF VARIABLE_DESCRIPTOR;
	variableKey : TOF_Core.GENERIC_VALUE;
	variableValue : TOF_Core.GENERIC_VALUE;
	exceptionCode : __SYSTEM.ExceptionCode;
	
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _RootActivity = rootActivity THEN
	RETURN;
END_IF

IF Busy THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Unable to change root activity for workflow '", Name, "': workflow is busy");

	workflowBusyException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF rootActivity <> 0 THEN
	IF rootActivity.ParentActivity <> 0 THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Unable to set root activity for workflow '", Name, "': activity is already attached to a parent activity");

		workflowBusyException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
	END_IF

	IF rootActivity.Workflow <> 0 AND_THEN rootActivity.Workflow.SelfAddress <> SelfAddress THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Unable to set root activity for workflow '", Name, "': activity belongs to another workflow");

		workflowBusyException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
	END_IF
END_IF

IF NOT _Initialized THEN
	IF VariableCount > 0 THEN
		variables := CreateVariables();
		
		__TRY
			FOR i := 0 TO VariableCount - 1 DO
				IF variables[i].Name = '' THEN
					workflowVariableException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Method CreateVariables returned workflow variable with empty name");
				END_IF
				
				variableKey := TOF_Core.GenericValueFactory.FromStringValue(variables[i].Name);
				variableValue := TOF_Core.GenericValueFactory.FromParts(
					variables[i].TypeClass,
					variables[i].Address,
					variables[i].Size,
					TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
				
				_Variables.SetGeneric(variableKey, variableValue);
				variableKey.Reset();
			END_FOR
			
			IF _Variables.Length <> VariableCount THEN
				formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Invalid number of unique workflow variables ", TO_WSTRING(_Variables.Length), " instead of ", TO_WSTRING(VariableCount), ". Check for duplicated names");

				workflowVariableException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);		
			END_IF
		__CATCH(exceptionCode)
			// Release unaccepted key and partial dictionary entries before propagating the exception.
			variableKey.Release();
			_Variables.Clear();

			TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
		__ENDTRY
	END_IF
	
	_Initialized := TRUE;
END_IF

_RootActivity := rootActivity;]]></ST>
      </Implementation>
    </Method>
    <Property Name="StartingAllowed" Id="{95daf790-beb6-482f-b496-9fe693beae09}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestStart is permitted in the current workflow state.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL StartingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{68298cce-8206-42d6-ae98-f824acf8e5c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StartingAllowed := _RootActivity <> 0 AND_THEN Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="State" Id="{41e640de-75d7-4041-9e96-1cf5228bad0c}">
      <Declaration><![CDATA[(*!
<summary>Gets the current workflow state reflected from RootActivity, or PASSIVE_READY when unconfigured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL State : WORKFLOW_ELEMENT_STATE]]></Declaration>
      <Get Name="Get" Id="{981298d5-8560-4acd-85b3-18b8e41e747f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	State := _RootActivity.State;
ELSE
	State := WORKFLOW_ELEMENT_STATE.PASSIVE_READY;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SuspendingAllowed" Id="{0820968e-0c3a-437c-b3a5-aa866f9eaee4}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestSuspend is permitted in the current workflow state.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL SuspendingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{0986e853-cad0-400c-9019-3c43569bc0cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SuspendingAllowed := _RootActivity <> 0 AND_THEN Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryGetVariable" Id="{5010e467-b98c-4a4e-ae7b-f87b6c5b379c}">
      <Declaration><![CDATA[(*!
<summary>Attempts to resolve a named variable from the workflow variable dictionary.</summary>
<description>Returns FALSE when resolution fails or a nested call raises an exception. Use the output only when TRUE is returned. Does not propagate exceptions or clear terminal allocation state.</description>
<param name="name">Name of the variable to resolve.</param>
<param name="variable">Resolved variable descriptor when TRUE is returned.</param>
*)
METHOD TryGetVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryGetVariable := _Variables.TryGetValueByKey(name, value => variable);
__CATCH
	TryGetVariable := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
