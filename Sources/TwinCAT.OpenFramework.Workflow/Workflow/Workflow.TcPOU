    <Method Name="RegisterChild" Id="{d5ebe690-8ae4-4f6f-8bba-5616c293b52c}">
      <Declaration><![CDATA[(*!
<summary>Accepts ownership of a constructed dynamic workflow element.</summary>
<description>
Call after successful __NEW, outside FB_init/FB_exit/FB_reinit, before configuring or exposing the child. Null
and static children are ignored. Requires a live child exclusively owned by the caller and associated with
this workflow. On success the workflow owns the child until DisposeDynamicChildren or destruction; callers
only borrow it. Duplicate addresses are ignored; distinct addresses are retained regardless of payload
equality. Before ownership transfer, a registration exception triggers an attempt to delete the child and is
propagated; the caller must not reuse its pointer. Destructors must not raise. Post-registration diagnostic
failures do not undo ownership. Registration and disposal must not run concurrently or reenter this workflow.
</description>
<param name="child">Constructed workflow element to register.</param>
*)
METHOD FINAL RegisterChild
VAR_INPUT
	child : IWorkflowElement;
END_VAR
VAR
	formattedLogMessage : TOF_Core.ERROR_MESSAGE;

	childObject : TOF_Core.IObject;
	childAddress : PVOID;
	i : DINT;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF child = 0 THEN
	RETURN;
END_IF

childObject := child;

__TRY
	IF NOT child.IsDynamicInstance THEN
		RETURN;
	END_IF

	childAddress := child.SelfAddress;

	FOR i := 0 TO _DynamicChildren.Length - 1 DO
		IF _DynamicChildren.Get(index := i).Address = childAddress THEN
			RETURN;
		END_IF
	END_FOR

	_DynamicChildren.AppendGeneric(
		value := TOF_Core.GenericValueFactory.FromParts(
			genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
			address := childAddress,
			size := child.SelfSize,
			memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
		)
	);
__CATCH(exceptionCode)
	TOF_Core.Memory.TryReleaseDynamicObject(instance := childObject);

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

__TRY
	formattedLogMessage := TOF_Core.WideStrings.Concat255(
		"Dynamic child with address #",
		TO_WSTRING(Tc2_Utilities.PVOID_TO_HEXSTR(in := childAddress, iPrecision := SIZEOF(PVOID) * 2, bLoCase := FALSE)),
		" registered in workflow '",
		Name,
		"'"
	);

	TOF_Core.LogManager.TryLogMessage(
		message := formattedLogMessage,
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		topic1 := TO_WSTRING(ClassName),
		topic2 := TO_WSTRING(__POUNAME())
	);
__CATCH
	// Diagnostic failure does not undo the completed ownership transfer.
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestCancel" Id="{e9e3f3d2-fd31-4599-91c9-ed64362dfc36}">
      <Declaration><![CDATA[(*!
<summary>Requests cancellation of the root activity when permitted in the current state.</summary>
<description>
Throws <c>WorkflowConfigurationException</c> when called during <c>OnConfigure</c>. Returns FALSE without
modifying <c>FailError</c> when <c>OnConfigure</c> failed. Throws <c>DataMemberNotSpecifiedException</c>
when <c>RootActivity</c> is not configured. Non-terminal exceptions from <c>OnRootActivityRequestCancel</c>
or <c>RootActivity.RequestCancel</c> are caught, recorded in <c>FailError</c> and logged.
</description>
<param name="reason">Diagnostic reason for cancellation.</param>
*)
METHOD FINAL RequestCancel : BOOL
VAR_INPUT
	reason : WSTRING(255);
END_VAR
VAR
	formattedLogMessage : TOF_Core.ERROR_MESSAGE;

	abortRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot cancel during OnConfigure"
		)
	);
END_IF

IF _LogStateChanges THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Cancel requested for workflow '", Name, "'");

	TOF_Core.LogManager.TryLogMessage(
		message := formattedLogMessage,
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		topic1 := TO_WSTRING(ClassName),
		topic2 := TO_WSTRING(__POUNAME())
	);
END_IF

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED THEN
	RETURN;
END_IF

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(currentState := State, newState := WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING) THEN
		__TRY
			OnRootActivityRequestCancel(abortRequest => abortRequest);

			IF NOT abortRequest THEN
				_RootActivity.RequestCancel(reason := reason);

				RequestCancel := TRUE;
			ELSIF _LogStateChanges THEN
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request cancel for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(
					message := formattedLogMessage,
					category := TOF_Core.LOG_CATEGORY.INFORMATION,
					topic1 := TO_WSTRING(ClassName),
					topic2 := TO_WSTRING(__POUNAME()),
					topic3 := "Cancelled"
				);
			END_IF
		__CATCH(exceptionCode)
			handleException(
				exceptionCode := exceptionCode,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);
		__ENDTRY
	END_IF
ELSE
	TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		dataMemberName := 'RootActivity'
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{124b6f2b-6165-4e5c-803c-4a849401ae4a}">
      <Declaration><![CDATA[(*!
<summary>Requests resetting of the root activity from a finished passive state.</summary>
<description>
Throws <c>WorkflowConfigurationException</c> when called during <c>OnConfigure</c>. Failures of
<c>OnConfigure</c> are not recoverable via <c>RequestReset</c>; returns FALSE without overwriting
<c>FailError</c>. Throws <c>DataMemberNotSpecifiedException</c> when <c>RootActivity</c> is not
configured. Validates transition to <c>ACTIVE_RESETTING</c>, invokes <c>OnRootActivityRequestReset</c>
and forwards <c>RequestReset</c> to <c>RootActivity</c>. Clears <c>FailError</c> when accepted. Restores
own declarations when reset completes immediately or in <c>Execute</c>. Non-terminal exceptions from the
hook or root activity are caught, recorded in <c>FailError</c> and logged.
</description>
*)
METHOD FINAL RequestReset : BOOL
VAR
	formattedLogMessage : TOF_Core.ERROR_MESSAGE;

	abortRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot reset during OnConfigure"
		)
	);
END_IF

IF _LogStateChanges THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Reset requested for workflow '", Name, "'");

	TOF_Core.LogManager.TryLogMessage(
		message := formattedLogMessage,
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		topic1 := TO_WSTRING(ClassName),
		topic2 := TO_WSTRING(__POUNAME())
	);
END_IF

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED THEN
	RETURN;
END_IF

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(currentState := State, newState := WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING) THEN
		__TRY
			OnRootActivityRequestReset(abortRequest => abortRequest);

			IF NOT abortRequest THEN
				_FailError.Clear();
				_RootActivity.RequestReset();

				IF _RootActivity.State = WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
					_VariableScope.Restore();
				END_IF

				RequestReset := TRUE;
			ELSIF _LogStateChanges THEN
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request reset for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(
					message := formattedLogMessage,
					category := TOF_Core.LOG_CATEGORY.INFORMATION,
					topic1 := TO_WSTRING(ClassName),
					topic2 := TO_WSTRING(__POUNAME()),
					topic3 := "Cancelled"
				);
			END_IF
		__CATCH(exceptionCode)
			handleException(
				exceptionCode := exceptionCode,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);
		__ENDTRY
	END_IF
ELSE
	TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		dataMemberName := 'RootActivity'
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{8bafec37-0963-43f8-ba1c-3151d45bcb5a}">
      <Declaration><![CDATA[(*!
<summary>Requests starting or resuming of the root activity when permitted in the current state.</summary>
<description>
Throws <c>WorkflowConfigurationException</c> when called during <c>OnConfigure</c>. Invokes one-shot
<c>OnConfigure</c> while unconfigured; a non-terminal exception from <c>OnConfigure</c> is recorded in
<c>FailError</c>, logged and causes FALSE to be returned. Returns FALSE without modifying <c>FailError</c>
when <c>OnConfigure</c> previously failed. Throws <c>DataMemberNotSpecifiedException</c> when
<c>RootActivity</c> remains zero after configuration. Non-terminal exceptions from
<c>OnRootActivityRequestStart</c> or <c>RootActivity.RequestStart</c> are caught, recorded in
<c>FailError</c> and logged.
</description>
*)
METHOD FINAL RequestStart : BOOL
VAR
	formattedLogMessage : TOF_Core.ERROR_MESSAGE;

	abortRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot start during OnConfigure"
		)
	);
END_IF

IF _LogStateChanges THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Start requested for workflow '", Name, "'");

	TOF_Core.LogManager.TryLogMessage(
		message := formattedLogMessage,
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		topic1 := TO_WSTRING(ClassName),
		topic2 := TO_WSTRING(__POUNAME())
	);
END_IF

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.UNCONFIGURED THEN
	__TRY
		ensureConfigured();
	__CATCH(exceptionCode)
		handleException(
			exceptionCode := exceptionCode,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);

		RETURN;
	__ENDTRY
END_IF

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED THEN
	RETURN;
END_IF

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(currentState := State, newState := WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING) THEN
		__TRY
			OnRootActivityRequestStart(abortRequest => abortRequest);

			IF NOT abortRequest THEN
				_FailError.Clear();
				_RootActivity.RequestStart();

				RequestStart := TRUE;
			ELSIF _LogStateChanges THEN
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request start for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(
					message := formattedLogMessage,
					category := TOF_Core.LOG_CATEGORY.INFORMATION,
					topic1 := TO_WSTRING(ClassName),
					topic2 := TO_WSTRING(__POUNAME()),
					topic3 := "Cancelled"
				);
			END_IF
		__CATCH(exceptionCode)
			handleException(
				exceptionCode := exceptionCode,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);
		__ENDTRY
	END_IF
ELSE
	TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		dataMemberName := 'RootActivity'
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestSuspend" Id="{d3ff2a73-061d-479e-8566-a8cc52ec948c}">
      <Declaration><![CDATA[(*!
<summary>Requests suspension of the root activity when permitted in the current state.</summary>
<description>
Throws <c>WorkflowConfigurationException</c> when called during <c>OnConfigure</c>. Returns FALSE without
modifying <c>FailError</c> when <c>OnConfigure</c> failed. Throws <c>DataMemberNotSpecifiedException</c>
when <c>RootActivity</c> is not configured. Non-terminal exceptions from
<c>OnRootActivityRequestSuspend</c> or <c>RootActivity.RequestSuspend</c> are caught, recorded in
<c>FailError</c> and logged.
</description>
*)
METHOD FINAL RequestSuspend : BOOL
VAR
	formattedLogMessage : TOF_Core.ERROR_MESSAGE;

	abortRequest : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot suspend during OnConfigure"
		)
	);
END_IF

IF _LogStateChanges THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Request suspend for workflow '", Name, "'");

	TOF_Core.LogManager.TryLogMessage(
		message := formattedLogMessage,
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		topic1 := TO_WSTRING(ClassName),
		topic2 := TO_WSTRING(__POUNAME())
	);
END_IF

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED THEN
	RETURN;
END_IF

IF _RootActivity <> 0 THEN
	IF Workflows.ValidateTransition(currentState := State, newState := WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING) THEN
		__TRY
			OnRootActivityRequestSuspend(abortRequest => abortRequest);

			IF NOT abortRequest THEN
				_RootActivity.RequestSuspend();

				RequestSuspend := TRUE;
			ELSIF _LogStateChanges THEN
				formattedLogMessage := TOF_Core.WideStrings.Concat255("Request suspend for workflow '", Name, "' was cancelled");

				TOF_Core.LogManager.TryLogMessage(
					message := formattedLogMessage,
					category := TOF_Core.LOG_CATEGORY.INFORMATION,
					topic1 := TO_WSTRING(ClassName),
					topic2 := TO_WSTRING(__POUNAME()),
					topic3 := "Cancelled"
				);
			END_IF
		__CATCH(exceptionCode)
			handleException(
				exceptionCode := exceptionCode,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);
		__ENDTRY
	END_IF
ELSE
	TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		dataMemberName := 'RootActivity'
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResettingAllowed" Id="{7f3a18d2-5b64-4c91-8e20-1d4f6a9c3b82}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestReset is permitted in the current workflow state.</summary>
<description>Returns FALSE without side effects when RootActivity is zero or configuration failed.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResettingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{9c1b4e73-2a85-4d19-b630-5e8f2a1d7c94}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED OR_ELSE _RootActivity = 0 THEN
	RETURN;
END_IF

ResettingAllowed := Workflows.ValidateTransition(
	currentState := State,
	newState := WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING
);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RootActivity" Id="{142ff0bb-9cbe-49d5-8b58-eabad1dc6713}">
      <Declaration><![CDATA[(*!
<summary>Gets the root activity of the workflow, or zero if not configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL RootActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{bda62c52-93af-4541-b8a0-25e42cace2f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RootActivity := _RootActivity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{86d2dfd7-cfc5-4359-abaf-2eb402cadcf3}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{61772ecc-c835-4cc5-8f8d-109d1d9f49e3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Serialize" Id="{e6d25190-dc12-443a-baad-ee68c68f129a}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR
VAR
	version : UINT := 1;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[writer.WriteValue(
	name := 'version',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UINT,
	data := ADR(version),
	size := SIZEOF(version)
);
Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
Workflows.WriteConfigurationObject(writer := writer, name := 'root', source := _RootActivity);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetRootActivity" Id="{c98e2b1c-fc8c-4d20-ba30-5596dcd42dcd}">
      <Declaration><![CDATA[(*!
<summary>Assigns the root activity of the workflow and initializes workflow variables on first assignment.</summary>
<description>
Throws <c>WorkflowConfigurationException</c> when the workflow is busy or self-configuration has failed; throws
<c>WorkflowAttachmentException</c> when <c>rootActivity</c> already has a parent, has no workflow association
or belongs to another workflow. Assigning a nonzero root while unconfigured marks configuration complete so
subsequent <c>Execute</c> or <c>RequestStart</c> calls skip <c>OnConfigure</c>; inside <c>OnConfigure</c>,
configuration remains in progress until the hook completes. Invokes <c>InitializeVariables</c> on first
assignment. A failed hook removes only bindings appended during that attempt, preserves earlier bindings and
the previous root, and allows a later retry. Custom hook side effects are not rolled back; the hook must not
reenter configuration or dispose this workflow.
</description>
<param name="rootActivity">Root activity to assign, or zero to detach.</param>
*)
METHOD FINAL SetRootActivity
VAR_INPUT
	rootActivity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
	initialVariableCount : DINT;
	rootParentActivity : IActivity;
	rootWorkflow : IWorkflow;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Unable to change root activity for workflow '",
		Name,
		"': workflow configuration failed"
	);

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF _RootActivity = rootActivity THEN
	RETURN;
END_IF

IF Busy THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Unable to change root activity for workflow '",
		Name,
		"': workflow is busy"
	);

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF rootActivity <> 0 THEN
	rootParentActivity := rootActivity.ParentActivity;

	IF rootParentActivity <> 0 THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
			"Unable to set root activity for workflow '",
			Name,
			"': activity is already attached to a parent activity"
		);

		WorkflowExceptions.ThrowWorkflowAttachment(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := formattedExceptionMessage
		);
	END_IF

	rootWorkflow := rootActivity.Workflow;

	IF rootWorkflow = 0 OR_ELSE rootWorkflow.SelfAddress <> SelfAddress THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
			"Unable to set root activity for workflow '",
			Name,
			"': root activity must already belong to this workflow"
		);

		WorkflowExceptions.ThrowWorkflowAttachment(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := formattedExceptionMessage
		);
	END_IF
END_IF

IF NOT _VariablesInitialized THEN
	initialVariableCount := _VariableScope.Length;

	// Registration appends unique bindings; remove only this attempt's additions on failure.

	__TRY
		InitializeVariables();
	__CATCH(exceptionCode)
		_VariableScope.RollbackToLength(initialLength := initialVariableCount);

		TOF_Core.ExceptionManager.ReThrowLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
	__ENDTRY

	_VariablesInitialized := TRUE;
END_IF

_RootActivity := rootActivity;

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.UNCONFIGURED AND_THEN _RootActivity <> 0 THEN
	_ConfigurationState := WORKFLOW_CONFIGURATION_STATE.CONFIGURED;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="StartingAllowed" Id="{95daf790-beb6-482f-b496-9fe693beae09}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestStart is permitted in the current workflow state.</summary>
<description>Returns FALSE without side effects when RootActivity is zero or configuration failed.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL StartingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{68298cce-8206-42d6-ae98-f824acf8e5c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED OR_ELSE _RootActivity = 0 THEN
	RETURN;
END_IF

StartingAllowed := Workflows.ValidateTransition(
	currentState := State,
	newState := WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING
);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="State" Id="{41e640de-75d7-4041-9e96-1cf5228bad0c}">
      <Declaration><![CDATA[(*!
<summary>Gets the current workflow state.</summary>
<description>
Returns PASSIVE_FAILED when self-configuration failed, RootActivity.State when configured, or
PASSIVE_READY otherwise.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL State : WORKFLOW_ELEMENT_STATE]]></Declaration>
      <Get Name="Get" Id="{981298d5-8560-4acd-85b3-18b8e41e747f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED THEN
	State := WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED;
ELSIF _RootActivity <> 0 THEN
	State := _RootActivity.State;
ELSE
	State := WORKFLOW_ELEMENT_STATE.PASSIVE_READY;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SuspendingAllowed" Id="{0820968e-0c3a-437c-b3a5-aa866f9eaee4}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestSuspend is permitted in the current workflow state.</summary>
<description>Returns FALSE without side effects when RootActivity is zero or configuration failed.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL SuspendingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{0986e853-cad0-400c-9019-3c43569bc0cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED OR_ELSE _RootActivity = 0 THEN
	RETURN;
END_IF

SuspendingAllowed := Workflows.ValidateTransition(
	currentState := State,
	newState := WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING
);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryGetVariable" Id="{5010e467-b98c-4a4e-ae7b-f87b6c5b379c}">
      <Declaration><![CDATA[(*!
<summary>Attempts to resolve a named variable from the workflow variable dictionary.</summary>
<description>
Returns FALSE when resolution fails or a nested call raises an exception. Use the output only when TRUE is
returned. Does not propagate exceptions or clear terminal allocation state. A latched allocation failure returns FALSE
without entering further lookup callbacks, including when a nested callback contained the allocation exception.
</description>
<param name="name">Name of the variable to resolve.</param>
<param name="variable">Resolved variable descriptor when TRUE is returned.</param>
*)
METHOD TryGetVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryGetVariable := _VariableScope.TryGetLocalVariable(name := name, variable => variable);]]></ST>
      </Implementation>
    </Method>
    <Property Name="VariableScopeOwnerKind" Id="{8f37c219-4d28-4e93-a615-3b70f18c9d42}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Returns the diagnostic owner kind label ('workflow') for variable registration errors.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PROTECTED VariableScopeOwnerKind : STRING]]></Declaration>
      <Get Name="Get" Id="{17827fe4-9f53-428a-965a-4ad4c96bece7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[VariableScopeOwnerKind := 'workflow';]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>