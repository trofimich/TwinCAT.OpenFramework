<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Workflow" Id="{276b6eec-c9aa-49be-b713-e71500f934ba}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Coordinates a root activity, workflow state transitions, variable storage and dynamic child lifetime.</summary>
<description>
<h2>Build and own the activity graph</h2>
<ol>
<li>For dynamic or recipe-driven graphs, construct each dynamic activity or condition, check allocation,
and call <c>RegisterChild</c> before configuring or attaching the node. Registration uses its address and
transfers ownership to the workflow until disposal. <c>Activity</c> and <c>Condition</c> do not register in
<c>FB_init</c>. Attach configured nodes to their parents and assign the root with <c>SetRootActivity</c>.</li>
<li>For static or mixed subclass scenarios, declare child elements as instance fields (with
<c>workflow := THIS^</c> or <c>0</c>) and override <c>OnConfigure</c> to declare variables, wire the graph
and call <c>SetRootActivity</c>. Static fields remain caller-owned; repeat runs via <c>RequestReset</c>
rather than <c>DisposeDynamicChildren</c>.</li>
</ol>
<c>OnConfigure</c> runs automatically once on the first <c>Execute</c> or <c>RequestStart</c> while
unconfigured, unless a nonzero <c>RootActivity</c> was already assigned earlier (for example externally or
during <c>Deserialize</c>). The ownership registry also holds embedded task and comparer instances until
disposal.
<h2>Advance execution and read diagnostics</h2>
The owning PLC task advances the workflow through <c>Execute</c>. Uncaught non-terminal exceptions from
the root or workflow hooks are recorded in <c>FailError</c> and logged via <c>LogManager</c>. A
non-terminal exception in <c>OnConfigure</c> clears <c>RootActivity</c> and latches <c>PASSIVE_FAILED</c>
without recovery via <c>RequestReset</c>. Terminal allocation failures propagate. Diagnostic string inputs
are borrowed during each call, and retained text is copied into the workflow's storage.
<h2>Observe and reset variables</h2>
The variable dictionary uses default key equality and hashing. Named variable lookup reports failure
without propagating exceptions. Its output is usable only on success. Workflow declarations reset in
place when the root completes resetting.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Workflow EXTENDS StatefulWorkflowObject IMPLEMENTS IWorkflow, TOF_Core.IConfigurationSerializable, IEmbeddedDependencyOwner
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_VariablesInitialized : BOOL;

	{attribute 'hide'}
	_ConfigurationState : WORKFLOW_CONFIGURATION_STATE;

	{attribute 'hide'}
	_LogStateChanges : BOOL := TRUE;

	_RootActivity : IActivity;

	_DynamicChildren : TOF_Collections.List<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{0a85699b-0877-4f46-87b6-cd53ff5cc628}" />
    <Folder Name="Overriden methods" Id="{7102e9a5-813c-42ef-9cb4-8a48ef0392fa}" />
    <Folder Name="Service methods" Id="{3a817429-0fa1-41b2-bf58-9a3b2167edfc}" />
    <Method Name="AttachEmbeddedDependency" Id="{025ec813-8fd9-4acc-9815-7c83f859ab36}">
      <Declaration><![CDATA[(*!
<summary>Attaches a fresh dynamic task or comparer to this workflow owner.</summary>
<description>Use in one task with a live node and a previously unowned dependency. Rejects calls while Busy is
TRUE or self-configuration has failed. The caller retains ownership on insertion failure. Duplicate registration
raises before mutation. Accepted objects live until workflow disposal, including after rebinding.</description>
*)
METHOD FINAL AttachEmbeddedDependency
VAR_INPUT
	dependency : TOF_Core.IObject;
	node : IWorkflowElement;
END_VAR
VAR
	serializable : TOF_Core.IConfigurationSerializable;
	task : TOF_Tasks.ITask;
	comparer : TOF_Core.IComparer;
	address : PVOID;
	ownerWorkflow : IWorkflow;
	nodeWorkflow : IWorkflow;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := THIS^;

IF node = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Embedded dependency requires a node in this ready workflow"
	);
END_IF

nodeWorkflow := node.Workflow;

IF nodeWorkflow <> ownerWorkflow
	OR_ELSE Busy
	OR_ELSE _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Embedded dependency requires a node in this ready workflow"
	);
END_IF

IF dependency = 0
	OR_ELSE NOT dependency.IsDynamicInstance
	OR_ELSE dependency.SelfAddress = SelfAddress
	OR_ELSE dependency.SelfAddress = node.SelfAddress
	OR_ELSE NOT __QUERYINTERFACE(dependency, serializable)
	OR_ELSE (NOT __QUERYINTERFACE(dependency, task) AND_THEN NOT __QUERYINTERFACE(dependency, comparer))
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255("Expected a dynamic serializable dependency at ", node.Name)
	);
END_IF

address := dependency.SelfAddress;

FOR i := 0 TO _DynamicChildren.Length - 1 DO
	IF _DynamicChildren.Get(index := i).Address = address THEN
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := TOF_Core.WideStrings.Concat255("Dependency already owned by this workflow at ", node.Name)
		);
	END_IF
END_FOR

_DynamicChildren.AppendGeneric(
	value := TOF_Core.GenericValueFactory.FromParts(
		genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
		address := address,
		size := dependency.SelfSize,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
	)
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{bab15e3d-0210-4a1d-9bb4-41a96adad825}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether the root activity is currently in an active state.</summary>
<description>FALSE reflects the root state and does not certify nested resource release after failure.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{25a01fa6-5f1d-49d9-abad-9f8714f9cd46}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	Busy := _RootActivity.Busy;
ELSE
	Busy := FALSE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CancellingAllowed" Id="{dfcebe9b-ab64-4804-8d3a-9c7b480916ca}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestCancel is permitted in the current workflow state.</summary>
<description>Returns FALSE without side effects when RootActivity is zero or configuration failed.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CancellingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{1950e828-b0f7-41b0-af94-b6507dbd368e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED OR_ELSE _RootActivity = 0 THEN
	RETURN;
END_IF

CancellingAllowed := Workflows.ValidateTransition(
	currentState := State,
	newState := WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING
);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CancelReason" Id="{526411d6-4df3-4a3b-abe6-82d140566243}">
      <Declaration><![CDATA[(*!
<summary>Gets a reference to the cancellation reason of the root activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CancelReason : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{2b2eea18-9847-400b-97a8-d83167a86a22}">
        <Declaration><![CDATA[VAR_INST
	emptyCancelReason : WSTRING(255) := "";
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	CancelReason REF= _RootActivity.CancelReason;
ELSE
	CancelReason REF= emptyCancelReason;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{74686342-960c-43da-a108-c5309407514a}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8f28a369-1d8e-439e-b04d-afcb361b776d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Deserialize" Id="{e7578e72-87d4-4f70-ab3f-0f7fa6b027b2}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and deserialization context are borrowed for this call.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Active configuration deserialization context providing workflow reconstruction services.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[loader := WorkflowConfigurationSerializer.ResolveWorkflowLoader(context := context);
Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

SetRootActivity(
	rootActivity := Workflows.ReadActivity(
		loader := loader,
		node := reader.GetField(node := node, name := 'root')
	)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DisposeDynamicChildren" Id="{6b69ccba-15f0-48cc-974c-9c24c24bc45d}">
      <Declaration><![CDATA[(*!
<summary>Detaches workflow state and releases registered dynamic nodes and embedded dependencies.</summary>
<description>
<note type="information">
For a running graph that needs asynchronous cleanup, request cancellation when permitted and keep advancing
execution until outstanding work has stopped before disposing of the graph. Disposal only detaches state
and attempts deletion. Arrange any remaining resource cleanup separately.
</note>
Clears <c>RootActivity</c>, variable bindings and <c>FailError</c>, resets self-configuration state back to
<c>UNCONFIGURED</c> and releases owned registry entries. Throws <c>WorkflowConfigurationException</c> if
called reentrantly during <c>OnConfigure</c>. Do not call this method on static field graphs merely to repeat
execution; use <c>RequestReset</c> instead. Normal return does not certify physical resource release or
successful deallocation by each destructor. Dynamic child destructors must obey their no-throw lifecycle
contract. Disposal must not run concurrently or reenter this workflow. Discard old references, including
static containers that borrowed deleted descendants. Build and register a fresh graph for
<c>SetRootActivity</c>, or let <c>Execute</c>/<c>RequestStart</c> invoke <c>OnConfigure</c> again. The
application-wide fatal allocation latch remains unchanged.
</description>
*)
METHOD DisposeDynamicChildren]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot dispose children during OnConfigure"
		)
	);
END_IF

disposeDynamicChildrenInternal();]]></ST>
      </Implementation>
    </Method>
    <Method Name="disposeDynamicChildrenInternal" Id="{5f3f72e6-107b-4f62-a2a0-b68dc247b4ea}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Detaches workflow state and releases registered dynamic nodes without throwing exceptions.

Shared by DisposeDynamicChildren and FB_exit so destruction preserves its no-throw lifecycle contract.
*)
METHOD PRIVATE disposeDynamicChildrenInternal]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RootActivity := 0;
_ConfigurationState := WORKFLOW_CONFIGURATION_STATE.UNCONFIGURED;
_VariablesInitialized := FALSE;
_VariableScope.Clear();
_FailError.Clear();
_DynamicChildren.Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ensureConfigured" Id="{8a6710ca-7df5-4afc-b2ce-2d67958e1005}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Executes one-shot OnConfigure when the workflow is still unconfigured.

Skips when already configured or failed. Rejects reentrant configuration calls with
WorkflowConfigurationException. On a non-terminal exception from OnConfigure, clears RootActivity,
latches FAILED state and rethrows with terminal allocation failures taking priority.
*)
METHOD PRIVATE ensureConfigured
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURED
	OR_ELSE _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.FAILED
THEN
	RETURN;
END_IF

IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot reenter configuration"
		)
	);
END_IF

_ConfigurationState := WORKFLOW_CONFIGURATION_STATE.CONFIGURING;

__TRY
	OnConfigure();
	_ConfigurationState := WORKFLOW_CONFIGURATION_STATE.CONFIGURED;
__CATCH(exceptionCode)
	_RootActivity := 0;
	_ConfigurationState := WORKFLOW_CONFIGURATION_STATE.FAILED;

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{591aa81e-a79a-4b4b-bf41-97b54125a21a}">
      <Declaration><![CDATA[(*!
<summary>Runs one cyclic execution step of the workflow and its root activity.</summary>
<description>
Runs one-shot <c>OnConfigure</c> while unconfigured before <c>OnBeforeRootActivityExecute</c>, then invokes
<c>RootActivity.Execute</c> and <c>OnAfterRootActivityExecute</c>. Throws <c>WorkflowConfigurationException</c>
if called reentrantly during <c>OnConfigure</c>. Non-terminal exceptions from <c>OnConfigure</c>, the root
activity or hooks are caught, recorded in <c>FailError</c> and logged via <c>LogManager</c>;
<c>OnAfterRootActivityExecute</c> still runs after an exception in the preceding step. After a failed
<c>OnConfigure</c>, subsequent scans skip reconfiguration, continue running before/after hooks and preserve
<c>FailError</c>. Completion of an ongoing root reset restores workflow declarations in place. Terminal
allocation failures propagate.
</description>
*)
METHOD FINAL Execute
VAR
	wasResetting : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ConfigurationState = WORKFLOW_CONFIGURATION_STATE.CONFIGURING THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255(
			"Workflow '",
			Name,
			"' cannot execute during OnConfigure"
		)
	);
END_IF

__TRY
	ensureConfigured();

	OnBeforeRootActivityExecute();

	IF _RootActivity <> 0 THEN
		wasResetting := _RootActivity.State = WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING;
		_RootActivity.Execute();

		IF _RootActivity.State = WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
			_FailError.Clear();

			IF wasResetting THEN
				_VariableScope.Restore();
			END_IF
		END_IF
	END_IF
__CATCH(exceptionCode)
	handleException(exceptionCode := exceptionCode, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
__ENDTRY

__TRY
	OnAfterRootActivityExecute();
__CATCH(exceptionCode)
	handleException(exceptionCode := exceptionCode, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="FailError" Id="{e7a8b006-53f5-4707-ae65-96e34a954950}">
      <Declaration><![CDATA[(*!
<summary>Gets a reference to the durable error snapshot captured when the workflow or root activity fails.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL FailError : REFERENCE TO TOF_Core.ERROR]]></Declaration>
      <Get Name="Get" Id="{241dbeba-018c-4dcc-ae83-a41da8c0e1e7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _FailError.HasError OR_ELSE _RootActivity = 0 THEN
	FailError REF= _FailError;
ELSE
	FailError REF= _RootActivity.FailError;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{8a118ccc-cf33-4895-aaa4-ec240e9f2ff6}">
      <Declaration><![CDATA[(*!
<summary>Detaches the workflow and disposes its registered dynamic children during destruction.</summary>
<description>
Uses <c>disposeDynamicChildrenInternal</c> under the no-throw lifecycle contract. Does not perform cooperative
stopping or establish physical resource-release or online-change preservation guarantees. Old borrowed tree
aliases must not be used after destruction. The bInCopyCode flag does not implement a separate relocation
protocol.
</description>
<param name="bInCopyCode">TwinCAT copy-code exit marker; this member does not implement relocation.</param>
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[disposeDynamicChildrenInternal();]]></ST>
      </Implementation>
    </Method>
    <Property Name="HaltReason" Id="{d3195a13-7315-4fe3-bced-ed5c7b1dd8a3}">
      <Declaration><![CDATA[(*!
<summary>Gets a reference to the halt reason of the root activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL HaltReason : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{b4ccf352-2016-4ab8-933f-a656e330fbf2}">
        <Declaration><![CDATA[VAR_INST
	emptyHaltReason : WSTRING(255) := "";
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	HaltReason REF= _RootActivity.HaltReason;
ELSE
	HaltReason REF= emptyHaltReason;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="handleException" Id="{a21c7e4b-5d91-4f88-9b30-7c4e18f2b6a1}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Records and logs an uncaught non-terminal exception at the workflow boundary.

Propagates terminal allocation failures via RaiseIfAllocationFailed. Stabilizes native exceptions via Clone,
populates FailError and logs the exception through LogManager.TryLogException. Ordinary failures from
exception retrieval, cloning or conversion produce a fixed ERROR fallback instead of escaping this boundary.
The fallback has epoch timestamps and identifies this boundary; it does not claim to preserve unavailable payload.
Terminal allocation failure always propagates before after-hooks or further normal execution.

exceptionCode — System exception code captured by __CATCH.
catchPointPOUName — Name of the catching workflow method.
catchPointPosition — Source position of the catch block.
*)
METHOD PRIVATE handleException
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	catchPointPOUName : STRING(255);
	catchPointPosition : STRING(255);
END_VAR
VAR
	exception : TOF_Core.IException;
	snapshotAvailable : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

// Diagnostic callbacks may fail; the workflow boundary must still complete.

exception := CaptureExecutionException(
	exceptionCode := exceptionCode,
	catchPointPOUName := catchPointPOUName,
	catchPointPosition := catchPointPosition,
	fallbackMessage := "Workflow exception diagnostics are unavailable",
	snapshotAvailable => snapshotAvailable
);

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

IF snapshotAvailable THEN
	TOF_Core.LogManager.TryLogException(
		exception := exception,
		severity := TOF_Core.ERROR_SEVERITY.ERROR,
		topic1 := "Workflow",
		topic2 := TO_WSTRING(catchPointPOUName)
	);
ELSE
	_FailError.SetSource(
		sourceNamespaceName := CurrentNamespace.Name,
		sourceClassName := 'Workflow',
		sourcePOUName := catchPointPOUName
	);

	TOF_Core.LogManager.TryLogMessage(
		message := _FailError.TopMessage,
		category := TOF_Core.LOG_CATEGORY.ERROR,
		topic1 := "Workflow",
		topic2 := TO_WSTRING(catchPointPOUName)
	);
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitializeVariables" Id="{dd857de1-a9f7-4039-9560-281d3c9e9711}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook for subclasses to register their initial workflow variables.</summary>
<description>
Invoked once during the first SetRootActivity before root activity execution.
Derived classes override this method to register variables via BindPlcVariable. If the hook raises, only
its appended bindings are removed; preexisting bindings remain available and the next assignment retries.
Do not reenter SetRootActivity, dispose this workflow or retain aliases to keys added by a failed attempt.
Other subclass side effects are not transactional and must support retry.
</description>
*)
METHOD PROTECTED InitializeVariables]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="LogStateChanges" Id="{7e04d520-1b6f-4c49-8d58-0a43b61f9e75}">
      <Declaration><![CDATA[(*!
<summary>Controls whether informational lifecycle request and state-transition messages are emitted to LogManager.</summary>
<description>
Defaults to TRUE. Set FALSE to suppress INFORMATION logs from activity state transitions and lifecycle requests
while preserving unhandled failure logging via TryLogException.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL LogStateChanges : BOOL]]></Declaration>
      <Get Name="Get" Id="{8f15e631-2c70-4d5a-9e69-1b54c720af86}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LogStateChanges := _LogStateChanges;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{9026f742-3d81-4e6b-af7a-2c65d831b097}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_LogStateChanges := LogStateChanges;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{556d9f39-ce40-4931-99f4-9b47c3d967a0}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0067a9e1-ebf4-4b39-809e-932261087b8e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnAfterRootActivityExecute" Id="{dea40369-d161-4fc1-bc15-7686100c5bae}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked at the end of Execute after RootActivity.Execute completes or fails.</summary>
*)
METHOD PROTECTED OnAfterRootActivityExecute]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeRootActivityExecute" Id="{98c31e4c-dd28-45ea-b6fa-6f7ffd46cc49}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked at the beginning of Execute before RootActivity.Execute runs.</summary>
*)
METHOD PROTECTED OnBeforeRootActivityExecute]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnConfigure" Id="{a1cd0059-3967-431f-9622-f6f79019a37f}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked once before execution or starting to configure a static or mixed workflow.</summary>
<description>
Invoked automatically once from <c>Execute</c> or <c>RequestStart</c> while unconfigured, and skipped if a
nonzero <c>RootActivity</c> was already assigned earlier (for example externally via <c>SetRootActivity</c>
or during <c>Deserialize</c>). Override to configure static or dynamic elements, register dynamic children
via <c>RegisterChild</c>, bind or declare variables, and assign the root via <c>SetRootActivity</c>.
Reentering <c>Execute</c>, <c>RequestStart</c>, <c>RequestSuspend</c>, <c>RequestCancel</c>,
<c>RequestReset</c> or <c>DisposeDynamicChildren</c> during this call raises
<c>WorkflowConfigurationException</c>. Non-terminal exceptions clear <c>RootActivity</c> and latch
<c>PASSIVE_FAILED</c> with <c>FailError</c> without recovery via <c>RequestReset</c>.
</description>
*)
METHOD PROTECTED OnConfigure]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRootActivityRequestCancel" Id="{b3cbfe62-449f-465f-bf5c-b273ba14c9bb}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked before forwarding a validated cancellation request to RootActivity.</summary>
<param name="abortRequest">Set TRUE to suppress the cancellation request.</param>
*)
METHOD PROTECTED OnRootActivityRequestCancel
VAR_OUTPUT
	abortRequest : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRootActivityRequestReset" Id="{c4729a1e-8b3d-4f92-a610-3e5b9d124c88}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked before forwarding a validated reset request to RootActivity.</summary>
<param name="abortRequest">Set TRUE to suppress the reset request.</param>
*)
METHOD PROTECTED OnRootActivityRequestReset
VAR_OUTPUT
	abortRequest : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRootActivityRequestStart" Id="{ec309e5d-92ab-4d1e-bc30-2227f73237f8}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked before forwarding a validated start or resume request to RootActivity.</summary>
<param name="abortRequest">Set TRUE to suppress the start request.</param>
*)
METHOD PROTECTED OnRootActivityRequestStart
VAR_OUTPUT
	abortRequest : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRootActivityRequestSuspend" Id="{6021acef-ee70-43ba-9c45-d3783b487bf4}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked before forwarding a validated suspension request to RootActivity.</summary>
<param name="abortRequest">Set TRUE to suppress the suspension request.</param>
*)
METHOD PROTECTED OnRootActivityRequestSuspend
VAR_OUTPUT
	abortRequest : BOOL;
END_VAR]]></Declaration>
      <Implementation>
