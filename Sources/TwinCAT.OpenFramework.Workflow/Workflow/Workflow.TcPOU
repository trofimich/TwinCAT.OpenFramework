(*!
<summary>Coordinates a root activity, workflow state transitions, variable storage and dynamic child lifetime.</summary>
<description>
Diagnostic string inputs are borrowed only during the call; retained diagnostic text is copied into owned storage.
The variable dictionary uses default key equality and hashing. Named variable lookup reports failure without
propagating exceptions; its output is usable only on success. Dynamic children are registered explicitly after
construction and identified by address. Registration is not performed by Activity or Condition FB_init; registered
children remain workflow-owned until disposal. Uncaught non-terminal exceptions from the root activity and workflow
hooks are contained at the workflow boundary, recorded in FailError and logged via LogManager. Terminal allocation
failures are propagated.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK ABSTRACT Workflow 
VAR_GENERIC CONSTANT
    VariableCount : INT(0..10000) := 0;
END_VAR
EXTENDS TOF_Core.Object IMPLEMENTS IWorkflow
VAR
	{attribute 'hide'} 
	_Name : WSTRING;

	_Initialized : BOOL;
	
	_FailError : TOF_Core.ERROR;
	
	_Variables : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
	
	_RootActivity : IActivity;
	
	_DynamicChildren : TOF_Collections.List<0>(0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Members to override" Id="{0a85699b-0877-4f46-87b6-cd53ff5cc628}" />
    <Property Name="Busy" Id="{bab15e3d-0210-4a1d-9bb4-41a96adad825}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether the root activity is currently in an active state.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{25a01fa6-5f1d-49d9-abad-9f8714f9cd46}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	Busy := _RootActivity.Busy;
ELSE
	Busy := FALSE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CancellingAllowed" Id="{dfcebe9b-ab64-4804-8d3a-9c7b480916ca}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestCancel is permitted in the current workflow state.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CancellingAllowed : BOOL]]></Declaration>
      <Get Name="Get" Id="{1950e828-b0f7-41b0-af94-b6507dbd368e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CancellingAllowed := _RootActivity <> 0 AND_THEN Workflows.ValidateTransition(State, WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CancelReason" Id="{526411d6-4df3-4a3b-abe6-82d140566243}">
      <Declaration><![CDATA[(*!
<summary>Gets a reference to the cancellation reason of the root activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CancelReason : REFERENCE TO WSTRING(255)
]]></Declaration>
      <Get Name="Get" Id="{2b2eea18-9847-400b-97a8-d83167a86a22}">
        <Declaration><![CDATA[VAR_INST
	emptyCancelReason : WSTRING(255) := "";
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	CancelReason REF= _RootActivity.CancelReason;
ELSE
	CancelReason REF= emptyCancelReason;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CreateVariables" Id="{77b0e16c-37a3-4b71-b6b3-d4ba31e98e52}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Returns the descriptors of variables exposed in this workflow container.</summary>
<description>
Called once during the first SetRootActivity when VariableCount &gt; 0. Each descriptor must have a unique non-empty name.
</description>
*)
METHOD PROTECTED ABSTRACT CreateVariables : ARRAY [0..VariableCount - 1] OF VARIABLE_DESCRIPTOR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="DisposeDynamicChildren" Id="{6b69ccba-15f0-48cc-974c-9c24c24bc45d}">
      <Declaration><![CDATA[(*!
<summary>Detaches workflow state and releases all registered dynamic workflow elements.</summary>
<description>
Clears RootActivity, variable bindings and FailError before releasing owned dynamic children so no dangling
references remain on the workflow instance.
</description>
*)
METHOD DisposeDynamicChildren]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RootActivity := 0;
_Initialized := FALSE;
_Variables.Clear();
_FailError.Clear();
_DynamicChildren.Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{591aa81e-a79a-4b4b-bf41-97b54125a21a}">
      <Declaration><![CDATA[(*!
<summary>Runs one cyclic execution step of the workflow and its root activity.</summary>
<description>
Invokes OnBeforeRootActivityExecute, RootActivity.Execute and OnAfterRootActivityExecute. Non-terminal exceptions
from the root activity or hooks are caught, recorded in FailError and logged via LogManager; OnAfterRootActivityExecute
still runs after an exception in the preceding step. Terminal allocation failures are propagated.
</description>
*)
METHOD FINAL Execute
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnBeforeRootActivityExecute();

	IF _RootActivity <> 0 THEN
		_RootActivity.Execute();

		IF _RootActivity.State = WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
			_FailError.Clear();
		END_IF
	END_IF
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY

__TRY
	OnAfterRootActivityExecute();
__CATCH(exceptionCode)
	handleException(exceptionCode, __POUNAME(), __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="FailError" Id="{e7a8b006-53f5-4707-ae65-96e34a954950}">
      <Declaration><![CDATA[(*!
<summary>Gets a reference to the durable error snapshot captured when the workflow or root activity fails.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL FailError : REFERENCE TO TOF_Core.ERROR]]></Declaration>
      <Get Name="Get" Id="{241dbeba-018c-4dcc-ae83-a41da8c0e1e7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _FailError.HasError OR_ELSE _RootActivity = 0 THEN
	FailError REF= _FailError;
ELSE
	FailError REF= _RootActivity.FailError;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{8a118ccc-cf33-4895-aaa4-ec240e9f2ff6}">
      <Declaration><![CDATA[//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[DisposeDynamicChildren();]]></ST>
      </Implementation>
    </Method>
    <Property Name="HaltReason" Id="{d3195a13-7315-4fe3-bced-ed5c7b1dd8a3}">
      <Declaration><![CDATA[(*!
<summary>Gets a reference to the halt reason of the root activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL HaltReason : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{b4ccf352-2016-4ab8-933f-a656e330fbf2}">
        <Declaration><![CDATA[VAR_INST
	emptyHaltReason : WSTRING(255) := "";
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _RootActivity <> 0 THEN
	HaltReason REF= _RootActivity.HaltReason;
ELSE
	HaltReason REF= emptyHaltReason;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="handleException" Id="{a21c7e4b-5d91-4f88-9b30-7c4e18f2b6a1}">
      <Declaration><![CDATA[(*!
<summary>Records and logs an uncaught non-terminal exception at the workflow boundary.</summary>
<description>
Propagates terminal allocation failures via RaiseIfAllocationFailed. Stabilizes native exceptions via Clone,
populates FailError and logs the exception through LogManager.TryLogException.
</description>
<param name="exceptionCode">System exception code captured by __CATCH.</param>
<param name="catchPointPOUName">Name of the catching workflow method.</param>
<param name="catchPointPosition">Source position of the catch block.</param>
*)
METHOD PRIVATE handleException
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	catchPointPOUName : STRING(255);
	catchPointPosition : STRING(255);
END_VAR
VAR
	exception : TOF_Core.IException;
	clonedObject : TOF_Core.IObject;
	stabilizedException : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

exception := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := exceptionCode,
	catchPointNamespaceName := NamespaceName,
	catchPointPOUName := catchPointPOUName,
	catchPointPosition := catchPointPosition);

IF exception <> 0 AND_THEN NOT exception.IsDynamicInstance THEN
	clonedObject := exception.Clone();

	IF clonedObject <> 0 AND_THEN __QUERYINTERFACE(clonedObject, stabilizedException) THEN
		exception := stabilizedException;
	END_IF
END_IF

_FailError.Clear();

IF exception <> 0 THEN
	exception.ToError(_FailError, TOF_Core.ERROR_SEVERITY.ERROR);
END_IF

TOF_Core.LogManager.TryLogException(
	exception,
	TOF_Core.ERROR_SEVERITY.ERROR,
	TO_WSTRING(ClassName),
	TO_WSTRING(catchPointPOUName));

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{7260c51c-949e-4411-88e2-fdf1b44dbbf3}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the diagnostic name of the workflow.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Name : WSTRING]]></Declaration>
