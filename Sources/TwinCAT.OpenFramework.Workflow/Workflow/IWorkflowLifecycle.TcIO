<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowLifecycle" Id="{ea7e2343-b453-4257-a102-c07c2213ec98}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines the common lifecycle state machine, guards and control contract for workflow components.</summary>
<description>
Implemented by activities and workflows that execute cyclically and transition through the workflow element
lifecycle states (PASSIVE_READY, ACTIVE_RUNNING, ACTIVE_SUSPENDING, PASSIVE_SUSPENDED, ACTIVE_CANCELLING,
ACTIVE_RESETTING, PASSIVE_COMPLETED, PASSIVE_HALTED, PASSIVE_CANCELLED, PASSIVE_FAILED).
Provides state inspection, error snapshots, cancellation and halt diagnostics, and lifecycle request commands.
</description>
*)
INTERFACE IWorkflowLifecycle EXTENDS TOF_Core.INamed, TOF_Core.IExecutable
]]></Declaration>
    <Property Name="Busy" Id="{154cbbce-183d-489e-921c-4a397d3b593f}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the component is currently in an active state requiring cyclic Execute calls.</summary>
<description>
Returns TRUE in ACTIVE_RUNNING, ACTIVE_CANCELLING, ACTIVE_SUSPENDING and ACTIVE_RESETTING.
FALSE does not certify nested resource release after failure.
</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{dbb8f834-2918-4d90-9f65-02c8fc7e2c28}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="CancellingAllowed" Id="{c30144e7-9df0-406c-b565-86015e333300}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestCancel is permitted in the current lifecycle state.</summary>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY CancellingAllowed : BOOL
]]></Declaration>
      <Get Name="Get" Id="{b76d7296-6724-48d7-aeb5-c6f6c460dda7}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="CancelReason" Id="{e2424581-8934-49ed-8542-60a4397c8ff1}">
      <Declaration><![CDATA[(*!
<summary>Returns the reason recorded for the most recent cancellation request.</summary>
<description>
Set when RequestCancel is accepted and cleared when resetting completes or a new run starts.
</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY CancelReason : REFERENCE TO WSTRING(255)
]]></Declaration>
      <Get Name="Get" Id="{4c1cb5fe-ea3e-4a59-b6c9-7b99f5e6d8f2}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="FailError" Id="{cbaee25a-2751-4732-b020-6d6c3a3af683}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the durable error snapshot captured when execution failed.</summary>
<description>
Populated when an exception transitions the component to PASSIVE_FAILED and cleared when resetting completes
or a new run starts. If diagnostic conversion fails, contains fixed fallback text with epoch timestamps instead of
partial data. Callers must not mutate the returned ERROR instance.
</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY FailError : REFERENCE TO TOF_Core.ERROR
]]></Declaration>
      <Get Name="Get" Id="{e1c5ea6d-a4fc-4699-ba7c-eb521f2d18ac}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="HaltReason" Id="{f7fed69b-50bb-4087-a6d2-8f97eb2969aa}">
      <Declaration><![CDATA[(*!
<summary>Returns the diagnostic reason reported when execution halted internally.</summary>
<description>
Set when transitioning to PASSIVE_HALTED and cleared when resetting completes or a new run starts.
</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY HaltReason : REFERENCE TO WSTRING(255)
]]></Declaration>
      <Get Name="Get" Id="{88452702-8873-4cbb-87d4-84e7e7431a25}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="ResettingAllowed" Id="{e539cc5d-0555-4d9b-9f82-24e3919ac9bb}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestReset is permitted in the current lifecycle state.</summary>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY ResettingAllowed : BOOL
]]></Declaration>
      <Get Name="Get" Id="{d1a445ac-6239-499a-86a0-1d546f689631}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="StartingAllowed" Id="{81c89cbe-ccbb-4340-88de-54bebb9b050f}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestStart is permitted in the current lifecycle state.</summary>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY StartingAllowed : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ef38f69d-2e59-4090-b65d-5836eb34a403}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="State" Id="{97dd944a-6790-4c2e-b42d-2d6de27fa56e}">
      <Declaration><![CDATA[(*!
<summary>Returns the current lifecycle state of the component.</summary>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY State : WORKFLOW_ELEMENT_STATE
]]></Declaration>
      <Get Name="Get" Id="{69bbd997-f75e-49a7-8b92-63b9330f5d11}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="SuspendingAllowed" Id="{892b0e76-ddfe-4850-bc69-84506580d70b}">
      <Declaration><![CDATA[(*!
<summary>Indicates whether RequestSuspend is permitted in the current lifecycle state.</summary>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA.Access' := '1'}
PROPERTY SuspendingAllowed : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ace8860c-69db-4942-89c1-5b3756b91150}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="RequestCancel" Id="{c2cfa23e-2c9a-48c3-a02e-7859a9c5711e}">
      <Declaration><![CDATA[(*!
<summary>Requests cooperative cancellation and runs the initial stopping step.</summary>
<description>
Returns FALSE when the current state does not allow transitioning to ACTIVE_CANCELLING.
Returns TRUE when cancellation has been accepted.
</description>
<param name="reason">Diagnostic reason for cancellation.</param>
*)
METHOD RequestCancel : BOOL
VAR_INPUT
	reason : WSTRING(255);
END_VAR
]]></Declaration>
    </Method>
    <Method Name="RequestReset" Id="{e4b9ef55-78d1-4bd5-9836-875013e34b57}">
      <Declaration><![CDATA[(*!
<summary>Requests resetting from a finished passive state back to PASSIVE_READY.</summary>
<description>
Returns FALSE when the current state does not allow transitioning to ACTIVE_RESETTING.
Returns TRUE when resetting has been accepted.
</description>
*)
METHOD RequestReset : BOOL
]]></Declaration>
    </Method>
    <Method Name="RequestStart" Id="{ed64965f-f686-415d-8593-a67d0ef5c3f8}">
      <Declaration><![CDATA[(*!
<summary>Requests a fresh start from PASSIVE_READY or resumes execution from PASSIVE_SUSPENDED.</summary>
<description>
Returns FALSE when the current state does not allow transitioning to ACTIVE_RUNNING.
Returns TRUE when the request has been accepted.
</description>
*)
METHOD RequestStart : BOOL
]]></Declaration>
    </Method>
    <Method Name="RequestSuspend" Id="{e3302e15-574d-4b1b-ba0a-61c2496425b5}">
      <Declaration><![CDATA[(*!
<summary>Requests cooperative suspension from ACTIVE_RUNNING.</summary>
<description>
Returns FALSE when the current state does not allow transitioning to ACTIVE_SUSPENDING.
Returns TRUE when suspension has been accepted.
</description>
*)
METHOD RequestSuspend : BOOL
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
