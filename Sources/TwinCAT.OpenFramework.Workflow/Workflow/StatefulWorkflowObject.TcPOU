      <Declaration><![CDATA[(*!
<summary>Returns the diagnostic owner kind label ('activity' or 'workflow') for variable registration errors.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PROTECTED ABSTRACT VariableScopeOwnerKind : STRING]]></Declaration>
      <Get Name="Get" Id="{883237fb-26d2-4d4a-a9d2-8c5e25e82ccd}">
