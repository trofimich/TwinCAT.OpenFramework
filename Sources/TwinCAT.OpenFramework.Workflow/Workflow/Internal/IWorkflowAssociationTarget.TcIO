(*
Internal target used by Workflow.FB_reinit to update direct workflow associations after relocation.

Implementations update _Workflow only when a direct association was already set so inherited parent-resolved
associations remain untouched.
*)
{attribute 'hide'}
INTERFACE INTERNAL IWorkflowAssociationTarget EXTENDS TOF_Core.IObject]]></Declaration>
    <Method Name="RebindWorkflow" Id="{36bb76f6-18c6-4119-922e-6887e572af7e}">
      <Declaration><![CDATA[(* Updates a direct workflow association after the owning workflow relocated during online change. *)
METHOD RebindWorkflow
VAR_INPUT
	workflow : IWorkflow;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>