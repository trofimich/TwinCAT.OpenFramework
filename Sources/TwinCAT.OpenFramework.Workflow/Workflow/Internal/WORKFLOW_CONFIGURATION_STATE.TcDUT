(*
Tracks one-shot self-configuration progress for Workflow instances.

UNCONFIGURED is the initial state after FB_init. CONFIGURING guards against reentrant lifecycle or
disposal calls while OnConfigure runs. CONFIGURED marks completion after OnConfigure or an external
nonzero SetRootActivity. FAILED latches a non-terminal OnConfigure failure as non-recoverable.
*)

{attribute 'qualified_only'}
{attribute 'strict'}
TYPE WORKFLOW_CONFIGURATION_STATE :
(
	UNCONFIGURED := 0,
	CONFIGURING,
	CONFIGURED,
	FAILED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>