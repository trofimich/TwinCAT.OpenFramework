<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="WORKFLOW_CONFIGURATION_STATE" Id="{fe301e8b-bf11-4c2a-84d3-9723deb4f565}">
    <Declaration><![CDATA[(*
