<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowElementHelper" Id="{6b8d7a14-5c39-4e21-8f0a-92d14e6b7c35}" SpecialFunc="None">
    <Declaration><![CDATA[(*
