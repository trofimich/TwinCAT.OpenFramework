(*!
<summary>Distinguishes execution-only, embedded and externally keyed bindings.</summary>
<description>Only embedded dependencies transfer ownership to the workflow.</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE DEPENDENCY_BINDING_KIND :
(
	UNSPECIFIED,
	EMBEDDED,
	EXTERNAL_KEY
);
END_TYPE]]></Declaration>
  </DUT>
