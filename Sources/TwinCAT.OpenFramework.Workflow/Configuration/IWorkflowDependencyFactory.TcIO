<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowDependencyFactory" Id="{e8f1b78d-8986-4cd6-ac40-f4a35ba7982b}">
    <Declaration><![CDATA[(*
