(*!
<summary>Creates dynamic custom workflow instances and embedded dependencies.</summary>
<description>
Creation transfers exclusive ownership of a fresh unshared instance to the caller.
Return zero for an unknown type name.
</description>
*)
INTERFACE IWorkflowDependencyFactory]]></Declaration>
    <Method Name="CreateDependency" Id="{7d208a81-b0a8-4b8b-b8af-30ed6a6cfcdb}">
      <Declaration><![CDATA[(*!
<summary>Creates a fresh unowned dynamic custom workflow or embedded dependency.</summary>
<description>Return zero for an unknown type name.</description>
<param name="typeName">Qualified PLC type name.</param>
*)
METHOD CreateDependency : TOF_Core.IObject
VAR_INPUT
	typeName : STRING(255);
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>