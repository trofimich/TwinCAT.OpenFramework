<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowVariableBinder" Id="{940a7e41-3163-4c1d-9490-c9018d5b8999}">
    <Declaration><![CDATA[(*
