(*!
<summary>Binds external PLC variables to a freshly loaded workflow tree.</summary>
<description>
Invoked after the full tree is loaded, before variable requirement validation.
Must only modify variable bindings on the supplied fresh workflow.
</description>
*)
INTERFACE IWorkflowVariableBinder]]></Declaration>
    <Method Name="BindVariables" Id="{d3a0806a-146b-49fc-b0a7-37b7bdf2a1c2}">
      <Declaration><![CDATA[(*!
<summary>Registers external PLC variables on the complete fresh tree before operand validation.</summary>
<param name="workflow">Loaded workflow instance.</param>
*)
METHOD BindVariables
VAR_INPUT
	workflow : IWorkflow;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>