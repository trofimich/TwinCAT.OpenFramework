(*!
<summary>Creates application-specific activities and conditions for Workflows.CreateElement.</summary>
<description>Invoked in the owning task during configuration. The common creation path registers a successful result.</description>
*)
INTERFACE IWorkflowElementFactory]]></Declaration>
    <Method Name="CreateElement" Id="{ea05d59e-6fe1-4e7d-a1c5-4b27528d95d3}">
      <Declaration><![CDATA[(*!
<summary>Creates an unregistered element for a recognized qualified PLC type.</summary>
<description>Return zero for an unknown type. For a recognized type return one fresh, unattached dynamic element
associated with workflow. Transfer exclusive ownership on return. On failure clean up before propagating;
a failed allocation must raise terminal OOM. Do not register or publish the element in this callback.</description>
<param name="typeName">Case-sensitive namespace and PLC type name.</param>
<param name="workflow">Prospective owner supplied to the node constructor.</param>
*)
METHOD CreateElement : IWorkflowElement
VAR_INPUT
	typeName : STRING(255);
	workflow : IWorkflow;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
