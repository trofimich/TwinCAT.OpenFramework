(*
Holds one pending operand check during a synchronous workflow load.

The loader owns the entry and borrows its scope until validation or rollback.
*)

{attribute 'enable_dynamic_creation'}		
TYPE VARIABLE_REQUIREMENT :
STRUCT
	Scope : IVariableLookup;
	Name : STRING;
	Next : POINTER TO VARIABLE_REQUIREMENT;
END_STRUCT
END_TYPE]]></Declaration>
