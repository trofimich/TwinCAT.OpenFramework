(*!
<summary>Internal configuration serialization and deserialization provider for workflow objects.</summary>
<description>
Reads and writes workflow configuration headers, local variable declarations, typed literals, child activities,
conditions, and embedded or external dependencies using TOF_Core.IConfigurationReader and
TOF_Core.IConfigurationWriter.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM INTERNAL WorkflowConfigurationSerializer
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{3a817429-0fa1-41b2-bf58-9a3b2167ed9b}" />
    <Property Name="ClassName" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e22}">
      <Declaration><![CDATA[(*!
<summary>Returns the program name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e23}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e26}">
      <Declaration><![CDATA[(*!
<summary>Returns the library namespace name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e27}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReadActivity" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e28}">
      <Declaration><![CDATA[(*!
<summary>Restores a child and checks the interface required by its parent role.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="loader">Workflow loader providing element construction services.</param>
<param name="node">Configuration node of the activity.</param>
*)
METHOD ReadActivity : IActivity
VAR_INPUT
	loader : IWorkflowLoader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR
VAR
	element : IWorkflowElement;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF node.Handle = 0 THEN
	RETURN;
END_IF

IF loader = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow loader required"
	);
END_IF

element := loader.ReadElement(node := node);

IF NOT __QUERYINTERFACE(element, ReadActivity) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Invalid child type for Activity role"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadCatchActivity" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e29}">
      <Declaration><![CDATA[(*!
<summary>Restores a child and checks the interface required by its parent role.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="loader">Workflow loader providing element construction services.</param>
<param name="node">Configuration node of the catch activity.</param>
*)
METHOD ReadCatchActivity : ICatchActivity
VAR_INPUT
	loader : IWorkflowLoader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR
VAR
	element : IWorkflowElement;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF node.Handle = 0 THEN
	RETURN;
END_IF

IF loader = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow loader required"
	);
END_IF

element := loader.ReadElement(node := node);

IF NOT __QUERYINTERFACE(element, ReadCatchActivity) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Invalid child type for CatchActivity role"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadCondition" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e2a}">
      <Declaration><![CDATA[(*!
<summary>Restores a child and checks the interface required by its parent role.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="loader">Workflow loader providing element construction services.</param>
<param name="node">Configuration node of the condition.</param>
*)
METHOD ReadCondition : ICondition
VAR_INPUT
	loader : IWorkflowLoader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR
VAR
	element : IWorkflowElement;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF node.Handle = 0 THEN
	RETURN;
END_IF

IF loader = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow loader required"
	);
END_IF

element := loader.ReadElement(node := node);

IF NOT __QUERYINTERFACE(element, ReadCondition) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Invalid child type for Condition role"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadConfigurationHeader" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e2b}">
      <Declaration><![CDATA[(*!
<summary>Reads local variable declarations and the display name for a named workflow object.</summary>
<description>
Restores local declarations into scope and reads the 'name' field into target.Name.
Use within one synchronous load.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration object node.</param>
<param name="target">Named workflow object receiving the restored display name.</param>
<param name="scope">Declaration container receiving local variable declarations.</param>
*)
METHOD ReadConfigurationHeader
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	target : TOF_Core.INamed;
	scope : IDeclaredVariableContainer;
END_VAR
VAR
	displayName : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReadDeclarations(reader := reader, node := node, scope := scope);
reader.ReadValue(
	node := reader.GetField(node := node, name := 'name'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(displayName),
	size := SIZEOF(displayName)
);
target.Name := displayName;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadDeclarations" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e2d}">
      <Declaration><![CDATA[(*!
<summary>Copies all initial declarations into a fresh local scope.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration object node.</param>
<param name="scope">Declaration container receiving local variable declarations.</param>
*)
METHOD ReadDeclarations
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	scope : IDeclaredVariableContainer;
END_VAR
VAR
	items : TOF_Core.CONFIGURATION_NODE;
	count : DINT;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[items := reader.GetField(node := node, name := 'variables');
count := TO_DINT(reader.GetArraySize(node := items));

FOR i := 0 TO count - 1 DO
	readDeclarationValue(reader := reader, node := reader.GetItem(node := items, index := TO_UDINT(i)), scope := scope);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="readDeclarationValue" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e2e}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Decodes one typed scalar or array declaration.</summary>
<description>Passes elementCount = 0 for a scalar variable, or a positive count for an array.
Temporary storage remains local and is released on success or failure.</description>
*)
METHOD PRIVATE readDeclarationValue
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	scope : IDeclaredVariableContainer;
END_VAR
VAR
	name : STRING;
	typeName : STRING;
	value : __SYSTEM.AnyType;
	valueType : TOF_Core.CONFIGURATION_VALUE_TYPE;
	initial : TOF_Core.CONFIGURATION_NODE;
	item : TOF_Core.CONFIGURATION_NODE;
	isArray : BOOL;
	count : UDINT;
	elementCount : DINT;
	i : UDINT;
	storage : POINTER TO BYTE;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[name := ReadName(reader := reader, node := reader.GetField(node := node, name := 'name'));
typeName := ReadName(reader := reader, node := reader.GetField(node := node, name := 'type'));
value := WorkflowElementFactory.ParseTypeDescriptor(typeName := typeName);
valueType := WorkflowElementFactory.ConfigurationValueType(typeClass := value.TypeClass);
initial := reader.GetField(node := node, name := 'initialValue');
isArray := reader.IsArray(node := initial);

IF isArray THEN
	count := reader.GetArraySize(node := initial);
	elementCount := TO_DINT(count);

	IF count = 0 THEN
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "An array declaration requires at least one element"
		);
	END_IF
ELSE
	count := 1;
	elementCount := 0;
END_IF

IF TO_ULINT(count) * TO_ULINT(value.diSize) > 2147483647 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Invalid declaration length"
	);
END_IF

storage := __NEW(BYTE, (count * TO_UDINT(value.diSize)));

IF storage = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

__TRY
	FOR i := 0 TO count - 1 DO
		item := initial;

		IF isArray THEN
			item := reader.GetItem(node := initial, index := i);
		END_IF

		reader.ReadValue(
			node := item,
			valueType := valueType,
			data := storage + i * TO_UDINT(value.diSize),
			size := TO_UDINT(value.diSize)
		);
	END_FOR

	scope.DeclareConfigurationVariable(
		name := name,
		typeName := typeName,
		initialData := storage,
		elementCount := elementCount
	);
__CATCH(exceptionCode)
	IF storage <> 0 THEN
		__DELETE(storage);
	END_IF

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

__DELETE(storage);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadLiteral" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e2f}">
      <Declaration><![CDATA[(*!
<summary>Allocates and decodes a literal into caller-owned byte storage.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration node containing literal object.</param>
*)
METHOD ReadLiteral : __SYSTEM.AnyType
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR
VAR
	typeName : STRING;
	value : __SYSTEM.AnyType;
	valueType : TOF_Core.CONFIGURATION_VALUE_TYPE;
	storage : POINTER TO BYTE;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[typeName := ReadName(reader := reader, node := reader.GetField(node := node, name := 'type'));
value := WorkflowElementFactory.ParseTypeDescriptor(typeName := typeName);
valueType := WorkflowElementFactory.ConfigurationValueType(typeClass := value.TypeClass);
storage := __NEW(BYTE, TO_UDINT(value.diSize));

IF storage = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

__TRY
	reader.ReadValue(
		node := reader.GetField(node := node, name := 'value'),
		valueType := valueType,
		data := storage,
		size := TO_UDINT(value.diSize)
	);
__CATCH(exceptionCode)
	__DELETE(storage);
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

value.pValue := storage;
ReadLiteral := value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadName" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e30}">
      <Declaration><![CDATA[(*!
<summary>Reads an IEC name without truncation.</summary>
<description>The reader rejects an oversized field.</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration node containing string name.</param>
*)
METHOD ReadName : STRING
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[reader.ReadValue(
	node := node,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(ReadName),
	size := SIZEOF(ReadName)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadTypeName" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e31}">
      <Declaration><![CDATA[(*!
<summary>Reads a qualified configuration type name.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Configuration node containing type name.</param>
*)
METHOD ReadTypeName : STRING(255)
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[reader.ReadValue(
	node := node,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(ReadTypeName),
	size := SIZEOF(ReadTypeName)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadVariableHasValueCondition" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e32}">
      <Declaration><![CDATA[(*!
<summary>Restores a child and checks the interface required by its parent role.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="loader">Workflow loader providing element construction services.</param>
<param name="node">Configuration node of the condition.</param>
*)
METHOD ReadVariableHasValueCondition : IVariableHasValueCondition
VAR_INPUT
	loader : IWorkflowLoader;
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR
VAR
	element : IWorkflowElement;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF node.Handle = 0 THEN
	RETURN;
END_IF

IF loader = 0 THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow loader required"
	);
END_IF

element := loader.ReadElement(node := node);

IF NOT __QUERYINTERFACE(element, ReadVariableHasValueCondition) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Invalid child type for VariableHasValueCondition role"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResolveWorkflowLoader" Id="{c9512f29-8c0f-4872-acab-18a8ded26844}">
      <Declaration><![CDATA[(*!
<summary>Resolves and validates the workflow loader from the configuration deserialization context.</summary>
<description>
Validates that the supplied deserialization context is present and implements IWorkflowLoader.
Because workflow elements strictly depend on loader services to reconstruct child elements and
register required variables, a missing or incompatible context violates a mandatory precondition
and raises WorkflowConfiguration. This is not a Try method; failure is fatal to deserialization and
interrupts restoration.
The returned interface is borrowed for the duration of the synchronous deserialization call and must not be
retained across cycles.
</description>
<param name="context">Active configuration deserialization context passed to Deserialize.</param>
*)
METHOD ResolveWorkflowLoader : IWorkflowLoader
VAR_INPUT
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF context = 0 OR_ELSE NOT __QUERYINTERFACE(context, loader) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow loader context required"
	);
END_IF

ResolveWorkflowLoader := loader;]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteConfigurationHeader" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e33}">
      <Declaration><![CDATA[(*!
<summary>Writes qualified type, display name and local declarations for one node.</summary>
<description>Call once per node before writing its configuration fields. Only owned declarations are enumerated.</description>
<param name="writer">Active configuration writer.</param>
<param name="source">Source workflow object exposing NamespaceName and ClassName.</param>
<param name="displayName">Display name of the workflow object.</param>
<param name="scope">Declaration container whose owned declarations will be written.</param>
*)
METHOD WriteConfigurationHeader
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	source : TOF_Core.IObject;
	displayName : WSTRING;
	scope : IDeclaredVariableContainer;
END_VAR
VAR
	qualifiedName : STRING(255);
	position : DINT;
	variableName : STRING;
	declaration : VARIABLE_DECLARATION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[qualifiedName := TOF_Core.Strings.Concat255(source.NamespaceName, '.', source.ClassName);
writer.WriteValue(
	name := 'type',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(qualifiedName),
	size := SIZEOF(qualifiedName)
);
writer.WriteValue(
	name := 'name',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(displayName),
	size := SIZEOF(displayName)
);
writer.BeginArray(name := 'variables');

WHILE scope.NextDeclaration(position := position, name => variableName, declaration => declaration) DO
	writeDeclaration(writer := writer, scope := scope, variableName := variableName, declaration := declaration);
END_WHILE

writer.EndArray();]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteConfigurationLiteral" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e34}">
      <Declaration><![CDATA[(*!
<summary>Writes the type and value of a configured literal operand.</summary>
<description>The source descriptor is borrowed for this call. Unsupported types raise.</description>
<param name="writer">Active configuration writer.</param>
<param name="name">Object property name.</param>
<param name="value">Descriptor of the literal value.</param>
*)
METHOD WriteConfigurationLiteral
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	name : STRING;
	value : __SYSTEM.AnyType;
END_VAR
VAR
	typeName : STRING;
	valueType : TOF_Core.CONFIGURATION_VALUE_TYPE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[typeName := WorkflowElementFactory.ConfigurationTypeName(
	typeClass := value.TypeClass,
	size := TO_UDINT(value.diSize)
);
valueType := WorkflowElementFactory.ConfigurationValueType(typeClass := value.TypeClass);
writer.BeginObject(name := name);
writer.WriteValue(
	name := 'type',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(typeName),
	size := SIZEOF(typeName)
);
writer.WriteValue(
	name := 'value',
	valueType := valueType,
	data := value.pValue,
	size := TO_UDINT(value.diSize)
);
writer.EndObject();]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteConfigurationObject" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e35}">
      <Declaration><![CDATA[(*!
<summary>Writes a nested configuration under the supplied role.</summary>
<description>The object must implement IConfigurationSerializable. Null or unsupported objects raise.</description>
<param name="writer">Active configuration writer.</param>
<param name="name">Enclosing property name.</param>
<param name="source">Configuration source instance.</param>
*)
METHOD WriteConfigurationObject
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	name : STRING;
	source : TOF_Core.IObject;
END_VAR
VAR
	serializable : TOF_Core.IConfigurationSerializable;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF source = 0 OR_ELSE NOT __QUERYINTERFACE(source, serializable) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Missing or unsupported configuration object"
	);
END_IF

writer.BeginObject(name := name);
serializable.Serialize(writer := writer);
writer.EndObject();]]></ST>
      </Implementation>
    </Method>
    <Method Name="writeDeclaration" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e36}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Writes the declaration type and its complete initial value.</summary>
<description>Uses temporary storage for one element and releases it on success and on writer failure.</description>
*)
METHOD PRIVATE writeDeclaration
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	scope : IDeclaredVariableContainer;
	variableName : STRING;
	declaration : VARIABLE_DECLARATION;
END_VAR
VAR
	value : __SYSTEM.AnyType;
	storage : POINTER TO BYTE;
	typeName : STRING;
	valueType : TOF_Core.CONFIGURATION_VALUE_TYPE;
	fieldName : STRING;
	i : DINT;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[typeName := WorkflowElementFactory.ConfigurationTypeName(
	typeClass := declaration.ElementType,
	size := declaration.ElementSize
);
valueType := WorkflowElementFactory.ConfigurationValueType(typeClass := declaration.ElementType);
writer.BeginObject(name := '');
writer.WriteValue(
	name := 'name',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(variableName),
	size := SIZEOF(variableName)
);
writer.WriteValue(
	name := 'type',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(typeName),
	size := SIZEOF(typeName)
);

IF declaration.IsArray THEN
	writer.BeginArray(name := 'initialValue');
ELSE
	fieldName := 'initialValue';
END_IF

storage := __NEW(BYTE, declaration.ElementSize);

IF storage = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

value.pValue := storage;
value.diSize := TO_DINT(declaration.ElementSize);
value.TypeClass := declaration.ElementType;

__TRY
	FOR i := 0 TO declaration.ElementCount - 1 DO
		scope.CopyInitialElement(name := variableName, index := i, destination := value);
		writer.WriteValue(name := fieldName, valueType := valueType, data := storage, size := declaration.ElementSize);
	END_FOR
__CATCH(exceptionCode)
	__DELETE(storage);
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

__DELETE(storage);

IF declaration.IsArray THEN
	writer.EndArray();
END_IF

writer.EndObject();]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteDependency" Id="{b52e7d93-4c82-4fa6-ad23-82e9b6f14e37}">
      <Declaration><![CDATA[(*!
<summary>Writes one embedded configuration or one stable external key.</summary>
<description>
An unspecified binding raises with the node name. Borrowed objects need no serialization interface.
</description>
<param name="writer">Active configuration writer.</param>
<param name="role">Role name of the dependency.</param>
<param name="kind">Embedded or external binding kind.</param>
<param name="key">External key on external binding.</param>
<param name="dependency">Dependency object instance.</param>
<param name="nodeName">Owner node name for diagnostics.</param>
*)
METHOD WriteDependency
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
	role : STRING;
	kind : DEPENDENCY_BINDING_KIND;
	key : STRING;
	dependency : TOF_Core.IObject;
	nodeName : WSTRING;
END_VAR
VAR
	typeName : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[writer.BeginObject(name := role);

CASE kind OF
	DEPENDENCY_BINDING_KIND.EMBEDDED:
		typeName := TOF_Core.Strings.Concat255(dependency.NamespaceName, '.', dependency.ClassName);
		writer.WriteValue(
			name := 'type',
			valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
			data := ADR(typeName),
			size := SIZEOF(typeName)
		);
		WriteConfigurationObject(writer := writer, name := 'configuration', source := dependency);
	DEPENDENCY_BINDING_KIND.EXTERNAL_KEY:
		writer.WriteValue(
			name := 'key',
			valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
			data := ADR(key),
			size := SIZEOF(key)
		);
ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := TOF_Core.WideStrings.Concat255("Missing dependency binding role at ", nodeName)
	);
END_CASE

writer.EndObject();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FormatComparisonOperator" Id="{85ae3c6b-cc20-43d2-bfdb-720d600b2564}">
      <Declaration><![CDATA[(*!
<summary>Formats a comparison operator enumeration value into its standard string representation.</summary>
<description>
Produces '=', '<>', '<', '<=', '>', or '>='. Unknown values raise a configuration exception.
</description>
<param name="comparisonOperator">Comparison operator value to format.</param>
*)
METHOD FormatComparisonOperator : STRING
VAR_INPUT
	comparisonOperator : COMPARISON_OPERATOR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE comparisonOperator OF
	COMPARISON_OPERATOR.EQUAL:
		FormatComparisonOperator := '=';

	COMPARISON_OPERATOR.NOT_EQUAL:
		FormatComparisonOperator := '<>';

	COMPARISON_OPERATOR.LESS_THAN:
		FormatComparisonOperator := '<';

	COMPARISON_OPERATOR.LESS_THAN_OR_EQUAL:
		FormatComparisonOperator := '<=';

	COMPARISON_OPERATOR.GREATER_THAN:
		FormatComparisonOperator := '>';

	COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL:
		FormatComparisonOperator := '>=';

ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unknown comparison operator value"
	);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FormatLogicalOperator" Id="{8dd00bd7-aeda-4c10-b0bc-5e418f75d3ae}">
      <Declaration><![CDATA[(*!
<summary>Formats a logical operator enumeration value into its standard uppercase string representation.</summary>
<description>
Produces 'AND' or 'OR'. Unknown values raise a configuration exception.
</description>
<param name="logicalOperator">Logical operator value to format.</param>
*)
METHOD FormatLogicalOperator : STRING
VAR_INPUT
	logicalOperator : LOGICAL_OPERATOR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE logicalOperator OF
	LOGICAL_OPERATOR.AND_:
		FormatLogicalOperator := 'AND';

	LOGICAL_OPERATOR.OR_:
		FormatLogicalOperator := 'OR';

ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unknown logical operator value"
	);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParseComparisonOperator" Id="{411da550-e56b-4732-b331-f167951a9edf}">
      <Declaration><![CDATA[(*!
<summary>Parses a comparison operator from its string representation.</summary>
<description>
Accepts standard comparison operators: '=', '<>', '<', '<=', '>', '>='.
Also accepts common synonyms: '==' for '=', '!=' for '<>'.
Evaluation is case-insensitive. Unknown operator strings raise a configuration exception.
</description>
<param name="rawOperator">Operator string to parse.</param>
*)
METHOD ParseComparisonOperator : COMPARISON_OPERATOR
VAR_INPUT
	rawOperator : STRING;
END_VAR
VAR
	normalized : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[normalized := Tc2_Utilities.F_ToUCase(in := rawOperator);

IF normalized = '='
	OR_ELSE normalized = '=='
THEN
	ParseComparisonOperator := COMPARISON_OPERATOR.EQUAL;

ELSIF normalized = '<>'
	OR_ELSE normalized = '!='
THEN
	ParseComparisonOperator := COMPARISON_OPERATOR.NOT_EQUAL;

ELSIF normalized = '<' THEN
	ParseComparisonOperator := COMPARISON_OPERATOR.LESS_THAN;

ELSIF normalized = '<=' THEN
	ParseComparisonOperator := COMPARISON_OPERATOR.LESS_THAN_OR_EQUAL;

ELSIF normalized = '>' THEN
	ParseComparisonOperator := COMPARISON_OPERATOR.GREATER_THAN;

ELSIF normalized = '>=' THEN
	ParseComparisonOperator := COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL;

ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unknown comparison operator"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParseLogicalOperator" Id="{29964157-d261-4c7c-95e4-7ee0fe2fae24}">
      <Declaration><![CDATA[(*!
<summary>Parses a logical operator from its string representation.</summary>
<description>
Supports 'AND' and 'OR' (including 'AND_' and 'OR_'). Evaluation is case-insensitive.
Unknown operator strings raise a configuration exception.
</description>
<param name="rawOperator">Operator string to parse.</param>
*)
METHOD ParseLogicalOperator : LOGICAL_OPERATOR
VAR_INPUT
	rawOperator : STRING;
END_VAR
VAR
	normalized : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[normalized := Tc2_Utilities.F_ToUCase(in := rawOperator);

IF normalized = 'AND'
	OR_ELSE normalized = 'AND_'
THEN
	ParseLogicalOperator := LOGICAL_OPERATOR.AND_;

ELSIF normalized = 'OR'
	OR_ELSE normalized = 'OR_'
THEN
	ParseLogicalOperator := LOGICAL_OPERATOR.OR_;

ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unknown logical operator"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>