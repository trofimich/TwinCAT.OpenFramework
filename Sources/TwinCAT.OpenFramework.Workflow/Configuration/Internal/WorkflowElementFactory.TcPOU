(*
Internal element factory and elementary IEC type registry for the Workflow library.

Allocates standard workflow activities and conditions by qualified type name, delegates unknown type names to an
optional caller-supplied factory, validates and registers dynamically created elements with their owning workflow,
and maps between elementary IEC type classes and configuration type names.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM INTERNAL WorkflowElementFactory
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f99}" />
    <Method Name="allocateStandardElement" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f12}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*
Allocates a concrete built-in activity or condition by qualified name.

Unknown names return zero. A recognized type whose allocation fails raises terminal OOM. The caller
registers each successful result before exposure.
typeName — Qualified PLC name.
workflow — Live owner for FB initialization.
*)
METHOD PRIVATE allocateStandardElement : IWorkflowElement
VAR_INPUT
	typeName : STRING(255);
	workflow : IWorkflow;
END_VAR
VAR
	prefix : STRING(255);
	prefixLength : INT;
	localName : STRING(255);
	assignVariableActivity : POINTER TO AssignVariableActivity;
	delayActivity : POINTER TO DelayActivity;
	ifElseActivity : POINTER TO IfElseActivity;
	invokeTaskActivity : POINTER TO InvokeTaskActivity;
	parallelActivity : POINTER TO ParallelActivity;
	sequenceActivity : POINTER TO SequenceActivity;
	tryCatchActivity : POINTER TO TryCatchActivity;
	catchActivity : POINTER TO CatchActivity;
	waitAndPickActivity : POINTER TO WaitAndPickActivity;
	waitConditionActivity : POINTER TO WaitConditionActivity;
	waitVariableValueActivity : POINTER TO WaitVariableValueActivity;
	whileActivity : POINTER TO WhileActivity;
	compareVariableCondition : POINTER TO CompareVariableCondition;
	compositeCondition : POINTER TO CompositeCondition;
	notCondition : POINTER TO NotCondition;
	trueCondition : POINTER TO TrueCondition;
	variableHasValueCondition : POINTER TO VariableHasValueCondition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[prefix := TOF_Core.Strings.Concat255(NamespaceName, '.');
prefixLength := Tc2_Standard.LEN(STR := prefix);

IF Tc2_Standard.LEFT(STR := typeName, SIZE := prefixLength) <> prefix THEN
	RETURN;
END_IF

localName := Tc2_Standard.RIGHT(STR := typeName, SIZE := Tc2_Standard.LEN(STR := typeName) - prefixLength);

IF localName = 'AssignVariableActivity' THEN
	assignVariableActivity := __NEW(AssignVariableActivity(workflow := workflow));

	IF assignVariableActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := assignVariableActivity^;
ELSIF localName = 'DelayActivity' THEN
	delayActivity := __NEW(DelayActivity(workflow := workflow));

	IF delayActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := delayActivity^;
ELSIF localName = 'IfElseActivity' THEN
	ifElseActivity := __NEW(IfElseActivity(workflow := workflow));

	IF ifElseActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := ifElseActivity^;
ELSIF localName = 'InvokeTaskActivity' THEN
	invokeTaskActivity := __NEW(InvokeTaskActivity(workflow := workflow));

	IF invokeTaskActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := invokeTaskActivity^;
ELSIF localName = 'ParallelActivity' THEN
	parallelActivity := __NEW(ParallelActivity(workflow := workflow));

	IF parallelActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := parallelActivity^;
ELSIF localName = 'SequenceActivity' THEN
	sequenceActivity := __NEW(SequenceActivity(workflow := workflow));

	IF sequenceActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := sequenceActivity^;
ELSIF localName = 'TryCatchActivity' THEN
	tryCatchActivity := __NEW(TryCatchActivity(workflow := workflow));

	IF tryCatchActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := tryCatchActivity^;
ELSIF localName = 'CatchActivity' THEN
	catchActivity := __NEW(CatchActivity(workflow := workflow));

	IF catchActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := catchActivity^;
ELSIF localName = 'WaitAndPickActivity' THEN
	waitAndPickActivity := __NEW(WaitAndPickActivity(workflow := workflow));

	IF waitAndPickActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := waitAndPickActivity^;
ELSIF localName = 'WaitConditionActivity' THEN
	waitConditionActivity := __NEW(WaitConditionActivity(workflow := workflow));

	IF waitConditionActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := waitConditionActivity^;
ELSIF localName = 'WaitVariableValueActivity' THEN
	waitVariableValueActivity := __NEW(WaitVariableValueActivity(workflow := workflow));

	IF waitVariableValueActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := waitVariableValueActivity^;
ELSIF localName = 'WhileActivity' THEN
	whileActivity := __NEW(WhileActivity(workflow := workflow));

	IF whileActivity = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := whileActivity^;
ELSIF localName = 'CompareVariableCondition' THEN
	compareVariableCondition := __NEW(CompareVariableCondition(workflow := workflow));

	IF compareVariableCondition = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := compareVariableCondition^;
ELSIF localName = 'CompositeCondition' THEN
	compositeCondition := __NEW(CompositeCondition(workflow := workflow));

	IF compositeCondition = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := compositeCondition^;
ELSIF localName = 'NotCondition' THEN
	notCondition := __NEW(NotCondition(workflow := workflow));

	IF notCondition = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := notCondition^;
ELSIF localName = 'TrueCondition' THEN
	trueCondition := __NEW(TrueCondition(workflow := workflow));

	IF trueCondition = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := trueCondition^;
ELSIF localName = 'VariableHasValueCondition' THEN
	variableHasValueCondition := __NEW(VariableHasValueCondition(workflow := workflow));

	IF variableHasValueCondition = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	allocateStandardElement := variableHasValueCondition^;
ELSE
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f13}">
      <Declaration><![CDATA[(* Returns the program name for diagnostic reporting. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f14}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConfigurationTypeName" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f15}">
      <Declaration><![CDATA[(*
Returns the elementary IEC spelling used in configuration documents.

String capacities exclude the terminator. Unsupported types raise before writing the value.
*)
METHOD ConfigurationTypeName : STRING
VAR_INPUT
	typeClass : __SYSTEM.TYPE_CLASS;
	size : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE typeClass OF
	__SYSTEM.TYPE_CLASS.TYPE_BOOL:
		ConfigurationTypeName := 'BOOL';
	__SYSTEM.TYPE_CLASS.TYPE_BYTE:
		ConfigurationTypeName := 'BYTE';
	__SYSTEM.TYPE_CLASS.TYPE_WORD:
		ConfigurationTypeName := 'WORD';
	__SYSTEM.TYPE_CLASS.TYPE_DWORD:
		ConfigurationTypeName := 'DWORD';
	__SYSTEM.TYPE_CLASS.TYPE_LWORD:
		ConfigurationTypeName := 'LWORD';
	__SYSTEM.TYPE_CLASS.TYPE_SINT:
		ConfigurationTypeName := 'SINT';
	__SYSTEM.TYPE_CLASS.TYPE_INT:
		ConfigurationTypeName := 'INT';
	__SYSTEM.TYPE_CLASS.TYPE_DINT:
		ConfigurationTypeName := 'DINT';
	__SYSTEM.TYPE_CLASS.TYPE_LINT:
		ConfigurationTypeName := 'LINT';
	__SYSTEM.TYPE_CLASS.TYPE_USINT:
		ConfigurationTypeName := 'USINT';
	__SYSTEM.TYPE_CLASS.TYPE_UINT:
		ConfigurationTypeName := 'UINT';
	__SYSTEM.TYPE_CLASS.TYPE_UDINT:
		ConfigurationTypeName := 'UDINT';
	__SYSTEM.TYPE_CLASS.TYPE_ULINT:
		ConfigurationTypeName := 'ULINT';
	__SYSTEM.TYPE_CLASS.TYPE_REAL:
		ConfigurationTypeName := 'REAL';
	__SYSTEM.TYPE_CLASS.TYPE_LREAL:
		ConfigurationTypeName := 'LREAL';
	__SYSTEM.TYPE_CLASS.TYPE_TIME:
		ConfigurationTypeName := 'TIME';
	__SYSTEM.TYPE_CLASS.TYPE_LTIME:
		ConfigurationTypeName := 'LTIME';
	__SYSTEM.TYPE_CLASS.TYPE_DATE:
		ConfigurationTypeName := 'DATE';
	__SYSTEM.TYPE_CLASS.TYPE_LDATE:
		ConfigurationTypeName := 'LDATE';
	__SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY:
		ConfigurationTypeName := 'TOD';
	__SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY:
		ConfigurationTypeName := 'LTOD';
	__SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME:
		ConfigurationTypeName := 'DT';
	__SYSTEM.TYPE_CLASS.TYPE_LDATEANDTIME:
		ConfigurationTypeName := 'LDT';
	__SYSTEM.TYPE_CLASS.TYPE_STRING:
		ConfigurationTypeName := TOF_Core.Strings.Concat255('STRING(', TO_STRING(size - 1), ')');
	__SYSTEM.TYPE_CLASS.TYPE_WSTRING:
		ConfigurationTypeName := TOF_Core.Strings.Concat255('WSTRING(', TO_STRING(size / 2 - 1), ')');
ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unsupported configuration value type"
	);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigurationValueType" Id="{538b3524-fc2b-4092-850d-07e38cbea93d}">
      <Declaration><![CDATA[(*
Maps an elementary IEC type class to its CONFIGURATION_VALUE_TYPE enum.

Unsupported type classes raise a configuration exception.
typeClass — Type class from __SYSTEM.TYPE_CLASS.
*)
METHOD ConfigurationValueType : TOF_Core.CONFIGURATION_VALUE_TYPE
VAR_INPUT
	typeClass : __SYSTEM.TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE typeClass OF
	__SYSTEM.TYPE_CLASS.TYPE_BOOL:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL;
	__SYSTEM.TYPE_CLASS.TYPE_BYTE:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BYTE;
	__SYSTEM.TYPE_CLASS.TYPE_WORD:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WORD;
	__SYSTEM.TYPE_CLASS.TYPE_DWORD:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DWORD;
	__SYSTEM.TYPE_CLASS.TYPE_LWORD:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LWORD;
	__SYSTEM.TYPE_CLASS.TYPE_SINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_SINT;
	__SYSTEM.TYPE_CLASS.TYPE_INT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_INT;
	__SYSTEM.TYPE_CLASS.TYPE_DINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT;
	__SYSTEM.TYPE_CLASS.TYPE_LINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LINT;
	__SYSTEM.TYPE_CLASS.TYPE_USINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_USINT;
	__SYSTEM.TYPE_CLASS.TYPE_UINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UINT;
	__SYSTEM.TYPE_CLASS.TYPE_UDINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UDINT;
	__SYSTEM.TYPE_CLASS.TYPE_ULINT:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_ULINT;
	__SYSTEM.TYPE_CLASS.TYPE_REAL:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL;
	__SYSTEM.TYPE_CLASS.TYPE_LREAL:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LREAL;
	__SYSTEM.TYPE_CLASS.TYPE_TIME:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TIME;
	__SYSTEM.TYPE_CLASS.TYPE_LTIME:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTIME;
	__SYSTEM.TYPE_CLASS.TYPE_DATE:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DATE;
	__SYSTEM.TYPE_CLASS.TYPE_LDATE:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDATE;
	__SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TOD;
	__SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTOD;
	__SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DT;
	__SYSTEM.TYPE_CLASS.TYPE_LDATEANDTIME:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDT;
	__SYSTEM.TYPE_CLASS.TYPE_STRING:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING;
	__SYSTEM.TYPE_CLASS.TYPE_WSTRING:
		ConfigurationValueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING;
ELSE
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unsupported configuration value type"
	);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateElement" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f16}">
      <Declaration><![CDATA[(*
Creates a dynamic workflow element and returns it after ownership registration.

Requires a live ready workflow in its owning task. Built-in qualified names are handled first, then the
optional application factory. Unknown names raise a configuration exception. A successful element is borrowed
until workflow disposal; configuration and attachment are separate operations. Registration failures propagate
under the RegisterChild cleanup contract. Call outside lifecycle methods and without reentry.
typeName — Case-sensitive qualified PLC type.
workflow — Owner of the resulting element.
factory — Optional application type factory.
*)
METHOD CreateElement : IWorkflowElement
VAR_INPUT
	typeName : STRING(255);
	workflow : IWorkflow;
	factory : IWorkflowElementFactory := 0;
END_VAR
VAR
	element : IWorkflowElement;
	owner : IWorkflow;
	elementParent : IWorkflowElement;
	object : TOF_Core.IObject;
	exceptionCode : __SYSTEM.ExceptionCode;
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

IF workflow = 0 OR_ELSE typeName = '' OR_ELSE workflow.State <> WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Creating an element requires a qualified type name and a ready workflow"
	);
END_IF

element := allocateStandardElement(typeName := typeName, workflow := workflow);

IF element = 0 AND_THEN factory <> 0 THEN
	element := factory.CreateElement(typeName := typeName, workflow := workflow);
END_IF

IF element = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
	message := TOF_Core.WideStrings.Concat255("Unknown workflow element type: ", TO_WSTRING(typeName));
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := message
	);
END_IF

object := element;

__TRY
	TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
	owner := element.Workflow;
	elementParent := element.Parent;

	IF NOT element.IsDynamicInstance
		OR_ELSE owner = 0
		OR_ELSE owner.SelfAddress <> workflow.SelfAddress
		OR_ELSE elementParent <> 0
		OR_ELSE typeName <> TOF_Core.Strings.Concat255(element.NamespaceName, '.', element.ClassName)
	THEN
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Factory returned an invalid element for this workflow"
		);
	END_IF
__CATCH(exceptionCode)
	TOF_Core.Memory.TryReleaseDynamicObject(instance := object);
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

workflow.RegisterChild(child := element);
TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
CreateElement := element;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParseTypeDescriptor" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f17}">
      <Declaration><![CDATA[(*
Resolves an exact elementary type and storage capacity.

Use within one synchronous load. Handles borrow the active document and expire when it is replaced.
*)
METHOD ParseTypeDescriptor : __SYSTEM.AnyType
VAR_INPUT
	typeName : STRING;
END_VAR
VAR
	offset : INT;
	length : INT;
	capacity : DINT;
	i : INT;
	digit : BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF typeName = 'BOOL' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_BOOL;
	ParseTypeDescriptor.diSize := 1;
ELSIF typeName = 'BYTE' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_BYTE;
	ParseTypeDescriptor.diSize := 1;
ELSIF typeName = 'WORD' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WORD;
	ParseTypeDescriptor.diSize := 2;
ELSIF typeName = 'DWORD' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_DWORD;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LWORD' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LWORD;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'SINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_SINT;
	ParseTypeDescriptor.diSize := 1;
ELSIF typeName = 'INT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_INT;
	ParseTypeDescriptor.diSize := 2;
ELSIF typeName = 'DINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_DINT;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LINT;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'USINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_USINT;
	ParseTypeDescriptor.diSize := 1;
ELSIF typeName = 'UINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_UINT;
	ParseTypeDescriptor.diSize := 2;
ELSIF typeName = 'UDINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_UDINT;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'ULINT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_ULINT;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'REAL' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_REAL;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LREAL' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LREAL;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'TIME' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_TIME;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LTIME' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LTIME;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'DATE' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_DATE;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LDATE' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LDATE;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'TOD' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LTOD' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY;
	ParseTypeDescriptor.diSize := 8;
ELSIF typeName = 'DT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME;
	ParseTypeDescriptor.diSize := 4;
ELSIF typeName = 'LDT' THEN
	ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_LDATEANDTIME;
	ParseTypeDescriptor.diSize := 8;
ELSE
	IF Tc2_Standard.LEFT(STR := typeName, SIZE := 7) = 'STRING(' THEN
		offset := 7;
		ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
	ELSIF Tc2_Standard.LEFT(STR := typeName, SIZE := 8) = 'WSTRING(' THEN
		offset := 8;
		ParseTypeDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
	ELSE
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Unknown IEC configuration type"
		);
	END_IF

	length := Tc2_Standard.LEN(STR := typeName);

	IF length <= offset + 1 OR_ELSE typeName[length - 1] <> 41 THEN
		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Invalid string capacity"
		);
	END_IF

	FOR i := offset TO length - 2 DO
		digit := typeName[i];

		IF digit < 48 OR_ELSE digit > 57 OR_ELSE capacity > 107374180 THEN
			WorkflowExceptions.ThrowWorkflowConfiguration(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := "Invalid or excessive string capacity"
			);
		END_IF

		capacity := capacity * 10 + TO_DINT(digit) - 48;
	END_FOR

	ParseTypeDescriptor.diSize := (capacity + 1) * SEL(offset = 8, 1, 2);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f18}">
      <Declaration><![CDATA[(* Returns the library namespace name for diagnostic reporting. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a41f6c82-3b71-4e95-9c12-71d8a5e03f19}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
