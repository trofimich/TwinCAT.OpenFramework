<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowLoader" Id="{0eee9579-6c3c-4821-9744-bc84948298a2}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides workflow graph reconstruction services during configuration loading.</summary>
<description>
Acts as a configuration deserialization context for workflow elements during deserialization.
The caller keeps the loader and active document alive for the call.
</description>
*)
INTERFACE IWorkflowLoader EXTENDS TOF_Core.IConfigurationDeserializationContext]]></Declaration>
    <Method Name="BindDependency" Id="{22e0a73a-85b9-443f-8444-35d836c76549}">
      <Declaration><![CDATA[(*!
<summary>Restores an embedded configuration or resolves a borrowed external key.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="node">Dependency configuration node.</param>
<param name="target">Target workflow element receiving the dependency.</param>
<param name="isTask">TRUE for task dependency, FALSE for comparer.</param>
*)
METHOD BindDependency
VAR_INPUT
	node : TOF_Core.CONFIGURATION_NODE;
	target : IWorkflowElement;
	isTask : BOOL;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ReadElement" Id="{65205ac2-28ef-4109-9887-561d98b63fb9}">
      <Declaration><![CDATA[(*!
<summary>Creates and restores a fresh registered element.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="node">Configuration node of the element.</param>
*)
METHOD ReadElement : IWorkflowElement
VAR_INPUT
	node : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AddRequiredVariable" Id="{a9c60e56-2c07-4cb5-a8f3-fbdd35243b93}">
      <Declaration><![CDATA[(*!
<summary>Records a required variable operand for lookup after the tree has been attached.</summary>
<description>Use within one synchronous load.</description>
<param name="scope">Container scope requiring the variable.</param>
<param name="name">Required variable name.</param>
*)
METHOD AddRequiredVariable
VAR_INPUT
	scope : IVariableLookup;
	name : STRING;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>