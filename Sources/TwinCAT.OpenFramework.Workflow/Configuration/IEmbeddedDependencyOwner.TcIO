<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IEmbeddedDependencyOwner" Id="{bbec2a73-0640-4881-9984-74e0f451398a}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Accepts exclusive ownership of embedded configuration dependencies.</summary>
<description>Standard Workflow implements this optional capability for task and comparer bindings.</description>
*)
INTERFACE IEmbeddedDependencyOwner]]></Declaration>
    <Method Name="AttachEmbeddedDependency" Id="{57f75ad1-97a2-43cb-ac99-9eb125768ed2}">
      <Declaration><![CDATA[(*!
<summary>Attaches a fresh dynamic task or comparer to this workflow owner.</summary>
<description>
Use in one task with a live node and a previously unowned dependency. The caller retains ownership on insertion failure.
Duplicate registration raises before mutation. Accepted objects live until workflow disposal, including after rebinding.
</description>
*)
METHOD AttachEmbeddedDependency
VAR_INPUT
	dependency : TOF_Core.IObject;
	node : IWorkflowElement;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
