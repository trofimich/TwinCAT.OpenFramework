(*!
<summary>Resolves externally managed dependencies by a stable key.</summary>
<description>
Resolution borrows an existing shared instance without transferring ownership.
Return zero for an unknown key.
</description>
*)
INTERFACE IWorkflowDependencyResolver]]></Declaration>
    <Method Name="ResolveExternal" Id="{89234413-f41f-4f3e-9eae-ab747312db5a}">
      <Declaration><![CDATA[(*!
<summary>Returns an existing borrowed dependency for the supplied stable key.</summary>
<description>Return zero for an unknown key.</description>
<param name="key">Dependency lookup key.</param>
*)
METHOD ResolveExternal : TOF_Core.IObject
VAR_INPUT
	key : STRING;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>