<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IWorkflowDependencyResolver" Id="{b7b88fc9-3040-442b-8f55-f4771df1f971}">
    <Declaration><![CDATA[(*
