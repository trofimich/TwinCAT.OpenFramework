<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="LOGICAL_OPERATOR" Id="{858be361-e7f2-4b47-bbf7-3e230569860c}">
    <Declaration><![CDATA[(*
