(*!
<summary>Selects the logical combination applied by CompositeCondition.</summary>
<description>
AND_ requires all configured children to evaluate TRUE; OR_ requires at least one TRUE child.
CompositeCondition stops at the first decisive result. Child absence and configuration errors are governed
by CompositeCondition, not represented by an extra operator value.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE LOGICAL_OPERATOR :
(
	//! <summary>Conjunction; the first FALSE child determines FALSE.</summary>
	AND_ := 0,
	//! <summary>Disjunction; the first TRUE child determines TRUE.</summary>
	OR_ := 1
) BYTE;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>