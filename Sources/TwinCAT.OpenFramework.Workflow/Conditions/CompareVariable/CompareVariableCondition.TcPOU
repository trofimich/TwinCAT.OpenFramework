<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CompareVariableCondition" Id="{e6af0489-4250-42f8-a1a5-877dabb5feb1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Evaluates relational or equality comparisons on workflow variables.</summary>
<description>
Standard elements resolve condition-local and ancestor bindings first, then evaluating activity/ancestor
bindings, then workflow fallback. The condition-associated workflow precedes a distinct context workflow.
Custom elements expose direct bindings through ILocalVariableLookup; legacy opaque lookups run after
discoverable local scopes and before workflow fallback.
Supports evaluating a workflow variable against a copied reference value, or comparing two workflow variables.
Without a custom comparer, numeric pairs use GENERIC_VALUE.CompareTo across widths and signedness, including
exact mixed integer/floating-point ordering. STRING/WSTRING pairs use its complete terminated-text ordering
across capacities and encodings. Other pairs require equal generic type categories before dispatch through
TOF_Comparison.StandardComparers; unequal categories raise GenericConversionNotSupportedException before
payload comparison. Equal categories retain their concrete comparer rules, including byte ordering for
USER_DEFINED, storage-address ordering for POINTER_TO and natural OBJECT ordering through IComparable.
Explicit comparer bindings persist a workflow-owned configuration or an external key.
A custom comparer receives both descriptors unchanged and defines its own supported representations.
Descriptors must describe live readable storage matching their categories; strings must be terminated within
their storage. Operands remain borrowed during evaluation. Comparer and conversion exceptions propagate
without fallback. Evaluation does not update configuration or acquire or release operand ownership.
Raises an exception when evaluated before configuration or when a referenced variable cannot be resolved.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK CompareVariableCondition EXTENDS Condition
	IMPLEMENTS ICompareVariableCondition, TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_FirstVariableName : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_SecondVariableName : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_Operator : COMPARISON_OPERATOR := COMPARISON_OPERATOR.EQUAL;

	{attribute 'OPC.UA.DA' := '0'}
	_ReferenceValue : TOF_Core.GENERIC_VALUE;

	{attribute 'OPC.UA.DA' := '0'}
	_Comparer : TOF_Core.IComparer;
	_BindingKind : DEPENDENCY_BINDING_KIND;
	_ExternalKey : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_Configured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{3914a872-5b91-4e78-bc41-7298efda5192}" />
    <Folder Name="Service methods" Id="{58dd9158-ea44-441f-ae30-1e47152182db}" />
    <Property Name="ClassName" Id="{fab625c7-99bf-4544-8456-04904e433ff5}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a77c592c-ae7e-4fb4-900b-6ab3303cd63c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="compareOperands" Id="{4a82c915-7b38-4d91-8e24-3f60d18c7b52}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Dispatches operand comparison through the configured comparer or built-in type rules.</summary>
*)
METHOD PRIVATE compareOperands : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	activeComparer : TOF_Core.IComparer;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Comparer <> 0 THEN
	compareOperands := _Comparer.Compare(first := first, second := second);
ELSIF (
		first.TypeClass >= TOF_Core.GENERIC_TYPE_CLASS.BOOLEAN
		AND_THEN first.TypeClass <= TOF_Core.GENERIC_TYPE_CLASS.REAL_64
		AND_THEN second.TypeClass >= TOF_Core.GENERIC_TYPE_CLASS.BOOLEAN
		AND_THEN second.TypeClass <= TOF_Core.GENERIC_TYPE_CLASS.REAL_64
	)
	OR_ELSE (
		(first.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.STRING_8
			OR_ELSE first.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.STRING_16)
		AND_THEN (second.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.STRING_8
			OR_ELSE second.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.STRING_16)
	)
THEN
	compareOperands := first.CompareTo(otherValue := second);
ELSE
	IF first.TypeClass <> second.TypeClass THEN
		TOF_Core.Exceptions.ThrowGenericConversionNotSupported(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			sourceDataType := first.TypeClass,
			targetDataType := second.TypeClass
		);
	END_IF

	activeComparer := TOF_Comparison.StandardComparers.GetForTypeClass(typeClass := first.TypeClass);
	compareOperands := activeComparer.Compare(first := first, second := second);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Comparer" Id="{c5cee58f-97b1-4e3b-b4c0-30a32d650a18}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the borrowed custom ordering strategy, or zero to select automatic pair dispatch.</summary>
<description>
A non-null comparer must remain alive while used and accept the resolved operand representations. It receives
both descriptors unchanged, bypassing automatic numeric/text ordering and equal-category validation. Its
exceptions propagate without fallback; replacing the comparer does not alter the configured operands.
Direct assignment clears any persistent binding role. Zero selects built-in comparison.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Comparer : TOF_Core.IComparer]]></Declaration>
      <Get Name="Get" Id="{236d6b99-6016-448d-a7dd-1b328b75be8a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Comparer := _Comparer;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{6b4dfd9b-b143-4b69-a963-52f482393721}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[validateNotBusy(sourcePOUName := __POUNAME());

_Comparer := Comparer;
_BindingKind := DEPENDENCY_BINDING_KIND.UNSPECIFIED;
_ExternalKey := '';]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Configured" Id="{c8e83b65-0437-4436-a991-d1a48c3abaaa}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the condition has been configured and is ready for evaluation.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{ca898883-f588-4111-9c2b-3159a0007bc2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _Configured;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{807ed91f-00e7-440c-9ac7-14b98571059f}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to compare a workflow variable with a literal reference value.</summary>
<description>
Operand compatibility is checked during evaluation, when both descriptors are resolved. Automatic numeric
and text pairs use GENERIC_VALUE.CompareTo; other automatic pairs require equal generic categories. A custom
comparer defines its own supported pairs. Evaluation does not update the configured operands or operator.
</description>
<param name="firstVariableName">Non-empty name of the workflow variable to evaluate.</param>
<param name="comparisonOperator">Relational or equality operator to apply.</param>
<param name="referenceValue">Literal reference value to compare against.</param>
*)
METHOD Configure
VAR_INPUT
	firstVariableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	referenceValue : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[configureLiteral(
	firstVariableName := firstVariableName,
	comparisonOperator := comparisonOperator,
	referenceValue := referenceValue
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigureEmbeddedComparer" Id="{373fefe4-0983-4fb9-ae88-2fdb9b5452b3}">
      <Declaration><![CDATA[(*!
<summary>Adopts a fresh workflow-owned comparer.</summary>
<description>Requires a ready node in a workflow and a dynamic serializable instance available for exclusive transfer.
The workflow owns it on success. A duplicate in the same workflow raises before changing this node.</description>
*)
METHOD ConfigureEmbeddedComparer
VAR_INPUT
	comparer : TOF_Core.IComparer;
END_VAR
VAR
	owner : IEmbeddedDependencyOwner;
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[validateNotBusy(sourcePOUName := __POUNAME());

ownerWorkflow := Workflow;

IF ownerWorkflow = 0 OR_ELSE NOT __QUERYINTERFACE(ownerWorkflow, owner) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Workflow does not accept embedded dependencies"
	);
END_IF

owner.AttachEmbeddedDependency(dependency := comparer, node := THIS^);

_Comparer := comparer;
_BindingKind := DEPENDENCY_BINDING_KIND.EMBEDDED;
_ExternalKey := '';]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigureExternalComparer" Id="{f918a814-f5e0-4db2-b780-ed73abc88c05}">
      <Declaration><![CDATA[(*!
<summary>Binds an externally owned comparer.</summary>
<description>Requires a live dependency and a nonempty stable key. Several nodes may borrow the same external instance.
The provider keeps it alive. Rejection preserves the previous binding.</description>
*)
METHOD ConfigureExternalComparer
VAR_INPUT
	comparer : TOF_Core.IComparer;
	key : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[validateNotBusy(sourcePOUName := __POUNAME());

IF comparer = 0 OR_ELSE key = '' THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "External binding requires a live dependency and a key"
	);
END_IF

_Comparer := comparer;
_BindingKind := DEPENDENCY_BINDING_KIND.EXTERNAL_KEY;
_ExternalKey := key;]]></ST>
      </Implementation>
    </Method>
    <Method Name="configureLiteral" Id="{af599852-b872-4e81-a5b5-d50914aea5ab}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Validates the names and copies the typed literal operand.</summary>
<description>The descriptor and its payload are borrowed only for this call.</description>
*)
METHOD PRIVATE configureLiteral
VAR_INPUT
	firstVariableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	referenceValue : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[validateNotBusy(sourcePOUName := __POUNAME());

IF firstVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'firstVariableName',
		argumentValue := firstVariableName
	);
END_IF

IF referenceValue.pValue = TOF_Core.Memory.NULL_ADDRESS OR_ELSE referenceValue.diSize = TOF_Core.SignedInt32.ZERO THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'referenceValue'
	);
END_IF

validateOperator(comparisonOperator := comparisonOperator, sourcePOUName := __POUNAME());

_Configured := FALSE;

_ReferenceValue.Release();
_ReferenceValue := TOF_Core.GenericValueFactory.FromAnyType(
		value := referenceValue,
		isObject := FALSE,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY
	);

_FirstVariableName := firstVariableName;
_SecondVariableName := '';
_Operator := comparisonOperator;

_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigureVariable" Id="{63fdf89f-287b-4c38-9b3b-f718981db849}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to compare two workflow variables.</summary>
<description>
Operand compatibility is checked during evaluation, when both descriptors are resolved. Automatic numeric
and text pairs use GENERIC_VALUE.CompareTo; other automatic pairs require equal generic categories. A custom
comparer defines its own supported pairs. Evaluation does not update the configured operands or operator.
</description>
<param name="firstVariableName">Non-empty name of the first (left-hand) workflow variable.</param>
<param name="comparisonOperator">Relational or equality operator to apply.</param>
<param name="secondVariableName">Non-empty name of the second (right-hand) workflow variable.</param>
*)
METHOD ConfigureVariable
VAR_INPUT
	firstVariableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	secondVariableName : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[validateNotBusy(sourcePOUName := __POUNAME());

IF firstVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'firstVariableName',
		argumentValue := firstVariableName
	);
END_IF

IF secondVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'secondVariableName',
		argumentValue := secondVariableName
	);
END_IF

validateOperator(comparisonOperator := comparisonOperator, sourcePOUName := __POUNAME());

_Configured := FALSE;

_ReferenceValue.Release();

_FirstVariableName := firstVariableName;
_SecondVariableName := secondVariableName;
_Operator := comparisonOperator;

_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{cb634a06-9bdd-4f0f-bd8f-d151b5700f3b}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and deserialization context are borrowed for this call.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Active configuration deserialization context providing workflow reconstruction services.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
	firstVariableName : STRING;
	secondVariableName : STRING;
	sourceNode : TOF_Core.CONFIGURATION_NODE;
	valueNode : TOF_Core.CONFIGURATION_NODE;
	comparerNode : TOF_Core.CONFIGURATION_NODE;
	comparison : COMPARISON_OPERATOR;
	operatorText : STRING;
	literal : __SYSTEM.AnyType;
	storage : POINTER TO BYTE;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[loader := WorkflowConfigurationSerializer.ResolveWorkflowLoader(context := context);
Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

firstVariableName := Workflows.ReadName(reader := reader, node := reader.GetField(node := node, name := 'first'));
loader.AddRequiredVariable(scope := THIS^, name := firstVariableName);
operatorText := Workflows.ReadName(reader := reader, node := reader.GetField(node := node, name := 'operator'));
comparison := Workflows.ParseComparisonOperator(rawOperator := operatorText);

sourceNode := reader.FindField(node := node, name := 'second');
valueNode := reader.FindField(node := node, name := 'value');

IF (sourceNode.Handle = 0) = (valueNode.Handle = 0) THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Expected exactly one comparison operand"
	);
END_IF

IF sourceNode.Handle <> 0 THEN
	secondVariableName := Workflows.ReadName(reader := reader, node := sourceNode);
	loader.AddRequiredVariable(scope := THIS^, name := secondVariableName);
	ConfigureVariable(firstVariableName := firstVariableName, comparisonOperator := comparison, secondVariableName := secondVariableName);
ELSE
	literal := Workflows.ReadLiteral(reader := reader, node := valueNode);
	storage := literal.pValue;

	__TRY
		configureLiteral(firstVariableName := firstVariableName, comparisonOperator := comparison, referenceValue := literal);
	__CATCH(exceptionCode)
		__DELETE(storage);
		TOF_Core.ExceptionManager.ReThrowLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
	__ENDTRY

	__DELETE(storage);
END_IF

comparerNode := reader.FindField(node := node, name := 'comparer');

IF comparerNode.Handle <> 0 THEN
	loader.BindDependency(node := comparerNode, target := THIS^, isTask := FALSE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="evaluateComparisonResult" Id="{6b19d428-3c57-4e92-a814-2f70e38c9d61}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Evaluates the configured relational or equality operator against a comparison result.</summary>
*)
METHOD PRIVATE evaluateComparisonResult : BOOL
VAR_INPUT
	comparisonResult : TOF_Core.COMPARISON_RESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE _Operator OF
	COMPARISON_OPERATOR.EQUAL:
		evaluateComparisonResult := comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;

	COMPARISON_OPERATOR.NOT_EQUAL:
		evaluateComparisonResult := comparisonResult <> TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;

	COMPARISON_OPERATOR.LESS_THAN:
		evaluateComparisonResult := comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;

	COMPARISON_OPERATOR.LESS_THAN_OR_EQUAL:
		evaluateComparisonResult := comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND
			OR_ELSE comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;

	COMPARISON_OPERATOR.GREATER_THAN:
		evaluateComparisonResult := comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;

	COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL:
		evaluateComparisonResult := comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND
			OR_ELSE comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{a6ce3e19-6f11-4f34-a7c3-4b9eff5768e5}">
      <Declaration><![CDATA[(*!
<summary>Releases the owned comparison reference snapshot during destruction.</summary>
<description>
Uses GENERIC_VALUE.Release and completes without exceptions under its cleanup contract. Borrowed aliases
to the released snapshot become invalid. This destructor does not establish an online-change relocation
protocol or preserve aliases across copy-code destruction; use an explicitly supported owner procedure.
</description>
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ReferenceValue.Release();]]></ST>
      </Implementation>
    </Method>
    <Property Name="FirstVariableName" Id="{97c2ca05-cf60-4c11-b293-d16b084fe0ab}">
      <Declaration><![CDATA[(*!
<summary>Returns the name of the first workflow variable.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FirstVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{d8cfc091-42f6-4c18-8948-66ff0c21e4b3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FirstVariableName := _FirstVariableName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{9a3dab93-7a16-4fd2-abd7-f3283f20b0f4}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{aa5b9ecb-ffd5-4d38-92ed-b439a0e2537a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEvaluate" Id="{d1e7db02-9592-4e74-af2f-447ec2bae63f}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resolves operands, selects a compatible ordering strategy and evaluates the comparison operator.</summary>
<description>
Custom comparers receive the original descriptors. Automatic dispatch uses GENERIC_VALUE.CompareTo for
numeric or text pairs and requires equal categories for other standard comparers. Incompatible pairs raise
GenericConversionNotSupportedException before typed payload comparison. Exceptions propagate to the caller.
The implementation does not update configuration, stored reference ownership or operand data during evaluation.
</description>
<param name="activity">Activity context for variable lookup.</param>
*)
METHOD PROTECTED OnEvaluate : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
	variableFound : BOOL;
	firstValue : TOF_Core.GENERIC_VALUE;
	secondValue : TOF_Core.GENERIC_VALUE;
	comparisonResult : TOF_Core.COMPARISON_RESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Configured THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition '", Name, "' is not configured");

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

variableFound := TryResolveVariable(name := _FirstVariableName, activity := activity, variable => firstValue);

IF NOT variableFound THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Condition '",
		Name,
		"' requires variable '",
		TO_WSTRING(_FirstVariableName),
		"' which is not found"
	);

	WorkflowExceptions.ThrowWorkflowVariableNotFound(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF _SecondVariableName <> '' THEN
	variableFound := TryResolveVariable(name := _SecondVariableName, activity := activity, variable => secondValue);

	IF NOT variableFound THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
			"Condition '",
			Name,
			"' requires variable '",
			TO_WSTRING(_SecondVariableName),
			"' which is not found"
		);

		WorkflowExceptions.ThrowWorkflowVariableNotFound(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := formattedExceptionMessage
		);
	END_IF
ELSE
	secondValue := _ReferenceValue;
END_IF

comparisonResult := compareOperands(first := firstValue, second := secondValue);
OnEvaluate := evaluateComparisonResult(comparisonResult := comparisonResult);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Operator" Id="{5b497c96-2374-4bde-82a8-17a76eb8cb98}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the comparison operator.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Operator : COMPARISON_OPERATOR]]></Declaration>
      <Get Name="Get" Id="{f73558b1-4852-4f69-a17b-828e66ba7763}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Operator := _Operator;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{71481cab-9031-402b-85b2-c2601863c13d}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[validateNotBusy(sourcePOUName := __POUNAME());
validateOperator(comparisonOperator := Operator, sourcePOUName := __POUNAME());

_Operator := Operator;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SecondVariableName" Id="{5cfa2b48-ea7a-4c15-8755-e130e52052b1}">
      <Declaration><![CDATA[(*!
<summary>Returns the name of the second workflow variable, or empty when comparing against a literal.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SecondVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{3a70bf0c-96df-49bf-9a49-ca7770033c44}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SecondVariableName := _SecondVariableName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3814306b-ab0b-4a8a-a1bb-4cae5a4f72c6}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b335a7a9-3ed6-4e9c-bbe2-2b4d0ca44dc5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Serialize" Id="{7e206955-54b1-4f30-b0b5-82a1dffcd9c0}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR
VAR
	operatorText : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
IF _Comparer <> 0 THEN
	Workflows.WriteDependency(
		writer := writer,
		role := 'comparer',
		kind := _BindingKind,
		key := _ExternalKey,
		dependency := _Comparer,
		nodeName := Name
	);
END_IF

writer.WriteValue(
	name := 'first',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(_FirstVariableName),
	size := SIZEOF(_FirstVariableName)
);
operatorText := Workflows.FormatComparisonOperator(comparisonOperator := _Operator);
writer.WriteValue(
	name := 'operator',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(operatorText),
	size := SIZEOF(operatorText)
);

IF _SecondVariableName <> '' THEN
	writer.WriteValue(
		name := 'second',
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
		data := ADR(_SecondVariableName),
		size := SIZEOF(_SecondVariableName)
	);
ELSE
	Workflows.WriteConfigurationLiteral(writer := writer, name := 'value', value := _ReferenceValue.AsAnyType());
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="validateNotBusy" Id="{2e58c419-7a36-4d82-b915-3c40d28e7f61}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Rejects configuration mutation while the associated workflow is active.</summary>
*)
METHOD PRIVATE validateNotBusy
VAR_INPUT
	sourcePOUName : STRING;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

IF ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := sourcePOUName,
		sourcePosition := __POSITION(),
		message := "Cannot change the binding during execution"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="validateOperator" Id="{8c41b529-3d48-4e91-a726-5f30c18e9d42}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Validates that comparisonOperator is a defined COMPARISON_OPERATOR enumeration value.</summary>
*)
METHOD PRIVATE validateOperator
VAR_INPUT
	comparisonOperator : COMPARISON_OPERATOR;
	sourcePOUName : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF comparisonOperator < COMPARISON_OPERATOR.EQUAL
	OR_ELSE comparisonOperator > COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL
THEN
	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := sourcePOUName,
		sourcePosition := __POSITION(),
		message := "Unknown operator value"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
