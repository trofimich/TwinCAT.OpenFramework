<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ICompareVariableCondition" Id="{adeccc20-b664-4623-b885-aa176bd58ba1}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a condition that evaluates relational or equality comparisons on workflow variables.</summary>
<description>
Supports comparing a variable against a literal reference value, or comparing two workflow variables.
Optionally accepts a custom IComparer; defaults to TOF_Comparison.StandardComparers for the variable data type.
</description>
*)

INTERFACE ICompareVariableCondition EXTENDS ICondition]]></Declaration>
    <Property Name="Comparer" Id="{38c9169d-8630-40b4-9caa-3e203c4621de}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the custom comparer used for comparison, or 0 to use standard type-based comparers.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Comparer : TOF_Core.IComparer]]></Declaration>
      <Get Name="Get" Id="{e70f0ddf-9c74-40eb-b624-b11930fd2efa}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{c083ae13-324e-4893-9d08-1a7ab13fa88f}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Method Name="Configure" Id="{a456edd5-c363-432a-af06-71e2cae2c62a}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to compare a workflow variable with a literal reference value.</summary>
<param name="variableName">Non-empty name of the workflow variable to evaluate.</param>
<param name="comparisonOperator">Relational or equality operator to apply.</param>
<param name="referenceValue">Literal reference value to compare against.</param>
*)
METHOD Configure
VAR_INPUT
	variableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	referenceValue : ANY;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ConfigureVariable" Id="{d43fb834-46b1-4a3b-bd44-a8922e832f1c}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to compare two workflow variables.</summary>
<param name="firstVariableName">Non-empty name of the first (left-hand) workflow variable.</param>
<param name="comparisonOperator">Relational or equality operator to apply.</param>
<param name="secondVariableName">Non-empty name of the second (right-hand) workflow variable.</param>
*)
METHOD ConfigureVariable
VAR_INPUT
	firstVariableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	secondVariableName : STRING;
END_VAR]]></Declaration>
    </Method>
    <Property Name="FirstVariableName" Id="{0f04375e-1dd5-4a7a-a523-953612159d63}">
      <Declaration><![CDATA[(*!
<summary>Returns the name of the first workflow variable.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FirstVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{acb52c21-378e-40b2-8374-3698b9c8e5f9}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Operator" Id="{694a9140-8d68-4d42-a8c3-44e3f89b94cd}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the comparison operator.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Operator : COMPARISON_OPERATOR]]></Declaration>
      <Get Name="Get" Id="{4856c07f-6773-4336-8556-87084a2ba20c}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{f08a8dc5-a7c3-4d23-bdb0-c48f88c2d7cc}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Property Name="SecondVariableName" Id="{4a8bc4c7-a282-488e-b8f3-242d6e98ad6f}">
      <Declaration><![CDATA[(*!
<summary>Returns the name of the second workflow variable, or empty when comparing against a literal.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SecondVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{72b7bc1c-7618-4c98-bb1d-522304ae34df}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>
