<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ICompareVariableCondition" Id="{adeccc20-b664-4623-b885-aa176bd58ba1}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a condition that evaluates relational or equality comparisons on workflow variables.</summary>
<description>
Standard elements resolve condition-local and ancestor bindings first, then evaluating activity/ancestor
bindings, then workflow fallback. The condition-associated workflow precedes a distinct context workflow.
Custom elements expose direct bindings through ILocalVariableContainer; legacy opaque lookups run after
discoverable local scopes and before workflow fallback.
Supports evaluating a workflow variable against a copied reference value, or comparing two workflow variables.
Without a custom comparer, numeric pairs use GENERIC_VALUE.CompareTo across widths and signedness, including
exact mixed integer/floating-point ordering. STRING/WSTRING pairs use its complete terminated-text ordering
across capacities and encodings. Other pairs require equal generic type categories before dispatch through
TOF_Comparison.StandardComparers; unequal categories raise GenericConversionNotSupportedException before
payload comparison. Equal categories retain their concrete comparer rules, including byte ordering for
USER_DEFINED, storage-address ordering for POINTER_TO and natural OBJECT ordering through IComparable.
A custom comparer receives both descriptors unchanged and defines its own supported representations.
Descriptors must describe live readable storage matching their categories; strings must be terminated within
their storage. Operands remain borrowed during evaluation. Comparer and conversion exceptions propagate
without fallback. Evaluation does not update configuration or acquire or release operand ownership.
Raises an exception when evaluated before configuration or when a referenced variable cannot be resolved.
</description>
*)

INTERFACE ICompareVariableCondition EXTENDS ICondition]]></Declaration>
    <Property Name="Comparer" Id="{38c9169d-8630-40b4-9caa-3e203c4621de}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the borrowed custom ordering strategy, or zero to select automatic pair dispatch.</summary>
<description>
A non-null comparer must remain alive while used and accept the resolved operand representations. It receives
both descriptors unchanged, bypassing automatic numeric/text ordering and equal-category validation. Its
exceptions propagate without fallback; replacing the comparer does not alter the configured operands.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Comparer : TOF_Core.IComparer]]></Declaration>
      <Get Name="Get" Id="{e70f0ddf-9c74-40eb-b624-b11930fd2efa}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{c083ae13-324e-4893-9d08-1a7ab13fa88f}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Method Name="Configure" Id="{a456edd5-c363-432a-af06-71e2cae2c62a}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to compare a workflow variable with a literal reference value.</summary>
<description>
Operand compatibility is checked during evaluation, when both descriptors are resolved. Automatic numeric
and text pairs use GENERIC_VALUE.CompareTo; other automatic pairs require equal generic categories. A custom
comparer defines its own supported pairs. Evaluation does not update the configured operands or operator.
</description>
<param name="variableName">Non-empty name of the workflow variable to evaluate.</param>
<param name="comparisonOperator">Relational or equality operator to apply.</param>
<param name="referenceValue">Literal reference value to compare against.</param>
*)
METHOD Configure
VAR_INPUT
	variableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	referenceValue : ANY;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ConfigureVariable" Id="{d43fb834-46b1-4a3b-bd44-a8922e832f1c}">
      <Declaration><![CDATA[(*!
<summary>Configures the condition to compare two workflow variables.</summary>
<description>
Operand compatibility is checked during evaluation, when both descriptors are resolved. Automatic numeric
and text pairs use GENERIC_VALUE.CompareTo; other automatic pairs require equal generic categories. A custom
comparer defines its own supported pairs. Evaluation does not update the configured operands or operator.
</description>
<param name="firstVariableName">Non-empty name of the first (left-hand) workflow variable.</param>
<param name="comparisonOperator">Relational or equality operator to apply.</param>
<param name="secondVariableName">Non-empty name of the second (right-hand) workflow variable.</param>
*)
METHOD ConfigureVariable
VAR_INPUT
	firstVariableName : STRING;
	comparisonOperator : COMPARISON_OPERATOR;
	secondVariableName : STRING;
END_VAR]]></Declaration>
    </Method>
    <Property Name="FirstVariableName" Id="{0f04375e-1dd5-4a7a-a523-953612159d63}">
      <Declaration><![CDATA[(*!
<summary>Returns the name of the first workflow variable.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FirstVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{acb52c21-378e-40b2-8374-3698b9c8e5f9}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Operator" Id="{694a9140-8d68-4d42-a8c3-44e3f89b94cd}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the comparison operator.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Operator : COMPARISON_OPERATOR]]></Declaration>
      <Get Name="Get" Id="{4856c07f-6773-4336-8556-87084a2ba20c}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{f08a8dc5-a7c3-4d23-bdb0-c48f88c2d7cc}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Property Name="SecondVariableName" Id="{4a8bc4c7-a282-488e-b8f3-242d6e98ad6f}">
      <Declaration><![CDATA[(*!
<summary>Returns the name of the second workflow variable, or empty when comparing against a literal.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SecondVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{72b7bc1c-7618-4c98-bb1d-522304ae34df}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>
