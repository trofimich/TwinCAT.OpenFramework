<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CompositeCondition" Id="{8a55c5b1-693f-4932-9f9a-010c3c539516}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Combines one or more child workflow conditions using a logical AND or OR operator.</summary>
<description>
Requires at least one child condition to be considered Configured. Short-circuits evaluation on the first
decisive child result.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK CompositeCondition EXTENDS Condition IMPLEMENTS ICompositeCondition
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_LogicalOperator : LOGICAL_OPERATOR;

	{attribute 'OPC.UA.DA' := '0'}
	_Children : TOF_Collections.List<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden members" Id="{92167edf-a171-45ae-b0b4-cbb4363d35a0}" />
    <Method Name="AddChildCondition" Id="{a9ba8ac8-dab1-4579-a8c6-f1dcf4f0781e}">
      <Declaration><![CDATA[(*!
<summary>Appends a child condition and assigns this composite as its ParentCondition.</summary>
<description>
Rejects null references, self/ancestor cycles and conditions already attached elsewhere.
The child must be unattached, including to this parent; duplicate slots are rejected before insertion.
The parent chain and owning workflow must be PASSIVE_READY. Fixed workflow association is validated.
Storage allocation precedes parent callbacks; callback exceptions may leave a partial configuration.
Child references remain borrowed and must outlive the tree. No implicit detach or ownership transfer occurs.
</description>
<param name="condition">Child condition to append.</param>
*)
METHOD AddChildCondition
VAR_INPUT
	condition : ICondition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'condition'
	);
END_IF

Workflows.ValidateElementAttachment(parent := THIS^, child := condition);

IF condition.Parent <> 0 THEN
	WorkflowExceptions.ThrowWorkflowAttachment(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Child element already occupies a parent slot"
	);
END_IF

_Children.AppendGeneric(
	value := TOF_Core.GenericValueFactory.FromParts(
		genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
		address := condition.SelfAddress,
		size := condition.SelfSize,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
	)
);

condition.ParentCondition := THIS^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{70333ea1-3549-4d0a-a3ad-521d1db0db74}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a5ccd782-e1de-457e-9e73-065fb67a7a80}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Configured" Id="{21dacc3f-ed62-4ab7-8da9-cb67ea9bfcba}">
      <Declaration><![CDATA[(*!
<summary>Returns TRUE when at least one child condition has been added.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{ea5c9fa4-9f95-445e-834b-d8986cf079b5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _Children.Length > TOF_Core.SignedInt32.ZERO;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="LogicalOperator" Id="{2e60dc3a-8843-4578-a90f-416536b1cdcb}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the logical operator (AND_ or OR_) used to combine child conditions.</summary>
*)
PROPERTY LogicalOperator : LOGICAL_OPERATOR]]></Declaration>
      <Get Name="Get" Id="{24be606b-b29e-4d7a-9059-3d33397fc9bc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LogicalOperator := _LogicalOperator;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{91bb16fb-1705-4e7d-aeac-ee32b7347b30}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_LogicalOperator := LogicalOperator;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{52983f0a-5112-4343-a340-1487d5e77845}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8a11a0fb-561b-4d9a-b1ae-2ae3af60f58b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEvaluate" Id="{65421d01-d63f-414e-ae6f-3caad321436b}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Evaluates child conditions in order and short-circuits according to LogicalOperator.</summary>
<param name="activity">Activity context for evaluation.</param>
*)
METHOD PROTECTED OnEvaluate : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;


	i : DINT;
	
	childCondition : ICondition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Configured THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition '", Name, "' is not configured");

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

IF _LogicalOperator = LOGICAL_OPERATOR.AND_ THEN
	OnEvaluate := TRUE;
END_IF

FOR i := 0 TO _Children.Length - 1 DO
	IF NOT __QUERYINTERFACE(_Children.Get(index := i).AsObject(), childCondition) THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition #", TO_WSTRING(i), " is null");

		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := formattedExceptionMessage
		);
	END_IF

	IF NOT childCondition.Configured THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
			"Condition '",
			childCondition.Name,
			"' is not configured"
		);

		WorkflowExceptions.ThrowWorkflowConfiguration(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := formattedExceptionMessage
		);
	END_IF

	IF childCondition.Evaluate(activity := activity) THEN
		IF _LogicalOperator = LOGICAL_OPERATOR.OR_ THEN
			OnEvaluate := TRUE;
			RETURN;
		END_IF
	ELSE
		IF _LogicalOperator = LOGICAL_OPERATOR.AND_ THEN
			OnEvaluate := FALSE;
			RETURN;
		END_IF
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{0c774fc8-e3e1-46bd-bc7e-7d6910760a9c}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{02bdd4c2-e6e9-4e38-a963-e1672ee8a20b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>