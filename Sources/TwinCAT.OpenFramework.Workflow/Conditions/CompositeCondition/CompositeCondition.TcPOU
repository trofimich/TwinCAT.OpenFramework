(*!
<summary>Combines one or more child workflow conditions using a logical AND or OR operator.</summary>
<description>
Requires at least one child condition to be considered Configured. Short-circuits evaluation on the first
decisive child result.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK ABSTRACT CompositeCondition EXTENDS Condition IMPLEMENTS ICompositeCondition
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_LogicalOperator : LOGICAL_OPERATOR;

	{attribute 'OPC.UA.DA' := '0'}
	_Children : TOF_Collections.List<0>(0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden members" Id="{92167edf-a171-45ae-b0b4-cbb4363d35a0}" />
    <Method Name="AddChildCondition" Id="{a9ba8ac8-dab1-4579-a8c6-f1dcf4f0781e}">
      <Declaration><![CDATA[(*!
<summary>Appends a child condition and assigns this composite as its ParentCondition.</summary>
<description>
Rejects null references, self/ancestor cycles and conditions already attached elsewhere.
</description>
<param name="condition">Child condition to append.</param>
*)
METHOD AddChildCondition
VAR_INPUT
	condition : ICondition;
END_VAR
VAR
	ancestor : ICondition;
	argumentNullException : TOF_Core.ArgumentNotSpecifiedException;
	invalidAttachmentException : TOF_Core.StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition = 0 THEN
	argumentNullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'condition');
END_IF

ancestor := THIS^;

WHILE ancestor <> 0 DO
	IF ancestor = condition THEN
		invalidAttachmentException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Cannot attach a condition that is this composite condition or its ancestor");
	END_IF

	ancestor := ancestor.ParentCondition;
END_WHILE

IF condition.ParentActivity <> 0
	OR_ELSE (condition.ParentCondition <> 0 AND_THEN condition.ParentCondition.SelfAddress <> SelfAddress)
THEN
	invalidAttachmentException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Child condition is already attached to another parent");
END_IF

_Children.AppendGeneric(TOF_Core.GenericValueFactory.FromParts(TOF_Core.GENERIC_TYPE_CLASS.OBJECT, condition.SelfAddress, condition.SelfSize, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY));

condition.ParentCondition := THIS^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{70333ea1-3549-4d0a-a3ad-521d1db0db74}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a5ccd782-e1de-457e-9e73-065fb67a7a80}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Configured" Id="{21dacc3f-ed62-4ab7-8da9-cb67ea9bfcba}">
      <Declaration><![CDATA[(*!
<summary>Returns TRUE when at least one child condition has been added.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{ea5c9fa4-9f95-445e-834b-d8986cf079b5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _Children.Length > 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="LogicalOperator" Id="{2e60dc3a-8843-4578-a90f-416536b1cdcb}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the logical operator (AND_ or OR_) used to combine child conditions.</summary>
*)
PROPERTY LogicalOperator : LOGICAL_OPERATOR]]></Declaration>
      <Get Name="Get" Id="{24be606b-b29e-4d7a-9059-3d33397fc9bc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LogicalOperator := _LogicalOperator;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{91bb16fb-1705-4e7d-aeac-ee32b7347b30}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_LogicalOperator := LogicalOperator;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{52983f0a-5112-4343-a340-1487d5e77845}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8a11a0fb-561b-4d9a-b1ae-2ae3af60f58b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEvalute" Id="{65421d01-d63f-414e-ae6f-3caad321436b}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Evaluates child conditions in order and short-circuits according to LogicalOperator.</summary>
<param name="activity">Activity context for evaluation.</param>
*)
METHOD PROTECTED OnEvalute : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	conditionException : TOF_Core.StandardException;

	i : DINT;
	
	childCondition : ICondition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Configured THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition '", Name, "' is not configured");

	conditionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF _LogicalOperator = LOGICAL_OPERATOR.AND_ THEN
	OnEvalute := TRUE;	
END_IF
 
FOR i := 0 TO _Children.Length - 1 DO
	IF NOT __QUERYINTERFACE(_Children.Get(i).AsObject(), childCondition) THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition #", TO_WSTRING(i), " is null");

		conditionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
	END_IF
	
	IF NOT childCondition.Configured THEN
		formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition '", childCondition.Name, "' is not configured");

		conditionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
	END_IF

	IF childCondition.Evaluate(activity) THEN
		IF _LogicalOperator = LOGICAL_OPERATOR.OR_ THEN
			OnEvalute := TRUE;	
			RETURN;
		END_IF
	ELSE
		IF _LogicalOperator = LOGICAL_OPERATOR.AND_ THEN
			OnEvalute := FALSE;	
			RETURN;
		END_IF
	END_IF	 
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{0c774fc8-e3e1-46bd-bc7e-7d6910760a9c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{02bdd4c2-e6e9-4e38-a963-e1672ee8a20b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>