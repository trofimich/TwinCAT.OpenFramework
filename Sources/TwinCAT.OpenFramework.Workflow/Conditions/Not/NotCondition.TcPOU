(*!
<summary>Condition that inverts the evaluation result of an inner workflow condition.</summary>
<description>
Evaluates the inner condition via Evaluate and returns the logical negation of its result.
Requires a non-null, configured inner condition to be considered Configured.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK NotCondition EXTENDS Condition IMPLEMENTS INotCondition
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_Condition : ICondition;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal members" Id="{b93590a6-dd9b-4289-bf40-a61da5548aea}" />
    <Property Name="ClassName" Id="{bca735fa-76c8-4113-8046-d96caa463f1b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9ad56043-d757-444d-b758-425c6ce04d39}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Condition" Id="{32b77fcc-93ca-49a3-8432-613313d7a66d}">
      <Declaration><![CDATA[(*!
<summary>Gets the inner condition whose evaluation result is inverted.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{d1f9b7a5-8a62-45ab-ad96-3f31da99c90a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Condition := _Condition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Configured" Id="{aacb589b-8c73-4aad-bf10-28beb66feaf1}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the inner condition has been configured and is ready for evaluation.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{2464377e-9bae-4b3f-b0f3-10e6b95ad25b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _Condition <> 0 AND_THEN _Condition.Configured;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{abc1db78-0e72-457d-9142-b2d5a0d8938b}">
      <Declaration><![CDATA[(*!
<summary>Configures the inner condition to be inverted.</summary>
<description>
Validates that the condition is not null, not this condition itself or an ancestor,
and not already attached to another parent.
</description>
<param name="condition">Inner condition to invert.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ValidateConditionAttachment(condition, 'condition');

_Condition := condition;
condition.ParentCondition := THIS^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{42ff9a00-beff-49d9-9666-03a047f67985}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c12881cc-90f9-4ba4-a93d-ce9b87971edc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEvaluate" Id="{2980fd52-bd90-48be-a8d9-65fd93889672}" FolderPath="Internal members\">
      <Declaration><![CDATA[(*!
<summary>Evaluates the inner condition and returns its logical negation.</summary>
<param name="activity">Activity context for variable lookup.</param>
*)
METHOD PROTECTED OnEvaluate : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Configured THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition '", Name, "' is not configured");

	WorkflowExceptions.ThrowWorkflowConfiguration(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

OnEvaluate := NOT _Condition.Evaluate(activity);]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{52232918-81b2-434b-820c-49bd1bbcb29a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{5565922b-1d3d-4db0-9941-176d41d9b15c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ValidateConditionAttachment" Id="{5eedc3dc-858b-4e55-9016-c2022c97226c}" FolderPath="Internal members\">
      <Declaration><![CDATA[(*!
<summary>Verifies that an inner condition can be attached to this negation wrapper without cycles or conflicts.</summary>
<param name="condition">Condition candidate to validate.</param>
<param name="argumentName">Parameter name for diagnostic reporting.</param>
*)
METHOD PROTECTED ValidateConditionAttachment
VAR_INPUT
	condition : ICondition;
	argumentName : STRING(255);
END_VAR
VAR
	ancestor : ICondition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), argumentName);
END_IF

ancestor := THIS^;

WHILE ancestor <> 0 DO
	IF ancestor = condition THEN
		WorkflowExceptions.ThrowWorkflowAttachment(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Cannot attach a condition that is this condition or its ancestor");
	END_IF

	ancestor := ancestor.ParentCondition;
END_WHILE

IF condition.ParentActivity <> 0
	OR_ELSE (condition.ParentCondition <> 0 AND_THEN condition.ParentCondition.SelfAddress <> SelfAddress)
THEN
	WorkflowExceptions.ThrowWorkflowAttachment(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Child condition is already attached to another parent");
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
