<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="INotCondition" Id="{26df5acc-8964-4dee-85e8-06362dcc31ba}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a condition that inverts the evaluation result of an inner condition.</summary>
*)

INTERFACE INotCondition EXTENDS ICondition]]></Declaration>
    <Property Name="Condition" Id="{b36514dc-a2b9-4fd0-b989-b2197bbf8b1a}">
      <Declaration><![CDATA[(*!
<summary>Gets the inner condition whose evaluation result is inverted.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Condition : ICondition]]></Declaration>
      <Get Name="Get" Id="{72b3d3bc-0542-4ded-9f67-421837919668}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Configure" Id="{8569ee99-900f-45a4-81d4-b0c8c4ba02f1}">
      <Declaration><![CDATA[(*!
<summary>Configures the inner condition to be inverted.</summary>
<description>
Validates that the condition is not null, not this condition itself or an ancestor,
and not already attached to another parent.
</description>
<param name="condition">Inner condition to invert.</param>
*)
METHOD Configure
VAR_INPUT
	condition : ICondition;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
