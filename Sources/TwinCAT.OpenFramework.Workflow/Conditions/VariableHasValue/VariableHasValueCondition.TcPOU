<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="VariableHasValueCondition" Id="{30d35608-a928-454b-b4e1-546e7091b14c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>
Evaluates whether a named workflow variable matches a configured reference value by bytewise equality.
</summary>
<description>
Standard elements resolve condition-local and ancestor bindings first, then evaluating activity/ancestor
bindings, then workflow fallback. The condition-associated workflow precedes a distinct context workflow.
Custom elements expose direct bindings through ILocalVariableLookup; legacy opaque lookups run after
discoverable local scopes and before workflow fallback. Raises an
exception when evaluated before Configure or when the monitored variable cannot be found.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK VariableHasValueCondition EXTENDS Condition
	IMPLEMENTS IVariableHasValueCondition, TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'OPC.UA.DA' := '0'}
	_MonitoredVariableName : STRING;

	{attribute 'OPC.UA.DA' := '0'}
	_Predicate : TOF_Comparison.BytewiseEqualityPredicate;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{d7c51a79-76d5-4e54-8ba0-beccf5464437}" />
    <Folder Name="Service methods" Id="{49e947e5-a970-42b5-94f3-6c9b90e734da}" />
    <Property Name="ClassName" Id="{b7bad684-4c7d-44fa-b9f3-59356c9c0af6}">
      <Declaration><![CDATA[(*!
<summary>Borrows the initialized class name used in diagnostics.</summary>
<description>
Returns initialized metadata storage without allocation. Callers must not modify the returned string.
Derived function blocks must use distinct initialized static storage when overriding this metadata.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2a12b19e-b4b4-4d1f-994c-3462d69f02b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{beea4cf4-f4df-4bfa-87eb-0a7431cad617}">
      <Declaration><![CDATA[(*!
<summary>Configures the monitored variable name and copies the reference value for comparison.</summary>
<param name="monitoredVariableName">Non-empty name of the variable to monitor.</param>
<param name="referenceValue">Non-empty reference value to compare against.</param>
*)
METHOD Configure
VAR_INPUT
	monitoredVariableName : STRING;
	referenceValue : ANY; 
END_VAR
VAR 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF monitoredVariableName = '' THEN
	TOF_Core.Exceptions.ThrowArgumentOutOfRange(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'monitoredVariableName',
		argumentValue := monitoredVariableName
	);
END_IF

IF referenceValue.pValue = TOF_Core.Memory.NULL_ADDRESS OR_ELSE referenceValue.diSize = TOF_Core.SignedInt32.ZERO THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'referenceValue'
	);
END_IF

configureInternal(monitoredWorkflowVariableName := monitoredVariableName, referenceValue := referenceValue);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Configured" Id="{d3138cc2-4f83-42fd-a975-721b3efc8f84}">
      <Declaration><![CDATA[(*!
<summary>Reports whether both the variable name and reference value have been configured.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{0840293a-29eb-4900-b343-b40209a68d29}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Configured := _MonitoredVariableName <> '' AND_THEN NOT _Predicate.ReferenceValue.IsNull;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="configureInternal" Id="{0fc36eec-48f7-4ec9-ab94-4c8afdbe1add}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Stores the variable name and copies the reference value into the equality predicate.</summary>
<param name="monitoredWorkflowVariableName">Validated variable name.</param>
<param name="referenceValue">Validated reference value.</param>
*)
METHOD PRIVATE configureInternal
VAR_INPUT
	monitoredWorkflowVariableName : STRING;
	referenceValue : __SYSTEM.AnyType; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MonitoredVariableName := monitoredWorkflowVariableName;
_Predicate.SetReferenceValueByAnyType(referenceValue := referenceValue);]]></ST>
      </Implementation>
    </Method>
    <Property Name="MonitoredVariableName" Id="{7e4166f8-1c74-494f-b340-b1e526abbf0a}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured variable name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY MonitoredVariableName : STRING]]></Declaration>
      <Get Name="Get" Id="{1eb33d4c-ec62-4599-b5f6-fa72662f6551}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[MonitoredVariableName := _MonitoredVariableName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{224db0af-4774-4e0e-bcd7-af75cd7fc026}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>
Borrows storage from the live internal namespace provider. Reacquire references after application
reinitialization or relocation. Treat the reference as read-only; no ownership or synchronization is provided.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{642d2276-39fc-457c-9d46-321b3f7648ae}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEvaluate" Id="{8440fe50-06b4-43d8-bb22-4354c386b514}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resolves the monitored variable with local scopes before workflow and compares its value.</summary>
<param name="activity">Activity context for variable lookup.</param>
*)
METHOD PROTECTED OnEvaluate : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;


	variableFound : BOOL;
	variable : TOF_Core.GENERIC_VALUE;
	variableValue : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Configured THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255("Condition '", Name, "' is not configured");

	WorkflowExceptions.ThrowWorkflowConfiguration(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

variableFound := TryResolveVariable(name := _MonitoredVariableName, activity := activity, variable => variable);

IF NOT variableFound THEN
	formattedExceptionMessage := TOF_Core.WideStrings.Concat255(
		"Condition '",
		Name,
		"' requires variable '",
		TO_WSTRING(_MonitoredVariableName),
		"' which is not found"
	);

	WorkflowExceptions.ThrowWorkflowVariableNotFound(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := formattedExceptionMessage
	);
END_IF

variableValue := variable.AsAnyType();

OnEvaluate := _Predicate.Check(valueToCompare := variableValue);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ReferenceValue" Id="{f2dea975-210b-4d62-87af-bcb2e4255b55}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed reference to the stored comparison value.</summary>
<description>
The predicate owns the snapshot. Callers must not mutate, release or reset the borrowed descriptor. Its
payload may be replaced by Configure and becomes invalid when the condition is disposed. The reference
property is read-only by contract rather than by IEC reference-assignment mechanics.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ReferenceValue : REFERENCE TO TOF_Core.GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{2820c5a1-237c-4f4e-8eb7-440359a3c141}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ReferenceValue REF= _Predicate.ReferenceValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{55fdfcaa-f84a-4e5f-9254-77c594301c7d}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete function block instance in bytes.</summary>
<description>
Reports the instance layout rather than dynamic allocations owned by its fields. A derived function block
with a different layout must override this property; the value does not grant disposal rights.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{fbc6c56a-2a60-4acb-9dc2-0c0cf6bc25f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Serialize" Id="{2fb31a9c-6d60-4f08-9976-e0cba68a71c7}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Workflows.WriteConfigurationHeader(writer := writer, source := THIS^, displayName := Name, scope := THIS^);
writer.WriteValue(
	name := 'variable',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(_MonitoredVariableName),
	size := SIZEOF(_MonitoredVariableName)
);
Workflows.WriteConfigurationLiteral(writer := writer, name := 'value', value := ReferenceValue.AsAnyType());]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{ffbe41a7-f2d3-4696-919d-167500a0615a}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and deserialization context are borrowed for this call.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Active configuration deserialization context providing workflow reconstruction services.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	loader : IWorkflowLoader;
	operand : STRING;
	literal : __SYSTEM.AnyType;
	storage : POINTER TO BYTE;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[loader := WorkflowConfigurationSerializer.ResolveWorkflowLoader(context := context);
Workflows.ReadConfigurationHeader(reader := reader, node := node, target := THIS^, scope := THIS^);

operand := Workflows.ReadName(reader := reader, node := reader.GetField(node := node, name := 'variable'));
loader.AddRequiredVariable(scope := THIS^, name := operand);
literal := Workflows.ReadLiteral(reader := reader, node := reader.GetField(node := node, name := 'value'));
storage := literal.pValue;

__TRY
	configureInternal(monitoredWorkflowVariableName := operand, referenceValue := literal);
__CATCH(exceptionCode)
	__DELETE(storage);
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

__DELETE(storage);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>