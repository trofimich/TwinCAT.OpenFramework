<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Condition" Id="{5ba1e305-1521-4876-bdb5-1f2abfdf8601}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides the base hierarchy, variable lookup and evaluation logging for workflow conditions.</summary>
<description>
FB_init stores the workflow association and default name only. Dynamic instances require explicit
RegisterChild after construction; static instances remain caller-owned. Named variable lookup searches local,
parent condition, parent activity and workflow scopes without propagating exceptions. Variable conditions
use TryResolveVariable to search local scopes, then the evaluating activity hierarchy, before workflow fallback.
Condition declarations survive evaluation and reset with the owning activity.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ABSTRACT Condition EXTENDS TOF_Core.Object
	IMPLEMENTS ICondition, ILocalVariableLookup, IDeclaredVariableContainer,
		IVariableBinder, IVariableResetScopeProvider
VAR
	{attribute 'hide'} 
	_Name : WSTRING;

	_Workflow : IWorkflow;

	_ParentActivity : IActivity;
	
	_ParentCondition : ICondition;

	_VariableResetScope : VariableResetScope;
	_VariableScope : VariableScope;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{5ed654de-488c-41a3-9dd6-d31befe37354}" />
    <Folder Name="Service methods" Id="{7102e9a5-813c-42ef-9cb4-8a48ef0392bc}" />
    <Property Name="Configured" Id="{167f4971-9594-4ce6-95be-09c7e6a87131}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the condition is completely configured and ready for evaluation.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT Configured : BOOL]]></Declaration>
      <Get Name="Get" Id="{d14f9b9f-000e-4358-a872-00cc7a327f4d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Evaluate" Id="{79c4792c-02ed-4587-8f2d-2a9ccd61ae06}">
      <Declaration><![CDATA[(*!
<summary>Evaluates the condition via OnEvaluate and logs when it evaluates to TRUE.</summary>
<param name="activity">Activity context for evaluation.</param>
*)
METHOD FINAL Evaluate : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR
VAR
	formattedLogMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OnEvaluate(activity := activity) THEN
	Evaluate := TRUE;

	formattedLogMessage := TOF_Core.WideStrings.Concat255(
		"Condition '",
		Name,
		"' evaluated as TRUE at ",
		TO_WSTRING(TOF_Core.System.SystemLocalDateTime)
	);

	TOF_Core.LogManager.TryLogMessage(
		message := formattedLogMessage,
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		topic1 := TO_WSTRING(ClassName),
		topic2 := "Condition",
		topic3 := "ConditionEvaluate"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{4bec2862-106d-4344-bbd9-4598c29c12e2}">
      <Declaration><![CDATA[(*!
<summary>Stores the borrowed workflow association and initializes the default condition name.</summary>
<description>
Does not allocate registry storage. The creator must call workflow.RegisterChild after __NEW succeeds, outside
lifecycle methods, if the workflow is to own this dynamic instance.
</description>
<param name="workflow">Workflow that hosts this condition, or 0 when attached later.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	workflow : IWorkflow;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Name := GetDefaultName();

_Workflow := workflow;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{71961bbf-f4ff-4ba9-a45a-cd1279b7b5ac}">
      <Declaration><![CDATA[(*!
<summary>Returns a reference to the condition diagnostic name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Name : REFERENCE TO WSTRING
]]></Declaration>
      <Get Name="Get" Id="{f1799a45-8028-470b-acc1-25f2f24a0e72}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name REF= _Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEvaluate" Id="{679374e5-c40e-49a4-b386-c18b7d32a90f}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Evaluates the concrete condition predicate.</summary>
<param name="activity">Activity context for evaluation.</param>
*)
METHOD PROTECTED ABSTRACT OnEvaluate : BOOL
VAR_INPUT
	activity : IActivity;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Parent" Id="{40367a00-bd78-4469-98b1-577fa9c041fd}">
      <Declaration><![CDATA[(*!
<summary>Returns the immediate parent condition or parent activity.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Parent : IWorkflowElement]]></Declaration>
      <Get Name="Get" Id="{0f9d4991-246e-4d36-9ce8-fbe0351b39ca}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ParentCondition <> 0 THEN
	Parent := _ParentCondition;
ELSE
	Parent := _ParentActivity;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnclosingActivity" Id="{4cfa67f8-5c8c-41ea-9487-dd9a619745d2}">
      <Declaration><![CDATA[(*!
<summary>Resolves the nearest activity that hosts this condition, traversing parent conditions if needed.</summary>
<description>
Returns the direct ParentActivity when attached directly to an activity, or traverses the ParentCondition
chain upward until the hosting activity is found. Returns 0 if unattached.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL EnclosingActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{f9e629fa-d4f1-4b2b-804f-6c6e3caf5584}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ParentActivity <> 0 THEN
	EnclosingActivity := _ParentActivity;
ELSIF _ParentCondition <> 0 THEN
	EnclosingActivity := _ParentCondition.EnclosingActivity;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ParentActivity" Id="{b6256e22-b8a0-4cc3-a832-607b87034c7f}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the borrowed immediate parent activity to which this condition is attached.</summary>
<description>
Returns 0 when the condition is attached to a parent condition rather than directly to an activity.
Use EnclosingActivity to resolve the owning activity context through the parent condition chain.
The standard implementation validates cycles, fixed workflow association and PASSIVE_READY before a new
link is stored. Existing parent links cannot be detached or replaced; an unchanged link is a no-op.
Parents are borrowed for the tree lifetime and do not transfer ownership. Configuration is single-task
without reentry; a child with a known owner requires a parent from that same known workflow.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ParentActivity : IActivity]]></Declaration>
      <Get Name="Get" Id="{51d2327b-3bc3-49d3-8be6-ff68ae13904b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ParentActivity := _ParentActivity;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{41b8ec15-87fc-4bba-8ef5-a5827c202fef}">
        <Declaration><![CDATA[VAR
	resetOwner : IVariableResetScopeProvider;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ParentCondition = 0 AND_THEN _ParentActivity = ParentActivity THEN
	RETURN;
END_IF

IF _ParentCondition <> 0 OR_ELSE _ParentActivity <> 0 OR_ELSE ParentActivity = 0 THEN
	WorkflowExceptions.ThrowWorkflowAttachment(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Condition parent cannot be detached or replaced"
	);
END_IF

Workflows.ValidateElementAttachment(parent := ParentActivity, child := THIS^);

IF __QUERYINTERFACE(ParentActivity, resetOwner) THEN
	_VariableResetScope.Attach(parent := resetOwner.GetResetScope());
END_IF

_ParentActivity := ParentActivity;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ParentCondition" Id="{c33d6432-48ad-41c4-919b-becbef5c626f}">
      <Declaration><![CDATA[(*!
<summary>Gets or establishes the borrowed parent composite condition.</summary>
<description>
An unchanged link is a no-op. Topology and readiness are validated before mutation; an existing activity or
condition parent cannot be detached or replaced. Activity context is resolved through the live parent chain,
without caching a second parent link. A standard parent links the subtree for reset. Both nodes are
non-copyable after linking and are used in the same task.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ParentCondition : ICondition]]></Declaration>
      <Get Name="Get" Id="{f889bd28-4875-415c-9f55-b2b9cfb6479e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ParentCondition := _ParentCondition;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{dc850025-6a74-45a0-9116-b83341f47346}">
        <Declaration><![CDATA[VAR
	resetOwner : IVariableResetScopeProvider;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ParentActivity = 0 AND_THEN _ParentCondition = ParentCondition THEN
	RETURN;
END_IF

IF _ParentActivity <> 0 OR_ELSE _ParentCondition <> 0 OR_ELSE ParentCondition = 0 THEN
	WorkflowExceptions.ThrowWorkflowAttachment(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Condition parent cannot be detached or replaced"
	);
END_IF

Workflows.ValidateElementAttachment(parent := ParentCondition, child := THIS^);

IF __QUERYINTERFACE(ParentCondition, resetOwner) THEN
	_VariableResetScope.Attach(parent := resetOwner.GetResetScope());
END_IF

_ParentCondition := ParentCondition;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="BindPlcVariable" Id="{6f5798da-6c21-457a-b2ca-224f01c47000}">
      <Declaration><![CDATA[(*!
<summary>Binds a named PLC variable reference in this condition's local scope.</summary>
<description>
Stores a borrowed reference to the supplied PLC variable in the condition variable dictionary under a unique name.
Fails if the workflow is busy, the name is empty, the name already exists in this condition, or the variable resides
in stack memory.
Type mapping precedes allocation of the owned name key. Failure before dictionary acceptance releases
that key and propagates the exception; successful binding transfers key ownership to the dictionary.
The variable storage remains borrowed and must outlive its binding.
</description>
<param name="name">Unique non-empty variable name.</param>
<param name="plcVariable">PLC variable to bind (instance field or global variable).</param>
<param name="plcVariableIsObject">TRUE if the variable is an FB instance implementing IObject.</param>
*)
METHOD BindPlcVariable : BOOL
VAR_INPUT
	name : STRING;
	plcVariable : ANY;
	plcVariableIsObject : BOOL := FALSE;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

BindPlcVariable := _VariableScope.BindPlcVariable(
	name := name,
	plcVariable := plcVariable,
	plcVariableIsObject := plcVariableIsObject,
	busy := ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy,
	ownerKind := 'condition',
	busyOwnerKind := 'workflow',
	ownerName := THIS^.Name,
	sourceClassName := ClassName,
	sourcePOUName := __POUNAME()
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetVariable" Id="{54c0b438-a23e-4e9d-a1fa-12698a06e3ed}">
      <Declaration><![CDATA[(*!
<summary>Attempts to resolve a named variable from this condition, its parent hierarchy or the workflow.</summary>
<description>
Returns FALSE when resolution fails or a nested call raises an exception. Use the output only when TRUE is
returned. Does not propagate exceptions or clear terminal allocation state. A latched allocation failure returns FALSE
without entering further lookup callbacks, including when a nested callback contained the allocation exception.
</description>
<param name="name">Case-sensitive variable name to look up.</param>
<param name="variable">Resolved variable value when TRUE is returned.</param>
*)
METHOD TryGetVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	RETURN;
END_IF

__TRY
	TryGetVariable := _VariableScope.TryGetLocalVariable(name := name, variable => variable);

	IF NOT TryGetVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed
		AND_THEN _ParentCondition <> 0
	THEN
		TryGetVariable := _ParentCondition.TryGetVariable(name := name, variable => variable);
	END_IF

	IF NOT TryGetVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed
		AND_THEN _ParentActivity <> 0
	THEN
		TryGetVariable := _ParentActivity.TryGetVariable(name := name, variable => variable);
	END_IF

	IF NOT TryGetVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
		ownerWorkflow := Workflow;

		IF ownerWorkflow <> 0 THEN
			TryGetVariable := ownerWorkflow.TryGetVariable(name := name, variable => variable);
		END_IF
	END_IF
__CATCH
	TryGetVariable := FALSE;
__ENDTRY

IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	TryGetVariable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Workflow" Id="{b14cf224-5c49-4763-9197-5e142173c022}">
      <Declaration><![CDATA[(*!
<summary>Returns the workflow associated with this condition or inherited from its parent hierarchy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Workflow : IWorkflow]]></Declaration>
      <Get Name="Get" Id="{48d09523-3b5c-4012-a81b-619f271a0e9a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Workflow <> 0 THEN
	Workflow := _Workflow;
ELSIF _ParentCondition <> 0 THEN
	Workflow := _ParentCondition.Workflow;
ELSIF _ParentActivity <> 0 THEN
	Workflow := _ParentActivity.Workflow;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryGetLocalVariable" Id="{35e9d3c1-3375-44e2-b1d7-293ce4afb018}">
      <Declaration><![CDATA[(*!
<summary>Attempts to find a binding registered directly on this instance.</summary>
<description>
Does not inspect parents or workflow fallback. Returns a borrowed descriptor only on TRUE.
Returns FALSE for absence, callback exceptions or terminal allocation failure without clearing the fatal latch.
The owner keeps the registered PLC storage alive; use one task without concurrent reconfiguration.
</description>
<param name="name">Case-sensitive name registered directly on this instance.</param>
<param name="variable">Borrowed binding descriptor, usable only on TRUE.</param>
*)
METHOD TryGetLocalVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryGetLocalVariable := _VariableScope.TryGetLocalVariable(name := name, variable => variable);]]></ST>
      </Implementation>
    </Method>
    <Method Name="tryGetHierarchyVariable" Id="{0f916c1d-490f-4bd7-9055-aaa0242fb7fc}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Searches one stable parent chain for direct bindings or legacy lookup providers.</summary>
<description>
The local pass queries only ILocalVariableLookup. The legacy pass calls TryGetVariable only on
elements without that capability. All callbacks are contained; a fatal allocation observation stops traversal.
Parent links must remain acyclic and unchanged during lookup. Output is borrowed and usable only on TRUE.
</description>
<param name="scope">First element of the borrowed stable parent chain, or zero.</param>
<param name="name">Case-sensitive binding name.</param>
<param name="localLookup">TRUE searches direct bindings; FALSE consults only legacy providers.</param>
<param name="variable">Borrowed resolved descriptor, usable only on TRUE.</param>
*)
METHOD PRIVATE tryGetHierarchyVariable : BOOL
VAR_INPUT
	scope : IWorkflowElement;
	name : STRING;
	localLookup : BOOL;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	currentScope : IWorkflowElement;
	lookupContainer : ILocalVariableLookup;
	hasLocalLookup : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	RETURN;
END_IF

__TRY
	currentScope := scope;

	WHILE currentScope <> 0 AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed DO
		hasLocalLookup := __QUERYINTERFACE(currentScope, lookupContainer);

		IF localLookup AND_THEN hasLocalLookup THEN
			tryGetHierarchyVariable := lookupContainer.TryGetLocalVariable(name := name, variable => variable);
		ELSIF NOT localLookup AND_THEN NOT hasLocalLookup THEN
			tryGetHierarchyVariable := currentScope.TryGetVariable(name := name, variable => variable);
		END_IF

		IF tryGetHierarchyVariable OR_ELSE TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
			EXIT;
		END_IF

		currentScope := currentScope.Parent;
	END_WHILE
__CATCH
	tryGetHierarchyVariable := FALSE;
__ENDTRY

IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	tryGetHierarchyVariable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryResolveVariable" Id="{b472ac93-f74b-43bc-a428-8805683e1486}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Resolves a variable for condition evaluation with workflow fallback last.</summary>
<description>
Searches this condition and its parent chain for direct bindings, then the evaluating activity and its
ancestors. Legacy providers without ILocalVariableLookup are consulted afterward using their opaque
lookup policy. Finally searches this condition's workflow, then a distinct evaluating activity workflow.
Preserves nearest-scope shadowing for standard elements. The graph and registered storage must remain
alive and stable in one owner task. Returns FALSE without exception escape or clearing terminal OOM;
the borrowed output is usable only on TRUE.
</description>
<param name="name">Case-sensitive binding name.</param>
<param name="activity">Optional evaluating activity supplying additional local scopes and fallback.</param>
<param name="variable">Borrowed resolved descriptor, usable only on TRUE.</param>
*)
METHOD PROTECTED TryResolveVariable : BOOL
VAR_INPUT
	name : STRING;
	activity : IActivity;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
	contextWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	RETURN;
END_IF

__TRY
	TryResolveVariable := tryGetHierarchyVariable(
		scope := THIS^,
		name := name,
		localLookup := TRUE,
		variable => variable
	);

	IF NOT TryResolveVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
		TryResolveVariable := tryGetHierarchyVariable(
			scope := activity,
			name := name,
			localLookup := TRUE,
			variable => variable
		);
	END_IF

	IF NOT TryResolveVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
		TryResolveVariable := tryGetHierarchyVariable(
			scope := THIS^,
			name := name,
			localLookup := FALSE,
			variable => variable
		);
	END_IF

	IF NOT TryResolveVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
		TryResolveVariable := tryGetHierarchyVariable(
			scope := activity,
			name := name,
			localLookup := FALSE,
			variable => variable
		);
	END_IF

	IF NOT TryResolveVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
		ownerWorkflow := Workflow;

		IF ownerWorkflow <> 0 AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
			TryResolveVariable := ownerWorkflow.TryGetVariable(name := name, variable => variable);
		END_IF
	END_IF

	IF NOT TryResolveVariable AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed
		AND_THEN activity <> 0
	THEN
		contextWorkflow := activity.Workflow;

		IF contextWorkflow <> 0 AND_THEN contextWorkflow <> ownerWorkflow
			AND_THEN NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed
		THEN
			TryResolveVariable := contextWorkflow.TryGetVariable(name := name, variable => variable);
		END_IF
	END_IF
__CATCH
	TryResolveVariable := FALSE;
__ENDTRY

IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	TryResolveVariable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeclareArray" Id="{d6f41a45-d7f0-411d-9a35-88ec1c6e6748}">
      <Declaration><![CDATA[(*!
<summary>Declares a nonempty one-dimensional array of elementary IEC values.</summary>
<description>Copies every element in source order into independent zero-based storage of fixed length.
Descriptors must borrow live, readable variables throughout the call and have identical IEC types and sizes,
including string capacity. Duplicate names, unsupported shapes and busy scopes raise before insertion.
Use in the owning task. Reset restores the complete initial sequence in place.</description>
<param name="name">Unique local binding name.</param>
<param name="initialValues">Typed initial element descriptors from Workflows.GetValueDescriptor,
live for this call.</param>
<param name="elementCount">Number of readable contiguous descriptors; positive and fixed at creation.</param>
*)
METHOD FINAL DeclareArray
VAR_INPUT
	name : STRING;
	initialValues : POINTER TO __SYSTEM.AnyType;
	elementCount : DINT;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

_VariableScope.DeclareArray(
	name := name,
	initialValues := initialValues,
	elementCount := elementCount,
	busy := ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy
);
_VariableResetScope.SetBindings(bindings := _VariableScope.Bindings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeclareConfigurationVariable" Id="{255484f7-a486-4aff-bb4b-54c231a41ea6}">
      <Declaration><![CDATA[(*!
<summary>Copies a decoded scalar or fixed one-dimensional array into local storage.</summary>
<description>Pass elementCount = 0 for a scalar variable, or a positive count for an array.
Initial data is copied into local storage.</description>
<param name="name">Unique local binding name.</param>
<param name="typeName">Elementary IEC type name.</param>
<param name="initialData">Pointer to contiguous decoded initial bytes.</param>
<param name="elementCount">0 for a scalar variable, or positive count for an array.</param>
*)
METHOD FINAL DeclareConfigurationVariable
VAR_INPUT
	name : STRING;
	typeName : STRING;
	initialData : PVOID;
	elementCount : DINT;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

_VariableScope.DeclareConfigurationVariable(
	busy := ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy,
	name := name,
	typeName := typeName,
	initialData := initialData,
	elementCount := elementCount
);
_VariableResetScope.SetBindings(bindings := _VariableScope.Bindings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeclareVariable" Id="{40875d7a-d6f9-46f5-9b19-1ddc02b9403a}">
      <Declaration><![CDATA[(*!
<summary>Declares a writable named value and copies its initial contents into this scope.</summary>
<description>Use during idle configuration in one owning task. The name must be nonempty and unique among local
bindings and declarations. Accepts elementary numeric, bit, date/time and string variables. Both copies retain
the supplied storage size. Lookup borrows the current value until scope disposal. Successful owner reset
restores it in place. Invalid declarations raise without replacing a binding. Terminal allocation failure propagates.
</description>
<param name="name">Case-sensitive local name.</param>
<param name="initialValue">Typed initial contents, including the full declared string capacity.</param>
*)
METHOD FINAL DeclareVariable
VAR_INPUT
	name : STRING;
	initialValue : ANY;
END_VAR
VAR
	ownerWorkflow : IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ownerWorkflow := Workflow;

_VariableScope.DeclareVariable(
	name := name,
	initialValue := initialValue,
	busy := ownerWorkflow <> 0 AND_THEN ownerWorkflow.Busy
);
_VariableResetScope.SetBindings(bindings := _VariableScope.Bindings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResetScope" Id="{b718d2c5-86bd-4e79-92e2-8fc2a0de6036}">
      <Declaration><![CDATA[(*!
<summary>Borrows the reset scope embedded in this parent for condition attachment.</summary>
<description>Returns live storage for the lifetime of the parent. Used by the validated parent setter
in its owning task. The caller must not delete, copy or independently reconfigure the scope.</description>
*)
METHOD FINAL GetResetScope : IVariableResetScope]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetResetScope := _VariableResetScope;]]></ST>
      </Implementation>
    </Method>
    <Method Name="NextDeclaration" Id="{511621b3-ebda-4482-8995-2b8f1d28831c}">
      <Declaration><![CDATA[(*!
<summary>Enumerates owned declarations local to this node.</summary>
<description>Start position at zero. TRUE supplies one declaration and advances the position; FALSE marks the end.
Borrowed PLC bindings are skipped. The scope must stay live and unchanged for the enumeration.
A negative position raises. Order follows dictionary storage and is not a serialization guarantee.</description>
<param name="position">Next dictionary slot to scan.</param>
<param name="name">Local name on TRUE.</param>
<param name="declaration">IEC element type, storage width, shape and extent on TRUE.</param>
*)
METHOD FINAL NextDeclaration : BOOL
VAR_IN_OUT
	position : DINT;
END_VAR
VAR_OUTPUT
	name : STRING;
	declaration : VARIABLE_DECLARATION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[NextDeclaration := _VariableScope.NextDeclaration(
	position := position,
	name => name,
	declaration => declaration
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDeclaredElement" Id="{a987fa26-c59e-4222-8c19-73a1054576e2}">
      <Declaration><![CDATA[(*!
<summary>Borrows one writable element of a local declaration.</summary>
<description>Indices start at zero. Scalar declarations accept index zero. Missing declarations, borrowed bindings
and out-of-range indices raise. The element remains at the same address through reset. Use in the owning task
only while the declaration exists.</description>
<param name="name">Local declaration name.</param>
<param name="index">Zero-based element index.</param>
*)
METHOD FINAL GetDeclaredElement : TOF_Core.GENERIC_VALUE
VAR_INPUT
	name : STRING;
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetDeclaredElement := _VariableScope.GetDeclaredElement(name := name, index := index);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopyInitialElement" Id="{a5da9ef7-8677-40df-9de1-6e82378bd62d}">
      <Declaration><![CDATA[(*!
<summary>Copies one initial element into caller-owned storage.</summary>
<description>
Reads the reset image even after the live value changes. The writable destination must have the exact
IEC type and storage size of the element. Invalid names, indices and incompatible destinations raise
before copying.
</description>
<param name="name">Local declaration name.</param>
<param name="index">Zero-based element index, zero for a scalar.</param>
<param name="destination">Descriptor of writable storage with the declared IEC type and capacity.
Pass GetValueDescriptor for a PLC variable.</param>
*)
METHOD FINAL CopyInitialElement
VAR_INPUT
	name : STRING;
	index : DINT;
	destination : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_VariableScope.CopyInitialElement(
	name := name,
	index := index,
	destination := destination
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
