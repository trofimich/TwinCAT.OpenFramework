<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IVariableContainer" Id="{a821d865-7499-4823-bc9c-a9226b7ccd87}">
    <Declaration><![CDATA[(*!
<summary>
Named variable lookup reports failure without propagating exceptions; its output is usable only on success.
</summary>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

INTERFACE IVariableContainer EXTENDS TOF_Core.IObject
]]></Declaration>
    <Method Name="TryGetVariable" Id="{cde7c073-74e9-49f1-ac46-4fe75c6c0e26}">
      <Declaration><![CDATA[(*!
<summary>Attempts to resolve a named variable from the available variable containers.</summary>
<description>
Returns FALSE when resolution fails or a nested call raises an exception. Use the output only when TRUE is
returned. Does not propagate exceptions or clear terminal allocation state. Terminal allocation failure forces FALSE,
including when a nested lookup contained its original exception. The owner still raises at the task boundary.
</description>
*)
METHOD TryGetVariable : BOOL
VAR_INPUT
	name : STRING;
END_VAR
VAR_OUTPUT
	variable : TOF_Core.GENERIC_VALUE;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="RegisterVariable" Id="{b7722bd8-3651-4539-8da5-2d3028de9089}">
      <Declaration><![CDATA[(*!
<summary>Registers a named PLC variable reference in this container.</summary>
<description>
Stores a borrowed reference to the supplied PLC variable under a unique case-sensitive name.
The variable must reside in static or dynamic memory; passing stack-allocated variables is not permitted.
Registration is only allowed during configuration while the container is not busy.
</description>
<param name="name">Unique non-empty variable name.</param>
<param name="plcVariable">PLC variable to bind (instance field or global variable).</param>
<param name="plcVariableIsObject">TRUE if the variable is an FB instance implementing IObject.</param>
*)
METHOD RegisterVariable : BOOL
VAR_INPUT
	name : STRING;
	plcVariable : ANY;
	plcVariableIsObject : BOOL := FALSE;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>