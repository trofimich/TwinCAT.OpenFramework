		<DataType>
			<Name GUID="{1489C7AA-92C1-2201-F7DD-DEEBAD4CEFBC}" Namespace="TOF_IOModels" AutoDeleteType="true">EL6xxx22ByteInData</Name>
			<Comment><![CDATA[
