<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="SIMPLE_TEXT_FILE_LOGGER_STATE" Id="{c555fb68-efff-4d11-9ca4-debbe246952e}">
    <Declaration><![CDATA[(*!
<summary>Identifies the current phase of a text-file logger.</summary>
<description>Stop first drains accepted messages in the current initialization/logging phase.
STOPPING then advances final file release; STOPPED permits explicit Start.
FAILED remains terminal and may still require cyclic cleanup.
New states follow FAILED so the existing state ordinals remain unchanged.</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE SIMPLE_TEXT_FILE_LOGGER_STATE :
(
	INITIAL,
	CREATING_DIRECTORY, 
	LOGGING, 
	FAILED,
	STOPPING,
	STOPPED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>