(*!
<summary>Provides configurable library limits for logging.</summary>
<description>Limits apply independently to each logger instance, not to a shared memory budget.</description>
*)
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	(*!
	<summary>Maximum number of messages waiting in each SimpleTextFileLogger message queue.</summary>
	<description>When the queue reaches this limit, TryLog methods return FALSE before formatting or allocating queued text. Already accepted messages are retained. The current send batch is excluded and is limited separately by maxRecordsPerFile. Zero prevents acceptance of new messages.</description>
	*)
	MAX_PENDING_LOG_MESSAGES : UINT := 100;

	(*!
	<summary>Maximum number of text records waiting in each QueuedLogger.</summary>
	<description>Fixed per-instance storage; each record includes an ERROR_MESSAGE and number metadata. The array reserves one extra slot so zero capacity is representable; zero rejects all records. One additional record is reserved for the active backend call. Capacity also bounds records forwarded by one Execute. Full queues reject new records without waiting for free space; acquiring the queue lock may still block.</description>
	*)
	QUEUED_LOGGER_CAPACITY : UINT := 100;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
