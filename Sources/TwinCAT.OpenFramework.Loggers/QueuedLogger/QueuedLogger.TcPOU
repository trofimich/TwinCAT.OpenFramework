<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="QueuedLogger" Id="{b2c6c979-01fa-442b-855a-08f1c69ad0aa}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Wraps another ILogger and forwards diagnostics from multiple tasks through a bounded queue.</summary>
<description>Configure once from the cyclic task that will service this instance, before publishing it to logging callers. Configuration binds Execute to that task; other tasks may enqueue but their Execute calls do nothing. Backend and wrapper lifetimes must cover all calls and pending processing. Backend is borrowed, not deleted or configured here; do not call it independently from other tasks or create routing cycles. Queue storage is fixed by Parameters.QUEUED_LOGGER_CAPACITY. Ordinary text admission does not allocate heap memory; error and exception formatting may allocate through their existing implementations. A full or unconfigured queue returns FALSE. TRUE means queued, not written. Errors and exceptions are formatted in the sending task, including source and local timestamp; aggregate causes become separate records and can interleave with other callers. Structured backend source fields and backend-specific aggregate markers are not preserved. Plain messages retain their supplied text. Execute attempts each dequeued record once without retry, even after backend FALSE or exception. FailedDeliveryCount records those failed attempts, not confirmed message loss or durable-write failures. No callback runs under the queue lock. Queue lock contention may block briefly. All TryLog methods and Execute contain exceptions and preserve terminal allocation state. PendingMessageCount exposes queued records only, excluding active delivery and backend work. Stop callers and finish backend processing before destruction; destruction does not flush pending records. Online-change behavior has not been established.</description>
*)

{attribute 'no_explicit_call' := 'Use Configure, TryLog methods and Execute'}
FUNCTION_BLOCK FINAL QueuedLogger EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.ILogger
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();

	_Backend : TOF_Core.ILogger;
	_OwnerTaskIndex : DINT;
	_QueueLock : Tc2_System.FB_IecCriticalSection;

	_Queue : ARRAY [0..Parameters.QUEUED_LOGGER_CAPACITY - 1] OF QUEUED_LOG_MESSAGE;
	_ReadIndex : UDINT;
	_WriteIndex : UDINT;
	_Count : UDINT;

	_CurrentMessage : QUEUED_LOG_MESSAGE;
	_FailedDeliveryCount : ULINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{4e07e9c8-ae76-4432-b4d6-c4bf5d4594a6}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{47c4d366-ef9b-46f6-973f-a50ac03601e9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{4c6d20a1-6e26-4434-ad62-03f30ea395d6}">
      <Declaration><![CDATA[(*!
<summary>Assigns the backend and binds processing to the calling cyclic task.</summary>
<description>Call once before publishing the wrapper. Returns FALSE for null or self backend, non-cyclic context, an already configured instance or lock failure. No allocation, exception creation or ownership transfer. Does not initialize the backend or replace an existing configuration.</description>
<param name="backend">Live logger serviced exclusively through this wrapper; must outlive its use.</param>
*)
METHOD Configure : BOOL
VAR_INPUT
	backend : TOF_Core.ILogger;
END_VAR
VAR
	taskIndex : DINT;
	selfLogger : TOF_Core.ILogger;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := TOF_Core.System.GetCurrentTaskIndex();

IF taskIndex < 1 OR_ELSE taskIndex > TOF_Core.System.TASK_COUNT OR_ELSE backend = 0 THEN
	RETURN;
END_IF

selfLogger := THIS^;

IF backend = selfLogger THEN
	RETURN;
END_IF

IF NOT _QueueLock.Enter() THEN
	RETURN;
END_IF

IF _OwnerTaskIndex = 0 THEN
	_Backend := backend;
	_OwnerTaskIndex := taskIndex;
	Configure := TRUE;
END_IF

_QueueLock.Leave();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{e5b8db30-d739-411c-a177-18119bf27053}">
      <Declaration><![CDATA[(*!
<summary>Services the backend and forwards a bounded batch from the owner task.</summary>
<description>Other tasks and unconfigured instances do no work. Snapshots the initial queue length and processes at most that many records, bounded by queue capacity. Calls backend Execute once before forwarding, allowing it to advance prior work. Each record is removed under the lock and copied into owner-only storage, then forwarded without the lock. Backend FALSE or exception increments FailedDeliveryCount once without retrying the record or logging another error. Backend Execute failures and enqueue rejections are excluded. Backend must borrow the record only for the call and must not reenter this wrapper. Concurrent producers may refill released slots. Does not guarantee durable output or a fixed execution time; backend and lock latency still apply.</description>
*)
METHOD Execute
VAR
	taskIndex : DINT;
	messagesToProcess : UDINT;
	i : UDINT;
	lockHeld : BOOL;
	delivered : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := TOF_Core.System.GetCurrentTaskIndex();

__TRY
	IF NOT _QueueLock.Enter() THEN
		RETURN;
	END_IF

	lockHeld := TRUE;

	IF _OwnerTaskIndex = 0 OR_ELSE taskIndex <> _OwnerTaskIndex THEN
		_QueueLock.Leave();
		lockHeld := FALSE;
		RETURN;
	END_IF

	messagesToProcess := _Count;
	_QueueLock.Leave();
	lockHeld := FALSE;

	__TRY
		_Backend.Execute();
	__CATCH
		// Backend failure must not escape or trigger recursive diagnostics.
	__ENDTRY

	FOR i := 1 TO messagesToProcess DO
		IF NOT _QueueLock.Enter() THEN
			RETURN;
		END_IF

		lockHeld := TRUE;
		_CurrentMessage := _Queue[_ReadIndex];
		_ReadIndex := _ReadIndex + 1;

		IF _ReadIndex >= Parameters.QUEUED_LOGGER_CAPACITY THEN
			_ReadIndex := 0;
		END_IF

		_Count := _Count - 1;
		_QueueLock.Leave();
		lockHeld := FALSE;

		__TRY
			IF _CurrentMessage.HasMessageNumber THEN
				delivered := _Backend.TryLogMessage(_CurrentMessage.Category, _CurrentMessage.Message, _CurrentMessage.MessageNumber);
			ELSE
				delivered := _Backend.TryLogMessage(_CurrentMessage.Category, _CurrentMessage.Message);
			END_IF
		__CATCH
			delivered := FALSE;
		__ENDTRY

		IF NOT delivered AND_THEN _FailedDeliveryCount < TOF_Core.UnsignedInt64.MAX_VALUE THEN
			_FailedDeliveryCount := _FailedDeliveryCount + 1;
		END_IF
	END_FOR
__CATCH
	IF lockHeld THEN
		_QueueLock.Leave();
	END_IF
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="FailedDeliveryCount" Id="{e941ff7a-fc15-4ef1-9c3b-f0b926f0c9ca}">
      <Declaration><![CDATA[(*!
<summary>Counts dequeued records whose single delivery attempt returned FALSE or raised an exception.</summary>
<description>Read from the owner task, or with application-level synchronization against Execute. Updated only by owner-task Execute. Starts at zero and saturates at UnsignedInt64.MAX_VALUE; no reset is provided. Excludes enqueue rejection and backend Execute errors. A failed attempt may have produced partial output; successful acceptance does not guarantee durable storage.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FailedDeliveryCount : ULINT]]></Declaration>
      <Get Name="Get" Id="{8260c53f-34a5-4e62-a6c6-1d7beb8b45e3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FailedDeliveryCount := _FailedDeliveryCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{e4c570a2-4e96-49f0-a27c-676afc330870}">
      <Declaration><![CDATA[(*!
<summary>Provides the queued logger NamespaceName.</summary>
<description>Borrowed read-only library namespace.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fdab0a59-862f-4095-ad24-46853b03c6c5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PendingMessageCount" Id="{f7763125-25b8-4f4e-b66b-d42b753b0d4c}">
      <Declaration><![CDATA[(*!
<summary>Returns a synchronized snapshot of the number of records waiting in the queue.</summary>
<description>Returns -1 if the queue lock cannot be acquired; zero means no queued records at the snapshot instant. Lock contention may block. Excludes the record currently being forwarded and any work buffered by the backend. Concurrent producers may change the count immediately after reading. For draining, stop producers and read from the owner task after Execute returns. Zero does not guarantee successful delivery, completed file I/O or a closed file. This property does not flush or stop either logger.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PendingMessageCount : DINT]]></Declaration>
      <Get Name="Get" Id="{000da11a-6da2-401b-874a-fe95f1876214}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PendingMessageCount := -1;

IF _QueueLock.Enter() THEN
	PendingMessageCount := TO_DINT(_Count);
	_QueueLock.Leave();
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{ff022a1b-f97c-47dc-8883-4a7825e259a0}">
      <Declaration><![CDATA[(*!
<summary>Provides the queued logger SelfSize.</summary>
<description>Size of this concrete instance, including its fixed queue storage.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7409f164-cfa1-4153-872d-92608066cdb6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryLogError" Id="{f7511d49-baae-40f0-a9e5-84c752870033}">
      <Declaration><![CDATA[(*!
<summary>Formats a borrowed error in the sending task and queues its text.</summary>
<description>Copies source and local timestamp into the text using ERROR.ToString. Retains no reference to ERROR. Returns FALSE for an invalid reference, failed admission or caught formatting exception. Does not clear terminal allocation state.</description>
<param name="error">Live error formatted during this call.</param>
<param name="messageNumber">Optional number copied with the formatted message.</param>
*)
METHOD TryLogError : BOOL
VAR_INPUT
	error : REFERENCE TO TOF_Core.ERROR;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR
VAR
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF NOT __ISVALIDREF(error) THEN
		RETURN;
	END_IF

	message := error.ToString(TOF_Core.ERROR_SOURCE_DISPLAY_MODE.TOP_AND_ROOT, TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL);
	TryLogError := TryLogMessage(SEL(error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL, TOF_Core.LOG_CATEGORY.ERROR, TOF_Core.LOG_CATEGORY.CRITICAL_ERROR), message, messageNumber);
__CATCH
	TryLogError := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogException" Id="{7110670c-336b-4b80-aa5f-381540f0d63f}">
      <Declaration><![CDATA[(*!
<summary>Queues text snapshots of a live exception or its aggregate causes.</summary>
<description>Formats source and local timestamp before task cleanup. Aggregate causes are visited in stored order and share the supplied optional request number. Stops on the first failure; already accepted records remain queued and FALSE may mean partial admission. Concurrent callers may interleave aggregate entries. Empty aggregates are formatted as ordinary exceptions. Input graphs must be valid and acyclic. No exception reference or clone is retained; terminal allocation state is preserved.</description>
<param name="exception">Live, acyclic exception graph borrowed for formatting.</param>
<param name="severity">Severity used to choose the queued category.</param>
<param name="messageNumber">Optional request number copied to each accepted cause record.</param>
*)
METHOD TryLogException : BOOL
VAR_INPUT
	exception : TOF_Core.IReadOnlyException;
	severity : TOF_Core.ERROR_SEVERITY;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR
VAR
	message : TOF_Core.ERROR_MESSAGE;
	aggregateException : TOF_Core.IAggregateException;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF exception = 0 THEN
		RETURN;
	END_IF

	IF __QUERYINTERFACE(exception, aggregateException) AND_THEN aggregateException.InnerExceptionCount > 0 THEN
		FOR i := 0 TO TO_DINT(aggregateException.InnerExceptionCount) - 1 DO
			IF NOT THIS^.TryLogException(aggregateException.GetInnerException(i), severity, messageNumber) THEN
				RETURN;
			END_IF
		END_FOR

		TryLogException := TRUE;
	ELSE
		message := exception.GetMessage(TRUE, TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL);
		TryLogException := TryLogMessage(SEL(severity = TOF_Core.ERROR_SEVERITY.CRITICAL, TOF_Core.LOG_CATEGORY.ERROR, TOF_Core.LOG_CATEGORY.CRITICAL_ERROR), message, messageNumber);
	END_IF
__CATCH
	TryLogException := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogMessage" Id="{d1cab8b8-026e-4345-b782-1bb6899ce79b}">
      <Declaration><![CDATA[(*!
<summary>Copies one message and its optional number into the bounded queue.</summary>
<description>Borrows inputs only for this call; the caller must keep them stable while copied. Returns FALSE before configuration, at capacity, on lock failure or on a caught exception. Commits the entry only after copying its contents. Does not call the backend or allocate text storage.</description>
<param name="category">Category copied into the queued record.</param>
<param name="message">Text copied into owned queue storage.</param>
<param name="messageNumber">Optional borrowed number copied by value.</param>
*)
METHOD TryLogMessage : BOOL
VAR_INPUT
	category : TOF_Core.LOG_CATEGORY;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR
VAR
	lockHeld : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF NOT _QueueLock.Enter() THEN
		RETURN;
	END_IF

	lockHeld := TRUE;

	IF _OwnerTaskIndex <> 0 AND_THEN _Count < Parameters.QUEUED_LOGGER_CAPACITY THEN
		_Queue[_WriteIndex].Message := message;
		_Queue[_WriteIndex].Category := category;
		_Queue[_WriteIndex].HasMessageNumber := __ISVALIDREF(messageNumber);

		IF _Queue[_WriteIndex].HasMessageNumber THEN
			_Queue[_WriteIndex].MessageNumber := messageNumber;
		END_IF

		_WriteIndex := _WriteIndex + 1;

		IF _WriteIndex >= Parameters.QUEUED_LOGGER_CAPACITY THEN
			_WriteIndex := 0;
		END_IF

		_Count := _Count + 1;
		TryLogMessage := TRUE;
	END_IF

	_QueueLock.Leave();
	lockHeld := FALSE;
__CATCH
	IF lockHeld THEN
		_QueueLock.Leave();
	END_IF

	TryLogMessage := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>