(*!
<summary>Stores an owned text snapshot waiting for a logging backend.</summary>
<description>Internal QueuedLogger storage. Text, category and optional number are copied by value. Contains no borrowed references to caller data or exceptions.</description>
*)
TYPE QUEUED_LOG_MESSAGE :
STRUCT
	Message : TOF_Core.ERROR_MESSAGE;
	Category : TOF_Core.LOG_CATEGORY;
	HasMessageNumber : BOOL;
	MessageNumber : ULINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
