(*!
<summary>Writes diagnostics through TwinCAT EventLogger and expands aggregate exceptions into entries.</summary>
<description>Use this backend for TwinCAT EventLogger events with structured source information when logging errors and exceptions directly. Use one task for direct calls on each instance; concurrent use of its internal FB_TcEventLogger has no established guarantee here. For callers in multiple tasks, use QueuedLogger and let only its owner task access this backend; do not bypass the wrapper with concurrent direct calls. QueuedLogger forwards text records, so exception source is included in text rather than the structured source field, and backend-specific aggregate formatting is not preserved. Execute performs no cyclic work. Exception logging accepts IReadOnlyException and reads borrowed diagnostics without transferring ownership. Implementations must not retain exception references beyond their task cleanup. Numbered messages preserve the number and truncate oversized text to ERROR_MESSAGE capacity with a final ellipsis. TryLog methods must satisfy the no-throw contract even when called directly, without LogManager. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK EventLogger EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.ILogger
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	_EventLogger : Tc3_EventLogger.FB_TcEventLogger;
	
	_DebugEventType : Global.TcEventEntry;
	_InformationEventType : Global.TcEventEntry;
	_WarningEventType : Global.TcEventEntry;
	_ErrorEventType : Global.TcEventEntry;
	_CriticalErrorEventType : Global.TcEventEntry;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal members" Id="{eb43b981-fe0c-4384-9a7e-ded8f887a71f}" />
    <Property Name="ClassName" Id="{8606f867-ab71-4ff0-b44a-b045271484a0}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3237a013-9364-426b-a2dd-3913256764ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{45bb9e14-c21d-4ace-9cc8-e5705603b0cc}">
      <Declaration><![CDATA[(*!
<summary>Completes without work because this logger has no cyclic processing.</summary>
<description>Does not raise exceptions.</description>
*)
METHOD Execute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// EventLogger has no cyclic work]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{e52cf092-8b74-4e13-811f-db521a4e102c}">
      <Declaration><![CDATA[(*!
<summary>FB_Init is always available implicitly and it is used primarily for initialization.</summary>
<description>The return value is not evaluated. Assigns and retains event definitions for each severity category.</description>
<param name="debugEventType">Event entry used for DEBUG category.</param>
<param name="informationEventType">Event entry used for INFORMATION category.</param>
<param name="warningEventType">Event entry used for WARNING category.</param>
<param name="errorEventType">Event entry used for ERROR category.</param>
<param name="criticalErrorEventType">Event entry used for CRITICAL_ERROR category.</param>
*)
METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	debugEventType : Global.TcEventEntry;
	informationEventType : Global.TcEventEntry;
	warningEventType : Global.TcEventEntry;
	errorEventType : Global.TcEventEntry;
	criticalErrorEventType : Global.TcEventEntry;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DebugEventType := debugEventType;	
_InformationEventType := informationEventType;
_WarningEventType := warningEventType;
_ErrorEventType := errorEventType;
_CriticalErrorEventType := criticalErrorEventType;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalTryLogMessage" Id="{b17f1f74-b328-47c1-a9cb-5cbdf2cd529f}" FolderPath="Internal members\">
      <Declaration><![CDATA[(*!
<summary>Sends a diagnostic with its source and optional message number.</summary>
<description>When a number is supplied, preserves the number prefix and as much message text as fits ERROR_MESSAGE. Truncated text ends with U+2026. Formatting uses local storage and does not raise a size-overflow exception. Returns FALSE for an unsupported category or failed send.</description>
*)
METHOD PROTECTED InternalTryLogMessage : BOOL
VAR_INPUT
	category : TOF_Core.LOG_CATEGORY;	
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	source : Tc2_System.T_MaxString;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR
VAR	
	sourceInfo : Tc3_EventLogger.FB_TcSourceInfo;
	arguments : Tc3_EventLogger.FB_TcArguments;
	messageWithNumber : TOF_Core.ERROR_MESSAGE;
	methodResult : HRESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[sourceInfo.sName := source;

IF __ISVALIDREF(messageNumber) THEN
	messageWithNumber := TOF_Core.WideStrings.Concat255(TO_WSTRING(TOF_Core.Exceptions.MESSAGE_NUMBER_PREFIX), TO_WSTRING(messageNumber), TO_WSTRING(TOF_Core.Exceptions.MESSAGE_NUMBER_SUFFIX));
	TOF_Core.WideStrings.AppendFit(messageWithNumber, message);
	arguments.AddWString(messageWithNumber);
ELSE
	arguments.AddWString(message);
END_IF

CASE category OF
	TOF_Core.LOG_CATEGORY.DEBUG:
		methodResult := _EventLogger.SendMessageEx(_DebugEventType, sourceInfo, 0, arguments);				
			
	TOF_Core.LOG_CATEGORY.INFORMATION:
		methodResult := _EventLogger.SendMessageEx(_InformationEventType, sourceInfo, 0, arguments);				
		
	TOF_Core.LOG_CATEGORY.WARNING:
		methodResult := _EventLogger.SendMessageEx(_WarningEventType, sourceInfo, 0, arguments);				
	
	TOF_Core.LOG_CATEGORY.ERROR:
		methodResult := _EventLogger.SendMessageEx(_ErrorEventType, sourceInfo, 0, arguments);				

	TOF_Core.LOG_CATEGORY.CRITICAL_ERROR:
		methodResult := _EventLogger.SendMessageEx(_CriticalErrorEventType, sourceInfo, 0, arguments);				

	ELSE
		Tc2_System.ADSLOGSTR(
			msgCtrlMask := Tc2_System.Global_Variables.ADSLOG_MSGTYPE_ERROR OR Tc2_System.Global_Variables.ADSLOG_MSGTYPE_LOG, 
			msgFmtStr := Tc2_Standard.CONCAT('Unsupported log category ', TO_STRING(category)), 
			strArg := '');
			
		RETURN;		
END_CASE

IF Tc3_Module.FAILED(methodResult) THEN
	Tc2_System.ADSLOGSTR(
		msgCtrlMask := Tc2_System.Global_Variables.ADSLOG_MSGTYPE_ERROR OR Tc2_System.Global_Variables.ADSLOG_MSGTYPE_LOG, 
		msgFmtStr := Tc2_Standard.CONCAT('FB_TcMessage creation failed with HRESULT = ', TO_STRING(methodResult)), 
		strArg := '');
		
	RETURN;		
END_IF

InternalTryLogMessage := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{75388737-b788-4a16-a31f-a3885f5f2749}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{751a8249-a618-42a3-8fb5-6e37489fe438}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{98e9eadc-01ba-46bc-90cb-368644546c24}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{606ae824-c393-4762-992a-f3ef439dd9fb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryLogError" Id="{4a210b47-12f5-416e-800c-6b940764fae5}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log a borrowed error without propagating exceptions.</summary>
<description>Borrows inputs only for the call. TRUE reports backend acceptance, not guaranteed durable storage. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
*)
METHOD TryLogError : BOOL
VAR_INPUT
	error : REFERENCE TO TOF_Core.ERROR;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR
VAR
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF NOT __ISVALIDREF(error) THEN
		RETURN;
	END_IF

	message := error.ToString(TOF_Core.ERROR_SOURCE_DISPLAY_MODE.HIDDEN, TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN);

	TryLogError := InternalTryLogMessage(SEL(error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL, TOF_Core.LOG_CATEGORY.ERROR, TOF_Core.LOG_CATEGORY.CRITICAL_ERROR), message, error.GetSource(TRUE), messageNumber);
__CATCH
	TryLogError := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogException" Id="{1990277d-d5d3-4267-af7a-8be26122cbfe}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log diagnostic information from a read-only exception view.</summary>
<description>Borrows the exception for the call without clearing it or taking ownership. The exception and its inner causes must remain live while their diagnostics are read. Logging does not extend their lifetime. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
<param name="exception">Exception view to read; null is ignored.</param>
<param name="severity">Severity used to select the log category.</param>
*)
METHOD TryLogException : BOOL
VAR_INPUT
	exception : TOF_Core.IReadOnlyException;
	severity : TOF_Core.ERROR_SEVERITY;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR
VAR
	message : TOF_Core.ERROR_MESSAGE;
	aggregateException : TOF_Core.IAggregateException;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF exception = 0 THEN
		RETURN;
	END_IF

	IF NOT __QUERYINTERFACE(exception, aggregateException) OR_ELSE aggregateException.InnerExceptionCount = 0 THEN
		message := exception.GetMessage(FALSE, TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL);
		TryLogException := InternalTryLogMessage(SEL(severity = TOF_Core.ERROR_SEVERITY.CRITICAL, TOF_Core.LOG_CATEGORY.ERROR, TOF_Core.LOG_CATEGORY.CRITICAL_ERROR), message, exception.GetSourceDescription(), messageNumber);
	ELSE
		TryLogException := TRUE;
		
		FOR i := 0 TO aggregateException.InnerExceptionCount - 1 DO
			TryLogException := TryLogException AND THIS^.TryLogException(aggregateException.GetInnerException(i), severity, messageNumber);		
		END_FOR
	END_IF
__CATCH
	TryLogException := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogMessage" Id="{68073492-716c-4ee9-a006-f48bbbfa1f4f}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log borrowed message text without propagating exceptions.</summary>
<description>Borrows inputs only for the call. TRUE reports backend acceptance, not guaranteed durable storage. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
*)
METHOD TryLogMessage : BOOL
VAR_INPUT
	category : TOF_Core.LOG_CATEGORY;	
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryLogMessage := InternalTryLogMessage(category, message, '', messageNumber);
__CATCH
	TryLogMessage := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>