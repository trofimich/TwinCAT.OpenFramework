    </Folder>
    <Method Name="bindIO" Id="{1bc433ca-8d0e-4452-8e3c-75449de42a8a}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE bindIO]]></Declaration>
      <Implementation>
        <ST><![CDATA[_WorkingModeSwitch.BindToIO(
	TerminalModels.DI_1.Channel_1
);

_BlinkingYellowModeSwitch.BindToIO(
	TerminalModels.DI_1.Channel_2
);

_SwitchSpeedAdjuster.BindToInt16IO(TerminalModels.AI_3.Channel_1);

_TrafficLight1.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Channel_1,
	yellowLightRawValue := TerminalModels.DO_2.Channel_2,
	greenLightRawValue 	:= TerminalModels.DO_2.Channel_3	
);
_TrafficLight2.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Channel_4,
	yellowLightRawValue := TerminalModels.DO_2.Channel_5,
	greenLightRawValue 	:= TerminalModels.DO_2.Channel_6	
);
_TrafficLight3.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Channel_7,
	yellowLightRawValue := TerminalModels.DO_2.Channel_8,
	greenLightRawValue 	:= TerminalModels.DO_2.Channel_9	
);
_TrafficLight4.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Channel_10,
	yellowLightRawValue := TerminalModels.DO_2.Channel_11,
	greenLightRawValue 	:= TerminalModels.DO_2.Channel_12	
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="BlinkingYellowModeSwitch" Id="{a4a71e1a-5dc0-41c8-b6e2-0a340d126fcd}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL BlinkingYellowModeSwitch : TOF_Devices_IO.IDigitalInput]]></Declaration>
      <Get Name="Get" Id="{35f9ad22-fa01-46e2-a2ae-83a8496cef6a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[BlinkingYellowModeSwitch := _BlinkingYellowModeSwitch;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="calculateCorrectedInterval" Id="{51d751ca-80fc-4362-91e8-31296f350aff}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE calculateCorrectedInterval : TIME
VAR_INPUT
	originalInterval : TIME;
	correctionPercent : SINT(-50..50);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF correctionPercent = 0 THEN
	calculateCorrectedInterval := originalInterval;
ELSIF correctionPercent > 0 THEN
	calculateCorrectedInterval := originalInterval + TO_TIME(TO_INT(originalInterval) * correctionPercent / 100);
ELSE
	calculateCorrectedInterval := originalInterval - TO_TIME(TO_INT(originalInterval) * -correctionPercent / 100);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Children" Id="{edb09d7e-eaa4-4ee7-bf71-f499880b4098}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent]]></Declaration>
