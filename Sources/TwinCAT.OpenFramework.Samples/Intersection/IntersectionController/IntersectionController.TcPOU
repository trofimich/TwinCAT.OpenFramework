    <Method Name="executeTimers" Id="{dfed4c3f-27bc-4f55-8a83-85a2d79b2492}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE executeTimers]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RedGreenLightTimer.Execute();
_YellowLightTimer.Execute();
_FlashingYellowLightTimer.Execute();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{cc48a528-d8b0-42ce-9f2b-4916737cac09}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	(* if TRUE, the retain variables are initialized (warm start / cold start)*)
	bInitRetains	: BOOL;
	(* if TRUE, the instance afterwards gets moved into the copy code (online change)*)
	bInCopyCode	: BOOL;
	name : WSTRING;
END_VAR
VAR_IN_OUT CONSTANT
	plugins : ARRAY [*] OF TOF_Automation.IAutomationControllerPlugin;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssignPlugins(plugins);]]></ST>
      </Implementation>
    </Method>
    <Property Name="LightsState" Id="{0d41ded4-f538-4005-aa70-f221d58f38a5}" FolderPath="Statuses\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL LightsState : INTERSECTION_LIGHTS_STATE]]></Declaration>
      <Get Name="Get" Id="{7519eabe-1cc3-4af8-82b3-a2f8425fe098}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LightsState := _LightsState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Mode" Id="{70c7bc2d-0923-4507-922c-273224e7708a}" FolderPath="Statuses\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL Mode : INTERSECTION_MODE]]></Declaration>
      <Get Name="Get" Id="{0c285f66-f61a-47a3-955f-b140c5836c96}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _IsOn THEN
	Mode := SEL(_FlashingYellowModeOn, INTERSECTION_MODE.WORKING, INTERSECTION_MODE.FLASHING_YELLOW);
ELSE
	Mode := INTERSECTION_MODE.OFF;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b7a7d419-b6f1-4dfe-b4b4-ae9ac4b21e47}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : STRING]]></Declaration>
      <Get Name="Get" Id="{225fc0aa-c40a-4b1c-a5e5-ec5ea749c036}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName := CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnBeforeChildrenInitializing" Id="{d14266f5-308f-4ec2-bbd3-dd4787db6449}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[METHOD PROTECTED OnBeforeChildrenInitializing  
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RedGreenLightTimer.Interval := IntersectionConstants.RED_GREEN_LIGHT_INTERVAL;
_YellowLightTimer.Interval := IntersectionConstants.YELLOW_LIGHT_INTERVAL;

_FlashingYellowLightTimer.Interval := IntersectionConstants.FLASHING_YELLOW_LIGHT_INTERVAL;

bindIO();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeChildrenStopped" Id="{0516e5db-6b58-48f7-b149-9edab8091cfe}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[METHOD PROTECTED OnBeforeChildrenStopped
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ResetButton.Changed AND_THEN _ResetButton.Value THEN
	Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeChildrenWorking" Id="{a2091fd1-b3c2-4408-9e2a-b795dd68dcf8}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[METHOD PROTECTED OnBeforeChildrenWorking]]></Declaration>
      <Implementation>
        <ST><![CDATA[executeTimers();

IF _AdjustSpeedButton.Changed AND_THEN _AdjustSpeedButton.Value THEN
	SetSwitchingSpeedCorrectionPercent(TO_SINT(_SwitchSpeedAdjuster.Value));
END_IF

IF _ResetButton.Changed AND_THEN _ResetButton.Value THEN
	Reset();
ELSIF _TurnOnButton.Changed AND_THEN _TurnOnButton.Value THEN
	TurnOn();
ELSIF TurnOffButton.Changed AND_THEN _TurnOnButton.Value THEN
	TurnOff();
ELSIF _SetYellowFlashingModeOnButton.Changed AND_THEN _SetYellowFlashingModeOnButton.Value THEN
	SetYellowFlashingModeOn();
ELSIF _SetYellowFlashingModeOffButton.Changed AND_THEN _SetYellowFlashingModeOffButton.Value THEN
	SetYellowFlashingModeOff();
ELSE
	CASE Mode OF
		INTERSECTION_MODE.WORKING:
			processNormalMode();
		
		INTERSECTION_MODE.FLASHING_YELLOW:
			processBlinkingYellowMode();
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnOperationalStateChanged" Id="{dfa58b81-4624-4688-b85b-fa55f112c836}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[METHOD PROTECTED OnOperationalStateChanged
VAR_INPUT
	previousState : TOF_Automation.OPERATIONAL_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED AND_THEN Mode <> INTERSECTION_MODE.OFF THEN
	TurnOff();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="OperationalStateName" Id="{af99d547-78da-4f00-96bd-32d0d0304681}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY OperationalStateName : STRING(16)]]></Declaration>
      <Get Name="Get" Id="{7a068cfa-95a9-4134-b604-ea1c07f183d2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[OperationalStateName := TO_STRING(_OperationalState);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="processBlinkingYellowMode" Id="{62fb35a3-197f-483b-a168-1d68d2c02c71}" FolderPath="Service methods\Process mode\">
      <Declaration><![CDATA[METHOD PRIVATE processBlinkingYellowMode]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _FlashingYellowLightTimer.Elapsed THEN
	IF _LightsState = INTERSECTION_LIGHTS_STATE.ALL_YELLOW THEN
		setState(
			state := INTERSECTION_LIGHTS_STATE.ALL_OFF, 
			nextState := INTERSECTION_LIGHTS_STATE.ALL_YELLOW
		);		
	ELSE
		setState(
			state := INTERSECTION_LIGHTS_STATE.ALL_YELLOW, 
			nextState := INTERSECTION_LIGHTS_STATE.ALL_OFF
		);		
	END_IF
	
	startFlashingYellowLightTimer();
	
	updateTraficLights();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="processNormalMode" Id="{a778b296-2e19-469e-8475-30ab670a6dcd}" FolderPath="Service methods\Process mode\">
      <Declaration><![CDATA[METHOD processNormalMode]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE _LightsState OF
	INTERSECTION_LIGHTS_STATE.GROUP1_GREEN_GROUP2_RED:
		IF _RedGreenLightTimer.Elapsed THEN
			startYellowLightTimer();
			
			setState(
				state := INTERSECTION_LIGHTS_STATE.ALL_YELLOW, 
				nextState := INTERSECTION_LIGHTS_STATE.GROUP1_RED_GROUP2_GREEN
			);
			
			updateTraficLights();
		END_IF
	
	INTERSECTION_LIGHTS_STATE.GROUP1_RED_GROUP2_GREEN:
		IF _RedGreenLightTimer.Elapsed THEN
			startYellowLightTimer();
			
			setState(
				state := INTERSECTION_LIGHTS_STATE.ALL_YELLOW, 
				nextState := INTERSECTION_LIGHTS_STATE.GROUP1_GREEN_GROUP2_RED
			);
			
			updateTraficLights();
		END_IF
	
	INTERSECTION_LIGHTS_STATE.ALL_YELLOW:
		IF _YellowLightTimer.Elapsed THEN
			startRedGreenLightTimer();
			
			setState(
				state := _NextState, 
				nextState := INTERSECTION_LIGHTS_STATE.ALL_YELLOW
			);
			
			updateTraficLights();
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResetButton" Id="{17258f9f-04a6-4026-9d49-4d1d3b2cf340}" FolderPath="Subdevices\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResetButton : TOF_Devices_IO.IDigitalInput]]></Declaration>
      <Get Name="Get" Id="{2fcfe820-b683-4e4c-ba46-821a27b852e2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResetButton := _ResetButton;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{db85e590-8997-4b56-bd9a-8e5dd4df70fe}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f6ab4eca-dad6-4656-bd85-433d2bf1854b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="setState" Id="{5c2f2c55-d0ba-4b8a-8df7-9cfa51071236}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD INTERNAL setState
VAR_INPUT
	state : INTERSECTION_LIGHTS_STATE;
	nextState : INTERSECTION_LIGHTS_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LightsState := state;
_NextState := nextState;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSwitchingSpeedCorrectionPercent" Id="{ce93f60b-ebdf-4524-8da1-82b6d19e82c7}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD SetSwitchingSpeedCorrectionPercent
VAR_INPUT
	correctionPercent : SPEED_CORRECTION_PERCENT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SwitchingSpeedCorrectionPercent := correctionPercent;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setTrafficLigtsColor" Id="{32bd3844-8f88-48f3-a224-ac959493d17c}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE setTrafficLigtsColor
VAR_IN_OUT CONSTANT
	trafficLights : ARRAY [*] OF ITrafficLight;
END_VAR
VAR_INPUT
	light : TRAFFIC_LIGHT_COLOR;
END_VAR
VAR
	i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(trafficLights, 1) TO UPPER_BOUND(trafficLights, 1) DO
	trafficLights[i].SetLight(light);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetYellowFlashingModeOff" Id="{a46b1b82-4335-41d5-8b6c-822f10afe1d7}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD SetYellowFlashingModeOff]]></Declaration>
      <Implementation>
        <ST><![CDATA[starMode(
	isOn := _IsOn,
	flashingYellowModeOn := FALSE
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="SetYellowFlashingModeOffButton" Id="{277109e0-167c-4f25-8caa-2f4a2c1254c7}" FolderPath="Subdevices\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SetYellowFlashingModeOffButton : TOF_Devices_IO.IDigitalInput]]></Declaration>
      <Get Name="Get" Id="{a4d0fca5-b801-417e-86fd-d6ab425535e8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SetYellowFlashingModeOffButton := _SetYellowFlashingModeOffButton;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetYellowFlashingModeOn" Id="{a8d74869-0985-48ce-8ed9-f193f84d16fd}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD SetYellowFlashingModeOn]]></Declaration>
      <Implementation>
        <ST><![CDATA[starMode(
	isOn := _IsOn,
	flashingYellowModeOn := TRUE
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="SetYellowFlashingModeOnButton" Id="{a4a71e1a-5dc0-41c8-b6e2-0a340d126fcd}" FolderPath="Subdevices\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SetYellowFlashingModeOnButton : TOF_Devices_IO.IDigitalInput]]></Declaration>
      <Get Name="Get" Id="{35f9ad22-fa01-46e2-a2ae-83a8496cef6a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SetYellowFlashingModeOnButton := _SetYellowFlashingModeOnButton;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SignalGroup1" Id="{4843127a-b5f8-4288-9d56-ada883c49d57}" FolderPath="Subdevices\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SignalGroup1 : REFERENCE TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF IReadOnlyTrafficLight]]></Declaration>
      <Get Name="Get" Id="{1a4eb1b3-0819-4585-b390-ed321667e91d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SignalGroup1 REF= _ReadOnlySignalGroup1^;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SignalGroup2" Id="{ecc07983-e080-4dca-9104-b4c59dd18f5a}" FolderPath="Subdevices\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SignalGroup2 : REFERENCE TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF IReadOnlyTrafficLight]]></Declaration>
      <Get Name="Get" Id="{8facf4b3-e9c7-4a51-887f-6cbb040d8e61}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SignalGroup2 REF= _ReadOnlySignalGroup2^;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="starMode" Id="{8ddb5609-6544-4dcc-b972-500abb23f0f5}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE starMode
VAR_INPUT
	isOn : BOOL;
	flashingYellowModeOn : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RedGreenLightTimer.Cancel();
_YellowLightTimer.Cancel();
_FlashingYellowLightTimer.Cancel();

_IsOn := isOn;
_FlashingYellowModeOn := flashingYellowModeOn;

CASE Mode OF
	INTERSECTION_MODE.OFF:
		_LightsState := INTERSECTION_LIGHTS_STATE.ALL_OFF;

	INTERSECTION_MODE.WORKING:
		startRedGreenLightTimer();
		_LightsState := INTERSECTION_LIGHTS_STATE.GROUP1_GREEN_GROUP2_RED;
	
	INTERSECTION_MODE.FLASHING_YELLOW:
		_LightsState := INTERSECTION_LIGHTS_STATE.ALL_YELLOW;
		startFlashingYellowLightTimer();
END_CASE

updateTraficLights();]]></ST>
      </Implementation>
    </Method>
    <Method Name="startFlashingYellowLightTimer" Id="{96309d45-677b-4977-9f1c-e21c0143efbb}" FolderPath="Service methods\Start timer\">
      <Declaration><![CDATA[METHOD PRIVATE startFlashingYellowLightTimer]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FlashingYellowLightTimer.Interval := calculateCorrectedInterval(IntersectionConstants.FLASHING_YELLOW_LIGHT_INTERVAL, _SwitchingSpeedCorrectionPercent);

_FlashingYellowLightTimer.Restart();]]></ST>
      </Implementation>
    </Method>
