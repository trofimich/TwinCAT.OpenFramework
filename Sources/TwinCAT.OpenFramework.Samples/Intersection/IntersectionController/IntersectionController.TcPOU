    <Property Name="AdjustSpeedButton" Id="{0e8de7ff-e0de-4178-bb7b-65c754591901}" FolderPath="Subdevices\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL AdjustSpeedButton : TOF_Devices_IO.IDigitalInput]]></Declaration>
      <Get Name="Get" Id="{dead62fc-07a9-4404-83ab-c23a9824c993}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AdjustSpeedButton := _AdjustSpeedButton;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="bindIO" Id="{1bc433ca-8d0e-4452-8e3c-75449de42a8a}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE bindIO]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResetButton.BindToIO(
	TerminalModels.DI_1.Ch1
);

_TurnOnButton.BindToIO(
	TerminalModels.DI_1.Ch2
);
TurnOffButton.BindToIO(
	TerminalModels.DI_1.Ch3
);

_SetYellowFlashingModeOnButton.BindToIO(
	TerminalModels.DI_1.Ch4
);
_SetYellowFlashingModeOffButton.BindToIO(
	TerminalModels.DI_1.Ch5
);

_AdjustSpeedButton.BindToIO(
	TerminalModels.DI_1.Ch6
);

_TrafficLight1.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Ch01,
	yellowLightRawValue := TerminalModels.DO_2.Ch02,
	greenLightRawValue 	:= TerminalModels.DO_2.Ch03	
);
_TrafficLight2.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Ch04,
	yellowLightRawValue := TerminalModels.DO_2.Ch05,
	greenLightRawValue 	:= TerminalModels.DO_2.Ch06	
);
_TrafficLight3.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Ch07,
	yellowLightRawValue := TerminalModels.DO_2.Ch08,
	greenLightRawValue 	:= TerminalModels.DO_2.Ch09	
);
_TrafficLight4.BindToIO(
	redLightRawValue 	:= TerminalModels.DO_2.Ch10,
	yellowLightRawValue := TerminalModels.DO_2.Ch11,
	greenLightRawValue 	:= TerminalModels.DO_2.Ch12	
);

_SwitchSpeedAdjuster.BindToInt16IO(TerminalModels.AI_3.Ch1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="calculateCorrectedInterval" Id="{51d751ca-80fc-4362-91e8-31296f350aff}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE calculateCorrectedInterval : TIME
VAR_INPUT
	originalInterval : TIME;
	correctionPercent : SPEED_CORRECTION_PERCENT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF correctionPercent = 0 THEN
	calculateCorrectedInterval := originalInterval;
ELSIF correctionPercent > 0 THEN
	calculateCorrectedInterval := originalInterval + TO_TIME(TO_INT(originalInterval) * correctionPercent / 100.0);
ELSE
	calculateCorrectedInterval := originalInterval - TO_TIME(TO_INT(originalInterval) * -correctionPercent / 100.0);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Children" Id="{edb09d7e-eaa4-4ee7-bf71-f499880b4098}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{90a76f6a-9caa-4ca6-88e8-931aff742de9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Devices;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{533645c9-51ab-4278-b915-2be070529db7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1aae8f98-7140-4915-9ec0-3cdf6e26caf7}">
