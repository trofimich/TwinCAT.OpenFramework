      </Get>
    </Property>
    <Method Name="setState" Id="{5c2f2c55-d0ba-4b8a-8df7-9cfa51071236}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD INTERNAL setState
VAR_INPUT
	state : INTERSECTION_STATE;
	nextState : INTERSECTION_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_State := state;
_NextState := nextState;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setTrafficLigtsColor" Id="{32bd3844-8f88-48f3-a224-ac959493d17c}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE setTrafficLigtsColor
VAR_IN_OUT CONSTANT
	frafficLights : ARRAY [*] OF ITrafficLight;
END_VAR
VAR_INPUT
	light : TRAFFIC_LIGHT_COLOR;
END_VAR
VAR
	i : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(frafficLights, 1) TO UPPER_BOUND(frafficLights, 1) DO
	frafficLights[i].SetLight(light);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="SignalGroup1" Id="{4843127a-b5f8-4288-9d56-ada883c49d57}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SignalGroup1 : REFERENCE TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF ITrafficLight]]></Declaration>
      <Get Name="Get" Id="{1a4eb1b3-0819-4585-b390-ed321667e91d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SignalGroup1 REF= _SignalGroup1;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SignalGroup2" Id="{ecc07983-e080-4dca-9104-b4c59dd18f5a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SignalGroup2 : REFERENCE TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF ITrafficLight]]></Declaration>
      <Get Name="Get" Id="{8facf4b3-e9c7-4a51-887f-6cbb040d8e61}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SignalGroup2 REF= _SignalGroup1;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="startBlinkingYellowMode" Id="{338031f0-6ea3-4eea-a4fb-410b4cc13072}" FolderPath="Service methods\Start mode\">
      <Declaration><![CDATA[METHOD PRIVATE startBlinkingYellowMode]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RedGreenLightTimer.Cancel();
_YellowLightTimer.Cancel();

startFlashingYellowLightTimer();

_Mode := INTERSECTION_MODE.BLINKING_YELLOW;
_State := INTERSECTION_STATE.ALL_YELLOW;

updateTraficLights();]]></ST>
      </Implementation>
    </Method>
    <Method Name="startFlashingYellowLightTimer" Id="{96309d45-677b-4977-9f1c-e21c0143efbb}" FolderPath="Service methods\Start timer\">
      <Declaration><![CDATA[METHOD PRIVATE startFlashingYellowLightTimer]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FlashingYellowLightTimer.Interval := calculateCorrectedInterval(IntersectionConstants.FLASHING_YELLOW_LIGHT_INTERVAL, TO_SINT(IntersectionConstants.SWITCH_SPEED_FACTOR * _SwitchSpeedAdjuster.Value));

_FlashingYellowLightTimer.Restart();]]></ST>
      </Implementation>
    </Method>
    <Method Name="startIdelingMode" Id="{8ddb5609-6544-4dcc-b972-500abb23f0f5}" FolderPath="Service methods\Start mode\">
      <Declaration><![CDATA[METHOD startIdelingMode]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RedGreenLightTimer.Cancel();
_YellowLightTimer.Cancel();
_FlashingYellowLightTimer.Cancel();

_Mode := INTERSECTION_MODE.IDELING;
_State := INTERSECTION_STATE.ALL_OFF;

updateTraficLights();]]></ST>
      </Implementation>
    </Method>
    <Method Name="startMode" Id="{7a7d5ebb-876c-475e-adf9-9517420ae539}" FolderPath="Service methods\Start mode\">
      <Declaration><![CDATA[METHOD PRIVATE startMode]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _WorkingModeSwitch.Value THEN
	startIdelingMode();
ELSE
	IF _BlinkingYellowModeSwitch.Value THEN
		startBlinkingYellowMode();
	ELSE
		startNormalMode();
	END_IF	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="startNormalMode" Id="{bfa9afc6-d6b0-4dbc-b2b3-10d6e8a939c6}" FolderPath="Service methods\Start mode\">
      <Declaration><![CDATA[METHOD startNormalMode]]></Declaration>
      <Implementation>
        <ST><![CDATA[startRedGreenLightTimer();

_YellowLightTimer.Cancel();
_FlashingYellowLightTimer.Cancel();

_Mode := INTERSECTION_MODE.NORMAL;
_State := INTERSECTION_STATE.GROUP1_GREEN_GROUP2_RED;

updateTraficLights();]]></ST>
      </Implementation>
    </Method>
    <Method Name="startRedGreenLightTimer" Id="{50f36714-64fe-4212-afb9-2e8a39734cfd}" FolderPath="Service methods\Start timer\">
      <Declaration><![CDATA[METHOD PRIVATE startRedGreenLightTimer]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RedGreenLightTimer.Interval := calculateCorrectedInterval(IntersectionConstants.RED_GREEN_LIGHT_INTERVAL, TO_SINT(IntersectionConstants.SWITCH_SPEED_FACTOR * _SwitchSpeedAdjuster.Value));

_RedGreenLightTimer.Restart();]]></ST>
      </Implementation>
    </Method>
    <Method Name="startYellowLightTimer" Id="{75f70f4d-af10-457d-91be-f1022c3b5646}" FolderPath="Service methods\Start timer\">
      <Declaration><![CDATA[METHOD PRIVATE startYellowLightTimer]]></Declaration>
      <Implementation>
        <ST><![CDATA[_YellowLightTimer.Interval := calculateCorrectedInterval(IntersectionConstants.YELLOW_LIGHT_INTERVAL, TO_SINT(IntersectionConstants.SWITCH_SPEED_FACTOR * _SwitchSpeedAdjuster.Value));

_YellowLightTimer.Restart();]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{0d41ded4-f538-4005-aa70-f221d58f38a5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL State : INTERSECTION_STATE]]></Declaration>
      <Get Name="Get" Id="{7519eabe-1cc3-4af8-82b3-a2f8425fe098}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[State := _State;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SwitchSpeedAdjuster" Id="{06dddc90-cb5c-4f31-9411-86ecae41141b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL SwitchSpeedAdjuster : TOF_Devices_IO.IAnalogInput]]></Declaration>
      <Get Name="Get" Id="{af2782fd-129d-48e7-9c55-29dba0d016f0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SwitchSpeedAdjuster := _SwitchSpeedAdjuster;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TrafficLights" Id="{1eb64023-b212-4c31-8a8b-6a8402e94081}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL TrafficLights : REFERENCE TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP * 2] OF ITrafficLight]]></Declaration>
      <Get Name="Get" Id="{d43f39e5-1277-4211-984b-d6561c34e197}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[TrafficLights REF= _TrafficLights;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="updateTraficLights" Id="{f60cca55-65f4-4222-8c1f-0c67e0a9c589}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE updateTraficLights]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE _State OF
	INTERSECTION_STATE.ALL_OFF:
		setTrafficLigtsColor(_TrafficLights, TRAFFIC_LIGHT_COLOR.NO_COLOR);
	
	INTERSECTION_STATE.ALL_YELLOW:
		setTrafficLigtsColor(_TrafficLights, TRAFFIC_LIGHT_COLOR.YELLOW);
	
	INTERSECTION_STATE.GROUP1_GREEN_GROUP2_RED:
		setTrafficLigtsColor(_SignalGroup1, TRAFFIC_LIGHT_COLOR.GREEN);
		setTrafficLigtsColor(_SignalGroup2, TRAFFIC_LIGHT_COLOR.RED);
	
	INTERSECTION_STATE.GROUP1_RED_GROUP2_GREEN:
		setTrafficLigtsColor(_SignalGroup1, TRAFFIC_LIGHT_COLOR.RED);
		setTrafficLigtsColor(_SignalGroup2, TRAFFIC_LIGHT_COLOR.GREEN);
END_CASE]]></ST>
      </Implementation>
    </Method>
