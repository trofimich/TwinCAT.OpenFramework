{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK IntersectionController EXTENDS TOF_Automation.AutomationController<7>
VAR	
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_Mode : INTERSECTION_MODE;
	{attribute 'hide'} 
	_State : INTERSECTION_STATE;
	{attribute 'hide'} 
	_NextState : INTERSECTION_STATE;
	
	{region "Device instances"}
	
	{attribute 'hide'} 
	_WorkingModeSwitch : TOF_Devices_IO.DigitalInput("WorkingModeSwitch", THIS^);
	
	{attribute 'hide'} 
	_BlinkingYellowModeSwitch : TOF_Devices_IO.DigitalInput("BlinkingYellowModeSwitch", THIS^);
	
	{attribute 'hide'} 
	_SpeedAdjusterConverter : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := -20,
		maxAnalogValue := +20,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(TOF_Core.SignedInt16.MIN_VALUE),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(TOF_Core.SignedInt16.MAX_VALUE)
	);
	{attribute 'hide'} 
	_SwitchSpeedAdjuster : TOF_Devices_IO.AnalogInput("SwitchSpeedAdjuster", THIS^, _SpeedAdjusterConverter);
	
	{attribute 'hide'} 
	_TrafficLight1 : TrafficLight("TrafficLight1", THIS^);
	{attribute 'hide'} 
	_TrafficLight2 : TrafficLight("TrafficLight2", THIS^);
	{attribute 'hide'} 
	_TrafficLight3 : TrafficLight("TrafficLight3", THIS^);
	{attribute 'hide'} 
	_TrafficLight4 : TrafficLight("TrafficLight4", THIS^);
	
 	{endregion} 	

	{region "Device related collections"}

	{attribute 'hide'} 
	_Devices : ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent := 
	[
		_WorkingModeSwitch, 
		_BlinkingYellowModeSwitch, 
		_SwitchSpeedAdjuster, 
		_TrafficLight1, 
		_TrafficLight2, 
		_TrafficLight3, 
		_TrafficLight4
	];

	{attribute 'hide'} 
	_TrafficLights : ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP * 2] OF ITrafficLight :=
	[
		_TrafficLight1, 
		_TrafficLight2, 
		_TrafficLight3,		
		_TrafficLight4		
	];
	
	{attribute 'hide'} 
	_SignalGroup1 : ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF ITrafficLight :=
	[
		_TrafficLight1, 
		_TrafficLight3		
	];
	
	{attribute 'hide'} 
	_SignalGroup2 : ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF ITrafficLight :=
	[
		_TrafficLight2, 
		_TrafficLight4		
	];
	
 	{endregion} 	
	
	{region "Timers"}
	
	_RedGreenLightTimer : TOF_Timers.Timer;
	_YellowLightTimer : TOF_Timers.Timer;

	_FlashingYellowLightTimer : TOF_Timers.Timer;
	
	{endregion}
END_VAR
VAR_INPUT
	ThrowTestExceptionRequest : BOOL;
	IsTestExceptionCritical : BOOL;
	TestExceptionMessage : STRING := 'Test error message';

	ResetRequest : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
