    <Property Name="NextState" Id="{74da6e54-f63b-42c5-9611-7719f4839f3d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL NextState : INTERSECTION_STATE]]></Declaration>
      <Get Name="Get" Id="{234ef350-20ca-4de9-8f19-1c73cd4395de}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NextState := _NextState;]]></ST>
