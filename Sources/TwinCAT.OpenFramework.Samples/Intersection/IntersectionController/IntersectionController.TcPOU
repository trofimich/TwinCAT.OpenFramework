{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK IntersectionController EXTENDS TOF_Automation.AutomationController<12> IMPLEMENTS IIntersectionController
VAR	
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_IsOn : BOOL;
	{attribute 'hide'} 
	_FlashingYellowModeOn : BOOL;
	{attribute 'hide'} 
	_SwitchingSpeedCorrectionPercent : SPEED_CORRECTION_PERCENT;
	
	{attribute 'hide'} 
	_LightsState : INTERSECTION_LIGHTS_STATE;
	{attribute 'hide'} 
	_NextState : INTERSECTION_LIGHTS_STATE;
	
	{region "Device instances"}

	_ResetButton : TOF_Devices_IO.DigitalInput("ResetButton", THIS^);
	
	_TurnOnButton : TOF_Devices_IO.DigitalInput("TurnOnButton", THIS^);
	_TurnOffButton : TOF_Devices_IO.DigitalInput("TurnOffButton", THIS^);
	
	_SetYellowFlashingModeOnButton : TOF_Devices_IO.DigitalInput("SetYellowFlashingModeOnButton", THIS^);
	_SetYellowFlashingModeOffButton : TOF_Devices_IO.DigitalInput("SetYellowFlashingModeOffButton", THIS^);
	
	_AdjustSpeedButton : TOF_Devices_IO.DigitalInput("AdjustSpeedButton", THIS^);
	_SpeedAdjusterConverter : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := -20,
		maxAnalogValue := +20,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(TOF_Core.SignedInt16.MIN_VALUE),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(TOF_Core.SignedInt16.MAX_VALUE)
	);
	_SwitchSpeedAdjuster : TOF_Devices_IO.AnalogInput("SwitchSpeedAdjuster", THIS^, _SpeedAdjusterConverter);
	
	_TrafficLight1 : TrafficLight("TrafficLight1", THIS^);
	_TrafficLight2 : TrafficLight("TrafficLight2", THIS^);
	_TrafficLight3 : TrafficLight("TrafficLight3", THIS^);
	_TrafficLight4 : TrafficLight("TrafficLight4", THIS^);
	
	_DemoExceptionGenerator : DemoExceptionGenerator("WatchdogDevice", THIS^);
	
 	{endregion} 	

	{region "Device related collections"}

	{attribute 'hide'} 
	_Devices : ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent := 
	[
		_ResetButton,
		_TurnOnButton, 
		_TurnOffButton, 
		_SetYellowFlashingModeOnButton, 
		_SetYellowFlashingModeOffButton,
		_AdjustSpeedButton, 
		_SwitchSpeedAdjuster, 
		_TrafficLight1, 
		_TrafficLight2, 
		_TrafficLight3, 
		_TrafficLight4,
		_DemoExceptionGenerator
	];

	{attribute 'hide'} 
	_TrafficLights : ARRAY [1..IntersectionConstants.TOTAL_TRAFFIC_LIGHTS] OF ITrafficLight :=
	[
		_TrafficLight1, 
		_TrafficLight2, 
		_TrafficLight3,		
		_TrafficLight4		
	];
	{attribute 'hide'} 
	_ReadOnlyTrafficLights : POINTER TO ARRAY [1..IntersectionConstants.TOTAL_TRAFFIC_LIGHTS] OF IReadOnlyTrafficLight := ADR(_TrafficLights);
	
	{attribute 'hide'} 
	_SignalGroup1 : ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF ITrafficLight :=
	[
		_TrafficLight1, 
		_TrafficLight3		
	];
	{attribute 'hide'} 
	_ReadOnlySignalGroup1 : POINTER TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF IReadOnlyTrafficLight := ADR(_SignalGroup1);
	
	{attribute 'hide'} 
	_SignalGroup2 : ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF ITrafficLight :=
	[
		_TrafficLight2, 
		_TrafficLight4		
	];
	{attribute 'hide'} 
	_ReadOnlySignalGroup2 : POINTER TO ARRAY [1..IntersectionConstants.TRAFFIC_LIGHTS_PER_GROUP] OF IReadOnlyTrafficLight := ADR(_SignalGroup2);
	
 	{endregion} 	
	
	{region "Timers"}
	
	_RedGreenLightTimer : TOF_Timers.Timer;
	_YellowLightTimer : TOF_Timers.Timer;

	_FlashingYellowLightTimer : TOF_Timers.Timer;
	
	{endregion}
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{f2e82d7a-5ab5-47e6-a7c7-dc6438a69b54}" />
