<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DemoExceptionGenerator" Id="{45653e5b-ddb2-4268-a8bb-8203bd23d851}" SpecialFunc="None">
    <Declaration><![CDATA[(*

