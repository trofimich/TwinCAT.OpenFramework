<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DemoException" Id="{adc8ba1f-b7dc-4ef4-bc68-4f768efa6feb}" SpecialFunc="None">
    <Declaration><![CDATA[(*

