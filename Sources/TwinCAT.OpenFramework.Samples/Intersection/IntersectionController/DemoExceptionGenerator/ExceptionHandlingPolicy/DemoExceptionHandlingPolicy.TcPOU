<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DemoExceptionHandlingPolicy" Id="{c8288e63-0e66-4103-9ccf-5f7fe2e64839}" SpecialFunc="None">
    <Declaration><![CDATA[(*

