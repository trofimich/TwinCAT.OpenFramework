<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TrafficLight" Id="{4a48deea-1b31-43e8-87e2-aa154a1466e2}" SpecialFunc="None">
    <Declaration><![CDATA[(*

.. <legal notes>

