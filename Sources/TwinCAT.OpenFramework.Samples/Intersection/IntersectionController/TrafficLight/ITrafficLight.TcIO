<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITrafficLight" Id="{2f0f4da8-a058-43dd-a919-c00ac07d2563}">
    <Declaration><![CDATA[(*!
<summary>Demonstrates permission-controlled selection of traffic-light outputs. TrySetLight reports rejection or exceptions without propagating them.</summary>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

INTERFACE ITrafficLight EXTENDS IReadOnlyTrafficLight]]></Declaration>
    <Folder Name="Commands" Id="{f66c5f33-e3fd-4d1b-9fb3-80f691b86f53}" />
    <Method Name="TrySetLight" Id="{5ef16d35-bb6d-4350-a1ef-fe103adb21fd}" FolderPath="Commands\">
      <Declaration><![CDATA[(*!
<summary>Requests permission and attempts to select the traffic-light outputs.</summary>
<description>Returns FALSE on rejection or a caught exception. Exceptions do not escape to the caller. Already changed outputs are not rolled back; FALSE is not proof that all outputs are unchanged. A caught exception sets a fixed rejection reason without allocating diagnostic objects.</description>
*)
METHOD TrySetLight : BOOL
VAR_INPUT
	color : TRAFFIC_LIGHT_COLOR;
END_VAR
VAR_IN_OUT
	rejectReason : WSTRING(255);
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>