(*!
<summary>Owns the discrete and standard INT16 analog process-image endpoints used by the intersection sample.</summary>
<description>
Link each channel to the corresponding EL1018/EL2409/EL3001 PDO in XAE before hardware operation.
AI_3 requires the standard status-plus-INT16 PDO; compact input PDOs are unsupported.
This sample uses basic models without bus diagnostics; commissioning must establish the mapping and bus validity.
For explicit WcState/channel-status handling see IOModelsExample in HowTo. The program body performs no work.
Use one owner task for the intersection; externally synchronize other access. Copies do not create I/O links.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM TerminalModels
VAR
	_ClassName : STRING := __POUNAME();
END_VAR
VAR_OUTPUT
	DI_1 : TOF_IOModels.EL1018;
	DO_2 : TOF_IOModels.EL2409;
	AI_3 : TOF_IOModels.EL3001;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{55ef0c9f-269d-4d28-9a5f-326c413d24c7}">
      <Declaration><![CDATA[//! <summary>Borrows the program-owned name; callers must not modify it.</summary>
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7db7bcc1-613a-411c-899a-70385bc02d5b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[ClassName REF= _ClassName;]]></ST></Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{6b43d063-73d2-467c-ab82-a410001d96b7}">
      <Declaration><![CDATA[//! <summary>Borrows project namespace storage for the program lifetime; callers must not modify it.</summary>
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d4eb0f0f-e02a-4059-a8c6-fe28f9c86c98}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST></Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
