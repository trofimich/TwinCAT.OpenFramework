(*!
<summary>Runs the intersection and workflow samples through the automation runner.</summary>
<description>Installs the sample log filter once before the first runner call, using local initialization state independent of the system task cycle counter.</description>
*)

PROGRAM MAIN
VAR_OUTPUT
	IntersectionHMI : HmiIntersectionController;
END_VAR
VAR
	{attribute 'hide'} 
	_IntersectionPlugings : ARRAY [0..0] OF TOF_Automation.IAutomationControllerPlugin := [IntersectionHMI];
END_VAR
VAR_OUTPUT	
	IntersectionController : IntersectionController("IntersectionController", _IntersectionPlugings);	
	DemoWorkflowController : DemoWorkflowController("DemoWorkflowController");
	
	Runner : TOF_Automation.AutomationRunner;
END_VAR
VAR
	{attribute 'hide'} 
	_AutomationControllers : ARRAY [0..1] OF TOF_Automation.IAutomationComponent := 
	[
		IntersectionController,
		DemoWorkflowController
	];
	
	{attribute 'hide'} 
	_LogFilter : LogFilter;
	{attribute 'hide'}
	_LogFilterInitialized : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT _LogFilterInitialized THEN
	TOF_Core.LogManager.Filter := _LogFilter;
	_LogFilterInitialized := TRUE;
END_IF

Runner.Execute(_AutomationControllers);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
