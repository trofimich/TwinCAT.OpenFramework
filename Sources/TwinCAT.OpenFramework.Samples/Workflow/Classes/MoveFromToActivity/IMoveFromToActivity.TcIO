(*!
<summary>Sample activity that steps integer X/Y workflow coordinates toward a configured target position.</summary>
*)

INTERFACE IMoveFromToActivity EXTENDS TOF_Workflow.IActivity]]></Declaration>
    <Method Name="Configure" Id="{9ccb4e38-b843-4113-be0f-07863100f907}">
      <Declaration><![CDATA[(*!
<summary>Sets the target integer X and Y coordinates for the activity.</summary>
<param name="toXPosition">Target X coordinate.</param>
<param name="toYPosition">Target Y coordinate.</param>
*)
METHOD Configure
VAR_INPUT
	toXPosition : INT;
	toYPosition : INT;
END_VAR]]></Declaration>
    </Method>
    <Property Name="ToXPosition" Id="{d3e4c418-01c0-47cc-b47b-821dd0aa71e2}">
      <Declaration><![CDATA[(*!
<summary>Gets the configured target X coordinate.</summary>
*)
PROPERTY ToXPosition : INT]]></Declaration>
      <Get Name="Get" Id="{74ee6da6-c00d-44c9-9df5-bd2e40818b9c}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="ToYPosition" Id="{baed957d-7c8f-4ff8-b1ad-7e58ade5f9f2}">
      <Declaration><![CDATA[(*!
<summary>Gets the configured target Y coordinate.</summary>
*)
PROPERTY ToYPosition : INT]]></Declaration>
      <Get Name="Get" Id="{c4522abe-ac13-455c-ae27-fc2a0a5c360e}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>
