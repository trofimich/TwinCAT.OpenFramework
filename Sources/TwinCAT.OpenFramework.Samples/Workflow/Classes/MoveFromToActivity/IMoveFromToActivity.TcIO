<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IMoveFromToActivity" Id="{940fad79-65b4-4386-97b6-a2766a37107e}">
    <Declaration><![CDATA[(*
