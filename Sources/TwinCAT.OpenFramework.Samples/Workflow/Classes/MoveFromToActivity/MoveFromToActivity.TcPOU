(*!
<summary>Sample activity that steps integer XPosition and YPosition workflow variables toward configured coordinates.</summary>
<description>
Advances each coordinate by one unit per timer interval until both reach ToXPosition and ToYPosition.
Supports suspension with remaining-time preservation, cancellation, resetting and failure timer cleanup.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK MoveFromToActivity EXTENDS TOF_Workflow.Activity IMPLEMENTS IMoveFromToActivity
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_ToXPosition : INT;
	_ToYPosition : INT;
	
	_PositionChangeTimer : TOF_Timers.Timer("PositionChangeTimer");
	//! <summary>Time left before the next position step, captured when suspension begins.</summary>
	_RemainingPositionChangeTime : TIME;
END_VAR
VAR CONSTANT
	//! <summary>Delay before the first position step and between subsequent steps; suspended time is excluded.</summary>
	POSITION_CHANGE_TIMER_INTERVAL : TIME := T#10MS;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{7fdac448-b90e-4952-a44c-a57d67c7342e}" />
    <Property Name="ClassName" Id="{a66a843c-b1e9-49fb-b1bd-eb30c1a59478}">
      <Declaration><![CDATA[(*!
<summary>Gets the runtime class name of this object.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{684d0e63-ba64-4197-8549-110764775012}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{eac7bd11-88b0-437c-b3da-fdca548034fb}">
      <Declaration><![CDATA[(*!
<summary>Sets the target integer X and Y coordinates for the activity.</summary>
<param name="toXPosition">Target X coordinate.</param>
<param name="toYPosition">Target Y coordinate.</param>
*)
METHOD Configure
VAR_INPUT
	toXPosition : INT;
	toYPosition : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ToXPosition := toXPosition;
_ToYPosition := toYPosition;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{e00b0c07-e227-4744-b352-43bc3b73d1fd}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace name of this object.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a0c0e8db-f447-4081-a52b-0b41216a5713}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnFail" Id="{b64d892c-3e19-4c87-a520-8f4e2a9c1b73}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Stops the position-change timer and clears saved remaining time when the activity fails.</summary>
<param name="exception">Exception that caused the failure.</param>
*)
METHOD PROTECTED OnFail
VAR_INPUT
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RemainingPositionChangeTime := TOF_Core.Times.MIN_VALUE;

IF _PositionChangeTimer.State.Running THEN
	_PositionChangeTimer.Cancel();
	_PositionChangeTimer.Execute();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnResetting" Id="{c71e49a8-5b20-4f31-9d40-2a6b8e1c5f92}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Stops the position-change timer and clears saved remaining time during resetting.</summary>
<param name="startResetting">TRUE on the initial RequestReset call; FALSE on subsequent Execute cycles.</param>
*)
METHOD PROTECTED OnResetting : TOF_Workflow.ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RemainingPositionChangeTime := TOF_Core.Times.MIN_VALUE;

IF _PositionChangeTimer.State.Running THEN
	_PositionChangeTimer.Cancel();
	_PositionChangeTimer.Execute();
END_IF

IF NOT _PositionChangeTimer.State.Running THEN
	OnResetting := TOF_Workflow.ACTIVITY_RESETTING_STATE.WORK_RESET;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{531b20aa-04ec-447d-8df6-e631e6e7a6ba}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Moves each coordinate by one unit after each position-change interval.</summary>
<description>
A fresh run restarts the timer with the full interval; resuming restarts it with the remaining time
captured by OnStopping, excluding suspended time. After a resumed step, subsequent steps use the full
interval again. An elapsed interval advances at most one step per call; missed intervals are not replayed.
A refused timer restart returns WORK_HALTED with a diagnostic, preserving any coordinate changes already
made. Variable lookup and conversion exceptions propagate to the activity's failure handling.
The activity owner drives these callbacks sequentially; they do not drive the activity recursively.
</description>
<param name="startRunning">Begins a fresh run, including reuse after an earlier run.</param>
<param name="startResuming">Resumes the remaining interval saved during suspension.</param>
<param name="haltReason">Describes a refused timer restart when WORK_HALTED is returned.</param>
*)
METHOD PROTECTED OnRunning : TOF_Workflow.ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
	xPosition : TOF_Core.GENERIC_VALUE;
	yPosition : TOF_Core.GENERIC_VALUE;

	currentXPosition : INT;
	currentYPosition : INT;
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF startRunning THEN
	IF NOT _PositionChangeTimer.SetIntervalAndRestart(POSITION_CHANGE_TIMER_INTERVAL) THEN
		haltReason := "Could not start the position-change timer";
		OnRunning := TOF_Workflow.ACTIVITY_RUNNING_STATE.WORK_HALTED;
	END_IF
ELSIF startResuming THEN
	IF NOT _PositionChangeTimer.SetIntervalAndRestart(_RemainingPositionChangeTime) THEN
		haltReason := "Could not resume the position-change timer";
		OnRunning := TOF_Workflow.ACTIVITY_RUNNING_STATE.WORK_HALTED;
	END_IF
ELSE
	_PositionChangeTimer.Execute();

	IF _PositionChangeTimer.Elapsed THEN
		IF NOT TryGetVariable('XPosition', variable => xPosition) THEN
			TOF_Workflow.WorkflowExceptions.ThrowWorkflowVariableNotFound(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Variable 'XPosition' was not found");
		END_IF
		
		IF NOT TryGetVariable('YPosition', variable => yPosition) THEN
			TOF_Workflow.WorkflowExceptions.ThrowWorkflowVariableNotFound(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Variable 'YPosition' was not found");			
		END_IF
		
		currentXPosition := xPosition.AsInt();
		currentYPosition := yPosition.AsInt();
		
		IF currentXPosition <> _ToXPosition THEN
			IF currentXPosition < _ToXPosition THEN
				currentXPosition := currentXPosition + 1;
			ELSE
				currentXPosition := currentXPosition - 1;
			END_IF
			
			xPosition.ChangeValueByAny(currentXPosition);
		END_IF
		
		IF currentYPosition <> _ToYPosition THEN
			IF currentYPosition < _ToYPosition THEN
				currentYPosition := currentYPosition + 1;
			ELSE
				currentYPosition := currentYPosition - 1;
			END_IF
			
			yPosition.ChangeValueByAny(currentYPosition);
		END_IF
		
		IF currentXPosition <> _ToXPosition OR_ELSE currentYPosition <> _ToYPosition THEN
			IF NOT _PositionChangeTimer.SetIntervalAndRestart(POSITION_CHANGE_TIMER_INTERVAL) THEN
				haltReason := "Could not restart the position-change timer";
				OnRunning := TOF_Workflow.ACTIVITY_RUNNING_STATE.WORK_HALTED;
			END_IF
		ELSE		
			OnRunning := TOF_Workflow.ACTIVITY_RUNNING_STATE.WORK_COMPLETED;
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{9d74ecb1-a096-400b-ae1c-aa5003999773}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Stops the position-change timer and preserves the remaining interval on suspension.</summary>
<description>
On the first suspension call, updates the timer and saves its remaining interval before cancellation.
If the interval has elapsed, saves zero so the first Execute after resume can perform the pending step.
No coordinates change here. Cancels an active timer and advances stopping; WORK_STOPPED is returned
only after it is no longer running. Further stopping calls preserve the saved remaining time.
Exceptions propagate to the activity's failure handling; captured time and timer effects are not rolled back.
</description>
<param name="startCancelling">Marks the initial cancellation request; cancellation does not save a resume interval.</param>
<param name="startSuspending">Marks the initial suspension request and captures the remaining interval once.</param>
<param name="haltReason">No halt diagnostic is produced by ordinary timer stopping.</param>
*)
METHOD PROTECTED OnStopping : TOF_Workflow.ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF startSuspending THEN
	_PositionChangeTimer.Execute();

	IF _PositionChangeTimer.ElapsedTime < _PositionChangeTimer.Interval THEN
		_RemainingPositionChangeTime := _PositionChangeTimer.Interval - _PositionChangeTimer.ElapsedTime;
	ELSE
		_RemainingPositionChangeTime := TOF_Core.Times.MIN_VALUE;
	END_IF
END_IF

IF _PositionChangeTimer.State.Running THEN
	_PositionChangeTimer.Cancel();
	_PositionChangeTimer.Execute();
END_IF

IF NOT _PositionChangeTimer.State.Running THEN
	OnStopping := TOF_Workflow.ACTIVITY_STOPPING_STATE.WORK_STOPPED;
END_IF]]></ST>
      </Implementation>
    </Method>
