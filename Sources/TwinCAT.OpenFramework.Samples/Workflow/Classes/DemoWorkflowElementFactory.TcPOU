<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DemoWorkflowElementFactory" Id="{d3fd8960-8e91-482a-9784-bb9c5a4922c2}">
    <Declaration><![CDATA[(*
