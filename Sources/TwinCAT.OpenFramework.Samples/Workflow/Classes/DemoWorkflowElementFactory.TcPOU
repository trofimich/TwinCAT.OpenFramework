(*!
<summary>Supplies application-specific workflow elements for the movement sample.</summary>
<description>All returned nodes use the requested workflow association.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DemoWorkflowElementFactory IMPLEMENTS TOF_Workflow.IWorkflowElementFactory]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CreateElement" Id="{f8d92414-91f7-4e19-8d1c-7de659c003ff}">
      <Declaration><![CDATA[(*!
<summary>Creates the sample movement activity for its qualified PLC name.</summary>
<description>Returns zero for other names. Transfers the new instance to the common registration path.
A failed allocation raises terminal OOM.</description>
<param name="typeName">Requested qualified name.</param>
<param name="workflow">Prospective workflow owner.</param>
*)
METHOD CreateElement : TOF_Workflow.IWorkflowElement
VAR_INPUT
	typeName : STRING(255);
	workflow : TOF_Workflow.IWorkflow;
END_VAR
VAR
	createdActivity : POINTER TO MoveFromToActivity;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF typeName <> TOF_Core.Strings.Concat255(CurrentNamespace.Name, '.MoveFromToActivity') THEN
	RETURN;
END_IF

createdActivity := __NEW(MoveFromToActivity(workflow := workflow));

IF createdActivity = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

CreateElement := createdActivity^;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
