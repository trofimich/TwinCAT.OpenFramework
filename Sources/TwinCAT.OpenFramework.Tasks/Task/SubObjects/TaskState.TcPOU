<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskState" Id="{29e45909-ad82-4112-87e1-9792e16e3a41}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: Â© 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
