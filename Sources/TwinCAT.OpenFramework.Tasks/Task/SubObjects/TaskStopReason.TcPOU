<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskStopReason" Id="{7d87c05a-fcfb-432e-850f-e02324aa4eaa}" SpecialFunc="None">
    <Declaration><![CDATA[(*
