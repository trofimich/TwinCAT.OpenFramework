(*!
<summary>Exposes a task's live stop reason and diagnostic message.</summary>
<description>
Borrows live backing variables supplied at initialization or rebound after online change. Getters safely guard
against unbound references and return default values if references are not valid. Treat the view and returned
references as read-only. Copy values when a snapshot is required.
</description>
*)

FUNCTION_BLOCK FINAL TaskStopReason
VAR
	{attribute 'hide'} 
	_StopReason : REFERENCE TO TASK_STOP_REASON;
	{attribute 'hide'} 
	_StopReasonMessage : REFERENCE TO TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{640d0762-9bf0-4131-882f-dcb46e69365c}" />
    <Property Name="ExternalCancel" Id="{d65436ff-6214-4d46-9752-1b7fe17ac652}">
      <Declaration><![CDATA[(*!
<summary>Reports an external cancellation reason.</summary>
<description>
For a final result, inspect only after the task reaches STOPPED. Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ExternalCancel : BOOL
]]></Declaration>
      <Get Name="Get" Id="{7f13fe79-d3bc-4bc8-b4d0-6ac92e5863ec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_StopReason) THEN
	ExternalCancel := _StopReason = TASK_STOP_REASON.EXTERNAL_CANCEL;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Failure" Id="{d6062a9c-f01f-4565-bc38-70f8d2de96fa}">
      <Declaration><![CDATA[(*!
<summary>Reports a failure reason.</summary>
<description>
Original and final reasons can differ when resource release fails. Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Failure : BOOL
]]></Declaration>
      <Get Name="Get" Id="{d068f895-ce50-4ef3-9400-cfe95cba193f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_StopReason) THEN
	Failure := _StopReason = TASK_STOP_REASON.FAILURE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{9b4ff5ec-60f2-4a46-b40a-f94ddf37dfdb}">
      <Declaration><![CDATA[(*!
<summary>Binds the view to its owner's live state.</summary>
<description>
Stores references without copying their current values or changing the owner. Valid supplied references are
bound; skipped during online change copy code. Does not allocate or raise framework exceptions.
</description>
<param name="stopReason">Live original or final reason owned by the task.</param>
<param name="stopReasonMessage">Live message paired with that reason.</param>
*)
METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	stopReason : REFERENCE TO TASK_STOP_REASON;
	stopReasonMessage : REFERENCE TO TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	Rebind(
		stopReason := stopReason,
		stopReasonMessage := ADR(stopReasonMessage)
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="InternalAbort" Id="{83d53d2e-69b8-477b-a831-f35aca5a62a2}">
      <Declaration><![CDATA[(*!
<summary>Reports an internal abort reason.</summary>
<description>
An internal abort comes from ABORTED processing rather than an accepted external Cancel. Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL InternalAbort : BOOL
]]></Declaration>
      <Get Name="Get" Id="{92ffbc6f-df3a-4e34-a23c-cf718d105a5c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_StopReason) THEN
	InternalAbort := _StopReason = TASK_STOP_REASON.INTERNAL_ABORT;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Message" Id="{c3e5d188-2060-484b-b1ea-89681b3d29ed}">
      <Declaration><![CDATA[(*!
<summary>Borrows the diagnostic message paired with this reason.</summary>
<description>
Read-only live reference; do not write through it or retain it beyond the backing owner's lifetime. Copy the
text before Reset or reuse if needed.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Message : REFERENCE TO TOF_Core.ERROR_MESSAGE]]></Declaration>
      <Get Name="Get" Id="{6e0f0ef3-6037-4993-90fa-17ec1e266163}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_StopReasonMessage) THEN
	Message REF= _StopReasonMessage;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Rebind" Id="{6005371b-076e-4f41-89ae-b484140aadfa}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Rebinds the view to its owner's live stop reason and message variables.</summary>
<description>
Updates internal references when valid variables are supplied. Used during initialization and
subsequent online-change reinitialization.
</description>
<param name="stopReason">Live original or final reason owned by the task.</param>
<param name="stopReasonMessage">Live message paired with that reason.</param>
*)
METHOD INTERNAL Rebind
VAR_INPUT
	stopReason : REFERENCE TO TASK_STOP_REASON;
	stopReasonMessage : POINTER TO TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StopReason REF= stopReason;
_StopReasonMessage REF= stopReasonMessage^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Value" Id="{bf66afab-3314-4fc2-84c5-0c928fe81af1}">
      <Declaration><![CDATA[(*!
<summary>Returns the current stop reason by value.</summary>
<description>
WORK_DONE is also the initialization/reset default, so a final result is meaningful only after STOPPED.
Returns WORK_DONE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Value : TASK_STOP_REASON
]]></Declaration>
      <Get Name="Get" Id="{47e63340-a1b6-40b3-a584-a27092139917}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_StopReason) THEN
	Value := _StopReason;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="WorkDone" Id="{18bd0391-61a5-49dd-99aa-bdb1161d008c}">
      <Declaration><![CDATA[(*!
<summary>Reports the WORK_DONE reason.</summary>
<description>
Does not prove completion on its own: WORK_DONE is also the initial/reset value. Combine final-result checks
with State.Stopped. Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL WorkDone : BOOL
]]></Declaration>
      <Get Name="Get" Id="{78980f47-9ff5-4e3f-aeec-12296145f136}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_StopReason) THEN
	WorkDone := _StopReason = TASK_STOP_REASON.WORK_DONE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>