<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskRunningSubstate" Id="{33bf852e-0c60-47d9-bc3f-417ab0b1c31c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes a task's acquisition, processing or release phase.</summary>
<description>
Borrows live backing variables supplied at initialization. They must remain valid for the entire view
lifetime; getters do not check for unbound references. Treat the view and returned references as read-only.
Copy values when a snapshot is required.
</description>
*)
FUNCTION_BLOCK TaskRunningSubstate
VAR
	{attribute 'hide'} 
	_TaskRunningSubstate : REFERENCE TO TASK_RUNNING_SUBSTATE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{34e692c4-9474-4331-a86c-cedfa2730f0a}">
      <Declaration><![CDATA[(*!
<summary>Binds the view to its owner's live state.</summary>
<description>
Stores references without copying their current values or changing the owner. All supplied references must
be valid and outlive the view. Does not allocate or raise framework exceptions.
</description>
<param name="bInitRetains">Runtime initialization flag; this binding does not branch on it.</param>
<param name="bInCopyCode">Runtime copy-code flag; this binding does not branch on it.</param>
<param name="taskRunningSubstate">Live phase variable owned by the task; meaningful while RUNNING.</param>
*)
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; 
    bInCopyCode: BOOL;  
	taskRunningSubstate : REFERENCE TO TASK_RUNNING_SUBSTATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TaskRunningSubstate REF= taskRunningSubstate;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Processing" Id="{c8bd812e-2584-4de4-95d9-34cf06cfc9ed}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the phase is PROCESSING.</summary>
<description>
Meaningful only for a running task; pending cancellation suppresses ordinary work even in this phase.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Processing : BOOL
]]></Declaration>
      <Get Name="Get" Id="{4483d9b6-41e7-4d4e-8193-be29c61fa9d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Processing := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.PROCESSING;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResourceAcquiring" Id="{3050b1db-54c2-4caf-89cf-15051bcb4ac5}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the phase is RESOURCE_ACQUIRING.</summary>
<description>
Meaningful only for a running task. It does not prove the acquire request has already been issued.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResourceAcquiring : BOOL
]]></Declaration>
      <Get Name="Get" Id="{67c79e58-31c8-4e9e-be02-63a1f4668026}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResourceAcquiring := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResourceReleasing" Id="{472edf48-e063-484a-aaaa-6dbfa988578d}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the phase is RESOURCE_RELEASING.</summary>
<description>
Meaningful only for a running task. It does not prove physical release or completion.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResourceReleasing : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ffdd6c0d-4f4a-40e4-97bf-f65f63f2c59f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResourceReleasing := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Value" Id="{523bb735-a922-4ac0-8324-a2f7c495f6e3}">
      <Declaration><![CDATA[(*!
<summary>Returns the current phase by value.</summary>
<description>
Meaningful only while the owning task is RUNNING; reading does not advance it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Value : TASK_RUNNING_SUBSTATE
]]></Declaration>
      <Get Name="Get" Id="{3513a302-47e2-48a8-9a30-afa41a5109df}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Value := _TaskRunningSubstate;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>