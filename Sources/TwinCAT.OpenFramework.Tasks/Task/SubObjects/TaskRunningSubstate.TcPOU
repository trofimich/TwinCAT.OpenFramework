<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskRunningSubstate" Id="{33bf852e-0c60-47d9-bc3f-417ab0b1c31c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: Â© 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes a task's acquisition, processing, stopping or release phase.</summary>
<description>
Borrows live backing variables supplied at initialization or rebound after online change. Getters safely guard
against unbound references and return default values if references are not valid. Treat the view and returned
references as read-only. Copy values when a snapshot is required.
</description>
*)

FUNCTION_BLOCK TaskRunningSubstate
VAR
	{attribute 'hide'} 
	_TaskRunningSubstate : REFERENCE TO TASK_RUNNING_SUBSTATE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{43f206d2-6cc9-4d08-8f4c-c1b2bb98d46e}" />
    <Method Name="FB_Init" Id="{34e692c4-9474-4331-a86c-cedfa2730f0a}">
      <Declaration><![CDATA[(*!
<summary>Binds the view to its owner's live state.</summary>
<description>
Stores references without copying their current values or changing the owner. Valid supplied references are
bound; skipped during online change copy code. Does not allocate or raise framework exceptions.
</description>
<param name="taskRunningSubstate">Live phase variable owned by the task; meaningful while RUNNING.</param>
*)
METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	taskRunningSubstate : REFERENCE TO TASK_RUNNING_SUBSTATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	Rebind(taskRunningSubstate := taskRunningSubstate);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Processing" Id="{c8bd812e-2584-4de4-95d9-34cf06cfc9ed}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the phase is PROCESSING.</summary>
<description>
Meaningful only for a running task. Accepted cancellation immediately selects STOPPING. Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Processing : BOOL
]]></Declaration>
      <Get Name="Get" Id="{4483d9b6-41e7-4d4e-8193-be29c61fa9d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_TaskRunningSubstate) THEN
	Processing := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.PROCESSING;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Rebind" Id="{f0584171-2a37-418e-98ca-a16cf1e8a369}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Rebinds the view to its owner's live substate variable.</summary>
<description>
Updates the internal reference when a valid variable is supplied. Used during initialization and
subsequent online-change reinitialization.
</description>
<param name="taskRunningSubstate">Live phase variable owned by the task; meaningful while RUNNING.</param>
*)
METHOD INTERNAL Rebind
VAR_INPUT
	taskRunningSubstate : REFERENCE TO TASK_RUNNING_SUBSTATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TaskRunningSubstate REF= taskRunningSubstate;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResourceAcquiring" Id="{3050b1db-54c2-4caf-89cf-15051bcb4ac5}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the phase is RESOURCE_ACQUIRING.</summary>
<description>
Meaningful only for a running task. It does not prove the acquire request has already been issued.
Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResourceAcquiring : BOOL
]]></Declaration>
      <Get Name="Get" Id="{67c79e58-31c8-4e9e-be02-63a1f4668026}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_TaskRunningSubstate) THEN
	ResourceAcquiring := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResourceReleasing" Id="{472edf48-e063-484a-aaaa-6dbfa988578d}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the phase is RESOURCE_RELEASING.</summary>
<description>
Meaningful only for a running task. It does not prove physical release or completion. Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResourceReleasing : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ffdd6c0d-4f4a-40e4-97bf-f65f63f2c59f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_TaskRunningSubstate) THEN
	ResourceReleasing := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Stopping" Id="{7e89fb73-cbdc-4a35-94fd-3ab8d0401ab8}">
      <Declaration><![CDATA[(*!
<summary>Reports whether active work is being finished before release.</summary>
<description>
Meaningful only while RUNNING. Includes every stop reason; observing it does not advance cleanup.
Returns FALSE if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Stopping : BOOL]]></Declaration>
      <Get Name="Get" Id="{c5179362-88b0-4ebd-b0bc-d629d5121056}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_TaskRunningSubstate) THEN
	Stopping := _TaskRunningSubstate = TASK_RUNNING_SUBSTATE.STOPPING;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Value" Id="{523bb735-a922-4ac0-8324-a2f7c495f6e3}">
      <Declaration><![CDATA[(*!
<summary>Returns the current phase by value.</summary>
<description>
Meaningful only while the owning task is RUNNING; reading does not advance it.
Returns RESOURCE_ACQUIRING if unbound.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Value : TASK_RUNNING_SUBSTATE
]]></Declaration>
      <Get Name="Get" Id="{3513a302-47e2-48a8-9a30-afa41a5109df}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_TaskRunningSubstate) THEN
	Value := _TaskRunningSubstate;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>