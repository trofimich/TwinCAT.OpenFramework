<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Task" Id="{4f3cf4ac-1772-4e42-a725-ba88b4bb1e14}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs a reusable cooperative operation through acquisition, processing, stopping and release.</summary>
<description>
One owner drives the task through Start, cyclic Execute and Reset; no worker thread or PLC scheduler task is
created. Keep callbacks short and avoid concurrent or recursive Execute. The resource manager is borrowed
and must remain live and stable during a run. All stop reasons wait through OnStopping before release.
Normal work completion advances stopping in the same Execute, without waiting or repeating work.
No callback may recursively drive this task, except Reset in OnAfterStop.
Ordinary work and resource exceptions are converted into stop diagnostics where handled. If obtaining their
messages fails, phase-specific fallback text preserves the intended failure transition; preparation and
reset use the same fallback policy for refusal. The first stopping exception is submitted to the log;
later stopping exceptions retry without repeated log attempts. This is not a universal no-throw boundary.
The caller still provides exception cleanup and terminal allocation-failure checks at its PLC task boundary.
</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK ABSTRACT Task EXTENDS TOF_Core.Object IMPLEMENTS ITask
VAR
	{attribute 'hide'} 
	_Name : WSTRING;
	//! <summary>TRUE once an explicit name is stored or first access successfully caches the default.</summary>
	{attribute 'hide'} 
	_NameInitialized : BOOL;
	
	{attribute 'hide'} 
	_State : TASK_STATE;	
	{attribute 'hide'} 
	_StateChanged : BOOL;	
	{attribute 'hide'} 
	_RunningSubstate : TASK_RUNNING_SUBSTATE;
	{attribute 'hide'} 
	_ResourceOperationStarted : BOOL;
	//! <summary>Tracks whether a stopping exception has been submitted to the log in this run.</summary>
	{attribute 'hide'}
	_StoppingExceptionReportAttempted : BOOL;

	{attribute 'hide'} 
	_OriginalStopReason : TASK_STOP_REASON;
	{attribute 'hide'} 
	_TemporaryErrorMessage : TOF_Core.ERROR_MESSAGE;	
	{attribute 'hide'} 
	_OriginalStopReasonMessage : TOF_Core.ERROR_MESSAGE;
	{attribute 'hide'} 
	_OriginalStopReasonObject : TaskStopReason(_OriginalStopReason, _OriginalStopReasonMessage);
	
	{attribute 'hide'} 
	_FinalStopReason : TASK_STOP_REASON;	
	{attribute 'hide'} 
	_FinalStopReasonMessage : TOF_Core.ERROR_MESSAGE;
	{attribute 'hide'} 
	_FinalStopReasonObject : TaskStopReason(_FinalStopReason, _FinalStopReasonMessage);
	
	{attribute 'hide'} 
	_StateObject : TaskState(_State, _StateChanged);
	{attribute 'hide'} 
	_RunningSubstateObject : TaskRunningSubstate(_RunningSubstate);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Members to override" Id="{e6ebeb0e-7c81-4b67-af2e-12cd935145f5}" />
    <Folder Name="Service members" Id="{fcccf993-7a8e-4ed0-ab1b-398389fd2b3c}" />
    <Method Name="Cancel" Id="{70542690-0d14-4f0e-bd58-570de50ff500}">
      <Declaration><![CDATA[(*!
<summary>Requests cooperative cancellation of a running task.</summary>
<description>
Accepted only while RUNNING, with no pending cancellation and before RESOURCE_RELEASING. Records
EXTERNAL_CANCEL as the original reason and enters STOPPING before invoking OnCancelRequest once. A first
Cancel during STOPPING replaces the original result with EXTERNAL_CANCEL. TRUE means accepted, not
completed; continue Execute until STOPPED. Repeated or ineligible requests return FALSE with refuseReason.
Callback exceptions are logged without withdrawing the request.
</description>
<param name="refuseReason">Reason for refusal; meaningful when the method returns FALSE.</param>
*)
METHOD FINAL Cancel : BOOL
VAR_OUTPUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _State <> TASK_STATE.RUNNING THEN
	refuseReason := TOF_Core.WideStrings.Concat255("Expected state is '", TO_WSTRING(TASK_STATE.RUNNING), "' but current state is '", TO_WSTRING(_State), "'");
	RETURN;
END_IF

IF _OriginalStopReason = TASK_STOP_REASON.EXTERNAL_CANCEL
	OR_ELSE _RunningSubstate = TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING
THEN
	refuseReason := "Cancellation already requested or resource release has begun";
	RETURN;
END_IF

_OriginalStopReason := TASK_STOP_REASON.EXTERNAL_CANCEL;
_OriginalStopReasonMessage := "Cancelled by external logic";

setRunningSubstate(TASK_RUNNING_SUBSTATE.STOPPING);

safeCallOnCancelRequest();

Cancel := TRUE;	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{0c44d2a0-6aaa-455c-bf4e-d065a6e8ebfd}">
      <Declaration><![CDATA[(*!
<summary>Advances the running task and clears its transition indicator.</summary>
<description>
Clears State.StateChanged on every call, including READY and STOPPED calls. While RUNNING, advances
acquisition, work or release without a blocking wait. A normal terminal work result also advances stopping
once in the same call. A caught acquire/process exception defers stopping until the next Execute. Readiness
selects release for a later Execute, or stops immediately without a resource.
The owner determines call frequency and must keep calling during cleanup. No automatic scheduling or general
callback reentrancy protection is provided.
</description>
*)
METHOD FINAL Execute ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StateChanged := FALSE;

IF _State = TASK_STATE.RUNNING THEN
	handleRunning();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{4a40010f-36b0-4b8e-9bdb-42fc8f2b04c7}">
      <Declaration><![CDATA[(*!
<summary>Stores an explicit diagnostic name and defers default-name creation.</summary>
<description>
Copies a nonempty name into task-owned storage and marks it initialized. With an empty name, the
initially FALSE marker leaves default-name creation to the first Name read after construction.
Does not read overridden metadata, start work or acquire resources. Start and Reset preserve the name.
</description>
<param name="bInitRetains">TRUE when retain variables are initialized.</param>
<param name="bInCopyCode">TRUE when the instance is subsequently copied for online change.</param>
<param name="name">Diagnostic name to copy, or empty to request the default name.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT	
	bInitRetains	: BOOL;	
	bInCopyCode	: BOOL;
	name : WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF name <> TOF_Core.WideStrings.Empty THEN
	_Name := name;
	_NameInitialized := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="FinalStopReason" Id="{2700e19c-2cd2-4878-bd36-35fddbc83862}">
      <Declaration><![CDATA[(*!
<summary>Final termination result; meaningful as a final result only in STOPPED.</summary>
<description>
STOPPED means execution has ended, not that physical resource release succeeded.
Resource-release exceptions produce FAILURE without an automatic release retry.
Best-effort errors handled and
logged by the resource manager do not by themselves change this result.
Reset restores the default reason and clears the message. This is a live view.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL FinalStopReason : REFERENCE TO TaskStopReason]]></Declaration>
      <Get Name="Get" Id="{4683eaba-a5e9-4ae8-8977-247101cb64d5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FinalStopReason REF= _FinalStopReasonObject;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetProcessingStateByStopReason" Id="{2c7b7363-a7d0-4c80-8f77-2fdbbb832cf9}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Maps a completed task's stop reason to a processing result.</summary>
<description>
WORK_DONE maps to DONE, INTERNAL_ABORT and EXTERNAL_CANCEL to ABORTED, and FAILURE to ERROR. Call with a
defined TASK_STOP_REASON after completion. No state is modified; an unrecognized value is not rejected and
leaves the default BUSY result.
</description>
<param name="taskStopReason">Completed task result to translate.</param>
*)
METHOD PROTECTED GetProcessingStateByStopReason : TASK_PROCESSING_STATE
VAR_INPUT
	taskStopReason : TASK_STOP_REASON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE taskStopReason OF
	TASK_STOP_REASON.WORK_DONE:
		GetProcessingStateByStopReason := TASK_PROCESSING_STATE.DONE;
	
    TASK_STOP_REASON.INTERNAL_ABORT, TASK_STOP_REASON.EXTERNAL_CANCEL:
		GetProcessingStateByStopReason := TASK_PROCESSING_STATE.ABORTED;
	
    TASK_STOP_REASON.FAILURE:
		GetProcessingStateByStopReason := TASK_PROCESSING_STATE.ERROR;
END_CASE ]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetStopReasonByProcessingState" Id="{c77bcf33-94ab-426f-a1b5-c4dac370b49f}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Maps a terminal processing result to the reason for stopping.</summary>
<description>
DONE maps to WORK_DONE, ABORTED to INTERNAL_ABORT, and ERROR to FAILURE. BUSY and unrecognized values raise
ArgumentOutOfRangeException. Does not modify task state.
</description>
<param name="taskpPocessingState">Terminal result from OnRunning.</param>
*)
METHOD PROTECTED GetStopReasonByProcessingState : TASK_STOP_REASON
VAR_INPUT
	taskpPocessingState : TASK_PROCESSING_STATE;
END_VAR
VAR
	invalidTaskRunningResult : TOF_Core.ArgumentOutOfRangeException;
	
	taskRunningResultName : STRING(16);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE taskpPocessingState OF
	TASK_PROCESSING_STATE.DONE:
		GetStopReasonByProcessingState := TASK_STOP_REASON.WORK_DONE;
	
    TASK_PROCESSING_STATE.ABORTED:
		GetStopReasonByProcessingState := TASK_STOP_REASON.INTERNAL_ABORT;
		
    TASK_PROCESSING_STATE.ERROR:
		GetStopReasonByProcessingState := TASK_STOP_REASON.FAILURE;
	
	ELSE
		taskRunningResultName := TO_STRING(taskpPocessingState);
		invalidTaskRunningResult.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'taskpPocessingState', taskRunningResultName);
END_CASE
 ]]></ST>
      </Implementation>
    </Method>
    <Method Name="handleRunning" Id="{0c0b3c2d-2039-40cf-90c1-1bc48ceedfa2}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Advances work and permits immediate stopping after a normal terminal result.</summary>
<description>
Every terminal work result and acquire/process exception enters STOPPING. Normal results call OnStopping
once immediately; exceptions leave its first call for the next Execute to avoid advancing a failed child
twice in one call. OnStopping must complete before
release or STOPPED; its exceptions keep STOPPING without replacing the original reason. The first
stopping exception is submitted to the log; later ones retry without another log attempt. Release
exceptions terminate the attempt with final FAILURE and no retry. A caught exception uses named,
phase-specific fallback text if its message is empty or formatting fails; fixed phase text remains if
fallback formatting also fails. Terminal allocation failure remains latched for the owner's fatal boundary.
Callbacks must not recursively drive this task; OnAfterStop may Reset after finalization.
</description>
*)
METHOD PRIVATE handleRunning
VAR
	readyToRelease : BOOL;
	taskProcessingState : TASK_PROCESSING_STATE;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	phaseFailureMessage : WSTRING(40);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	CASE _RunningSubstate OF
		TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING:
			IF NOT _ResourceOperationStarted THEN
				_ResourceOperationStarted := TRUE;
				
				ResourceManager.StartAcquire();
			END_IF

			ResourceManager.Execute();
			
			IF ResourceManager.ResourceAcquired THEN
				setRunningSubstate(TASK_RUNNING_SUBSTATE.PROCESSING);
			END_IF

		TASK_RUNNING_SUBSTATE.PROCESSING:
			OnRunning(processingState => taskProcessingState, stopReasonMessage := _OriginalStopReasonMessage);

			IF taskProcessingState <> TASK_PROCESSING_STATE.BUSY THEN
				_OriginalStopReason := GetStopReasonByProcessingState(taskProcessingState);
				setRunningSubstate(TASK_RUNNING_SUBSTATE.STOPPING);
			END_IF

		TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING:
			IF NOT _ResourceOperationStarted THEN
				_ResourceOperationStarted := TRUE;
				
				ResourceManager.StartRelease();
			END_IF

			ResourceManager.Execute();
			
			IF NOT ResourceManager.ResourceAcquired THEN
				setStoppedState(_OriginalStopReason, _OriginalStopReasonMessage);
				safeCallOnAfterStop();
			END_IF
	END_CASE

	IF _State = TASK_STATE.RUNNING AND_THEN _RunningSubstate = TASK_RUNNING_SUBSTATE.STOPPING THEN
		OnStopping(readyToRelease => readyToRelease);

		IF readyToRelease THEN
			IF ReleaseResourceRequired THEN
				setRunningSubstate(TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING);
			ELSE
				setStoppedState(_OriginalStopReason, _OriginalStopReasonMessage);
				safeCallOnAfterStop();
			END_IF
		END_IF
	END_IF
__CATCH(exceptionCode)
	IF _RunningSubstate = TASK_RUNNING_SUBSTATE.STOPPING THEN
		IF _StoppingExceptionReportAttempted THEN
			// Continue the interrupted hook on a later Execute without repeated logging.
			RETURN;
		END_IF

		_StoppingExceptionReportAttempted := TRUE;
	END_IF

	CASE _RunningSubstate OF
		TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING:
			phaseFailureMessage := "resource acquisition failed";

		TASK_RUNNING_SUBSTATE.PROCESSING:
			phaseFailureMessage := "processing failed";

		TASK_RUNNING_SUBSTATE.STOPPING:
			phaseFailureMessage := "stopping failed";

		TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING:
			phaseFailureMessage := "release failed";
	END_CASE

	_TemporaryErrorMessage := phaseFailureMessage;

	__TRY
		_TemporaryErrorMessage := TOF_Core.WideStrings.Concat255("Task '", Name, "' ", phaseFailureMessage);
		exception := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
		_TemporaryErrorMessage := exception.GetMessage();

		IF _TemporaryErrorMessage = TOF_Core.WideStrings.Empty THEN
			_TemporaryErrorMessage := phaseFailureMessage;
			_TemporaryErrorMessage := TOF_Core.WideStrings.Concat255("Task '", Name, "' ", phaseFailureMessage);
		END_IF
	__CATCH
		// Keep the named or fixed phase fallback and any terminal allocation-failure latch.
	__ENDTRY

	TOF_Core.LogManager.TryLogMessage(_TemporaryErrorMessage, TOF_Core.LOG_CATEGORY.ERROR, "Task", "Execute");

	CASE _RunningSubstate OF
		TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING:
			setStoppedState(TASK_STOP_REASON.FAILURE, _TemporaryErrorMessage);
			safeCallOnAfterStop();

		TASK_RUNNING_SUBSTATE.STOPPING:
			// Retry stopping later; never release after an interrupted hook.
			RETURN;

		ELSE
			_OriginalStopReason := TASK_STOP_REASON.FAILURE;
			_OriginalStopReasonMessage := _TemporaryErrorMessage;
			
			setRunningSubstate(TASK_RUNNING_SUBSTATE.STOPPING);
	END_CASE
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{4e451f29-f53d-4bcf-8f0a-083cf67f553b}">
      <Declaration><![CDATA[(*!
<summary>Provides the task's diagnostic name.</summary>
<description>
FB_init copies a nonempty supplied name. For an empty name, the first read caches Object.GetDefaultName,
including ClassName and the instance address. First access to a default name must occur after the
most-derived FB has completed initialization, from the task's owner. The getter does not detect construction
completion or synchronize callers. ClassName overrides must not recursively read Name.
If metadata access fails, the exception propagates and initialization remains pending for a later read.
Successful initialization happens once; later reads do not recompute metadata. Start and Reset preserve
the name and its storage. The returned reference remains valid while the task lives; do not write through it.
The name is diagnostic text, not a persistent identifier; later ClassName changes do not rename the task.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL Name : REFERENCE TO WSTRING]]></Declaration>
      <Get Name="Get" Id="{758bcc09-602f-41b4-b11f-e8268c4f3c3a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _NameInitialized THEN
	_Name := GetDefaultName();
	_NameInitialized := TRUE;
END_IF

Name REF= _Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnAfterStop" Id="{86e85a1b-93eb-4520-a6b2-faaa5a3db20e}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Notifies descendants after final termination has been recorded.</summary>
<description>
Called after transition to STOPPED and assignment of FinalStopReason, following the release attempt when
required. Use for short notifications or bookkeeping for any stop reason. Callback exceptions are logged and
do not replace the recorded result. Reset from this hook can change the visible state and clear results
before Execute returns; it does not schedule another run. General recursive lifecycle control is not
guaranteed.
</description>
*)
METHOD PROTECTED OnAfterStop
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeStart" Id="{5fb86c1f-5c4e-4feb-b7c4-caeef1bc2031}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Prepares a READY task synchronously before starting.</summary>
<description>
Called by Start before RUNNING and resource acquisition. Validate or prepare one run without waiting in a
loop. A callback exception refuses Start and supplies refuseReason, using fixed fallback text if obtaining
the exception message fails. Preparation already performed is not rolled back. The base does nothing.
</description>
*)
METHOD PROTECTED OnBeforeStart]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCancelRequest" Id="{ec05160b-b364-40ca-9992-6a0764b0e3eb}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Initiates an accepted cancellation once.</summary>
<description>
Called synchronously by Cancel after the original stop reason is set to EXTERNAL_CANCEL. Not called for refused or
repeated requests. Initiate only short cancellation actions; Execute and OnStopping advance completion.
Callback exceptions are logged without withdrawing the request. The base implementation does nothing.
</description>
*)
METHOD PROTECTED OnCancelRequest]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{a7e8974b-7e43-4ce5-8790-6b98c2babadd}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Resets descendant state before returning a stopped task to READY.</summary>
<description>
Called synchronously by Reset only in STOPPED, before base stop reasons and cancellation state are cleared.
READY Reset does not call this hook. A callback exception refuses Reset, using fixed fallback text if
obtaining the exception message fails; changes already made are not rolled back. The base implementation
does nothing. Descendants must preserve any reset work required by their immediate base class.
</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{fa525f37-9567-4dcb-9fc7-ad672f39a641}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Advances one step of the operation after resource acquisition.</summary>
<description>
Called only in PROCESSING. Return BUSY to continue, DONE to complete,
ABORTED for internal abort or ERROR for failure. A normal terminal result enters STOPPING and calls OnStopping once in the same Execute. The stop message is the task's live per-run buffer and is not cleared before every callback.
Exceptions enter the task's failure and
cleanup path; completed side effects are not rolled back. Keep execution bounded and do not block waiting
for an asynchronous result.
</description>
<param name="processingState">Result of this processing step; the default value is BUSY.</param>
<param name="stopReasonMessage">Optional diagnostic message retained for termination; not an owned buffer.</param>
*)
METHOD PROTECTED ABSTRACT OnRunning
VAR_OUTPUT
	processingState : TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{2ad060bf-91d2-42fc-8f3b-934bf7b4d05f}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Finishes active work before resource release for every stop reason.</summary>
<description>
Called in STOPPING after success, internal abort, failure or external cancellation. A normal terminal work
result invokes this hook in the same Execute; a caught work/acquire exception defers it to the next call. Ordinary
OnRunning and acquisition no longer execute. Set readyToRelease on every call; FALSE requires another
Execute. Finish pending I/O and acquisition without starting new work. TRUE permits release on the next
Execute, or immediate STOPPED when no resource is acquired. The base returns TRUE.
An exception keeps STOPPING and retries on a later Execute without changing the original result. Only
the first stopping exception is submitted to the log in a run; later ones are suppressed. Partial hook
effects are not rolled back. Make interrupted progress resumable. No timeout or
physical abort is implied. Descendants must preserve inherited stopping work and combine readiness.
</description>
<param name="readyToRelease">TRUE when active work no longer prevents release or termination.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[readyToRelease := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="OriginalStopReason" Id="{584c09b9-cc15-4863-851e-295e1f3855a3}">
      <Declaration><![CDATA[(*!
<summary>Reason recorded for stopping: completion, internal abort, cancellation or failure.</summary>
<description>
Established when stopping begins and preserved during resource release, along
with its message. Release exceptions affect FinalStopReason and its message.
The initial WORK_DONE value does not indicate completed work.
Reset restores the default reason and clears the message. This is a live view.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL OriginalStopReason : REFERENCE TO TaskStopReason]]></Declaration>
      <Get Name="Get" Id="{f76dfe1f-2858-4323-89c5-fdbe686b4c10}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[OriginalStopReason REF= _OriginalStopReasonObject;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ReleaseResourceRequired" Id="{f0fd2b26-a815-4a05-9799-39dece9b0738}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Reports whether the current manager has an acquired resource.</summary>
<description>
TRUE only for a nonzero ResourceManager reporting ResourceAcquired. Does not initiate cleanup or determine
whether acquisition is still pending. Both getters must be non-throwing and free of side effects.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PROTECTED FINAL ReleaseResourceRequired : BOOL]]></Declaration>
      <Get Name="Get" Id="{146f8d24-87e8-452d-aa8d-94dc970b416d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ReleaseResourceRequired := ResourceManager <> 0 AND_THEN ResourceManager.ResourceAcquired;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{98e72552-cae8-4b2c-b8c6-8047c79b882a}">
      <Declaration><![CDATA[(*!
<summary>Prepares a stopped task for reuse.</summary>
<description>
READY returns TRUE without callbacks or clearing state. RUNNING returns FALSE; cancel and drive Execute to
STOPPED first. In STOPPED, OnReset must succeed before base state returns to READY and stop diagnostics are
cleared. Partial callback effects are not rolled back on refusal. Failure to obtain a callback exception's
message uses fixed refusal text; terminal allocation failure still requires the caller's task-boundary check.
</description>
<param name="refuseReason">Reason for refusal; meaningful when the method returns FALSE.</param>
*)
METHOD FINAL Reset : BOOL
VAR_OUTPUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _State = TASK_STATE.READY THEN
	Reset := TRUE;
	RETURN;
END_IF

IF _State <> TASK_STATE.STOPPED THEN
	refuseReason := TOF_Core.WideStrings.Concat255("Expected state is '", TO_WSTRING(TASK_STATE.READY), " or ", TO_WSTRING(TASK_STATE.STOPPED), "' but current state is '", TO_WSTRING(_State), "'");
	RETURN;
END_IF
	
IF safeCallOnReset(refuseReason) THEN
	setIdleState();

	Reset := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResourceManager" Id="{d940cf50-89bd-4d74-bb1c-dbd9609c4f14}">
      <Declaration><![CDATA[(*!
<summary>Provides the borrowed manager used for resource acquisition and release.</summary>
<description>
The base returns zero. Keep a nonzero manager alive and stable throughout the run; only the task drives its
StartAcquire, StartRelease and Execute methods. Start skips acquisition when already acquired, but normal
stopping still releases an acquired resource. During OnStopping, descendants must complete pending
acquisition as required by the manager before permitting release for any stop reason. Release exceptions
terminate the attempt with final FAILURE and no automatic retry. ResourceManager and ResourceAcquired getters must not throw or
have side effects.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY ResourceManager : TOF_Core.IResourceManager]]></Declaration>
      <Get Name="Get" Id="{eb1a2806-2821-4891-9a94-be06e63069cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RunningSubstate" Id="{66935ac7-34a7-4c86-b67d-8cd08feeed21}">
      <Declaration><![CDATA[(*!
<summary>Provides a live read-only view of the current execution phase.</summary>
<description>
Meaningful only while State.Running is TRUE. The view borrows this task's fields and must not outlive it.
Observing a phase does not authorize external callers to drive the resource manager.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL RunningSubstate : REFERENCE TO TaskRunningSubstate]]></Declaration>
      <Get Name="Get" Id="{7f57d865-76a7-4394-ab4e-08fffeb4344f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RunningSubstate REF= _RunningSubstateObject;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="safeCallOnAfterStop" Id="{0c327d25-c1a4-490a-bffb-4b7b77fe9c81}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Invokes the termination hook and attempts to log a callback exception.</summary>
<description>
Does not change the final result to reflect callback failure. Logging is best effort; a callback can already
have changed observable task state. Exception transport requires cyclic task context.
</description>
*)
METHOD PRIVATE safeCallOnAfterStop
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnAfterStop();
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());

	TOF_Core.LogManager.TryLogException(exception, TOF_Core.ERROR_SEVERITY.ERROR, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="safeCallOnBeforeStart" Id="{4d5ec1be-1747-41c1-b234-c3cc18f33f59}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Invokes start preparation and converts a callback exception to refusal.</summary>
<description>
Returns TRUE when OnBeforeStart returns normally. On exception, copies its formatted message to refuseReason
and leaves FALSE. If obtaining the message raises, retains fixed refusal text. Does not roll back callback
effects or clear terminal allocation failure; the caller's fatal boundary remains required.
</description>
<param name="refuseReason">Receives formatted diagnostics when preparation throws.</param>
*)
METHOD PRIVATE safeCallOnBeforeStart : BOOL
VAR_IN_OUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;	
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnBeforeStart();
	
	safeCallOnBeforeStart := TRUE;
__CATCH(exceptionCode)
	refuseReason := "Task start preparation failed";

	__TRY
		exception := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
		refuseReason := exception.GetMessage();
	__CATCH
		// Keep the fallback text and any terminal allocation-failure latch.
	__ENDTRY
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="safeCallOnCancelRequest" Id="{905ed24a-5192-4ad8-85ce-047a09b432af}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Invokes the cancellation notification and attempts to log a callback exception.</summary>
<description>
The cancellation request has already been accepted; callback failure does not undo the recorded reason.
Exception transport requires cyclic task context.
</description>
*)
METHOD PRIVATE safeCallOnCancelRequest
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnCancelRequest();
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());

	TOF_Core.LogManager.TryLogException(exception, TOF_Core.ERROR_SEVERITY.ERROR, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="safeCallOnReset" Id="{15a9e5da-1c2d-41c3-b3ce-bb3ffe792a82}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Invokes reset preparation and converts a callback exception to refusal.</summary>
<description>
Returns TRUE when OnReset returns normally. On exception, formats refuseReason and leaves FALSE. Does not
undo partial reset effects. If obtaining the message raises, retains fixed refusal text. Does not clear
terminal allocation failure; the caller's fatal boundary remains required.
</description>
<param name="refuseReason">Receives formatted diagnostics when reset preparation throws.</param>
*)
METHOD PRIVATE safeCallOnReset : BOOL
VAR_IN_OUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;	
	exception : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnReset();
	
	safeCallOnReset := TRUE;
__CATCH(exceptionCode)
	refuseReason := "Task reset failed";

	__TRY
		exception := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
		refuseReason := exception.GetMessage();
	__CATCH
		// Keep the fallback text and any terminal allocation-failure latch.
	__ENDTRY
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="setIdleState" Id="{d671c618-6e83-4250-9051-fb8450c86902}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Enters READY and clears per-run task state.</summary>
<description>
Used after successful reset preparation. Attempts transition logging, sets StateChanged when the lifecycle
state changes, clears the resource-operation marker, and resets both stop reasons and
messages. Does not release resources or invoke reset hooks.
</description>
*)
METHOD PRIVATE FINAL setIdleState
VAR CONSTANT
	NEW_STATE : TASK_STATE := TASK_STATE.READY;
END_VAR
VAR
	formattedLogMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _State <> NEW_STATE THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Task '", Name, "' changed state from '", TO_WSTRING(_State), "' to '", TO_WSTRING(NEW_STATE), "'");

	TOF_Core.LogManager.TryLogMessage(
		formattedLogMessage, 
		TOF_Core.LOG_CATEGORY.INFORMATION, 
		TO_WSTRING(ClassName), 
		"Task", 
		TOF_Core.WideStrings.Concat255("Task.", TO_WSTRING(NEW_STATE))
	);

	_State := NEW_STATE;
	_StateChanged := TRUE;	
END_IF 

_RunningSubstate := TASK_RUNNING_SUBSTATE.PROCESSING;
_ResourceOperationStarted := FALSE;

_OriginalStopReason := TASK_STOP_REASON.WORK_DONE;
_OriginalStopReasonMessage := "";	

_FinalStopReason := TASK_STOP_REASON.WORK_DONE;
_FinalStopReasonMessage := "";	]]></ST>
      </Implementation>
    </Method>
    <Method Name="setRunningState" Id="{1d4e1480-16f7-42b7-b601-af024b62cfc3}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Prepares the first execution phase and enters RUNNING.</summary>
<description>
Reads the stable resource manager before publishing RUNNING. Selects acquisition only for a nonzero manager
without an acquired resource, otherwise PROCESSING. Clears stop diagnostics, the resource-operation marker
and the stopping-exception report marker; attempts transition logging. Does not invoke StartAcquire or
OnRunning; Execute advances them.
</description>
*)
METHOD PRIVATE FINAL setRunningState
VAR
	resourceManagerForStart : TOF_Core.IResourceManager;

	formattedLogMessage : WSTRING(255);
END_VAR
VAR CONSTANT
	NEW_STATE : TASK_STATE := TASK_STATE.RUNNING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[resourceManagerForStart := ResourceManager;

IF resourceManagerForStart <> 0 AND_THEN NOT resourceManagerForStart.ResourceAcquired THEN
	setRunningSubstate(TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING);
ELSE
	setRunningSubstate(TASK_RUNNING_SUBSTATE.PROCESSING);
END_IF

IF _State <> NEW_STATE THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Task '", Name, "' changed state from '", TO_WSTRING(_State), "' to '", TO_WSTRING(NEW_STATE), "'");
 
	TOF_Core.LogManager.TryLogMessage(
		formattedLogMessage,
		TOF_Core.LOG_CATEGORY.INFORMATION,
		TO_WSTRING(ClassName),
		"Task",
		TOF_Core.WideStrings.Concat255("Task.", TO_WSTRING(NEW_STATE))
	);
END_IF

_ResourceOperationStarted := FALSE;
_StoppingExceptionReportAttempted := FALSE;

_OriginalStopReason := TASK_STOP_REASON.WORK_DONE;
_OriginalStopReasonMessage := "";

_FinalStopReason := TASK_STOP_REASON.WORK_DONE;
_FinalStopReasonMessage := "";

IF _State <> NEW_STATE THEN
	_State := NEW_STATE;
	_StateChanged := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="setRunningSubstate" Id="{d7f6ee1f-b4e3-4b35-9d2a-d0008766d37e}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Selects a running phase and resets its one-time resource request marker.</summary>
<description>
Does not format diagnostics, change the lifecycle state or StateChanged, or invoke the resource manager.
</description>
<param name="runningSubState">Phase to execute on the next applicable dispatch.</param>
*)
METHOD PRIVATE setRunningSubstate
VAR_INPUT
	runningSubState : TASK_RUNNING_SUBSTATE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RunningSubstate := runningSubState;
_ResourceOperationStarted := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setStoppedState" Id="{8d421360-d406-412c-baae-5d7b7f498ca6}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Records the final result and enters STOPPED.</summary>
<description>
Attempts transition logging and sets StateChanged on a lifecycle transition. Copies a nonempty supplied
message, otherwise uses the original message or a default for the final reason. Preserves the original
reason and does not itself invoke OnAfterStop. STOPPED does not prove physical resource release.
</description>
<param name="finalStopReason">Final lifecycle result, including any release failure.</param>
<param name="finalStopReasonMessage">Borrowed diagnostic text copied during this call; may alias the task's original message.</param>
*)
METHOD PRIVATE FINAL setStoppedState
VAR_INPUT
	finalStopReason : TASK_STOP_REASON;
END_VAR
VAR_IN_OUT CONSTANT
	finalStopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR CONSTANT
	NEW_STATE : TASK_STATE := TASK_STATE.STOPPED;
END_VAR
VAR
	formattedLogMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _State <> NEW_STATE THEN
	formattedLogMessage := TOF_Core.WideStrings.Concat255("Task '", Name, "' changed state from '", TO_WSTRING(_State), "' to '", TO_WSTRING(NEW_STATE), "'");

	TOF_Core.LogManager.TryLogMessage(
		formattedLogMessage, 
		TOF_Core.LOG_CATEGORY.INFORMATION, 
		TO_WSTRING(ClassName), 
		"Task", 
		TOF_Core.WideStrings.Concat255("Task.", TO_WSTRING(NEW_STATE))
	);

	_State := NEW_STATE;
	_StateChanged := TRUE;	
END_IF 

_FinalStopReason := finalStopReason;

IF finalStopReasonMessage <> "" THEN
	_FinalStopReasonMessage := finalStopReasonMessage;
ELSE
	IF _OriginalStopReasonMessage <> "" THEN
		_FinalStopReasonMessage := _OriginalStopReasonMessage;
	ELSE
		CASE _FinalStopReason OF
			TASK_STOP_REASON.WORK_DONE:
				_FinalStopReasonMessage := "Work done";
		
			TASK_STOP_REASON.INTERNAL_ABORT:
				_FinalStopReasonMessage := "Stopped by internal logic";
				
			TASK_STOP_REASON.EXTERNAL_CANCEL:
				_FinalStopReasonMessage := "Stopped by external logic";
		
			TASK_STOP_REASON.FAILURE:
				_FinalStopReasonMessage := "Exception occured";
		END_CASE	
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{ce59c237-31f2-4c66-aa57-58d7b3210a0c}">
      <Declaration><![CDATA[(*!
<summary>Starts a prepared task in READY.</summary>
<description>
Returns TRUE after OnBeforeStart succeeds and RUNNING is established; work and acquisition are advanced by
subsequent Execute calls. An ineligible state or a caught preparation failure returns FALSE with
refuseReason. Callback effects are not rolled back. Failure to obtain a callback exception's message uses
fixed refusal text; terminal allocation failure still requires the caller's task-boundary check.
</description>
<param name="refuseReason">Reason for refusal; meaningful when the method returns FALSE.</param>
*)
METHOD FINAL Start : BOOL
VAR_OUTPUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Start := FALSE;

IF _State <> TASK_STATE.READY THEN
	refuseReason := TOF_Core.WideStrings.Concat255("Expected state is '", TO_WSTRING(TASK_STATE.READY), "' but current state is '", TO_WSTRING(_State), "'");
	RETURN;
END_IF

IF safeCallOnBeforeStart(refuseReason) THEN
	setRunningState();

	Start := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{dafc5e3d-e24c-471f-9fe0-3ccb7b88ba9e}">
      <Declaration><![CDATA[(*!
<summary>Provides a live read-only lifecycle view.</summary>
<description>
READY permits Start, RUNNING includes work and cleanup, and STOPPED permits result inspection and Reset.
StateChanged is cleared at the beginning of each Execute and set on a lifecycle transition; it is not a
global one-cycle pulse. The view must not outlive this task.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL State : REFERENCE TO TaskState]]></Declaration>
      <Get Name="Get" Id="{194ca53a-f3b4-4af6-941f-9e148bc75ff7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[State REF= _StateObject;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>