<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITask" Id="{d3098217-84d9-41a9-8015-2bb7aecc397b}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines a reusable cooperative operation with optional resource acquisition and release.</summary>
<description>
One owner drives inherited Execute cyclically while RUNNING, including after an accepted Cancel, until
STOPPED. Avoid concurrent or recursive Execute on the same task. State, RunningSubstate and stop reasons are
borrowed live views for observation only; keep the task alive and do not modify referenced data. Copy result
values and messages before Reset or reuse. Boolean control results do not establish a general no-throw
guarantee for arbitrary implementations or diagnostic failures.
</description>
*)
INTERFACE ITask EXTENDS TOF_Core.IExecutable, TOF_Core.INamed]]></Declaration>
    <Method Name="Cancel" Id="{ef728205-374a-4fc3-bb32-decdf03e58b9}">
      <Declaration><![CDATA[(*!
<summary>Requests cancellation before resource release begins.</summary>
<description>
Accepted only in RUNNING with no pending cancellation and before resource release. TRUE means accepted, not
completed; continue Execute until STOPPED. Accepted cancellation enters STOPPING, including from a previous
work result in that phase, and sets EXTERNAL_CANCEL. Repeated, releasing or non-running requests return FALSE with
refuseReason.
</description>
<param name="refuseReason">Reason for refusal; meaningful on FALSE.</param>
*)
METHOD Cancel : BOOL
VAR_OUTPUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
    <Property Name="FinalStopReason" Id="{9c067443-4d32-49a9-9845-eddee92ba4b3}">
      <Declaration><![CDATA[(*!
<summary>Provides the final lifecycle result for a stopped task.</summary>
<description>
Meaningful as a final result only in STOPPED. Release exceptions produce FAILURE without an automatic
release retry; STOPPED does not prove physical resource release. Best-effort errors handled inside the
manager do not by themselves change this result. Reset clears the message and restores the default reason.
The view is borrowed and read-only.
</description>
*)
{attribute 'monitoring' := 'call'}

PROPERTY FINAL FinalStopReason : REFERENCE TO TaskStopReason]]></Declaration>
      <Get Name="Get" Id="{10662390-fa02-468e-bb67-3e7f8e5a6238}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="OriginalStopReason" Id="{28504d1b-5c93-456e-98f0-f8d2dcf4bea6}">
      <Declaration><![CDATA[(*!
<summary>Provides the reason that initiated stopping.</summary>
<description>
Completion, internal abort, external cancellation or failure is preserved with its message during release; a
release exception affects FinalStopReason instead. The initial WORK_DONE value does not indicate completion.
Reset restores defaults. This is a borrowed read-only live view.
</description>
*)
{attribute 'monitoring' := 'call'}

PROPERTY FINAL OriginalStopReason : REFERENCE TO TaskStopReason]]></Declaration>
      <Get Name="Get" Id="{89fc588e-f13f-4d20-9402-908b7a5c845d}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Reset" Id="{f44f6234-4002-4781-87c3-cf0011acb117}">
      <Declaration><![CDATA[(*!
<summary>Prepares a stopped task for reuse.</summary>
<description>
READY returns TRUE without callbacks or reinitialization. RUNNING refuses reset; cancel and keep calling
Execute until STOPPED first. In STOPPED, successful reset restores default stop reasons and clears their
messages. A refused reset does not guarantee rollback of callback effects.
</description>
<param name="refuseReason">Reason for refusal; meaningful on FALSE.</param>
*)
METHOD Reset : BOOL
VAR_OUTPUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
    <Property Name="ResourceManager" Id="{0e115959-9e74-49ea-a0aa-9c9e0f7debdb}">
      <Declaration><![CDATA[(*!
<summary>Provides the borrowed manager used by the task, or zero for none.</summary>
<description>
Keep the manager alive and stable throughout the run. The task issues StartAcquire or StartRelease once per
phase and advances Execute; external callers must not drive those operations concurrently. Pending
acquisition and active work must finish according to the concrete manager and task contracts before release.
ResourceManager and
ResourceAcquired getters have no side effects and must not throw.
</description>
*)
{attribute 'monitoring' := 'call'}

PROPERTY ResourceManager : TOF_Core.IResourceManager]]></Declaration>
      <Get Name="Get" Id="{1545f52a-8298-44a9-8fcc-24c9d4881fdb}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="RunningSubstate" Id="{d522f074-5e81-4b66-9912-a1c688905470}">
      <Declaration><![CDATA[(*!
<summary>Provides a live diagnostic view of the running phase.</summary>
<description>
Meaningful only while State.Running is TRUE. Observe acquisition, processing, stopping or release without driving the
resource manager directly. The view is borrowed and read-only.
</description>
*)
{attribute 'monitoring' := 'call'}

PROPERTY FINAL RunningSubstate : REFERENCE TO TaskRunningSubstate]]></Declaration>
      <Get Name="Get" Id="{f9725b23-b66a-4a9d-82c6-f306b9252035}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Start" Id="{bab46e46-c28a-4012-a6f3-9e40cfdbeb7a}">
      <Declaration><![CDATA[(*!
<summary>Starts a READY task's lifecycle.</summary>
<description>
TRUE means RUNNING, not completed. Continue Execute for work and cleanup. Ineligible state or refused
preparation returns FALSE with refuseReason. Refusal does not guarantee rollback of preparation already
performed.
</description>
<param name="refuseReason">Reason for refusal; meaningful on FALSE.</param>
*)
METHOD Start : BOOL
VAR_OUTPUT
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
    <Property Name="State" Id="{c8210fde-faab-453b-946c-61525bfba211}">
      <Declaration><![CDATA[(*!
<summary>Provides a live view of the task lifecycle.</summary>
<description>
READY precedes start, RUNNING includes acquisition, work, stopping and release, and STOPPED marks termination. Assess the completed
result through FinalStopReason. StateChanged is cleared at the start of Execute and set on a lifecycle
transition; its lifetime follows method calls, not necessarily one PLC cycle. The view is borrowed and
read-only.
</description>
*)
{attribute 'monitoring' := 'call'}

PROPERTY FINAL State : REFERENCE TO TaskState]]></Declaration>
      <Get Name="Get" Id="{d5910087-292c-4520-9582-a57bd68854f3}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>