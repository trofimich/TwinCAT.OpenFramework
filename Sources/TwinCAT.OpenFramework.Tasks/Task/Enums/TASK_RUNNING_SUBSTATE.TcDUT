(*!
<summary>Identifies the active phase of a running task.</summary>
<description>
Acquisition, processing and release are diagnostic substates, not independent scheduling tasks. Interpret
them only while TASK_STATE is RUNNING.
</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE TASK_RUNNING_SUBSTATE :
(
	//! <summary>Acquire the resource before ordinary work.</summary>
	RESOURCE_ACQUIRING := 0,
	//! <summary>Advance ordinary work unless cancellation is pending.</summary>
	PROCESSING,
	//! <summary>Advance the terminal resource-release attempt.</summary>
	RESOURCE_RELEASING
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>