(*!
<summary>Reports one OnRunning step's progress or terminal outcome.</summary>
<description>
BUSY continues processing; DONE, ABORTED and ERROR begin stopping with WORK_DONE, INTERNAL_ABORT and FAILURE
respectively. External cancellation is requested through Cancel.
</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE TASK_PROCESSING_STATE :
(
	//! <summary>Continue with a subsequent Execute.</summary>
	BUSY := 0,
	//! <summary>Finish ordinary work successfully.</summary>
	DONE,
    //! <summary>Stop because the operation aborted internally.</summary>
    ABORTED,
    //! <summary>Stop because processing failed.</summary>
    ERROR
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>