(*!
<summary>Identifies why a task entered or completed stopping.</summary>
<description>
OriginalStopReason retains the initiating reason; FinalStopReason can become FAILURE after a release
exception. The default WORK_DONE does not itself establish task completion.
</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE TASK_STOP_REASON :
(
	//! <summary>Successful work, or the initial/reset default before termination.</summary>
	WORK_DONE := 0,
    //! <summary>Operation aborted through its processing result.</summary>
    INTERNAL_ABORT,
    //! <summary>External cancellation was accepted.</summary>
    EXTERNAL_CANCEL,
    //! <summary>Processing, acquisition or final release failed.</summary>
    FAILURE
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>