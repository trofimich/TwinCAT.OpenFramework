(*!
<summary>Identifies the cooperative task lifecycle.</summary>
<description>
READY permits Start, RUNNING covers work and cleanup, and STOPPED permits final-result inspection and Reset.
The default READY is not an already completed operation.
</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE TASK_STATE :
(
	//! <summary>Ready for a new Start request.</summary>
	READY := 0,
	//! <summary>Lifecycle active, including resource cleanup.</summary>
	RUNNING,
	//! <summary>Lifecycle ended; inspect FinalStopReason.</summary>
	STOPPED
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>