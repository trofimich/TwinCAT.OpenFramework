(*!
<summary>Provides a concrete FIFO task queue with public enqueueing.</summary>
<description>
Inherits cooperative execution, cancellation and reset from TaskQueue and uses no resource manager of its
own. Child objects are borrowed; the owner keeps them alive and prepared. This type is FINAL; use TaskQueue
for specialized queue behavior.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FINAL StandardTaskQueue EXTENDS TaskQueue
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{2edfd268-df4f-41f9-aef6-5aec377fffed}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bdddd8f6-e658-400e-a4a5-16ccab27e38b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Enqueue" Id="{cdf8e544-88b0-466c-84c0-eef4bbb8ce8c}">
      <Declaration><![CDATA[(*!
<summary>Adds a prepared READY child to the queue.</summary>
<description>
Null raises an exception. READY and uniqueness are caller preconditions, not checked here. The queue
controls the child's lifecycle until removal, without owning or deleting it. Do not drive the child
independently while queued. Reset a stopped queue before adding a new batch, because that Reset clears its
entries. Dynamic storage growth can raise terminal allocation failure.
</description>
<param name="task">Live READY task to run in FIFO order.</param>
*)
METHOD Enqueue
VAR_INPUT
	task : ITask;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[EnqueueTask(task);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{09dc716e-5580-4c60-8504-8027d84a23b2}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace for diagnostics.</summary>
<description>
Borrowed read-only reference to compiler-initialized namespace storage; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0c9b30bd-5848-4c38-b284-a2579e632128}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{27f24e8d-93c2-4b63-beaf-bbb71cead191}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete queue instance.</summary>
<description>
Does not include separately allocated list storage or child objects.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{aca67082-7f76-4409-a726-dcf164bb235b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>