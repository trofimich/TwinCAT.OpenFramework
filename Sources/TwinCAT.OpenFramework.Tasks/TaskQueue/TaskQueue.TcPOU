<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskQueue" Id="{022231a9-4d5c-485f-8036-933ca5fa0b31}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Executes borrowed child tasks sequentially in FIFO order.</summary>
<description>
One owner drives the queue and the lifecycles of its queued children. Children must be live, READY when
enqueued and unique in this queue; callers must not independently drive them while queued. Only one child is
active at a time. The dynamic list owns its storage but not child objects. Successful children are removed;
unsuccessful current and waiting entries remain until cleared or reset. Empty queues keep running unless
StopWhenNoPendingTasks is TRUE. All stop reasons advance the current child's cleanup without starting
waiting children. The base Task records a processing exception and enters STOPPING; OnStopping requests
child cancellation and waits for completion before parent release. An accepted external Cancel during that wait retains the
base Task cancellation result; the first failure is submitted to the log. No cleanup timeout is imposed.
Descendants overriding queue hooks must preserve the inherited queue operations.
</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK ABSTRACT TaskQueue EXTENDS Task
VAR
	{attribute 'hide'} 
	_SubTasks : TOF_Collections.List<0>(0);
	
	{attribute 'hide'} 
	_CurrentTask : ITask;
	
	{attribute 'hide'} 
	_StopWhenNoPendingTasks : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden members" Id="{87373d04-36a2-4d28-add4-3c2f57bc7828}" />
    <Folder Name="Service members" Id="{06274e03-41d8-4565-8c9c-96cb34fe5d89}" />
    <Method Name="ClearWaitingTasks" Id="{b798e4c5-1ea0-4f4b-9332-cbb30319d82c}">
      <Declaration><![CDATA[(*!
<summary>Removes waiting entries without resetting or deleting child objects.</summary>
<description>
While RUNNING with a current task, retains that first entry and removes the rest. Otherwise clears all
entries and the current reference. Does not request cancellation. A stopped unsuccessful current task is
removed when clearing outside RUNNING.
</description>
*)
METHOD FINAL ClearWaitingTasks
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT State.Running OR_ELSE _CurrentTask = 0 THEN
	_SubTasks.Clear();
	_CurrentTask := 0;
ELSE	
	FOR i := _SubTasks.Length - 1 TO 1 BY -1 DO
		_SubTasks.RemoveAt(i);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnqueueTask" Id="{dd1edab2-2601-428c-93c5-93955d43eb2f}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends a prepared borrowed task to the FIFO.</summary>
<description>
Null raises ArgumentNotSpecifiedException. READY and uniqueness are caller preconditions, not checked here.
Keep the child alive and do not start, execute, cancel or reset it independently while queued. Removal
transfers no ownership and does not reset or delete it. No queue-state guard is applied; Reset from STOPPED
clears entries, so prepare the queue before filling it for reuse. Storage growth can raise terminal
allocation failure.
</description>
<param name="task">Live READY child whose lifecycle is delegated to the queue until removal.</param>
*)
METHOD PROTECTED FINAL EnqueueTask
VAR_INPUT
	task : ITask;
END_VAR
VAR
	taskTypeNotSpecifiedException : TOF_Core.ArgumentNotSpecifiedException;
	
	taskAsGeneric : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF task = 0 THEN
	taskTypeNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'task');
END_IF

taskAsGeneric := TOF_Core.GenericValueFactory.FromParts(TOF_Core.GENERIC_TYPE_CLASS.OBJECT, task.SelfAddress, task.SelfSize, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);

_SubTasks.AppendGeneric(taskAsGeneric);]]></ST>
      </Implementation>
    </Method>
    <Method Name="getTaskByIndex" Id="{cd04d130-57fe-4818-a5b7-e32f1a5e2b67}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Resolves one stored entry to its task interface.</summary>
<description>
Requires a valid zero-based index and a live borrowed child. List access rejects an invalid index; failure
to query ITask raises StandardException. Does not clone or transfer ownership.
</description>
<param name="index">Index within the queue's current list.</param>
*)
METHOD PRIVATE getTaskByIndex : ITask
VAR_INPUT
	index : DINT;
END_VAR
VAR
	taskInterface : TOF_Core.IObject;
	
	toITaskConversionNotSupportedException : TOF_Core.StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskInterface := _SubTasks.Get(index).AsIObject();

IF NOT __QUERYINTERFACE(taskInterface, getTaskByIndex) THEN
	toITaskConversionNotSupportedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Can't convert task from _Tasks collection to ITask type");
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{535bd2ee-e5c8-4b16-a824-27dc49f7d538}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Cancels and advances the current child before any parent termination.</summary>
<description>
Called by the common STOPPING phase after any result or exception. Never starts waiting children. Requests
Cancel while the child is RUNNING, then advances it once. A Cancel exception is contained so Execute still
gets a chance to progress; readiness remains FALSE for that call. Execute exceptions reach the base stopping
handler, which retains the original result and retries. Refusal of Cancel does not imply completion.
No child is removed or reset here. Additional descendant cleanup must combine readiness with this result.
</description>
<param name="readyToRelease">TRUE when no child is RUNNING and this stopping step completed normally.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR
VAR
	cancelCallFailed : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentTask <> 0 AND_THEN _CurrentTask.State.Running THEN
	__TRY
		_CurrentTask.Cancel();
	__CATCH
		// Advance the child even if its cancellation request was interrupted.
		cancelCallFailed := TRUE;
	__ENDTRY

	_CurrentTask.Execute();
END_IF

readyToRelease := NOT cancelCallFailed
	AND_THEN (_CurrentTask = 0 OR_ELSE NOT _CurrentTask.State.Running);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCancelRequest" Id="{86d21a87-30df-4ecc-9666-f132ccbf24fc}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Forwards an accepted queue cancellation to its running child.</summary>
<description>
Called once by the task's Cancel path. Does not wait or inspect the child's refusal message; a child already
stopping can refuse another cancellation request. OnStopping advances completion. Preserve forwarding when
overriding this hook.
</description>
*)
METHOD PROTECTED OnCancelRequest]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentTask <> 0 AND_THEN _CurrentTask.State.Running THEN
	_CurrentTask.Cancel();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{77d5a316-a3d7-4b72-abf0-f45fddad039f}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Clears a stopped queue for reuse.</summary>
<description>
Releases list storage and drops current and waiting references without resetting or deleting children. Their
owner prepares them before re-enqueueing. Base Reset clears stop diagnostics. READY Reset
does not invoke this hook; use ClearWaitingTasks to empty a READY queue. Descendants must preserve this step.
</description>
*)
METHOD PROTECTED OnReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SubTasks.Clear();
_CurrentTask := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{caddc2fa-80a1-43cf-b16f-1400efcc8f23}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Starts or advances at most one current child per processing call.</summary>
<description>
An existing current child receives one Execute. Otherwise the first waiting child is selected and started;
newly started work is advanced by a later call. Start refusal or an unexpected READY current yields ERROR.
A successful stopped child is removed; other results are mapped from FinalStopReason and its message.
An empty queue yields DONE only when StopWhenNoPendingTasks is TRUE. Removing the last successful child
leaves BUSY until the next call. Exceptions propagate to the base Task failure handler, which records and
logs diagnostics and enters STOPPING. OnStopping waits for child cleanup before parent release.
</description>
<param name="processingState">Queue progress; defaults to BUSY while waiting or advancing a child.</param>
<param name="stopReasonMessage">Receives child refusal or unsuccessful completion diagnostics.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentTask <> 0 THEN
	_CurrentTask.Execute();
ELSIF _SubTasks.Length > TOF_Core.SignedInt32.ZERO THEN
	_CurrentTask := getTaskByIndex(0);

	IF NOT _CurrentTask.Start(refuseReason => stopReasonMessage) THEN
		processingState := TASK_PROCESSING_STATE.ERROR;
		RETURN;
	END_IF
ELSIF _StopWhenNoPendingTasks THEN
	processingState := TASK_PROCESSING_STATE.DONE;
END_IF

IF _CurrentTask <> 0 THEN
	CASE _CurrentTask.State.Value OF
		TASK_STATE.READY:
			processingState := TASK_PROCESSING_STATE.ERROR;
			stopReasonMessage := "Current task returned to READY before completion";

		TASK_STATE.STOPPED:
			IF _CurrentTask.FinalStopReason.WorkDone THEN
				removeCurrentTask();
			ELSE
				processingState := GetProcessingStateByStopReason(_CurrentTask.FinalStopReason.Value);
				stopReasonMessage := _CurrentTask.FinalStopReason.Message;
			END_IF
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="PendingTaskCount" Id="{2038ab95-2e50-4179-a754-1d1cc97697ad}">
      <Declaration><![CDATA[(*!
<summary>Reports the number of entries still retained by the queue.</summary>
<description>
Includes the current task and waiting children, including a failed or cancelled current retained after
stopping. Zero does not by itself mean the queue has reached STOPPED.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL PendingTaskCount : DINT]]></Declaration>
      <Get Name="Get" Id="{771aaa60-c187-4100-b7c8-70432db59981}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PendingTaskCount := _SubTasks.Length;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="removeCurrentTask" Id="{3d0dfaf2-e80b-4d5e-a44a-7f243e73f6b8}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Removes the first queue entry and clears the current reference.</summary>
<description>
Used after successful child completion. Compacts remaining list entries without resetting or deleting the
child; the caller retains its object and may inspect its stopped result. Does not start the next child.
</description>
*)
METHOD PRIVATE removeCurrentTask]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _SubTasks.Length > 0 THEN
	_SubTasks.RemoveAt(0);
END_IF

_CurrentTask := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="StopWhenNoPendingTasks" Id="{88898ba4-339d-4e7d-ad5c-2ad26acedd0e}">
      <Declaration><![CDATA[(*!
<summary>Controls whether an empty running queue completes.</summary>
<description>
Defaults to FALSE, allowing Execute to wait for later enqueueing. TRUE makes OnRunning report DONE when it
finds no current or waiting child. May be changed between owner calls; setting it does not itself execute or
stop the queue.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL StopWhenNoPendingTasks : BOOL]]></Declaration>
      <Get Name="Get" Id="{e11d548f-9f11-44b2-98c2-153ff14511f3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StopWhenNoPendingTasks := _StopWhenNoPendingTasks;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{8155d48a-5e36-4cd2-9d1d-ee03111c46a4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_StopWhenNoPendingTasks := StopWhenNoPendingTasks;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>