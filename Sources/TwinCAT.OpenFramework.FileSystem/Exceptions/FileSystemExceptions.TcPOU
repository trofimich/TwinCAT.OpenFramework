<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileSystemExceptions" Id="{dd62c6ab-3d90-4ca9-9192-7d723cc3b5f8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides static helper methods for throwing FileSystem-specific exceptions.</summary>
<description>Constructs stack-local template exceptions, formats diagnostics without heap allocation and propagates them through ExceptionManager.</description>
*)

PROGRAM FileSystemExceptions
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ThrowInvalidPath" Id="{cab3ac12-7ebf-48ed-a71e-7ca691e520c2}">
      <Declaration><![CDATA[(*!
<summary>Raises an InvalidPathException without requiring a caller-owned exception variable.</summary>
<description>Constructs a temporary stack template and delegates to InvalidPathException.Throw.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="path">Rejected filesystem path.</param>
<param name="errorMessage">Diagnostic explanation.</param>
*)
METHOD ThrowInvalidPath
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	path : STRING(255);
END_VAR
VAR_INPUT
	errorMessage : WSTRING(255);
END_VAR
VAR
	exception : InvalidPathException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, path, errorMessage);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ThrowFileSystem" Id="{09d909ba-c131-4a7e-8485-2eace484a12d}">
      <Declaration><![CDATA[(*!
<summary>Raises a FileSystemException without requiring a caller-owned exception variable.</summary>
<description>Constructs a temporary stack template and delegates to FileSystemException.Throw.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
<param name="errorCode">Native/ADS error code, or 0 if unassigned.</param>
*)
METHOD ThrowFileSystem
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	errorCode : UDINT := 0;
END_VAR
VAR
	exception : FileSystemException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, errorCode);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
