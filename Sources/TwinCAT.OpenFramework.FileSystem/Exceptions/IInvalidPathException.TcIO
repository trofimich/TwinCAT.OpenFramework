<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IInvalidPathException" Id="{4fabf056-d31d-48b6-bc73-597bed22690b}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes diagnostics for a rejected filesystem path.</summary>
<description>Diagnostic string inputs are borrowed only during the call; retained diagnostic text is copied into owned storage.</description>
*)
INTERFACE IInvalidPathException EXTENDS TOF_Core.IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{3aecdf47-2204-47ee-b3e1-2f24c9af88aa}">
      <Declaration><![CDATA[(*!
<summary>Processes the supplied diagnostic message without copying the input buffer.</summary>
<description>Long diagnostic strings are borrowed read-only for this call; their references are not retained. Pass variables or literals, and store computed expressions in local variables before calling.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	path : STRING(255);
END_VAR
VAR_IN_OUT
	errorMessage : WSTRING(255);
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>