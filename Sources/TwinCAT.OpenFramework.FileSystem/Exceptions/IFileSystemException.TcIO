<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IFileSystemException" Id="{e19a417b-93ac-4de8-ab10-1ffe7ab820cc}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes diagnostics for a filesystem operation failure.</summary>
<description>Reports caller-detected filesystem errors, such as ADS/OS errors, using the GeneralException lifetime and throw rules. Message is borrowed read-only during the call; errorCode holds the operation failure code.</description>
*)
INTERFACE IFileSystemException EXTENDS TOF_Core.IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{32ed7145-c7ac-4c6a-b9a8-1f5f7c35c02d}">
      <Declaration><![CDATA[(*!
<summary>Raises an exception describing the filesystem failure.</summary>
<description>Borrows message read-only for this call and records the numeric error code. Retains formatted diagnostic text. The caller detects the filesystem error; this method propagates it.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
<param name="errorCode">Native/ADS error code, or 0 if unassigned.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	errorCode : UDINT := 0;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
