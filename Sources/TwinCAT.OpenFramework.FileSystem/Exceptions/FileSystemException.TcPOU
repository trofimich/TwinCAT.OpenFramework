<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileSystemException" Id="{ae1bbb4c-25c9-4ede-b477-d4e2dbf3bbcb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports an error occurring during filesystem operations.</summary>
<description>Reports caller-detected filesystem failures using the GeneralException lifetime and throw rules. Message is borrowed read-only during the call; errorCode stores the native/ADS error identifier. Dynamic instances and clones belong to DynamicMemoryManager until task cleanup. Plain __NEW does not transfer ownership to the task manager.</description>
*)

{attribute 'enable_dynamic_creation'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FileSystemException EXTENDS TOF_Core.GeneralException IMPLEMENTS IFileSystemException
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{376ea995-58b5-4c78-90b1-69650a357d0d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{80c7e1c5-bd06-4d91-a5f8-ba7a9104a58f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{e792337e-6253-4b91-87c8-846b83c3e742}">
      <Declaration><![CDATA[(*!
<summary>Creates a task-owned copy of this exception and its diagnostic payload.</summary>
<description>Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence. The returned reference is borrowed until task cleanup and must not be deleted by the caller.</description>
*)
METHOD Clone : TOF_Core.IObject
VAR
	exceptionClone : POINTER TO FileSystemException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(FileSystemException);

IF exceptionClone = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

TOF_Core.DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{e661210f-f8c8-4dcc-89b3-816483dc0fc7}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5fc180fe-9746-4cb8-bd97-0a075e11695c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{bbfec0e7-f859-42a0-936a-da63ff5b72d3}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{11aae084-3af3-48d8-b045-b79955e6f600}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{1f875777-9d21-4766-ab74-aa42509cccbd}">
      <Declaration><![CDATA[(*!
<summary>Raises a filesystem exception with the supplied message and error code.</summary>
<description>Borrows message read-only for this call and records the numeric error code. Formats diagnostic text without heap allocation during message preparation; does not retain the input reference. The caller detects the filesystem error; this method propagates it.</description>
<param name="sourceNamespaceName">Namespace of the caller.</param>
<param name="sourceClassName">Class name of the caller.</param>
<param name="sourcePOUName">POU name of the caller.</param>
<param name="sourcePosition">Source position of the caller.</param>
<param name="message">Diagnostic explanation.</param>
<param name="errorCode">Native/ADS error code, or 0 if unassigned.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	errorCode : UDINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, errorCode, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
