<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="InvalidPathException" Id="{548744c4-a8a9-4007-b2c1-225cf445257a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports a rejected filesystem path and its diagnostic explanation.</summary>
<description>Reports caller-detected path errors using the GeneralException lifetime and throw rules. The path is borrowed during the call; errorMessage is copied by value. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK InvalidPathException EXTENDS TOF_Core.GeneralException IMPLEMENTS IInvalidPathException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{6d3da3bd-a6e5-45c1-bda2-e3e02c19b687}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{266b1451-a7f7-4677-9a17-074c37418502}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{bd9b6470-1f00-427e-b60b-49934c91d8f4}">
      <Declaration><![CDATA[(*!
<summary>Creates a task-owned copy of this exception and its diagnostic payload.</summary>
<description>Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence. The returned reference is borrowed until task cleanup and must not be deleted by the caller.</description>
*)
METHOD Clone : TOF_Core.IObject
VAR
	exceptionClone : POINTER TO InvalidPathException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(InvalidPathException);

IF exceptionClone = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

TOF_Core.DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{40a5cc6f-fd53-4b14-9f42-0450d3eda511}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{10e0e80e-3bc6-4cdb-a3c8-368be4e2bfe9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{63d69ff8-6f79-48c9-ace4-f2c04e14a203}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{71d83967-5c13-49fa-897c-5f7133252b44}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{d47f41f8-35c7-48fd-869f-e96f29dd4029}">
      <Declaration><![CDATA[(*!
<summary>Raises an exception describing the rejected path and its reason.</summary>
<description>Borrows path read-only for this call and copies errorMessage by value, limited to 255 characters. Retains formatted diagnostic text, not the input reference. The caller detects the invalid path; this method does not validate it.
The local diagnostic builder is released after copying the formatted text and before InternalThrow transfers control to the exception handler.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	path : STRING(255);
END_VAR
VAR_INPUT
	errorMessage : WSTRING(255);
END_VAR
VAR
	stringBuilder : TOF_Core.WideStringBuilder;
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString("Invalid path ")
	.AppendString255(STRING_TO_WSTRING('$22'))
	.AppendString255(STRING_TO_WSTRING(path))
	.AppendString255(STRING_TO_WSTRING('$22: '))
	.Append(errorMessage)
	.AssignToString(message);

(* An exception skips FB_exit for this local builder; release its buffer before Throw. *)
stringBuilder.Clear(releaseMemory := TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>