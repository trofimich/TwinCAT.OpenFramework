<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IFileSystemTask" Id="{9c00ffee-8699-4214-a02b-b55274e82ffa}">
    <Declaration><![CDATA[(*!
<summary>Provides task execution with a configured file-system target and operation timeout.</summary>
<description>Before online change, the application must stop submitting new work and keep advancing
each running task through completion and cleanup. Keep its configuration, borrowed objects and buffers
alive until then. Drive queued children only through their owning queue. File-content tasks also require
their resource owner to finish release; a stopped child alone does not close its file.
Online change with pending native operations or retained open resources is unsupported. This is an
application precondition, not an automatic online-change guard. Completed best-effort cleanup does not
certify physical resource release after a native close or enumeration-abort failure.</description>
*)
INTERFACE IFileSystemTask EXTENDS TOF_Tasks.ITask]]></Declaration>
    <Property Name="AmsNetId" Id="{67da093e-7fbc-4086-bd94-17e58d77fb19}">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Configure before execution and keep stable through stopping. File-content tasks obtain the effective target from their bound resource; assigning this property does not retarget an acquired file.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{67874916-c8b4-433e-bf54-da8715bc7c70}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{b656d654-3192-426d-bf05-19cbe72538b9}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Property Name="Timeout" Id="{1917d497-41b7-46ed-a4b8-c636530f3b0a}">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Implementations apply this value to their native requests. Configure before execution and keep stable through stopping; it is not a deadline for the entire task lifecycle.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{8fde4042-033f-49d3-bfff-947c1f6e13bf}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{0225f65b-466b-48a2-889b-fe867eb9595b}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
  </Itf>
</TcPlcObject>