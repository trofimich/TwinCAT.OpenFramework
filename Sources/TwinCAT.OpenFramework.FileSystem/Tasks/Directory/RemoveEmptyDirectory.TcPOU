(*!
<summary>Removes an empty filesystem directory through cyclic task execution.</summary>
<description>Configure DirectoryPath, PathType, AmsNetId and Timeout before Start and keep them unchanged
until STOPPED. The path must be nonblank and pass PathHelper's limited lexical filter; native services
determine whether the requested operation is supported. This task does not perform an existence precheck
or suppress native errors. Invalid configuration and native errors use the base Task failure and cleanup
path. Cancellation waits for submitted I/O without rolling back completed filesystem changes.
Reset clears the native request state and preserves configuration. Use one owner task per instance.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RemoveEmptyDirectory EXTENDS TOF_Tasks.Task IMPLEMENTS IFileSystemTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

    _RemoveDirectory : Tc2_System.FB_RemoveDir;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{3c1b2bb2-508a-43ab-aba6-d51610d36987}" />
    <Folder Name="Members to override" Id="{80e81cc0-48cb-4c8d-a6d2-f5019c2649ac}" />
    <Property Name="AmsNetId" Id="{e619447a-91f5-4cfd-87c1-c6f4d65469a7}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Configure before Start and keep unchanged until STOPPED; the setter stores configuration without submitting I/O.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{af838fb5-84a9-40c2-96ed-bb37e1ba8ee8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _RemoveDirectory.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{955f8a77-cfbb-437a-a3ea-c4c2072c8db2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{9bdfd013-5a24-4a24-9847-b8d276cbdfd1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{07f43309-f5f9-4714-8a79-b20e37081f91}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="DirectoryPath" Id="{d94128c9-a1f4-40bf-a870-d7916c828353}" FolderPath="Inputs\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Provides the copied path for the next directory operation.</summary>
<description>Set before Start and keep unchanged until STOPPED. Checked by PathHelper before submission,
then interpreted by the native service using PathType. Assignment does not perform I/O; Reset preserves it.</description>
*)
PROPERTY DirectoryPath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{1f72f3d7-a990-4668-a6c3-c54f2f298ded}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[DirectoryPath := _RemoveDirectory.sPathName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{39cb2b34-0284-49a9-954b-190ef76241ef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.sPathName := DirectoryPath;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{c30ceec4-6b12-4987-9c9a-253d7cedcfe2}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5de19f01-2439-4806-bb38-5c646f83ed28}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnReset" Id="{054f9fa5-a632-419e-a47f-3fd2edb96643}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Resets the native request edge after the task has stopped.</summary>
<description>Preserves configured inputs and does not undo completed filesystem effects. Pending I/O must finish during stopping before this hook runs.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RemoveDirectory(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{df915afb-aa65-445f-a579-78975326fa79}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Validates the configured path and advances the native empty-directory removal request.</summary>
<description>Computed diagnostic strings are held in local buffers for the duration of the receiving call without dynamic string-builder allocations.</description>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR	
	pathErrorMessage : WSTRING(255);
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _RemoveDirectory.bExecute THEN 
	IF TOF_Core.Strings.IsNullOrWhiteSpace(_RemoveDirectory.sPathName) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'DirectoryPath');		
	END_IF
	
	IF NOT PathHelper.IsValidDirectoryPath(_RemoveDirectory.sPathName, errorMessage => pathErrorMessage) THEN
		FileSystemExceptions.ThrowInvalidPath(NamespaceName, ClassName, __POUNAME(), __POSITION(), _RemoveDirectory.sPathName, pathErrorMessage);
	END_IF
END_IF

_RemoveDirectory(bExecute := TRUE);

IF _RemoveDirectory.bError THEN
	TOF_Core.WideStrings.Append255(
		formattedExceptionMessage,
		"An while removing directory '",
		TO_WSTRING(_RemoveDirectory.sPathName),
		"'");

	FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _RemoveDirectory.nErrId);
END_IF

IF NOT _RemoveDirectory.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{d399643c-23a2-4f0b-a5c6-299e72a07996}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Waits for an already submitted operation before task termination.</summary>
<description>
Runs for every stop reason. Advances the pending FB with bExecute=FALSE without issuing another request.
Completion does not roll back side effects. Keep configuration and borrowed buffers valid until STOPPED.
</description>
<param name="readyToRelease">TRUE when the underlying FB is no longer busy.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _RemoveDirectory.bBusy THEN
	_RemoveDirectory(bExecute := FALSE);
END_IF

readyToRelease := NOT _RemoveDirectory.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Property Name="PathType" Id="{2b9d54ab-fa46-41da-ac42-cdc7d5acef43}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the native path context for the filesystem request.</summary>
<description>Configure before Start and keep unchanged until STOPPED. It is passed to the native operation, not used as a path-validity result. Reset preserves it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PathType : Tc2_System.E_OpenPath]]></Declaration>
      <Get Name="Get" Id="{6baf4074-7f57-4b46-a346-9359d4fc170d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PathType := _RemoveDirectory.ePath;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{7a03c98f-e798-4494-b934-37bb17268ced}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.ePath := PathType;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SelfSize" Id="{9adbdd4e-26f1-45e1-9314-6ac5a9fcf883}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7af252a4-6350-4943-9c1e-b0b9f893fccd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{c5f42126-d467-415e-a93a-fa9d11d77a43}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{3464bdc4-4947-406d-8d6a-94c7e64bc5b4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _RemoveDirectory.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{67cf6448-3dc3-4665-a07b-57b154ad6605}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>