{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Creates a filesystem directory through cyclic task execution.</summary>
<description>Configure DirectoryPath, PathType, AmsNetId and Timeout before Start and keep them unchanged
until STOPPED. The path must be nonblank and pass PathHelper's limited lexical filter; native services
determine whether the requested operation is supported. This task does not perform an existence precheck
or suppress native errors. Invalid configuration and native errors use the base Task failure and cleanup
path. Cancellation waits for submitted I/O without rolling back completed filesystem changes.
Reset clears the native request state and preserves configuration. Use one owner task per instance.</description>
*)
FUNCTION_BLOCK CreateDirectory EXTENDS TOF_Tasks.Task IMPLEMENTS IFileSystemTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

    _CreateDirectory : Tc2_System.FB_CreateDir;

	{attribute 'hide'} 
	_DirectoryPathNotSpecifiedException :	TOF_Core.DataMemberNotSpecifiedException;
	{attribute 'hide'} 
	_InvalidPathException : InvalidPathException;	
	{attribute 'hide'} 
	_CreateDirectoryException : TOF_Core.StandardException;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{cd46d3f1-05ad-4d2a-bb18-250033ee445c}" />
    <Folder Name="Members to override" Id="{740079d8-792c-4051-b807-b10023f9c7a1}" />
    <Property Name="AmsNetId" Id="{ed338df4-10dc-451a-b64d-a000a295e7f0}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Configure before Start and keep unchanged until STOPPED; the setter stores configuration without submitting I/O.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{94b5c541-fb9b-4788-a387-16d6d7a06a3f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _CreateDirectory.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{477e135b-e114-4f7b-ae5e-413843dd690f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{68947efb-286a-42af-a556-a0bbd5d3027a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{40a07058-94c4-4be0-ab88-a373f33d3011}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="DirectoryPath" Id="{7d34ff6b-66c9-43e2-9ce1-01d401372e05}" FolderPath="Inputs\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Provides the copied path for the next directory operation.</summary>
<description>Set before Start and keep unchanged until STOPPED. Checked by PathHelper before submission,
then interpreted by the native service using PathType. Assignment does not perform I/O; Reset preserves it.</description>
*)
PROPERTY DirectoryPath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{bfb35ddc-0143-4123-989c-469790325d20}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[DirectoryPath := _CreateDirectory.sPathName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f1f98b86-e1b0-48a8-a264-70f11718c110}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.sPathName := DirectoryPath;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{ea279b18-2495-419a-af6e-f1db1538b308}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{affba913-0ba6-4588-83ed-6a9649f3e1dc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnStopping" Id="{41f71629-0447-4447-a2fb-74c1ee110012}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Waits for an already submitted operation before task termination.</summary>
<description>
Runs for every stop reason. Advances the pending FB with bExecute=FALSE without issuing another request.
Completion does not roll back side effects. Keep configuration and borrowed buffers valid until STOPPED.
</description>
<param name="readyToRelease">TRUE when the underlying FB is no longer busy.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CreateDirectory.bBusy THEN
	_CreateDirectory(bExecute := FALSE);
END_IF

readyToRelease := NOT _CreateDirectory.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{8a28ceca-ec54-49f2-97aa-c7a5fc415861}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Resets the native request edge after the task has stopped.</summary>
<description>Preserves configured inputs and does not undo completed filesystem effects. Pending I/O must finish during stopping before this hook runs.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CreateDirectory(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{6bd810fa-872b-4e47-b2bc-32ff3c16f403}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Validates the configured path and advances the native directory-create request.</summary>
<description>Computed diagnostic strings are held in local buffers for the duration of the receiving call.
The local diagnostic builder is released after copying its message and before raising the operation exception.</description>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR	
	pathErrorMessage : WSTRING(255);
	errorMessageBuilder : TOF_Core.WideStringBuilder;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _CreateDirectory.bExecute THEN 
	IF TOF_Core.Strings.IsNullOrWhiteSpace(_CreateDirectory.sPathName) THEN
		_DirectoryPathNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'DirectoryPath');		
	END_IF
	
	IF NOT PathHelper.IsValidDirectoryPath(_CreateDirectory.sPathName, errorMessage => pathErrorMessage) THEN
		_InvalidPathException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), _CreateDirectory.sPathName, pathErrorMessage);
	END_IF
END_IF

_CreateDirectory(bExecute := TRUE);

IF _CreateDirectory.bError THEN
	errorMessageBuilder
		.AppendString("Error while creating directory '")
		.Append(_CreateDirectory.sPathName)
		.AppendString("'");

	formattedExceptionMessage := errorMessageBuilder.ToString255();

	(* An exception skips FB_exit for this local builder; release its buffer before Throw. *)
	errorMessageBuilder.Clear(releaseMemory := TRUE);

	_CreateDirectoryException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _CreateDirectory.nErrId);
ELSIF NOT _CreateDirectory.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="PathType" Id="{813cddba-24ae-417e-a32e-8078530fc9b5}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the native path context for the filesystem request.</summary>
<description>Configure before Start and keep unchanged until STOPPED. It is passed to the native operation, not used as a path-validity result. Reset preserves it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PathType : Tc2_System.E_OpenPath]]></Declaration>
      <Get Name="Get" Id="{26543d70-59ee-403c-af69-d4faa3e2e712}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PathType := _CreateDirectory.ePath;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{fc38db83-a1b0-4341-9146-45fe2533fa6e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.ePath := PathType;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SelfSize" Id="{ff29508a-b927-484d-8776-c7a1fd61b57a}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9fd144e1-4541-4668-9bfe-274b7a79cf1d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{78fb4594-c887-4181-a8a6-4363e1f0945e}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{8affc407-c0f2-46cc-acef-d2a177ecaf4b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _CreateDirectory.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0f89e125-a68f-47d7-ab94-803cd70c6f9c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>