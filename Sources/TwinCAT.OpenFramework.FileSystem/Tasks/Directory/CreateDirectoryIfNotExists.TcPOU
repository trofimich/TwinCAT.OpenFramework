(*!
<summary>Creates a filesystem directory when it is absent.</summary>
<description>An existing directory completes after native enumeration has been closed. Pending search and
create commands finish before stopping. Diagnostic string inputs are borrowed only during the call; retained
diagnostic text is copied into owned storage. A found file produces FAILURE without starting create I/O; stopping closes the enumeration before task completion.
The existence check and subsequent filesystem change are separate, non-atomic operations. Another actor may
change the same path between them. Native errors from the subsequent create/remove are reported as failure;
this wrapper does not retry or reinterpret them as a successful race. Coordinate access externally when
other tasks or processes can modify the same path. Cancellation does not roll back completed filesystem effects.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK CreateDirectoryIfNotExists EXTENDS TOF_Tasks.Task IMPLEMENTS IFileSystemTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	_DirectoryChecking : BOOL;

	_EnumFindFile : Tc2_Utilities.FB_EnumFindFileEntry;
	//! <summary>Records whether a search command may still own native enumeration resources.</summary>
	_EnumerationStarted : BOOL;
	//! <summary>Prevents repeating the abort command while its completion is pending.</summary>
	_EnumerationAbortIssued : BOOL;

    _CreateDirectory : Tc2_System.FB_CreateDir;
	
	_DirectoryExists : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{72162f8c-3af3-4e02-a1df-ddb19e10bd0b}" />
    <Folder Name="Members to override" Id="{29ed9959-faf9-4eea-b64e-16ca8bd7bdba}" />
    <Property Name="AmsNetId" Id="{75963665-ee78-4fa8-a8ba-a263ce85ed58}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Configure before Start and keep unchanged until STOPPED; the setter stores configuration without submitting I/O.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{0b9656a1-b5da-48f1-9686-5e89cf9ab0d9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _CreateDirectory.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f29eb289-785a-4011-b830-23d4654b92c7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.sNetId := AmsNetId;
_EnumFindFile.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{772c2bee-42a6-4b44-92e1-e2e3ac0fe305}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d48ae1e0-1512-4f1c-8848-d5007082ea9b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="DirectoryPath" Id="{bbc57fd0-372a-4fb8-959e-d17da5c5fd0b}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Provides the copied directory path used by the operation and its existence check.</summary>
<description>Configure before Start and keep unchanged until STOPPED. PathHelper applies its limited lexical filter before native submission. Assignment does not perform I/O; Reset preserves the path.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY DirectoryPath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{21cb0521-d7c0-4238-9bf6-9c5754a8dbce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[DirectoryPath := _CreateDirectory.sPathName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{cb2f5be1-cec7-44f0-9270-d8eb17c2dfce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.sPathName := DirectoryPath;
_EnumFindFile.sPathName := DirectoryPath;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{04f57de5-c180-43a5-bd15-dc10f66128a4}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{58e477c6-a257-4ee5-b1c0-efb60743e4d8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnStopping" Id="{8ce7764f-d460-43ce-8459-94d4022daa55}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Advances directory stop actions before reporting termination.</summary>
<description>
Used for every stop reason. Drains a pending search, then issues an abort with a rising bExecute edge if the
search ended before bEOE without error. Waits for abort and any pending create operation before termination;
no new ordinary create request starts.

An abort error is logged once with its native code and path, without retrying abort or replacing the task
stop reason. Readiness means this cleanup attempt ended, not that server resources were proven released.
The log attempt is made after clearing pending enumeration state; logger failure does not restart cleanup.</description>
<param name="readyToRelease">TRUE when the directory FBs have finished their pending requests.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR
VAR
	enumerationAbortMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _EnumerationStarted THEN
	_EnumFindFile(bExecute := FALSE);

	IF NOT _EnumFindFile.bBusy THEN
		IF _EnumFindFile.bEOE OR_ELSE _EnumFindFile.bError THEN
			_EnumerationStarted := FALSE;

			(* End this attempt before reporting its error so logging cannot cause repeated aborts. *)
			IF _EnumerationAbortIssued AND_THEN _EnumFindFile.bError THEN
				enumerationAbortMessage := TOF_Core.WideStrings.Concat255("Directory enumeration abort failed (native error code ", TO_WSTRING(_EnumFindFile.nErrId), "): ", TO_WSTRING(_EnumFindFile.sPathName));
				TOF_Core.LogManager.TryLogMessage(enumerationAbortMessage, TOF_Core.LOG_CATEGORY.ERROR, TO_WSTRING(__POUNAME()));
			END_IF
		ELSIF NOT _EnumerationAbortIssued THEN
			_EnumFindFile(bExecute := TRUE, eCmd := Tc2_Utilities.E_EnumCmdType.eEnumCmd_Abort);
			_EnumerationAbortIssued := TRUE;
		ELSE
			_EnumerationStarted := FALSE;
		END_IF
	END_IF
END_IF

_CreateDirectory(bExecute := FALSE);

readyToRelease := NOT _EnumerationStarted AND_THEN NOT _CreateDirectory.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{984acbb0-ac08-4c31-ae33-c2a4be092b2d}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Clears completed directory operations and per-run enumeration cleanup state.</summary>
<description>Called only after stopping has completed; it does not abandon pending native I/O.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EnumFindFile(bExecute := FALSE);
_CreateDirectory(bExecute := FALSE);

_DirectoryChecking := FALSE;
_EnumerationStarted := FALSE;
_EnumerationAbortIssued := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{a3a8c06e-520b-42ce-91d6-56459af3271d}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Checks for a directory and creates it only if absent.</summary>
<description>Early discovery leaves native search cleanup to OnStopping. A missing directory begins a create
request after bEOE. Computed diagnostics are held in local buffers for the receiving call without dynamic string-builder allocations.
A found file returns ERROR with a diagnostic message and leaves enumeration cleanup to OnStopping; no create request starts.</description>
<param name="processingState">BUSY while searching or creating; DONE when no create is needed or creation ends; ERROR when the path refers to a file.</param>
<param name="stopReasonMessage">Receives diagnostics when the path refers to a file; native failures use exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
	pathErrorMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _EnumFindFile.bExecute THEN 
	IF TOF_Core.Strings.IsNullOrWhiteSpace(_EnumFindFile.sPathName) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'DirectoryPath');		
	END_IF
	
	IF NOT PathHelper.IsValidDirectoryPath(_EnumFindFile.sPathName, errorMessage => pathErrorMessage) THEN
		FileSystemExceptions.ThrowInvalidPath(NamespaceName, ClassName, __POUNAME(), __POSITION(), _EnumFindFile.sPathName, pathErrorMessage);
	END_IF
	
	_DirectoryChecking := TRUE;
	
	_EnumFindFile.eCmd := Tc2_Utilities.E_EnumCmdType.eEnumCmd_First;
END_IF

IF _DirectoryChecking THEN
	_EnumerationStarted := TRUE;
	_EnumFindFile(bExecute := TRUE);
	
	IF _EnumFindFile.bError THEN
		TOF_Core.WideStrings.Append255(
			formattedExceptionMessage,
			"Error while checking directory '",
			TO_WSTRING(_EnumFindFile.sPathName),
			"'");

		FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _EnumFindFile.nErrId);
	ELSIF NOT _EnumFindFile.bBusy THEN	
		_DirectoryChecking := FALSE;
		
		IF NOT _EnumFindFile.bEOE THEN
			IF _EnumFindFile.stFindFile.fileAttributes.bDirectory THEN
				processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
			ELSE
				stopReasonMessage := TOF_Core.WideStrings.Concat255("Directory path refers to a file: ", TO_WSTRING(_EnumFindFile.sPathName));
				processingState := TOF_Tasks.TASK_PROCESSING_STATE.ERROR;
			END_IF
		END_IF
	END_IF
ELSE
	_CreateDirectory(bExecute := TRUE);
	
	IF _CreateDirectory.bError THEN
		TOF_Core.WideStrings.Append255(
			formattedExceptionMessage,
			"Error while creating directory '",
			TO_WSTRING(_CreateDirectory.sPathName),
			"'");

		FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _CreateDirectory.nErrId);
	END_IF
	
	IF NOT _CreateDirectory.bBusy THEN
		processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
	END_IF	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="PathType" Id="{a54b04ec-cd7b-4e9f-80f0-572747084722}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the native path context for the filesystem request.</summary>
<description>Configure before Start and keep unchanged until STOPPED. It is passed to the native operation, not used as a path-validity result. Reset preserves it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PathType : Tc2_System.E_OpenPath]]></Declaration>
      <Get Name="Get" Id="{7fcc77cc-b8d7-426d-90c6-e24e5f35b2ef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PathType := _CreateDirectory.ePath;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1a3ec1ca-d584-4c58-8d28-770af096da1b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.ePath := PathType;
_EnumFindFile.ePath := PathType;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SelfSize" Id="{38591cca-9b5a-41c8-a1d9-7b4c7612af64}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{32dce6e7-8b10-424c-92ef-410388921835}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{cc9ba0bc-ae72-498e-846f-abe517e54417}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{38b82f1c-e29c-4d4c-9d19-e22b6f2bb4e5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _CreateDirectory.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{e2e7c00a-b69b-4048-80db-cd8a15155a3b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CreateDirectory.tTimeout := Timeout;
_EnumFindFile.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
