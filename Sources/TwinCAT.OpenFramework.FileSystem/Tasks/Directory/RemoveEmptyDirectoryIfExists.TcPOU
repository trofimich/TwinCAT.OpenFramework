(*!
<summary>Removes an empty filesystem directory when it exists.</summary>
<description>Closes native enumeration before starting removal when a directory is found. Pending search and
remove commands finish before stopping. Diagnostic string inputs are borrowed only during the call; retained
diagnostic text is copied into owned storage. A found file produces FAILURE without starting remove I/O; stopping closes the enumeration before task completion.
The existence check and subsequent filesystem change are separate, non-atomic operations. Another actor may
change the same path between them. Native errors from the subsequent create/remove are reported as failure;
this wrapper does not retry or reinterpret them as a successful race. Coordinate access externally when
other tasks or processes can modify the same path. Cancellation does not roll back completed filesystem effects.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RemoveEmptyDirectoryIfExists EXTENDS TOF_Tasks.Task IMPLEMENTS IFileSystemTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	_DirectoryChecking : BOOL;

	_EnumFindFile : Tc2_Utilities.FB_EnumFindFileEntry;
	//! <summary>Records whether a search command may still own native enumeration resources.</summary>
	_EnumerationStarted : BOOL;
	//! <summary>Prevents repeating the abort command while its completion is pending.</summary>
	_EnumerationAbortIssued : BOOL;

    _RemoveDirectory : Tc2_System.FB_RemoveDir;
	
	//! <summary>Latches a found directory for this run so removal cannot restart the search.</summary>
	_DirectoryFound : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{d200b53b-8744-4aec-a14f-974a3034cb08}" />
    <Folder Name="Members to override" Id="{cc1622b5-e5a9-4d21-bf84-f83314a6ce15}" />
    <Property Name="AmsNetId" Id="{33231476-36a5-497a-ad7e-750d17c5c35d}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Configure before Start and keep unchanged until STOPPED; the setter stores configuration without submitting I/O.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{1978e639-b3c0-4847-b3ac-848b3950a1fd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _RemoveDirectory.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f4f785d0-4431-4006-af5e-c473578857ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.sNetId := AmsNetId;
_EnumFindFile.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{da884c8d-da0e-4446-94de-815bc91103e8}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a8949b15-b2e5-4f29-9b77-c837795d25ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="DirectoryPath" Id="{75ef4a85-8d55-4cbe-9c46-42cf48e4c999}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Provides the copied directory path used by the operation and its existence check.</summary>
<description>Configure before Start and keep unchanged until STOPPED. PathHelper applies its limited lexical filter before native submission. Assignment does not perform I/O; Reset preserves the path.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY DirectoryPath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{84eab205-7aae-495a-a1ac-ded926a76e89}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[DirectoryPath := _RemoveDirectory.sPathName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1e71b4db-02b2-47c0-ae6c-e0456e486b42}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.sPathName := DirectoryPath;
_EnumFindFile.sPathName := DirectoryPath;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{1b6339d2-f773-4d94-add3-a19851648e80}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{15650b30-2ff4-4bfa-979a-51fa51cc7f4b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="advanceEnumerationClosure" Id="{14c9d349-957a-490c-9db0-cd53f4b50b67}">
      <Declaration><![CDATA[(*!
<summary>Completes an active directory search before deletion or task termination.</summary>
<description>Deasserts bExecute while a search command is pending. After a nonterminal search result, issues one
abort with a fresh rising edge and waits for its completion. bEOE and native errors close the enumeration
without an explicit abort. FALSE means the caller must resume on a later Execute.
An abort error is logged once with its native code and path, without retrying abort or replacing the task
stop reason. Readiness means this cleanup attempt ended, not that server resources were proven released.
The log attempt is made after clearing pending enumeration state; logger failure does not restart cleanup.</description>
*)
METHOD PRIVATE advanceEnumerationClosure : BOOL
VAR
	enumerationAbortMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[advanceEnumerationClosure := FALSE;

IF NOT _EnumerationStarted THEN
	advanceEnumerationClosure := TRUE;
	RETURN;
END_IF

_EnumFindFile(bExecute := FALSE);

IF _EnumFindFile.bBusy THEN
	RETURN;
END_IF

IF _EnumFindFile.bEOE OR_ELSE _EnumFindFile.bError THEN
	_EnumerationStarted := FALSE;

	(* End this attempt before reporting its error so logging cannot cause repeated aborts. *)
	IF _EnumerationAbortIssued AND_THEN _EnumFindFile.bError THEN
		enumerationAbortMessage := TOF_Core.WideStrings.Concat255("Directory enumeration abort failed (native error code ", TO_WSTRING(_EnumFindFile.nErrId), "): ", TO_WSTRING(_EnumFindFile.sPathName));
		TOF_Core.LogManager.TryLogMessage(enumerationAbortMessage, TOF_Core.LOG_CATEGORY.ERROR, TO_WSTRING(__POUNAME()));
	END_IF
	advanceEnumerationClosure := TRUE;
	RETURN;
END_IF

IF NOT _EnumerationAbortIssued THEN
	_EnumFindFile(bExecute := TRUE, eCmd := Tc2_Utilities.E_EnumCmdType.eEnumCmd_Abort);
	_EnumerationAbortIssued := TRUE;
	RETURN;
END_IF

_EnumerationStarted := FALSE;
advanceEnumerationClosure := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{9698167e-1825-4c05-b9a5-4b8b95b26192}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Advances directory stop actions before reporting termination.</summary>
<description>
Used for every stop reason. Finishes any search command and its required abort, then waits for pending remove
I/O. A new remove request is never started here. Readiness reports native FB completion, not server rollback.
</description>
<param name="readyToRelease">TRUE when the directory FBs have finished their pending requests.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[readyToRelease := advanceEnumerationClosure();

_RemoveDirectory(bExecute := FALSE);

readyToRelease := readyToRelease AND_THEN NOT _RemoveDirectory.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{b9893c29-63cc-4e1a-8818-43b55eff8a9e}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Clears completed directory operations and per-run enumeration cleanup state.</summary>
<description>Called only after stopping has completed; it does not abandon pending native I/O.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EnumFindFile(bExecute := FALSE);
_RemoveDirectory(bExecute := FALSE);

_DirectoryChecking := FALSE;
_DirectoryFound := FALSE;
_EnumerationStarted := FALSE;
_EnumerationAbortIssued := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{fddd3dfa-0b97-4445-a381-2f1fa1c8cd9b}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Checks for a directory and removes it only after closing the search.</summary>
<description>On early discovery, the search abort must complete before the remove FB is started. A missing
directory completes successfully. Computed diagnostics are held in local buffers for the receiving call without dynamic string-builder allocations.
A found file returns ERROR with a diagnostic message and leaves enumeration cleanup to OnStopping; no remove request starts.</description>
<param name="processingState">BUSY while searching, closing the search or removing; DONE after completion; ERROR when the path refers to a file.</param>
<param name="stopReasonMessage">Receives diagnostics when the path refers to a file; native failures use exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	formattedExceptionMessage : TOF_Core.ERROR_MESSAGE;
	pathErrorMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _DirectoryChecking AND_THEN NOT _EnumerationStarted AND_THEN NOT _DirectoryFound
THEN
	IF TOF_Core.Strings.IsNullOrWhiteSpace(_EnumFindFile.sPathName) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'DirectoryPath');		
	END_IF
	
	IF NOT PathHelper.IsValidDirectoryPath(_EnumFindFile.sPathName, errorMessage => pathErrorMessage) THEN
		FileSystemExceptions.ThrowInvalidPath(NamespaceName, ClassName, __POUNAME(), __POSITION(), _EnumFindFile.sPathName, pathErrorMessage);
	END_IF
	
	_DirectoryChecking := TRUE;
	
	_EnumFindFile(bExecute := FALSE, eCmd := Tc2_Utilities.E_EnumCmdType.eEnumCmd_First);
	_RemoveDirectory(bExecute := FALSE);
END_IF

IF _DirectoryChecking THEN
	_EnumerationStarted := TRUE;
	_EnumFindFile(bExecute := TRUE);
	
	IF _EnumFindFile.bError THEN
		TOF_Core.WideStrings.Append255(
			formattedExceptionMessage,
			"Error while checking directory '",
			TO_WSTRING(_EnumFindFile.sPathName),
			"'");

		FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _EnumFindFile.nErrId);
	ELSIF NOT _EnumFindFile.bBusy THEN	
		_DirectoryChecking := FALSE;
		
		IF NOT _EnumFindFile.bEOE THEN
			IF _EnumFindFile.stFindFile.fileAttributes.bDirectory THEN
				_DirectoryFound := TRUE;
			ELSE
				stopReasonMessage := TOF_Core.WideStrings.Concat255("Directory path refers to a file: ", TO_WSTRING(_EnumFindFile.sPathName));
				processingState := TOF_Tasks.TASK_PROCESSING_STATE.ERROR;
			END_IF
		ELSE
			processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
		END_IF
	END_IF
ELSE
	IF NOT advanceEnumerationClosure() THEN
		RETURN;
	END_IF

	_RemoveDirectory(bExecute := TRUE);
	
	IF _RemoveDirectory.bError THEN
		TOF_Core.WideStrings.Append255(
			formattedExceptionMessage,
			"Error while removing directory '",
			TO_WSTRING(_RemoveDirectory.sPathName),
			"'");

		FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _RemoveDirectory.nErrId);
	END_IF
	
	IF NOT _RemoveDirectory.bBusy THEN
		processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
	END_IF	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="PathType" Id="{65f2912c-9f8e-4c59-b92c-158be7c27bb4}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the native path context for the filesystem request.</summary>
<description>Configure before Start and keep unchanged until STOPPED. It is passed to the native operation, not used as a path-validity result. Reset preserves it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PathType : Tc2_System.E_OpenPath]]></Declaration>
      <Get Name="Get" Id="{1a295761-0b23-44cd-9cf6-5ec2217f5cae}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PathType := _RemoveDirectory.ePath;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{afa9df79-bb5b-4b9e-899a-4a5a3f3dec41}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.ePath := PathType;
_EnumFindFile.ePath := PathType;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SelfSize" Id="{2768e2fa-09ff-4db7-b70d-5cb5c0bddabf}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{1f8367d6-45d3-49e2-9b48-087efc8bea5d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{0696c8bc-2d71-49e6-bb59-5942bbc070bf}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{c549910c-0d19-4d37-b063-22fc7a6b6263}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _RemoveDirectory.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{bfd71f91-7d3a-45cc-abcd-e131cad12772}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RemoveDirectory.tTimeout := Timeout;
_EnumFindFile.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
