(*!
<summary>Deletes a file through cyclic task execution.</summary>
<description>Use one owner task. Configure the path, target, path type and timeout before Start and keep them unchanged
until STOPPED. A missing path is rejected during execution; native errors propagate through Task failure
handling. There is no separate existence check and no conversion of a native not-found error to success.
Continue Execute through stopping, including after cancellation: an already submitted request is drained,
not rolled back. Failure or cancellation does not prove the file still exists. Reset preserves configuration.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DeleteFile EXTENDS TOF_Tasks.Task IMPLEMENTS IFileSystemTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

    _DeleteFile : Tc2_System.FB_FileDelete;

	{attribute 'hide'} 
	_FilePathNotSpecifiedException :	TOF_Core.DataMemberNotSpecifiedException;
	{attribute 'hide'} 
	_DeleteFileException : TOF_Core.StandardException;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{5c734593-9cb0-4d4a-a8bd-280e5f7cf47f}" />
    <Folder Name="Members to override" Id="{8c98957e-0b2c-4bc7-ad6a-510d4f07ad24}" />
    <Property Name="AmsNetId" Id="{51e41684-991f-4895-ae24-ce493fb5ef2c}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Configure before Start and keep unchanged until STOPPED; the setter stores configuration without submitting I/O.</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA' := '1'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{76322297-0858-4421-a0f5-6bbdc5b131fb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _DeleteFile.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{745ae5f5-8fb5-4563-93fc-b37de88ffcb3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_DeleteFile.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{9a0868c1-10bc-4fb1-9326-3325da31a11b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7319f073-76e9-4be5-bd91-98627ec5b619}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FilePath" Id="{d92d06d0-9330-4ded-b02a-eb12d17df177}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Provides the configured path for the file operation.</summary>
<description>The setter copies text without performing I/O. Configure before Start and keep unchanged until STOPPED; Reset preserves it. The native service determines whether the path is usable.</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA' := '1'}
PROPERTY FilePath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{b4f03ed5-6f36-4301-ba38-819c4e9a9c6a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FilePath := _DeleteFile.sPathName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d40f0212-7cfd-4ab0-9944-711f5bbe86a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_DeleteFile.sPathName := FilePath;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{6dbfdf1c-1abc-4260-b785-e313a600550a}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e7b99e4c-8c32-4968-8443-d5548a868161}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnStopping" Id="{1f9243b4-249b-4e10-a8ba-a9ada8bba94c}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Waits for an already submitted operation before task termination.</summary>
<description>
Runs for every stop reason. Advances the pending FB with bExecute=FALSE without issuing another request.
Completion does not roll back side effects. Keep configuration and borrowed buffers valid until STOPPED.
</description>
<param name="readyToRelease">TRUE when the underlying FB is no longer busy.</param>
*)
METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _DeleteFile.bBusy THEN
	_DeleteFile(bExecute := FALSE);
END_IF

readyToRelease := NOT _DeleteFile.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{d1362757-d3ac-47a4-8843-3c884393e309}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Resets the native request edge after the task has stopped.</summary>
<description>Preserves configured inputs and does not undo completed filesystem effects. Pending I/O must finish during stopping before this hook runs.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DeleteFile(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{94b4f428-70c7-4323-9b12-6f7c9f13f4aa}" FolderPath="Members to override\">
      <Declaration><![CDATA[(*!
<summary>Submits and advances native deletion of the configured file.</summary>
<description>Validates required configuration before submitting the request. Native errors raise an exception
for the base Task failure/stopping path; the local diagnostic builder is released before that Throw.
Normal completion reports DONE only after the native block is no longer busy. No rollback is performed.</description>
<param name="processingState">BUSY while pending; DONE after native completion without an error.</param>
<param name="stopReasonMessage">Not changed here; failures are passed through exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	pathErrorMessage : WSTRING(255);
	errorMessageBuilder : TOF_Core.WideStringBuilder;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _DeleteFile.bExecute THEN 
	IF TOF_Core.Strings.IsNullOrWhiteSpace(_DeleteFile.sPathName) THEN
		_FilePathNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'FilePath');		
	END_IF
END_IF

_DeleteFile(bExecute := TRUE);

IF _DeleteFile.bError THEN
	errorMessageBuilder
		.AppendString("An error occurred while deleting the file '")
		.Append(_DeleteFile.sPathName)
		.AppendString("'");

	formattedExceptionMessage := errorMessageBuilder.ToString255();

	(* An exception skips FB_exit for this local builder; release its buffer before Throw. *)
	errorMessageBuilder.Clear(releaseMemory := TRUE);

	_DeleteFileException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage, errorCode := _DeleteFile.nErrId);
END_IF

IF NOT _DeleteFile.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="PathType" Id="{04d5602f-b967-48be-8eee-fabfe0730217}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the native path context for the filesystem request.</summary>
<description>Configure before Start and keep unchanged until STOPPED. It is passed to the native operation, not used as a path-validity result. Reset preserves it.</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA' := '1'}
PROPERTY PathType : Tc2_System.E_OpenPath]]></Declaration>
      <Get Name="Get" Id="{0a70ed3a-ad22-4012-998e-cad8adb6f0ec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PathType := _DeleteFile.ePath;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{17f4d9e6-d7fb-441b-a237-6a68c55281e2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_DeleteFile.ePath := PathType;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SelfSize" Id="{b9e0f797-1600-4e2b-aeef-634d4ea22c0b}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6ca5367a-528c-4d24-a82f-7f843c438268}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{bbee8d51-257c-48ae-bf00-0819c028fd98}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'OPC.UA.DA' := '1'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{b5e1ae9e-d6a8-42b3-9294-f0972e8a4b98}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _DeleteFile.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{73b0fc19-215f-4912-8e36-2f185992f3be}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_DeleteFile.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>