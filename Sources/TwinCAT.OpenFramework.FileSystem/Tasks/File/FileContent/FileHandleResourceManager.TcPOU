(*!
<summary>Manages file opening and best-effort closing for file-content tasks.</summary>
<description>
StartAcquire and StartRelease request one operation; Execute advances it until completion.
Configure before acquisition and keep configuration unchanged until release completes.
Do not overlap requests. FinishPendingAcquire drains a pending open during stopping.
Close errors are logged and finish the cleanup attempt. Normal release must be advanced through Execute before destruction. FB_exit only makes a final best-effort close request and does not wait for or verify its completion. Before online change, the owner must finish pending acquisition and release through cyclic execution. No pending native operation or retained open handle may cross online change; this precondition is not enforced automatically.
</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
FUNCTION_BLOCK INTERNAL FileHandleResourceManager EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IResourceManager
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	_FileOpen : Tc2_System.FB_FileOpen;
	_FileClose : Tc2_System.FB_FileClose;
	
	_FileHandleAcquired : BOOL;
	_Acquiring : BOOL;
	_Releasing : BOOL;
	
	_FileHandleResource : FileHandleResource(_FileOpen);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{2e824959-2c7c-490d-b090-ada3c4d7a2d9}" />
    <Folder Name="Internal methods" Id="{6577756f-627e-4f88-8d2b-366f1cad24e3}" />
    <Folder Name="Outputs" Id="{1801966b-7c3d-4b3c-94f0-65a057cde663}" />
    <Property Name="AmsNetId" Id="{58ba6341-e7aa-43c3-a872-d3eb4b8261f4}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the ADS target for the native filesystem operation.</summary>
<description>Shared by open and close. Configure before acquisition and keep unchanged through completed release; assignment does not submit I/O.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{b1951ee2-f8d0-49e2-83e5-41b7bedd997b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _FileOpen.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{471b9689-2694-4be0-84e4-42cf3bfdd869}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_FileOpen.sNetId := AmsNetId;
_FileClose.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{cc79ca29-ba9e-49d4-b09a-938a015d18e8}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b72512a6-29f2-482c-8ad3-73e1bab73efc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{a6fd7154-99a5-481c-85e2-93b3106fac63}">
      <Declaration><![CDATA[(*!
<summary>Advances the requested acquire or release operation; does nothing when idle.</summary>
*)
METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Acquiring THEN
	executeAcquire();
ELSIF _Releasing THEN
	executeRelease();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="executeAcquire" Id="{812a139a-f185-479e-864d-b310d1edded3}">
      <Declaration><![CDATA[(*!
<summary>Advances opening of the configured file and reports success through ResourceAcquired.</summary>
*)
METHOD PRIVATE executeAcquire
VAR
	openFileException : TOF_Core.StandardException;
	
	messageBuilder : TOF_Core.WideStringBuilder;
	message : TOF_Core.ERROR_MESSAGE;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FileOpen(bExecute := TRUE);
	
IF _FileOpen.bError THEN
	_Acquiring := FALSE;

	messageBuilder
		.AppendString("Error while open file '")
		.Append(_FileOpen.sPathName)
		.AppendString("'")
		.AssignToString(message);

	messageBuilder.Clear(releaseMemory := TRUE);

	openFileException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), message, _FileOpen.nErrId);		
END_IF

IF NOT _FileOpen.bBusy AND_THEN _FileOpen.hFile > 0 THEN
	_Acquiring := FALSE;
	_FileHandleAcquired := TRUE;
	
	messageBuilder
		.AppendString("File '")
		.AppendString255(TO_WSTRING(_FileOpen.sPathName))
		.AppendString("' open")
		.AssignToString(message);

	TOF_Core.LogManager.TryLogMessage(message, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="executeRelease" Id="{a4a50be3-0dfc-44f6-bb5a-f1a98beada52}">
      <Declaration><![CDATA[(*!
<summary>Advances best-effort file closing; close errors are logged and the cleanup attempt is completed.</summary>
<description>After native completion, clears the acquired/releasing flags even on close failure.
The error message includes the native nErrId as a decimal code before the file path.
Logging does not retry close or convert the close error to a new exception. Completed cleanup bookkeeping
does not prove physical handle closure; logging delivery depends on the configured logger.</description>
*)
METHOD PRIVATE executeRelease
VAR	
	messageBuilder : TOF_Core.WideStringBuilder;
	message : TOF_Core.ERROR_MESSAGE;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _FileHandleAcquired THEN
	_Releasing := FALSE;
	_FileOpen(bExecute := FALSE);
	
	RETURN;
END_IF

_FileClose(hFile := _FileOpen.hFile, bExecute := TRUE);

IF NOT _FileClose.bBusy THEN
	_Releasing := FALSE;
	_FileHandleAcquired := FALSE;
	
	_FileOpen(bExecute := FALSE);

	IF _FileClose.bError THEN
		messageBuilder
			.AppendString("Error while closing file (native error code ")
			.AppendString255(TO_WSTRING(_FileClose.nErrId))
			.AppendString("): '")
			.Append(_FileOpen.sPathName)
			.AppendString("'")
			.AssignToString(message);
	
		TOF_Core.LogManager.TryLogMessage(message, TOF_Core.LOG_CATEGORY.ERROR, TO_WSTRING(ClassName), "FileHandleResourceManager.executeRelease", "FileHandleResourceManager.executeRelease.Done");
	ELSE
		messageBuilder
			.AppendString("File '")
			.AppendString255(TO_WSTRING(_FileOpen.sPathName))
			.AppendString("' closed")
			.AssignToString(message);
	
		TOF_Core.LogManager.TryLogMessage(message, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));
	END_IF
END_IF 
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{e2227dd5-5c0b-46b5-b99e-d2542b988db4}">
      <Declaration><![CDATA[//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

(*!
<summary>Makes a final best-effort close request for a still-acquired file handle.</summary>
<description>Does not wait for bBusy to clear or inspect the close result. Callers must complete normal release through cyclic Execute before destroying this manager; this fallback does not guarantee that the file has closed. Does not create framework exceptions or format diagnostics. The same fallback runs when bInCopyCode is TRUE; this method implements no handoff of an active handle to a copied instance. Before online change, callers must finish normal release and resolve any cleanup error. Under that precondition this fallback has no acquired handle to close. It cannot prepare an active manager for online change or guarantee uninterrupted file I/O.</description>
*)
METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _FileHandleAcquired THEN
	_FileClose(hFile := _FileOpen.hFile, bExecute := TRUE);
	_FileOpen(bExecute := FALSE);	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="FileHandle" Id="{2896eaf9-a80f-404e-94b8-8123c510f09c}" FolderPath="Outputs\">
      <Declaration><![CDATA[(*!
<summary>Provides the native handle associated with the file resource.</summary>
<description>Use only during the current acquisition; the value alone is not an acquisition guard. Do not close it independently or retain it across release.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL FileHandle : UINT]]></Declaration>
      <Get Name="Get" Id="{6df95589-41ea-4b94-84cc-212d2dd51c8f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FileHandle := _FileOpen.hFile;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FilePath" Id="{e7da9441-fbfb-4fa6-a4d8-72325b7739cf}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Provides the configured path for the file operation.</summary>
<description>Configure before acquisition and keep unchanged through release. Assignment copies the path without opening a file; StartAcquire rejects a missing path.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FilePath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{0f59a514-2049-4c57-9a08-ebeb32943655}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FilePath := _FileOpen.sPathName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{96688e65-eb38-4fda-9004-426d8915b6bc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_FileOpen.sPathName := FilePath;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FinishPendingAcquire" Id="{c81dece5-ef14-407d-ad17-b6960c0c25b9}" FolderPath="Internal methods\">
      <Declaration><![CDATA[(*!
<summary>Finishes a pending open during stopping without starting a new open.</summary>
<description>
TRUE means its response has been processed (or none was pending), and acquisition is no longer scheduled.
Preserve a successfully returned handle so the normal release path can close it.
</description>
*)

METHOD INTERNAL FinishPendingAcquire : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _FileOpen.bBusy THEN
	_FileOpen(bExecute := FALSE);

	IF NOT _FileOpen.bBusy AND_THEN NOT _FileOpen.bError AND_THEN _FileOpen.hFile > 0 THEN
		_FileHandleAcquired := TRUE;
	END_IF
END_IF

FinishPendingAcquire := NOT _FileOpen.bBusy;

IF FinishPendingAcquire THEN
	_Acquiring := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="FileHandleResource" Id="{6e403d76-5580-4e7f-aced-4b132e2a3937}">
      <Declaration><![CDATA[(*!
<summary>Provides the manager-owned typed resource for binding file-content tasks.</summary>
<description>The reference is valid only while this manager is alive. Obtaining it does not acquire or open
a file. It remains a borrowed view across release and reacquisition; use its handle only during the current
acquisition. Do not delete the resource or modify its borrowed path. No ownership is transferred.</description>
*)
PROPERTY FileHandleResource : REFERENCE TO FileHandleResource]]></Declaration>
      <Get Name="Get" Id="{99b2d18c-cc24-47e6-b5ff-4c54bc9a4675}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FileHandleResource REF= _FileHandleResource;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetResource" Id="{da34d722-f49b-4fa9-bce2-28d0fd1bb9f9}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed resource object owned by this manager.</summary>
<description>
The caller must not delete the returned object. It may be obtained before acquisition
and retained while the manager remains alive, including across release and reacquisition.
The object remains valid after release, but its presence does not mean the resource is acquired.
Use the underlying resource only after successful acquisition and before release begins.
Do not reuse a handle saved from an earlier acquisition after release.
</description>
*)
METHOD GetResource : TOF_Core.IObject]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetResource := _FileHandleResource;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ModeFlags" Id="{d8877c23-9995-4a58-9d03-9d10857af478}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects native file access and text or binary flags.</summary>
<description>Use the valid Tc2_System FOPEN_MODE combinations documented by FileContentManager.ModeFlags. Configure before acquisition and keep unchanged through release; native opening reports incompatible flags.</description>
*)

{attribute 'monitoring' := 'call'}

PROPERTY ModeFlags : DWORD]]></Declaration>
      <Get Name="Get" Id="{584251ae-11fc-4ba6-89de-426cc46b474a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ModeFlags := _FileOpen.nMode;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{bba085b2-d74c-4015-b308-0f6bfb546081}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_FileOpen.nMode := ModeFlags;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{27fd42e0-b5de-433d-a7c7-62172f1098aa}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{415be913-5fd9-4560-9a47-04b1e4a47a7d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PathType" Id="{0498697c-dcd7-4ba7-a720-017e4bbbaf68}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Selects the native path context for the filesystem request.</summary>
<description>Passed to native file opening. Configure before acquisition and keep unchanged through release; the setter does not validate or open a path.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PathType : Tc2_System.E_OpenPath]]></Declaration>
      <Get Name="Get" Id="{10200069-c008-4ef3-ab5c-d58c7df21bcd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PathType := _FileOpen.ePath;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{4d9b8d65-f570-4865-9dd6-f67555c0b87f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_FileOpen.ePath := PathType;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ResourceAcquired" Id="{976b6166-7716-4306-abdc-0df2c42fb7a2}">
      <Declaration><![CDATA[(*!
<summary>Reports whether this manager currently retains an acquired handle.</summary>
<description>FALSE also occurs before acquisition completes and after a failed best-effort close attempt. This bookkeeping flag is not proof that the native service physically released a resource.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ResourceAcquired : BOOL]]></Declaration>
      <Get Name="Get" Id="{3890982e-702d-45cd-afaa-5dec8d04c8fa}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResourceAcquired := _FileHandleAcquired;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1462f709-fe1e-4e8c-b9f5-e539de887f05}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9d7145ea-ca1b-4e2a-8ba0-84e101203bf1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StartAcquire" Id="{16d0f4b4-ae54-48bd-8d26-f722c5bc38f3}">
      <Declaration><![CDATA[(*!
<summary>Requests opening of the configured file on subsequent Execute calls.</summary>
<description>
Call once with no pending operation. An already acquired handle is retained.
An empty FilePath raises an exception before the request is scheduled.
 Computed diagnostic strings are held in local buffers for the duration of the receiving call.</description>
*)
METHOD StartAcquire
VAR
	formattedLogMessage : WSTRING(255);

	memberNotSpecifiedException : TOF_Core.DataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _FileHandleAcquired THEN
	RETURN;
END_IF

IF TOF_Core.Strings.IsNullOrWhiteSpace(_FileOpen.sPathName) THEN
	memberNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'FilePath');
END_IF

formattedLogMessage := TOF_Core.WideStrings.Concat255("Attempt to open file '", TO_WSTRING(_FileOpen.sPathName), "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));

_FileClose(bExecute := FALSE);
_FileOpen(bExecute := FALSE);
_Acquiring := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartRelease" Id="{8c1a0c78-599e-44dc-a8be-967c680bd37f}">
      <Declaration><![CDATA[(*!
<summary>Requests best-effort closing on subsequent Execute calls.</summary>
<description>
Acquisition must have completed or been drained by FinishPendingAcquire.
Call once; releasing an absent handle is allowed.
 Computed diagnostic strings are held in local buffers for the duration of the receiving call.</description>
*)
METHOD StartRelease
VAR
	formattedLogMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formattedLogMessage := TOF_Core.WideStrings.Concat255("Attempt to close file '", TO_WSTRING(_FileOpen.sPathName), "'");

TOF_Core.LogManager.TryLogMessage(formattedLogMessage, TOF_Core.LOG_CATEGORY.INFORMATION, TO_WSTRING(ClassName), TO_WSTRING(__POUNAME()));

IF _FileHandleAcquired THEN
	_Releasing := TRUE;
ELSE
	_FileOpen(bExecute := FALSE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Timeout" Id="{55f19980-de6f-45fb-885f-84e42279fbe8}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Shared by native open and close. Configure before acquisition and keep unchanged through release. It is not an overall resource-lifecycle deadline.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{ac33da2e-1fca-4ee3-9451-0faaba6eb7f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _FileOpen.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{411066da-c860-4e44-b31c-1d604dbd4d2b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_FileOpen.tTimeout := Timeout;
_FileClose.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>