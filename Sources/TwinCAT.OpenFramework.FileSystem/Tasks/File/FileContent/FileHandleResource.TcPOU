<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileHandleResource" Id="{3b5c26cf-3170-4545-bd8c-3bd2c4df1329}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes a borrowed view of the native open-file block owned by a resource manager.</summary>
<description>This object owns neither the native block nor its handle. Keep the referenced FB_FileOpen alive
for the entire use of this view. The getters do not check acquisition: an assigned view is not evidence of
an open file. Use handle and target together only during the current acquisition, never after release.
An invalid native-block reference yields default scalar results or an invalid FilePath reference.
Do not modify FilePath through its reference, close the handle independently or delete this borrowed object.</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'}
FUNCTION_BLOCK INTERNAL FileHandleResource EXTENDS TOF_Core.Object
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_FileOpen : REFERENCE TO Tc2_System.FB_FileOpen;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="AmsNetId" Id="{380802f5-49e1-48ab-848f-8d4221f7487f}">
      <Declaration><![CDATA[(*!
<summary>Target of the open file; use together with FileHandle.</summary>
*)

{attribute 'monitoring' := 'call'}

PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{6426ac28-9518-4d34-82d5-0cb3445bd540}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_FileOpen) THEN
	AmsNetId := _FileOpen.sNetId;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{e357a305-e7de-4b32-92a8-00371949d47e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{284aba92-edd1-4b1b-9361-0330fa8f6d0c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{3a7a9b22-aecf-4b7b-98d9-39fda05e6a70}">
      <Declaration><![CDATA[(*!
<summary>Binds this view to a caller-owned native file-open block without acquiring a file.</summary>
<description>The binding is borrowed and must remain alive throughout use. An invalid reference is retained
without throwing; getters then return default scalars or an invalid reference. No handle is opened or closed.</description>
<param name="fileOpen">Borrowed native block providing the path, target and current handle.</param>
*)
METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	fileOpen : REFERENCE TO Tc2_System.FB_FileOpen;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FileOpen REF= fileOpen;]]></ST>
      </Implementation>
    </Method>
    <Property Name="FileHandle" Id="{41387944-3b27-40d9-a71a-79172bcfc3c1}">
      <Declaration><![CDATA[(*!
<summary>Reads the native handle from the borrowed open-file block.</summary>
<description>Returns the default UINT when no native block is bound. Does not check acquisition or close status; a stored numeric handle must not be reused after release.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FileHandle : UINT]]></Declaration>
      <Get Name="Get" Id="{5c0a725f-80b2-4645-9072-3dcfb1a89456}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_FileOpen) THEN
	FileHandle := _FileOpen.hFile;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FilePath" Id="{b9868a13-98bb-41c4-aa60-43cac9371bda}">
      <Declaration><![CDATA[(*!
<summary>Provides a borrowed view of the configured native file path.</summary>
<description>The reference is invalid when no native block is bound. Keep the owner alive and do not write through this reference. This path identifies configuration, not proof that the file is open.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FilePath : REFERENCE TO Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{97ff0fdc-ec21-47e3-8ff8-51dd09c647a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF __ISVALIDREF(_FileOpen) THEN
	FilePath REF= _FileOpen.sPathName;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{4f8fd457-4527-453a-bb0a-b797e3616ec8}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a13f030a-2ce4-4068-b49d-03db3751d4f0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{18c8a656-741c-413f-993f-ac37337ec5cd}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{79dc3c1f-cd1f-4f38-b451-48654d0e5843}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>