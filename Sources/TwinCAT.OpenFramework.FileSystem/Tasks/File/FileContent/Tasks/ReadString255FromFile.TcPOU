<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ReadString255FromFile" Id="{41262c4b-3425-416b-97ce-608743b9ee3d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
