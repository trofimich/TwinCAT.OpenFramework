(*!
<summary>Queries the native end-of-file status of the acquired file.</summary>
<description>The owner must keep the resource acquired through stopping. Configure Timeout before Start
and keep it unchanged until STOPPED. Missing binding and native errors use the Task failure and cleanup
path. IsEndOfFile exposes the native result only after STOPPED with WORK_DONE; FALSE outside that state
does not establish that more data is available. Cancellation waits for a submitted query.
Reset clears binding and request state while retaining Timeout.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK CheckEndOfFile EXTENDS FileContentTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

    _CheckEOF : Tc2_System.FB_EOF;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{82edc534-6a5e-4ae5-8d23-1ba709acf1c8}" />
    <Folder Name="Outputs" Id="{41c6a1be-e0f4-45ee-969f-073817a29093}" />
    <Folder Name="Overriden methods" Id="{b3a9a104-5590-45eb-a995-37fc09e70ca8}" />
    <Property Name="AmsNetId" Id="{e149419e-786d-4305-a41e-d3175d9386f0}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Exposes the native operation target copied from the bound file resource.</summary>
<description>The resource target overwrites a separately assigned value before native submission. Configure the resource owner to select a target; do not change this value while the task is running.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{e4fa5c0d-f1fe-4ade-acb2-cd2495b11105}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _CheckEOF.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{ba58c8e7-ddfd-4fd3-b664-fa7cfd82cc2c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CheckEOF.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{92c6854c-2a01-4b57-a4c7-6bdd34567945}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cd5fed1a-8fad-444e-b905-350a9c2d31bb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FileOperationInProgress" Id="{29a2ee22-f44c-4ee1-96a6-d2520f1bf9f3}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the underlying native file operation is busy.</summary>
<description>Observes native I/O, including work drained during stopping. FALSE is not a task-success result and does not independently permit the resource owner to close or destroy the file.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FileOperationInProgress : BOOL]]></Declaration>
      <Get Name="Get" Id="{03e34f8f-a3cb-4f19-8e7a-81546d9e6b65}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FileOperationInProgress := _CheckEOF.bBusy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsEndOfFile" Id="{c1b5d8de-809e-4884-9f22-118bcad9a052}" FolderPath="Outputs\">
      <Declaration><![CDATA[(*!
<summary>Reports the EOF indicator obtained by a successfully completed check.</summary>
<description>Returns the native result only while State.Stopped and FinalStopReason.WorkDone are both TRUE.
In every other state, including READY, RUNNING, failure and cancellation, returns the initial value of the
property type. This default is not a success indicator; inspect the task state and final reason.
FALSE outside successful completion does not establish that more data is available.
The getter does not modify native outputs or buffers. Copy a successful result before Reset or reuse.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY IsEndOfFile : BOOL]]></Declaration>
      <Get Name="Get" Id="{d13c706b-d45c-4a66-baf1-1d45e9292d9c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT State.Stopped OR_ELSE NOT FinalStopReason.WorkDone THEN
	RETURN;
END_IF

IsEndOfFile := _CheckEOF.bEOF;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{05e39b9f-2c89-4e16-9c19-3e743047286a}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{003130f8-56ed-4c9b-9d18-7b35c58fc3f6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnReset" Id="{238b9ac2-5ee6-4e96-9332-0870fa56da11}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resets the native request edge after the task has stopped.</summary>
<description>Also preserves the inherited resource-binding cleanup. Configured inputs remain available for reuse; borrowed buffers are not freed or cleared. Pending I/O must finish during stopping before this hook runs.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.OnReset();

_CheckEOF(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{65c6a206-26fe-4757-9d9e-d93e29314daf}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Checks the end-of-file indicator through the bound file handle.</summary>
<description>Requires a live bound resource whose owner keeps the handle acquired until stopping completes.
Native errors raise an exception for the base Task failure and cleanup path without dynamic string-builder allocations; completed I/O effects are not rolled back.</description>
<param name="processingState">BUSY while pending; DONE after native completion without an error.</param>
<param name="stopReasonMessage">Not changed; native failures use exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	errorMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _CheckEOF.bExecute THEN 
	IF NOT __ISVALIDREF(_FileHandleResource) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'FileHandleResource');		
	END_IF
	
	_CheckEOF.sNetId := _FileHandleResource.AmsNetId;
	_CheckEOF.hFile := _FileHandleResource.FileHandle;
END_IF

_CheckEOF(bExecute := TRUE);

IF _CheckEOF.bError THEN
	TOF_Core.WideStrings.Append255(
		errorMessage,
		"An error occurred while checking end of file '",
		TO_WSTRING(FilePath),
		"'");

	FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), errorMessage, errorCode := _CheckEOF.nErrId);
END_IF

IF NOT _CheckEOF.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{6abf9d76-cb22-4790-82ad-518029c66bac}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Wait for an already submitted file operation before allowing handle release.</summary>
<description>
FALSE on bExecute only avoids a new request; it does not abort the pending one.
Runs for every stop reason. If no operation is busy, stopping is ready immediately.
</description>
<param name="readyToRelease">TRUE after pending work has completed and release may begin.</param>
*)

METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CheckEOF.bBusy THEN
	_CheckEOF(bExecute := FALSE);
END_IF

readyToRelease := NOT _CheckEOF.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{94a2fbaf-c0ad-4170-a839-9590de59e3a4}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{53293525-2f4f-489f-88c4-d92f28407c7f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{fcfb7d41-f01f-46ca-8b77-3103533ff2b1}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{aae9bbb2-7b47-4c98-88f1-8a52141efb4d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _CheckEOF.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1815fa30-3487-4e3e-a4d5-3828aefe5fe1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CheckEOF.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>