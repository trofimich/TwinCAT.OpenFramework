(*!
<summary>Changes the bound file's position using a configured offset and origin.</summary>
<description>The resource owner must keep the file acquired through task stopping.
Configure Position, Origin and Timeout before Start and keep them unchanged until STOPPED.
Missing binding and native errors use the base Task failure and cleanup path.
Cancellation waits for submitted I/O and does not restore the previous file position.
Reset from STOPPED clears the binding and native request state, preserving offset, origin and timeout.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SetPositionInFile EXTENDS FileContentTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

    _SetPosition : Tc2_System.FB_FileSeek;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{a5df2b6b-917f-4f8c-b00d-1f6201a63ac9}" />
    <Folder Name="Overriden methods" Id="{e0bbb6ab-3610-477a-8601-1e6464605dbf}" />
    <Property Name="AmsNetId" Id="{962933ed-c3fb-407a-924b-c22895e6ca9b}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Exposes the native operation target copied from the bound file resource.</summary>
<description>The resource target overwrites a separately assigned value before native submission. Configure the resource owner to select a target; do not change this value while the task is running.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{fd9fa5cf-c7af-48b9-ae46-81212e5af96f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _SetPosition.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{63cff82e-1299-472d-b0f6-34d2d19d5720}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_SetPosition.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{cfdb6426-d476-42b9-99d1-4f5358e336a0}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9308678a-bfc7-4c39-9bf3-a53309e5994e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FileOperationInProgress" Id="{d2f9cbc9-0bf1-4bfb-bb02-4e28ad125b5c}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the underlying native file operation is busy.</summary>
<description>Observes native I/O, including work drained during stopping. FALSE is not a task-success result and does not independently permit the resource owner to close or destroy the file.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FileOperationInProgress : BOOL]]></Declaration>
      <Get Name="Get" Id="{2f0a7120-515d-4b95-a71e-21856b7a972c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FileOperationInProgress := _SetPosition.bBusy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5d4e917a-caa7-42e6-b306-afda1ea469d1}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{14add75a-a1cd-47cc-8e51-098a619ad651}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnReset" Id="{cfc6df6b-d281-4a15-b319-5749c80fbdb9}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Clears the borrowed binding and native request state after stopping.</summary>
<description>Preserves Position, Origin and Timeout. Does not cancel pending I/O; stopping must finish first.</description>
*)
METHOD PROTECTED OnReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.OnReset();

_SetPosition(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{5baa2eff-208e-451f-9d4c-98409c9ff39d}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Changes the position of the bound file using the configured offset and origin.</summary>
<description>Requires a live bound resource whose owner keeps the handle acquired until stopping completes.
Native errors raise an exception for the base Task failure and cleanup path without dynamic string-builder allocations; completed I/O effects are not rolled back.</description>
<param name="processingState">BUSY while pending; DONE after native completion without an error.</param>
<param name="stopReasonMessage">Not changed; native failures use exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	errorMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _SetPosition.bExecute THEN 
	IF NOT __ISVALIDREF(_FileHandleResource) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'FileHandleResource');		
	END_IF
	
	_SetPosition.sNetId := _FileHandleResource.AmsNetId;
	_SetPosition.hFile := _FileHandleResource.FileHandle;
END_IF

_SetPosition(bExecute := TRUE);

IF _SetPosition.bError THEN
	TOF_Core.WideStrings.Append255(
		errorMessage,
		"An error occurred while changing position in file ",
		TO_WSTRING(FilePath),
		"'");

	FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), errorMessage, errorCode := _SetPosition.nErrId);
END_IF

IF NOT _SetPosition.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{a3832dc5-33f8-4a9b-9737-37bc7f72bd87}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Wait for an already submitted file operation before allowing handle release.</summary>
<description>
FALSE on bExecute only avoids a new request; it does not abort the pending one.
Runs for every stop reason. If no operation is busy, stopping is ready immediately.
</description>
<param name="readyToRelease">TRUE after pending work has completed and release may begin.</param>
*)

METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _SetPosition.bBusy THEN
	_SetPosition(bExecute := FALSE);
END_IF

readyToRelease := NOT _SetPosition.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Origin" Id="{59a9a4c8-934e-41d3-b102-8ce67e140be5}" FolderPath="Inputs\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Selects the native reference point for the requested offset.</summary>
<description>Configure together with Position before Start and keep unchanged until STOPPED.
Passed to FB_FileSeek without additional validation; Reset preserves it.</description>
*)
PROPERTY Origin : Tc2_System.E_SeekOrigin]]></Declaration>
      <Get Name="Get" Id="{aff431bd-6656-46a8-836e-c5952078887b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Origin := _SetPosition.eOrigin;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{e5a42079-3800-4fef-badd-149a0f68983e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_SetPosition.eOrigin := Origin;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Position" Id="{8bf26b09-787c-4098-a51e-a06a2a359eaa}" FolderPath="Inputs\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Provides the requested native seek offset relative to Origin.</summary>
<description>This is configuration, not the resulting file position. Set before Start and keep unchanged
until STOPPED; Reset preserves it. Native constraints depend on Origin and the opened file.</description>
*)
PROPERTY Position : DINT]]></Declaration>
      <Get Name="Get" Id="{335fe352-4856-40ef-bb0c-554974e6ff67}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Position := _SetPosition.nSeekPos;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{58209566-1197-4dd9-947a-57418722e8fc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_SetPosition.nSeekPos := Position;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SelfSize" Id="{c9813391-742f-48f8-bb85-0f5cf528183c}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d49aef89-2950-4f78-a37e-432539dcc989}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{860a0249-7acd-4b02-8556-575cc6a54120}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{92bb4a91-5a5d-40f1-a1f2-bce74a7e6d05}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _SetPosition.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f2d5d237-0ebd-4438-b8df-16e6514a2323}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_SetPosition.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>