<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SetPositionInFile" Id="{2ffd7f2a-d3d6-47c9-9d3a-1e9a401c5b19}" SpecialFunc="None">
    <Declaration><![CDATA[(*
