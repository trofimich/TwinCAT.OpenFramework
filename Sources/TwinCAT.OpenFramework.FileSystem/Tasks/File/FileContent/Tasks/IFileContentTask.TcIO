<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IFileContentTask" Id="{859cad29-f756-4643-9494-4f576dede29b}">
    <Declaration><![CDATA[(*!
<summary>Defines a queued file operation that borrows a manager-owned resource.</summary>
<description>A child must be READY and absent from every queue before binding. While queued, keep it alive
and let the queue drive its lifecycle. Binding and queue membership transfer no ownership. Implementations
must keep borrowed resource data read-only and complete pending I/O before permitting resource release.
Keep the resource owner alive throughout use. Removing a queue entry does not clear the binding.</description>
*)
INTERFACE IFileContentTask EXTENDS IFileSystemTask]]></Declaration>
    <Property Name="FileHandle" Id="{f6c6e0fd-429b-4e98-bf0d-619a28a96627}">
      <Declaration><![CDATA[(*!
<summary>Provides the native handle associated with the file resource.</summary>
<description>Use only during the current acquisition; the value alone is not an acquisition guard. Do not close it independently or retain it across release. FileContentTask returns zero when unbound.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FileHandle : UINT]]></Declaration>
      <Get Name="Get" Id="{83d0effd-8aa4-4f4d-b6d8-9e5a583ecb21}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="FilePath" Id="{60cfe4a8-0551-4d90-aecd-e47e23f80131}">
      <Declaration><![CDATA[(*!
<summary>Provides a copy of the path from the borrowed file resource.</summary>
<description>The resource owner must remain alive during access. FileContentTask returns an empty string when unbound. The path is configuration, not proof of acquisition or file existence.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL FilePath : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{c6b874d6-1ea7-49dc-9993-89439dc6a142}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="SetFileHandleResource" Id="{4580e1bd-b58f-4c03-b06a-eb0706e8e9f9}">
      <Declaration><![CDATA[(*!
<summary>Bind, replace or clear a borrowed resource only in READY; otherwise throw.</summary>
<description>
An invalid reference clears the binding. Reset a STOPPED task before rebinding.
The caller must first remove the task from any queue; READY alone does not
mean it is unqueued. The resource owner must outlive its use by this task. FileContentTask clears binding on Reset from STOPPED, but its READY Reset is a no-op; a removed READY child needs explicit clearing or rebinding.
</description>
*)

METHOD SetFileHandleResource
VAR_INPUT
	fileHandleResource : REFERENCE TO FileHandleResource;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>