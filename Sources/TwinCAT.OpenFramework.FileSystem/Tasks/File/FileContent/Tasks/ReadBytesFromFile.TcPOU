<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ReadBytesFromFile" Id="{8d176d9d-3c32-47fa-be9c-aa34c97798bd}" SpecialFunc="None">
    <Declaration><![CDATA[(*
