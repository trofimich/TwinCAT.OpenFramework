<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GetPositionInFile" Id="{589984cb-20b3-4d5e-b92e-2c600f40dc07}" SpecialFunc="None">
    <Declaration><![CDATA[(*
