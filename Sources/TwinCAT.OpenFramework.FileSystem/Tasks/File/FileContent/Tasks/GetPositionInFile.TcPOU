(*!
<summary>Queries the current position of the acquired file.</summary>
<description>The owner must keep the resource acquired through stopping. Configure Timeout before Start
and keep it unchanged until STOPPED. Missing binding and native errors use the Task failure and cleanup
path. Position exposes the query result only after STOPPED with WORK_DONE; later I/O can change the file's
position. Cancellation waits for any submitted query. Reset clears binding and request state while
retaining Timeout; copy a successful result before Reset or reuse.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK GetPositionInFile EXTENDS FileContentTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
    _GetPosition : Tc2_System.FB_FileTell;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{132d34ff-170b-437a-b755-6b4c67629e17}" />
    <Folder Name="Outputs" Id="{9c277747-f33e-4922-9b3f-e8998de76f0c}" />
    <Folder Name="Overriden methods" Id="{0f8a30b3-db15-43b2-aebd-4538b88c8498}" />
    <Property Name="AmsNetId" Id="{3fb53d8b-5a71-4e70-8d7f-c2de48894754}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Exposes the native operation target copied from the bound file resource.</summary>
<description>The resource target overwrites a separately assigned value before native submission. Configure the resource owner to select a target; do not change this value while the task is running.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{8231e78a-82bd-4b5d-88e1-252c433f584b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _GetPosition.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{56c586d5-1614-4c6d-aa86-62695c2034bd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_GetPosition.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{3119fb09-efe4-4e59-8070-1a4958510494}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e792c430-8415-4677-8ab4-e5d290093f91}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FileOperationInProgress" Id="{421d204a-4433-4ffa-8255-b2d47bec5a79}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the underlying native file operation is busy.</summary>
<description>Observes native I/O, including work drained during stopping. FALSE is not a task-success result and does not independently permit the resource owner to close or destroy the file.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FileOperationInProgress : BOOL]]></Declaration>
      <Get Name="Get" Id="{9df29e8f-5258-454f-84d6-cdde3f532eea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FileOperationInProgress := _GetPosition.bBusy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{91ed0966-c6a6-4873-80e4-d317dbeb5c18}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a44ca9e3-659a-4478-9198-9da9c75071a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnReset" Id="{e1a1ef1a-19ac-4bfc-b8f7-a89af6a57f15}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Resets the native request edge after the task has stopped.</summary>
<description>Also preserves the inherited resource-binding cleanup. Configured inputs remain available for reuse; borrowed buffers are not freed or cleared. Pending I/O must finish during stopping before this hook runs.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.OnReset();

_GetPosition(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{a79ccf8c-b862-48f5-8715-d9728abb00d7}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Reads the current position of the bound file.</summary>
<description>Requires a live bound resource whose owner keeps the handle acquired until stopping completes.
Native errors raise an exception for the base Task failure and cleanup path without dynamic string-builder allocations; completed I/O effects are not rolled back.</description>
<param name="processingState">BUSY while pending; DONE after native completion without an error.</param>
<param name="stopReasonMessage">Not changed; native failures use exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	errorMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _GetPosition.bExecute THEN 
	IF NOT __ISVALIDREF(_FileHandleResource) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'FileHandleResource');		
	END_IF
	
	_GetPosition.sNetId := _FileHandleResource.AmsNetId;
	_GetPosition.hFile := _FileHandleResource.FileHandle;
END_IF

_GetPosition(bExecute := TRUE);

IF _GetPosition.bError THEN
	TOF_Core.WideStrings.Append255(
		errorMessage,
		"An error while getting position from file ",
		TO_WSTRING(FilePath),
		"'");

	FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), errorMessage, errorCode := _GetPosition.nErrId);
END_IF

IF NOT _GetPosition.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{6f90b4f7-2304-4362-ad08-5443e95e24a8}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Wait for an already submitted file operation before allowing handle release.</summary>
<description>
FALSE on bExecute only avoids a new request; it does not abort the pending one.
Runs for every stop reason. If no operation is busy, stopping is ready immediately.
</description>
<param name="readyToRelease">TRUE after pending work has completed and release may begin.</param>
*)

METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _GetPosition.bBusy THEN
	_GetPosition(bExecute := FALSE);
END_IF

readyToRelease := NOT _GetPosition.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Position" Id="{e1c79e4d-9015-4235-8a8d-20b6e812d3d2}" FolderPath="Outputs\">
      <Declaration><![CDATA[(*!
<summary>Reports the position obtained by a successfully completed position query.</summary>
<description>Returns the native result only while State.Stopped and FinalStopReason.WorkDone are both TRUE.
In every other state, including READY, RUNNING, failure and cancellation, returns the initial value of the
property type. This default is not a success indicator; inspect the task state and final reason.
Zero outside successful completion does not establish that the file is positioned at its beginning.
The getter does not modify native outputs or buffers. Copy a successful result before Reset or reuse.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Position : DINT]]></Declaration>
      <Get Name="Get" Id="{ed2a4843-e3fc-4cdd-8ca8-a77df96ded7d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT State.Stopped OR_ELSE NOT FinalStopReason.WorkDone THEN
	RETURN;
END_IF

Position := _GetPosition.nSeekPos;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f0c038b3-58d4-499a-acbf-2477d5667990}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{5c41b0ad-594c-4255-b875-ffcb5c43f065}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Timeout" Id="{87cf03cd-dc51-42fe-acb8-19815cf0061c}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{f41c19ec-acfc-4b30-99ec-a843a190b765}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _GetPosition.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{2d75dd28-2171-400e-bef7-1327cb1230cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_GetPosition.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>