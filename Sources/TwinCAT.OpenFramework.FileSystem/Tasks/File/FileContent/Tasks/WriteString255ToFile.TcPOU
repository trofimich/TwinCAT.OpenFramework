(*!
<summary>Writes configured STRING text to the bound file through cyclic task execution.</summary>
<description>The resource owner must keep the file acquired through task stopping.
Set StringToWrite and Timeout before Start and leave them unchanged until STOPPED.
The text is copied into this instance; the caller's original string need not remain alive.
Missing binding and native errors use the base Task failure and cleanup path.
Cancellation waits for submitted I/O; it does not undo written bytes or restore the file position.
Reset from STOPPED clears the binding and native request state but retains text and timeout.
The native FB_FilePuts contract requires a file opened in text mode and writes up to the terminating null, excluding that null. This wrapper adds no encoding conversion or extra line terminator; native text-mode transformations still apply.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WriteString255ToFile EXTENDS FileContentTask
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

    _PutString : Tc2_System.FB_FilePuts;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Inputs" Id="{c90ab75e-8dc3-4b45-ad36-6961ec2277cb}" />
    <Folder Name="Overriden methods" Id="{d3979173-ae53-46e6-9996-687d3c0e08df}" />
    <Property Name="AmsNetId" Id="{02308492-412c-4a23-87d5-d3466f26825e}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Exposes the native operation target copied from the bound file resource.</summary>
<description>The resource target overwrites a separately assigned value before native submission. Configure the resource owner to select a target; do not change this value while the task is running.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY AmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{3c518d86-7d02-4a09-a394-6841f7a8ac34}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AmsNetId := _PutString.sNetId;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{78a73bc7-3075-4757-a1bb-083ddfdaa2b4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_PutString.sNetId := AmsNetId;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{0b760799-c217-45c2-973f-5be773916b80}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ab62f41d-7f81-4604-8755-1488bd1c120b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FileOperationInProgress" Id="{9a4f50bd-e8ba-4c13-b2dd-c6414f00704f}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the underlying native file operation is busy.</summary>
<description>Observes native I/O, including work drained during stopping. FALSE is not a task-success result and does not independently permit the resource owner to close or destroy the file.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FileOperationInProgress : BOOL]]></Declaration>
      <Get Name="Get" Id="{dc4659a9-b8c9-4fc8-886e-de37577198bb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FileOperationInProgress := _PutString.bBusy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a4029f55-09ae-4261-a0a0-19bf834f2266}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Returns borrowed read-only namespace storage; do not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a6fbf731-8f3f-4acc-a84e-356ba69de31e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnReset" Id="{53dca5b9-de6b-4a90-95fd-1f0e061e0d5c}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Clears the borrowed binding and native request state after stopping.</summary>
<description>Preserves StringToWrite and Timeout. Does not cancel pending I/O; stopping must finish first.</description>
*)
METHOD PROTECTED OnReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.OnReset();

_PutString(bExecute := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{5cd407a7-8a02-494d-a158-94f807a2f78d}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Submits the configured text using the acquired resource and advances the write.</summary>
<description>Missing binding raises a required-property exception before native submission.
Native write errors raise an operation exception without dynamic string-builder allocations for Task to record as FAILURE and finish stopping;
an unsuccessful write does not guarantee that the file is unchanged.</description>
<param name="processingState">DONE on native completion without an error; otherwise retains the pending state.</param>
<param name="stopReasonMessage">Not changed; failures are passed through exceptions.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR
	errorMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _PutString.bExecute THEN 
	IF NOT __ISVALIDREF(_FileHandleResource) THEN
		TOF_Core.Exceptions.ThrowDataMemberNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'FileHandleResource');		
	END_IF
	
	_PutString.sNetId := _FileHandleResource.AmsNetId;
	_PutString.hFile := FileHandle;
END_IF

_PutString(bExecute := TRUE);

IF _PutString.bError THEN
	TOF_Core.WideStrings.Append255(
		errorMessage,
		"An error occurred whole writing string to file ",
		TO_WSTRING(FilePath),
		"'");

	FileSystemExceptions.ThrowFileSystem(NamespaceName, ClassName, __POUNAME(), __POSITION(), errorMessage, errorCode := _PutString.nErrId);
END_IF

IF NOT _PutString.bBusy THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{44b50953-bd58-493c-b48a-1e6d4b051a24}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Wait for an already submitted file operation before allowing handle release.</summary>
<description>
FALSE on bExecute only avoids a new request; it does not abort the pending one.
Runs for every stop reason. If no operation is busy, stopping is ready immediately.
</description>
<param name="readyToRelease">TRUE after pending work has completed and release may begin.</param>
*)

METHOD PROTECTED OnStopping
VAR_OUTPUT
	readyToRelease : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _PutString.bBusy THEN
	_PutString(bExecute := FALSE);
END_IF

readyToRelease := NOT _PutString.bBusy;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{4f9b0242-f34c-4887-bddd-793a928f18fd}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete instance in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{cf34fb03-196f-468e-9070-0202c41039c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StringToWrite" Id="{b5829f8a-442f-4665-90da-2c231925d5bb}" FolderPath="Inputs\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Provides the text copied into this task for the next write.</summary>
<description>Set before Start and keep unchanged until STOPPED. The getter returns configured text,
not a report of bytes written. Reset preserves it. The wrapper does not reject an empty string.</description>
*)
PROPERTY StringToWrite : Tc2_System.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{71543294-bffb-4c26-8fcc-c4af06f05499}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StringToWrite := _PutString.sLine;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{4ac42420-c5ba-4ec2-b893-04afd6c75763}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_PutString.sLine := StringToWrite;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Timeout" Id="{717fa332-6c77-470a-ad49-7d63a1fbd637}" FolderPath="Inputs\">
      <Declaration><![CDATA[(*!
<summary>Configures the timeout passed to native operation requests.</summary>
<description>Set before Start and keep unchanged until STOPPED. Reset preserves this value. It is not an overall task deadline or a guarantee of resource release after a timeout.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{8d6084a4-27a2-40d5-a8b7-702f4613fa0a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _PutString.tTimeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{ba996215-27a0-4cf1-9ad2-0524697f866d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_PutString.tTimeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>