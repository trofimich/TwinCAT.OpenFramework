<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WriteString255ToFile" Id="{23227cf9-4814-43fa-8811-d02015e181a4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
