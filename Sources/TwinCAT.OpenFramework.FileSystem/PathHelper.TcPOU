<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PathHelper" Id="{0dca2365-65a2-482c-a73e-d706575b93b9}" SpecialFunc="None">
    <Declaration><![CDATA[(*!
<summary>Provides lexical checks for directory and file path strings.</summary>
<description>These checks perform no filesystem I/O, normalization or access checks. Passing does not
certify acceptance by a native service or target filesystem. The current filter is not a complete Windows,
UNC or platform-specific path validator; it does not validate reserved names or dot components.
Callers must separately satisfy the path requirements of the actual operation and target.</description>
*)
PROGRAM PathHelper]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="IsValidDirectoryPath" Id="{74a38896-f3ee-456c-865c-7f0b909dbd4e}">
      <Declaration><![CDATA[(*!
<summary>Checks the lexical form of a directory path without accessing the filesystem.</summary>
<description>Rejects an empty path, bytes below ASCII space, characters from the current forbidden set
and repeated slash/backslash separators beyond the leading pair. A colon is accepted only immediately
after an ASCII drive letter and before a separator. Relative paths and a trailing separator are not
rejected solely for being relative or trailing. Leading separator pairs are permitted lexically, but
UNC server/share structure is not checked and native network-path support is not implied.
Reserved names, dot components and trailing dots/spaces are not validated. TRUE means only that this
filter passed; errorMessage is meaningful on FALSE. Input is borrowed only for the call.</description>
<param name="directoryPath">Directory path to inspect without modifying or retaining it.</param>
<param name="errorMessage">Reason for the first rejected condition.</param>
*)
METHOD IsValidDirectoryPath : BOOL
VAR_IN_OUT CONSTANT
	directoryPath : Tc2_System.T_MaxString;
END_VAR
VAR_OUTPUT
	errorMessage : WSTRING(255);
END_VAR
VAR
    i, j : UDINT;
    stringLength : UDINT;
    character : BYTE;
    (* Current lexical exclusions, not an OS-wide list. Caret is an existing library restriction;
       the drive-letter exception below handles the only accepted colon position. *)
    invalidChars : STRING(8) := '<>"|?*^:';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringLength := TOF_Core.Strings.GetLength(directoryPath);

IF stringLength = 0 THEN
	errorMessage := "Path is empty";
    RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    character := directoryPath[i];
	
	// special case with Windows drive path
	IF i = 1 AND_THEN character = Tc2_System.F_ToASC(':') THEN
		IF stringLength >= 3 
			AND_THEN (directoryPath[2] = Tc2_System.F_ToASC('\') OR_ELSE directoryPath[2] = Tc2_System.F_ToASC('/')) 
			AND_THEN ((directoryPath[0] >= Tc2_System.F_ToASC('A') AND_THEN directoryPath[0] <= Tc2_System.F_ToASC('Z')) OR_ELSE (directoryPath[0] >= Tc2_System.F_ToASC('a') AND_THEN directoryPath[0] <= Tc2_System.F_ToASC('z')))
		THEN
			CONTINUE;
		END_IF		
	END_IF
    
    // check for invalid characters
    FOR j := 0 TO TOF_Core.Strings.GetLength(invalidChars) - 1 DO
        IF character = invalidChars[j] THEN			
			errorMessage := TOF_Core.WideStrings.Concat255("The forbidden character '", TO_WSTRING(Tc2_System.F_ToCHR(character)), "' at position ", TO_WSTRING(i + 1));
            RETURN;
        END_IF
    END_FOR
    
	// check for special ascii characters
    IF character < 32 THEN
		errorMessage := TOF_Core.WideStrings.Concat255("The forbidden character with code ", TO_WSTRING(character), " at position ", TO_WSTRING(i + 1));
        RETURN;
    END_IF
	
	// two slashes one after other are not allowed (except on start)
	IF i > 1 
		AND_THEN (character = Tc2_System.F_ToASC('\') OR_ELSE character = Tc2_System.F_ToASC('/')) 
		AND_THEN (directoryPath[i - 1] = Tc2_System.F_ToASC('\') OR_ELSE directoryPath[i - 1] = Tc2_System.F_ToASC('/')) 
	THEN
		errorMessage := TOF_Core.WideStrings.Concat255("Several slashes one by one at position ", TO_WSTRING(i + 1));	
		RETURN;
	END_IF
END_FOR

IsValidDirectoryPath := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsValidFilePath" Id="{c79d4e63-0f05-42ae-918f-7c9d81a28bdc}">
      <Declaration><![CDATA[(*!
<summary>Checks the lexical form of a file path and rejects a trailing separator.</summary>
<description>Borrows the path only for this call. Returns FALSE with errorMessage for an empty path,
a forbidden character, repeated separators beyond the leading pair, or a final slash or backslash.
A drive-letter colon is allowed only before a slash or backslash. TRUE means the lexical checks passed;
it does not establish file existence, access rights or acceptance by the target filesystem.
No filesystem I/O is performed. Relative paths are not rejected solely for being relative. Leading separator
pairs do not establish a valid UNC path; reserved names, dot components and trailing dots/spaces are not
validated. errorMessage is meaningful only when FALSE is returned.</description>
<param name="filePath">File path to inspect without modifying or retaining it.</param>
<param name="errorMessage">Receives the reason for the first rejected condition.</param>
*)
METHOD IsValidFilePath : BOOL
VAR_IN_OUT CONSTANT
	filePath : Tc2_System.T_MaxString;
END_VAR
VAR_OUTPUT
	errorMessage : WSTRING(255);
END_VAR
VAR
    i, j : UDINT;
    stringLength : UDINT;
    character : BYTE;
    (* Current lexical exclusions, not an OS-wide list. Caret is an existing library restriction;
       the drive-letter exception below handles the only accepted colon position. *)
    invalidChars : STRING(8) := '<>"|?*^:';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringLength := TOF_Core.Strings.GetLength(filePath);

IF stringLength = 0 THEN
	errorMessage := "Path is empty";
    RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    character := filePath[i];
	
	// special case with Windows drive path
	IF i = 1 AND_THEN character = Tc2_System.F_ToASC(':') THEN
		IF stringLength >= 3 
			AND_THEN (filePath[2] = Tc2_System.F_ToASC('\') OR_ELSE filePath[2] = Tc2_System.F_ToASC('/')) 
			AND_THEN ((filePath[0] >= Tc2_System.F_ToASC('A') AND_THEN filePath[0] <= Tc2_System.F_ToASC('Z')) OR_ELSE (filePath[0] >= Tc2_System.F_ToASC('a') AND_THEN filePath[0] <= Tc2_System.F_ToASC('z')))
		THEN
			CONTINUE;
		END_IF		
	END_IF
    
    // check for invalid characters
    FOR j := 0 TO TOF_Core.Strings.GetLength(invalidChars) - 1 DO
        IF character = invalidChars[j] THEN
			errorMessage := TOF_Core.WideStrings.Concat255("The forbidden character '", TO_WSTRING(Tc2_System.F_ToCHR(character)), "' at position ", TO_WSTRING(i + 1));
            RETURN;
        END_IF
    END_FOR
    
	// check for special ascii characters
    IF character < 32 THEN
		errorMessage := TOF_Core.WideStrings.Concat255("The forbidden character with code ", TO_WSTRING(character), " at position ", TO_WSTRING(i + 1));
        RETURN;
    END_IF
	
	// two slashes one after other are not allowed (except on start)
	IF i > 1 
		AND_THEN (character = Tc2_System.F_ToASC('\') OR_ELSE character = Tc2_System.F_ToASC('/')) 
		AND_THEN (filePath[i - 1] = Tc2_System.F_ToASC('\') OR_ELSE filePath[i - 1] = Tc2_System.F_ToASC('/')) 
	THEN
		errorMessage := TOF_Core.WideStrings.Concat255("Several slashes one by one at position ", TO_WSTRING(i + 1));	
		RETURN;
	END_IF
	
	// slash can't be the last char of the file path
	IF i = stringLength - 1 AND_THEN (character = Tc2_System.F_ToASC('\') OR_ELSE character = Tc2_System.F_ToASC('/')) THEN
		errorMessage := "Slash at the end of the path";	
		RETURN;
	END_IF
END_FOR

IsValidFilePath := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>