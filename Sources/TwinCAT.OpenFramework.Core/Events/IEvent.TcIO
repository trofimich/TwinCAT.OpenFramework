<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IEvent" Id="{4290fe22-bbfe-42ca-acfa-29f4b1a003dc}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes an event's source and its handled status to recipients.</summary>
<description>
Each instance represents one event occurrence and is not reset or reused for a new occurrence.
Delivery is synchronous. Dispatchers and recipients borrow the event during delivery and must not
retain references to it for later use. Delivery does not transfer ownership or require heap allocation.
Handled records processing independently of propagation; marking an event as handled does not stop delivery.
</description>
*)

INTERFACE IEvent EXTENDS IObject]]></Declaration>
    <Property Name="Handled" Id="{887baed9-f1ee-4209-9b76-3b844d59fcde}">
      <Declaration><![CDATA[(*!
<summary>Reports whether a recipient has marked the event as handled.</summary>
<description>Other recipients may still receive the event; this is not a propagation-stop flag.</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY Handled : BOOL]]></Declaration>
      <Get Name="Get" Id="{4825f4b2-b919-4f9b-9c79-4e4388a5282d}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="SetHandled" Id="{bf90052d-8d4e-4a65-a834-1f380b97a326}">
      <Declaration><![CDATA[(*!
<summary>Marks the event as handled without stopping its propagation.</summary>
*)

METHOD SetHandled]]></Declaration>
    </Method>
    <Property Name="SourceObject" Id="{f823d641-dad4-46f7-8bef-0714c45a8a9b}">
      <Declaration><![CDATA[(*!
<summary>Returns the event's source, or 0 when no specific source is associated with it.</summary>
<description>
The source reference is borrowed; the event neither owns the source nor extends its lifetime.
When a source is supplied, the caller must keep it alive for the entire event lifetime.
Reading this property does not transfer ownership.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY SourceObject : IObject]]></Declaration>
      <Get Name="Get" Id="{c4b87340-f526-4515-8c1c-13ce336c21d0}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>