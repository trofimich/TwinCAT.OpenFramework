<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IBubbleEventDispatcher" Id="{f62a5f0e-5516-42ac-a0e7-a8a62a6e4765}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides synchronous event propagation toward ancestors.</summary>
<description>Events are borrowed during delivery, without ownership transfer or retention for later use.</description>
*)

INTERFACE IBubbleEventDispatcher EXTENDS IObject]]></Declaration>
    <Method Name="BubbleEvent" Id="{acb4d73c-1a1e-40ac-a587-a8c77cde71cc}">
      <Declaration><![CDATA[(*!
<summary>Propagates an event toward ancestors within this call.</summary>
<description>
The event argument must be non-null and refer to a live event.
Delivery is synchronous; it is not queued for later PLC cycles.
An exception from a recipient aborts delivery and propagates to the caller.
Effects of recipients already invoked are not rolled back; remaining recipients are not visited.
The caller keeps the event alive throughout delivery. Dispatchers and recipients must not retain
event references for later use or take ownership. The instance represents the same occurrence for all recipients.
</description>
*)

METHOD BubbleEvent
VAR_INPUT
	event : IEvent;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>