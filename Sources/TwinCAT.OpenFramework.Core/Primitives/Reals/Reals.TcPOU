<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Reals" Id="{361c062a-943b-4db7-ab4a-7715ff446a31}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides finite REAL limits and special floating-point values.</summary>
<description>
MIN_VALUE is the most negative finite REAL; MAX_VALUE is the largest positive finite REAL.
The IEEE 754 binary32 representation stores a sign, an exponent and a fraction in 32 bits.
A mask is an integer pattern used with bitwise AND to retain selected bits and clear the others.
Use these masks with the union Raw member; converting a floating value to an integer does not expose its stored bits.
The masks classify infinity, NaN and signed zero without evaluating NaN operands.
The _BITS constants are complete representations, used to choose one representation for values treated as equal.
Generic REAL/LREAL equality and hashing share the binary64 constants in LongReals after non-NaN REAL values are converted to LREAL.
Infinity constants expose their numeric value through the union Value member.
NOT_A_NUMBER remains computed with LOG(-1) for compatibility with the project's compiler; native equality does not identify NaN.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM Reals
VAR CONSTANT
	(*!
	<summary>Selects the exponent field in the stored REAL bits.</summary>
	<description>IEEE 754 binary32 stores the exponent in bits 30..23 (bit 0 is the least significant). Raw AND EXPONENT_MASK keeps these bits and clears the sign and fraction. If the result equals EXPONENT_MASK, the value is infinity or NaN; FRACTION_MASK distinguishes the two. Apply this mask to the Raw member of the union, without converting the floating value to an integer.</description>
	*)
	EXPONENT_MASK : UDINT := UDINT#16#7F800000;
	(*!
	<summary>Selects the stored fraction field in the REAL bits.</summary>
	<description>Raw AND FRACTION_MASK keeps bits 22..0, which store the fraction of the significand, and clears the sign and exponent. When all exponent bits are set, a zero fraction means infinity and a nonzero fraction means NaN. This field is part of the binary representation; it is not the decimal part after the decimal point.</description>
	*)
	FRACTION_MASK : UDINT := UDINT#16#007FFFFF;
	(*!
	<summary>Removes the sign bit from the stored REAL bits.</summary>
	<description>Raw AND MAGNITUDE_MASK clears sign bit 31 and preserves the exponent and fraction. Both positive zero and negative zero then produce ZERO_BITS, allowing either zero to be recognized without floating-point comparison. The result is an integer bit pattern, not a numeric conversion or a computed floating-point absolute value.</description>
	*)
	MAGNITUDE_MASK : UDINT := UDINT#16#7FFFFFFF;
	(*!
	<summary>Provides one chosen quiet NaN bit pattern for REAL.</summary>
	<description>NaN means not a number and has multiple IEEE 754 encodings. This constant chooses one quiet NaN representation: all exponent bits and the highest fraction bit are set, with all other bits clear. Canonical means that different encodings can be mapped to this single pattern. Generic equality and hashing use LongReals.CANONICAL_NAN_BITS directly for REAL NaN, before converting other REAL values to LREAL. This is an integer bit pattern; the union Value member provides its floating-point interpretation. It is not a mask or a value to compare numerically with NaN.</description>
	*)
	CANONICAL_NAN_BITS : UDINT := UDINT#16#7FC00000;

	(*!
	<summary>Provides the all-zero bit pattern representing positive REAL zero.</summary>
	<description>Negative zero differs only in its sign bit. This constant is the integer bit representation of positive zero. Generic equality and hashing currently normalize zeros after conversion to LREAL, using LongReals.ZERO_BITS. Use it with Raw or the result of Raw AND MAGNITUDE_MASK.</description>
	*)
	ZERO_BITS : UDINT := UDINT#0;

	//!<summary>Most negative finite IEEE 754 binary32 value (raw bits 16#FF7FFFFF).</summary>
	MIN_VALUE : REAL := -3.402823466E+38;
	//!<summary>Largest positive finite IEEE 754 binary32 value (raw bits 16#7F7FFFFF).</summary>
	MAX_VALUE : REAL := +3.402823466E+38;
	
    POSITIVE_INFINITY : REAL_UNION := (Raw := 16#7F800000); 
    NEGATIVE_INFINITY : REAL_UNION := (Raw := 16#FF800000); 
    NOT_A_NUMBER : REAL := TO_REAL(LOG(-1)); // REAL_UNION := (Raw := 16#7FC00000); // IEEE 754 NaN	
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{9df65ee2-61ad-4aa6-8540-da6369d277dd}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f3e499ff-278e-4944-9b5a-c3c32eaeeaeb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{38bfc198-2daa-457d-8569-d0dd6eafc0d0}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f423181e-b835-486d-a0e9-cbf1e9bf75ba}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
