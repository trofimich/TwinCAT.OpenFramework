<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="LREAL_UNION" Id="{0ec34dde-090d-4f4c-9891-07730a892d72}">
    <Declaration><![CDATA[(*!
<summary>Provides floating-point and raw-bit views of the same 64-bit storage.</summary>
<description>Value and Raw overlap. Reading the other member reinterprets bits; it does not perform numeric conversion.</description>
*)
TYPE LREAL_UNION :
UNION
    Value : LREAL;
    Raw : ULINT;
END_UNION
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>