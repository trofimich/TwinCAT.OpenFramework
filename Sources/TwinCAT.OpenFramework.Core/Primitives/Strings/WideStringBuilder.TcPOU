(*!
<summary>Builds a wide string in an owned, reusable dynamic buffer.</summary>
<description>WSTRING inputs are appended without a 255-character intermediate buffer. Other ANY types retain InternalAnyToString255 conversion. AppendString255 methods remain limited by their declared input type. Input storage is borrowed only during the call; StringAddress is invalidated by buffer growth or release. Use each instance from one task. Allocation failure uses the terminal DynamicMemoryManager path. AssignToString requires enough space for the complete text and its terminator.</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
FUNCTION_BLOCK WideStringBuilder EXTENDS Object
VAR CONSTANT
	STRING_CHAR_SIZE : BYTE := 2;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_String : POINTER TO WSTRING;
	{attribute 'hide'} 
	_Length : UDINT;
	{attribute 'hide'} 
	_Capacity : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{9857c13e-06aa-4399-9488-6a58a1b6e6a8}" />
    <Method Name="Append" Id="{6f3cbb3e-fb01-46b8-b89e-0f2b1d1d3fe5}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the wide string under the method's input rules.</summary>
<description>Appends a WSTRING directly without the 255-character conversion limit; other ANY types retain their existing conversion. Returns this builder for chaining.</description>
*)

METHOD Append : REFERENCE TO WideStringBuilder
VAR_INPUT
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalAppend(value);

Append REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendIf" Id="{1027bfdc-7c63-46bc-8795-3097e5694098}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the wide string under the method's input rules.</summary>
<description>When condition is TRUE, appends using the same conversion rules as Append. Otherwise leaves the buffer unchanged. Returns this builder.</description>
*)

METHOD AppendIf : REFERENCE TO WideStringBuilder
VAR_INPUT
	value : ANY;
	condition : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	InternalAppend(value);
END_IF

AppendIf REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendString" Id="{05b18936-609a-4892-bda6-5361d77d0a41}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the wide string under the method's input rules.</summary>
<description>Borrows a null-terminated WSTRING for this call and appends its text without a WSTRING(255) intermediate value. Returns this builder.</description>
*)

METHOD AppendString : REFERENCE TO WideStringBuilder
VAR_IN_OUT CONSTANT
	value : WSTRING;
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
valueDescriptor.pValue := ADR(value);
valueDescriptor.diSize := 2 * TO_DINT(Tc2_Utilities.WLEN2(ADR(value))) + 2;

InternalAppend(valueDescriptor);

AppendString REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendString255" Id="{b07d1f15-7ae5-4ead-a318-bab33de34773}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the wide string under the method's input rules.</summary>
<description>Appends the supplied WSTRING(255). The public input type limits this overload to 255 characters. Returns this builder.</description>
*)

METHOD AppendString255 : REFERENCE TO WideStringBuilder
VAR_INPUT
	value : WSTRING(255);
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
valueDescriptor.pValue := ADR(value);
valueDescriptor.diSize := 2 * TO_DINT(Tc2_Utilities.WLEN2(ADR(value))) + 2;

InternalAppend(valueDescriptor);

AppendString255 REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendString255If" Id="{8e3a3f02-4c32-45d6-9fff-f406b2a78b75}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the wide string under the method's input rules.</summary>
<description>When condition is TRUE, appends the supplied WSTRING(255). The input type limits this overload to 255 characters. Returns this builder.</description>
*)

METHOD AppendString255If : REFERENCE TO WideStringBuilder
VAR_INPUT
	value : WSTRING(255);
	condition : BOOL;
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
	valueDescriptor.pValue := ADR(value);
	valueDescriptor.diSize := 2 * TO_DINT(Tc2_Utilities.WLEN2(ADR(value))) + 2;
	
	InternalAppend(valueDescriptor);
END_IF

AppendString255If REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendStringIf" Id="{0373130c-990c-40b3-b6a5-31b35f0c79b7}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the wide string under the method's input rules.</summary>
<description>When condition is TRUE, appends the borrowed WSTRING without a WSTRING(255) intermediate value. Otherwise leaves the buffer unchanged. Returns this builder.</description>
*)

METHOD AppendStringIf : REFERENCE TO WideStringBuilder
VAR_IN_OUT CONSTANT
	value : WSTRING;
END_VAR
VAR_INPUT
	condition : BOOL;
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
	valueDescriptor.pValue := ADR(value);
	valueDescriptor.diSize := 2 * TO_DINT(Tc2_Utilities.WLEN2(ADR(value))) + 2;
	
	InternalAppend(valueDescriptor);
END_IF

AppendStringIf REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AssignToString" Id="{4e181416-d833-48b8-b605-97d9ed4518a3}">
      <Declaration><![CDATA[(*!
<summary>Copies the complete built text into a caller-owned WSTRING.</summary>
<description>The target must hold all characters and one terminator. Wrong type or insufficient capacity raises the existing argument exception. An empty builder writes only the terminator. Returns whether all character bytes were copied; does not truncate.</description>
*)

METHOD AssignToString : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR
	targetStringPointer : POINTER TO WSTRING;
	textSize : UDINT;
 
	invalidTargetStringTypeException : ArgumentTypeClassNotSupportedException;
	invalidTargetStringSizeException : TargetVariableMemoryOverflowException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	invalidTargetStringTypeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', targetString.TypeClass);
END_IF

IF TO_ULINT(targetString.diSize) < TO_ULINT(StringRealSize) THEN
	invalidTargetStringSizeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize));
END_IF

targetStringPointer := targetString.pValue;

textSize := _Length * STRING_CHAR_SIZE;
IF textSize > 0 THEN
	AssignToString := Tc2_System.MEMCPY(targetStringPointer, _String, textSize) = textSize;
ELSE
	AssignToString := TRUE;
END_IF

Tc2_System.MEMSET(targetString.pValue + textSize, 0, STRING_CHAR_SIZE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Capacity" Id="{566ddd93-32fa-48ab-976d-1e9fdb82325e}">
      <Declaration><![CDATA[PROPERTY Capacity : UDINT]]></Declaration>
      <Get Name="Get" Id="{66b8ca6d-f87a-416b-ac7a-3b57e4e78287}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Capacity := _Capacity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{20db3583-02f9-493d-96b4-447b8007a2cd}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING
]]></Declaration>
      <Get Name="Get" Id="{df1a47fe-9ca7-4256-ad0f-1c4235f9f5d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{1277440b-361c-4cfe-b957-700fa5da93d9}">
      <Declaration><![CDATA[METHOD Clear : REFERENCE TO WideStringBuilder
VAR_INPUT
	releaseMemory : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Length := 0;

IF _Capacity > 0 THEN
	IF releaseMemory THEN
		__DELETE(_String);	
		_Capacity := 0;	
	ELSE
		Tc2_System.MEMSET(_String, 0, StringMaxSize);
	END_IF	
END_IF

Clear REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearIf" Id="{c57c2045-0bf2-4101-bf48-28fb50ecc9b2}">
      <Declaration><![CDATA[METHOD ClearIf : REFERENCE TO WideStringBuilder
VAR_INPUT
	condition : BOOL;
	releaseMemory : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	Clear(releaseMemory);
END_IF

ClearIf REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{1c72be94-5d9c-4cd8-b16c-b46c483f30d8}">
      <Declaration><![CDATA[//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear(TRUE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAppend" Id="{1fbc2ca2-a0a0-454f-989f-7506cc4419b4}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends a complete WSTRING or the existing formatted representation of another type.</summary>
<description>The descriptor must identify valid input storage. WSTRING is read up to its terminator within diSize. The source may refer to the current buffer: it is copied before the old allocation is released. Other types retain the 255-character conversion. Empty input is a no-op. Allocation failure leaves the existing buffer intact and raises the terminal allocation error without returning normally.</description>
*)

METHOD PROTECTED InternalAppend 
VAR_IN_OUT CONSTANT
	value : __SYSTEM.AnyType;
END_VAR
VAR
	sourceAddress : POINTER TO WORD;

	string255ToAppend : WSTRING(255);	

	stringToAppendLength : UDINT;
	
	requiredLength : ULINT;
	
	newString : POINTER TO BYTE;
	newCapacity : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	sourceAddress := value.pValue;
	
	WHILE stringToAppendLength < TO_UDINT(value.diSize / STRING_CHAR_SIZE) AND_THEN sourceAddress[stringToAppendLength] <> 0	DO
		stringToAppendLength := stringToAppendLength + 1;
	END_WHILE
ELSE
	string255ToAppend := WideStrings.InternalAnyToString255(value);
	
	sourceAddress := ADR(string255ToAppend);
	
	stringToAppendLength := TO_UDINT(Tc2_Standard.WLEN(string255ToAppend));
END_IF

IF stringToAppendLength = 0 THEN
	RETURN;
END_IF

requiredLength := TO_ULINT(_Length) + stringToAppendLength;

IF requiredLength > (TO_ULINT(UnsignedInt32.MAX_VALUE) / STRING_CHAR_SIZE) - 1 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

IF requiredLength > _Capacity THEN
	newCapacity := TO_UDINT(requiredLength);
	
	IF requiredLength < TO_ULINT(_Length) + 80	AND_THEN TO_ULINT(_Length) + 80 <= (TO_ULINT(UnsignedInt32.MAX_VALUE) / STRING_CHAR_SIZE) - 1 THEN
		newCapacity := _Length + 80;
	END_IF

	newString := __NEW(BYTE, (STRING_CHAR_SIZE + (newCapacity * STRING_CHAR_SIZE)));
	
	IF newString = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	IF _Length > 0 THEN
		Tc2_System.MEMCPY(newString, _String, _Length * STRING_CHAR_SIZE);
	END_IF
	
	Tc2_System.MEMCPY(newString + (_Length * STRING_CHAR_SIZE), sourceAddress, stringToAppendLength * STRING_CHAR_SIZE);
	Tc2_System.MEMSET(newString + (TO_UDINT(requiredLength) * STRING_CHAR_SIZE), 0, STRING_CHAR_SIZE);

	IF _String <> 0 THEN
		__DELETE(_String);
	END_IF
	
	_String := newString;
	_Capacity := newCapacity;
ELSE
	newString := _String;
	
	Tc2_System.MEMCPY(newString + (_Length * STRING_CHAR_SIZE), sourceAddress, stringToAppendLength * STRING_CHAR_SIZE);
	Tc2_System.MEMSET(newString + (TO_UDINT(requiredLength) * STRING_CHAR_SIZE), 0, STRING_CHAR_SIZE);
END_IF

_Length := TO_UDINT(requiredLength);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{28fe3bd4-1d06-4af1-8052-95257a1415e7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
