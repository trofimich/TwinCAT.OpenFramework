<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringSplittingEnumerator" Id="{cd3c3f30-cd38-4659-b9c4-859e877b4baf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Enumerates allocated text fragments from a borrowed source string.</summary>
<description>Initialization requires a separator containing 1 to 80 characters, stored in a fixed buffer. The source must remain alive and unchanged during iteration. The enumerator owns the current fragment; borrowed fragment references expire on MoveNext, Reset or destruction. Allocation failure uses the terminal memory mechanism. With a nonempty separator, empty fragments are preserved when RemoveEmptyEntries is FALSE, including the final fragment after a trailing separator and one fragment for an empty source. RemoveEmptyEntries filters empty fragments after optional trimming. MaxCount still limits the number of returned fragments. Do not copy an instance by assignment or pass it by value while it owns an allocated buffer; use references instead. Assignment does not clone the buffer or transfer ownership. Do not overwrite an instance that still owns a buffer. The creator is responsible for the splitter lifetime and cleanup. Release the current fragment with Reset when abandoning iteration. Delete the splitter itself only if it was allocated with __NEW; FB_exit releases its current fragment. Statically or locally declared instances must not be passed to __DELETE. The borrowed source is never owned or freed by the splitter.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK WideStringSplittingEnumerator EXTENDS Object IMPLEMENTS IEnumerator
VAR_OUTPUT
	SourceString : POINTER TO WSTRING;
	SourceStringLength : UDINT;
	SourceStringSize : UDINT;
	Separator : WSTRING(80);
	SeparatorLength : UDINT;
	//!<summary>Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</summary>
	MaxCount : UDINT := 0;
	TrimEntries : BOOL := FALSE;
	RemoveEmptyEntries : BOOL := FALSE;	
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_CurrentString : POINTER TO WSTRING;
	{attribute 'hide'} 
	_CurrentStringLength : UDINT;
	{attribute 'hide'} 
	_CurrentEntry : POINTER TO WSTRING;
	{attribute 'hide'} 
	_CurrentEntrySize : UDINT;
	{attribute 'hide'} 
	_EntryCount : UDINT; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{eb782797-fea3-47ac-a8db-cbfc72d737be}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b0de37f0-477e-4092-a2e4-1e3cd48b7e08}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Current" Id="{a33a22ac-5669-4623-936f-19fdd6a797a9}">
      <Declaration><![CDATA[(*!
<summary>Shows curent collection element</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY Current : REFERENCE TO GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{b343fd78-0841-4c7a-bd2d-6b447815e0a9}">
        <Declaration><![CDATA[VAR_INST
	genericValue : GENERIC_VALUE;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentEntry <> 0 AND_THEN _CurrentEntrySize > 0 THEN
	genericValue := GenericValueFactory.FromParts(GENERIC_TYPE_CLASS.STRING_UTF16, _CurrentEntry, _CurrentEntrySize, GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
ELSE
	genericValue.Reset();
END_IF

Current REF= genericValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CurrentEntry" Id="{f4b2ce05-56f1-4a2a-ab8a-2d63ad7de743}">
      <Declaration><![CDATA[PROPERTY CurrentEntry : REFERENCE TO WSTRING
]]></Declaration>
      <Get Name="Get" Id="{859e54d6-429d-47fd-a753-3e8e965a0bc3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentEntry <> 0 THEN
	CurrentEntry REF= _CurrentEntry^;	
END_IF ]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{d23faa7c-5379-472c-b75f-ff9aa468fe1d}">
      <Declaration><![CDATA[//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentEntry <> 0 THEN
	__DELETE(_CurrentEntry);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{efd8c83e-84af-4552-92cf-49864ca5b37a}">
      <Declaration><![CDATA[(*!
<summary>Sets the borrowed source and splitting options, then resets iteration.</summary>
<description>SourceStringLength counts UTF-16 code units; SourceStringSize counts bytes including the terminator. The separator is copied into internal storage. The source remains caller-owned.</description>
*)
//!<param name="maxCount">Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</param>
//!<param name="separator">Separator containing 1 to 80 characters; the caller must validate its length before initialization.</param>
METHOD INTERNAL Initialize
VAR_INPUT
	sourceString : POINTER TO WSTRING;
	separator : WSTRING(80);
	maxCount : UDINT;
	trimEntries : BOOL;
	removeEmptyEntries : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.SourceString := sourceString;
THIS^.SourceStringLength := WideStrings.InternalGetLength(sourceString);
THIS^.SourceStringSize := (THIS^.SourceStringLength + 1) * WideStrings.CharSize; 
THIS^.Separator := separator;
THIS^.SeparatorLength := WideStrings.InternalGetLength(ADR(THIS^.Separator));
THIS^.MaxCount := maxCount;
THIS^.TrimEntries := trimEntries;
THIS^.RemoveEmptyEntries := removeEmptyEntries;

_CurrentString := THIS^.SourceString;

Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveNext" Id="{6f4c66bb-70e6-443d-b741-5ac7aedc0a0c}">
      <Declaration><![CDATA[(*!
<summary>Releases the previous fragment and advances to the next selected fragment.</summary>
<description>Returns TRUE when a new current fragment is available, FALSE at the end or when the configured limit is reached. A non-null cursor with zero remaining length represents a pending empty final fragment; a null cursor marks completed iteration. Empty fragments are returned unless RemoveEmptyEntries is TRUE, subject to MaxCount. Each fragment owns a null-terminated allocation; allocation failure invokes DynamicMemoryManager.RaiseAllocationFailure before the buffer is accessed.</description>
*)
METHOD MoveNext : BOOL
VAR
	separatorPosition : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[START:

IF _CurrentEntry <> 0 THEN
	_CurrentEntrySize := 0;
	
	__DELETE(_CurrentEntry);
END_IF

IF _CurrentString = 0 OR_ELSE Separator = "" OR_ELSE (MaxCount > 0 AND_THEN _EntryCount >= MaxCount) THEN
	RETURN;
END_IF

IF WideStrings.InternalFind(_CurrentString, _CurrentStringLength, ADR(Separator), SeparatorLength, position => separatorPosition) THEN
	_CurrentEntrySize := separatorPosition * WideStrings.CharSize;
	_CurrentEntry := __NEW(BYTE, _CurrentEntrySize);

	IF _CurrentEntry = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	Tc2_System.MEMCPY(_CurrentEntry, _CurrentString, (separatorPosition - 1) * WideStrings.CharSize);
	Tc2_System.MEMSET(_CurrentEntry + ((separatorPosition - 1) * WideStrings.CharSize), 0, WideStrings.CharSize);

	_CurrentString := _CurrentString + ((separatorPosition - 1) * WideStrings.CharSize) + (SeparatorLength * WideStrings.CharSize);
	_CurrentStringLength := _CurrentStringLength - separatorPosition + 1 - SeparatorLength;
ELSE	
	_CurrentEntrySize := (_CurrentStringLength + 1) * WideStrings.CharSize;	
	_CurrentEntry := __NEW(BYTE, _CurrentEntrySize);

	IF _CurrentEntry = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF
	
	Tc2_System.MEMCPY(_CurrentEntry, _CurrentString, _CurrentEntrySize);
	
	_CurrentString := 0;
	_CurrentStringLength := 0;
END_IF

IF TrimEntries THEN
	WideStrings.TrimChar(_CurrentEntry^);
END_IF

IF RemoveEmptyEntries AND_THEN _CurrentEntry^ = "" THEN
	JMP START;
END_IF

_EntryCount := _EntryCount + 1;

MoveNext := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{606a15c2-aeca-432d-8e3c-a9852072d07e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8d26a153-dac4-4ce7-b323-94027a2445d2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{6ff5f895-f51d-4f1c-b79b-00ce34e370cc}">
      <Declaration><![CDATA[(*!
<summary>Releases the current fragment and resets iteration to before the first entry.</summary>
<description>
Preserves splitting settings and does not allocate memory or modify the source string.
Previously borrowed fragment addresses and references become invalid.
The initialized source string must remain alive and unchanged throughout iteration.
Repeated Reset calls are allowed, including before iteration and after its end.
</description>
*)
METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentEntry <> 0 THEN
	__DELETE(_CurrentEntry);
END_IF

_CurrentEntry := 0;
_CurrentEntrySize := 0;

_CurrentString := SourceString;
_CurrentStringLength := SourceStringLength;
_EntryCount := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{e6e7cb18-6bbe-4fa5-8b86-e60c4005ed50}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6cd74453-76de-45a9-9aff-7d3ec88a250f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>