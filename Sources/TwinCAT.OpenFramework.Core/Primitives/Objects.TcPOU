<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Objects" Id="{2b792c90-0560-472d-af9e-6b756ff69e35}" SpecialFunc="None">
    <Declaration><![CDATA[(*

