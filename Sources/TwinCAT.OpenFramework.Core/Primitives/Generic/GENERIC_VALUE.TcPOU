{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Describes typed generic storage and provides value access and conversion operations.</summary>
<description>Stores a type category, address, byte size and ownership flag for externally stored data. Copying this descriptor copies those fields, not the referenced payload. Typed access requires live storage matching the descriptor; conversion methods do not validate its lifetime. Equals and GetHashCode share value semantics and accept an optional borrowed IEqualityComparer. They preserve type categories, normalize floating NaN and signed zero, and delegate nonempty OBJECT operands to the object's equality/hash pair. Neither method adds descriptor state or takes ownership. Try methods contain exceptions and report failure without rolling back bytes already written.</description>
*)
FUNCTION_BLOCK GENERIC_VALUE
VAR_OUTPUT
	Address : POINTER TO BYTE;
	Size : ULINT;
	TypeClass : GENERIC_TYPE_CLASS;
	IsMemoryOwner : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="AsTyped" Id="{e96a41ac-e3cd-4eee-9bfa-b62dba0c2d0e}">
      <Folder Name="Date and time" Id="{0e8135f9-c7a8-41d0-996d-4e135d2a2366}" />
