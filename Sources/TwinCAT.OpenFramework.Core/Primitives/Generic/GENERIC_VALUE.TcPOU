		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(UnsignedInt16.MAX_VALUE)) THEN
			AsUInt := TO_UINT(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE)) THEN
			AsUInt := TO_UINT(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE)) THEN
			AsUInt := TO_UINT(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsDInt^) <= TO_LINT(UnsignedInt16.MAX_VALUE)) THEN
			AsUInt := TO_UINT(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(UnsignedInt16.MAX_VALUE)) THEN
			AsUInt := TO_UINT(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_16);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsULInt" Id="{ddfdd7f6-ff0f-4202-a7b9-d1b08069f76c}" FolderPath="AsTyped\Integer\Unsugned\">
