    <Method Name="AsAnyType" Id="{59db7a53-29a2-4c5e-a06f-b2b343ab8f25}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed system descriptor for this generic value.</summary>
<description>Does not copy the payload or transfer ownership. Size above SignedInt32.MAX_VALUE raises ArgumentOutOfRangeException; type mapping exceptions propagate. The caller keeps the described storage alive while using the result. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsAnyType : __SYSTEM.AnyType]]></Declaration>
      <Implementation>
        <ST><![CDATA[AsAnyType := SystemAnyTypes.CreateAnyTypeByGenericValue(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsBool" Id="{1aaa60f7-a8aa-48fc-a4c3-f53925263a40}" FolderPath="AsTyped\">
      <Declaration><![CDATA[(*!
<summary>Reads a Boolean or converts an integer to FALSE for zero and TRUE for any nonzero value.</summary>
<description>Requires live storage matching the descriptor. Signed and unsigned integers are read at their full width, including BYTE, WORD, DWORD and LWORD representations. Other categories throw GenericConversionNotSupportedException. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsBool : BOOL
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN:
		AsBool := universalPointer.AsBool^;
		RETURN;

	GENERIC_TYPE_CLASS.INT_8, GENERIC_TYPE_CLASS.INT_16, GENERIC_TYPE_CLASS.INT_32, GENERIC_TYPE_CLASS.INT_64:
		AsBool := AsLInt() <> 0;
		RETURN;

	GENERIC_TYPE_CLASS.UINT_8, GENERIC_TYPE_CLASS.UINT_16, GENERIC_TYPE_CLASS.UINT_32, GENERIC_TYPE_CLASS.UINT_64:
		AsBool := AsULInt() <> 0;
		RETURN;
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.BOOLEAN);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsByte" Id="{936f9e9f-e35c-461b-a5b6-c2e02b118baf}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsByte : BYTE
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsByte := universalPointer.AsByte^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsWord^) <= TO_ULINT(UnsignedByte.MAX_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(UnsignedByte.MAX_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsDWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(UnsignedByte.MAX_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedByte.MIN_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsInt^) <= TO_LINT(UnsignedByte.MAX_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsDInt^) <= TO_LINT(UnsignedByte.MAX_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(UnsignedByte.MAX_VALUE)) THEN
			AsByte := TO_BYTE(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsDate" Id="{db320a05-493c-45cf-92f8-51bf496ee511}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to DATE.</summary>
<description>Requires live storage matching the descriptor. INT_32, UINT_32, INT_64 and UINT_64 are counts of seconds since the epoch; DATE_AND_TIME_32 is a calendar timestamp. Numeric inputs must fit DateAndTimes.MIN_VALUE/MAX_VALUE even with TRUE. LDATE is checked as signed nanoseconds against the same limits widened to LDT before narrowing. For these inputs, FALSE accepts only midnight; TRUE discards the time of day. The result of these conversions has no hidden time remainder. Rejected or unsupported conversions raise GenericConversionNotSupportedException. DATE_32 is read directly. A valid calendar LDATE within the DATE range is accepted with either flag; a hidden time remainder requires TRUE and is explicitly removed. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows discarding the time of day from numeric, DT and LDATE inputs; does not permit numeric or LDATE range overflow.</param>
METHOD FINAL AsDate : DATE
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;

	secondsSinceMidnight : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.DATE_32: 
		 AsDate := universalPointer.AsDate^;
		 RETURN;		 

	GENERIC_TYPE_CLASS.INT_32:
		IF universalPointer.AsDInt^ >= TO_LINT(DateAndTimes.MIN_VALUE) THEN
			secondsSinceMidnight := TO_UDINT(universalPointer.AsDInt^) MOD Times.SECONDS_PER_DAY;

			IF allowTypeCastWithDataLoss OR_ELSE secondsSinceMidnight = 0 THEN
				AsDate := TO_DATE(TO_UDINT(universalPointer.AsDInt^) - secondsSinceMidnight);
				RETURN;
			END_IF
		END_IF

	GENERIC_TYPE_CLASS.UINT_32, GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		secondsSinceMidnight := TO_UDINT(universalPointer.AsUDInt^) MOD Times.SECONDS_PER_DAY;

		IF allowTypeCastWithDataLoss OR_ELSE secondsSinceMidnight = 0 THEN
			AsDate := TO_DATE(TO_UDINT(universalPointer.AsUDInt^) - secondsSinceMidnight);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF universalPointer.AsLInt^ >= TO_LINT(DateAndTimes.MIN_VALUE) AND_THEN universalPointer.AsLInt^ <= TO_LINT(DateAndTimes.MAX_VALUE) THEN
			secondsSinceMidnight := TO_UDINT(universalPointer.AsLInt^) MOD Times.SECONDS_PER_DAY;

			IF allowTypeCastWithDataLoss OR_ELSE secondsSinceMidnight = 0 THEN
				AsDate := TO_DATE(TO_UDINT(universalPointer.AsLInt^) - secondsSinceMidnight);
				RETURN;
			END_IF
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF universalPointer.AsULInt^ <= TO_ULINT(DateAndTimes.MAX_VALUE) THEN
			secondsSinceMidnight := TO_UDINT(universalPointer.AsULInt^) MOD Times.SECONDS_PER_DAY;

			IF allowTypeCastWithDataLoss OR_ELSE secondsSinceMidnight = 0 THEN
				AsDate := TO_DATE(TO_UDINT(universalPointer.AsULInt^) - secondsSinceMidnight);
				RETURN;
			END_IF
		END_IF

	GENERIC_TYPE_CLASS.DATE_64:
		IF universalPointer.AsLInt^ >= TO_LINT(TO_LDT(DateAndTimes.MIN_VALUE))
			AND_THEN universalPointer.AsLInt^ <= TO_LINT(TO_LDT(DateAndTimes.MAX_VALUE)) THEN
			IF allowTypeCastWithDataLoss OR_ELSE universalPointer.AsLInt^ MOD TO_LINT(LongTimes.ONE_DAY) = 0 THEN
				// Remove the time in nanoseconds before converting whole seconds to DATE.
				AsDate := TO_DATE((universalPointer.AsLInt^ - universalPointer.AsLInt^ MOD TO_LINT(LongTimes.ONE_DAY))
					/ TO_LINT(LongTimes.ONE_SECOND));
				RETURN;
			END_IF
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.DATE_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsDateAndTime" Id="{ba931761-c96e-42e2-9fa4-d1882172beda}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to DATE_AND_TIME.</summary>
<description>Requires live storage matching the descriptor. For DATE_AND_TIME_64, FALSE requires a timestamp within the DT range and an exact whole number of seconds. Signed nanoseconds are checked before narrowing. TRUE uses native TO_DT without these checks; out-of-range behavior depends on the runtime and may raise an exception. Rejected or unsupported conversions raise GenericConversionNotSupportedException. Numeric inputs are seconds since the epoch. With FALSE, signed inputs must be nonnegative and 64-bit inputs must fit the DT range; TRUE passes the original signed or unsigned value to native TO_DT. DATE_32 and DATE_AND_TIME_32 retain their direct conversion paths. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows loss of precision or range in LDT to DT conversion and native numeric conversions outside the DT range.</param>
METHOD FINAL AsDateAndTime : DATE_AND_TIME
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		 AsDateAndTime := universalPointer.AsDateAndTime^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_32:
		 AsDateAndTime := TO_DT(universalPointer.AsUDInt^);
		 RETURN;
		
	GENERIC_TYPE_CLASS.DATE_32:
		 AsDateAndTime := TO_DT(universalPointer.AsDate^);
		 RETURN;
	GENERIC_TYPE_CLASS.DATE_AND_TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE (
			universalPointer.AsLInt^ >= TO_LINT(TO_LDT(DateAndTimes.MIN_VALUE))
			AND_THEN universalPointer.AsLInt^ <= TO_LINT(TO_LDT(DateAndTimes.MAX_VALUE))
			AND_THEN universalPointer.AsLInt^ MOD TO_LINT(LongTimes.ONE_SECOND) = 0) THEN
			AsDateAndTime := TO_DT(universalPointer.AsLDateAndTime^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE universalPointer.AsDInt^ >= TO_LINT(DateAndTimes.MIN_VALUE) THEN
			AsDateAndTime := TO_DT(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (
			universalPointer.AsLInt^ >= TO_LINT(DateAndTimes.MIN_VALUE)
			AND_THEN universalPointer.AsLInt^ <= TO_LINT(DateAndTimes.MAX_VALUE)) THEN
			AsDateAndTime := TO_DT(universalPointer.AsLInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE universalPointer.AsULInt^ <= TO_ULINT(DateAndTimes.MAX_VALUE) THEN
			AsDateAndTime := TO_DT(universalPointer.AsULInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.DATE_AND_TIME_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsDInt" Id="{4fea0b7d-fe5e-4808-9a02-b0a72b1114c9}" FolderPath="AsTyped\Integer\Signed\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsDInt : DINT
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsDInt := TO_DINT(universalPointer.AsByte^);
		 RETURN;
		
	GENERIC_TYPE_CLASS.UINT_16:
		 AsDInt := TO_DINT(universalPointer.AsWord^);
		 RETURN;

	GENERIC_TYPE_CLASS.INT_8: 
		 AsDInt := TO_DINT(universalPointer.AsSInt^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.INT_16: 
		 AsDInt := TO_DINT(universalPointer.AsInt^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.INT_32: 
		 AsDInt := universalPointer.AsDInt^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(SignedInt32.MAX_VALUE)) THEN
			AsDInt := TO_DINT(universalPointer.AsDWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(SignedInt32.MAX_VALUE)) THEN
			AsDInt := TO_DINT(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(SignedInt32.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(SignedInt32.MAX_VALUE)) THEN
			AsDInt := TO_DINT(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.INT_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsDWord" Id="{1ee84003-88d5-466d-8c56-9b5d650c16eb}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsDWord : DWORD
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsDWord := TO_DWORD(universalPointer.AsByte^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.UINT_16:
		 AsDWord := TO_DWORD(universalPointer.AsWord^);
		 RETURN;
 
	GENERIC_TYPE_CLASS.UINT_32: 
		 AsDWord := universalPointer.AsDWord^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(UnsignedInt32.MAX_VALUE)) THEN
			AsDWord := TO_DWORD(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE)) THEN
			AsDWord := TO_DWORD(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE)) THEN
			AsDWord := TO_DWORD(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE)) THEN
			AsDWord := TO_DWORD(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(UnsignedInt32.MAX_VALUE)) THEN
			AsDWord := TO_DWORD(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsInt" Id="{fbd81b42-6af9-470c-9770-5641903fbac8}" FolderPath="AsTyped\Integer\Signed\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsInt : INT
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsInt := TO_INT(universalPointer.AsByte^);
		 RETURN;

	GENERIC_TYPE_CLASS.INT_8: 
		 AsInt := TO_INT(universalPointer.AsSInt^);
		 RETURN;
			 
	GENERIC_TYPE_CLASS.INT_16: 
		 AsInt := universalPointer.AsInt^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsWord^) <= TO_ULINT(SignedInt16.MAX_VALUE)) THEN
			AsInt := TO_INT(universalPointer.AsWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(SignedInt16.MAX_VALUE)) THEN
			AsInt := TO_INT(universalPointer.AsDWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(SignedInt16.MAX_VALUE)) THEN
			AsInt := TO_INT(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(SignedInt16.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsDInt^) <= TO_LINT(SignedInt16.MAX_VALUE)) THEN
			AsInt := TO_INT(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(SignedInt16.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(SignedInt16.MAX_VALUE)) THEN
			AsInt := TO_INT(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.INT_16);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsIObject" Id="{80096a9d-d283-480b-80a4-d0dd536beae0}" FolderPath="AsTyped\">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed IObject view of object storage.</summary>
<description>Requires OBJECT TypeClass; other tags raise GenericConversionNotSupportedException. A null address returns a null interface; a nonnull address must identify a live compatible object. Does not clone or transfer ownership. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsIObject : IObject
VAR
	objectPointer : POINTER TO Object;

	conversionException : GenericConversionNotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TypeClass = GENERIC_TYPE_CLASS.OBJECT THEN
	objectPointer := Address;
	
	IF objectPointer <> 0 THEN
		__QUERYINTERFACE(objectPointer^, AsIObject);						
	END_IF
ELSE	
	conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.OBJECT);		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLDate" Id="{a43023c1-e686-4d4d-82c6-573f5b54a6de}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to LDATE.</summary>
<description>Requires live storage matching the descriptor. DATE_AND_TIME_32 and DATE_AND_TIME_64 are treated as calendar timestamps. INT_64 and UINT_64 are signed and unsigned counts of nanoseconds since the epoch. UINT_64 values above LongDateAndTimes.MAX_VALUE are rejected even with TRUE. Numeric inputs follow calendar normalization: FALSE accepts only midnight; TRUE discards the time of day. The results have no hidden time remainder. LDT normalization uses signed nanoseconds and rounds down to midnight, including before the epoch. The first partial LDT day (1677-09-21) is rejected even with TRUE because its midnight cannot be represented in LDATE; the range check precedes subtraction. Rejected or unsupported conversions raise GenericConversionNotSupportedException. DATE_64 is read directly and DATE_32 uses native widening; these paths do not normalize hidden time components. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows discarding the time of day from DT, LDT and numeric nanosecond counts; does not permit a midnight outside the LDATE range.</param>
METHOD FINAL AsLDate : LDATE
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;

	secondsSinceMidnight : UDINT;
	nanosecondsSinceMidnight : LINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.DATE_64: 
		 AsLDate := universalPointer.AsLDate^;
		 RETURN;		 

	GENERIC_TYPE_CLASS.DATE_32: 
		 AsLDate := TO_LDATE(universalPointer.AsDate^);
		 RETURN;
	GENERIC_TYPE_CLASS.UINT_64:
		IF universalPointer.AsULInt^ <= TO_ULINT(LongDateAndTimes.MAX_VALUE) THEN
			nanosecondsSinceMidnight := TO_LINT(universalPointer.AsULInt^ MOD TO_ULINT(LongTimes.ONE_DAY));

			IF allowTypeCastWithDataLoss OR_ELSE nanosecondsSinceMidnight = 0 THEN
				AsLDate := TO_LDATE(universalPointer.AsULInt^ - TO_ULINT(nanosecondsSinceMidnight));
				RETURN;
			END_IF
		END_IF

	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		secondsSinceMidnight := TO_UDINT(universalPointer.AsDateAndTime^) MOD Times.SECONDS_PER_DAY;

		IF allowTypeCastWithDataLoss OR_ELSE secondsSinceMidnight = 0 THEN
			AsLDate := TO_LDATE(TO_DT(TO_UDINT(universalPointer.AsDateAndTime^) - secondsSinceMidnight));
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.DATE_AND_TIME_64, GENERIC_TYPE_CLASS.INT_64:
		nanosecondsSinceMidnight := universalPointer.AsLInt^ MOD TO_LINT(LongTimes.ONE_DAY);

		// Normalize a negative remainder to the elapsed time since midnight.
		IF nanosecondsSinceMidnight < 0 THEN
			nanosecondsSinceMidnight := nanosecondsSinceMidnight + TO_LINT(LongTimes.ONE_DAY);
		END_IF

		IF (allowTypeCastWithDataLoss OR_ELSE nanosecondsSinceMidnight = 0)
			AND_THEN universalPointer.AsLInt^ >= SignedInt64.MIN_VALUE + nanosecondsSinceMidnight THEN
			AsLDate := TO_LDATE(universalPointer.AsLInt^ - nanosecondsSinceMidnight);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.DATE_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLDateAndTime" Id="{36a42bba-09cd-44d2-9d6f-f83ecf955631}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to LDATE_AND_TIME.</summary>
<description>Requires live storage matching the descriptor. Reads LDT directly and widens DT or DATE to LDT; valid LDATE is also accepted with FALSE. Numeric INT_64 and UINT_64 inputs are nanoseconds since the epoch. INT_64 is read as signed and fits the documented LDT range. UINT_64 with FALSE must not exceed LongDateAndTimes.MAX_VALUE; TRUE permits native TO_LDT outside that range, with runtime-dependent results or exceptions. TIME and LTIME mean duration added to the epoch. TIME milliseconds are scaled to nanoseconds in ULINT and always fit LDT. LTIME already uses nanoseconds; FALSE checks LongDateAndTimes.MAX_VALUE before conversion, while TRUE allows native out-of-range conversion. Rejected or unsupported conversions raise GenericConversionNotSupportedException. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native out-of-range UINT_64 and LTIME conversion.</param>
METHOD FINAL AsLDateAndTime : LDATE_AND_TIME
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.DATE_AND_TIME_64: 
		 AsLDateAndTime := universalPointer.AsLDateAndTime^;
		 RETURN;		 

	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		 AsLDateAndTime := TO_LDT(universalPointer.AsDateAndTime^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.INT_64:
		AsLDateAndTime := TO_LDT(universalPointer.AsLInt^);
		RETURN;

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE universalPointer.AsULInt^ <= TO_ULINT(LongDateAndTimes.MAX_VALUE) THEN
			AsLDateAndTime := TO_LDT(universalPointer.AsULInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.DATE_32:
		 AsLDateAndTime := TO_LDT(universalPointer.AsDate^);
		 RETURN;

	GENERIC_TYPE_CLASS.TIME_32:
		 AsLDateAndTime := TO_LDT(TO_ULINT(universalPointer.AsTime^) * TO_ULINT(LongTimes.ONE_MILLISECOND));
		 RETURN;
	GENERIC_TYPE_CLASS.DATE_64:
		AsLDateAndTime := TO_LDT(universalPointer.AsLDate^);
		RETURN;

	GENERIC_TYPE_CLASS.TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE TO_ULINT(universalPointer.AsLTime^) <= TO_ULINT(LongDateAndTimes.MAX_VALUE) THEN
			AsLDateAndTime := TO_LDT(TO_ULINT(universalPointer.AsLTime^));
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.DATE_AND_TIME_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLInt" Id="{557ab87e-2262-4a71-b53a-324d552cca35}" FolderPath="AsTyped\Integer\Signed\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsLInt : LINT
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsLInt := TO_LINT(universalPointer.AsByte^);
		 RETURN;
		
	GENERIC_TYPE_CLASS.UINT_16:
		 AsLInt := TO_LINT(universalPointer.AsWord^);
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_32: 
		 AsLInt := TO_LINT(universalPointer.AsDWord^);
		 RETURN;

	GENERIC_TYPE_CLASS.INT_8: 
		 AsLInt := TO_LINT(universalPointer.AsSInt^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.INT_16: 
		 AsLInt := TO_LINT(universalPointer.AsInt^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.INT_32: 
		 AsLInt := TO_LINT(universalPointer.AsDInt^);
		 RETURN;
			 			 
	GENERIC_TYPE_CLASS.INT_64:
		 AsLInt := universalPointer.AsLInt^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(SignedInt64.MAX_VALUE)) THEN
			AsLInt := TO_LINT(universalPointer.AsLWord^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.INT_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLReal" Id="{6ff6d2d4-05a2-4a88-8dfa-3efa48fa159c}" FolderPath="AsTyped\Floating point\">
      <Declaration><![CDATA[(*!
<summary>Reads REAL_32 or REAL_64 storage as LREAL.</summary>
<description>REAL_32 is widened and REAL_64 read directly. Other tags raise GenericConversionNotSupportedException. The address must reference live, aligned storage of the tagged representation. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsLReal : LREAL
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.REAL_32:
		 AsLReal := TO_LREAL(universalPointer.AsReal^);
		 RETURN;
	 
	GENERIC_TYPE_CLASS.REAL_64:	
		 AsLReal := universalPointer.AsLReal^;
		 RETURN;
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.REAL_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLTime" Id="{312f2003-0852-4cfd-8313-e6043e172de5}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to a nanosecond duration.</summary>
<description>Requires live storage matching the descriptor. DT and LDT inputs mean elapsed time since the epoch. DT seconds are scaled to nanoseconds in ULINT and always fit LTIME. LDT is read as signed nanoseconds; FALSE rejects timestamps before the epoch, while TRUE passes the signed value to native TO_LTIME. INT_64 follows the same nonnegative rule. Valid TOD/LTOD inputs mean duration since midnight. TIME_32 is widened; TIME_64 and UINT_64 retain their values. TRUE does not guarantee safe out-of-range behavior. Unsupported or rejected conversions raise GenericConversionNotSupportedException. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion of negative INT_64 values and LDT timestamps before the epoch.</param>
METHOD FINAL AsLTime : LTIME
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.TIME_64:
		 AsLTime := universalPointer.AsLTime^;
		 RETURN;

	GENERIC_TYPE_CLASS.TIME_32: 
		 AsLTime := TO_LTIME(universalPointer.AsTime^);
		 RETURN;
		
	GENERIC_TYPE_CLASS.UINT_64:
		 AsLTime := TO_LTIME(universalPointer.AsULInt^);
		 RETURN;

	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		 AsLTime := TO_LTIME(TO_ULINT(universalPointer.AsDateAndTime^) * TO_ULINT(LongTimes.ONE_SECOND));
		 RETURN;
		 
	GENERIC_TYPE_CLASS.TIME_OF_DAY_32: 
		 AsLTime := TO_LTIME(universalPointer.AsTimeOfDay^);
		 RETURN;

	GENERIC_TYPE_CLASS.TIME_OF_DAY_64:
		AsLTime := TO_LTIME(universalPointer.AsLTimeOfDay^);
		RETURN;

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE universalPointer.AsLInt^ >= TO_LINT(LongTimes.MIN_VALUE) THEN
			AsLTime := TO_LTIME(universalPointer.AsLInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.DATE_AND_TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE universalPointer.AsLInt^ >= TO_LINT(LongDateAndTimes.EPOCH) THEN
			AsLTime := TO_LTIME(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.TIME_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLTimeOfDay" Id="{3746ef26-79d9-476c-ba8d-9d1fb97744ec}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to LTIME_OF_DAY.</summary>
<description>Reads a time of day in nanoseconds. With FALSE, supported integer and duration inputs must be nonnegative and less than 24 hours; integer units are nanoseconds. TIME_OF_DAY_64 is read directly and TIME_OF_DAY_32 is widened. TRUE permits out-of-range native conversions. For DT/LDT, FALSE accepts only timestamps on 1970-01-01; TRUE discards the calendar date and extracts the time of day. Negative LDT remainders are normalized to the interval from midnight inclusive to one day exclusive. Nanosecond precision is preserved. Requires live storage matching the descriptor. Checks precede the potentially lossy conversion. Rejected or unsupported conversions raise GenericConversionNotSupportedException. TRUE does not guarantee safe overflow behavior. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the value cannot be represented exactly; FALSE checks numeric and duration inputs and rejects DT/LDT dates other than 1970-01-01.</param>
METHOD FINAL AsLTimeOfDay : LTIME_OF_DAY
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;

	nanosecondsSinceMidnight : LINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.TIME_OF_DAY_64:
		AsLTimeOfDay := universalPointer.AsLTimeOfDay^;
		RETURN;

	GENERIC_TYPE_CLASS.TIME_OF_DAY_32:
		AsLTimeOfDay := TO_LTOD(universalPointer.AsTimeOfDay^);
		RETURN;

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsULInt^ < TO_ULINT(LongTimes.ONE_DAY)) THEN
			AsLTimeOfDay := TO_LTOD(universalPointer.AsULInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsLInt^ >= TO_LINT(LongTimes.MIN_VALUE) AND_THEN universalPointer.AsLInt^ < TO_LINT(LongTimes.ONE_DAY)) THEN
			AsLTimeOfDay := TO_LTOD(universalPointer.AsLInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.TIME_32:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsTime^ < Times.ONE_DAY) THEN
			AsLTimeOfDay := TO_LTOD(universalPointer.AsTime^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		IF allowTypeCastWithDataLoss OR_ELSE TO_UDINT(universalPointer.AsDateAndTime^) < Times.SECONDS_PER_DAY THEN
			AsLTimeOfDay := TO_LTOD(TO_ULINT(TO_UDINT(universalPointer.AsDateAndTime^) MOD Times.SECONDS_PER_DAY)
				* TO_ULINT(LongTimes.ONE_SECOND));
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsLTime^ < LongTimes.ONE_DAY) THEN
			AsLTimeOfDay := TO_LTOD(universalPointer.AsLTime^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.DATE_AND_TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE (
			universalPointer.AsLInt^ >= TO_LINT(LongDateAndTimes.EPOCH)
			AND_THEN universalPointer.AsLInt^ < TO_LINT(LongTimes.ONE_DAY)) THEN
			nanosecondsSinceMidnight := universalPointer.AsLInt^ MOD TO_LINT(LongTimes.ONE_DAY);

			IF nanosecondsSinceMidnight < 0 THEN
				nanosecondsSinceMidnight := nanosecondsSinceMidnight + TO_LINT(LongTimes.ONE_DAY);
			END_IF

			AsLTimeOfDay := TO_LTOD(nanosecondsSinceMidnight);
			RETURN;
		END_IF

END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.TIME_OF_DAY_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsLWord" Id="{329d366e-53cb-444a-baae-0e3cbf144975}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsLWord : LWORD
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsLWord := TO_LWORD(universalPointer.AsByte^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.UINT_16:
		 AsLWord := TO_LWORD(universalPointer.AsWord^);
		 RETURN;
 
	GENERIC_TYPE_CLASS.UINT_32: 
		 AsLWord := TO_LWORD(universalPointer.AsDWord^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.UINT_64:	
		 AsLWord := universalPointer.AsLWord^;
		 RETURN;

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedInt64.MIN_VALUE)) THEN
			AsLWord := TO_LWORD(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedInt64.MIN_VALUE)) THEN
			AsLWord := TO_LWORD(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedInt64.MIN_VALUE)) THEN
			AsLWord := TO_LWORD(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedInt64.MIN_VALUE)) THEN
			AsLWord := TO_LWORD(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_64);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsObject" Id="{996e8fad-fcc2-4f05-b582-9a439f872e26}" FolderPath="AsTyped\">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed reference to object storage.</summary>
<description>Requires OBJECT TypeClass; other tags raise GenericConversionNotSupportedException. A null address leaves the result unbound. A nonnull address must identify a live Object; the reference does not extend its lifetime. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsObject : REFERENCE TO Object
VAR
	objectPointer : POINTER TO Object;

	conversionException : GenericConversionNotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TypeClass = GENERIC_TYPE_CLASS.OBJECT THEN
	objectPointer := Address;
	
	IF objectPointer <> 0 THEN
		AsObject REF= objectPointer^;		
	END_IF
ELSE	
	conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.OBJECT);		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsReal" Id="{45160cf2-6e60-4035-806b-879e84f1bb89}" FolderPath="AsTyped\Floating point\">
      <Declaration><![CDATA[(*!
<summary>Reads a REAL value or converts an LREAL value according to its representability.</summary>
<description>Requires live storage matching TypeClass. REAL_32 is read directly. For REAL_64 with FALSE, rejects NaN and infinities by their exponent bits, checks the finite REAL range before narrowing, and accepts the result only if widening it back to LREAL reproduces the original value. With TRUE, uses native TO_REAL without these checks, including for special values. Native floating-point behavior follows the target runtime configuration. Unsupported or inexact conversions with FALSE raise GenericConversionNotSupportedException. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows inexact, out-of-range and special-value LREAL to REAL conversions; FALSE requires a finite exactly representable value.</param>
METHOD FINAL AsReal : REAL
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.REAL_32:
		AsReal := universalPointer.AsReal^;
		RETURN;

	GENERIC_TYPE_CLASS.REAL_64:
		IF allowTypeCastWithDataLoss THEN
			AsReal := TO_REAL(universalPointer.AsLReal^);
			RETURN;
		END_IF

		// All exponent bits are set for both infinity and NaN.
		IF (universalPointer.AsULInt^ AND LongReals.POSITIVE_INFINITY.Raw) <> LongReals.POSITIVE_INFINITY.Raw
			AND_THEN universalPointer.AsLReal^ >= TO_LREAL(Reals.MIN_VALUE)
			AND_THEN universalPointer.AsLReal^ <= TO_LREAL(Reals.MAX_VALUE) THEN
			AsReal := TO_REAL(universalPointer.AsLReal^);

			IF TO_LREAL(AsReal) = universalPointer.AsLReal^ THEN
				RETURN;
			END_IF
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.REAL_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Assign" Id="{862ebf60-dfb4-45d8-a755-cbc5dc31a2cb}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Installs descriptor fields without copying or releasing a payload.</summary>
<description>A null address raises ArgumentNotSpecifiedException before modification. The caller supplies a consistent type, size and ownership flag and must arrange release of any previous owned storage before overwriting it. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD INTERNAL FINAL Assign
VAR_INPUT
	genericTypeClass : GENERIC_TYPE_CLASS;
	address : POINTER TO BYTE;
	size : ULINT;
	isMemoryOwner : BOOL;
END_VAR
VAR
	addressNullException : ArgumentNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF address = 0 THEN
	addressNullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'address');
END_IF

THIS^.TypeClass := genericTypeClass;
THIS^.Address := address;
THIS^.Size := size;
THIS^.IsMemoryOwner := isMemoryOwner;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsSInt" Id="{17b44680-9119-41da-9958-f566e80539b5}" FolderPath="AsTyped\Integer\Signed\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsSInt : SINT
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.INT_8: 
		 AsSInt := universalPointer.AsSInt^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsWord^) <= TO_ULINT(SignedByte.MAX_VALUE)) THEN
			AsSInt := TO_SINT(universalPointer.AsWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(SignedByte.MAX_VALUE)) THEN
			AsSInt := TO_SINT(universalPointer.AsDWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(SignedByte.MAX_VALUE)) THEN
			AsSInt := TO_SINT(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(SignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsInt^) <= TO_LINT(SignedByte.MAX_VALUE)) THEN
			AsSInt := TO_SINT(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(SignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsDInt^) <= TO_LINT(SignedByte.MAX_VALUE)) THEN
			AsSInt := TO_SINT(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(SignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(SignedByte.MAX_VALUE)) THEN
			AsSInt := TO_SINT(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.INT_8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsString255" Id="{34520551-01e7-4ae7-9a34-54ba8a2cf3c1}" FolderPath="AsTyped\Strings\">
      <Declaration><![CDATA[(*!
<summary>Formats a supported generic value as text with capacity for 255 characters.</summary>
<description>Requires live storage matching the descriptor. Same-encoding string values are copied directly into the result, retaining at most 255 code units and a terminator without an intermediate 80-character string. WSTRING uses single-byte Latin-1 conversion, not UTF-8. With FALSE, each source code unit in the retained prefix (at most 255, stopping at the terminator) must fit UnsignedByte.MAX_VALUE; otherwise GenericConversionNotSupportedException is raised before conversion. The truncated tail is not validated. TRUE permits omission of unrepresentable characters. WSTRING_TO_STRING2 writes directly into the result and skips characters it cannot convert. Output beyond the 255-byte text capacity is not retained; the function completion flag is intentionally ignored because this API permits truncation. Numeric formatting retains its native conversion behavior. Unsupported conversions raise GenericConversionNotSupportedException; the source and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows omission of WSTRING characters that cannot be represented in Latin-1. Truncation to 255 bytes is allowed with either flag.</param>
METHOD FINAL AsString255 : STRING(255)
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;

	characterIndex : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN:
		 AsString255 := TO_STRING(universalPointer.AsBool^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_8:
		 AsString255 := TO_STRING(universalPointer.AsSInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_16:
		 AsString255 := TO_STRING(universalPointer.AsInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_32:
		 AsString255 := TO_STRING(universalPointer.AsDInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_64:
		 AsString255 := TO_STRING(universalPointer.AsLInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_8:
		 AsString255 := TO_STRING(universalPointer.AsUSInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_16:
		 AsString255 := TO_STRING(universalPointer.AsUInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_32:
		 AsString255 := TO_STRING(universalPointer.AsUDInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_64:
		 AsString255 := TO_STRING(universalPointer.AsULInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.REAL_32:
		 AsString255 := TO_STRING(universalPointer.AsReal^);
		 RETURN;
    GENERIC_TYPE_CLASS.REAL_64:
		 AsString255 := TO_STRING(universalPointer.AsLReal^);
		 RETURN;
    GENERIC_TYPE_CLASS.STRING_ASCII:
		 Tc2_Utilities.STRNCPY(ADR(AsString255), universalPointer.AsString, SIZEOF(AsString255));
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_32:
		 AsString255 := TO_STRING(universalPointer.AsTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_64:
		 AsString255 := TO_STRING(universalPointer.AsLTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_32:
		 AsString255 := TO_STRING(universalPointer.AsDate^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_64:
		 AsString255 := TO_STRING(universalPointer.AsLDate ^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		 AsString255 := TO_STRING(universalPointer.AsDateAndTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_AND_TIME_64:
		 AsString255 := TO_STRING(universalPointer.AsLDateAndTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_OF_DAY_32:
		 AsString255 := TO_STRING(universalPointer.AsTimeOfDay^);
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_OF_DAY_64:
		 AsString255 := TO_STRING(universalPointer.AsLTimeOfDay^);
		 RETURN;

	GENERIC_TYPE_CLASS.STRING_UTF16:
		IF NOT allowTypeCastWithDataLoss THEN
			FOR characterIndex := 0 TO SIZEOF(AsString255) - 2 DO
				IF universalPointer.AsWord[characterIndex] = 0 THEN
					EXIT;
				END_IF

				IF universalPointer.AsWord[characterIndex] > TO_WORD(UnsignedByte.MAX_VALUE) THEN
					conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.STRING_ASCII);
				END_IF
			END_FOR
		END_IF

		Tc2_Utilities.WSTRING_TO_STRING2(ADR(AsString255), universalPointer.AsWString, SIZEOF(AsString255));
		RETURN;
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.STRING_ASCII);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsStringReference" Id="{5ecee28b-da1c-4264-92ee-6c69f4328ec9}" FolderPath="AsTyped\Strings\">
      <Declaration><![CDATA[(*!
<summary>Borrows the STRING storage described by this value.</summary>
<description>Requires STRING_ASCII or raises GenericConversionNotSupportedException. Does not copy, bound-check or validate the payload. The reference remains valid only while the source storage remains alive; the descriptor size still limits any access. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsStringReference : REFERENCE TO STRING
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
    GENERIC_TYPE_CLASS.STRING_ASCII:
		 AsStringReference REF= universalPointer.AsString^;
		 RETURN;
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.STRING_ASCII);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsTime" Id="{b0c8a8a8-d7c2-483f-b215-128f7d04ba16}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported value to a millisecond duration.</summary>
<description>DT input means elapsed time since the epoch: seconds are scaled to milliseconds in ULINT before conversion. FALSE requires that duration to fit Times.MAX_VALUE; TRUE permits native out-of-range narrowing. Reads a millisecond duration. With FALSE, signed integer inputs must be nonnegative and 64-bit integer inputs must fit UINT_32; integer units are milliseconds. LTIME additionally must fit TIME and contain an integral number of milliseconds. TRUE permits the native conversion even when these conditions fail. Requires live storage matching the descriptor. Checks precede the potentially lossy conversion. Rejected or unsupported conversions raise GenericConversionNotSupportedException. TRUE does not guarantee safe overflow behavior. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the value cannot be represented exactly; FALSE checks supported numeric and duration inputs.</param>
METHOD FINAL AsTime : TIME
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		IF allowTypeCastWithDataLoss OR_ELSE TO_ULINT(universalPointer.AsDateAndTime^) <= TO_ULINT(Times.MAX_VALUE) / TO_ULINT(Times.ONE_SECOND) THEN
			AsTime := TO_TIME(TO_ULINT(universalPointer.AsDateAndTime^) * TO_ULINT(Times.ONE_SECOND));
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_32:
		AsTime := TO_TIME(universalPointer.AsUDInt^);
		RETURN;

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsDInt^ >= TO_LINT(Times.MIN_VALUE)) THEN
			AsTime := TO_TIME(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.TIME_32:
		AsTime := universalPointer.AsTime^;
		RETURN;

	GENERIC_TYPE_CLASS.TIME_OF_DAY_32:
		AsTime := TO_TIME(universalPointer.AsTimeOfDay^);
		RETURN;

	GENERIC_TYPE_CLASS.TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsLTime^ <= TO_LTIME(Times.MAX_VALUE) AND_THEN TO_ULINT(universalPointer.AsLTime^) MOD TO_ULINT(LongTimes.ONE_MILLISECOND) = 0) THEN
			AsTime := TO_TIME(universalPointer.AsLTime^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsLInt^ >= TO_LINT(Times.MIN_VALUE) AND_THEN universalPointer.AsLInt^ <= TO_LINT(Times.MAX_VALUE)) THEN
			AsTime := TO_TIME(universalPointer.AsLInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsULInt^ <= TO_ULINT(Times.MAX_VALUE)) THEN
			AsTime := TO_TIME(universalPointer.AsULInt^);
			RETURN;
		END_IF

END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.TIME_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsTimeOfDay" Id="{83f725a7-471b-4136-801c-36fbe6098098}" FolderPath="AsTyped\Date and time\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts a supported generic value to TIME_OF_DAY.</summary>
<description>Reads a time of day in milliseconds. With FALSE, supported integer and duration inputs must be nonnegative and less than 24 hours; integer units are milliseconds. LTIME additionally must contain an integral number of milliseconds. TRUE permits the native conversion even when these conditions fail. TIME_OF_DAY_32 is read directly. Requires live storage matching the descriptor. Checks precede the potentially lossy conversion. Rejected or unsupported conversions raise GenericConversionNotSupportedException. TRUE does not guarantee safe overflow behavior. Stored data and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the value cannot be represented exactly; FALSE checks supported numeric and duration inputs.</param>
METHOD FINAL AsTimeOfDay : TIME_OF_DAY
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.TIME_OF_DAY_32:
		AsTimeOfDay := universalPointer.AsTimeOfDay^;
		RETURN;

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsDInt^ >= TO_LINT(Times.MIN_VALUE) AND_THEN universalPointer.AsDInt^ < TO_DINT(Times.ONE_DAY)) THEN
			AsTimeOfDay := TO_TOD(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsUDInt^ < TO_UDINT(Times.ONE_DAY)) THEN
			AsTimeOfDay := TO_TOD(universalPointer.AsUDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.TIME_32:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsTime^ < Times.ONE_DAY) THEN
			AsTimeOfDay := TO_TOD(universalPointer.AsTime^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsLInt^ >= TO_LINT(Times.MIN_VALUE) AND_THEN universalPointer.AsLInt^ < TO_LINT(Times.ONE_DAY)) THEN
			AsTimeOfDay := TO_TOD(universalPointer.AsLInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsULInt^ < TO_ULINT(Times.ONE_DAY)) THEN
			AsTimeOfDay := TO_TOD(universalPointer.AsULInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.TIME_64:
		IF allowTypeCastWithDataLoss OR_ELSE (universalPointer.AsLTime^ < LongTimes.ONE_DAY AND_THEN TO_ULINT(universalPointer.AsLTime^) MOD TO_ULINT(LongTimes.ONE_MILLISECOND) = 0) THEN
			AsTimeOfDay := TO_TOD(universalPointer.AsLTime^);
			RETURN;
		END_IF

END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.TIME_OF_DAY_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsUDInt" Id="{90863b55-b5cf-4472-b2f4-3d7e5196f54f}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsUDInt : UDINT
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsUDInt := TO_UDINT(universalPointer.AsByte^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.UINT_16:
		 AsUDInt := TO_UDINT(universalPointer.AsWord^);
		 RETURN;
 
	GENERIC_TYPE_CLASS.UINT_32: 
		 AsUDInt := universalPointer.AsDWord^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(UnsignedInt32.MAX_VALUE)) THEN
			AsUDInt := TO_UDINT(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE)) THEN
			AsUDInt := TO_UDINT(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE)) THEN
			AsUDInt := TO_UDINT(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE)) THEN
			AsUDInt := TO_UDINT(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedInt32.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(UnsignedInt32.MAX_VALUE)) THEN
			AsUDInt := TO_UDINT(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_32);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsUInt" Id="{0cb7d9b1-a26c-4d44-8107-5807eda8eaa5}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsUInt : UINT
VAR_INPUT
