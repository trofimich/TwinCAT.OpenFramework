    <Method Name="AsUSInt" Id="{7f2825bd-7342-487e-96ac-27ff3bcc2e3c}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsUSInt : USINT
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsUSInt := universalPointer.AsUSInt^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsWord^) <= TO_ULINT(UnsignedByte.MAX_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(UnsignedByte.MAX_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsDWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(UnsignedByte.MAX_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedByte.MIN_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsInt^) <= TO_LINT(UnsignedByte.MAX_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsDInt^) <= TO_LINT(UnsignedByte.MAX_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedByte.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(UnsignedByte.MAX_VALUE)) THEN
			AsUSInt := TO_USINT(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsWord" Id="{5e995462-8574-4174-bafd-d9d8e8e626c5}" FolderPath="AsTyped\Integer\Unsugned\">
      <Declaration><![CDATA[(*!
<summary>Reads or converts an integer representation when the value fits the result.</summary>
<description>Requires live storage matching the descriptor. For supported integer types, FALSE accepts the actual value only when it fits the result range; bounds are checked before narrowing or changing signedness. TRUE permits the native conversion even outside that range. Unsupported types or rejected values raise GenericConversionNotSupportedException. Existing BOOLEAN byte-view behavior is retained. Stored data and ownership are unchanged; no dynamic allocation is needed for successful conversion. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="allowTypeCastWithDataLoss">Allows native conversion when the actual value is outside the result range; overflow behavior follows TwinCAT.</param>
METHOD FINAL AsWord : WORD
VAR_INPUT
	allowTypeCastWithDataLoss : BOOL := FALSE;
END_VAR
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN, GENERIC_TYPE_CLASS.UINT_8:
		 AsWord := TO_WORD(universalPointer.AsByte^);
		 RETURN;
		 
	GENERIC_TYPE_CLASS.UINT_16:
		 AsWord := universalPointer.AsWord^;
		 RETURN;

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(UnsignedInt16.MAX_VALUE)) THEN
			AsWord := TO_WORD(universalPointer.AsDWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.UINT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsLWord^) <= TO_ULINT(UnsignedInt16.MAX_VALUE)) THEN
			AsWord := TO_WORD(universalPointer.AsLWord^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_8:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsSInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE)) THEN
			AsWord := TO_WORD(universalPointer.AsSInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_16:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE)) THEN
			AsWord := TO_WORD(universalPointer.AsInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsDInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsDInt^) <= TO_LINT(UnsignedInt16.MAX_VALUE)) THEN
			AsWord := TO_WORD(universalPointer.AsDInt^);
			RETURN;
		END_IF

	GENERIC_TYPE_CLASS.INT_64:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_LINT(universalPointer.AsLInt^) >= TO_LINT(UnsignedInt16.MIN_VALUE) AND_THEN TO_LINT(universalPointer.AsLInt^) <= TO_LINT(UnsignedInt16.MAX_VALUE)) THEN
			AsWord := TO_WORD(universalPointer.AsLInt^);
			RETURN;
		END_IF
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.UINT_16);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsWString255" Id="{02ab723a-3f42-4d36-a0f6-c0e9871bfd09}" FolderPath="AsTyped\Strings\">
      <Declaration><![CDATA[(*!
<summary>Formats a supported generic value as text with capacity for 255 characters.</summary>
<description>Requires live storage matching the descriptor. Same-encoding string values are copied directly into the result, retaining at most 255 code units and a terminator without an intermediate 80-character string. STRING input is converted directly into the result with STRING_TO_WSTRING2, using the library single-byte string conversion rather than UTF-8 decoding. Output is truncated to 255 wide code units when needed; the function completion flag is intentionally ignored because this API permits truncation. Numeric formatting retains its native conversion behavior. Unsupported conversions raise GenericConversionNotSupportedException; the source and ownership are unchanged. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsWString255 : WSTRING(255)
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN:
		 AsWString255 := TO_WSTRING(universalPointer.AsBool^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_8:
		 AsWString255 := TO_WSTRING(universalPointer.AsSInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_16:
		 AsWString255 := TO_WSTRING(universalPointer.AsInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsDInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.INT_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsLInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_8:
		 AsWString255 := TO_WSTRING(universalPointer.AsUSInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_16:
		 AsWString255 := TO_WSTRING(universalPointer.AsUInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsUDInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.UINT_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsULInt^);
		 RETURN;
    GENERIC_TYPE_CLASS.REAL_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsReal^);
		 RETURN;
    GENERIC_TYPE_CLASS.REAL_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsLReal^);
		 RETURN;
    GENERIC_TYPE_CLASS.STRING_ASCII:
		 Tc2_Utilities.STRING_TO_WSTRING2(ADR(AsWString255), universalPointer.AsString, SIZEOF(AsWString255));
		 RETURN;
	GENERIC_TYPE_CLASS.STRING_UTF16:
		 Tc2_Utilities.WSTRNCPY(ADR(AsWString255), universalPointer.AsWString, SIZEOF(AsWString255));
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsLTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsDate^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsLDate^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsDateAndTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.DATE_AND_TIME_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsLDateAndTime^);
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_OF_DAY_32:
		 AsWString255 := TO_WSTRING(universalPointer.AsTimeOfDay^);
		 RETURN;
    GENERIC_TYPE_CLASS.TIME_OF_DAY_64:
		 AsWString255 := TO_WSTRING(universalPointer.AsLTimeOfDay^);
		 RETURN;
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.STRING_UTF16);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AsWStringReference" Id="{31493745-1b4b-4427-a5e6-18639dd644fb}" FolderPath="AsTyped\Strings\">
      <Declaration><![CDATA[(*!
<summary>Borrows the WSTRING storage described by this value.</summary>
<description>Requires STRING_UTF16 or raises GenericConversionNotSupportedException. Does not copy, bound-check or validate the payload. The reference remains valid only while the source storage remains alive; the descriptor size still limits any access. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL AsWStringReference : REFERENCE TO WSTRING
VAR
	conversionException : GenericConversionNotSupportedException;
	universalPointer : UNIVERSAL_POINTER;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[universalPointer.AsByte := Address;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.STRING_UTF16:
		 AsWStringReference REF= universalPointer.AsWString^;
		 RETURN;
END_CASE

conversionException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), TypeClass, GENERIC_TYPE_CLASS.STRING_UTF16);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ChangeValueByAny" Id="{f7c7dd69-068a-47f7-bb61-709a535f4d37}" FolderPath="ChangeValue\">
      <Declaration><![CDATA[(*!
<summary>Changes the stored value using an ANY descriptor.</summary>
<description>Delegates to ChangeValueByAnyType with the supplied isObject flag. Its compatibility checks, ownership behavior, mutation rules and exceptions apply unchanged; input storage is borrowed during the call. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL ChangeValueByAny
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ChangeValueByAnyType(value, isObject);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ChangeValueByAnyType" Id="{1e16a561-f4aa-4df6-80a7-92686d04f493}" FolderPath="ChangeValue\">
      <Declaration><![CDATA[(*!
<summary>Copies bytes from an AnyType value into the existing generic storage.</summary>
<description>Maps the source type using isObject, then rejects a mismatched generic type or insufficient destination capacity through StandardException. Copies value.diSize bytes with MEMCPY; a zero return raises StandardException. Source type mapping exceptions propagate. Does not allocate, clone objects, change descriptor fields or transfer ownership; bytes beyond the copied region remain unchanged. The caller supplies valid descriptors and live storage; this method does not validate memory lifetime or guarantee overlapping-copy behavior. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL ChangeValueByAnyType
VAR_INPUT
	value : __SYSTEM.AnyType;
	isObject : BOOL := FALSE;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	argumentDataType : GENERIC_TYPE_CLASS;
	
	exception : StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[argumentDataType := GenericTypeClassConvertor.GetGenericTypeClassBySystemAnyType(value, isObject);

IF argumentDataType <> TypeClass THEN
	formattedExceptionMessage := WideStrings.Concat255("Incompatible argument type '", TO_WSTRING(argumentDataType), "' and generic  type '", TO_WSTRING(TypeClass), "'");

	exception.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage); 
END_IF

IF Size < TO_ULINT(value.diSize) THEN
	formattedExceptionMessage := WideStrings.Concat255("Insufficient memory size: avaliable - ", TO_WSTRING(Size), ", required - ", TO_WSTRING(value.diSize));

	exception.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage); 	
END_IF

IF Tc2_System.MEMCPY(Address, value.pValue, TO_UDINT(value.diSize)) = 0 THEN
	exception.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Tc2_System.MEMCPY returned error (value 0)"); 		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a1f78ed3-d25a-4e81-8b88-934a58828338}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9652d94e-8909-435e-98b2-6d0f00f73d32}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= GenericValueFactory.GenericValueClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CopyTo" Id="{a9e28a3d-762a-4fcd-99e6-4d377c8be6f0}">
      <Declaration><![CDATA[(*!
<summary>Copies the stored byte representation into an equally sized target.</summary>
<description>
Requires a live writable target whose size equals Size. The caller is responsible
for data compatibility: no type check or numeric conversion is performed.
Copies bytes from a nonzero Address referencing live source storage. Does not clone referenced objects, transfer ownership, retain
the target or modify this descriptor. Copied pointer values still refer to the
same resources and do not grant an independent right to release them.
A zero source Address raises DataMemberNotSpecifiedException without changing the target.
A null target raises ArgumentNotSpecifiedException; a size mismatch raises
StandardException before copying. Overlapping source and target regions,
including identical addresses, are supported through MEMMOVE.
 Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="target">Writable destination with the same byte size; its type interpretation is the caller's responsibility.</param>
METHOD FINAL CopyTo
VAR_INPUT
	target : ANY;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	argumentNullException : ArgumentNotSpecifiedException;
	sourceNotSpecifiedException : DataMemberNotSpecifiedException;
	invalidTargetMemorySizeException : StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Address = 0 THEN
	sourceNotSpecifiedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'Address');
END_IF

IF target.pValue = 0 THEN
	argumentNullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'target'); 
END_IF

IF TO_ULINT(target.diSize) <> Size THEN
	formattedExceptionMessage := WideStrings.Concat255("Target variable size ", TO_WSTRING(target.diSize), " is not equals to generic variable size ", TO_WSTRING(Size));

	invalidTargetMemorySizeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

internalCopyTo(target.pValue);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Equals" Id="{165ded56-3861-403f-9838-406d75321178}">
      <Declaration><![CDATA[(*!
<summary>Compares generic values using an optional comparer or the built-in equality rules.</summary>
<description>
When comparer is supplied, AreEqual receives copies of both GENERIC_VALUE descriptors before any built-in empty or type checks. OBJECT and USER_DEFINED remain distinct and Size is passed without conversion to AnyType. The caller selects a compatible equality strategy, including its treatment of empty operands, and keeps it and the data alive for the call. Comparer exceptions propagate without fallback. The comparer and operands are borrowed only for the call; no payload is copied, cloned or released, and no ownership is transferred. IsMemoryOwner does not affect the strategy's equality result. A supplied strategy must provide GetValueHashCode consistent with AreEqual; this method does not compute a hash.
Without a comparer, the following built-in rules apply.
INT_8 through INT_64 and UINT_8 through UINT_64 compare by value across widths and signedness without floating-point conversion. A negative signed value never equals an unsigned value. Pairs of REAL_32/REAL_64 values compare by canonical binary64 representation after widening non-NaN REAL values, without a tolerance: positive and negative zero are equal, and all NaN encodings compare equal to each other, including across widths, but not to non-NaN values. NaN is classified from integer bit views before widening; other REAL widening follows the runtime floating-point configuration. A nonempty integer value and a nonempty floating-point value always compare unequal, in either operand order. Both empty descriptors compare equal; one empty descriptor compares unequal to a nonempty one. For nonempty descriptors, different TypeClass values compare unequal except for the integer and floating-point pairs described above. BOOLEAN values compare logically. Nonempty OBJECT descriptors delegate to the first live Object instance's Equals with the second instance as its argument. The object type must provide a symmetric, transitive equality relation and a matching GetHashCode; base Object uses identity equality. Callbacks and their exceptions propagate without fallback. An address does not validate object lifetime. Other matching categories retain byte comparison: strings use their actual string sizes, otherwise descriptor sizes are used. Dates and times compare by representation only within the same TypeClass. Byte comparison covers the full ULINT length in bounded MEMCMP chunks. USER_DEFINED compares all Size bytes, including padding and stored pointer values; equal fields do not necessarily imply equal bytes, and the concrete user-defined type identity is not checked. Supply a compatible comparer for field-based equality. Both descriptors must reference live storage consistent with their type and size; no ownership is transferred.
 Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="otherValue">Descriptor of the value to compare.</param>
//!<param name="comparer">Optional borrowed equality and hashing strategy; zero selects built-in equality.</param>
METHOD FINAL Equals : BOOL
VAR_INPUT
	otherValue : GENERIC_VALUE;
	comparer : IEqualityComparer := 0;
END_VAR
VAR
	signedValue : LINT;

	firstObject : POINTER TO Object;
	secondObject : POINTER TO Object;

	stringPointer : POINTER TO STRING;
	wideStringPointer : POINTER TO WSTRING;
	referenceDataSize : ULINT;
	valueToCompareDataSize : ULINT;
	comparedSize : ULINT;
	chunkSize : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF comparer <> 0 THEN
	Equals := comparer.AreEqual(THIS^, otherValue);
	
	RETURN;
END_IF

IF IsNull OR_ELSE otherValue.IsNull THEN
	Equals := IsNull AND_THEN otherValue.IsNull;
ELSE
	CASE TypeClass OF
		GENERIC_TYPE_CLASS.INT_8, GENERIC_TYPE_CLASS.INT_16, GENERIC_TYPE_CLASS.INT_32, GENERIC_TYPE_CLASS.INT_64:
			CASE otherValue.TypeClass OF
				GENERIC_TYPE_CLASS.INT_8, GENERIC_TYPE_CLASS.INT_16, GENERIC_TYPE_CLASS.INT_32, GENERIC_TYPE_CLASS.INT_64:
					Equals := AsLInt() = otherValue.AsLInt();
					RETURN;

				GENERIC_TYPE_CLASS.UINT_8, GENERIC_TYPE_CLASS.UINT_16, GENERIC_TYPE_CLASS.UINT_32, GENERIC_TYPE_CLASS.UINT_64:
					signedValue := AsLInt();
					Equals := signedValue >= SignedInt64.ZERO AND_THEN TO_ULINT(signedValue) = otherValue.AsULInt();
					RETURN;
			END_CASE

		GENERIC_TYPE_CLASS.UINT_8, GENERIC_TYPE_CLASS.UINT_16, GENERIC_TYPE_CLASS.UINT_32, GENERIC_TYPE_CLASS.UINT_64:
			CASE otherValue.TypeClass OF
				GENERIC_TYPE_CLASS.INT_8, GENERIC_TYPE_CLASS.INT_16, GENERIC_TYPE_CLASS.INT_32, GENERIC_TYPE_CLASS.INT_64:
					signedValue := otherValue.AsLInt();
					Equals := signedValue >= SignedInt64.ZERO AND_THEN AsULInt() = TO_ULINT(signedValue);
					RETURN;

				GENERIC_TYPE_CLASS.UINT_8, GENERIC_TYPE_CLASS.UINT_16, GENERIC_TYPE_CLASS.UINT_32, GENERIC_TYPE_CLASS.UINT_64:
					Equals := AsULInt() = otherValue.AsULInt();
					RETURN;
			END_CASE

		GENERIC_TYPE_CLASS.REAL_32, GENERIC_TYPE_CLASS.REAL_64:
			CASE otherValue.TypeClass OF
				GENERIC_TYPE_CLASS.REAL_32, GENERIC_TYPE_CLASS.REAL_64:
					Equals := getCanonicalRealBits() = otherValue.getCanonicalRealBits();
					RETURN;
			END_CASE
	END_CASE

	IF TypeClass <> otherValue.TypeClass THEN
		Equals := FALSE;
		RETURN;
	END_IF

	IF TypeClass = GENERIC_TYPE_CLASS.OBJECT THEN
		firstObject := Address;
		secondObject := otherValue.Address;
		Equals := firstObject^.Equals(secondObject^);
		RETURN;
	END_IF

	IF TypeClass = GENERIC_TYPE_CLASS.BOOLEAN THEN
		Equals := AsBool() = otherValue.AsBool();
		RETURN;
	END_IF

	IF TypeClass = GENERIC_TYPE_CLASS.STRING_ASCII AND_THEN otherValue.TypeClass = GENERIC_TYPE_CLASS.STRING_ASCII THEN
		stringPointer := Address;
		referenceDataSize := Strings.GetActualSize(stringPointer^);
		
		stringPointer := otherValue.Address;		
		valueToCompareDataSize := Strings.GetActualSize(stringPointer^);
	ELSIF TypeClass = GENERIC_TYPE_CLASS.STRING_UTF16 AND_THEN otherValue.TypeClass = GENERIC_TYPE_CLASS.STRING_UTF16 THEN
		wideStringPointer := Address;
		referenceDataSize := WideStrings.GetActualSize(wideStringPointer^);
		
		wideStringPointer := otherValue.Address;		
		valueToCompareDataSize := WideStrings.GetActualSize(wideStringPointer^);
	ELSE
		referenceDataSize := Size;
		valueToCompareDataSize := otherValue.Size;		
	END_IF
 
	IF referenceDataSize <> valueToCompareDataSize THEN
		Equals := FALSE;
		RETURN;
	END_IF

	comparedSize := 0;
	WHILE comparedSize < referenceDataSize DO
		chunkSize := TO_UDINT(MIN(referenceDataSize - comparedSize, TO_ULINT(UnsignedInt32.MAX_VALUE)));
		IF Tc2_System.MEMCMP(Address + TO_LWORD(comparedSize), otherValue.Address + TO_LWORD(comparedSize), chunkSize) <> SignedInt32.ZERO THEN
			Equals := FALSE;
			RETURN;
		END_IF

		comparedSize := comparedSize + TO_ULINT(chunkSize);
	END_WHILE

	Equals := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="getCanonicalRealBits" Id="{c0c43419-5c5f-48f3-bb40-f8d8b2204104}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Returns a shared binary64 representation for generic floating-point equality and hashing.</summary>
<description>Requires nonempty REAL_32 or REAL_64 storage of the matching representation. Classifies NaN from integer bit views before any floating conversion, maps all NaN encodings to one value, widens other REAL values to LREAL, and maps both signed zeros to positive zero. Payload and ownership are unchanged. Widening follows the runtime floating-point configuration.</description>
*)
METHOD PRIVATE getCanonicalRealBits : ULINT
VAR
	valuePointer : UNIVERSAL_POINTER;
	realValue : REAL_UNION;
	longRealValue : LREAL_UNION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valuePointer.AsByte := Address;

IF TypeClass = GENERIC_TYPE_CLASS.REAL_32 THEN
	realValue.Raw := valuePointer.AsUDInt^;
	IF (realValue.Raw AND Reals.EXPONENT_MASK) = Reals.EXPONENT_MASK
		AND_THEN (realValue.Raw AND Reals.FRACTION_MASK) <> UnsignedInt32.MIN_VALUE
	THEN
		getCanonicalRealBits := LongReals.CANONICAL_NAN_BITS;
		RETURN;
	END_IF

	longRealValue.Value := TO_LREAL(realValue.Value);
ELSE
	longRealValue.Raw := valuePointer.AsULInt^;
END_IF

IF (longRealValue.Raw AND LongReals.EXPONENT_MASK) = LongReals.EXPONENT_MASK
	AND_THEN (longRealValue.Raw AND LongReals.FRACTION_MASK) <> UnsignedInt64.MIN_VALUE
THEN
	getCanonicalRealBits := LongReals.CANONICAL_NAN_BITS;
ELSIF (longRealValue.Raw AND LongReals.MAGNITUDE_MASK) = LongReals.ZERO_BITS THEN
	getCanonicalRealBits := LongReals.ZERO_BITS;
ELSE
	getCanonicalRealBits := longRealValue.Raw;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHashCode" Id="{091c42af-fc6a-4c30-a170-e310c535bc0a}">
      <Declaration><![CDATA[(*!
<summary>Computes a hash consistent with generic value equality or a supplied equality strategy.</summary>
<description>
A supplied comparer takes precedence even for empty descriptors; its GetValueHashCode exceptions propagate without fallback. Use the same strategy for Equals and hashing.
Without a comparer, empty descriptors hash to zero. Integers are widened to 64-bit integer representations so equal values across widths and signedness hash alike; negative signed integers are never equal to unsigned values. BOOLEAN is normalized to zero or one. REAL values are widened to LREAL, both signed zeros are normalized, and all NaN encodings share one hash. Nonempty OBJECT delegates to the live object's GetHashCode and requires its Equals/hash pair to agree.
Strings hash their actual terminated byte sequence, independent of storage capacity. Other categories hash all Size bytes, matching the representation equality rules; USER_DEFINED includes padding and pointer fields and carries no concrete type identity.
The caller supplies live storage matching TypeClass and Size and keeps equality-relevant data stable while a hash index uses it. IsMemoryOwner does not participate. Descriptors and payload are borrowed without mutation, cloning, release or retained references. No instance fields, cached hashes or dynamic allocations are introduced by the built-in hashing algorithm; user callbacks may have their own costs and failures.
The built-in byte hash uses FNV-1a with an explicitly masked 64-bit intermediate, without relying on arithmetic overflow. Collisions are allowed and must be resolved with Equals. Hashes are not persistent identifiers or portable serialization values. Runtime is proportional to the hashed byte count; object and comparer callbacks define their own cost.
 Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="comparer">Optional borrowed equality and hashing strategy; zero selects the built-in rules.</param>
METHOD FINAL GetHashCode : UDINT
VAR_INPUT
	comparer : IEqualityComparer := 0;
END_VAR
VAR CONSTANT
	HASH_OFFSET_BASIS : UDINT := UDINT#2166136261;
	HASH_PRIME : ULINT := ULINT#16777619;
END_VAR
VAR
	signedValue : LINT;
	unsignedValue : ULINT;
	objectPointer : POINTER TO Object;
	stringPointer : POINTER TO STRING;
	wideStringPointer : POINTER TO WSTRING;

	dataPointer : POINTER TO BYTE;
	bytePointer : POINTER TO BYTE;
	dataSize : ULINT;
	index : ULINT;
	hashValue : UDINT;
	hashProduct : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF comparer <> 0 THEN
	GetHashCode := comparer.GetValueHashCode(THIS^);
	RETURN;
END_IF

IF IsNull THEN
	GetHashCode := 0;
	RETURN;
END_IF

dataPointer := Address;
dataSize := Size;

CASE TypeClass OF
	GENERIC_TYPE_CLASS.BOOLEAN:
		IF AsBool() THEN
			unsignedValue := 1;
		ELSE
			unsignedValue := 0;
		END_IF

		dataPointer := ADR(unsignedValue);
		dataSize := XSIZEOF(unsignedValue);

	GENERIC_TYPE_CLASS.INT_8, GENERIC_TYPE_CLASS.INT_16, GENERIC_TYPE_CLASS.INT_32, GENERIC_TYPE_CLASS.INT_64:
		signedValue := AsLInt();
		dataPointer := ADR(signedValue);
		dataSize := XSIZEOF(signedValue);

	GENERIC_TYPE_CLASS.UINT_8, GENERIC_TYPE_CLASS.UINT_16, GENERIC_TYPE_CLASS.UINT_32, GENERIC_TYPE_CLASS.UINT_64:
		unsignedValue := AsULInt();
		dataPointer := ADR(unsignedValue);
		dataSize := XSIZEOF(unsignedValue);

	GENERIC_TYPE_CLASS.REAL_32, GENERIC_TYPE_CLASS.REAL_64:
		unsignedValue := getCanonicalRealBits();
		dataPointer := ADR(unsignedValue);
		dataSize := XSIZEOF(unsignedValue);

	GENERIC_TYPE_CLASS.STRING_ASCII:
		stringPointer := Address;
		dataSize := Strings.GetActualSize(stringPointer^);

	GENERIC_TYPE_CLASS.STRING_UTF16:
		wideStringPointer := Address;
		dataSize := WideStrings.GetActualSize(wideStringPointer^);

	GENERIC_TYPE_CLASS.OBJECT:
		objectPointer := Address;
		GetHashCode := objectPointer^.GetHashCode();
		RETURN;
END_CASE

hashValue := HASH_OFFSET_BASIS;
index := 0;
WHILE index < dataSize DO
	bytePointer := dataPointer + TO_LWORD(index);
	hashProduct := TO_ULINT(hashValue XOR TO_UDINT(bytePointer^)) * HASH_PRIME;
	hashValue := TO_UDINT(hashProduct AND TO_ULINT(UnsignedInt32.MAX_VALUE));
	index := index + 1;
END_WHILE

GetHashCode := hashValue;]]></ST>
      </Implementation>
    </Method>
    <Method Name="internalCopyTo" Id="{dffcbd59-ee39-4c74-bc12-2c951ca57eee}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Copies the payload bytes to a destination already checked by the caller.</summary>
<description>The destination must be writable for Size bytes. Address must be nonzero and reference readable storage of that size; overlapping regions are supported. The caller checks for a zero source address before calling. No cloning or ownership transfer is performed.</description>
*)
METHOD PRIVATE internalCopyTo
VAR_INPUT
	targetAddress : PVOID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Tc2_System.MEMMOVE(targetAddress, Address, TO_UDINT(Size));]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsNull" Id="{b0a5dbd8-6fb5-436e-9b63-9e18aded8437}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the descriptor has no usable value metadata.</summary>
<description>TRUE when TypeClass is UNSPECIFIED, Address is zero or Size is zero. This is the empty-value criterion used by built-in Equals and GetHashCode; a supplied comparer defines its own policy. It does not validate payload lifetime or address validity. An empty descriptor may still own allocated storage; IsNull does not remove the obligation to Release it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL IsNull : BOOL]]></Declaration>
      <Get Name="Get" Id="{293dd0e0-6dfe-4234-9575-a1a778286228}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsNull := TypeClass = GENERIC_TYPE_CLASS.UNSPECIFIED OR_ELSE Address = 0 OR_ELSE Size = 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{6b1b9ffb-991c-4d04-a51f-7608d3745ab0}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{70ea020b-d8b3-4815-b692-efc03598f31f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Release" Id="{9937fc92-8120-434b-ac91-5b20bd6f7de6}" FolderPath="CleanupMethods\">
      <Declaration><![CDATA[(*!
<summary>Attempts release of owned storage and resets the descriptor.</summary>
<description>Borrowed storage is not freed. Owned objects use the object-release path; other owned storage uses raw-memory release. The descriptor is reset even if TryReleaseDynamicMemory fails; successful deallocation is not guaranteed and other aliases are not cleared. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL Release]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF IsMemoryOwner THEN
	Memory.TryReleaseDynamicMemory(Address, TypeClass = GENERIC_TYPE_CLASS.OBJECT);
END_IF

Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{7b456980-e70d-4684-918f-f6fc89768f34}" FolderPath="CleanupMethods\">
      <Declaration><![CDATA[(*!
<summary>Clears type, address, size and ownership metadata without freeing memory.</summary>
<description>Use after transferring ownership or when no owned storage remains. Resetting an owning descriptor without arranging release loses its ownership information; no destructor or allocation is performed. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[TypeClass := GENERIC_TYPE_CLASS.UNSPECIFIED;
Address := 0;
Size := 0;
IsMemoryOwner := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryChangeValueByAny" Id="{27b8e08e-2fa6-41be-af60-419256c2188b}" FolderPath="ChangeValue\">
      <Declaration><![CDATA[(*!
<summary>Attempts to copy a compatible value into the existing generic storage.</summary>
<description>Returns FALSE on type, capacity or copy exceptions. Does not change descriptor fields or transfer ownership. Requires live source and destination storage; copied bytes are not rolled back on failure. Preserves terminal allocation state for the task boundary. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL TryChangeValueByAny : BOOL
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	ChangeValueByAnyType(value, isObject);
	TryChangeValueByAny := TRUE;
__CATCH
	TryChangeValueByAny := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryChangeValueByAnyType" Id="{4ed65d07-87f2-4259-80eb-13281b15e53c}" FolderPath="ChangeValue\">
      <Declaration><![CDATA[(*!
<summary>Attempts to copy a compatible value into the existing generic storage.</summary>
<description>Returns FALSE on type, capacity or copy exceptions. Does not change descriptor fields or transfer ownership. Requires live source and destination storage; copied bytes are not rolled back on failure. Preserves terminal allocation state for the task boundary. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
METHOD FINAL TryChangeValueByAnyType : BOOL
VAR_INPUT
	value : __SYSTEM.AnyType;
	isObject : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	ChangeValueByAnyType(value, isObject);
	TryChangeValueByAnyType := TRUE;
__CATCH
	TryChangeValueByAnyType := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryCopyTo" Id="{ce4998f1-fc8d-443b-ab31-7fcdb66ae168}">
      <Declaration><![CDATA[(*!
<summary>Copies the byte representation when the target address and size are acceptable.</summary>
<description>Returns FALSE without copying for a zero source Address, a null target or a size mismatch; otherwise copies and returns TRUE. The caller supplies live writable storage and is responsible for data compatibility. No type conversion, cloning or ownership transfer is performed. Overlapping regions, including identical addresses, are supported. Catches exceptions and returns FALSE. A failed memory operation can leave partially copied bytes; no rollback is performed. Catching an exception does not validate memory lifetime. Descendants cannot override this descriptor operation; customize value equality through IEqualityComparer or the stored object equality contract.</description>
*)
//!<param name="target">Writable destination with the same byte size.</param>
METHOD FINAL TryCopyTo : BOOL
VAR_INPUT
	target : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF Address = 0 OR_ELSE target.pValue = 0 THEN
		RETURN; 
	END_IF

	IF TO_ULINT(target.diSize) <> Size THEN
		RETURN; 
	END_IF

	internalCopyTo(target.pValue);

	TryCopyTo := TRUE;
__CATCH
	TryCopyTo := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
