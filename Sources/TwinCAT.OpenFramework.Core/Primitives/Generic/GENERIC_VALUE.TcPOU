		 RETURN;

	GENERIC_TYPE_CLASS.UINT_32:
		IF allowTypeCastWithDataLoss OR_ELSE (TO_ULINT(universalPointer.AsDWord^) <= TO_ULINT(UnsignedInt16.MAX_VALUE)) THEN
