<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericValueTypeValidator" Id="{a6d5904d-3010-444c-98c8-80a1917cd203}" SpecialFunc="None">
    <Declaration><![CDATA[(*!
<summary>Validates that a generic descriptor has the configured type tag.</summary>
<description>FB_init stores the expected tag. Validate checks exact TypeClass equality only, without dereferencing or converting payloads; it does not validate address, size, lifetime or numeric range.</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK GenericValueTypeValidator EXTENDS Object IMPLEMENTS IGenericValueValidator
VAR
	_ClassName : STRING := __POUNAME();
	
	_TypeClass : GENERIC_TYPE_CLASS;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{f82f2d1b-4fc3-4718-8a54-251f7a3461ed}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f8ee5778-fbfa-4295-aae4-9ccdc19eabec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{95506783-a7ce-4b15-8e1c-b1e7f4fba622}">
      <Declaration><![CDATA[(*!
<summary>Stores the exact type tag required by validation.</summary>
<description>Copies typeClass without allocating or raising exceptions. Does not inspect a value.</description>
*)
//!<param name="bInitRetains">if TRUE, the retain variables are initialized (warm start / cold start)</param>

//!<param name="bInCopyCode">if TRUE, the instance afterwards gets moved into the copy code (online change)</param>

METHOD FB_init : BOOL
VAR_INPUT
	
	bInitRetains	: BOOL;
	
	bInCopyCode	: BOOL;
	typeClass : GENERIC_TYPE_CLASS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TypeClass := typeClass;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{9a354a72-0f79-490e-939d-4595cd41c7d6}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{81f4a78c-70ec-4b46-b623-1fc67f33b3d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{449e46a9-6074-482b-8702-4da704e912dd}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4b470976-567f-4fd3-acda-2171efc07a0c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Validate" Id="{340dfa6e-d672-4daf-b2d9-ef30de77ce10}">
      <Declaration><![CDATA[(*!
<summary>Requires an exact match with the configured generic type tag.</summary>
<description>Throws IncompatibleGenericValueTypeException on mismatch, using validatedObjectName in diagnostics. Does not convert or inspect payload bytes, address validity or lifetime; the descriptor is borrowed and unchanged. Descendants cannot replace exact type-tag validation; implement IGenericValueValidator separately for other validation rules.</description>
*)
METHOD FINAL Validate
VAR_INPUT
	validatedObjectName : WSTRING;
END_VAR
VAR_IN_OUT CONSTANT
	valueToValidate : GENERIC_VALUE;
END_VAR
VAR
	invalidTypeException : IncompatibleGenericValueTypeException;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF valueToValidate.TypeClass <> _TypeClass THEN
	invalidTypeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), validatedObjectName, valueToValidate.TypeClass, _TypeClass);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>