<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="GENERIC_MEMORY_MANAGEMENT_BEHAVIOR" Id="{f71fed05-2a68-457b-995d-be5861a1f1e3}">
    <Declaration><![CDATA[(*!
<summary>Selects copying, borrowing or adoption when building a generic descriptor.</summary>
<description>CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY creates an owned copy. STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY borrows existing storage. STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY adopts storage that the caller may transfer for release. Concrete factories define supported representations and clone behavior; adopting task-managed exception clones is not supported.</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE GENERIC_MEMORY_MANAGEMENT_BEHAVIOR :
(
	CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY,
	STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY,
	STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>