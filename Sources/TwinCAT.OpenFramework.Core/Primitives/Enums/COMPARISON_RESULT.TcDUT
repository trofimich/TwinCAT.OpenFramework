<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="COMPARISON_RESULT" Id="{15163b0f-b190-4edc-baf0-5adafd875cef}">
    <Declaration><![CDATA[(*!
<summary>Expresses the ordering of the first operand relative to the second.</summary>
<description>Values are -1, 0 and 1 for less, equal and greater. Operand compatibility is defined by the comparer.</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE COMPARISON_RESULT :
(
	FIRST_LESS_THAN_SECOND := -1,
	FIRST_EQUAL_TO_SECOND := 0,
	FIRST_GREATER_THAN_SECOND := 1
) SINT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>