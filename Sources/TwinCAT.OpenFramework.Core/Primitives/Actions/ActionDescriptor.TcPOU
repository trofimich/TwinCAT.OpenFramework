<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ActionDescriptor" Id="{856aea8e-1241-4104-8feb-5476cb8fbca8}" SpecialFunc="None">
    <Declaration><![CDATA[(*

