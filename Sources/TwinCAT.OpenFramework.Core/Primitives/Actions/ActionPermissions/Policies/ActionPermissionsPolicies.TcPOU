{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM ActionPermissionsPolicies
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_AllowAllActionsPermissionsPolicy : AllowAllActionsPermissionsPolicy; 
	{attribute 'hide'} 
	_DenyAllActionsPermissionsPolicy : DenyAllActionsPermissionsPolicy; 
END_VAR]]></Declaration>
