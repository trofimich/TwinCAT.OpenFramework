        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AllowAllActionsPermissionsPolicy := _AllowAllActionsPermissionsPolicy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{1980d5fd-b2f2-428e-a20f-7c703a9ad931}">
