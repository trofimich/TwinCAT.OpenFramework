<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LongTimes" Id="{263e7e24-5aea-46bd-812b-7ae09f701d7e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
