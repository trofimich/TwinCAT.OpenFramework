(*!
<summary>Provides LTIME limits, duration constants and conversions from common duration units.</summary>
<description>Conversion methods scale the input to nanoseconds. The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations. LREAL cannot represent every nanosecond exactly across the full LTIME range.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM LongTimes
VAR CONSTANT
	MIN_VALUE : LTIME := LTIME#0S;
	MAX_VALUE : LTIME := LTIME#213503D23H34M33S709MS551US615NS;

	//!<summary>Duration of one day; exclusive upper bound for time-of-day values.</summary>
	ONE_DAY : LTIME := LTIME#24h;

	//!<summary>One millisecond expressed at LTIME precision, used to check lossless conversion to TIME.</summary>
	ONE_MILLISECOND : LTIME := LTIME#1ms;

	//!<summary>One second expressed at LTIME precision, used to check lossless conversion of nanosecond timestamps to DT.</summary>
	ONE_SECOND : LTIME := LTIME#1s;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{f8be15f5-076c-48ca-bf4d-3a9e95f8c7a2}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0117bffd-f478-4b70-b5bc-46a0d24d6d47}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FromDays" Id="{378c3778-10dd-431b-be55-69536192d36c}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in days to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInDays">Duration expressed in days.</param>
METHOD FromDays : LTIME
VAR_INPUT
	timeInDays : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromDays := TO_LTIME(timeInDays * 86_400_000_000_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromHours" Id="{6d48b5e3-f6f9-4cda-bd2f-7268aac24b56}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in hours to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInHours">Duration expressed in hours.</param>
METHOD FromHours : LTIME
VAR_INPUT
	timeInHours : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromHours := TO_LTIME(timeInHours * 3_600_000_000_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromMicroseconds" Id="{9de3e4e6-2a06-42e2-ab0e-f0722937ecc1}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in microseconds to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInMicroseconds">Duration expressed in microseconds.</param>
METHOD FromMicroseconds : LTIME
VAR_INPUT
	timeInMicroseconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromMicroseconds := TO_LTIME(timeInMicroseconds * 1_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromMiliseconds" Id="{60adc2ea-a38d-47d4-a474-7a2d67c4313f}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in milliseconds to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInMiliseconds">Duration expressed in milliseconds.</param>
METHOD FromMiliseconds : LTIME
VAR_INPUT
	timeInMiliseconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromMiliseconds := TO_LTIME(timeInMiliseconds * 1_000_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromMinutes" Id="{4864dc88-5558-4377-87d4-5c0d0b7e14a0}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in minutes to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInMinutes">Duration expressed in minutes.</param>
METHOD FromMinutes : LTIME
VAR_INPUT
	timeInMinutes : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromMinutes := TO_LTIME(timeInMinutes * 60_000_000_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromNanoseconds" Id="{9b282456-af17-4b2c-b3b4-1526186f44af}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in nanoseconds to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInNanoseconds">Duration expressed in nanoseconds.</param>
METHOD FromNanoseconds : LTIME
VAR_INPUT
	timeInNanoseconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromNanoseconds := TO_LTIME(timeInNanoseconds);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromSeconds" Id="{aaba609a-b89b-4cb6-ad92-158daadb2ebe}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in seconds to LTIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in LTIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_LTIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInSeconds">Duration expressed in seconds.</param>
METHOD FromSeconds : LTIME
VAR_INPUT
	timeInSeconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromSeconds := TO_LTIME(timeInSeconds * 1_000_000_000);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{6cc57616-a14c-441b-bc54-f3c5ba4249d0}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{66442e2b-6586-4c7d-b0cf-573d7538d031}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>