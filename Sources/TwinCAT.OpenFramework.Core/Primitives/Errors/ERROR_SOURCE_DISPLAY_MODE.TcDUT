<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ERROR_SOURCE_DISPLAY_MODE" Id="{12200196-fc28-4f0a-bbc7-2eb21d5a35a7}">
    <Declaration><![CDATA[(*!
<summary>Selects which stored error source descriptions are shown.</summary>
<description>HIDDEN omits sources, TOP shows the outer source, TOP_AND_ROOT also includes the stored deepest cause source.</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE ERROR_SOURCE_DISPLAY_MODE :
(
	HIDDEN := 0,
	TOP, 
	TOP_AND_ROOT
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>