<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ERROR" Id="{180a9e25-68c0-4c96-ae5f-287c5c722d87}" SpecialFunc="None">
    <Declaration><![CDATA[(*

.. <legal notes>

legal notes
