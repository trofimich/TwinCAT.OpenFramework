<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="READ_ONLY_ERROR" Id="{b500ebd3-5887-4057-8f44-b01a878f2ef7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Stores an error snapshot for reading and diagnostic formatting.</summary>
<description>Consumers must treat the exposed fields as read-only. The snapshot stores its own messages, sources and timestamps independently of exception lifetime. ToString returns bounded diagnostic text with an ellipsis when the combined text exceeds its capacity.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK ABSTRACT READ_ONLY_ERROR
VAR_OUTPUT
	Severity : ERROR_SEVERITY;
	
	TopSource : STRING(255);
	RootSource : STRING(255);
	
	TopMessage : ERROR_MESSAGE;
	RootMessage : ERROR_MESSAGE;
 	
	LocalTimestamp : LDATE_AND_TIME;	
	UtcTimestamp : LDATE_AND_TIME;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Empty" Id="{15014ff2-60b8-447c-a227-5fdf334e9097}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{bcf535ce-d7ae-4354-8315-977d0d6d743c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Empty := TopMessage = "";]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetSource" Id="{d36b0d5c-6310-4e02-9fa2-271bbf6c3775}">
      <Declaration><![CDATA[(*!
<summary>Formats the top source and optionally a distinct root source.</summary>
<description>Returns TopSource unchanged when the root is not requested, empty or identical to the top source. Otherwise joins both sources with INNER_MESSAGE_PREFIX. If the combined text exceeds 255 characters, returns its first 252 characters followed by three ASCII dots. Exact-fit text is preserved. Does not modify the snapshot or allocate dynamic memory.</description>
*)
//!<param name="appendRootSource">Include a nonempty root source when it differs from the top source.</param>
METHOD GetSource : STRING(255);
VAR_INPUT
	appendRootSource : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT appendRootSource OR_ELSE TopSource = RootSource OR_ELSE RootSource = '' THEN
	GetSource := TopSource;
ELSE
	GetSource := Strings.Concat255(TopSource, TO_STRING(Exceptions.INNER_MESSAGE_PREFIX), RootSource);

	IF Tc2_Standard.LEN(TopSource)
		+ Tc2_Standard.LEN(TO_STRING(Exceptions.INNER_MESSAGE_PREFIX))
		+ Tc2_Standard.LEN(RootSource) > SIZEOF(GetSource) - 1 
	THEN
		GetSource := Strings.Concat255(Tc2_Standard.LEFT(GetSource, SIZEOF(GetSource) - 4), '...');
	END_IF
END_IF ]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{e8903122-2915-42cd-ac77-f6c4f8e65311}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{7797597b-4bc8-49e1-b2be-fa36024618bc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := TopMessage <> "";]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToString" Id="{8ae5d492-d51d-44d5-8715-918abb2a1096}">
      <Declaration><![CDATA[(*!
<summary>Formats the stored error with optional source and timestamp information.</summary>
<description>Preserves the order: top message, distinct root message, source, timestamp. If the combined text exceeds ERROR_MESSAGE capacity, returns its leading characters with a final ellipsis and stops formatting. Exact-fit text is preserved. Does not allocate dynamic memory, modify the snapshot or raise a size-overflow exception. The intermediate source buffer holds 255 characters, matching the GetSource result capacity. Source formatting retains the existing GetSource limit.</description>
*)
METHOD ToString : ERROR_MESSAGE
VAR_INPUT
	sourceDisplayMode : ERROR_SOURCE_DISPLAY_MODE := ERROR_SOURCE_DISPLAY_MODE.HIDDEN;
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
END_VAR
VAR
	tempString : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// always show top message
IF NOT WideStrings.TryAppendToTarget(ToString, TopMessage) THEN
	JMP TRUNCATED;
END_IF

// append root message if it exists ond differs from top message
IF RootMessage <> "" AND_THEN TopMessage <> RootMessage THEN
	IF NOT WideStrings.TryAppendToTarget(ToString, Exceptions.INNER_MESSAGE_PREFIX) THEN
		JMP TRUNCATED;
	END_IF
	
	IF NOT WideStrings.TryAppendToTarget(ToString, RootMessage) THEN
		JMP TRUNCATED;
	END_IF
END_IF 

// append message source
IF sourceDisplayMode <> ERROR_SOURCE_DISPLAY_MODE.HIDDEN THEN
	IF NOT WideStrings.TryAppendToTarget(ToString, Exceptions.SOURCE_PREFIX) THEN
		JMP TRUNCATED;
	END_IF
	
	tempString := TO_WSTRING(GetSource(sourceDisplayMode = ERROR_SOURCE_DISPLAY_MODE.TOP_AND_ROOT));
	
	IF NOT WideStrings.TryAppendToTarget(ToString, tempString) THEN
		JMP TRUNCATED;
	END_IF
END_IF

// append
IF timestampDisplayMode <> TIMESTAMP_DISPLAY_MODE.HIDDEN THEN
	IF NOT WideStrings.TryAppendToTarget(ToString, Exceptions.TIME_PREFIX) THEN
		JMP TRUNCATED;
	END_IF

	CASE timestampDisplayMode OF
		TIMESTAMP_DISPLAY_MODE.LOCAL:
			tempString := TO_WSTRING(LocalTimestamp);
			
			IF NOT WideStrings.TryAppendToTarget(ToString, tempString) THEN
				JMP TRUNCATED;
			END_IF
		
		TIMESTAMP_DISPLAY_MODE.UTC:
			tempString := TO_WSTRING(UtcTimestamp);
			
			IF NOT WideStrings.TryAppendToTarget(ToString, tempString) THEN
				JMP TRUNCATED;
			END_IF
			
			IF NOT WideStrings.TryAppendToTarget(ToString, "UTC") THEN
				JMP TRUNCATED;
			END_IF
	END_CASE
END_IF

RETURN;

TRUNCATED:

ToString[SIZEOF(ToString) / SIZEOF(WORD) - 2] := WideStrings.ELLIPSIS;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>