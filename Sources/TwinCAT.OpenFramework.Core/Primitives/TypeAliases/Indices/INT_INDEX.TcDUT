<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="INT_INDEX" Id="{32988081-e0ea-477c-b49b-40f4213cf20d}">
    <Declaration><![CDATA[(*!
<summary>Represents a nonnegative index below the maximum INT length.</summary>
<description>The declared range is 0 through 32766; callers must also respect the actual indexed container bounds.</description>
*)
TYPE INT_INDEX : INT(0..32767 - 1); END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>