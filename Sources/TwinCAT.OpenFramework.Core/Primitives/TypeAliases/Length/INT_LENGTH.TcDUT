<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="INT_LENGTH" Id="{a781777b-a6c5-4629-bcf2-ce9e17dd7dc7}">
    <Declaration><![CDATA[(*!
<summary>Represents a nonnegative INT-sized length.</summary>
<description>The declared range is 0 through 32767. Units and available storage depend on the consuming operation.</description>
*)
TYPE INT_LENGTH : INT(0..32767); END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>