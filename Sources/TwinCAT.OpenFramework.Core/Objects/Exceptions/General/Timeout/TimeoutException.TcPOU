<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimeoutException" Id="{40b3559a-65c3-40ee-997f-53729baffae1}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports that an operation exceeded its allowed duration.</summary>
<description>The caller measures elapsed time and detects the timeout. This exception only records the supplied limit and optional operation name. Uses the GeneralException task-local cycle lifetime and throw rules. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK TimeoutException EXTENDS GeneralException IMPLEMENTS ITimeoutException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{ac59544c-b6f9-43dd-a8bc-ecc1c3ec1c94}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{39350c4f-3abf-4b98-84ec-93e3a3c8a80a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{cd8e9c57-c147-46b8-84c8-18069c975e09}">
      <Declaration><![CDATA[(*!
<summary>Creates a clone of this concrete exception type.</summary>
<description>Copies GeneralException fields and timestamps. DynamicMemoryManager owns the clone until cleanup of the creating task; callers must not delete it. Allocation failure is terminal. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO TimeoutException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(TimeoutException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{b5e0e8ac-f21c-47d9-9c68-43376909c004}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2f0ecd7f-7c96-4751-8065-52a0db169940}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{81d45586-9316-43b0-837d-2c69f42d0f32}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e2d3f851-054d-442a-ad8c-06f864f8b056}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{d4195ce5-0e1c-4385-8b05-e0f8d16a7a23}">
      <Declaration><![CDATA[(*!
<summary>Builds the timeout diagnostic and raises this exception.</summary>
<description>Sets error code to zero and supplies no inner exception. Call only in cyclic task context, not during FB_init.</description>
<param name="timeoutValue">Configured timeout limit reported by the caller.</param>
<param name="operationName">Optional operation name; an empty name produces a generic timeout message.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	timeoutValue : TIME;
	operationName : WSTRING := "";
END_VAR
VAR
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF operationName = WideStrings.Empty THEN
	message := WideStrings.Concat255("Timeout ", TO_WSTRING(timeoutValue), " exceeded");
ELSE
	message := WideStrings.Concat255(operationName, " timeout ", TO_WSTRING(timeoutValue), " exceeded");
END_IF

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>