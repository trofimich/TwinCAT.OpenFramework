<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="INullReferenceException" Id="{038e712d-4ef6-48ba-830c-6ff3d9907d05}">
    <Declaration><![CDATA[(*!
<summary>Reports an unassigned required reference.</summary>
<description>The caller detects the missing reference before dereferencing it. This exception records its name; it does not inspect memory or test object lifetime. Uses the GeneralException task-local cycle lifetime and throw rules.</description>
*)
INTERFACE INullReferenceException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{c610b497-8802-47d6-934b-8a411e820c9b}">
      <Declaration><![CDATA[(*!
<summary>Reports the missing reference and raises this exception.</summary>
<description>Sets error code to zero and supplies no inner exception. Call only in cyclic task context, not during FB_init.</description>
<param name="variableOrPropertyName">Name of the required variable or property that is not assigned.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	variableOrPropertyName : STRING;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>