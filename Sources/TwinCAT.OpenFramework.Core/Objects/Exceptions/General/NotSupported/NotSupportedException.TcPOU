<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="NotSupportedException" Id="{ca8720a5-ceb8-45cd-a5ed-242709c5f465}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports an unsupported operation using a caller-supplied message.</summary>
<description>Diagnostic string inputs are borrowed only during the call; retained diagnostic text is copied into owned storage.</description>
*)
FUNCTION_BLOCK NotSupportedException EXTENDS GeneralException IMPLEMENTS INotSupportedException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{fa308b47-165a-4d2c-b0e0-96bb0f0311bf}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2b32fbdb-997b-4572-8009-392deb237a2e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{b049cd35-bfc4-4bc2-b2a8-87cab0b092ff}">
      <Declaration><![CDATA[(*!
<summary>Creates a clone of this concrete exception type.</summary>
<description>Copies GeneralException fields and timestamps. DynamicMemoryManager owns the clone until cleanup of the creating task; callers must not delete it. Allocation failure is terminal.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO NotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(NotSupportedException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{88785400-5425-4442-994b-d0dee3124a0a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2c990c16-8087-43bf-af3b-67fd1502e142}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{80ce1cde-f861-4c75-b814-e388e2b58a2f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f74f64e8-7d99-41a1-a696-ef463556d251}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{4f1e3799-83c4-482e-bcef-2e46b0881cf9}">
      <Declaration><![CDATA[(*!
<summary>Raises an unsupported-operation exception with the supplied diagnostic.</summary>
<description>Long diagnostic strings are borrowed read-only for this call; their references are not retained. Pass variables or literals, and store computed expressions in local variables before calling. The caller must supply a nonempty message; this precondition is not checked at runtime.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>