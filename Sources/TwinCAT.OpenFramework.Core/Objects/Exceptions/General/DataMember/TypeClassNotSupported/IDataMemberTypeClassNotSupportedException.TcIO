<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IDataMemberTypeClassNotSupportedException" Id="{a45d046e-cfd6-46af-9060-568a379f671e}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports a field or property whose TwinCAT type class is unsupported.</summary>
<description>The caller detects the member error; Throw records diagnostics rather than inspecting the object. Dynamic instances and clones belong to the current task memory manager until cleanup.</description>
*)
INTERFACE IDataMemberTypeClassNotSupportedException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{5803b728-3de8-4545-8f65-0e2db12e9b94}">
      <Declaration><![CDATA[(*!
<summary>Formats the rejected member and propagates the exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Builds a member diagnostic and captures source and timestamps with zero error code and no inner cause. Input storage is not retained. Allocation failure uses the shared terminal memory mechanism.</description>
<param name="dataMemberName">Name of the field or property rejected by the caller.</param>
<param name="dataMemberType">Unsupported TwinCAT type class.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	dataMemberName : STRING;
	dataMemberType : __SYSTEM.TYPE_CLASS;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>