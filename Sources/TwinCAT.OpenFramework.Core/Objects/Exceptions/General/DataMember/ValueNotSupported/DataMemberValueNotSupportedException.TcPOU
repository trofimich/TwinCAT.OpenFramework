<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DataMemberValueNotSupportedException" Id="{7c8607ac-ff97-4c81-9b19-1ae785ca9865}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports a field or property value unsupported by the operation.</summary>
<description>The caller detects the member error; Throw records diagnostics rather than inspecting the object. Dynamic instances and clones belong to the current task memory manager until cleanup. Value text is limited to 255 characters. Longer STRING and WSTRING inputs use a 254-character prefix followed by an ellipsis. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK DataMemberValueNotSupportedException EXTENDS GeneralException IMPLEMENTS IDataMemberValueNotSupportedException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{36c2df51-a974-4fe6-8f9b-c884984bbb46}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{565f1ae2-8d3a-4102-91d0-f8f516a770e4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{06589630-ee4e-4f3f-b35f-5e9c2d57c7f9}">
      <Declaration><![CDATA[(*!
<summary>Creates a distinct auto-disposed copy of this concrete exception type.</summary>
<description>Copies message, code, source and timestamps through CopyGeneralFields; any prepared inner cause remains borrowed. The current task memory manager owns the clone until cleanup. Allocation failure is terminal. Descendants with additional payload must override Clone to preserve their type and fields. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO DataMemberValueNotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(DataMemberValueNotSupportedException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{551a73cd-ef55-4bb1-8153-9388648dc0c5}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{01422b87-d8e8-4235-95ea-678b97178f1e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{2537b952-88bc-4f88-a62d-d4c6f4c7f428}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ef9e70fd-ad35-4422-ae5d-8acbd58f943c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{0586d628-4a4c-4adc-8bb8-68f1e0460289}">
      <Declaration><![CDATA[(*!
<summary>Formats the rejected member and propagates the exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Builds a member diagnostic and captures source and timestamps with zero error code and no inner cause. Input storage is not retained. Allocation failure uses the shared terminal memory mechanism. Uses the shared ANY formatter; STRING and WSTRING values longer than 255 characters retain their first 254 characters followed by an ellipsis. Exactly 255 characters remain unchanged.</description>
<param name="dataMemberName">Name of the field or property rejected by the caller.</param>
<param name="dataMemberValue">Live value to describe; string inputs must be null-terminated.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	dataMemberName : STRING;
	dataMemberValue : ANY;
END_VAR
VAR
	valueAsString : WSTRING(255);
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueAsString := WideStrings.InternalAnyToString255(dataMemberValue);

IF (dataMemberValue.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_STRING
	AND_THEN Strings.InternalGetLength(dataMemberValue.pValue) > 255)
	OR_ELSE (dataMemberValue.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_WSTRING
	AND_THEN WideStrings.InternalGetLength(dataMemberValue.pValue) > 255) THEN
	valueAsString := Tc2_Standard.WCONCAT(Tc2_Standard.WLEFT(valueAsString, 254), "…");
END_IF

stringBuilder
	.AppendString("Field or property '")
	.Append(dataMemberName)
	.AppendString("' has not supported value '")
	.AppendString(valueAsString)
	.AppendString("' in the instance of '")
	.AppendString255(TO_WSTRING(sourceNamespaceName))
	.AppendString(".")
	.AppendString255(TO_WSTRING(sourceClassName))
	.AppendString("'")
	.AssignToString(message);
	
stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>