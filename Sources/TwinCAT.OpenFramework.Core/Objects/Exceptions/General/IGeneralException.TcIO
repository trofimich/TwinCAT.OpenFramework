<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IGeneralException" Id="{d983ee74-5791-40d6-b742-92434317edb5}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes the message, error code and inner exception of a general exception.</summary>
<description>Root lookup provides a borrowed read-only diagnostic view without transferring ownership or extending lifetime. A wrapper with an inner exception must have its own nonempty message or nonzero error code; callers are responsible for this rule. A dynamic exception supplied as an inner cause must not be cleared or otherwise modified through any alias until its task cleanup. Reading and propagation through ExceptionManager remain allowed; static inputs are cloned. The supplied graph must already be acyclic, including graphs from custom implementations. Before changing this instance, framework Throw rejects any path back to this instance with a StandardException that has no inner cause. Validation follows IGeneralException and IAggregateException edges; inputs must remain live and stable during traversal. Shared causes in separate branches are allowed.</description>
*)
INTERFACE IGeneralException EXTENDS IException
]]></Declaration>
    <Property Name="ErrorCode" Id="{6b64a45c-051a-48ee-a27d-c3dbcc60e4bf}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL ErrorCode : UDINT]]></Declaration>
      <Get Name="Get" Id="{04d5d64f-d327-43d7-9f8a-41fb2f21cb91}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="GetRootException" Id="{d1541aef-c327-42c5-8db6-0308e8de7f5b}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the root exception.</summary>
<description>No clone is created and ownership is not transferred. The view does not extend the exception's lifetime and does not expose Clear.</description>
*)

METHOD GetRootException : IReadOnlyException]]></Declaration>
    </Method>
    <Property Name="InnerException" Id="{b22600ff-32e1-412a-9999-be966eb3f9a6}">
      <Declaration><![CDATA[(*!
<summary>Returns the inner cause as a borrowed reference for reading only.</summary>
<description>Returns zero when no inner cause is attached. Callers must not clear or otherwise modify the returned exception through this reference. No clone is created, ownership is not transferred and lifetime is not extended; registered exceptions remain valid only until their task cleanup. The IReadOnlyException view does not expose Clear. It is not an immutable snapshot; callers must also respect the read-only contract of borrowed source strings.</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL InnerException : IReadOnlyException]]></Declaration>
      <Get Name="Get" Id="{31d5db1b-8b93-413d-8924-a82a16beeb43}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="SourceMessage" Id="{5e4316d5-0fc4-47ec-9091-572b6a8bd406}">
      <Declaration><![CDATA[(*!
<summary>Borrows the exception's own message for reading without copying.</summary>
<description>Callers must not modify the returned string. The compiler does not enforce this read-only contract. The reference does not transfer ownership or extend the exception's lifetime and is not an independent snapshot; its contents may change when the exception is cleared or reused.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourceMessage : REFERENCE TO ERROR_MESSAGE]]></Declaration>
      <Get Name="Get" Id="{84e53f69-0a0a-48fb-8362-a2dbf733bd49}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>