<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IStandardException" Id="{44bc1fac-e5a7-4db5-b697-c8ac44e9b553}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides an application-defined exception with an explicit Throw operation.</summary>
<description>A supplied inner exception requires a nonempty wrapper message or nonzero error code. The caller is responsible for meeting this rule. A dynamic exception supplied as an inner cause must not be cleared or otherwise modified through any alias until its task cleanup. Reading and propagation through ExceptionManager remain allowed; static inputs are cloned. The supplied graph must already be acyclic, including graphs from custom implementations. Before changing this instance, framework Throw rejects any path back to this instance with a StandardException that has no inner cause. Validation follows IGeneralException and IAggregateException edges; inputs must remain live and stable during traversal. Shared causes in separate branches are allowed.</description>
*)
INTERFACE IStandardException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{2a459ebf-4fc3-4850-993f-95d325724c5e}">
      <Declaration><![CDATA[(*!
<summary>Raises the supplied message and code, optionally wrapping an inner exception.</summary>
<description>If innerException is supplied, message must be nonempty or errorCode nonzero. This is a caller obligation, not a runtime validation requirement. A dynamic exception supplied as an inner cause must not be cleared or otherwise modified through any alias until its task cleanup. Reading and propagation through ExceptionManager remain allowed; static inputs are cloned. The supplied graph must already be acyclic, including graphs from custom implementations. Before changing this instance, framework Throw rejects any path back to this instance with a StandardException that has no inner cause. Validation follows IGeneralException and IAggregateException edges; inputs must remain live and stable during traversal. Shared causes in separate branches are allowed. Long diagnostic strings are borrowed read-only for this call; their references are not retained. Pass variables or literals, and store computed expressions in local variables before calling.</description>
*)

METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : ERROR_MESSAGE;
END_VAR
VAR_INPUT
	errorCode : UDINT := 0;
	innerException : IException := 0;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
