<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StandardException" Id="{b382ea9e-7b50-4f43-b8b7-7261a023e53c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Raises an application-defined message and error code with an optional inner cause.</summary>
<description>Uses GeneralException metadata and task-scoped exception transport. When an inner exception is supplied, callers must provide a nonempty wrapper message or nonzero error code. This rule is not checked at runtime. A dynamic exception supplied as an inner cause must not be cleared or otherwise modified through any alias until its task cleanup. Reading and propagation through ExceptionManager remain allowed; static inputs are cloned. The supplied graph must already be acyclic, including graphs from custom implementations. Before changing this instance, framework Throw rejects any path back to this instance with a StandardException that has no inner cause. Validation follows IGeneralException and IAggregateException edges; inputs must remain live and stable during traversal. Shared causes in separate branches are allowed. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK StandardException EXTENDS GeneralException IMPLEMENTS IStandardException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{eab451d6-87ca-48a6-bb0f-5abba0092466}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e2b3d51c-0bdc-4b4c-a08d-e7c8bb7c8b43}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{6f61caa5-3ce7-4816-a0c4-5bffa6912192}">
      <Declaration><![CDATA[(*!
<summary>Creates an auto-disposed StandardException with copied diagnostics and a shared prepared inner cause.</summary>
<description>Copies message, code, source and timestamps without changing the source. The inner cause is borrowed, not recursively cloned, and must remain unchanged until task cleanup. The task memory manager owns the new instance; callers must not delete or adopt it. Allocation failure uses the shared terminal memory mechanism. Descendants with additional payload must override Clone to preserve that payload and their concrete type. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(StandardException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{576c6b13-52f5-4ff8-a422-b5c2db93befd}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f0c2c7b9-6239-4622-abbf-03d25e14440e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{dc73eb80-8242-4633-a156-5a68c24c43d9}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0c834c97-43c6-4490-926d-12b5257d99c3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{5a54acfb-e13d-4257-ba9c-403454910cd9}">
      <Declaration><![CDATA[(*!
<summary>Captures the supplied diagnostic information and raises the exception.</summary>
<description>If innerException is supplied, message must be nonempty or errorCode nonzero. The caller is responsible for this rule; no runtime validation is performed. Uses the owning task's exception transport and cleanup lifetime. A dynamic exception supplied as an inner cause must not be cleared or otherwise modified through any alias until its task cleanup. Reading and propagation through ExceptionManager remain allowed; static inputs are cloned. The supplied graph must already be acyclic, including graphs from custom implementations. Before changing this instance, framework Throw rejects any path back to this instance with a StandardException that has no inner cause. Validation follows IGeneralException and IAggregateException edges; inputs must remain live and stable during traversal. Shared causes in separate branches are allowed. Long diagnostic strings are borrowed read-only for this call; their references are not retained. Pass variables or literals, and store computed expressions in local variables before calling.</description>
*)

METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR_IN_OUT CONSTANT
	message : ERROR_MESSAGE;
END_VAR
VAR_INPUT
	errorCode : UDINT := 0;
	innerException : IException := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, errorCode, innerException);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
