<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IIncompartibleGenericValueTypeException" Id="{feeaa4aa-5b5e-462e-9c3e-1501eb3608c2}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports a generic value whose actual type class differs from the expected one.</summary>
<description>The caller detects the error; this type records the supplied diagnostic values without performing the conversion or validation. Dynamic instances and clones belong to the current task memory manager until cleanup.</description>
*)
INTERFACE IIncompartibleGenericValueTypeException EXTENDS IGeneralException]]></Declaration>
    <Method Name="Throw" Id="{bfb374d5-a64b-4d06-8c34-af2cdfea1228}">
      <Declaration><![CDATA[(*!
<summary>Formats the supplied failure details and propagates this exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Captures message, source and timestamps with zero error code and no inner cause. Input storage is not retained. Allocation failure uses the shared terminal memory mechanism.</description>
<param name="actualTypeClass">Observed generic type class.</param>
<param name="expectedTypeClass">Required generic type class.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	validatedObjectName : WSTRING;
	actualTypeClass : GENERIC_TYPE_CLASS;
	expectedTypeClass : GENERIC_TYPE_CLASS;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>