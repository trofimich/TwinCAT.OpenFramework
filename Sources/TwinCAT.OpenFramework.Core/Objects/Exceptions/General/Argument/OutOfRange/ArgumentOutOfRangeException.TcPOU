<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ArgumentOutOfRangeException" Id="{98d20286-f8bd-41e5-8b87-fcb4b5d7ca5e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports an argument value outside the range accepted by the caller.</summary>
<description>The caller determines that the argument is invalid; Throw formats the diagnostic rather than validating the argument. Argument values are represented in at most 255 characters. STRING and WSTRING values longer than 255 characters retain their first 254 characters followed by an ellipsis. Dynamic exceptions belong to the current task memory manager until cleanup. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK ArgumentOutOfRangeException EXTENDS GeneralException IMPLEMENTS IArgumentOutOfRangeException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{c27874b7-4abc-48c2-950c-b0bb5f01f34d}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{731dacbe-6b4c-4a54-a726-b999af608436}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{cce15318-1da6-4dd9-8b2e-884a82dd488e}">
      <Declaration><![CDATA[(*!
<summary>Creates a task-owned copy of this exception and its diagnostic payload.</summary>
<description>Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence. The returned reference is borrowed until task cleanup and must not be deleted by the caller.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO ArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(ArgumentOutOfRangeException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{905b7564-223e-4161-86fe-e47bcc939f12}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d388c6b1-588b-4ade-aeba-27a186862023}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{527aeda2-b68e-4925-b9c4-ca5bfdb83414}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8dbf744f-7964-4344-9744-8dc5f4e021dd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{5feec76b-4654-49c9-b2bc-8cf052990d28}">
      <Declaration><![CDATA[(*!
<summary>Formats the rejected argument and propagates the exception with source metadata.</summary>
<description>Call in the owning cyclic task, not during FB_init. Reads the supplied value only during this call and retains its formatted text. Long STRING and WSTRING values use a 254-character prefix followed by an ellipsis; exactly 255 characters are kept unchanged. Other types use the shared ANY formatter. Sets error code to zero and has no inner cause. Builder or exception allocation failure uses the terminal memory mechanism.</description>
<param name="argumentName">Name of the argument rejected by the caller.</param>
<param name="argumentValue">Live value to describe; string inputs must be null-terminated.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	argumentName : STRING;
	argumentValue : ANY;
END_VAR
VAR
	valueAsString : WSTRING(255);
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueAsString := WideStrings.InternalAnyToString255(argumentValue);

IF (argumentValue.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_STRING
	AND_THEN Strings.InternalGetLength(argumentValue.pValue) > 255)
	OR_ELSE (argumentValue.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_WSTRING
	AND_THEN WideStrings.InternalGetLength(argumentValue.pValue) > 255) THEN
	valueAsString := Tc2_Standard.WCONCAT(Tc2_Standard.WLEFT(valueAsString, 254), "…");
END_IF

stringBuilder
	.AppendString("Argument '")
	.Append(argumentName)
	.AppendString("' has invalid value '")
	.AppendString(valueAsString)
	.AppendString("' in '")
	.AppendString255(TO_WSTRING(GetFullPouName(sourceNamespaceName, sourceClassName, sourcePOUName)))
	.AppendString("'")
	.AssignToString(message);
	
stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>