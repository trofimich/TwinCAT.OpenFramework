<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IArgumentTypeNotSupportedException" Id="{1695bca9-f138-4a60-a05b-2d316a44dff3}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports an argument whose named type is not supported by the operation.</summary>
<description>The caller detects the invalid argument. Throw records a diagnostic message and source metadata; it does not inspect the actual argument or decide which types are supported. Dynamic instances belong to the current task memory manager until cleanup.</description>
*)
INTERFACE IArgumentTypeNotSupportedException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{ab79d730-cf02-4b98-838f-7d871c4cb905}">
      <Declaration><![CDATA[(*!
<summary>Builds the argument diagnostic and propagates this exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Captures message, source and timestamps with zero error code and no inner cause. Supplied names are copied into the message; no caller storage is retained. Allocation failure follows the shared terminal memory mechanism.</description>
<param name="argumentName">Name of the argument rejected by the caller.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	argumentName : STRING;
	argumentTypeName : STRING;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>