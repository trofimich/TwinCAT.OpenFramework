<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ArgumentTypeNotSupportedException" Id="{e65e380b-db18-442f-96f6-e7cc3cbe0ecf}" SpecialFunc="None">
    <Declaration><![CDATA[(*

.. <legal notes>

