(*!
<summary>Provides shared exception metadata, formatting and automatic cleanup registration.</summary>
<description>
Dynamic descendants are owned by DynamicMemoryManager until cleanup; static instances remain caller-owned.
Each dynamic exception belongs to the cyclic PLC task that created it; do not pass exception objects between tasks.
Do not throw or create dynamic exceptions during application FB_init. Static templates remain supported.
Clone implementations must return an IException-compatible object; clients borrow registered clones.
GetRootException returns a borrowed read-only view without extending its lifetime.
SourceFullPOUName and SourcePosition expose borrowed storage for reading only; callers must not modify it.
Source names formatted by GetFullPOUName are truncated to 128 characters without raising a formatting overflow exception.
</description>
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 


FUNCTION_BLOCK ABSTRACT Exception EXTENDS Object IMPLEMENTS IException
VAR
	_SourceFullPOUName : STRING(128);
	_SourcePosition : STRING(32);
	_LocalTimestamp : LDATE_AND_TIME;	
	_UtcTimestamp : LDATE_AND_TIME;	
	
	_AutoDisposeRegistrar : AutoDisposeRegistrar(THIS^);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{a47a20ca-4953-4e09-8f4d-fc2e8d3ac96e}" />
    <Method Name="AppendTimestampDescription" Id="{a316d3b4-0094-41d5-a4cb-9fba6e2a6883}" FolderPath="Service members\">
      <Declaration><![CDATA[METHOD PROTECTED AppendTimestampDescription
VAR_IN_OUT CONSTANT
	stringBuilder : WideStringBuilder;
END_VAR
VAR_INPUT
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
	localTimestamp : LDATE_AND_TIME;	
	utcTimestamp : LDATE_AND_TIME;	
END_VAR
VAR
	timeStampString : WSTRING(40);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF timestampDisplayMode = TIMESTAMP_DISPLAY_MODE.HIDDEN THEN
	RETURN;
END_IF

CASE timestampDisplayMode OF
	TIMESTAMP_DISPLAY_MODE.LOCAL:
		timeStampString := TO_WSTRING(localTimestamp);
	
	TIMESTAMP_DISPLAY_MODE.UTC:
		timeStampString := TO_WSTRING(utcTimestamp);
END_CASE

timeStampString := Tc2_Standard.WLEFT(Tc2_Standard.WDELETE(timeStampString, 4, 1), 22);

stringBuilder.AppendString(timeStampString);
IF timestampDisplayMode = TIMESTAMP_DISPLAY_MODE.UTC THEN
	stringBuilder.AppendString("UTC");
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clear" Id="{44a047f7-46bd-418c-989f-4458402150ba}">
      <Declaration><![CDATA[(*!
<summary>Resets source and timestamps. Descendants clear their own payload and call this implementation.</summary>
<description>
Resets timestamps to LongDateAndTimes.EPOCH. Does not delete the instance or unregister it from automatic cleanup.
</description>
*)

METHOD Clear]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SourceFullPOUName := '';
_SourcePosition := '';
_LocalTimestamp := LongDateAndTimes.EPOCH;	
_UtcTimestamp := LongDateAndTimes.EPOCH;	]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clone" Id="{ff7ec3e0-b6aa-4a29-8b78-e576a86138cb}">
      <Declaration><![CDATA[METHOD ABSTRACT Clone : IObject]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Empty" Id="{bd97cee3-a16c-4148-a36f-41860b6b4283}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{32775313-ab40-46b6-a69f-434f332e1416}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExtractClassName" Id="{2741f852-3263-48be-9dbc-ba747f8558d6}" FolderPath="Service members\">
      <Declaration><![CDATA[METHOD PROTECTED ExtractClassName : STRING
VAR_IN_OUT CONSTANT
	sourcePOUName : STRING;
END_VAR
VAR
	splitter : StringSplittingEnumerator;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[splitter := Strings.CreateSplitter(sourcePOUName, '.', 0, TRUE, TRUE);

WHILE splitter.MoveNext() DO		
	ExtractClassName := splitter.CurrentEntry;
	
	RETURN;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExtractMethodName" Id="{be44e9a6-255a-48b7-a062-fbf15488833a}" FolderPath="Service members\">
      <Declaration><![CDATA[METHOD PROTECTED ExtractMethodName : STRING
VAR_IN_OUT CONSTANT
	sourcePOUName : STRING;
END_VAR
VAR
	splitter : StringSplittingEnumerator;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[splitter := Strings.CreateSplitter(sourcePOUName, '.', 0, TRUE, TRUE);

WHILE splitter.MoveNext() DO
	ExtractMethodName := splitter.CurrentEntry;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{11857425-e8b4-42f5-9cda-87a6242433d1}">
      <Declaration><![CDATA[//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetFullPOUName" Id="{55af960f-b27f-4389-9e6d-9c37bf31a838}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Formats the namespace, class and POU name for exception diagnostics.</summary>
<description>
With a class name, uses the last nonempty POU name segment as the method name and appends parentheses.
Returns the first 128 characters when the full name exceeds the result capacity; truncation does not raise an exception.
</description>
*)

METHOD PROTECTED GetFullPOUName : STRING(128)
VAR_IN_OUT CONSTANT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sourceNamespaceName <> Strings.Empty THEN
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, sourceNamespaceName), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, '.'), 128);
END_IF

IF sourceClassName <> Strings.Empty THEN
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, sourceClassName), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, '.'), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, ExtractMethodName(sourcePOUName)), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, '()'), 128);
ELSE
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, sourcePOUName), 128);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMessage" Id="{6f101456-9a5d-4c21-8b11-8b9151d71824}">
      <Declaration><![CDATA[METHOD ABSTRACT GetMessage : ERROR_MESSAGE
VAR_INPUT
	showSource : BOOL := FALSE;
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
END_VAR]]></Declaration>
      <Implementation>
