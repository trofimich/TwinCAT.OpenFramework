      </Implementation>
    </Method>
    <Method Name="GetRootException" Id="{14eed042-28c1-47eb-a619-b182b2b0181c}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the root exception.</summary>
<description>No clone is created and ownership is not transferred. The view does not extend the exception's lifetime and does not expose Clear.</description>
*)

METHOD ABSTRACT GetRootException : IReadOnlyException]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSourceDescription" Id="{d08299fd-3dd9-413a-badd-9a2833bcb01e}">
      <Declaration><![CDATA[METHOD GetSourceDescription : STRING(255)
VAR
	stringBuilder : WideStringBuilder;
	
	result : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString255(TO_WSTRING(_SourceFullPOUName))
	.AppendStringIf(Exceptions.SOURCE_POSITION_PREFIX, sourcePosition <> '')
	.AppendString255If(TO_WSTRING(sourcePosition), sourcePosition <> '')
	.AssignToString(result);

GetSourceDescription := TO_STRING(result);]]></ST>
      </Implementation>
    </Method>
    <Property Name="LocalTimestamp" Id="{4c2d5866-231e-4105-a6bb-6c19851f1e45}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL LocalTimestamp : LDATE_AND_TIME]]></Declaration>
      <Get Name="Get" Id="{4cb9fd2f-3b41-4625-9c08-af3725cdee6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LocalTimestamp := _LocalTimestamp;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{45619644-007a-4d10-a49a-4bb8ab2228ac}">
        <Declaration><![CDATA[PROTECTED]]></Declaration>
        <Implementation>
          <ST><![CDATA[_LocalTimestamp := LocalTimestamp;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SourceFullPOUName" Id="{ce5ba086-21af-4254-a988-84dec5648bcb}">
      <Declaration><![CDATA[(*!
<summary>Provides the source POU name for reading without copying.</summary>
<description>
The reference borrows storage from the live exception and must not outlive it.
Callers must not modify the referenced string; ST does not enforce this restriction.
This is a live view, not a snapshot: changes to the exception can change the observed value.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourceFullPOUName : REFERENCE TO STRING(128)]]></Declaration>
      <Get Name="Get" Id="{8170787e-91f8-4271-bfce-a70e9b6f9137}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SourceFullPOUName REF= _SourceFullPOUName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SourcePosition" Id="{92080a7c-c630-4b10-82a8-4b95a8267619}">
      <Declaration><![CDATA[(*!
<summary>Provides the source position for reading without copying.</summary>
<description>
The reference borrows storage from the live exception and must not outlive it.
Callers must not modify the referenced string; ST does not enforce this restriction.
This is a live view, not a snapshot: changes to the exception can change the observed value.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourcePosition : REFERENCE TO STRING(32)]]></Declaration>
      <Get Name="Get" Id="{da2e3d95-43f0-4ba4-a676-8010643e418a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SourcePosition REF= _SourcePosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToError" Id="{8d25c83e-d9af-49a8-90c4-2ced5ac3b9ee}">
      <Declaration><![CDATA[(*!
<summary>Prepares diagnostic text locally before passing it to read-only logging or exception parameters.</summary>
<description>Computed diagnostic strings are held in local buffers for the duration of the receiving call.</description>
*)
METHOD ToError
VAR_IN_OUT CONSTANT
	targetError : ERROR;
END_VAR
VAR_INPUT
	severity : ERROR_SEVERITY;	
END_VAR
VAR
	topSourceText : STRING(255);
	rootSourceText : STRING(255);
	topMessageText : ERROR_MESSAGE;
	rootMessageText : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(targetError) THEN
	RETURN;
END_IF

topSourceText := GetSourceDescription();
rootSourceText := GetSourceDescription();
topMessageText := GetMessage();
rootMessageText := GetMessage();

targetError.Fill(
	severity,
	topSourceText,
	rootSourceText,
	topMessageText,
	rootMessageText,
	LocalTimestamp,
	UtcTimestamp
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="UtcTimestamp" Id="{6ae20a8f-f2b2-4c7c-96e2-30787aae9908}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL UtcTimestamp : LDATE_AND_TIME]]></Declaration>
      <Get Name="Get" Id="{68e22629-e573-41bd-b400-d1cb3c398e1f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[UtcTimestamp := _UtcTimestamp;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b2d25d91-e13d-48d8-a20e-cde8a5d29fe4}">
        <Declaration><![CDATA[PROTECTED]]></Declaration>
        <Implementation>
          <ST><![CDATA[_UtcTimestamp := UtcTimestamp;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
