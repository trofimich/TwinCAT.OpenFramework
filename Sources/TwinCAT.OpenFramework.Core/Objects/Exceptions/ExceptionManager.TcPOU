<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ExceptionManager" Id="{a83d007f-42e6-48cd-9a14-7b9a497b4ddf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Transports exceptions with a separate payload and native wrapper for each cyclic PLC task.</summary>
<description>Exception objects must not cross task boundaries. Throw/GetLastException/ReThrowLastException require cyclic context; do not throw from FB_init. Cleanup affects only the current task. Clone its static native wrapper before callbacks that can handle another native error. Per-task array bounds use System.TASK_COUNT.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM ExceptionManager
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	_Exceptions : ARRAY [1..System.TASK_COUNT] OF IException;
	_SystemExceptions : ARRAY [1..System.TASK_COUNT] OF SystemException;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{48fade2e-63bd-4687-b635-a26e3a0e44d2}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f78e5eeb-7174-4e7e-8bf4-5241f5dd7503}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cleanup" Id="{9439ecc4-f37f-44e7-803e-1ee8d39cff59}">
      <Declaration><![CDATA[(*!
<summary>Drops the borrowed framework payload before DynamicMemoryManager deletes registered objects.</summary>
<description>
Only affects the current cyclic task. Does not delete exceptions or reset its SystemException.
</description>
*)

METHOD Cleanup
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := DynamicMemoryManager.GetCurrentTaskIndex();

IF taskIndex = 0 THEN
	RETURN;
END_IF

CleanupTask(taskIndex);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CleanupTask" Id="{73c688ca-dc50-410f-8a35-38c9d610e5e0}">
      <Declaration><![CDATA[(*!
<summary>Drops one task's borrowed payload before its registered objects are deleted.</summary>
<description>Internal operation for the owning task or application teardown with cyclic execution stopped. taskIndex must be within the generated task table; concurrent access from another task is forbidden.</description>
*)

METHOD INTERNAL CleanupTask
VAR_INPUT
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Exceptions[taskIndex] := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetLastException" Id="{e2be0c6d-d285-4e57-9453-ace2efe79ed7}">
      <Declaration><![CDATA[(*!
<summary>Returns the framework payload or the shared SystemException configured for this catch.</summary>
<description>
The result is borrowed from the current cyclic task; its system instance changes on the next system catch in that task. Do not pass the result to another task.
Clone a static result before callbacks that may handle another system error.
A SystemException propagated by Throw is a dynamic framework payload retaining its original metadata.
A native code already lost by the runtime cannot be reconstructed here.
</description>
*)

METHOD GetLastException : IException
VAR_INPUT 
	exceptionCode : __SYSTEM.ExceptionCode;
	catchPointNamespaceName : STRING;
	catchPointPOUName : STRING;
	catchPointPosition : STRING;
END_VAR
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := DynamicMemoryManager.GetCurrentTaskIndex();

IF taskIndex = 0 THEN
	RETURN;
END_IF

// 3902013441 is a workaround for bug in 3.1.4026.19
IF (exceptionCode = __SYSTEM.ExceptionCode.RTSEXCPT_USER_EXCEPTION_BASE OR_ELSE exceptionCode = 3902013441) AND_THEN _Exceptions[taskIndex] <> 0 THEN
	GetLastException := _Exceptions[taskIndex];
ELSE
	_SystemExceptions[taskIndex].Configure(exceptionCode, catchPointNamespaceName, catchPointPOUName, catchPointPosition);
	
	GetLastException := _SystemExceptions[taskIndex];
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{dda72a28-bb72-497e-8f27-b037ac7ca94f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{db04ba72-0d5b-4d3e-bca2-301f74e7a26c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReThrowLastException" Id="{7ea9eaf2-899d-4c20-8cad-4853167d967f}">
      <Declaration><![CDATA[(*!
<summary>Propagates the current exception as a framework payload, wrapping native errors in SystemException.</summary>
<description>
Pass the current catch code and its location. For an already obtained exception, call Throw directly.
The payload belongs to the current cyclic task and must not be shared with another task.
Before callbacks that can handle another error, clone a borrowed static SystemException and retain that clone.
Static payloads are cloned on propagation; dynamic payloads retain identity until automatic cleanup.
The next raw catch code identifies framework transport, not the original native error.
A latched allocation failure is raised before any allocation and is never wrapped here.
</description>
*)

METHOD ReThrowLastException
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	catchPointNamespaceName : STRING := '';
	catchPointPOUName : STRING := '';
	catchPointPosition : STRING := '';
END_VAR
VAR
	currentException : IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[DynamicMemoryManager.RaiseIfAllocationFailed();

currentException := GetLastException(exceptionCode, catchPointNamespaceName, catchPointPOUName, catchPointPosition);

Throw(currentException);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Throw" Id="{75adab3e-0cb1-497b-afc4-6a0aa273ac06}">
      <Declaration><![CDATA[(*!
<summary>Null is a no-op. Dynamic exceptions are borrowed; static exceptions are cloned.</summary>
<description>
Call in a cyclic PLC task using a payload belonging to that task. Do not throw during FB_init.
The clone must implement IException and have a lifetime covering all handlers until cleanup.
Framework implementations register dynamic clones with DynamicMemoryManager.
SystemException uses the same transport and retains its captured native code and timestamps.
A latched allocation failure is raised before cloning.
</description>
*)

METHOD Throw
VAR_INPUT CONSTANT
	exception : IException;
END_VAR
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF exception = 0 THEN
	RETURN;
END_IF

DynamicMemoryManager.RaiseIfAllocationFailed();

taskIndex := DynamicMemoryManager.GetCurrentTaskIndex();

IF taskIndex = 0 THEN
	RETURN;
END_IF

IF exception.IsDynamicInstance THEN
	_Exceptions[taskIndex] := exception;
ELSE
	__QUERYINTERFACE(exception.Clone(), _Exceptions[taskIndex]);
END_IF

Tc2_System.F_RaiseException(__SYSTEM.ExceptionCode.RTSEXCPT_USER_EXCEPTION_BASE);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
