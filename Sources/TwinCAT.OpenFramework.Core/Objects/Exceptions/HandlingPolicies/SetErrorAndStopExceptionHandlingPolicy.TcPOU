<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SetErrorAndStopExceptionHandlingPolicy" Id="{147e24e0-52f1-4730-b874-817dcb4f0d6e}" SpecialFunc="None">
    <Declaration><![CDATA[(*

.. <legal notes>

