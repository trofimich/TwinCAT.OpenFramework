<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="EXCEPTION_REACTION" Id="{774d76d6-0135-4bca-b6fc-6df41659ea71}">
    <Declaration><![CDATA[(*
