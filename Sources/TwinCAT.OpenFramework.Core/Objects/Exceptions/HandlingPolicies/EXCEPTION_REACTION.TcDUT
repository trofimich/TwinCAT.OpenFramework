License: https://opensource.org/license/mit
*)

{attribute 'qualified_only'}
{attribute 'to_string'}
(*!
<summary>Selects how the caller reacts to a caught exception.</summary>
<description>Policies select a reaction; the caller applies it. In Automation outside initialization, IGNORE preserves exception logging but does not set the error state or stop the component. Initialization uses separate failure handling.</description>
*)
TYPE EXCEPTION_REACTION :
(
	SET_ERROR_AND_STOP,
	SET_ERROR_AND_CONTINUE,
	IGNORE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
