<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IgnoreExceptionHandlingPolicy" Id="{73dbd0d5-9e48-4680-a175-0b9578d97a63}" SpecialFunc="None">
    <Declaration><![CDATA[(*

