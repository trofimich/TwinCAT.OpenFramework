{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM ExceptionHandlingPolicies
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_SetErrorAndStop : SetErrorAndStopExceptionHandlingPolicy; 
	{attribute 'hide'} 
	_SetErrorAndContinue : SetErrorAndContinueExceptionHandlingPolicy; 
	{attribute 'hide'} 
	_Ignore : IgnoreExceptionHandlingPolicy; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{304036be-83ce-436b-8796-8bb9a917572e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{42386e35-a242-4e17-9672-f0bbcb69971b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Ignore" Id="{3fa5ddfd-092f-465d-8780-b698a4f21208}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Ignore : IExceptionHandlingPolicy]]></Declaration>
      <Get Name="Get" Id="{c36611be-4c85-4425-9b88-214f05dfc532}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Ignore := _Ignore;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{04c6ab03-30ec-4b23-ba7c-1d680266d5e9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
