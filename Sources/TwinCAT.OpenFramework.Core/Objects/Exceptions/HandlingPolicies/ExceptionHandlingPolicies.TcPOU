    <Property Name="SetErrorAndStop" Id="{40adec1c-f262-4483-9cda-8640fb51ad5f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SetErrorAndStop : IExceptionHandlingPolicy]]></Declaration>
      <Get Name="Get" Id="{e4a92697-c94a-4d25-9e15-f39344eac26a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
