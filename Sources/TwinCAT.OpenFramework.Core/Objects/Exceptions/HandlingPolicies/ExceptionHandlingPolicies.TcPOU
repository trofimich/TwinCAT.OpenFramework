        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SetErrorAndContinue" Id="{fbd978c5-f856-4be6-9cd4-d181823679a3}">
