PROPERTY SetErrorAndContinue : IExceptionHandlingPolicy]]></Declaration>
      <Get Name="Get" Id="{a417abe0-3b26-4c31-afeb-59de23130f2f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
