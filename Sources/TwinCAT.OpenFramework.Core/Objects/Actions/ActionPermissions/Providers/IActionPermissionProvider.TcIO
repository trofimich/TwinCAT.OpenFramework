<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IActionPermissionProvider" Id="{11122ffc-a610-4022-99ee-4c4322cf06fe}">
    <Declaration><![CDATA[(*
