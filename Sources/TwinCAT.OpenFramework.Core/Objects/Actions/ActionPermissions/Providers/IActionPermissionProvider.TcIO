(*!
<summary>Provides a decision on whether a requester may perform an action.</summary>
<description>A rejected request returns its current reason; a permitted request has no meaningful rejection reason.</description>
*)

INTERFACE IActionPermissionProvider EXTENDS IObject]]></Declaration>
    <Method Name="RequestActionPermission" Id="{f812615f-fe7b-472c-83d6-4941a1e729d2}">
      <Declaration><![CDATA[(*!
<summary>Returns whether the requested action is permitted.</summary>
<description>
An ordinary rejection returns FALSE. Exceptions raised while evaluating permission propagate to the caller;
they must not be converted into an ordinary rejection. No decision or rejection reason is guaranteed on an exception.
The decision is completed within this call; no continuation in later PLC cycles is required.
Input references and the reason buffer are borrowed only for the duration of the call.
Implementations must not retain them for use after returning. No ownership is transferred.
actionDescriptor and requestingObject must be non-null references to live objects.
Defensive null handling in an implementation does not make null arguments valid under this contract.
On FALSE, supplies the current rejection reason in rejectReason.
On TRUE, rejectReason is unspecified and need not be cleared; callers must ignore it.
</description>
*)

//!<param name="rejectReason">Receives the current reason on rejection; meaningful only when the result is FALSE.</param>
METHOD RequestActionPermission : BOOL
VAR_INPUT
	actionDescriptor : INamed;
	requestingObject : IObject;
END_VAR
VAR_IN_OUT
	rejectReason : WSTRING(255);
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
