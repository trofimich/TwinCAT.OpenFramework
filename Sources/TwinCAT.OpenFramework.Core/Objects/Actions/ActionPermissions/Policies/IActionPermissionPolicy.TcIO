<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IActionPermissionPolicy" Id="{44cadb8e-8c26-4fde-9b6f-11f06f99d24b}">
    <Declaration><![CDATA[(*
