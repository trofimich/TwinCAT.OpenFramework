(*!
<summary>Base object equality, hashing and metadata; dynamic instances are not automatically registered here.</summary>
<description>
ReferenceEquals provides final instance-identity comparison, without comparing contents.
Equals and GetHashCode default to instance identity and may be overridden together for value semantics.
Equal objects must have equal hashes; hash collisions do not imply equality.
The base methods allocate no memory and retain no references or cached hashes.
Descendants provide class and namespace names that remain unchanged throughout the instance lifetime.
</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'}
FUNCTION_BLOCK ABSTRACT Object IMPLEMENTS IObject]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{f442a49f-4b06-4aa2-85a7-5f5794dfab20}" />
    <Property Name="ClassName" Id="{93bace28-41b5-44d6-b854-9ee3edbd382f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{64b538df-f61f-4f5f-95f8-f82623c92e0a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Equals" Id="{ce3346d2-996b-483d-81c5-4a1af24f9bef}">
      <Declaration><![CDATA[(*!
<summary>Compares objects by instance identity unless a descendant defines value equality.</summary>
<description>
The base implementation delegates to ReferenceEquals, returns FALSE for null and does not raise exceptions.
Overrides must preserve reflexivity, symmetry and transitivity for supported live objects,
return FALSE for null or an incompatible object, and provide a matching GetHashCode implementation.
Equals determines equality; GetHashCode only helps a hash index select candidates for comparison.
Direct equality comparison does not require computing a hash.
Neither operand may be modified. Arguments remain borrowed; equality neither transfers ownership
nor validates lifetime. An override's exceptions propagate to the caller.
</description>
*)
//!<param name="other">Borrowed live object to compare, or zero.</param>
METHOD Equals : BOOL
VAR_INPUT
	other : IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Equals := ReferenceEquals(other);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{2d9f8d8d-3924-4b67-aafc-98d5a0623fe6}">
      <Declaration><![CDATA[(*!
<summary>FB_exit implementations in this hierarchy must complete without raising exceptions.</summary>
<description>
During DynamicMemoryManager cleanup, do not register auto-disposed objects or reenter cleanup.
Releasing resources owned by this instance remains allowed.
The empty base hook is retained for deletion through an Object pointer.
</description>
*)

//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDefaultName" Id="{3ae22fad-cdcc-4ba8-a264-9144f84c2553}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Builds a diagnostic name from the class name and instance address.</summary>
<description>Returns a bounded WSTRING value. The address is formatted as hexadecimal; the name is diagnostic text, not a persistent identifier.</description>
*)
METHOD PROTECTED FINAL GetDefaultName : WSTRING]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetDefaultName := TO_WSTRING(Strings.Concat255(ClassName, ' (0x', Tc2_Utilities.LWORD_TO_HEXSTR(TO_LWORD(THIS), 16, FALSE), ')'));]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetFullTypeName" Id="{12715793-7a00-41cb-b821-dee214b1871f}">
      <Declaration><![CDATA[(*!
<summary>Returns NamespaceName + '.' + ClassName, limited by the return string capacity.</summary>
*)

METHOD FINAL GetFullTypeName : STRING]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetFullTypeName := Strings.Concat255(NamespaceName, '.', ClassName);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHashCode" Id="{7b02717b-e80f-49fb-9b38-995ef4418223}">
      <Declaration><![CDATA[(*!
<summary>Produces an address-based hash matching the default instance equality.</summary>
<description>
Folds the instance address into a UDINT without allocation, cached state or exceptions.
The address is used because the base Equals compares instance identity, not object contents.
Hash indices use this result to select candidates and must resolve collisions with Equals;
equal hashes alone never establish equality. Computing a hash without an index does not accelerate lookup.
The result remains stable while the instance address is unchanged; relocation requires rebuilding
any index that uses this hash. This is not a persistent identifier and collisions are allowed.
Descendants that redefine Equals must provide hashes equal for all objects that compare equal.
For value equality, compute the hash from data consistent with that equality instead of retaining
the inherited address-based hash. For example, equality by Motor.Id requires equal Id values
to produce equal hashes even when the objects occupy different addresses.
Hashing must not modify the object. Equality-relevant state and hash results must remain stable
while the object is used as a hashed key. An override's exceptions propagate to the caller.
</description>
*)
METHOD GetHashCode : UDINT
VAR
	addressBits : LWORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[addressBits := TO_LWORD(THIS);

GetHashCode := TO_UDINT((addressBits XOR SHR(addressBits, SIZEOF(DWORD) * 8)) AND TO_LWORD(UnsignedInt32.MAX_VALUE));]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetName" Id="{257730f6-dd97-4461-8e3a-d2666d17bc44}">
      <Declaration><![CDATA[(*!
<summary>Uses INamed.Name when supported; otherwise returns ClassName and the instance address.</summary>
*)

METHOD GetName : WSTRING
VAR
	named : INamed;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __QUERYINTERFACE(THIS^, named) THEN
	GetName := named.Name;
ELSE
	GetName := GetDefaultName();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsDynamicInstance" Id="{24998a7a-78a1-4ed7-9b02-1f1a03f8b719}">
      <Declaration><![CDATA[(*!
<summary>Reports whether this instance address belongs to dynamic memory.</summary>
<description>Memory-area classification does not transfer ownership or establish whether an arbitrary pointer still refers to a live object.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL IsDynamicInstance : BOOL]]></Declaration>
      <Get Name="Get" Id="{13a65fb5-a1f5-4c18-8711-a901f8b8c50f}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsDynamicInstance := Memory.IsDynamicData(THIS, 1);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c3b0678c-30f0-404d-91d4-2a5aabe2e5cc}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete namespace name without copying its storage.</summary>
<description>
Descendants must keep the value unchanged and its storage valid throughout the instance lifetime.
Callers may only read the returned reference; it does not transfer ownership.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{816ff93c-7d0c-4e8e-8788-09a43eca472a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReferenceEquals" Id="{c147fb9a-ab41-452b-8012-567d8446205b}">
      <Declaration><![CDATA[(*!
<summary>Compares instance addresses; object contents do not participate in the comparison.</summary>
<description>
Returns FALSE for a null argument or failed pointer conversion.
A non-null argument must refer to a live instance. This method does not validate lifetime
or transfer ownership. Descendants cannot override this identity comparison.
</description>
*)

{attribute "object_name" := "ReferenceEquals"}
METHOD FINAL ReferenceEquals : BOOL
VAR_INPUT 
	object : IObject;
END_VAR
VAR
	selfPointer : POINTER TO Object;
	comparingPointer : POINTER TO Object;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReferenceEquals := FALSE;

IF object = 0 THEN
	RETURN;
END_IF

selfPointer := THIS;

IF __QUERYPOINTER(object, comparingPointer) THEN
	ReferenceEquals := selfPointer = comparingPointer;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfAddress" Id="{fb693a32-9773-4047-aa8f-22abdeeaa290}">
      <Declaration><![CDATA[(*!
<summary>Returns the address of this object instance.</summary>
<description>Borrowed pointer valid only while the object remains alive. The result does not transfer ownership or validate other aliases.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL SelfAddress : POINTER TO Object]]></Declaration>
      <Get Name="Get" Id="{9f8bbfa3-aa5e-447f-898b-426110e9c9ed}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfAddress := THIS;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e1435e8d-7dee-46fb-af88-e0c12efed32f}">
      <Declaration><![CDATA[(*!
<summary>Concrete descendants provide XSIZEOF(THIS^) for their own complete instance layout.</summary>
*)

{attribute 'monitoring' := 'call'}

PROPERTY ABSTRACT SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6e225585-3ad3-46c5-8df1-c249905d905a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>