(*!
<summary>Provides object identity comparison and a diagnostic interface-reference probe.</summary>
<description>
Identity comparison requires live non-null arguments. ProbeObjectReference only reports
the outcome of an interface query; it does not establish object lifetime.
Neither operation transfers ownership.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM Objects
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{ccf59170-02d7-4aa1-96f1-9c1217d7da66}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4c0779b6-026c-486e-95fd-b3ce93d2e044}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0a52a1e4-a33a-4a08-aac5-cea5a934d64c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cd3d301f-ab11-4b43-bf62-b16c7ad4f30a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ProbeObjectReference" Id="{9cd63bf4-5710-46da-b4e0-bce259e3cb5a}">
      <Declaration><![CDATA[(*!
<summary>Attempts to query IObject from a reference for diagnostic purposes.</summary>
<description>
Returns FALSE for null, a failed query, a null query result or a caught exception.
TRUE means only that the query succeeded and returned a non-null interface at that moment.
It does not prove that the original object is still alive or that later access is safe.
Arbitrary memory corruption is not guaranteed to be caught. This probe does not replace
ownership and lifetime rules and does not transfer ownership or retain the object.
</description>
*)

//!<param name="object">Interface reference to probe.</param>

METHOD ProbeObjectReference : BOOL
VAR_INPUT
	object : IObject;
END_VAR
VAR
	testObject : IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF object = 0 THEN
	RETURN;
END_IF

__TRY
	ProbeObjectReference := __QUERYINTERFACE(object, testObject) AND_THEN testObject <> 0;
__CATCH
	ProbeObjectReference := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReferencesEquals" Id="{6442b106-029f-4bde-8beb-97c457a6f31c}">
      <Declaration><![CDATA[(*!
<summary>Compares two object references by instance identity, without comparing contents.</summary>
<description>
Two null references are equal; exactly one null reference is not equal.
For non-null references, returns TRUE only when both pointer conversions succeed
and identify the same live instance. Does not call instance comparison methods.
</description>
*)

METHOD ReferencesEquals : BOOL
VAR_INPUT
	object1 : IObject;
	object2 : IObject;
END_VAR
VAR
	object1Pointer : POINTER TO Object;
	object2Pointer : POINTER TO Object;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF object1 = 0 THEN
	ReferencesEquals := object2 = 0;
	RETURN;
END_IF

IF object2 = 0 THEN
	RETURN;
END_IF

IF __QUERYPOINTER(object1, object1Pointer) AND_THEN __QUERYPOINTER(object2, object2Pointer) THEN
	ReferencesEquals := object1Pointer = object2Pointer;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>