<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IBroadcastEventDispatcher" Id="{3c2e41b3-2c0f-4ab2-a3aa-8f779a07679b}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides synchronous event propagation toward descendants.</summary>
<description>Events are borrowed during delivery, without ownership transfer or retention for later use.</description>
*)

INTERFACE IBroadcastEventDispatcher EXTENDS IObject]]></Declaration>
    <Method Name="BroadcastEvent" Id="{2bc6e69f-93ee-4d27-8fe9-548c0b33dd7e}">
      <Declaration><![CDATA[(*!
<summary>Propagates an event toward descendants within this call.</summary>
<description>
The event argument must be non-null and refer to a live event.
Delivery is synchronous; it is not queued for later PLC cycles.
An exception from a recipient aborts delivery and propagates to the caller.
Effects of recipients already invoked are not rolled back; remaining recipients are not visited.
The caller keeps the event alive throughout delivery. Dispatchers and recipients must not retain
event references for later use or take ownership. The instance represents the same occurrence for all recipients.
</description>
*)

METHOD BroadcastEvent
VAR_INPUT
	event : IEvent;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
