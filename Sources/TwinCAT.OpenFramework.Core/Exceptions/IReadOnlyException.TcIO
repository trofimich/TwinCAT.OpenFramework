<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IReadOnlyException" Id="{0960a3b1-66e4-4832-b86b-c54f200851be}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Diagnostic view of a live exception, not an immutable snapshot or an ownership transfer.</summary>
<description>
Source references borrow the instance's storage for reading without copying; callers must not modify the referenced strings.
ST does not enforce this read-only restriction. GetRootException returns a borrowed read-only view.
Clone lifetime/ownership must be defined by its implementation; framework exceptions are auto-disposed.
</description>
*)

INTERFACE IReadOnlyException EXTENDS IObject, ICloneable]]></Declaration>
    <Property Name="Empty" Id="{dc349d0e-ed71-4590-9357-ddf4fc9e5284}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the concrete exception contains an error.</summary>
<description>Concrete implementations define emptiness. Inspection must not change exception state.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{58813a44-4e7d-46b4-afb1-f45156ef239e}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="GetMessage" Id="{57f6bf0c-c856-4c4f-af68-ef32c780c8e8}">
      <Declaration><![CDATA[(*!
<summary>Formats the exception as bounded diagnostic text.</summary>
<description>Returns an independent ERROR_MESSAGE. showSource requests available source information; timestampDisplayMode selects a stored timestamp or hides it. Concrete exception types define their message composition; unavailable native throw-source information cannot be reconstructed.</description>
*)
METHOD ABSTRACT GetMessage : ERROR_MESSAGE
VAR_INPUT
	showSource : BOOL := FALSE;
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetRootException" Id="{4c53402b-fc14-4c87-ab09-efd2121d28c8}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the root exception.</summary>
<description>No clone is created and ownership is not transferred. The view does not extend the exception's lifetime and does not expose Clear.</description>
*)

METHOD GetRootException : IReadOnlyException]]></Declaration>
    </Method>
    <Method Name="GetSourceDescription" Id="{1537398c-d7b2-4d83-991f-4e3ae3934036}">
      <Declaration><![CDATA[(*!
<summary>Formats the available exception source description.</summary>
<description>Returns an independent bounded string. Native exceptions without original throw-site information return the unspecified-source marker; catch-point information is not an original throw site.</description>
*)
METHOD GetSourceDescription : STRING(255)]]></Declaration>
    </Method>
    <Property Name="LocalTimestamp" Id="{f12a212e-6ed7-4d5f-aea8-8cbb80d844be}">
      <Declaration><![CDATA[(*!
<summary>Provides the stored local timestamp of this exception.</summary>
<description>Framework exceptions capture it when thrown; native exceptions capture it when GetLastException obtains their description. Cloning preserves the timestamp; reading it does not read the current clock.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY LocalTimestamp : LDATE_AND_TIME]]></Declaration>
      <Get Name="Get" Id="{6225f5cc-2e24-47c1-a5a6-51383713afa8}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="SourceFullPOUName" Id="{ef861e65-244f-41ed-9189-8594787e37d3}">
      <Declaration><![CDATA[(*!
<summary>Provides the source POU name for reading without copying.</summary>
<description>
The reference borrows storage from the live exception and must not outlive it.
Callers must not modify the referenced string; ST does not enforce this restriction.
This is a live view, not a snapshot: changes to the exception can change the observed value.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourceFullPOUName : REFERENCE TO STRING(128)]]></Declaration>
      <Get Name="Get" Id="{c5174c93-4702-4ccb-a64c-648221a53607}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="SourcePosition" Id="{477cc2aa-1516-49dc-8403-aaf9c492905f}">
      <Declaration><![CDATA[(*!
<summary>Provides the source position for reading without copying.</summary>
<description>
The reference borrows storage from the live exception and must not outlive it.
Callers must not modify the referenced string; ST does not enforce this restriction.
This is a live view, not a snapshot: changes to the exception can change the observed value.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourcePosition : REFERENCE TO STRING(32)]]></Declaration>
      <Get Name="Get" Id="{46d0cdba-9c76-4f07-bed9-ed483246787c}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="ToError" Id="{93c883c0-0eea-4b24-bb87-4c3c2e4f5928}">
      <Declaration><![CDATA[(*!
<summary>Copies this exception into persistent error-state storage.</summary>
<description>Updates the supplied ERROR using the requested severity and the concrete exception conversion rules. The target owns its copied diagnostic state; no exception ownership is transferred or retained by this operation.</description>
*)
METHOD ToError
VAR_IN_OUT CONSTANT
	targetError : ERROR;
END_VAR
VAR_INPUT
	severity : ERROR_SEVERITY;	
END_VAR]]></Declaration>
    </Method>
    <Property Name="UtcTimestamp" Id="{b453a4df-c330-47e7-ace2-47dc0db79d04}">
      <Declaration><![CDATA[(*!
<summary>Provides the stored UTC timestamp of this exception.</summary>
<description>Framework exceptions capture it when thrown; native exceptions capture it when GetLastException obtains their description. Cloning preserves the timestamp; reading it does not read the current clock.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY UtcTimestamp : LDATE_AND_TIME]]></Declaration>
      <Get Name="Get" Id="{bb25a2a6-105e-4c48-bc80-b2fe7f0da615}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>