	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	targetVariableName : STRING;
	targetVariableSize : ULINT;
END_VAR
VAR
	exception : TargetVariableMemoryOverflowException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, targetVariableName, targetVariableSize);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ThrowTimeout" Id="{21f1c116-7401-4a01-9801-a01b02c03d16}">
      <Declaration><![CDATA[(*!
<summary>Raises a TimeoutException without requiring a caller-owned exception variable.</summary>
<description>Call in the owning cyclic task, not during FB_init. Constructs a temporary stack template and delegates to TimeoutException.Throw, which formats the diagnostic without heap allocation during message preparation and propagates a task-owned clone through ExceptionManager.</description>
<param name="timeoutValue">Configured timeout limit reported by the caller.</param>
<param name="operationName">Optional operation name; an empty name produces a generic timeout message.</param>
*)
METHOD ThrowTimeout
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	timeoutValue : TIME;
	operationName : WSTRING := "";
END_VAR
VAR
	exception : TimeoutException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, timeoutValue, operationName);]]></ST>
      </Implementation>
    </Method>
