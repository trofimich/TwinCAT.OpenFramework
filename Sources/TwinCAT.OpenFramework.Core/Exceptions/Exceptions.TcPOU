    <Method Name="ThrowStringOverflow" Id="{21f1c114-7401-4a01-9801-a01b02c03d14}">
      <Declaration><![CDATA[(*!
<summary>Raises a StringOverflowException without requiring a caller-owned exception variable.</summary>
<description>Call in the owning cyclic task, not during FB_init. Constructs a temporary stack template and delegates to StringOverflowException.Throw, which formats the diagnostic without heap allocation during message preparation and propagates a task-owned clone through ExceptionManager.</description>
<param name="actualLength">Actual string length in characters.</param>
<param name="maxLength">Allowed string length in characters.</param>
*)
METHOD ThrowStringOverflow
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	stringName : STRING;
	actualLength : UDINT;
	maxLength : UDINT;
END_VAR
VAR
	exception : StringOverflowException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception.Throw(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, stringName, actualLength, maxLength);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ThrowTargetVariableMemoryOverflow" Id="{21f1c115-7401-4a01-9801-a01b02c03d15}">
      <Declaration><![CDATA[(*!
<summary>Raises a TargetVariableMemoryOverflowException without requiring a caller-owned exception variable.</summary>
<description>Call in the owning cyclic task, not during FB_init. Constructs a temporary stack template and delegates to TargetVariableMemoryOverflowException.Throw, which formats the diagnostic without heap allocation during message preparation and propagates a task-owned clone through ExceptionManager.</description>
<param name="targetVariableName">Destination name used in the diagnostic.</param>
<param name="targetVariableSize">Available destination storage in bytes, including string terminator storage where applicable.</param>
*)
METHOD ThrowTargetVariableMemoryOverflow
