<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IExceptionHandlingPolicy" Id="{d50dbbea-981a-44d1-80f2-547a2b018dd7}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Selects the caller's reaction to a caught exception.</summary>
<description>Implementations must complete HandleException without raising exceptions. The caller applies the returned reaction; selecting IGNORE does not suppress Automation logging.</description>
*)
INTERFACE IExceptionHandlingPolicy EXTENDS IObject]]></Declaration>
    <Method Name="HandleException" Id="{4d297766-4165-4ad2-b0ec-d1c1753b7530}">
      <Declaration><![CDATA[(*!
<summary>Chooses a reaction using the exception and the failed operation's context.</summary>
<description>Only analyzes the supplied context and returns a reaction. Must not raise exceptions or initiate nested exception handling, including indirectly through called code. In particular, must not call ExceptionManager.GetLastException for another error, which could overwrite the supplied system wrapper. The exception is read-only and remains subject to its task-local cycle lifetime.</description>
<param name="exception">Exception to classify.</param>
<param name="handlingObject">Object requesting the handling decision.</param>
<param name="failedMethodName">Name of the failed operation.</param>
*)
METHOD HandleException : EXCEPTION_REACTION
VAR_INPUT
	exception : IReadOnlyException;
	handlingObject : IObject;
END_VAR
VAR_IN_OUT CONSTANT
	failedMethodName : STRING(255);
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>