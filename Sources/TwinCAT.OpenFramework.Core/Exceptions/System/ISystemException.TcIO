<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ISystemException" Id="{7870ea65-b79e-4a5f-a0cf-37b06b88ed45}">
    <Declaration><![CDATA[(*
