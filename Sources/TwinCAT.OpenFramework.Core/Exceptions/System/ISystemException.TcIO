(*!
<summary>Exposes the captured native exception code alongside the common exception diagnostics.</summary>
<description>
The code identifies the captured native error, not the framework transport code used for propagation.
Obtaining this interface does not transfer ownership or extend the exception's lifetime.
</description>
*)

INTERFACE ISystemException EXTENDS IException
]]></Declaration>
    <Property Name="ExceptionCode" Id="{15970fe0-8365-4901-b4a4-73314108321e}">
      <Declaration><![CDATA[(*!
<summary>Returns the captured native exception code.</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY ExceptionCode : __SYSTEM.ExceptionCode]]></Declaration>
      <Get Name="Get" Id="{5aed6761-fded-45fb-a3b9-33b86ea1a435}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>