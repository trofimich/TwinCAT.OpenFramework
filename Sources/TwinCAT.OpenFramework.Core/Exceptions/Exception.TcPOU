(*!
<summary>Provides shared exception metadata and formatting for task-owned clones.</summary>
<description>
Registered dynamic descendants are owned by DynamicMemoryManager until cleanup; static instances remain caller-owned. Clone overrides must register each new instance through DynamicMemoryManager.RegisterAutoDisposedObject after __NEW and before copying fields. Plain __NEW does not register an instance.
Each dynamic exception belongs to the cyclic PLC task that created it; do not pass exception objects between tasks.
Do not throw or create dynamic exceptions during application FB_init. Static templates remain supported.
Clone implementations must return an IException-compatible object; clients borrow registered clones.
GetRootException returns a borrowed read-only view without extending its lifetime.
SourceFullPOUName and SourcePosition expose borrowed storage for reading only; callers must not modify it.
Source names formatted by GetFullPOUName are truncated to 128 characters without raising a formatting overflow exception.
</description>
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 


FUNCTION_BLOCK ABSTRACT Exception EXTENDS Object IMPLEMENTS IException
VAR
	_SourceFullPOUName : STRING(128);
	_SourcePosition : STRING(32);
	_LocalTimestamp : LDATE_AND_TIME;	
	_UtcTimestamp : LDATE_AND_TIME;	
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{a47a20ca-4953-4e09-8f4d-fc2e8d3ac96e}" />
    <Method Name="AppendTimestampDescription" Id="{a316d3b4-0094-41d5-a4cb-9fba6e2a6883}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends the selected timestamp to an existing diagnostic builder.</summary>
<description>Hidden mode leaves the builder unchanged; otherwise appends the supplied local or UTC timestamp, with a UTC suffix for UTC mode. Does not clear existing text. Buffer growth follows the builder allocation-failure contract. Descendants cannot replace this shared metadata formatter; custom diagnostic payload formatting belongs in GetMessage or ToError.</description>
*)
METHOD PROTECTED FINAL AppendTimestampDescription
VAR_IN_OUT CONSTANT
	stringBuilder : WideStringBuilder;
END_VAR
VAR_INPUT
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
	localTimestamp : LDATE_AND_TIME;	
	utcTimestamp : LDATE_AND_TIME;	
END_VAR
VAR
	timeStampString : WSTRING(40);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF timestampDisplayMode = TIMESTAMP_DISPLAY_MODE.HIDDEN THEN
	RETURN;
END_IF

CASE timestampDisplayMode OF
	TIMESTAMP_DISPLAY_MODE.LOCAL:
		timeStampString := TO_WSTRING(localTimestamp);
	
	TIMESTAMP_DISPLAY_MODE.UTC:
		timeStampString := TO_WSTRING(utcTimestamp);
END_CASE

timeStampString := Tc2_Standard.WLEFT(Tc2_Standard.WDELETE(timeStampString, 4, 1), 22);

stringBuilder.AppendString(timeStampString);
IF timestampDisplayMode = TIMESTAMP_DISPLAY_MODE.UTC THEN
	stringBuilder.AppendString("UTC");
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clear" Id="{44a047f7-46bd-418c-989f-4458402150ba}">
      <Declaration><![CDATA[(*!
<summary>Resets source and timestamps. Descendants clear their own payload and call this implementation.</summary>
<description>
Resets timestamps to LongDateAndTimes.EPOCH. Does not delete the instance or unregister it from automatic cleanup.
</description>
*)

METHOD Clear]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SourceFullPOUName := '';
_SourcePosition := '';
_LocalTimestamp := LongDateAndTimes.EPOCH;	
_UtcTimestamp := LongDateAndTimes.EPOCH;	]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clone" Id="{ff7ec3e0-b6aa-4a29-8b78-e576a86138cb}">
      <Declaration><![CDATA[(*!
<summary>Creates an independent task-managed exception snapshot.</summary>
<description>Concrete descendants allocate and register the clone with DynamicMemoryManager before copying its state. The manager owns the clone until task cleanup; callers borrow it and must not delete it. Allocation failure follows the terminal allocation-failure policy.</description>
*)
METHOD ABSTRACT Clone : IObject]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Empty" Id="{bd97cee3-a16c-4148-a36f-41860b6b4283}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the concrete exception contains an error.</summary>
<description>Concrete descendants define which stored fields make an exception nonempty. Reading does not clear or modify it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{32775313-ab40-46b6-a69f-434f332e1416}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExtractClassName" Id="{2741f852-3263-48be-9dbc-ba747f8558d6}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Extracts the first component yielded by splitting a POU name on dots.</summary>
<description>Returns a bounded independent string. Temporary splitter storage is released at method exit; fragment allocation follows the normal allocation-failure policy. Descendants cannot replace this shared metadata formatter; custom diagnostic payload formatting belongs in GetMessage or ToError.</description>
*)
METHOD PROTECTED FINAL ExtractClassName : STRING
VAR_IN_OUT CONSTANT
	sourcePOUName : STRING;
END_VAR
VAR
	splitter : StringSplittingEnumerator;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[splitter := Strings.CreateSplitter(sourcePOUName, '.', 0, TRUE, TRUE);

WHILE splitter.MoveNext() DO		
	ExtractClassName := splitter.CurrentEntry;
	
	RETURN;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExtractMethodName" Id="{be44e9a6-255a-48b7-a062-fbf15488833a}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Extracts the last component yielded by splitting a POU name on dots.</summary>
<description>Returns a bounded independent string. Temporary splitter storage is released at method exit; fragment allocation follows the normal allocation-failure policy. Descendants cannot replace this shared metadata formatter; custom diagnostic payload formatting belongs in GetMessage or ToError.</description>
*)
METHOD PROTECTED FINAL ExtractMethodName : STRING
VAR_IN_OUT CONSTANT
	sourcePOUName : STRING;
END_VAR
VAR
	splitter : StringSplittingEnumerator;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[splitter := Strings.CreateSplitter(sourcePOUName, '.', 0, TRUE, TRUE);

WHILE splitter.MoveNext() DO
	ExtractMethodName := splitter.CurrentEntry;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{11857425-e8b4-42f5-9cda-87a6242433d1}">
      <Declaration><![CDATA[(*!
<summary>Clears exception state during destruction.</summary>
<description>Calls Clear; descendant cleanup must not raise or create exceptions. Referenced exceptions follow their own ownership rules and must not be deleted merely because they are referenced.</description>
*)
//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetFullPOUName" Id="{55af960f-b27f-4389-9e6d-9c37bf31a838}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Formats the namespace, class and POU name for exception diagnostics.</summary>
<description>
With a class name, uses the last nonempty POU name segment as the method name and appends parentheses.
Returns the first 128 characters when the full name exceeds the result capacity; truncation does not raise an exception.
 Descendants cannot replace this shared metadata formatter; custom diagnostic payload formatting belongs in GetMessage or ToError.</description>
*)

METHOD PROTECTED FINAL GetFullPOUName : STRING(128)
VAR_IN_OUT CONSTANT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sourceNamespaceName <> Strings.Empty THEN
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, sourceNamespaceName), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, '.'), 128);
END_IF

IF sourceClassName <> Strings.Empty THEN
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, sourceClassName), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, '.'), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, ExtractMethodName(sourcePOUName)), 128);
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, '()'), 128);
ELSE
	GetFullPOUName := Tc2_Standard.LEFT(Tc2_Standard.CONCAT(GetFullPOUName, sourcePOUName), 128);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMessage" Id="{6f101456-9a5d-4c21-8b11-8b9151d71824}">
      <Declaration><![CDATA[(*!
<summary>Formats the exception as bounded diagnostic text.</summary>
<description>Returns an independent ERROR_MESSAGE. showSource requests available source information; timestampDisplayMode selects a stored timestamp or hides it. Concrete exception types define their message composition; unavailable native throw-source information cannot be reconstructed.</description>
*)
METHOD ABSTRACT GetMessage : ERROR_MESSAGE
VAR_INPUT
	showSource : BOOL := FALSE;
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetRootException" Id="{14eed042-28c1-47eb-a619-b182b2b0181c}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the root exception.</summary>
<description>No clone is created and ownership is not transferred. The view does not extend the exception's lifetime and does not expose Clear.</description>
*)

METHOD ABSTRACT GetRootException : IReadOnlyException]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSourceDescription" Id="{d08299fd-3dd9-413a-badd-9a2833bcb01e}">
      <Declaration><![CDATA[(*!
<summary>Formats the available exception source description.</summary>
<description>Returns an independent bounded string. Native exceptions without original throw-site information return the unspecified-source marker; catch-point information is not an original throw site. Descendants cannot replace this shared metadata formatter; custom diagnostic payload formatting belongs in GetMessage or ToError.</description>
*)
METHOD FINAL GetSourceDescription : STRING(255)
VAR
	stringBuilder : WideStringBuilder;
	
	result : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString255(TO_WSTRING(_SourceFullPOUName))
	.AppendStringIf(Exceptions.SOURCE_POSITION_PREFIX, sourcePosition <> '')
	.AppendString255If(TO_WSTRING(sourcePosition), sourcePosition <> '')
	.AssignToString(result);

GetSourceDescription := TO_STRING(result);]]></ST>
      </Implementation>
    </Method>
    <Property Name="LocalTimestamp" Id="{4c2d5866-231e-4105-a6bb-6c19851f1e45}">
      <Declaration><![CDATA[(*!
<summary>Provides the stored local timestamp of this exception.</summary>
<description>Framework exceptions capture it when thrown; native exceptions capture it when GetLastException obtains their description. Cloning preserves the timestamp; reading it does not read the current clock.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL LocalTimestamp : LDATE_AND_TIME]]></Declaration>
      <Get Name="Get" Id="{4cb9fd2f-3b41-4625-9c08-af3725cdee6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LocalTimestamp := _LocalTimestamp;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{45619644-007a-4d10-a49a-4bb8ab2228ac}">
        <Declaration><![CDATA[PROTECTED]]></Declaration>
        <Implementation>
          <ST><![CDATA[_LocalTimestamp := LocalTimestamp;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SourceFullPOUName" Id="{ce5ba086-21af-4254-a988-84dec5648bcb}">
      <Declaration><![CDATA[(*!
<summary>Provides the source POU name for reading without copying.</summary>
<description>
The reference borrows storage from the live exception and must not outlive it.
Callers must not modify the referenced string; ST does not enforce this restriction.
This is a live view, not a snapshot: changes to the exception can change the observed value.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourceFullPOUName : REFERENCE TO STRING(128)]]></Declaration>
      <Get Name="Get" Id="{8170787e-91f8-4271-bfce-a70e9b6f9137}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SourceFullPOUName REF= _SourceFullPOUName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SourcePosition" Id="{92080a7c-c630-4b10-82a8-4b95a8267619}">
      <Declaration><![CDATA[(*!
<summary>Provides the source position for reading without copying.</summary>
<description>
The reference borrows storage from the live exception and must not outlive it.
Callers must not modify the referenced string; ST does not enforce this restriction.
This is a live view, not a snapshot: changes to the exception can change the observed value.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL SourcePosition : REFERENCE TO STRING(32)]]></Declaration>
      <Get Name="Get" Id="{da2e3d95-43f0-4ba4-a676-8010643e418a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SourcePosition REF= _SourcePosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToError" Id="{8d25c83e-d9af-49a8-90c4-2ced5ac3b9ee}">
      <Declaration><![CDATA[(*!
<summary>Copies exception diagnostics and timestamps into an ERROR value.</summary>
<description>An invalid target reference is ignored. Otherwise fills both top and root descriptions from this exception using the supplied severity and stored timestamps. Formats the source and message once each and copies the same results into both descriptions. Formatting uses default source and timestamp display options. The target retains copied text, not an exception reference; formatting may follow the allocation-failure policy of the concrete formatter.</description>
*)
METHOD ToError
VAR_IN_OUT CONSTANT
	targetError : ERROR;
END_VAR
VAR_INPUT
	severity : ERROR_SEVERITY;	
END_VAR
VAR
	topSourceText : STRING(255);
	rootSourceText : STRING(255);
	topMessageText : ERROR_MESSAGE;
	rootMessageText : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(targetError) THEN
	RETURN;
END_IF

topSourceText := GetSourceDescription();
rootSourceText := topSourceText;
topMessageText := GetMessage();
rootMessageText := topMessageText;

targetError.Fill(
	severity,
	topSourceText,
	rootSourceText,
	topMessageText,
	rootMessageText,
	LocalTimestamp,
	UtcTimestamp
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="UtcTimestamp" Id="{6ae20a8f-f2b2-4c7c-96e2-30787aae9908}">
      <Declaration><![CDATA[(*!
<summary>Provides the stored UTC timestamp of this exception.</summary>
<description>Framework exceptions capture it when thrown; native exceptions capture it when GetLastException obtains their description. Cloning preserves the timestamp; reading it does not read the current clock.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL UtcTimestamp : LDATE_AND_TIME]]></Declaration>
      <Get Name="Get" Id="{68e22629-e573-41bd-b400-d1cb3c398e1f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[UtcTimestamp := _UtcTimestamp;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b2d25d91-e13d-48d8-a20e-cde8a5d29fe4}">
        <Declaration><![CDATA[PROTECTED]]></Declaration>
        <Implementation>
          <ST><![CDATA[_UtcTimestamp := UtcTimestamp;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>