(*!
<summary>Holds at most 255 flattened entries. Inner exception graphs must be acyclic.</summary>
<description>
Input graphs must already be acyclic, including graphs from custom implementations. AddInnerException rejects paths back to this instance before adding any entries, using a StandardException without an inner cause.
Stored entries and GetInnerException use read-only views; ownership remains with the task memory manager. Root lookup returns a borrowed read-only view of the first entry's root, or this instance when empty.
ToError copies the aggregate message and the first entry's deepest cause into one ERROR, using the aggregate timestamps and caller-supplied severity.
 Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 


FUNCTION_BLOCK AggregateException EXTENDS Exception IMPLEMENTS IAggregateException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	_InnerExceptions : POINTER TO IReadOnlyException;
	{attribute 'hide'} 
	_InnerExceptionCount : UINT;
END_VAR
VAR CONSTANT
	MAX_INNER_EXCEPTION_COUNT : UINT := 255;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{c31ba568-bfb3-4fae-ac77-198d7130e4aa}" />
    <Method Name="AddInnerException" Id="{bfce23ea-1373-4ba3-866d-7d8a69bbfdab}">
      <Declaration><![CDATA[(*!
<summary>Flattens aggregates; borrows dynamic inners and clones static inners for automatic cleanup.</summary>
<description>
Owns only the reference array. Accepts read-only causes; static inputs are cloned and dynamic inputs are borrowed without exposing Clear. Allocation failure uses the shared fatal memory latch.
The supplied graph must already be acyclic, including graphs from custom implementations. The entire input graph is searched before adding entries. A path back to this instance raises StandardException without changing this instance. Validation follows IGeneralException and IAggregateException edges; inputs must remain live and stable during traversal. Shared causes in separate branches are allowed. Null/empty aggregate inputs add nothing.
Exceeding 255 entries raises latched OUT_OF_MEMORY before preparing the next entry.
After graph validation, flattening is incremental: prior successful additions are not rolled back on allocation or cloning failure.
</description>
*)

METHOD AddInnerException
VAR_INPUT
	innerException : IReadOnlyException; 
END_VAR
VAR
	aggregateException : IAggregateException;
	i : DINT;
	
	newInnerExceptionArray : POINTER TO IReadOnlyException;
	preparedInnerException : IReadOnlyException;

	invalidInnerException : StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF innerException = 0 THEN
	RETURN;
END_IF

IF NOT Exceptions.CanAttachInnerException(THIS^, innerException) THEN
	invalidInnerException.Throw(
		sourceNamespaceName := CurrentNamespace.Name,
		sourceClassName := 'AggregateException',
		sourcePOUName := 'AddInnerException',
		sourcePosition := '',
		message := "Cannot attach an exception graph containing its prospective owner.");
END_IF

IF __QUERYINTERFACE(innerException, aggregateException) THEN
	FOR i := 0 TO TO_DINT(aggregateException.InnerExceptionCount) - 1 DO
		AddInnerException(aggregateException.GetInnerException(i));
	END_FOR
ELSE
	IF _InnerExceptionCount >= MAX_INNER_EXCEPTION_COUNT THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	// Prepare the inner before replacing any existing array storage.
	IF innerException.IsDynamicInstance THEN
		preparedInnerException := innerException;
	ELSE
		__QUERYINTERFACE(innerException.Clone(), preparedInnerException);
	END_IF

	newInnerExceptionArray := __NEW(POINTER TO IReadOnlyException, (_InnerExceptionCount + 1));
	IF newInnerExceptionArray = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF
		
	IF _InnerExceptionCount > 0 THEN
		Tc2_System.MEMCPY(newInnerExceptionArray, _InnerExceptions, TO_UDINT(XSIZEOF(POINTER TO IReadOnlyException) * _InnerExceptionCount));	
	
		__DELETE(_InnerExceptions);
	END_IF
		
	newInnerExceptionArray[_InnerExceptionCount] := preparedInnerException;
	
	_InnerExceptions := newInnerExceptionArray; 
	_InnerExceptionCount := _InnerExceptionCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{bd878664-be6a-49ac-98d9-c91ba460da65}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{998929b6-4b31-437f-a5e5-a39dd1d6dc61}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{e4a1b8c7-9686-4ca1-8667-c1a80c4453a6}">
      <Declaration><![CDATA[(*!
<summary>Releases the owned reference array and resets metadata; does not delete borrowed inners.</summary>
<description>
Resets the entry count, source and timestamps. Repeated Clear is allowed. Does not delete the exception instance or unregister it from task cleanup. Other aggregates and clones borrowing the same causes remain valid until their task cleanup. An attached dynamic cause must not be cleared through an alias.
</description>
*)

METHOD Clear]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _InnerExceptions <> 0 THEN
	__DELETE(_InnerExceptions);
END_IF

_InnerExceptionCount := 0;

SUPER^.Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clone" Id="{486d4ff9-908c-48b8-a667-acc4326b9c0c}">
      <Declaration><![CDATA[(*!
<summary>Returns a distinct auto-disposed aggregate with copied metadata and its own reference array.</summary>
<description>
Empty aggregates also produce a distinct empty clone. Copies source metadata and timestamps; entries retain their order and their prepared dynamic causes remain shared. The task memory manager owns the clone until cleanup; callers must not delete or adopt it. Clearing the source aggregate does not clear the clone or its causes. Allocation failure uses the shared terminal memory mechanism. Descendants with additional payload must override Clone to preserve that payload and their concrete type.
 Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)

METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO AggregateException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(AggregateException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopyFields" Id="{0584c9e4-cd70-4feb-b915-e7d77badfcc1}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Copies aggregate metadata and entries into a distinct empty destination.</summary>
<description>
Destination must be empty and distinct from source. This helper does not clear existing entries. Source and its causes must remain live during copying. Copies metadata and adds source entries using AddInnerException's ownership rules; does not transfer ownership or extend cause lifetime. Copying is incremental, without rollback on allocation or cloning failure.
</description>
*)

METHOD PROTECTED CopyFields
VAR_IN_OUT CONSTANT
	sourceException : AggregateException;	
END_VAR
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SourceFullPOUName := sourceException.SourceFullPOUName;
_SourcePosition := sourceException.SourcePosition;
_LocalTimestamp := sourceException.LocalTimestamp;	
_UtcTimestamp := sourceException.UtcTimestamp;	

FOR i := 0 TO TO_DINT(sourceException.InnerExceptionCount) - 1 DO
	AddInnerException(sourceException.GetInnerException(i));
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Empty" Id="{d2ade75f-e0d1-434c-8840-7186cc0e6f7a}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the aggregate has no entries.</summary>
<description>Equivalent to a zero immediate-entry count; does not inspect whether individual entries are empty.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{c0b1f376-6cae-43f3-86ac-6339a2e458c0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Empty := _InnerExceptionCount = 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{56b27e89-e503-4505-9d3d-a810a3015a78}">
      <Declaration><![CDATA[(*!
<summary>Clears the aggregate during destruction.</summary>
<description>Releases its own entry storage according to Clear. Referenced exception objects remain owned by their lifetime manager; cleanup must not raise exceptions.</description>
*)
//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetInnerException" Id="{208441ce-95c7-4cde-b727-858df1415649}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of an entry at a zero-based index.</summary>
<description>Returns null for an index outside the stored range. Does not clone or transfer ownership, and does not extend the entry lifetime beyond its task cleanup. The view is not an immutable snapshot; modifying an attached dynamic cause through another alias is forbidden. Descendants cannot replace this view of the stored aggregate entries; entry indexing and count refer to the same internal storage.</description>
<param name="index">Zero-based entry index.</param>
*)
METHOD FINAL GetInnerException : IReadOnlyException
VAR_INPUT
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index >= 0 AND_THEN index < _InnerExceptionCount THEN
	GetInnerException := _InnerExceptions[index];
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMessage" Id="{76c9ffdd-6b67-4a44-aa6c-571f736f1a93}">
      <Declaration><![CDATA[(*!
<summary>With default options an empty aggregate returns "0 aggregated exceptions".</summary>
<description>Formats entries in their stored order. If the result exceeds ERROR_MESSAGE capacity, preserves the prefix and ends with an ellipsis; later entries may be omitted. Copying the final message does not raise a size-overflow exception. Builder allocation failures remain terminal.</description>
*)

METHOD GetMessage : ERROR_MESSAGE
VAR_INPUT
	showSource : BOOL := FALSE;
	timestampDisplayMode : TIMESTAMP_DISPLAY_MODE := TIMESTAMP_DISPLAY_MODE.HIDDEN;
END_VAR
VAR
	stringBuilder : WideStringBuilder;
	
	i : DINT;
	innerException : IReadOnlyException;
	innerExceptionMessage : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.Append(_InnerExceptionCount)
	.AppendString(Exceptions.AGGREGATE_EXCEPTION_SUFFIX);

IF timestampDisplayMode <> TIMESTAMP_DISPLAY_MODE.HIDDEN THEN
	stringBuilder.AppendString(Exceptions.TIME_PREFIX);
	AppendTimestampDescription(stringBuilder, timestampDisplayMode, _LocalTimestamp, _UtcTimestamp);
END_IF

IF showSource THEN
	stringBuilder
		.AppendString(Exceptions.SOURCE_PREFIX)
		.AppendString255(TO_WSTRING(_SourceFullPOUName))
		.AppendStringIf(Exceptions.SOURCE_POSITION_PREFIX, sourcePosition <> '')
		.AppendString255If(TO_WSTRING(sourcePosition), sourcePosition <> '');
END_IF

FOR i := 0 TO TO_DINT(_InnerExceptionCount) - 1 DO
	innerException := _InnerExceptions[i];
	
	innerExceptionMessage := innerException.GetMessage(showSource, timestampDisplayMode);
	
	stringBuilder
		.AppendString255(WideStrings.NewLine)
		.Append(i)
		.AppendString(Exceptions.MESSAGE_NUMBER_SUFFIX)	
		.AppendString(" ")
		.Append(innerExceptionMessage);
END_FOR		

GetMessage := Exceptions.CopyMessage(stringBuilder);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetRootException" Id="{3947d49e-1dd5-493f-96aa-4bb6602d0186}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the root exception.</summary>
<description>No clone is created and ownership is not transferred. The view does not extend the exception's lifetime and does not expose Clear.</description>
*)

METHOD FINAL GetRootException : IReadOnlyException]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _InnerExceptionCount > 0 THEN
	GetRootException := GetInnerException(0);
	
	GetRootException := GetRootException.GetRootException();
ELSE
	GetRootException := THIS^;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="InnerExceptionCount" Id="{734e1c9b-9746-493a-8ce4-7a56d60ff952}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of immediate exceptions in the aggregate.</summary>
<description>Counts direct entries, not recursively nested causes. The aggregate supports at most 255 entries. Descendants cannot replace this view of the stored aggregate entries; entry indexing and count refer to the same internal storage.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL InnerExceptionCount : UINT]]></Declaration>
      <Get Name="Get" Id="{d38858e5-3bfc-4ef7-a005-fb8d5b223e97}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[InnerExceptionCount := _InnerExceptionCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{494a86d9-380f-42f2-920d-5159f570a5a6}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d3864769-88da-4cdf-9783-f994cd245ebc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{174b7a67-11f4-4a03-a1cf-384fffd912fd}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0f74268c-6818-41c3-9fc5-eec449ba75e8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{1b8b1f86-dba3-4290-8289-61d8dd5d28c8}">
      <Declaration><![CDATA[(*!
<summary>Throws a task-managed snapshot of the aggregate exception.</summary>
<description>Sets the supplied source metadata and current local and UTC timestamps, then delegates to ExceptionManager.Throw. The original aggregate remains caller-owned; the registered snapshot is valid only until task cleanup. Requires a cyclic task and follows the terminal allocation-failure policy.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SourceFullPOUName := GetFullPOUName(sourceNamespaceName, sourceClassName, sourcePOUName);
_SourcePosition := sourcePosition;
_LocalTimestamp := System.SystemLocalDateTime;
_UtcTimestamp := System.SystemUtcDateTime;

ExceptionManager.Throw(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToError" Id="{d4ff76fe-085d-4302-a17b-b20e40bfa8ce}">
      <Declaration><![CDATA[(*!
<summary>Copies aggregate diagnostics and the first branch's root cause into one ERROR.</summary>
<description>The overall message describes all entries within the GetMessage length limit. Root message and source come from GetRootException, following the first entry to its deepest cause. Uses this aggregate's timestamps and the supplied severity. Copies diagnostic values without transferring exception ownership. An empty aggregate produces an explicit empty-aggregate description and no root message. An invalid target reference is ignored. Computed diagnostic strings are held in local buffers for the duration of the receiving call.</description>
<param name="targetError">Destination whose diagnostic fields are replaced.</param>
<param name="severity">Severity assigned to the resulting ERROR.</param>
*)
METHOD ToError
VAR_IN_OUT CONSTANT
	targetError : ERROR;
END_VAR
VAR_INPUT
	severity : ERROR_SEVERITY;	
END_VAR
VAR
	topSourceText : STRING(255);
	rootSourceText : STRING(255);
	topMessageText : ERROR_MESSAGE;
	rootMessageText : ERROR_MESSAGE;

	rootException : IReadOnlyException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(targetError) THEN
	RETURN;
END_IF

IF _InnerExceptionCount <= 0 THEN
	topSourceText := GetSourceDescription();
	rootSourceText := Exceptions.UNSPECIFIED_SOURCE;

	targetError.Fill(
		severity,
		topSourceText,
		rootSourceText,
		"Empty aggregate exception (zero inner exceptions)",
		"",
		LocalTimestamp,
		UtcTimestamp
	);
	
	RETURN;
END_IF

rootException := GetRootException();

topSourceText := Strings.Concat255(TO_STRING(_InnerExceptionCount), ' exceptions occured');
rootSourceText := rootException.GetSourceDescription();
topMessageText := GetMessage();
rootMessageText := rootException.GetMessage();

targetError.Fill(
	severity,
	topSourceText,
	rootSourceText,
	topMessageText,
	rootMessageText,
	LocalTimestamp,
	UtcTimestamp
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>