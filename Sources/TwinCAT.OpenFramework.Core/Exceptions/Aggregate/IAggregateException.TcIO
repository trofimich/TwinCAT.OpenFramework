<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IAggregateException" Id="{b988b248-0471-4475-9d2a-afe0ffc9eec0}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides access to the exceptions grouped in an aggregate.</summary>
<description>Entry and root lookup provide borrowed read-only diagnostic views without transferring ownership or extending lifetime.</description>
*)
INTERFACE IAggregateException EXTENDS IException]]></Declaration>
    <Method Name="GetInnerException" Id="{2d916ec4-46b0-4973-8bf3-5e92184d2ef7}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of an entry at a zero-based index.</summary>
<description>Returns null for an index outside the stored range. Does not clone or transfer ownership, and does not extend the entry lifetime beyond its task cleanup. The view is not an immutable snapshot; modifying an attached dynamic cause through another alias is forbidden.</description>
<param name="index">Zero-based entry index.</param>
*)
METHOD GetInnerException : IReadOnlyException
VAR_INPUT
	index : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetRootException" Id="{05287103-fa2a-4150-b3ca-bf42a00677a5}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed read-only view of the root exception.</summary>
<description>No clone is created and ownership is not transferred. The view does not extend the exception's lifetime and does not expose Clear.</description>
*)

METHOD GetRootException : IReadOnlyException]]></Declaration>
    </Method>
    <Property Name="InnerExceptionCount" Id="{667bfa13-f04a-4a29-8276-1126128becce}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of immediate exceptions in the aggregate.</summary>
<description>Counts direct entries, not recursively nested causes. The aggregate supports at most 255 entries.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY InnerExceptionCount : UINT]]></Declaration>
      <Get Name="Get" Id="{730d4a93-a9ce-44b8-a0bd-f31516351203}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Throw" Id="{c37a3a93-2628-4dc7-9856-dab793c214a9}">
      <Declaration><![CDATA[(*!
<summary>Throws a task-managed snapshot of the aggregate exception.</summary>
<description>Sets the supplied source metadata and current local and UTC timestamps, then delegates to ExceptionManager.Throw. The original aggregate remains caller-owned; the registered snapshot is valid only until task cleanup. Requires a cyclic task and follows the terminal allocation-failure policy.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>