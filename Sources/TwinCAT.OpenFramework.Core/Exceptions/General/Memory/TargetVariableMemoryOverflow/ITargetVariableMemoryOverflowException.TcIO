<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITargetVariableMemoryOverflowException" Id="{39f9ecfc-89ca-4ccd-9c46-c14c94c08b7f}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports that destination storage cannot hold the requested result.</summary>
<description>The caller detects the condition; this exception does not inspect or modify the collection or destination. Uses the GeneralException task-local cycle lifetime and throw rules.</description>
*)
INTERFACE ITargetVariableMemoryOverflowException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{c2c590e2-59c3-4764-8971-347504c00428}">
      <Declaration><![CDATA[(*!
<summary>Builds the diagnostic and raises this exception through GeneralException.</summary>
<description>Copies the supplied diagnostic data, sets error code to zero and supplies no inner exception. Call only in a cyclic task, not during FB_init. The caller must already have detected the reported condition.</description>
<param name="targetVariableName">Destination name used in the diagnostic.</param>
<param name="targetVariableSize">Available destination storage in bytes, including string terminator storage where applicable.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	targetVariableName : STRING;
	targetVariableSize : ULINT;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>