<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TargetVariableMemoryOverflowException" Id="{a5c51537-9964-43b1-bc8c-6a2ce7304192}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports that destination storage cannot hold the requested result.</summary>
<description>The caller detects the condition; this exception does not inspect or modify the collection or destination. Uses the GeneralException task-local cycle lifetime and throw rules. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK TargetVariableMemoryOverflowException EXTENDS GeneralException IMPLEMENTS ITargetVariableMemoryOverflowException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{6face4de-0106-4653-8501-0739f37c18e9}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{30d770a2-ebf9-4246-aef6-3271c58673ee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{9ed41139-91ec-41da-8fa6-2f309f22fbed}">
      <Declaration><![CDATA[(*!
<summary>Creates a clone of this concrete exception type.</summary>
<description>Copies GeneralException fields and timestamps. The clone belongs to DynamicMemoryManager until cleanup of the creating task; callers must not delete it. Allocation failure is terminal. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO TargetVariableMemoryOverflowException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(TargetVariableMemoryOverflowException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{8f8de7c2-c18d-4fe8-b545-c99ae3e41e03}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f1c191f8-a27e-4544-9f9e-1a0a2920d846}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{2752ec58-dcee-4d7a-8f6b-d4e2f3b6d8fd}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e13fa4a6-88b7-4506-b77e-187869e9727d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{c8177a3a-3507-4fd9-82e5-01f82a5acc18}">
      <Declaration><![CDATA[(*!
<summary>Builds the diagnostic and raises this exception through GeneralException.</summary>
<description>Copies the supplied diagnostic data, sets error code to zero and supplies no inner exception. Call only in a cyclic task, not during FB_init. The caller must already have detected the reported condition.</description>
<param name="targetVariableName">Destination name used in the diagnostic.</param>
<param name="targetVariableSize">Available destination storage in bytes, including string terminator storage where applicable.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	targetVariableName : STRING;
	targetVariableSize : ULINT;
END_VAR
VAR
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString("Terget variable '")
	.Append(targetVariableName)
	.AppendString("' (size ")
	.Append(targetVariableSize)
	.AppendString(") memory overflow '")
	.AppendString255(TO_WSTRING(GetFullPOUName(sourceNamespaceName, sourceClassName, sourcePOUName)))
	.AppendString("'")
	.AssignToString(message);
	
stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>