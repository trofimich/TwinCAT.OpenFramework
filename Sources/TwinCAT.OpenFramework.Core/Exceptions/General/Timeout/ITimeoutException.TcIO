<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITimeoutException" Id="{ac6243fb-9a96-4392-a8e2-9c8ccc7744cc}">
    <Declaration><![CDATA[(*!
<summary>Reports that an operation exceeded its allowed duration.</summary>
<description>The caller measures elapsed time and detects the timeout. This exception only records the supplied limit and optional operation name. Uses the GeneralException task-local cycle lifetime and throw rules.</description>
*)
INTERFACE ITimeoutException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{f86ea1ff-ed67-4ee6-9653-f2452f2af1f0}">
      <Declaration><![CDATA[(*!
<summary>Builds the timeout diagnostic and raises this exception.</summary>
<description>Sets error code to zero and supplies no inner exception. Call only in cyclic task context, not during FB_init.</description>
<param name="timeoutValue">Configured timeout limit reported by the caller.</param>
<param name="operationName">Optional operation name; an empty name produces a generic timeout message.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	timeoutValue : TIME;
	operationName : WSTRING := "";
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>