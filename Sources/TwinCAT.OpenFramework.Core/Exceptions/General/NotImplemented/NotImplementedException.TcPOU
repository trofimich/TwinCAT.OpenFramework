<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="NotImplementedException" Id="{1ccd7350-1849-40d6-9094-e353155803cb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports a called program organization unit whose implementation is missing.</summary>
<description>Identifies the unimplemented POU using the supplied source coordinates. An intentionally unsupported operation should use NotSupportedException. Uses the GeneralException task-local cycle lifetime and throw rules. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK NotImplementedException EXTENDS GeneralException IMPLEMENTS INotImplementedException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{4162c068-edc3-4db0-87ba-9370c1e87c7d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{febb8b95-91e0-4dcc-ae78-175d6e07e655}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{476c496d-8e58-4ae2-86e1-c382b6674ea5}">
      <Declaration><![CDATA[(*!
<summary>Creates a clone of this concrete exception type.</summary>
<description>Copies GeneralException fields and timestamps. DynamicMemoryManager owns the clone until cleanup of the creating task; callers must not delete it. Allocation failure is terminal. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO NotImplementedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(NotImplementedException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{6c11632e-d82d-4994-890f-9b82b32f150c}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8f706d29-9d18-43ea-9374-a590b2c47058}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5e24e755-7189-4ed2-b2fb-1abb3bf4aa92}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{68785b39-69c1-49c6-995d-22372c5d65ff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{cda6bd96-c7c8-4470-b7b6-c1c0820414ca}">
      <Declaration><![CDATA[(*!
<summary>Builds a diagnostic naming the unimplemented POU and raises this exception.</summary>
<description>Sets error code to zero and supplies no inner exception. Call only in cyclic task context, not during FB_init.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR
VAR
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString("Program organization unit '")
	.AppendString255(TO_WSTRING(GetFullPouName(sourceNamespaceName, sourceClassName, sourcePOUName)))
	.AppendString("' is not implemented")
	.AssignToString(message);

stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>