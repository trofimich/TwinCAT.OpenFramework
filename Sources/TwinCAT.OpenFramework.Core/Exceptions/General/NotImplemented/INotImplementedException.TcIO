<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="INotImplementedException" Id="{82ef214a-ff5b-491c-aa31-e9e83ecf5ae0}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports a called program organization unit whose implementation is missing.</summary>
<description>Identifies the unimplemented POU using the supplied source coordinates. An intentionally unsupported operation should use NotSupportedException. Uses the GeneralException task-local cycle lifetime and throw rules.</description>
*)
INTERFACE INotImplementedException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{d757613e-8291-4880-b39b-e9cd3ad0af6f}">
      <Declaration><![CDATA[(*!
<summary>Builds a diagnostic naming the unimplemented POU and raises this exception.</summary>
<description>Sets error code to zero and supplies no inner exception. Call only in cyclic task context, not during FB_init.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>