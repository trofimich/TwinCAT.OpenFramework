<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ArgumentValueNotSupportedException" Id="{d8d21990-1e39-4f5f-aef8-b984d73d7d73}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports an argument value that the requested operation does not support.</summary>
<description>The caller determines that the argument is invalid; Throw formats the diagnostic rather than validating the argument. Argument values are represented in at most 255 characters. STRING and WSTRING values longer than 255 characters retain their first 254 characters followed by an ellipsis. Dynamic exceptions belong to the current task memory manager until cleanup. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)

{attribute 'enable_dynamic_creation'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ArgumentValueNotSupportedException EXTENDS GeneralException IMPLEMENTS IArgumentValueNotSupportedException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{76dbf709-fe3c-4ce6-9d63-0d897868c4b5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{efbe33b9-10e8-456d-ae33-7cab85f1a521}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{20198072-dc81-4b94-9e1d-36ffa4fce358}">
      <Declaration><![CDATA[(*!
<summary>Creates a task-owned copy of this exception and its diagnostic payload.</summary>
<description>Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence. The returned reference is borrowed until task cleanup and must not be deleted by the caller.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO ArgumentValueNotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(ArgumentValueNotSupportedException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{a6740570-5162-4827-bc79-025f8a2ecb02}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fe87ff78-40d0-4e9e-a3a2-b59c59fb2b57}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3b8409ec-d858-4ce2-b488-d0871e63d4e2}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c88d045c-ef25-4168-a3c5-ad6ea6909cbe}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{1c82cdaa-6e6a-4d9a-bfc8-2c6b6a993818}">
      <Declaration><![CDATA[(*!
<summary>Formats the rejected argument and propagates the exception with source metadata.</summary>
<description>Call in the owning cyclic task, not during FB_init. Reads the supplied value only during this call and retains its formatted text without heap allocation during message preparation. Long STRING and WSTRING values use a 254-character prefix followed by an ellipsis; exactly 255 characters are kept unchanged. Other types use the shared ANY formatter. Sets error code to zero and has no inner cause. Exception clone allocation failure uses the terminal memory mechanism.</description>
<param name="argumentName">Name of the argument rejected by the caller.</param>
<param name="argumentValue">Live value to describe; string inputs must be null-terminated.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	argumentName : STRING;
	argumentValue : ANY;
END_VAR
VAR
	valueAsString : WSTRING(255);
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueAsString := WideStrings.AnyToStringFit255(argumentValue);

WideStrings.Append255(
	message,
	"Argument '",
	TO_WSTRING(argumentName),
	"' has not supported value '",
	valueAsString,
	"' in '",
	TO_WSTRING(GetFullPOUName(sourceNamespaceName, sourceClassName, sourcePOUName)),
	"'");

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>