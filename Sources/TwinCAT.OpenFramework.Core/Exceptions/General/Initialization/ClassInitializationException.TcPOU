<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ClassInitializationException" Id="{0a5c6ed3-0943-4e2b-b9c2-078f741efefe}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports failed explicit initialization using caller-supplied diagnostic text.</summary>
<description>Uses the GeneralException lifetime and throw rules. The initialization diagnostic is copied from a WSTRING(255) input. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK ClassInitializationException EXTENDS GeneralException IMPLEMENTS IClassInitializationException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{12636e5b-2221-4a85-bd91-7b499f0ac28b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2eb1e1f0-4f52-49a0-8c3e-b09ef3f14922}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{204906c1-215c-489a-a9df-dc250c7d1d43}">
      <Declaration><![CDATA[(*!
<summary>Creates a clone of this concrete exception type.</summary>
<description>Copies GeneralException fields and timestamps. DynamicMemoryManager owns the clone until cleanup of the creating task; callers must not delete it. Allocation failure is terminal. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO ClassInitializationException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(ClassInitializationException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{71da4ddf-9af9-4ed1-8157-897e90c70575}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{36a22929-5a9b-4423-9f0a-70884145e502}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{0e31268a-a08e-4a21-aa02-2270e792bc63}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{2f737564-447f-4a03-a317-6f8f1b2dd47d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{c2a15894-6732-49a8-81a0-8cf739ba1b51}">
      <Declaration><![CDATA[(*!
<summary>Reports failed initialization of the specified class.</summary>
<description>Combines the class name with the diagnostic text and raises the exception. The errorMessage input is copied by value and limited to 255 characters.</description>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	errorMessage : WSTRING(255);
END_VAR
VAR
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString("Class '")
	.AppendString255(TO_WSTRING(sourceNamespaceName))
	.AppendString(".")
	.AppendString255(TO_WSTRING(sourceClassName))
	.AppendString("' was not correctly initialized: ")
	.AppendString(errorMessage)
	.AssignToString(message);
	
stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>