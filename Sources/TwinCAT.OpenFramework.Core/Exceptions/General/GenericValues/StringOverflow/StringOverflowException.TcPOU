<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringOverflowException" Id="{7ec3cdac-3c06-40f2-880b-67ef5d2595f7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports a string length exceeding the limit checked by the caller.</summary>
<description>The caller detects the error; this type records the supplied diagnostic values without performing the conversion or validation. Dynamic instances and clones belong to the current task memory manager until cleanup. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK StringOverflowException EXTENDS GeneralException IMPLEMENTS IStringOverflowException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{198994cc-e4d8-4aa2-864f-5c3c2ed7e773}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6a7d9ff6-8d86-4782-83e3-58984ad51829}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{e4c28858-f46f-41f8-851c-4d4ca88c6135}">
      <Declaration><![CDATA[(*!
<summary>Creates a distinct auto-disposed copy of this concrete exception type.</summary>
<description>Copies message, code, source and timestamps through CopyGeneralFields; any prepared inner cause remains borrowed. The current task memory manager owns the clone until cleanup. Allocation failure is terminal. Descendants with additional payload must override Clone to preserve their type and fields. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO StringOverflowException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(StringOverflowException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{130ed9e1-f170-457f-9307-f07159bc7630}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{08c7ccdc-6f6e-4d45-bd9f-2b1cdcecffa2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{43584c9d-3e16-495a-a9e9-3909fbcf6a15}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b6729f0f-e759-4ddc-bded-9db3f86e4f23}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{ea045181-c29a-4f53-bd8d-3e1bf72e89e9}">
      <Declaration><![CDATA[(*!
<summary>Formats the supplied failure details and propagates this exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Captures message, source and timestamps with zero error code and no inner cause. Input storage is not retained. Allocation failure uses the shared terminal memory mechanism.</description>
<param name="actualLength">Actual string length in characters.</param>
<param name="maxLength">Allowed string length in characters.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	stringName : STRING;
	actualLength : UDINT;
	maxLength : UDINT;
END_VAR
VAR
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString("String length ")
	.Append(actualLength)
	.AppendString(" for '")
	.Append(stringName)
	.AppendString("' exceeds allowed limit ")
	.Append(maxLength)
	.AssignToString(message);
	
stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>