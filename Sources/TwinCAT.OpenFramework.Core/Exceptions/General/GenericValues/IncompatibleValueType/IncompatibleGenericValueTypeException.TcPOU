<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IncompatibleGenericValueTypeException" Id="{2a5dc715-cd1f-4ce2-9327-4f5541bcad20}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports a generic value whose actual type class differs from the expected one.</summary>
<description>The caller detects the error; this type records the supplied diagnostic values without performing the conversion or validation. Dynamic instances and clones belong to the current task memory manager until cleanup. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)

{attribute 'enable_dynamic_creation'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK IncompatibleGenericValueTypeException EXTENDS GeneralException IMPLEMENTS IIncompatibleGenericValueTypeException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{353676d2-1bd8-45e6-91d5-5a630137fd11}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{430d8c9d-c77f-4c10-9dc0-96aace5b6428}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{6778c213-d491-4b4b-b229-58c5eb8d7674}">
      <Declaration><![CDATA[(*!
<summary>Creates a distinct auto-disposed copy of this concrete exception type.</summary>
<description>Copies message, code, source and timestamps through CopyGeneralFields; any prepared inner cause remains borrowed. The current task memory manager owns the clone until cleanup. Allocation failure is terminal. Descendants with additional payload must override Clone to preserve their type and fields. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO IncompatibleGenericValueTypeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(IncompatibleGenericValueTypeException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{228b706b-668c-442a-95e8-e6c2fa086056}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5cf344df-0854-4df6-9638-6bb48a70ae9d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{52cecd28-1342-4b70-8845-0ca8ea2d7d3b}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{2b135b7f-a6d0-4930-b56d-1c902b11bc21}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{0d46e1a8-dfed-4ff2-a5b3-567ae4ff478d}">
      <Declaration><![CDATA[(*!
<summary>Formats the supplied failure details and propagates this exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Captures message, source and timestamps without heap allocation during message preparation, with zero error code and no inner cause. Input storage is not retained. Exception clone allocation failure uses the shared terminal memory mechanism.</description>
<param name="actualTypeClass">Observed generic type class.</param>
<param name="expectedTypeClass">Required generic type class.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	validatedObjectName : WSTRING;
	actualTypeClass : GENERIC_TYPE_CLASS;
	expectedTypeClass : GENERIC_TYPE_CLASS;
END_VAR
VAR
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[message := "A value of an incorrect type was passed";

IF validatedObjectName <> "" THEN
	WideStrings.Append255(
		message,
		" to the '",
		validatedObjectName,
		"'");
END_IF

WideStrings.Append255(
	message,
	": actual type class is '",
	TO_WSTRING(actualTypeClass),
	"', expected type class is '",
	TO_WSTRING(expectedTypeClass),
	"'");

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>