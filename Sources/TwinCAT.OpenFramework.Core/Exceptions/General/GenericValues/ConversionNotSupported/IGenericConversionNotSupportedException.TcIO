<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IGenericConversionNotSupportedException" Id="{67a2a108-d3bc-4b19-a1e1-b16c2025427d}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reports a conversion between generic type classes that the caller does not support.</summary>
<description>The caller detects the error; this type records the supplied diagnostic values without performing the conversion or validation. Dynamic instances and clones belong to the current task memory manager until cleanup.</description>
*)
INTERFACE IGenericConversionNotSupportedException EXTENDS IGeneralException
]]></Declaration>
    <Method Name="Throw" Id="{4d375bbc-f9a2-4054-a53e-6b0ca0ca138f}">
      <Declaration><![CDATA[(*!
<summary>Formats the supplied failure details and propagates this exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Captures message, source and timestamps with zero error code and no inner cause. Input storage is not retained. Allocation failure uses the shared terminal memory mechanism.</description>
<param name="sourceDataType">Source generic type class.</param>
<param name="targetDataType">Requested destination generic type class.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	sourceDataType : GENERIC_TYPE_CLASS;
	targetDataType : GENERIC_TYPE_CLASS;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>