<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericConversionNotSupportedException" Id="{e44deaaf-b4cd-4663-ba2a-ae13f98e6399}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'enable_dynamic_creation'}	
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
(*!
<summary>Reports a conversion between generic type classes that the caller does not support.</summary>
<description>The caller detects the error; this type records the supplied diagnostic values without performing the conversion or validation. Dynamic instances and clones belong to the current task memory manager until cleanup. Dynamic copies are explicitly registered by Clone after construction; plain __NEW does not transfer ownership to the task manager.</description>
*)
FUNCTION_BLOCK GenericConversionNotSupportedException EXTENDS GeneralException IMPLEMENTS IGenericConversionNotSupportedException
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{efce17e5-18d7-49cc-b942-ee38809eb1c9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a2856dc0-811e-49cf-901c-5dd4705d623a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{8cd166b3-ec3f-4eee-b711-2f722b225d6b}">
      <Declaration><![CDATA[(*!
<summary>Creates a distinct auto-disposed copy of this concrete exception type.</summary>
<description>Copies message, code, source and timestamps through CopyGeneralFields; any prepared inner cause remains borrowed. The current task memory manager owns the clone until cleanup. Allocation failure is terminal. Descendants with additional payload must override Clone to preserve their type and fields. Registers the newly constructed instance before copying payload, outside FB_init. Registration failure releases the unregistered instance and raises a terminal error; copy failure leaves the registered instance owned by the task manager for cleanup. Custom overrides must follow the same ownership sequence.</description>
*)
METHOD Clone : IObject
VAR
	exceptionClone : POINTER TO GenericConversionNotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exceptionClone := __NEW(GenericConversionNotSupportedException);

IF exceptionClone = 0 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

DynamicMemoryManager.RegisterAutoDisposedObject(exceptionClone^);

exceptionClone^.CopyGeneralFields(THIS^);

Clone := exceptionClone^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{40d9f937-7af3-4e76-8fb1-b7e1db2126e1}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ae461813-a7b3-4dd0-b312-2795b4bcb283}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{56727982-a3d3-474f-9c2e-6b1887ebbb2a}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f69cf91c-0297-49b2-8571-499bd323df47}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Throw" Id="{62e4f95c-658a-45fb-af2f-c1637d23caa0}">
      <Declaration><![CDATA[(*!
<summary>Formats the supplied failure details and propagates this exception.</summary>
<description>Call in the owning cyclic task, not during FB_init. Captures message, source and timestamps with zero error code and no inner cause. Input storage is not retained. Allocation failure uses the shared terminal memory mechanism.</description>
<param name="sourceDataType">Source generic type class.</param>
<param name="targetDataType">Requested destination generic type class.</param>
*)
METHOD Throw
VAR_INPUT
	sourceNamespaceName : STRING;
	sourceClassName : STRING;
	sourcePOUName : STRING;
	sourcePosition : STRING;
	sourceDataType : GENERIC_TYPE_CLASS;
	targetDataType : GENERIC_TYPE_CLASS;
END_VAR
VAR
	stringBuilder : WideStringBuilder;
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringBuilder
	.AppendString("Conversion from data type '")
	.AppendString255(TO_WSTRING(sourceDataType))
	.AppendString("' to '")
	.AppendString255(TO_WSTRING(targetDataType))
	.AppendString("' is not supported")
	.AssignToString(message);
	
stringBuilder.Clear(TRUE);

InternalThrow(sourceNamespaceName, sourceClassName, sourcePOUName, sourcePosition, message, 0, 0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>