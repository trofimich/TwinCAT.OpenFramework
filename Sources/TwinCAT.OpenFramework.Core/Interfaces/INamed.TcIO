INTERFACE INamed EXTENDS IObject]]></Declaration>
    <Property Name="Name" Id="{72c457aa-a371-4a9a-b527-076a57a0f56a}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed, read-only view of the name without copying its storage.</summary>
<description>
Read-only is a usage contract: callers must not write through the returned reference.
The reference requires a live provider and is not a snapshot; copy the value when an independent name is needed.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY Name : REFERENCE TO WSTRING]]></Declaration>
