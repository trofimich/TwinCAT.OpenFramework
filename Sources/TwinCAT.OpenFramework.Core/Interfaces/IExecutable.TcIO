(*!
<summary>Provides a common execution entry point for an object.</summary>
<description>
The caller drives execution; this interface does not schedule calls.
Configuration, lifecycle and execution timing are defined by the concrete object or its specialized interface.
</description>
*)

INTERFACE IExecutable EXTENDS IObject]]></Declaration>
    <Method Name="Execute" Id="{929462e9-5c53-48d1-a008-4a9304fa5e51}">
      <Declaration><![CDATA[(*!
<summary>Performs one invocation of the object's execution logic.</summary>
<description>
Returning from this method does not by itself indicate completion of a multi-cycle operation.
Required preparation, call frequency, state changes and exception handling follow the specialized contract.
Do not assume repeated calls within one PLC cycle are equivalent to a single call.
</description>
*)

METHOD Execute]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>