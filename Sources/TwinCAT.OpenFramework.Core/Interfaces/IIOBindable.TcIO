<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IIOBindable" Id="{c613c159-795e-4dc7-ae41-ac2b019d9330}">
    <Declaration><![CDATA[(*
