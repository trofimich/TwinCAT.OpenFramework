(*!
<summary>Exposes whether an object is bound to its required IO data.</summary>
<description>
Binding operations and the required IO channels belong to the concrete device API.
</description>
*)

INTERFACE IIOBindable EXTENDS IObject]]></Declaration>
    <Property Name="BoundToIO" Id="{133b2262-01f7-4288-a1ea-ef2b55cbb091}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the required IO bindings are present.</summary>
<description>
The concrete device defines which bindings are required.
This status does not establish hardware health, communication state or freshness of IO values.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL BoundToIO : BOOL]]></Declaration>
      <Get Name="Get" Id="{2f0f600d-241e-4f54-a080-d5f424f7851e}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>