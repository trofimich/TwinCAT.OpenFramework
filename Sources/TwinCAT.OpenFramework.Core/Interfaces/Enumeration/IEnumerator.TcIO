<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IEnumerator" Id="{459ae103-383b-4a03-9f68-f28a3cccf087}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides sequential traversal with a borrowed view of the current element.</summary>
<description>
The source must remain alive while the enumerator is used.
Do not structurally modify the source collection during traversal: adding, removing or reordering elements is unsupported.
</description>
*)

INTERFACE IEnumerator EXTENDS IObject]]></Declaration>
    <Property Name="Current" Id="{6246802f-40aa-48e9-b7fb-975da88bd2b5}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed, read-only descriptor of the current element.</summary>
<description>
Before the first successful MoveNext and after traversal ends, returns an empty GENERIC_VALUE.
Do not modify the descriptor or referenced data, and do not call Release through this view.
Read-only is a usage contract; REFERENCE TO does not enforce it.
References and addresses obtained from Current are not guaranteed to remain valid after
MoveNext, Reset or destruction of the enumerator. Copying the descriptor does not extend data lifetime or transfer ownership.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT Current : REFERENCE TO GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{cc639373-80a5-4044-8578-7fe884c3c23a}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="MoveNext" Id="{c36c1566-0815-4b50-a29c-445adbeb3671}">
      <Declaration><![CDATA[(*!
<summary>Advances to the next element and returns TRUE when an element is available.</summary>
<description>
Returns FALSE when traversal has ended; Current then represents an empty value.
Any previously obtained view of the current element must no longer be used after this call.
</description>
*)

METHOD MoveNext : BOOL]]></Declaration>
    </Method>
    <Method Name="Reset" Id="{959ae268-37f4-4623-916b-c48b391e2a9b}">
      <Declaration><![CDATA[(*!
<summary>Returns the enumerator to its initial position before the first element.</summary>
<description>
Current becomes empty; call MoveNext to obtain the first element again.
Previously obtained current-element views must no longer be used.
</description>
*)

METHOD Reset
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>