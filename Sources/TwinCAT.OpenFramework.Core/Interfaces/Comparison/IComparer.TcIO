<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IComparer" Id="{610e5cb7-c530-4689-b27d-7bafa4915f53}">
    <Declaration><![CDATA[(*
