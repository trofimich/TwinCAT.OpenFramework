<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IEqualityComparer" Id="{883e01fb-201f-4629-bd9c-fb4473fd3fa9}">
    <Declaration><![CDATA[(*!
<summary>Defines a matching pair of value equality and hashing operations for generic descriptors.</summary>
<description>
The implementation defines its supported value representations, including empty descriptors.
For supported values, equality must be reflexive, symmetric and transitive, and equal values must have equal hashes.
Unequal values may have equal hashes. Results must remain consistent while the operands and equality-relevant strategy configuration are unchanged.
Descriptors preserve the distinction between OBJECT and USER_DEFINED; IsMemoryOwner does not affect equality or hashing.
Arguments and referenced storage are borrowed for the call. Implementations must not modify, clone, release or retain the operands or their payload.
The caller keeps the comparer and referenced storage alive and supplies representations supported by this strategy.
These methods do not promise exception containment; failures propagate to the caller without a fallback strategy.
Inherited Equals and GetHashCode concern the comparer instance itself; AreEqual and GetValueHashCode concern supplied values.
</description>
*)
INTERFACE IEqualityComparer EXTENDS IObject
]]></Declaration>
    <Method Name="AreEqual" Id="{c1474796-d2b6-480b-a1db-cd1282ce0760}">
      <Declaration><![CDATA[(*!
<summary>Determines whether two supplied values are equal under this strategy.</summary>
<description>
Receives copies of the descriptors without copying or acquiring ownership of their payload.
TRUE requires GetValueHashCode to return the same hash for both values.
The implementation defines compatibility and empty-value handling; caller-side type conversion is not implied.
</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
METHOD AreEqual : BOOL
VAR_INPUT
	first : GENERIC_VALUE;
	second : GENERIC_VALUE;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="GetValueHashCode" Id="{a7d24477-dba1-418a-b410-d08448050519}">
      <Declaration><![CDATA[(*!
<summary>Computes a hash consistent with this strategy's value equality.</summary>
<description>
Receives a descriptor copy without copying or acquiring ownership of its payload.
Equal values must return the same hash, including across representations that AreEqual treats as equal.
A matching hash only selects candidates; AreEqual must distinguish collisions.
The hash is not a persistent identifier and need not be stable across executions or changes to equality-relevant data or strategy configuration.
</description>
*)
//!<param name="value">Descriptor to hash; referenced storage is borrowed for the call.</param>
METHOD GetValueHashCode : UDINT
VAR_INPUT
	value : GENERIC_VALUE;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
