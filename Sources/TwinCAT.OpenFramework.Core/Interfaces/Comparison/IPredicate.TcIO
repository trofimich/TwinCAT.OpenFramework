(*!
<summary>Defines a condition for selecting values described by AnyType.</summary>
<description>
A predicate may have configuration and internal state.
Supported data types and treatment of null values are defined by the concrete implementation.
</description>
*)

INTERFACE IPredicate EXTENDS IObject
]]></Declaration>
    <Method Name="Check" Id="{481953a6-7290-46b0-ac08-ad672ed4bf66}">
      <Declaration><![CDATA[(*!
<summary>Returns TRUE when the supplied value satisfies this predicate.</summary>
<description>
Must not modify the supplied data or the collection being traversed by the caller.
The predicate may update its own internal state without violating these restrictions.
</description>
*)
//!<param name="valueToCompare">Descriptor of the value to evaluate according to this predicate's supported types and null policy.</param>
METHOD Check : BOOL
VAR_INPUT
	valueToCompare : __SYSTEM.AnyType; 
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>