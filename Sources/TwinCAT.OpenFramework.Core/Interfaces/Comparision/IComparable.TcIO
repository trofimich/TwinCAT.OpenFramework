<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IComparable" Id="{f57543d2-c48b-40a1-89a1-48969e8514ee}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides the natural ordering defined by a concrete object type.</summary>
<description>
The implementing type defines which other types it can compare with.
Comparisons must not modify either object and must define a consistent ordering for supported values.
</description>
*)

INTERFACE IComparable EXTENDS __System.IQueryInterface]]></Declaration>
    <Method Name="CompareTo" Id="{2475bd0e-54ae-4479-a8b3-6f2c5ca19e19}">
      <Declaration><![CDATA[(*!
<summary>Compares this object with another supported object.</summary>
<description>
Returns FIRST_LESS_THAN_SECOND, FIRST_EQUAL_TO_SECOND or FIRST_GREATER_THAN_SECOND,
where this object is the first operand and otherValue is the second.
A null interface or an unsupported concrete type must raise an exception.
For supported values, comparing an object with itself returns equality;
reversing the operands reverses the ordering, and the ordering is transitive.
</description>
*)
//!<param name="otherValue">A live, non-null object of a type supported by this implementation; borrowed for the call.</param>
METHOD CompareTo : COMPARISION_RESULT
VAR_IN_OUT CONSTANT
	otherValue : IComparable;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>