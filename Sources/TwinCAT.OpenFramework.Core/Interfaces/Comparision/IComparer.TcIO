(*!
<summary>Defines an external ordering strategy for values described by AnyType.</summary>
<description>
The caller selects a comparer compatible with the supplied data representations.
Each implementation defines its supported representations and treatment of null values.
This interface does not guarantee automatic type validation or conversion.
</description>
*)

INTERFACE IComparer EXTENDS IObject
]]></Declaration>
    <Method Name="Compare" Id="{43cad5af-7c15-4b54-a84e-23be8e0a7ae0}">
      <Declaration><![CDATA[(*!
<summary>Compares the first value with the second according to this strategy.</summary>
<description>
Returns FIRST_LESS_THAN_SECOND, FIRST_EQUAL_TO_SECOND or FIRST_GREATER_THAN_SECOND.
The caller must supply valid descriptors and keep referenced data alive and readable for the call.
For non-null operands, accessible storage size and value representation must satisfy this comparer;
matching byte sizes alone do not establish compatibility.
Validation, if provided, follows the concrete comparer contract.
</description>
*)
//!<param name="first">Descriptor of the first operand; referenced storage is borrowed for the call.</param>
//!<param name="second">Descriptor of the second operand; referenced storage is borrowed for the call.</param>
METHOD Compare : COMPARISION_RESULT
VAR_INPUT
	first : __SYSTEM.AnyType;
	second : __SYSTEM.AnyType;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>