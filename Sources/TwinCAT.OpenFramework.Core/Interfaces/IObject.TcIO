(*!
<summary>Common object equality, hashing, metadata and identity. Interface references do not transfer ownership.</summary>
<description>
Members require a live instance; they cannot validate an object after its lifetime has ended.
Equals and GetHashCode form one contract: equal objects have equal hashes, but equal hashes
do not establish equality. Object supplies overridable defaults based on instance identity.
</description>
*)

INTERFACE IObject EXTENDS __SYSTEM.IQueryInterface]]></Declaration>
    <Property Name="ClassName" Id="{3e7a3cd3-d8e0-4d8a-8c55-1b5342aa67c1}">
      <Declaration><![CDATA[(*!
<summary>Borrowed reference to class-name storage, not an independent string copy.</summary>
<description>
The value remains unchanged and its storage remains valid throughout the instance lifetime.
Callers may only read the returned reference and must not use it after the instance lifetime ends.
</description>
*)

{attribute 'monitoring' := 'call'}

PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{889c3d50-a912-431d-828b-b0aa9026a512}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Equals" Id="{15ef53a3-ecfb-4fe7-a1b1-b86e9cfecea0}">
      <Declaration><![CDATA[(*!
<summary>Determines whether another object is equal under this type's equality rules.</summary>
<description>
Equality must be reflexive, symmetric and transitive for supported live objects.
Returns FALSE for null or an incompatible object. Neither operand is modified and no ownership
is transferred. Implementations that define value equality must supply matching GetHashCode results.
Object defaults to ReferenceEquals; its descendants may override Equals and GetHashCode together.
Equals is the final equality decision; a direct comparison does not require computing a hash.
Implementation exceptions propagate to the caller; object lifetime is not validated.
</description>
*)
//!<param name="other">Borrowed live object to compare, or zero.</param>
METHOD Equals : BOOL
VAR_INPUT
	other : IObject;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetFullTypeName" Id="{5fd27adb-4d7b-498f-9cad-32d06a6d8894}">
      <Declaration><![CDATA[(*!
<summary>Returns the namespace-qualified type name by value, within the return string capacity.</summary>
*)

METHOD GetFullTypeName : STRING
]]></Declaration>
    </Method>
    <Method Name="GetHashCode" Id="{afbdadc6-9a80-4b2e-b3dc-d233ae4f0c90}">
      <Declaration><![CDATA[(*!
<summary>Produces a hash consistent with this object's Equals implementation.</summary>
<description>
Objects that compare equal must return the same hash; unequal objects may also share a hash.
The hash helps a hash index select candidates, reducing equality comparisons when hashes are well distributed.
It does not replace Equals: hash collisions must be resolved by comparing the candidate objects with Equals.
Computing a hash alone, without an index, does not accelerate lookup or establish equality.
Value-equality implementations must hash data consistent with their equality rules. For example,
objects equal by Motor.Id must return equal hashes for equal Id values regardless of their addresses.
The inherited Object address-based hash is therefore unsuitable when distinct instances can compare equal.
Does not modify the object or transfer ownership. Equality-relevant state and hash results
must remain stable while the object is used as a hashed key. The result is not a persistent identifier.
Object supplies an address-based default without cached state; relocation requires rebuilding
indices that use address-based hashes. Implementation exceptions propagate to the caller.
</description>
*)
METHOD GetHashCode : UDINT]]></Declaration>
    </Method>
    <Method Name="GetName" Id="{8294dede-68ca-42ff-a38b-cc86adf90d8b}">
      <Declaration><![CDATA[(*!
<summary>Returns a diagnostic object name by value; it is not a unique object identifier.</summary>
*)

METHOD GetName : WSTRING]]></Declaration>
    </Method>
    <Property Name="IsDynamicInstance" Id="{46fa710c-bc2b-4e4c-a911-56db473aa5ff}">
      <Declaration><![CDATA[(*!
<summary>Reports the memory area, not ownership or registration for automatic cleanup.</summary>
*)

{attribute 'monitoring' := 'call'}

PROPERTY FINAL IsDynamicInstance : BOOL]]></Declaration>
      <Get Name="Get" Id="{e52ef2de-1fe8-4d12-944f-685b8a1320b6}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{41a2bdb9-dadd-4c91-851c-acf2ad853661}">
      <Declaration><![CDATA[(*!
<summary>Borrowed reference to namespace-name storage, not an independent string copy.</summary>
<description>
The value remains unchanged and its storage remains valid throughout the instance lifetime.
Callers may only read the returned reference and must not use it after the instance lifetime ends.
</description>
*)

{attribute 'monitoring' := 'call'}

PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{415a0a62-f677-4d44-b3ed-d7eb98e6d4aa}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="ReferenceEquals" Id="{1d3007f2-f5ed-4237-a812-4ec6c04abeaf}">
      <Declaration><![CDATA[(*!
<summary>Compares this instance's identity with another object, without comparing contents.</summary>
<description>
Returns FALSE for a null argument. Non-null arguments must refer to live instances.
Object implements this method as FINAL; descendants cannot redefine this identity operation.
No ownership is transferred and object lifetime is not validated.
</description>
*)

{attribute "object_name" := "ReferenceEquals"}
METHOD ReferenceEquals : BOOL
VAR_INPUT 
	object : IObject;
END_VAR]]></Declaration>
    </Method>
    <Property Name="SelfAddress" Id="{6b5d769e-7b05-4a19-a56c-3656121e0615}">
      <Declaration><![CDATA[(*!
<summary>Borrowed address of this instance. Obtaining it does not grant permission to delete the object.</summary>
*)

{attribute 'monitoring' := 'call'}

PROPERTY SelfAddress : POINTER TO Object]]></Declaration>
      <Get Name="Get" Id="{22ecdebc-d7a0-45cc-9cfa-c59fbc5dff05}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{902a9b17-518a-4f74-97b7-bd1998b63b8c}">
      <Declaration><![CDATA[(*!
<summary>Size in bytes of the complete concrete instance; excludes separately allocated buffers it owns.</summary>
*)

{attribute 'monitoring' := 'call'}

PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6b36f7ed-1855-4e40-a186-1ed3287e25da}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>