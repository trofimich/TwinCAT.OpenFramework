<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IObject" Id="{ead88c25-62c0-46e5-b40b-3c9531c283b1}">
    <Declaration><![CDATA[(*
