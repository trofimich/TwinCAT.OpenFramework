(*!
<summary>Provides polymorphic creation of an object copy.</summary>
<description>
Copy depth and the resulting object's lifetime follow the concrete type's contract.
This capability alone does not grant the caller permission to delete the result.
</description>
*)

INTERFACE ICloneable EXTENDS __System.IQueryInterface
]]></Declaration>
    <Method Name="Clone" Id="{3cacc8b3-c81b-4d49-b8db-110a65a4cb62}">
      <Declaration><![CDATA[(*!
<summary>Creates a copy according to the concrete object's cloning contract.</summary>
<description>
Framework exception clones are managed by the exception engine and DynamicMemoryManager until cycle cleanup.
Exceptions represent events within the current cycle; retaining them across cycles or storing them in user-managed collections is unsupported.
Use ERROR to retain an error as state. Engine-managed aggregate exceptions remain supported.
</description>
*)
METHOD Clone : IObject]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>