<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ConfigurationValueTypes" Id="{d59eaef3-6e42-468e-82ab-bff76035d3fa}" SpecialFunc="None">
    <Declaration><![CDATA[(*
