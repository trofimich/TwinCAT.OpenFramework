(*!
<summary>Validates memory buffer sizes for elementary configuration value types.</summary>
<description>
Enforces the format-independent byte-width rules for each CONFIGURATION_VALUE_TYPE enum member.
Stateless and free of side effects.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM ConfigurationValueTypes
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{290f492d-d017-4246-b81d-f60732a3f276}">
      <Declaration><![CDATA[(*!
<summary>Returns the program class name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6c274560-d5c7-451c-b98c-7cdc4fed770b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="IsValidSize" Id="{e114dc46-4887-4668-9c68-07db12f4c643}">
      <Declaration><![CDATA[(*!
<summary>Reports whether a byte size is valid for the specified elementary configuration value type.</summary>
<description>
Fixed-width primitive types require their exact byte width (1, 2, 4 or 8 bytes). TYPE_STRING requires at least
1 byte (including the null terminator). TYPE_WSTRING requires an even size of at least 2 bytes (including the
wide null terminator). Returns FALSE for unsupported enum values or incompatible sizes; no exception is raised.
</description>
<param name="valueType">Elementary configuration type class to validate.</param>
<param name="size">Buffer size in bytes.</param>
*)
METHOD IsValidSize : BOOL
VAR_INPUT
	valueType : CONFIGURATION_VALUE_TYPE;
	size : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE valueType OF
	CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	CONFIGURATION_VALUE_TYPE.TYPE_BYTE,
	CONFIGURATION_VALUE_TYPE.TYPE_SINT,
	CONFIGURATION_VALUE_TYPE.TYPE_USINT:
		IsValidSize := size = 1;

	CONFIGURATION_VALUE_TYPE.TYPE_WORD,
	CONFIGURATION_VALUE_TYPE.TYPE_INT,
	CONFIGURATION_VALUE_TYPE.TYPE_UINT:
		IsValidSize := size = 2;

	CONFIGURATION_VALUE_TYPE.TYPE_DWORD,
	CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	CONFIGURATION_VALUE_TYPE.TYPE_UDINT,
	CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	CONFIGURATION_VALUE_TYPE.TYPE_TIME,
	CONFIGURATION_VALUE_TYPE.TYPE_DATE,
	CONFIGURATION_VALUE_TYPE.TYPE_TOD,
	CONFIGURATION_VALUE_TYPE.TYPE_DT:
		IsValidSize := size = 4;

	CONFIGURATION_VALUE_TYPE.TYPE_LWORD,
	CONFIGURATION_VALUE_TYPE.TYPE_LINT,
	CONFIGURATION_VALUE_TYPE.TYPE_ULINT,
	CONFIGURATION_VALUE_TYPE.TYPE_LREAL,
	CONFIGURATION_VALUE_TYPE.TYPE_LTIME,
	CONFIGURATION_VALUE_TYPE.TYPE_LDATE,
	CONFIGURATION_VALUE_TYPE.TYPE_LTOD,
	CONFIGURATION_VALUE_TYPE.TYPE_LDT:
		IsValidSize := size = 8;

	CONFIGURATION_VALUE_TYPE.TYPE_STRING:
		IsValidSize := size >= 1;

	CONFIGURATION_VALUE_TYPE.TYPE_WSTRING:
		IsValidSize := size >= 2 AND_THEN (size MOD 2) = 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{89349d55-aa88-41eb-a3f9-44b043a1c35e}">
      <Declaration><![CDATA[(*!
<summary>Returns the library namespace name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{878bb26a-67fa-4967-b57f-402557c7f4c7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>

