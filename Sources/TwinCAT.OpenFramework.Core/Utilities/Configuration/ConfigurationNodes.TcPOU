(*!
<summary>Provides constants and helpers for configuration nodes.</summary>
<description>
Supplies canonical boundary values such as EMPTY_NODE for comparisons.
</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM ConfigurationNodes
VAR CONSTANT
	//! <summary>Empty configuration node denoting an absent or unassigned node.</summary>
	EMPTY_NODE : CONFIGURATION_NODE := (Handle := 0);
END_VAR
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{eb897fb0-e736-49fd-8507-f399b3e93803}">
      <Declaration><![CDATA[(*!
<summary>Returns the program class name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ede1d259-08dd-4f84-9964-2f27ccf4cb29}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a0012fb4-1257-49ef-b3c2-7533d3db33bc}">
      <Declaration><![CDATA[(*!
<summary>Returns the library namespace name for diagnostic reporting.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{950c767c-0375-4435-8879-bba52c7f142a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>