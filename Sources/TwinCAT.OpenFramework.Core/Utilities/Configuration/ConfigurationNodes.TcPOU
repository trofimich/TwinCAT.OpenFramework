<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ConfigurationNodes" Id="{c9a87487-a25c-431a-a764-27b6c2a15990}" SpecialFunc="None">
    <Declaration><![CDATA[(*
