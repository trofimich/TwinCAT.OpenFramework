(*!
<summary>Identifies supported elementary IEC types in configuration documents.</summary>
<description>
Distinguishes elementary primitive types for format-neutral configuration reading and writing following a
JSON/YAML-style hierarchical data model (objects with named fields, ordered arrays, and elementary values).
Specific storage widths must satisfy ConfigurationValueTypes.IsValidSize for each type class. Serialized objects
must ensure field names are unique within an enclosing object, safe for XML-like formats, and independent of
key order or casing.
</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE CONFIGURATION_VALUE_TYPE :
(
	TYPE_BOOL,
	TYPE_BYTE,
	TYPE_WORD,
	TYPE_DWORD,
	TYPE_LWORD,
	TYPE_SINT,
	TYPE_INT,
	TYPE_DINT,
	TYPE_LINT,
	TYPE_USINT,
	TYPE_UINT,
	TYPE_UDINT,
	TYPE_ULINT,
	TYPE_REAL,
	TYPE_LREAL,
	TYPE_TIME,
	TYPE_LTIME,
	TYPE_DATE,
	TYPE_LDATE,
	TYPE_TOD,
	TYPE_LTOD,
	TYPE_DT,
	TYPE_LDT,
	TYPE_STRING,
	TYPE_WSTRING
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>