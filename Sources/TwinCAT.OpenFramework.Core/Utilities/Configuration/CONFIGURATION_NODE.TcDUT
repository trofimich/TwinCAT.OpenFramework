(*!
<summary>Identifies an opaque configuration node within an active document.</summary>
<description>
Represents a node in a format-neutral hierarchical data model (JSON/YAML-style objects with named fields,
ordered arrays, or elementary values). Handles borrow the active document and expire when it is replaced or
closed. Do not store outside one synchronous load. Handle = 0 denotes an absent or unassigned node. Serialized
objects must ensure field names are unique within each object, safe for XML-like formats, and must not depend
on key order or case sensitivity.
</description>
*)
TYPE CONFIGURATION_NODE :
STRUCT
	Handle : __XWORD;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>