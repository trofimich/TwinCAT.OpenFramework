<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IConfigurationSerializable" Id="{bfb1e15c-ee71-45ee-bd68-6830ab29e619}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes configuration fields for format-neutral serialization and deserialization.</summary>
<description>
Universal interface for writing and restoring object state using a format-neutral hierarchical data model
(JSON/YAML-style objects with named fields, ordered arrays, and elementary values).
Serialize writes object fields to the supplied writer.
Deserialize restores instance fields from the supplied reader and node, using an optional domain-specific
deserialization context (IConfigurationDeserializationContext). The context is optional; when not required or
when absent, context = 0 is permitted. Objects requiring an external context (such as workflow element loaders
or dependency resolvers) are responsible for querying and validating the context interface and raising a
configuration exception when absent or incompatible.
Serialized objects must use unique field names within each object, ensure names are safe for XML-like formats,
and must not rely on key ordering or letter casing.
The caller keeps the reader/writer, document, and deserialization context alive for the duration
of the synchronous call.
On failure discard the partial instance; this is not a Try method.
</description>
*)
INTERFACE IConfigurationSerializable EXTENDS IObject]]></Declaration>
    <Method Name="Deserialize" Id="{cf664d62-d7ba-498a-8e29-c5fe218ae9a4}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader, document node and optional deserialization context are borrowed for this call.
Objects requiring a specific context validate it directly. On failure discard the partial instance;
this is not a Try method.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Optional deserialization context, or 0 if no external context is provided.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : IConfigurationReader;
	node : CONFIGURATION_NODE;
	context : IConfigurationDeserializationContext := 0;
END_VAR]]></Declaration>
    </Method>
    <Method Name="Serialize" Id="{3e8ee65c-9e6d-4d1b-b428-c2d5b8c85105}">
      <Declaration><![CDATA[(*!
<summary>Writes the fields needed to reconstruct this object.</summary>
<description>The caller owns the enclosing object and the writer. Propagate failure to the document owner.</description>
<param name="writer">Active configuration writer positioned inside the target object.</param>
*)
METHOD Serialize
VAR_INPUT
	writer : IConfigurationWriter;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>