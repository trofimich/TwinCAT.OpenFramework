<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IConfigurationWriter" Id="{c13d460a-4e60-409d-9db3-f53b16886edb}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Writes a configuration as nested objects, ordered lists and elementary values.</summary>
<description>
Represents a format-neutral hierarchical data model (JSON/YAML-style) composed of objects with named fields,
ordered arrays, and elementary values. Use an empty name at the document root and for list items. Object
property names must be nonempty, unique within their enclosing object, safe for XML-like formats, and objects
must not depend on key order or case sensitivity. Writers do not maintain an internal key dictionary or nesting
balance stack; verifying property name uniqueness and proper nesting is the responsibility of the caller.
Structural violations are caught and reported by the underlying format writer where supported.
The caller keeps all data live through the call and discards the document after any failure.
</description>
*)
INTERFACE IConfigurationWriter EXTENDS IObject]]></Declaration>
    <Method Name="BeginArray" Id="{d26be646-14ba-4499-9a65-6f62745eaee5}">
      <Declaration><![CDATA[(*!
<summary>Opens an ordered list.</summary>
<description>
Writes at the current position of the active document. Property names within an enclosing object must be unique.
</description>
<param name="name">List property name, or empty for array items or root.</param>
*)
METHOD BeginArray
VAR_INPUT
	name : STRING;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BeginObject" Id="{11270c4e-8174-4edb-8b5e-ccf77bd59f35}">
      <Declaration><![CDATA[(*!
<summary>Opens an object.</summary>
<description>
Writes at the current position of the active document. Property names within an enclosing object must be unique.
</description>
<param name="name">Object property name, or empty for array items or root.</param>
*)
METHOD BeginObject
VAR_INPUT
	name : STRING;
END_VAR]]></Declaration>
    </Method>
    <Method Name="EndArray" Id="{3d94103b-9009-4e7d-aae1-2fc062d2650d}">
      <Declaration><![CDATA[(*!
<summary>Closes the current list.</summary>
<description>Writes at the current position of the active document.</description>
*)
METHOD EndArray]]></Declaration>
    </Method>
    <Method Name="EndObject" Id="{dc2f5cbd-5ace-477b-930c-ce2f310814d0}">
      <Declaration><![CDATA[(*!
<summary>Closes the current object.</summary>
<description>Writes at the current position of the active document.</description>
*)
METHOD EndObject]]></Declaration>
    </Method>
    <Method Name="WriteValue" Id="{5fdd9465-6c73-410f-b1af-ec01fdc7f2e4}">
      <Declaration><![CDATA[(*!
<summary>Copies one elementary IEC value.</summary>
<description>
Writes at the current position of the active document. Property names within an enclosing object must be unique.
</description>
<param name="name">Value property name, or empty for array items.</param>
<param name="valueType">Elementary IEC type class.</param>
<param name="data">Pointer to readable source memory.</param>
<param name="size">Source memory size in bytes.</param>
*)
METHOD WriteValue
VAR_INPUT
	name : STRING;
	valueType : CONFIGURATION_VALUE_TYPE;
	data : PVOID;
	size : UDINT;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>