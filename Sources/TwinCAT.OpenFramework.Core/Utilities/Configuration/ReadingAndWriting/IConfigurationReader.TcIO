<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IConfigurationReader" Id="{b5a6ed6b-8cfd-4b03-8cc0-7c64caa689ac}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Reads structured configuration without exposing a concrete document format.</summary>
<description>
Represents a format-neutral hierarchical data model (JSON/YAML-style) composed of objects with named fields,
ordered arrays, and elementary values. Serialized objects must use unique field names within each object,
ensure names are safe for XML-like formats, and must not depend on key order or case sensitivity.
The caller keeps the document and all borrowed inputs alive for the call.
</description>
*)
INTERFACE IConfigurationReader EXTENDS IObject]]></Declaration>
    <Method Name="FindField" Id="{5f759d5c-54c7-4580-90f1-ae3748494f96}">
      <Declaration><![CDATA[(*!
<summary>Attempts to find an optional object member without throwing.</summary>
<description>Returns EMPTY_NODE when the member is absent. No exception escapes this method.</description>
<param name="node">Enclosing object node.</param>
<param name="name">Optional member field name.</param>
*)
METHOD FindField : CONFIGURATION_NODE
VAR_INPUT
	node : CONFIGURATION_NODE;
	name : STRING;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetArraySize" Id="{cffd3954-076b-4c90-9b9f-0b11d0f3bec5}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of elements of an array. Other shapes raise.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="node">Node representing an array.</param>
*)
METHOD GetArraySize : UDINT
VAR_INPUT
	node : CONFIGURATION_NODE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetField" Id="{cb5fa680-8e25-4e69-9eab-b8968de0c1eb}">
      <Declaration><![CDATA[(*!
<summary>Finds a mandatory object member or raises.</summary>
<description>Requires an existing member with the given name. If absent or invalid, raises an exception.</description>
<param name="node">Enclosing object node.</param>
<param name="name">Member field name.</param>
*)
METHOD GetField : CONFIGURATION_NODE
VAR_INPUT
	node : CONFIGURATION_NODE;
	name : STRING;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetItem" Id="{6dcf819a-a4c2-4ab2-bff5-25fbc6e2f9a8}">
      <Declaration><![CDATA[(*!
<summary>Returns an existing array item by zero-based index or raises.</summary>
<description>Use within one synchronous load. Out-of-bounds index raises an exception.</description>
<param name="node">Array node.</param>
<param name="index">Zero-based element index.</param>
*)
METHOD GetItem : CONFIGURATION_NODE
VAR_INPUT
	node : CONFIGURATION_NODE;
	index : UDINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="IsArray" Id="{338cceff-03c3-4c65-8573-c7be977e9e87}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the supplied value is an array.</summary>
<description>Use within one synchronous load. Handles borrow the active document and expire when it is replaced.</description>
<param name="node">Node to inspect.</param>
*)
METHOD IsArray : BOOL
VAR_INPUT
	node : CONFIGURATION_NODE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="IsPresent" Id="{27bd006e-1d0e-4015-8ffe-f0cdaad4b4bb}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the supplied node refers to a present document element.</summary>
<description>Returns FALSE for an empty or unassigned node handle.</description>
<param name="node">Node to inspect.</param>
*)
METHOD IsPresent : BOOL
VAR_INPUT
	node : CONFIGURATION_NODE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ReadValue" Id="{bf43123f-4683-4a1a-bfc9-a1571e718665}">
      <Declaration><![CDATA[(*!
<summary>Reads one elementary value into a live typed destination or raises.</summary>
<description>Validates destination pointer, size and type class. Raises on incompatibility or parse failure.</description>
<param name="node">Node containing the elementary value.</param>
<param name="valueType">Elementary IEC type class to decode.</param>
<param name="data">Writable pointer to the destination memory.</param>
<param name="size">Destination memory size in bytes.</param>
*)
METHOD ReadValue
VAR_INPUT
	node : CONFIGURATION_NODE;
	valueType : CONFIGURATION_VALUE_TYPE;
	data : PVOID;
	size : UDINT;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>