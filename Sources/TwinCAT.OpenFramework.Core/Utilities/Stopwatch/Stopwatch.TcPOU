<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Stopwatch" Id="{cf11f042-ef13-455b-9003-2c015c9dfb08}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Accumulates elapsed time with pause, reset and selectable counting direction.</summary>
<description>Execute updates the timer. Start begins or resumes counting and does nothing while active. Stop saves the counted time into both saved values and pauses counting. Reset clears time without changing the active state; Restart clears time and starts counting. Start selects the memory mode; internal resume operations and Restart preserve it. CountedTime combines the selected saved value with the timer elapsed time. Persistent saved time is updated by Stop and Reset, not by each Execute.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK Stopwatch EXTENDS Object IMPLEMENTS IExecutable
VAR		
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_Timer : Tc2_Standard.LTON;
	
	{attribute 'hide'} 
	_Direction : DIRECTION_TYPE := DIRECTION_TYPE.POSITIVE;

	{attribute 'hide'} 
	_NotPersistentSavedTime : LTIME; 
END_VAR
VAR PERSISTENT
	_UsePersistentMemory : BOOL;
	
	_PersistentSavedTime : LTIME; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Active" Id="{897b05b4-98a6-4632-b6fa-25df71ff00ae}">
      <Declaration><![CDATA[(*!
<summary>Gets or controls whether counting is active.</summary>
<description>Setting TRUE resumes with the selected memory mode; setting FALSE stops and saves time. Assigning the current state does nothing.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Active : BOOL]]></Declaration>
      <Get Name="Get" Id="{02c27c95-394f-4acb-9268-871c67b6472c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Active := _Timer.IN;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{90e932dc-1dd9-4faa-a82c-5f68b7b9b5d7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Timer.IN = Active THEN
	RETURN;
END_IF

IF Active THEN
	Start(usePersistentMemory := _UsePersistentMemory);
ELSE
	Stop();
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClassName" Id="{837b771f-9583-4e70-9794-bdf43f2f3ac1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d4e4e4dc-d780-4bc6-ad13-0c89fca862d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CountedTime" Id="{5674d9aa-f32a-4f4d-b79f-da0ac0a9cdde}">
      <Declaration><![CDATA[(*!
<summary>Reads accumulated time using the selected memory mode and direction.</summary>
<description>While running, combines saved time with the timer elapsed value; negative counting stops at zero. Reading does not advance the timer or change saved time. Call Execute cyclically for current elapsed time.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CountedTime : LTIME]]></Declaration>
      <Get Name="Get" Id="{e7121bee-1d6a-478e-8e51-f9078e7ef1b6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CountedTime := SEL(_UsePersistentMemory, _NotPersistentSavedTime, _PersistentSavedTime);

IF _Timer.IN THEN
	CASE _Direction OF
		DIRECTION_TYPE.POSITIVE:
			CountedTime := CountedTime + _Timer.ET;
		
		DIRECTION_TYPE.NEGATIVE:
			CountedTime := SEL(_Timer.ET > CountedTime, CountedTime - _Timer.ET, LTIME#0S);
	END_CASE
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Direction" Id="{88b28f87-1d1d-4428-bf6d-58c919f77f61}">
      <Declaration><![CDATA[(*!
<summary>Gets or changes the counting direction.</summary>
<description>Changing direction while active saves the current time and resumes in the new direction without changing the memory mode.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Direction : DIRECTION_TYPE]]></Declaration>
      <Get Name="Get" Id="{57211322-9c22-4d48-9b8d-25d3f1e7626d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Direction := _Direction;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{abc09738-3558-47cd-8937-7f600f496730}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _Direction = Direction THEN
	RETURN;
END_IF

IF _Timer.IN THEN
	Stop();
	Start(usePersistentMemory := _UsePersistentMemory);
END_IF

_Direction := Direction;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Execute" Id="{70236e42-c2ef-47f8-ab17-b9601eb70f1f}">
      <Declaration><![CDATA[(*!
<summary>Advances the stopwatch timer for the current cycle.</summary>
<description>Call cyclically while measuring time. Does not itself save persistent elapsed time or start a stopped stopwatch. Descendants cannot replace timer advancement; it remains consistent with this stopwatch start, stop and elapsed-time state.</description>
*)
METHOD FINAL Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{c137b4a8-96dd-4365-bc66-bf7d2b09d719}">
      <Declaration><![CDATA[(*!
<summary>FB_Exit must be implemented explicitly. If there is an implementation, then the</summary>
<description>
method is called before the controller removes the code of the function block instance
(implicit call). The return value is not evaluated.
</description>
*)


METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stop();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{bc33c0fc-ee85-405a-90f8-9d8eba01e55f}">
      <Declaration><![CDATA[(*!
<summary>FB_Init is always available implicitly and it is used primarily for initialization.</summary>
<description>
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.
</description>
*)



METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.PT := LongTimes.MAX_VALUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{cd74d6df-660e-4eb3-abbe-1269842a581b}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING
]]></Declaration>
      <Get Name="Get" Id="{f3046b29-a982-4223-b663-d8564220acb2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{0e7c1022-4d1f-4cdd-ad2a-c4d0792431b1}">
      <Declaration><![CDATA[(*!
<summary>Clears both saved times and the current timer interval.</summary>
<description>Preserves the active state, counting direction and memory mode. An active stopwatch continues counting from zero; a stopped stopwatch remains stopped.</description>
*)
METHOD FINAL Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[_NotPersistentSavedTime := LongTimes.MIN_VALUE;
_PersistentSavedTime := LongTimes.MIN_VALUE;

IF _Timer.IN THEN
	_Timer(IN := FALSE);
	_Timer(IN := TRUE);
ELSE
	_Timer(IN := FALSE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restart" Id="{f204032a-bad6-420e-a904-e72e1193eb2f}">
      <Declaration><![CDATA[(*!
<summary>Clears the counted time and starts counting again.</summary>
<description>Works while active or stopped. Preserves the counting direction and selected memory mode.</description>
*)
METHOD FINAL Restart]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset();
Start(usePersistentMemory := _UsePersistentMemory);]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{11beda5d-eb10-4c8c-9864-8706a61f3d9e}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a84a6694-7ee1-48cc-ab3d-2d7021dfef03}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Start" Id="{e670ae5c-9eef-481c-9197-255e2e64ba7a}">
      <Declaration><![CDATA[(*!
<summary>Begins or resumes counting from the selected saved time.</summary>
<description>While active, the call does nothing, including ignoring a different memory mode. While stopped, selects the memory mode and starts counting without clearing saved time. Use Restart to clear time and start again.</description>
<param name="usePersistentMemory">Selects the persistent saved time when starting from the stopped state. Defaults to FALSE.</param>
*)
METHOD FINAL Start
VAR_INPUT
	usePersistentMemory : BOOL := FALSE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Active THEN
	RETURN;
END_IF

_UsePersistentMemory := usePersistentMemory;

_Timer(IN := TRUE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{01df04dd-4ffa-4966-a21e-179760a468cb}">
      <Declaration><![CDATA[(*!
<summary>Stops counting and saves the counted time.</summary>
<description>Reads CountedTime once using the current direction and memory selection, writes the same result to both saved values, then resets the timer. The captured value uses the timer's last updated elapsed time.</description>
*)
METHOD FINAL Stop
VAR
	savedTime : LTIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[savedTime := CountedTime;

_NotPersistentSavedTime := savedTime;
_PersistentSavedTime := savedTime;

_Timer(IN := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="UsePersistentMemory" Id="{c956bd4d-4b04-4aa1-9c5e-4d79cd7838fe}">
      <Declaration><![CDATA[(*!
<summary>Reports the memory mode selected by Start.</summary>
<description>TRUE selects the persistent saved time. Restart and internal resume operations preserve this selection.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL UsePersistentMemory : BOOL]]></Declaration>
      <Get Name="Get" Id="{1ec0711a-ecea-47cf-b44d-5df336a5c9f8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[UsePersistentMemory := _UsePersistentMemory;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>