<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ILogger" Id="{bb7cc691-64aa-41ad-bc93-0075e9114ba5}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines message, error and exception logging with cyclic execution support.</summary>
<description>Exception logging accepts IReadOnlyException and reads borrowed diagnostics without transferring ownership. Implementations must not retain exception references beyond their task cleanup. A logger or filter invoked by LogManager must not call back into that manager, directly or indirectly, while handling the invocation. Independent diagnostics may use a separate channel that does not return to the same logging chain. This restriction does not prohibit internal method calls used to expand aggregate exceptions. TryLog methods must satisfy the no-throw contract even when called directly, without LogManager. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers. Execute must also contain exceptions: cyclic backend failures are reported through implementation diagnostics and failure state, without escaping to the caller. Failure cleanup must preserve buffers still used by pending I/O. This does not suppress the terminal allocation check at the task boundary.</description>
*)
INTERFACE ILogger EXTENDS IExecutable
]]></Declaration>
    <Method Name="TryLogError" Id="{cafb4c48-2d77-416c-8c02-5768d880a0fc}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log a borrowed error without propagating exceptions.</summary>
<description>Borrows inputs only for the call. TRUE reports backend acceptance, not guaranteed durable storage. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
*)
METHOD TryLogError : BOOL
VAR_INPUT
	error : REFERENCE TO ERROR;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
    </Method>
    <Method Name="TryLogException" Id="{6dc6a6c6-f48e-4a45-9afc-497f61af9ee9}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log diagnostic information from a read-only exception view.</summary>
<description>Borrows the exception for the call without clearing it or taking ownership. The exception and its inner causes must remain live while their diagnostics are read. Logging does not extend their lifetime. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
<param name="exception">Exception view to read; null is ignored.</param>
<param name="severity">Severity used to select the log category.</param>
*)
METHOD TryLogException : BOOL
VAR_INPUT
	exception : IReadOnlyException;
	severity : ERROR_SEVERITY;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
    </Method>
    <Method Name="TryLogMessage" Id="{28df38e9-fb6b-488e-8810-b61f44dcb4ce}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log borrowed message text without propagating exceptions.</summary>
<description>Borrows inputs only for the call. TRUE reports backend acceptance, not guaranteed durable storage. Does not propagate exceptions, including failures while reading or formatting diagnostics and calling the backend; returns FALSE instead. Already emitted entries are not rolled back, so FALSE may follow partial output. Caught exceptions are not logged again. The fatal allocation latch is preserved for RaiseIfAllocationFailed at the task boundary outside recoverable handlers.</description>
*)
METHOD TryLogMessage : BOOL
VAR_INPUT
	category : LOG_CATEGORY;	
END_VAR
VAR_IN_OUT CONSTANT
	message : ERROR_MESSAGE;
END_VAR
VAR_INPUT
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>