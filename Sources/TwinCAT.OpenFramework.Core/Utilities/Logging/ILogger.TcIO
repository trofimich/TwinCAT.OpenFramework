<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ILogger" Id="{bb7cc691-64aa-41ad-bc93-0075e9114ba5}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Defines message, error and exception logging with cyclic execution support.</summary>
<description>Exception logging accepts IReadOnlyException and reads borrowed diagnostics without transferring ownership. Implementations must not retain exception references beyond their task cleanup.</description>
*)
INTERFACE ILogger EXTENDS IExecutable
]]></Declaration>
    <Method Name="TryLogError" Id="{cafb4c48-2d77-416c-8c02-5768d880a0fc}">
      <Declaration><![CDATA[METHOD TryLogError : BOOL
VAR_INPUT
	error : REFERENCE TO ERROR;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
    </Method>
    <Method Name="TryLogException" Id="{6dc6a6c6-f48e-4a45-9afc-497f61af9ee9}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log diagnostic information from a read-only exception view.</summary>
<description>Borrows the exception for the call without clearing it or taking ownership. The exception and its inner causes must remain live while their diagnostics are read. Logging does not extend their lifetime.</description>
<param name="exception">Exception view to read; null is ignored.</param>
<param name="severity">Severity used to select the log category.</param>
*)
METHOD TryLogException : BOOL
VAR_INPUT
	exception : IReadOnlyException;
	severity : ERROR_SEVERITY;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
    </Method>
    <Method Name="TryLogMessage" Id="{28df38e9-fb6b-488e-8810-b61f44dcb4ce}">
      <Declaration><![CDATA[METHOD TryLogMessage : BOOL
VAR_INPUT
	category : LOG_CATEGORY;	
END_VAR
VAR_IN_OUT CONSTANT
	message : ERROR_MESSAGE;
END_VAR
VAR_INPUT
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>