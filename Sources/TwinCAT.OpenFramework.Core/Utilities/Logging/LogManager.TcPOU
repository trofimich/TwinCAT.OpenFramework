<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LogManager" Id="{5168e535-223e-4560-9821-bca21a9b8561}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Routes diagnostics and cyclically services loggers in cyclic PLC tasks.</summary>
<description>
LogManager is intended for logger use and cyclic servicing within PLC tasks. It provides each calling cyclic
PLC task with its logging destination, topic filtering, message numbering and cyclic logger execution.
Logging from non-cyclic contexts must be arranged separately by the application, outside LogManager.
TryLog calls use CurrentTaskLogger: the calling cyclic task's borrowed logger, or its own built-in AdsLogger.
No shared fallback or explicit per-call destination is provided. Outside a valid cyclic task, TryLog returns
FALSE before filtering, counters or backend calls, and ExecuteCurrentTaskLogger does no work. Logger references
must remain valid during use; routing does not transfer ownership. Each ordinary backend belongs to one task;
use the QueuedLogger wrapper from the Loggers library to share a backend through its owning cyclic task.
Every task must call ExecuteCurrentTaskLogger cyclically, directly or through AutomationRunner. No manager lock
spans backend calls. Counter updates and number snapshots are serialized by short critical sections. Filters,
backends, configuration changes and external counter reads or writes are not protected by this lock. Configure
shared Filter and MessageNumberFormat before parallel logging starts; runtime changes require application-level
synchronization with affected calls. Replace CurrentTaskLogger only in its own task between logging and service
calls, without reentry. Keep replaced logger and filter instances alive until their in-flight calls finish.
A filter shared by tasks must support concurrent ShouldLog calls and synchronize its own mutable state and
rule updates. The assigned number describes numbering order, not backend delivery order. Total counters
count cyclic requests reaching filtering after the initial null or empty-input guard. PassedFilter counters
count requests that pass filtering and are incremented before calling the logger, regardless of its result.
Message numbers use these post-filter counters and can have gaps in successfully written output. Exception logging
accepts IReadOnlyException and reads borrowed diagnostics without transferring ownership. Implementations must
not retain exception references beyond their task cleanup. A logger or filter invoked by LogManager must not
call back into that manager, directly or indirectly, while handling the invocation. TryLog methods return
FALSE on caught exceptions without logging them again. Counters retain increments already performed, and
backend side effects are not rolled back. A fatal allocation latch is not cleared; task boundaries must call
RaiseIfAllocationFailed outside recoverable handlers. Independent diagnostics may use a separate channel that
does not return to the same logging chain. This restriction does not prohibit internal method calls used to
expand aggregate exceptions.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM LogManager
VAR_INPUT
	(*!
	<summary>Selects whether logging calls receive a global or per-category sequence number.</summary>
	<description>
	Configure before parallel logging starts. Runtime changes must be synchronized by the application with
	logging calls; the counter lock does not protect this setting.
	</description>
	*)
	MessageNumberFormat : LOG_MESSAGE_NUMBER_FORMAT := LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL_BY_CATEGORY;
END_VAR
VAR_OUTPUT
	//!<summary>Requests reaching filtering after the initial input guard.</summary>
	TotalMessageCounter : ULINT;
	//!<summary>Requests passing filtering, counted before the logger call regardless of its result.</summary>
	PassedFilterMessageCounter : ULINT;
	
	//!<summary>Requests reaching filtering, grouped by category.</summary>
	TotalMessageByCategoryCounters : ARRAY [LOG_CATEGORY.DEBUG .. LOG_CATEGORY.CRITICAL_ERROR] OF ULINT;   
	//!<summary>Requests passing filtering by category, independent of logger success.</summary>
	PassedFilterMessageByCategoryCounters : ARRAY [LOG_CATEGORY.DEBUG .. LOG_CATEGORY.CRITICAL_ERROR] OF ULINT;   
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	//! <summary>Independent standard ADS destination and service-failure channel for each cyclic task.</summary>
	{attribute 'hide'} 
	_DefaultLoggers : ARRAY [1..System.TASK_COUNT] OF AdsLogger;
	//! <summary>Borrowed destinations assigned only by their owning cyclic tasks; zero selects standard ADS.</summary>
	{attribute 'hide'}
	_TaskLoggers : ARRAY [1..System.TASK_COUNT] OF ILogger;
	{attribute 'hide'} 
	_CounterLock : Tc2_System.FB_IecCriticalSection;
	{attribute 'hide'}
	_Filter : ILogFilter;  
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{605c7ee8-fe66-40d6-9aa1-b8b2828392e5}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized manager name for diagnostics.</summary>
<description>Read-only program storage; the caller must not modify the referenced string.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f1ca54d4-2382-4af1-96ca-fc4dbaf9eb4e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CurrentTaskLogger" Id="{8f399577-3e03-44ae-a287-168cdae9d0ec}">
      <Declaration><![CDATA[(*!
<summary>Gets or assigns the logging destination of the calling cyclic task.</summary>
<description>
The getter returns the task's assigned logger or its own built-in AdsLogger. Assigning zero restores that
standard destination. Outside a valid cyclic task, the getter returns zero and the setter changes nothing;
no exception is raised. References are borrowed; keep the assigned logger alive while configured and during
calls using it. Assignment does not initialize, execute or delete either logger. Configure or replace only
from the owning task between logging and service calls, without reentry; finish pending backend work before
destruction. An ordinary backend must not be assigned to different tasks. To share a backend, assign the same
QueuedLogger wrapper from the Loggers library to its producer tasks, including its configured cyclic owner;
only the wrapper may access the backend. The manager does not synchronize backend callbacks or transfer
ownership. ExecuteCurrentTaskLogger services the destination returned by this getter.
</description>
*)
PROPERTY CurrentTaskLogger : ILogger]]></Declaration>
      <Get Name="Get" Id="{c9c1cefb-1091-483c-b6a3-ca70a961903f}">
        <Declaration><![CDATA[VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[taskIndex := System.GetCurrentTaskIndex();

IF taskIndex < 1 OR_ELSE taskIndex > System.TASK_COUNT THEN
	RETURN;
END_IF

IF _TaskLoggers[taskIndex] = 0 THEN
	CurrentTaskLogger := _DefaultLoggers[taskIndex];
ELSE
	CurrentTaskLogger := _TaskLoggers[taskIndex];
END_IF]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{82c82d05-b526-431e-b338-c69fda2bdd1a}">
        <Declaration><![CDATA[VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[taskIndex := System.GetCurrentTaskIndex();

IF taskIndex < 1 OR_ELSE taskIndex > System.TASK_COUNT THEN
	RETURN;
END_IF

_TaskLoggers[taskIndex] := CurrentTaskLogger;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="ExecuteCurrentTaskLogger" Id="{13c3c36e-9fa4-45b8-9a63-156fe14d049b}">
      <Declaration><![CDATA[(*!
<summary>Advances the calling cyclic task's logger without propagating exceptions.</summary>
<description>
Uses the same CurrentTaskLogger destination as TryLog calls. Outside a valid cyclic task, returns without
backend calls or diagnostics. Call cyclically from every task that uses the manager; AutomationRunner does
this for its task. Does not lock backend callbacks. An ordinary backend must belong to this task; a shared
QueuedLogger services its backend only in its configured owner task. If a backend violates the no-throw
contract, attempts independent diagnostics through this task's built-in AdsLogger. Secondary diagnostic
failures are contained. Does not clear terminal allocation state or replace the task-boundary fatal check.
</description>
*)
METHOD ExecuteCurrentTaskLogger
VAR
	taskIndex : DINT;
	selectedLogger : ILogger;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := System.GetCurrentTaskIndex();

IF taskIndex < 1 OR_ELSE taskIndex > System.TASK_COUNT THEN
	RETURN;
END_IF

__TRY
	selectedLogger := CurrentTaskLogger;
	selectedLogger.Execute();
__CATCH(exceptionCode)
	__TRY
		exception := ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
	
		_DefaultLoggers[taskIndex].TryLogException(exception := exception, severity := ERROR_SEVERITY.ERROR);
	__CATCH
		// A secondary diagnostic failure must not escape to the caller.
	__ENDTRY
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="Filter" Id="{b6f1f4aa-92b0-409e-ad33-af6c50416e83}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the shared filter applied before forwarding diagnostics.</summary>
<description>
Zero disables filtering. The reference is borrowed and must remain valid during use. ShouldLog runs outside
the counter lock and may be called concurrently by different tasks; the filter implementation is responsible
for safe shared state and rule updates. Assign before parallel logging starts. Runtime replacement must be
synchronized by the application with all affected calls; the old filter must remain alive until its in-flight
calls finish. Rule updates inside the filter remain the responsibility of its implementation.
</description>
*)
PROPERTY FINAL Filter : ILogFilter]]></Declaration>
      <Get Name="Get" Id="{31e6a597-f4cb-45a7-bcf1-c6f162ef07f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Filter := _Filter;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{3a6b37ff-c92d-4d4c-a4cf-30b8093e5043}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Filter := Filter;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{84be6e8d-e2b5-4bd6-ae4f-31889ab0432e}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>
Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4891555c-102c-47e3-8f69-9a215e109b78}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryLogError" Id="{f8c266fa-1403-48ca-81af-80709466198a}">
      <Declaration><![CDATA[(*!
<summary>Attempts to forward an error through topic filtering to the configured logger.</summary>
<description>
Borrows the error for this call. An invalid reference or rejected filter returns FALSE. Returns FALSE if a
nested call raises an exception. Does not log the caught exception or roll back counters and backend side
effects. Counter-lock acquisition failure returns FALSE. Counter increments already made are retained. Logger
receives a call-local number snapshot. The fatal allocation latch remains set; RaiseIfAllocationFailed must be
called at the task boundary outside recoverable handlers. Uses CurrentTaskLogger; outside a valid cyclic
task, returns FALSE before reading diagnostics, filtering, counter changes or backend calls.
Returns FALSE when fatal allocation state is observed before work or after nested calls. The latch remains
set for the caller's task boundary; already accepted or emitted records are not rolled back.
</description>
*)
METHOD TryLogError : BOOL
VAR_INPUT
	error : REFERENCE TO ERROR;
	topic1 : WSTRING := "";	
	topic2 : WSTRING := "";	
	topic3 : WSTRING := "";	
	topic4 : WSTRING := "";	
	topic5 : WSTRING := "";	
END_VAR
VAR
	selectedLogger : ILogger;
	sequentialNumber : ULINT;
	categoryNumber : ULINT;
	counterLockHeld : BOOL;

	category : LOG_CATEGORY;
	topics : ARRAY [0..4] OF WSTRING; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	selectedLogger := CurrentTaskLogger;

	IF selectedLogger = 0 OR_ELSE DynamicMemoryManager.HasAllocationFailed OR_ELSE NOT __ISVALIDREF(error) THEN
		RETURN;
	END_IF

	category := SEL(error.Severity = ERROR_SEVERITY.CRITICAL, LOG_CATEGORY.ERROR, LOG_CATEGORY.CRITICAL_ERROR);

	IF NOT _CounterLock.Enter() THEN
		RETURN;
	END_IF

	counterLockHeld := TRUE;
	TotalMessageCounter := TotalMessageCounter + 1;
	TotalMessageByCategoryCounters[category] := TotalMessageByCategoryCounters[category] + 1;
	_CounterLock.Leave();
	counterLockHeld := FALSE;

	topics[0] := topic1;
	topics[1] := topic2;
	topics[2] := topic3;
	topics[3] := topic4;
	topics[4] := topic5;

	IF _Filter <> 0 AND_THEN NOT _Filter.ShouldLog(category := category, topics := topics) THEN
		RETURN;
	END_IF

	IF NOT _CounterLock.Enter() THEN
		RETURN;
	END_IF

	counterLockHeld := TRUE;
	PassedFilterMessageCounter := PassedFilterMessageCounter + 1;
	PassedFilterMessageByCategoryCounters[category] := PassedFilterMessageByCategoryCounters[category] + 1;
	sequentialNumber := PassedFilterMessageCounter;
	categoryNumber := PassedFilterMessageByCategoryCounters[category];
	_CounterLock.Leave();
	counterLockHeld := FALSE;

	CASE MessageNumberFormat OF
		LOG_MESSAGE_NUMBER_FORMAT.NONE:
			TryLogError := selectedLogger.TryLogError(error := error);

		LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL:
			TryLogError := selectedLogger.TryLogError(error := error, messageNumber := sequentialNumber);

		LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL_BY_CATEGORY:
			TryLogError := selectedLogger.TryLogError(error := error, messageNumber := categoryNumber);
	END_CASE

	IF DynamicMemoryManager.HasAllocationFailed THEN
		TryLogError := FALSE;
	END_IF
__CATCH
	IF counterLockHeld THEN
		_CounterLock.Leave();
	END_IF

	TryLogError := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogException" Id="{bd7d75b2-118d-460f-87a2-4f124e9232ba}">
      <Declaration><![CDATA[(*!
<summary>Attempts to log diagnostic information from a read-only exception view.</summary>
<description>
Borrows the exception for the call without clearing it or taking ownership. The exception and its inner causes
must remain live while their diagnostics are read. Logging does not extend their lifetime. Returns FALSE if a
nested call raises an exception. Does not log the caught exception or roll back counters and backend side
effects. Counter-lock acquisition failure returns FALSE. Counter increments already made are retained. Logger
receives a call-local number snapshot. The fatal allocation latch remains set; RaiseIfAllocationFailed must be
called at the task boundary outside recoverable handlers. Uses CurrentTaskLogger; outside a valid cyclic
task, returns FALSE before reading diagnostics, filtering, counter changes or backend calls.
Returns FALSE when fatal allocation state is observed before work or after nested calls. The latch remains
set for the caller's task boundary; already accepted or emitted records are not rolled back.
</description>
<param name="exception">Exception view to read; null is ignored.</param>
<param name="severity">Severity used to select the log category.</param>
*)
METHOD TryLogException : BOOL
VAR_INPUT
	exception : IReadOnlyException;
	severity : ERROR_SEVERITY;
	topic1 : WSTRING := "";	
	topic2 : WSTRING := "";	
	topic3 : WSTRING := "";	
	topic4 : WSTRING := "";	
END_VAR
VAR
	selectedLogger : ILogger;
	sequentialNumber : ULINT;
	categoryNumber : ULINT;
	counterLockHeld : BOOL;

	category : LOG_CATEGORY;
	topics : ARRAY [0..4] OF WSTRING; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	selectedLogger := CurrentTaskLogger;

	IF selectedLogger = 0 OR_ELSE DynamicMemoryManager.HasAllocationFailed OR_ELSE exception = 0 THEN
		RETURN;
	END_IF

	category := SEL(severity = ERROR_SEVERITY.CRITICAL, LOG_CATEGORY.ERROR, LOG_CATEGORY.CRITICAL_ERROR);

	IF NOT _CounterLock.Enter() THEN
		RETURN;
	END_IF

	counterLockHeld := TRUE;
	TotalMessageCounter := TotalMessageCounter + 1;
	TotalMessageByCategoryCounters[category] := TotalMessageByCategoryCounters[category] + 1;
	_CounterLock.Leave();
	counterLockHeld := FALSE;

	topics[0] := TO_WSTRING(exception.ClassName);
	topics[1] := topic1;
	topics[2] := topic2;
	topics[3] := topic3;
	topics[4] := topic4;

	IF _Filter <> 0 AND_THEN NOT _Filter.ShouldLog(category := category, topics := topics) THEN
		RETURN;
	END_IF

	IF NOT _CounterLock.Enter() THEN
		RETURN;
	END_IF

	counterLockHeld := TRUE;
	PassedFilterMessageCounter := PassedFilterMessageCounter + 1;
	PassedFilterMessageByCategoryCounters[category] := PassedFilterMessageByCategoryCounters[category] + 1;
	sequentialNumber := PassedFilterMessageCounter;
	categoryNumber := PassedFilterMessageByCategoryCounters[category];
	_CounterLock.Leave();
	counterLockHeld := FALSE;

	CASE MessageNumberFormat OF
		LOG_MESSAGE_NUMBER_FORMAT.NONE:
			TryLogException := selectedLogger.TryLogException(exception := exception, severity := severity);

		LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL:
			TryLogException := selectedLogger.TryLogException(
				exception := exception,
				severity := severity,
				messageNumber := sequentialNumber
			);

		LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL_BY_CATEGORY:
			TryLogException := selectedLogger.TryLogException(
				exception := exception,
				severity := severity,
				messageNumber := categoryNumber
			);
	END_CASE

	IF DynamicMemoryManager.HasAllocationFailed THEN
		TryLogException := FALSE;
	END_IF
__CATCH
	IF counterLockHeld THEN
		_CounterLock.Leave();
	END_IF

	TryLogException := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogMessage" Id="{1b41c149-f4d6-4a68-875a-675fa3954ac9}">
      <Declaration><![CDATA[(*!
<summary>Processes the supplied diagnostic message without copying the input buffer.</summary>
<description>
Long diagnostic strings are borrowed read-only for this call; their references are not retained. Pass
variables or literals, and store computed expressions in local variables before calling. Returns FALSE if a
nested call raises an exception. Does not log the caught exception or roll back counters and backend side
effects. Counter-lock acquisition failure returns FALSE. Counter increments already made are retained. Logger
receives a call-local number snapshot. The fatal allocation latch remains set; RaiseIfAllocationFailed must be
called at the task boundary outside recoverable handlers. Uses CurrentTaskLogger; outside a valid cyclic
task, returns FALSE before reading diagnostics, filtering, counter changes or backend calls.
Returns FALSE when fatal allocation state is observed before work or after nested calls. The latch remains
set for the caller's task boundary; already accepted or emitted records are not rolled back.
</description>
*)
METHOD TryLogMessage : BOOL
VAR_IN_OUT CONSTANT
	message : ERROR_MESSAGE;
END_VAR
VAR_INPUT
	category : LOG_CATEGORY;
	topic1 : WSTRING := "";	
	topic2 : WSTRING := "";	
	topic3 : WSTRING := "";	
	topic4 : WSTRING := "";	
	topic5 : WSTRING := "";	
END_VAR
VAR
	selectedLogger : ILogger;
	sequentialNumber : ULINT;
	categoryNumber : ULINT;
	counterLockHeld : BOOL;

	topics : ARRAY [0..4] OF WSTRING; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	selectedLogger := CurrentTaskLogger;

	IF selectedLogger = 0 OR_ELSE DynamicMemoryManager.HasAllocationFailed OR_ELSE message = WideStrings.Empty THEN
		RETURN;
	END_IF

	IF NOT _CounterLock.Enter() THEN
		RETURN;
	END_IF

	counterLockHeld := TRUE;
	TotalMessageCounter := TotalMessageCounter + 1;
	TotalMessageByCategoryCounters[category] := TotalMessageByCategoryCounters[category] + 1;
	_CounterLock.Leave();
	counterLockHeld := FALSE;

	topics[0] := topic1;
	topics[1] := topic2;
	topics[2] := topic3;
	topics[3] := topic4;
	topics[4] := topic5;

	IF _Filter <> 0 AND_THEN NOT _Filter.ShouldLog(category := category, topics := topics) THEN
		RETURN;
	END_IF

	IF NOT _CounterLock.Enter() THEN
		RETURN;
	END_IF

	counterLockHeld := TRUE;
	PassedFilterMessageCounter := PassedFilterMessageCounter + 1;
	PassedFilterMessageByCategoryCounters[category] := PassedFilterMessageByCategoryCounters[category] + 1;
	sequentialNumber := PassedFilterMessageCounter;
	categoryNumber := PassedFilterMessageByCategoryCounters[category];
	_CounterLock.Leave();
	counterLockHeld := FALSE;

	CASE MessageNumberFormat OF
		LOG_MESSAGE_NUMBER_FORMAT.NONE:
			TryLogMessage := selectedLogger.TryLogMessage(category := category, message := message);

		LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL:
			TryLogMessage := selectedLogger.TryLogMessage(
				category := category,
				message := message,
				messageNumber := sequentialNumber
			);

		LOG_MESSAGE_NUMBER_FORMAT.SEQUENTIAL_BY_CATEGORY:
			TryLogMessage := selectedLogger.TryLogMessage(
				category := category,
				message := message,
				messageNumber := categoryNumber
			);
	END_CASE

	IF DynamicMemoryManager.HasAllocationFailed THEN
		TryLogMessage := FALSE;
	END_IF
__CATCH
	IF counterLockHeld THEN
		_CounterLock.Leave();
	END_IF

	TryLogMessage := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>