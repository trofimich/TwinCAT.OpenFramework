<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ILogFilter" Id="{e8f4ea73-ee31-4d80-ae51-445c37a6d56c}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Selects which diagnostic requests should be forwarded to a logger.</summary>
<description>When invoked by LogManager, the filter must not call back into that manager directly or indirectly. Independent diagnostics must not return to the same logging chain. An instance shared by multiple tasks must support concurrent ShouldLog calls. The implementation is responsible for synchronizing mutable state and rule updates with readers. Read-only rules that remain unchanged during logging require no additional synchronization. An instance used exclusively by one task does not require cross-task synchronization.</description>
*)
INTERFACE ILogFilter EXTENDS IObject]]></Declaration>
    <Method Name="ShouldLog" Id="{563c2800-73e3-4d8e-875a-e42d6fe6ceff}">
      <Declaration><![CDATA[(*!
<summary>Returns TRUE to forward the request or FALSE to suppress it.</summary>
<description>Must not reenter the invoking LogManager, including through another helper. LogManager does not serialize this callback. Concurrent calls on a shared instance must not corrupt its state or observe partially updated rules. Arguments are borrowed for the call; callers must keep their contents stable while read.</description>
<param name="category">Category of the diagnostic request.</param>
<param name="topics">Topics used to decide whether to forward the request.</param>
*)
METHOD ShouldLog : BOOL
VAR_IN_OUT CONSTANT
	category : LOG_CATEGORY;
	topics : ARRAY [*] OF WSTRING;		
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>