<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DeadbandHysteresis" Id="{362de1d0-11a9-4969-80d9-9f9dc88afc70}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Tracks a latched threshold condition with a configurable hysteresis band.</summary>
<description>The caller must call RestartWithDeadband or RestartWithResetValue before the first Evaluate. Restart methods configure the thresholds and clear the latched state. Evaluate updates the state for each supplied value. The mode selects the direction of activation and reset. The caller supplies finite input values and parameters, a non-negative band width and finite computed thresholds. NaN, infinity and arithmetic overflow are outside the supported contract. No ABS conversion or runtime validation is performed.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK DeadbandHysteresis EXTENDS Object
VAR		
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_LatchValue : LREAL; 
	{attribute 'hide'} 
	_Deadband : LREAL;
	{attribute 'hide'} 
	_Mode : HYSTERESIS_MODE;
	
	{attribute 'hide'} 
	_Latched : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{722900e5-0af4-4119-9827-d8c93b046552}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING
]]></Declaration>
      <Get Name="Get" Id="{487660e4-edd4-4e2a-a474-cdbc7e7afe16}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Deadband" Id="{f4f46427-f152-49d9-973f-1168fa60bfd8}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured absolute separation between the thresholds.</summary>
<description>Read-only value installed by Restart; it has the same units as the monitored value.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Deadband : LREAL]]></Declaration>
      <Get Name="Get" Id="{be7b8da0-8c9c-4955-aeb8-7152a2dde1b1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Deadband := _Deadband;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Evaluate" Id="{d61fcb3b-c6c0-4ab8-834b-e415fcc629a0}">
      <Declaration><![CDATA[(*!
<summary>Updates and returns the latched condition for the supplied value.</summary>
<description>Call RestartWithDeadband or RestartWithResetValue before the first evaluation. The input and configured thresholds must be finite. In rising mode, activation includes equality with the latch threshold and reset requires falling below the reset threshold; falling mode uses the opposite comparisons. The method returns the updated stored state. Preconditions are not checked at runtime.</description>
<param name="currentValue">Finite value to evaluate against the configured thresholds.</param>
*)
METHOD FINAL Evaluate : BOOL
VAR_INPUT
	currentValue : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Latched THEN
	CASE _Mode OF
		HYSTERESIS_MODE.LATCH_ON_RISE_RESET_ON_FALL:
			IF currentValue < _LatchValue - _Deadband THEN
				_Latched := FALSE;
			END_IF
			
		HYSTERESIS_MODE.LATCH_ON_FALL_RESET_ON_RISE:
			IF currentValue > _LatchValue + _Deadband THEN
				_Latched := FALSE;
			END_IF
	END_CASE	
ELSE
	CASE _Mode OF
		HYSTERESIS_MODE.LATCH_ON_RISE_RESET_ON_FALL:
			IF currentValue >= _LatchValue THEN
				_Latched := TRUE;
			END_IF
			
		HYSTERESIS_MODE.LATCH_ON_FALL_RESET_ON_RISE:
			IF currentValue <= _LatchValue THEN
				_Latched := TRUE;
			END_IF
	END_CASE	
END_IF

Evaluate := _Latched;]]></ST>
      </Implementation>
    </Method>
    <Property Name="LatchValue" Id="{daaf3b63-0c86-4bdc-8629-1694bf2c03e6}">
      <Declaration><![CDATA[(*!
<summary>Returns the threshold at which the state latches.</summary>
<description>Read-only configured threshold; equality at this threshold can latch the state.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL LatchValue : LREAL]]></Declaration>
      <Get Name="Get" Id="{99c9b3a4-ce82-44dc-a5d6-26c086d3defd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LatchValue := _LatchValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Mode" Id="{02eefe36-d51b-4352-bf74-618ed78ec62b}">
      <Declaration><![CDATA[(*!
<summary>Returns the configured latching and reset direction.</summary>
<description>Reading does not evaluate an input or change the latch.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Mode : HYSTERESIS_MODE]]></Declaration>
      <Get Name="Get" Id="{212a2590-8ce9-4491-87b9-5f5aee5f5dc4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Mode := _Mode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1a18836c-3c66-4fba-a9d0-955c9cc6c3e0}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING
]]></Declaration>
      <Get Name="Get" Id="{9396263d-77ae-434b-afe2-3614dfb9d036}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResetValue" Id="{837ecb52-a64e-49f2-a047-748135c701da}">
      <Declaration><![CDATA[(*!
<summary>Calculates the reset threshold from the latch threshold and deadband.</summary>
<description>Subtracts the deadband in rising-latch mode and adds it in falling-latch mode. Equality at the reset threshold retains the latched state.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ResetValue : LREAL]]></Declaration>
      <Get Name="Get" Id="{562e959d-ef9f-4dae-adbe-f98adbbcc99b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CASE _Mode OF
   	HYSTERESIS_MODE.LATCH_ON_RISE_RESET_ON_FALL:
		ResetValue := _LatchValue - _Deadband;
		
    HYSTERESIS_MODE.LATCH_ON_FALL_RESET_ON_RISE:
		ResetValue := _LatchValue + _Deadband;
END_CASE]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RestartWithDeadband" Id="{92f0c6ff-d4f4-41b8-abc6-9616daf405d9}">
      <Declaration><![CDATA[(*!
<summary>Configures the activation threshold, band width and direction, then clears the latched state.</summary>
<description>The caller must supply finite latchValue and absoluteDeadband, with absoluteDeadband greater than or equal to zero. Zero is allowed. The computed reset threshold must remain finite. The method stores the supplied width without ABS conversion or runtime validation.</description>
<param name="latchValue">Threshold at which the condition becomes latched.</param>
<param name="absoluteDeadband">Non-negative distance between activation and reset thresholds.</param>
<param name="mode">Direction of activation and reset.</param>
*)
METHOD FINAL RestartWithDeadband
VAR_INPUT
	latchValue : LREAL; 
	absoluteDeadband : LREAL;  
	mode : HYSTERESIS_MODE := HYSTERESIS_MODE.LATCH_ON_RISE_RESET_ON_FALL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LatchValue := latchValue; 
_Deadband := absoluteDeadband;
_Mode := mode;

_Latched := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RestartWithResetValue" Id="{95c75482-4595-44a9-978f-e88e6569702e}">
      <Declaration><![CDATA[(*!
<summary>Configures hysteresis from activation and reset thresholds and clears the latched state.</summary>
<description>The caller supplies finite thresholds whose difference and reconstructed reset threshold remain finite. A latch threshold above the reset threshold selects rising mode; otherwise falling mode is selected, including equal thresholds. No runtime validation is performed.</description>
<param name="latchValue">Finite activation threshold.</param>
<param name="resetValue">Finite threshold used to calculate the band width and direction.</param>
*)
METHOD FINAL RestartWithResetValue
VAR_INPUT
	latchValue : LREAL; 
	resetValue : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF latchValue > resetValue THEN
	RestartWithDeadband(latchValue, latchValue - resetValue, HYSTERESIS_MODE.LATCH_ON_RISE_RESET_ON_FALL);
ELSE
	RestartWithDeadband(latchValue, resetValue - latchValue, HYSTERESIS_MODE.LATCH_ON_FALL_RESET_ON_RISE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{c1b6a736-ee27-474f-9d13-63bfe81fedcd}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a6184b4d-af6c-4c89-8717-37002638c068}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>