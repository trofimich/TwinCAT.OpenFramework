<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DeadbandHysteresis" Id="{362de1d0-11a9-4969-80d9-9f9dc88afc70}" SpecialFunc="None">
    <Declaration><![CDATA[(*

