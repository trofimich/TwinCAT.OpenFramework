<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Rounding" Id="{2d74878c-e7ed-4ad6-9900-556aca74c829}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides decimal truncation for floating-point values.</summary>
<description>Uses LREAL arithmetic when scaling and truncating values, without an intermediate integer conversion.</description>
*)
PROGRAM Rounding
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{b7f04a8e-e4fc-4b6c-b4bb-29398ce49122}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a5263e3d-4f25-428e-8f24-7223ea470d0a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{26427fab-f686-41e7-8e41-e034b7dcec36}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{410e6ec7-58b6-4bf6-8e52-29e5d0a0447d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Truncate" Id="{4c575123-d7d8-4e1f-b6da-b2438f37f081}">
      <Declaration><![CDATA[(*!
<summary>Truncates a value toward zero at the requested decimal place.</summary>
<description>Scales the value by a power of ten, truncates with Tc2_Math.LTRUNC and scales back. Arithmetic uses LREAL precision; decimal fractions are not necessarily represented exactly. The caller must supply a finite value whose product with the computed power of ten remains within the finite LREAL range. NaN, infinity and scaling overflow are outside the supported contract. These preconditions are not checked at runtime.</description>
<param name="value">Value to truncate.</param>
<param name="decimalPlaces">Number of decimal places to retain; zero truncates to an integral LREAL value.</param>
*)
METHOD Truncate : LREAL
VAR_INPUT
	value : LREAL;
	decimalPlaces : BYTE;
END_VAR
VAR 
	i : INT;
	factor : LREAL := 1;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO decimalPlaces DO
	factor := factor * 10;
END_FOR

Truncate := Tc2_Math.LTRUNC(value * factor) / factor;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>