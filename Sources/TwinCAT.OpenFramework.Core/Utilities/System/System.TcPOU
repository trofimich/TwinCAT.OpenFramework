<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="System" Id="{93357f84-3794-4f45-97d8-6aeeff54147a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
