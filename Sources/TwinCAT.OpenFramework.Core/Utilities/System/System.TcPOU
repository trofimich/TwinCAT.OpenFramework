SystemFileTime64 := _TaskStates[taskIndex].SystemFileTime64;]]></ST>
        </Implementation>
      </Get>

    </Property>
    <Property Name="SystemDataValid" Id="{0cb1ae30-8082-4885-a4df-b45f2a9ae686}">
      <Declaration><![CDATA[(*!
<summary>Indicates that the calling task has obtained system time and timezone successfully.</summary>
<description>Latches initial time and timezone readiness for this task until application reinitialization. AMS Net ID does not gate readiness. Returns FALSE outside cyclic context.</description>
*)

PROPERTY FINAL SystemDataValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{b72f9f7c-20a1-4fe4-8dfb-5a17d0fca9a7}">
        <Declaration><![CDATA[VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[taskIndex := GetCurrentTaskIndex();

IF taskIndex < 1 OR_ELSE taskIndex > TASK_COUNT THEN
	RETURN;
END_IF

SystemDataValid := _TaskStates[taskIndex].SystemDataValid;]]></ST>
        </Implementation>
      </Get>

    </Property>
  </POU>
</TcPlcObject>
