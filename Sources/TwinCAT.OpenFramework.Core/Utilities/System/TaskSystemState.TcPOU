<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskSystemState" Id="{d63d3190-ce01-410d-b2a1-6ff7a82ec17a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Maintains system time and ADS request state for one cyclic PLC task.</summary>
<description>Implementation detail of System. Each array element belongs exclusively to its task; do not call or read an instance from other tasks. Storage is static. Outputs are cached until the next Execute; SystemDataValid latches initial time and timezone readiness. Timezone configuration is acquired during initial preparation and is not periodically refreshed after a known timezone is obtained. Apply OS timezone configuration changes by reinitializing the PLC application. No exception objects are allocated.</description>
*)

{attribute 'no_explicit_call' := 'Use Execute'}
FUNCTION_BLOCK FINAL TaskSystemState
VAR_OUTPUT	
	SystemTimeZoneId : Tc2_Utilities.E_TimeZoneID;	
	SystemTimeZoneInformation : Tc2_Utilities.ST_TimeZoneInformation;		
			
	SystemLocalDateTime : LDATE_AND_TIME;			
	SystemUtcDateTime : LDATE_AND_TIME;
		
	SystemFileTime : Tc2_Utilities.T_FILETIME;		
	SystemFileTime64 : Tc2_Utilities.T_FILETIME64;
	
	(*!
	<summary>Indicates that system time and timezone have been obtained successfully.</summary>
	<description>Enables AutomationRunner initialization. Remains TRUE after initial readiness until application reinitialization. Obtaining the local AMS Net ID is not required.</description>
	*)
	SystemDataValid : BOOL;
END_VAR
VAR	
	{attribute 'hide'} 
	_GetLocalAmsNetId : FB_GetLocalAmsNetId;
	{attribute 'hide'} 
	_LocalSystemTime : Tc2_Utilities.FB_LocalSystemTime; 
	{attribute 'hide'} 
	_GetTimeZone : Tc2_Utilities.FB_GetTimeZoneInformation;
	{attribute 'hide'} 
	_LocalTimeToUtcTime : FB_TzSpecificLocalTimeToSystemTime;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Execute" Id="{0e211c6a-e2bd-40b2-858f-b7e535258d1c}">
      <Declaration><![CDATA[(*!
<summary>Advances system information requests and updates the cached clock.</summary>
<description>Call only from the cyclic PLC task owning this instance. Updates local and UTC snapshots after initial synchronization. Readiness remains set once time and timezone are obtained; AMS Net ID does not gate readiness. Timezone requests continue while the identifier is unknown or invalid; after a known identifier is obtained, the cached rules are retained until application reinitialization.</description>
*)

METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[_GetLocalAmsNetId(bExecute := TRUE);

IF SystemTimeZoneId = Tc2_Utilities.E_TimeZoneID.eTimeZoneID_Unknown OR_ELSE SystemTimeZoneId = Tc2_Utilities.E_TimeZoneID.eTimeZoneID_Invalid THEN
	_GetTimeZone(bExecute := TRUE, tTimeout := T#1S);
	
	IF NOT _GetTimeZone.bBusy THEN
		IF _GetTimeZone.bError THEN
			_GetTimeZone(bExecute := FALSE);
			_GetTimeZone(bExecute := TRUE);
		ELSE
			SystemTimeZoneId := _GetTimeZone.tzID;
			SystemTimeZoneInformation := _GetTimeZone.tzInfo;
		END_IF		
	END_IF
END_IF
 
_LocalSystemTime(bEnable := TRUE);

IF _LocalSystemTime.bValid AND_THEN NOT _GetTimeZone.bBusy AND_THEN NOT _GetTimeZone.bError THEN
	SystemLocalDateTime := System.ConvertTimestructToLongDateTime(_LocalSystemTime.systemTime);

	_LocalTimeToUtcTime(in := _LocalSystemTime.systemTime, tzInfo := _GetTimeZone.tzInfo);	

	SystemUtcDateTime := System.ConvertTimestructToLongDateTime(_LocalTimeToUtcTime.out);

	SystemFileTime := Tc2_Utilities.SYSTEMTIME_TO_FILETIME(_LocalSystemTime.systemTime);
	SystemFileTime64 := Tc2_Utilities.SYSTEMTIME_TO_FILETIME64(_LocalSystemTime.systemTime);
END_IF

IF NOT SystemDataValid 
	AND_THEN NOT _GetTimeZone.bBusy AND_THEN NOT _GetTimeZone.bError 
	AND_THEN _LocalSystemTime.bValid 
THEN
	SystemDataValid := TRUE; 	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="LocalAmsNetId" Id="{d0554e90-e68b-4885-9520-7b9878e75ef1}">
      <Declaration><![CDATA[(*!
<summary>Provides the owning task's LocalAmsNetId.</summary>
<description>Returns the last address obtained by this task. Does not indicate readiness; obtaining the address does not gate SystemDataValid.</description>
*)
PROPERTY FINAL LocalAmsNetId : Tc2_System.T_AmsNetID]]></Declaration>
      <Get Name="Get" Id="{b63da31d-0941-49f4-9a62-8a45bef7893a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LocalAmsNetId := _GetLocalAmsNetId.AddrString;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SystemTime" Id="{0ba5bf74-09dd-4439-a178-c0756220e707}">
      <Declaration><![CDATA[(*!
<summary>Provides the owning task's SystemTime.</summary>
<description>Borrowed read-only reference to this task's local calendar time. Remains valid for the instance lifetime; its contents change on Execute. Do not share the reference with other tasks.</description>
*)
PROPERTY SystemTime : REFERENCE TO TIMESTRUCT]]></Declaration>
      <Get Name="Get" Id="{a83580a3-2666-48ca-81ef-3b940ed71a26}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SystemTime REF= _LocalSystemTime.systemTime;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SystemTimeSynchronisationInterval" Id="{3fb3c97a-bc82-4761-8268-bb0bcb56ba4b}">
      <Declaration><![CDATA[(*!
<summary>Provides the owning task's SystemTimeSynchronisationInterval.</summary>
<description>Read or configure only from the owning task. The interval is in seconds, from 1 to 86400; it controls synchronization with the operating system rather than the frequency of Execute.</description>
*)
PROPERTY SystemTimeSynchronisationInterval : DWORD]]></Declaration>
      <Get Name="Get" Id="{bfa28337-dc33-4523-b6af-4d4879406bc0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SystemTimeSynchronisationInterval := _LocalSystemTime.dwCycle;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{bb3f61b5-e4d3-4854-97fe-dce7622f94bb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_LocalSystemTime.dwCycle := SystemTimeSynchronisationInterval;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>