(*!
<summary>Stores the auto-dispose registry and fallback-cleanup diagnostics of one cyclic PLC task.</summary>
<description>Internal manager storage. Only the owning task mutates it during cyclic execution. Application teardown may release it after cyclic tasks have stopped. Objects belong to the registry; clients borrow references until cleanup.</description>
*)
TYPE TASK_MEMORY_STATE :
STRUCT
	Objects : POINTER TO IObject;
	BufferCapacity : DWORD;
	ObjectCount : DWORD;

	LastSystemTaskCycleCount : UDINT;
	MissedCleanupCount : UDINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>