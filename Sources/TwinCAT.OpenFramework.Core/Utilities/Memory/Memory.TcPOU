(*!
<summary>Provides object address conversion, memory-area classification and explicit dynamic memory release.</summary>
<description>Release requires a live allocation owned by the caller. These helpers do not log object disposal; object FB_init, FB_exit and FB_reinit implementations must not create or raise exceptions. TryRelease methods contain exceptions and clear the supplied address/reference on exceptional failure; this does not clear other aliases.</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
PROGRAM Memory
VAR CONSTANT
	//! <summary>Null data address used to detect an unassigned buffer pointer; a non-null address alone does not prove validity or capacity.</summary>
	NULL_ADDRESS : PVOID := 0;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{f0cb7e04-3fa7-438c-9fb8-38f358e717d9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9465e911-db84-4abe-a766-2f2cfe6e21d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetAddressFromInterface" Id="{6158ab88-0c76-435a-bca8-37fff74aaa20}">
      <Declaration><![CDATA[(*!
<summary>Returns the borrowed address of a live FB instance; does not transfer ownership.</summary>
<description>
Returns 0 for a null interface or failed conversion. Does not validate lifetime.
</description>
*)

METHOD GetAddressFromInterface : PVOID
VAR_INPUT
	interfaceInstance : __SYSTEM.IQueryInterface; 
END_VAR
VAR
	instancePointer : POINTER TO BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF interfaceInstance <> 0 AND_THEN __QUERYPOINTER(interfaceInstance, instancePointer) THEN
	GetAddressFromInterface := instancePointer;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsDynamicData" Id="{4c5114c7-cc73-448a-9f8f-fa67bfde37e3}">
      <Declaration><![CDATA[(*!
<summary>Classifies the memory area only; does not prove allocation lifetime or ownership.</summary>
*)

METHOD IsDynamicData : BOOL
VAR_INPUT
	dataAddress : PVOID;
	dataSize : UDINT := 1;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsDynamicData := Tc2_System.F_CheckMemoryArea(dataAddress, dataSize) = E_TcMemoryArea.Dynamic;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{5aeb5d90-3cbf-4d4b-8537-6b3b6ccb7bea}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{464e75ad-f0ba-4929-8b1e-1713c91d4754}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryReleaseDynamicMemory" Id="{5fe5bc2a-b608-418e-9ff0-e9c1a91c92f5}">
      <Declaration><![CDATA[(*!
<summary>Caller must own a live allocation. Registered auto-disposed objects are released only by their manager.</summary>
<description>
Object FB_exit implementations must not raise exceptions. This method does not log disposal.
Returns FALSE for null/non-dynamic addresses without changing them. Catches exceptions and returns FALSE with address set to zero to prevent reuse of a possibly partially destroyed allocation.
TRUE means deletion completed. FALSE after an exception does not guarantee that memory was freed. Other aliases are not cleared and must not be used or deleted after a destruction failure. Terminal allocation state is preserved.
</description>
*)

METHOD TryReleaseDynamicMemory : BOOL
VAR_IN_OUT
	address : POINTER TO BYTE;	
END_VAR
VAR_INPUT
	isObject : BOOL;
END_VAR
VAR
	objectPointer : POINTER TO Object;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF address = 0 OR_ELSE NOT Memory.IsDynamicData(address, 1) THEN
		RETURN;
	END_IF

	IF isObject THEN
		objectPointer := address;
		
		__DELETE(objectPointer);
		address := 0;
	ELSE
		__DELETE(address);
	END_IF

	TryReleaseDynamicMemory := TRUE;
__CATCH
	address := 0;
	TryReleaseDynamicMemory := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryReleaseDynamicObject" Id="{1a29f8e6-f929-40c9-bee2-ed6219c50a45}">
      <Declaration><![CDATA[(*!
<summary>Caller must own the object; registered auto-disposed objects are released only by their manager.</summary>
<description>
Uses TryReleaseDynamicMemory. Returns FALSE for null or non-dynamic objects; non-dynamic references remain unchanged. Clears instance after successful deletion or when the release helper clears the address on an exception. Exceptions from obtaining SelfAddress are also caught with instance cleared. Other aliases remain the caller's responsibility; FALSE does not guarantee an intact object or successful deallocation.
</description>
*)

METHOD TryReleaseDynamicObject : BOOL
VAR_IN_OUT
	instance : IObject;	
END_VAR
VAR
	objectPointer : POINTER TO Object;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF instance = 0 THEN
		RETURN;
	END_IF
		
	objectPointer := instance.SelfAddress;

	TryReleaseDynamicObject := TryReleaseDynamicMemory(objectPointer, TRUE);

	IF TryReleaseDynamicObject OR_ELSE objectPointer = 0 THEN
		instance := 0;
	END_IF	
__CATCH
	instance := 0;
	TryReleaseDynamicObject := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
