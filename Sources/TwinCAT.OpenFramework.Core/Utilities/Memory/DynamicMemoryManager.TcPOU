{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
PROGRAM DynamicMemoryManager
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_AutoDisposedObjects : POINTER TO IObject;	
	{attribute 'hide'} 
	_AutoDisposedPointerCount : DWORD;
	{attribute 'hide'} 
	_AutoDisposedObjectCount : DWORD;

	{attribute 'hide'} 
	_LastSystemTaskCycleCount : UDINT;

	{attribute 'hide'}
	_AllocationFailed : BOOL; // Latched until PLC application reinitialization; cleanup does not reset it.

	{attribute 'hide'} 
	_MemoryCleanupHelper : MemoryCleanupHelper;	
END_VAR
VAR CONSTANT
	ALLOCATE_POINTER_COUNT : BYTE := 10;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service memebers" Id="{ead780a2-bf4c-47dc-a6d8-bac15c5bc6e0}" />
    <Property Name="ClassName" Id="{c33db740-6bfc-43f8-9d4d-602279175d35}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fc745387-f67a-4d86-bdee-e470addbc3c6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CleanupMemory" Id="{a080fe6a-f539-4ac0-9048-10f8d3587c3b}" FolderPath="Service memebers\">
      <Declaration><![CDATA[// Deletes registered objects; all borrowed references to them become invalid.
// Object FB_exit implementations and disposal logger/filter calls must not raise exceptions.
// During cleanup these callbacks must not register auto-disposed objects or reenter cleanup.
// Releasing their own resources remains allowed. This precondition is not checked at runtime.
METHOD CleanupMemory
VAR_INPUT
	releaseBuffer : BOOL := FALSE;
END_VAR
VAR
	i : ULINT;
	objectToDispose : POINTER TO Object;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _AutoDisposedObjectCount > 0 THEN
	FOR i := 0 TO _AutoDisposedObjectCount - 1 DO
		Memory.TryReleaseDynamicObject(_AutoDisposedObjects[i]);
	END_FOR
			
	_AutoDisposedObjectCount := 0;
END_IF

IF _AutoDisposedPointerCount > 0 AND_THEN releaseBuffer THEN
	__DELETE(_AutoDisposedObjects);
	
	_AutoDisposedPointerCount := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="cooperativeCleanupMemory" Id="{5754b7a5-6f2f-49c9-a633-b4906595d6ba}" FolderPath="Service memebers\">
      <Declaration><![CDATA[METHOD PRIVATE cooperativeCleanupMemory
VAR
	systemTaskInfo : Global.PlcTaskSystemInfo;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[systemTaskInfo := Tc2_System.F_GetTaskInfo();

IF systemTaskInfo.CycleCount <> _LastSystemTaskCycleCount THEN
	_LastSystemTaskCycleCount := systemTaskInfo.CycleCount;
	
	CleanupMemory(FALSE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{958706a2-1f53-424d-8ad1-0af68e5c53ec}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4f3b5fdf-4d9e-4c51-9c20-ce86f99117d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RegisterAutoDisposedObject" Id="{74218506-44e1-4d86-8e89-41e66c133362}" FolderPath="Service memebers\">
      <Declaration><![CDATA[// Successful registration gives this manager exclusive ownership of the dynamic object.
// Callers may borrow it until cleanup, but must not delete it or transfer its ownership.
// Must not be called while this manager is executing cleanup, including from disposal callbacks.
// Registry allocation failure latches a fatal error and raises RTSEXCPT_OUT_OF_MEMORY.
// The application boundary must call RaiseIfAllocationFailed outside recoverable exception handlers.
METHOD INTERNAL RegisterAutoDisposedObject
VAR_INPUT
	autoDisposedObject : IObject;
END_VAR
VAR
	newAutoDisposedObjects : POINTER TO IObject;
	newAutoDisposedPointerCount : DWORD;
	i : LINT;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RaiseIfAllocationFailed();

cooperativeCleanupMemory();

// skip registration id object did not created in the dynamic memory area
IF autoDisposedObject = 0 OR_ELSE NOT Memory.IsDynamicData(autoDisposedObject.SelfAddress) THEN
	RETURN;
END_IF

// prevents multiple registrations of the same object
IF _AutoDisposedObjectCount > 0 THEN
	FOR i := 0 TO TO_LINT(_AutoDisposedObjectCount) - 1 DO
		IF _AutoDisposedObjects[i] = autoDisposedObject THEN
			RETURN;
		END_IF
	END_FOR	
END_IF

IF _AutoDisposedObjectCount + 1 > _AutoDisposedPointerCount THEN
	newAutoDisposedPointerCount := _AutoDisposedPointerCount + ALLOCATE_POINTER_COUNT;
	
	newAutoDisposedObjects := __NEW(POINTER TO IObject, newAutoDisposedPointerCount);
	IF newAutoDisposedObjects = 0 THEN
		RaiseAllocationFailure();
		RETURN;
	END_IF
	
	IF _AutoDisposedObjectCount > 0 THEN
		Tc2_System.MEMCPY(newAutoDisposedObjects, _AutoDisposedObjects, TO_UDINT(XSIZEOF(POINTER TO IObject) * _AutoDisposedObjectCount));
		
		__DELETE(_AutoDisposedObjects);
	END_IF
	
	_AutoDisposedObjects := newAutoDisposedObjects;
	_AutoDisposedPointerCount := newAutoDisposedPointerCount;
END_IF

_AutoDisposedObjects[_AutoDisposedObjectCount] := autoDisposedObject;
_AutoDisposedObjectCount := _AutoDisposedObjectCount + 1;	]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseIfAllocationFailed" Id="{50bd9e86-6026-42f5-9840-3805894f952e}" FolderPath="Service memebers\">
      <Declaration><![CDATA[// Raises a latched fatal allocation failure without constructing a framework exception.
// Call at the application boundary outside handlers that could swallow this fatal error.
// Does not reset the flag, allocate a framework exception, or invoke logging/cleanup.
METHOD RaiseIfAllocationFailed]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _AllocationFailed THEN
	Tc2_System.F_RaiseException(__SYSTEM.ExceptionCode.RTSEXCPT_OUT_OF_MEMORY);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseAllocationFailure" Id="{2a951f88-56f8-4a83-aa48-d6c96c0b6514}" FolderPath="Service memebers\">
      <Declaration><![CDATA[// Latches a fatal allocation failure until application reinitialization and raises it.
// No heap exception, logging or cleanup. The application boundary must recheck the latch.
METHOD INTERNAL RaiseAllocationFailure]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AllocationFailed := TRUE;
RaiseIfAllocationFailed();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>