(*!
<summary>Owns cycle-scoped auto-disposed objects and records fatal allocation failures.</summary>
<description>
Registered objects are released by cycle cleanup. RaiseAllocationFailure is also available
to dependent libraries and does not register or transfer ownership of any object.
The fatal allocation flag persists until application reinitialization.
Registration ignores null and non-dynamic objects before accessing cyclic cleanup state.
Each cyclic PLC task owns a separate registry; references must not cross task boundaries.
Registry bounds use System.TASK_COUNT.
Call CleanupMemory after all exception consumers in each task, with or without AutomationRunner.
Fatal state is shared and synchronized; all other registry access belongs to the current task.
</description>
*)

//!<param name="_AllocationFailed">Latched until PLC application reinitialization; cleanup does not reset it.</param>

{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
PROGRAM DynamicMemoryManager
VAR CONSTANT
	ALLOCATE_POINTER_COUNT : BYTE := 10;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'}
	_TaskMemory : ARRAY [1..System.TASK_COUNT] OF TASK_MEMORY_STATE;

	{attribute 'hide'}
	_AllocationFailed : BOOL;
	{attribute 'hide'}
	_AllocationFailureLock : Tc2_System.FB_IecCriticalSection;

	{attribute 'hide'}
	_MemoryCleanupHelper : MemoryCleanupHelper;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service memebers" Id="{ead780a2-bf4c-47dc-a6d8-bac15c5bc6e0}" />
    <Property Name="ClassName" Id="{c33db740-6bfc-43f8-9d4d-602279175d35}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fc745387-f67a-4d86-bdee-e470addbc3c6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CleanupAllTasks" Id="{277e6ac8-bfb1-417b-b46f-b03cd85c424a}">
      <Declaration><![CDATA[(*!
<summary>Releases all task registries during application teardown.</summary>
<description>Internal shutdown operation only: all cyclic tasks must be stopped. Clears borrowed manager payloads before deleting objects and releasing buffers. Never call concurrently with task execution.</description>
*)

METHOD INTERNAL CleanupAllTasks
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR taskIndex := 1 TO System.TASK_COUNT DO
	cleanupTaskMemory(taskIndex, TRUE);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="CleanupMemory" Id="{a080fe6a-f539-4ac0-9048-10f8d3587c3b}">
      <Declaration><![CDATA[(*!
<summary>Deletes only the current task's registered objects and clears its exception payload.</summary>
<description>Call in a cyclic PLC task after all consumers. Borrowed references become invalid. FB_exit must not throw, register auto-disposed objects or reenter cleanup. releaseBuffer also releases this task's registry buffer; diagnostic counts remain unchanged.</description>
*)

METHOD CleanupMemory
VAR_INPUT
	releaseBuffer : BOOL := FALSE;
END_VAR
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := GetCurrentTaskIndex();

IF taskIndex = 0 THEN
	RETURN;
END_IF

cleanupTaskMemory(taskIndex, releaseBuffer);]]></ST>
      </Implementation>
    </Method>
    <Method Name="cleanupTaskMemory" Id="{10b48b5a-672d-4f3d-b7bd-26f0a00691d1}" FolderPath="Service memebers\">
      <Declaration><![CDATA[(*!
<summary>Clears one task's payload and deletes its registered objects.</summary>
<description>Called only by the owning task or during application teardown with cyclic execution stopped. taskIndex must be within the generated task table. Cleanup callbacks must not throw, register objects or reenter cleanup.</description>
*)

METHOD PRIVATE cleanupTaskMemory
VAR_INPUT
	taskIndex : DINT;
	releaseBuffer : BOOL;
END_VAR
VAR
	i : LINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ExceptionManager.CleanupTask(taskIndex);

IF _TaskMemory[taskIndex].ObjectCount > 0 THEN
	FOR i := 0 TO TO_LINT(_TaskMemory[taskIndex].ObjectCount) - 1 DO
		Memory.TryReleaseDynamicObject(_TaskMemory[taskIndex].Objects[i]);
	END_FOR

	_TaskMemory[taskIndex].ObjectCount := 0;
END_IF

IF releaseBuffer AND_THEN _TaskMemory[taskIndex].Objects <> 0 THEN
	__DELETE(_TaskMemory[taskIndex].Objects);
	_TaskMemory[taskIndex].BufferCapacity := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="cooperativeCleanupMemory" Id="{5754b7a5-6f2f-49c9-a633-b4906595d6ba}" FolderPath="Service memebers\">
      <Declaration><![CDATA[(*!
<summary>Releases the current task's remaining objects when its system cycle changes.</summary>
<description>Counts a missed cleanup only when objects from the previous cycle remain. The counter saturates at the UDINT maximum. No logging or diagnostic exception is emitted.</description>
*)

METHOD PRIVATE cooperativeCleanupMemory
VAR_INPUT
	taskIndex : DINT;
END_VAR
VAR
	systemTaskInfo : Global.PlcTaskSystemInfo;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[systemTaskInfo := Tc2_System.F_GetTaskInfo();

IF systemTaskInfo.CycleCount <> _TaskMemory[taskIndex].LastSystemTaskCycleCount THEN
	IF _TaskMemory[taskIndex].ObjectCount > 0 THEN
		IF _TaskMemory[taskIndex].MissedCleanupCount < UnsignedInt32.MAX_VALUE THEN
			_TaskMemory[taskIndex].MissedCleanupCount := _TaskMemory[taskIndex].MissedCleanupCount + 1;
		END_IF

		cleanupTaskMemory(taskIndex, FALSE);
	END_IF

	_TaskMemory[taskIndex].LastSystemTaskCycleCount := systemTaskInfo.CycleCount;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCurrentTaskIndex" Id="{a66a0c41-f14c-4d35-9c2f-df04c6e576a1}">
      <Declaration><![CDATA[(*!
<summary>Returns the current cyclic PLC task index for manager state access.</summary>
<description>Uses System.GetCurrentTaskIndex and applies the managers' cyclic-context requirement. Only indices covered by the generated system task table are accepted. Unsupported non-cyclic calls raise a native access violation without allocating an exception. Returns zero if the runtime returns from that raise.</description>
*)

METHOD INTERNAL GetCurrentTaskIndex : DINT
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := System.GetCurrentTaskIndex();

IF taskIndex < 1 OR_ELSE taskIndex > System.TASK_COUNT THEN
	Tc2_System.F_RaiseException(__SYSTEM.ExceptionCode.RTSEXCPT_ACCESS_VIOLATION);
	RETURN;
END_IF

GetCurrentTaskIndex := taskIndex;]]></ST>
      </Implementation>
    </Method>
    <Property Name="MissedCleanupCount" Id="{ea1704a2-f2f7-4189-803a-66fa66d283bf}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of fallback cleanups for the current cyclic PLC task.</summary>
<description>Increments when registration finds objects left from a previous cycle. Saturates at the UDINT maximum and resets only with application reinitialization. Read this property from the owning task; no arbitrary cross-task read is provided.</description>
*)

PROPERTY MissedCleanupCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{95222b0c-42a7-46df-8435-7b129d9d73d2}">
        <Declaration><![CDATA[VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[taskIndex := GetCurrentTaskIndex();
IF taskIndex = 0 THEN
	RETURN;
END_IF

MissedCleanupCount := _TaskMemory[taskIndex].MissedCleanupCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{958706a2-1f53-424d-8ad1-0af68e5c53ec}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4f3b5fdf-4d9e-4c51-9c20-ce86f99117d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RaiseAllocationFailure" Id="{2a951f88-56f8-4a83-aa48-d6c96c0b6514}">
      <Declaration><![CDATA[(*!
<summary>Latches a fatal allocation failure for the entire application and raises it.</summary>
<description>The latch is synchronized across tasks and cleared only by application reinitialization. No allocation, logging or cleanup is performed. The lock is released before raising. Inability to acquire the fatal-state lock also raises a native fatal error without accessing unprotected state. This method does not return normally; callers do not need a RETURN after the call.</description>
*)

METHOD RaiseAllocationFailure]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _AllocationFailureLock.Enter() THEN
	_AllocationFailed := TRUE;
	
	_AllocationFailureLock.Leave();
END_IF

Tc2_System.F_RaiseException(__SYSTEM.ExceptionCode.RTSEXCPT_OUT_OF_MEMORY);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseIfAllocationFailed" Id="{50bd9e86-6026-42f5-9840-3805894f952e}">
      <Declaration><![CDATA[(*!
<summary>Raises the application's synchronized fatal allocation state without constructing an exception object.</summary>
<description>Call at every task boundary outside recoverable handlers. A lock acquisition failure is treated as fatal rather than allowing unprotected access. The lock is released before the native raise.</description>
*)

METHOD RaiseIfAllocationFailed
VAR
	allocationFailed : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _AllocationFailureLock.Enter() THEN
	allocationFailed := _AllocationFailed;
	_AllocationFailureLock.Leave();
ELSE
	allocationFailed := TRUE;
END_IF

IF allocationFailed THEN
	Tc2_System.F_RaiseException(__SYSTEM.ExceptionCode.RTSEXCPT_OUT_OF_MEMORY);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterAutoDisposedObject" Id="{74218506-44e1-4d86-8e89-41e66c133362}">
      <Declaration><![CDATA[(*!
<summary>Registers a dynamic object under the exclusive ownership of the current cyclic PLC task's registry.</summary>
<description>Null and non-dynamic objects are ignored before accessing task state. The caller must not delete the object or share it with another task. Dynamic registration outside a cyclic task, registration during cleanup and reentrant cleanup are unsupported. Allocation failure is terminal for the application.</description>
*)

METHOD INTERNAL RegisterAutoDisposedObject
VAR_INPUT
	autoDisposedObject : IObject;
END_VAR
VAR
	taskIndex : DINT;
	newAutoDisposedObjects : POINTER TO IObject;
	newAutoDisposedPointerCount : DWORD;
	i : LINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF autoDisposedObject = 0 OR_ELSE NOT Memory.IsDynamicData(autoDisposedObject.SelfAddress) THEN
	RETURN;
END_IF

taskIndex := GetCurrentTaskIndex();
IF taskIndex = 0 THEN
	RETURN;
END_IF

RaiseIfAllocationFailed();

cooperativeCleanupMemory(taskIndex);

// prevents multiple registrations of the same object
IF _TaskMemory[taskIndex].ObjectCount > 0 THEN
	FOR i := 0 TO TO_LINT(_TaskMemory[taskIndex].ObjectCount) - 1 DO
		IF _TaskMemory[taskIndex].Objects[i] = autoDisposedObject THEN
			RETURN;
		END_IF
	END_FOR	
END_IF

IF _TaskMemory[taskIndex].ObjectCount + 1 > _TaskMemory[taskIndex].BufferCapacity THEN
	newAutoDisposedPointerCount := _TaskMemory[taskIndex].BufferCapacity + ALLOCATE_POINTER_COUNT;
	
	newAutoDisposedObjects := __NEW(POINTER TO IObject, newAutoDisposedPointerCount);
	
	IF newAutoDisposedObjects = 0 THEN
		RaiseAllocationFailure();
	END_IF
	
	IF _TaskMemory[taskIndex].ObjectCount > 0 THEN
		Tc2_System.MEMCPY(newAutoDisposedObjects, _TaskMemory[taskIndex].Objects, TO_UDINT(XSIZEOF(POINTER TO IObject) * _TaskMemory[taskIndex].ObjectCount));
		
	END_IF

	IF _TaskMemory[taskIndex].Objects <> 0 THEN
		__DELETE(_TaskMemory[taskIndex].Objects);
	END_IF

	_TaskMemory[taskIndex].Objects := newAutoDisposedObjects;
	_TaskMemory[taskIndex].BufferCapacity := newAutoDisposedPointerCount;
END_IF

_TaskMemory[taskIndex].Objects[_TaskMemory[taskIndex].ObjectCount] := autoDisposedObject;
_TaskMemory[taskIndex].ObjectCount := _TaskMemory[taskIndex].ObjectCount + 1;	]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
