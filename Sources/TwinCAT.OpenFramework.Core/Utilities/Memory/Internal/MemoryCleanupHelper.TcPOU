<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MemoryCleanupHelper" Id="{7dc830f2-0958-4a4b-8a4a-b4858028b05f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Releases every task's auto-dispose registry during application teardown.

The runtime must have stopped cyclic execution before FB_exit. This is not a cyclic cleanup entry point.
*)

FUNCTION_BLOCK INTERNAL MemoryCleanupHelper]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Exit" Id="{ab8a9fe6-b7e4-4631-afbd-30ad2c87a604}">
      <Declaration><![CDATA[(*
Clears all task payloads and releases all registered objects and registry buffers.

Called by the runtime with cyclic execution stopped. Cleanup callbacks must not throw or register objects. The
return value is not evaluated.
*)

// bInCopyCode — TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online
// change).

METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[DynamicMemoryManager.CleanupAllTasks();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
