{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE GENERIC_VALUE_COPY_RESULT :
(
	COPIED,
	INCOMPATIBLE_TYPE,
	INSUFFICIENT_CAPACITY,
	COPY_FAILED
);
END_TYPE]]></Declaration>
  </DUT>
