  <DUT Name="GENERIC_VALUE_COPY_RESULT" Id="{35ea289b-5678-41e4-a703-b8100f4f73f1}">
    <Declaration><![CDATA[(*!
<summary>Reports the outcome of copying a mapped source into existing generic value storage.</summary>
