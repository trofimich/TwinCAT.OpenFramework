<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SystemTypeClassConvertor" Id="{91216ed0-3bd5-4db8-bae4-d26622fece9b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Maps generic value categories to runtime type classes and formats runtime type names.</summary>
<description>
Maps metadata only; no payload is read or converted. OBJECT and USER_DEFINED both map to TYPE_USERDEF, without
restoring a concrete type identity. The Try method reports unsupported categories without exceptions or
dynamic allocation. Text formatting returns symbolic runtime type names, with decimal codes for unknown values.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM SystemTypeClassConvertor
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{81325192-b45e-447a-b7dd-1645415aabd9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a054da1e-96b7-460e-bce0-8a3fd3da13d2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetSystemTypeClassByGenericTypeClass" Id="{d9c3bb0b-6fa5-4b7c-8032-a6a81d60a893}">
      <Declaration><![CDATA[(*!
<summary>Returns the runtime type class corresponding to a generic category.</summary>
<description>
Uses the same mapping as TryGetSystemTypeClassByGenericTypeClass. Raises ArgumentValueNotSupportedException
for an unsupported category. UNSPECIFIED maps to TYPE_NONE; OBJECT and USER_DEFINED map to TYPE_USERDEF.
</description>
<param name="genericTypeClass">Generic category to map; an unsupported value is reported under this argument name.</param>
*)
METHOD GetSystemTypeClassByGenericTypeClass : __SYSTEM.TYPE_CLASS
VAR_INPUT
	genericTypeClass : GENERIC_TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT TryGetSystemTypeClassByGenericTypeClass(
	genericTypeClass := genericTypeClass,
	systemTypeClass => GetSystemTypeClassByGenericTypeClass
) THEN
	Exceptions.ThrowArgumentValueNotSupported(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'genericTypeClass',
		argumentValue := genericTypeClass
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{d2964ebb-b4ed-416d-8d6b-58b451189411}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>
Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c596cd02-263f-4a97-9187-3c868426ebe9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToString" Id="{a8aa7c9a-9bcc-41bd-8e99-7b4d00832be6}">
      <Declaration><![CDATA[(*!
<summary>Returns the symbolic name of a TwinCAT runtime type class as STRING.</summary>
<description>
Known Build 4026 type classes return their exact TYPE_ name. Unknown values return their unsigned decimal
code. Does not inspect payload storage, allocate dynamic memory, raise exceptions or retain state.
</description>
<param name="typeClass">Runtime type class to describe.</param>
*)
METHOD ToString : STRING(20)
VAR_INPUT
	typeClass : __SYSTEM.TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE typeClass OF
	__SYSTEM.TYPE_CLASS.TYPE_BOOL:
		ToString := 'TYPE_BOOL';
	__SYSTEM.TYPE_CLASS.TYPE_BIT:
		ToString := 'TYPE_BIT';
	__SYSTEM.TYPE_CLASS.TYPE_BYTE:
		ToString := 'TYPE_BYTE';
	__SYSTEM.TYPE_CLASS.TYPE_WORD:
		ToString := 'TYPE_WORD';
	__SYSTEM.TYPE_CLASS.TYPE_DWORD:
		ToString := 'TYPE_DWORD';
	__SYSTEM.TYPE_CLASS.TYPE_LWORD:
		ToString := 'TYPE_LWORD';
	__SYSTEM.TYPE_CLASS.TYPE_SINT:
		ToString := 'TYPE_SINT';
	__SYSTEM.TYPE_CLASS.TYPE_INT:
		ToString := 'TYPE_INT';
	__SYSTEM.TYPE_CLASS.TYPE_DINT:
		ToString := 'TYPE_DINT';
	__SYSTEM.TYPE_CLASS.TYPE_LINT:
		ToString := 'TYPE_LINT';
	__SYSTEM.TYPE_CLASS.TYPE_USINT:
		ToString := 'TYPE_USINT';
	__SYSTEM.TYPE_CLASS.TYPE_UINT:
		ToString := 'TYPE_UINT';
	__SYSTEM.TYPE_CLASS.TYPE_UDINT:
		ToString := 'TYPE_UDINT';
	__SYSTEM.TYPE_CLASS.TYPE_ULINT:
		ToString := 'TYPE_ULINT';
	__SYSTEM.TYPE_CLASS.TYPE_REAL:
		ToString := 'TYPE_REAL';
	__SYSTEM.TYPE_CLASS.TYPE_LREAL:
		ToString := 'TYPE_LREAL';
	__SYSTEM.TYPE_CLASS.TYPE_STRING:
		ToString := 'TYPE_STRING';
	__SYSTEM.TYPE_CLASS.TYPE_WSTRING:
		ToString := 'TYPE_WSTRING';
	__SYSTEM.TYPE_CLASS.TYPE_TIME:
		ToString := 'TYPE_TIME';
	__SYSTEM.TYPE_CLASS.TYPE_DATE:
		ToString := 'TYPE_DATE';
	__SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME:
		ToString := 'TYPE_DATEANDTIME';
	__SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY:
		ToString := 'TYPE_TIMEOFDAY';
	__SYSTEM.TYPE_CLASS.TYPE_POINTER:
		ToString := 'TYPE_POINTER';
	__SYSTEM.TYPE_CLASS.TYPE_REFERENCE:
		ToString := 'TYPE_REFERENCE';
	__SYSTEM.TYPE_CLASS.TYPE_SUBRANGE:
		ToString := 'TYPE_SUBRANGE';
	__SYSTEM.TYPE_CLASS.TYPE_ENUM:
		ToString := 'TYPE_ENUM';
	__SYSTEM.TYPE_CLASS.TYPE_ARRAY:
		ToString := 'TYPE_ARRAY';
	__SYSTEM.TYPE_CLASS.TYPE_PARAMS:
		ToString := 'TYPE_PARAMS';
	__SYSTEM.TYPE_CLASS.TYPE_USERDEF:
		ToString := 'TYPE_USERDEF';
	__SYSTEM.TYPE_CLASS.TYPE_NONE:
		ToString := 'TYPE_NONE';
	__SYSTEM.TYPE_CLASS.TYPE_ANY:
		ToString := 'TYPE_ANY';
	__SYSTEM.TYPE_CLASS.TYPE_ANYBIT:
		ToString := 'TYPE_ANYBIT';
	__SYSTEM.TYPE_CLASS.TYPE_ANYDATE:
		ToString := 'TYPE_ANYDATE';
	__SYSTEM.TYPE_CLASS.TYPE_ANYINT:
		ToString := 'TYPE_ANYINT';
	__SYSTEM.TYPE_CLASS.TYPE_ANYNUM:
		ToString := 'TYPE_ANYNUM';
	__SYSTEM.TYPE_CLASS.TYPE_ANYREAL:
		ToString := 'TYPE_ANYREAL';
	__SYSTEM.TYPE_CLASS.TYPE_LAZY:
		ToString := 'TYPE_LAZY';
	__SYSTEM.TYPE_CLASS.TYPE_LTIME:
		ToString := 'TYPE_LTIME';
	__SYSTEM.TYPE_CLASS.TYPE_BITCONST:
		ToString := 'TYPE_BITCONST';
	__SYSTEM.TYPE_CLASS.TYPE_UXINT:
		ToString := 'TYPE_UXINT';
	__SYSTEM.TYPE_CLASS.TYPE_XWORD:
		ToString := 'TYPE_XWORD';
	__SYSTEM.TYPE_CLASS.TYPE_XINT:
		ToString := 'TYPE_XINT';
	__SYSTEM.TYPE_CLASS.TYPE_XSTRING:
		ToString := 'TYPE_XSTRING';
	__SYSTEM.TYPE_CLASS.TYPE_VARLENARRAY:
		ToString := 'TYPE_VARLENARRAY';
	__SYSTEM.TYPE_CLASS.TYPE_ANYSTRING:
		ToString := 'TYPE_ANYSTRING';
	__SYSTEM.TYPE_CLASS.TYPE_VECTOR:
		ToString := 'TYPE_VECTOR';
	__SYSTEM.TYPE_CLASS.TYPE_LDATE:
		ToString := 'TYPE_LDATE';
	__SYSTEM.TYPE_CLASS.TYPE_LDATEANDTIME:
		ToString := 'TYPE_LDATEANDTIME';
	__SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY:
		ToString := 'TYPE_LTIMEOFDAY';

	ELSE
		ToString := TO_STRING(TO_UDINT(typeClass));
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToWideString" Id="{f3c1b95a-ffc2-44a0-902c-055d25264f74}">
      <Declaration><![CDATA[(*!
<summary>Returns the symbolic name of a TwinCAT runtime type class as WSTRING.</summary>
<description>
Known Build 4026 type classes return their exact TYPE_ name. Unknown values return their unsigned decimal
code. Does not inspect payload storage, allocate dynamic memory, raise exceptions or retain state.
</description>
<param name="typeClass">Runtime type class to describe.</param>
*)
METHOD ToWideString : WSTRING(20)
VAR_INPUT
	typeClass : __SYSTEM.TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ToWideString := TO_WSTRING(ToString(typeClass := typeClass));]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetSystemTypeClassByGenericTypeClass" Id="{3bfc8af8-64c4-4f48-88b1-4775b6605f3c}">
      <Declaration><![CDATA[(*!
<summary>Attempts to map a generic category without raising an exception.</summary>
<description>
Returns TRUE with the mapped type for supported categories, including UNSPECIFIED mapped to TYPE_NONE. Returns
FALSE with TYPE_NONE for unsupported categories. Does not allocate memory or change exception state.
</description>
*)
//!<param name="systemTypeClass">Mapped runtime type, or TYPE_NONE on failure.</param>
METHOD TryGetSystemTypeClassByGenericTypeClass : BOOL
VAR_INPUT
	genericTypeClass : GENERIC_TYPE_CLASS;
END_VAR
VAR_OUTPUT
	systemTypeClass : __SYSTEM.TYPE_CLASS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryGetSystemTypeClassByGenericTypeClass := FALSE;
systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_NONE;

CASE genericTypeClass OF
	GENERIC_TYPE_CLASS.UNSPECIFIED:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_NONE;
	GENERIC_TYPE_CLASS.BOOLEAN:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_BOOL;
	GENERIC_TYPE_CLASS.INT_8:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_SINT;
	GENERIC_TYPE_CLASS.INT_16:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_INT;
	GENERIC_TYPE_CLASS.INT_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_DINT;
	GENERIC_TYPE_CLASS.INT_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_LINT;
	GENERIC_TYPE_CLASS.UINT_8:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_USINT;
	GENERIC_TYPE_CLASS.UINT_16:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_UINT;
	GENERIC_TYPE_CLASS.UINT_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_UDINT;
	GENERIC_TYPE_CLASS.UINT_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_ULINT;
	GENERIC_TYPE_CLASS.REAL_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_REAL;
	GENERIC_TYPE_CLASS.REAL_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_LREAL;
	GENERIC_TYPE_CLASS.STRING_ASCII:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
	GENERIC_TYPE_CLASS.STRING_UTF16:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
	GENERIC_TYPE_CLASS.TIME_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_TIME;
	GENERIC_TYPE_CLASS.TIME_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_LTIME;
	GENERIC_TYPE_CLASS.DATE_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_DATE;
	GENERIC_TYPE_CLASS.DATE_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_LDATE;
	GENERIC_TYPE_CLASS.DATE_AND_TIME_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME;
	GENERIC_TYPE_CLASS.DATE_AND_TIME_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_LDATEANDTIME;
	GENERIC_TYPE_CLASS.TIME_OF_DAY_32:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY;
	GENERIC_TYPE_CLASS.TIME_OF_DAY_64:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY;
	GENERIC_TYPE_CLASS.POINTER_TO:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_POINTER;
	GENERIC_TYPE_CLASS.USER_DEFINED:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_USERDEF;
	GENERIC_TYPE_CLASS.OBJECT:
		systemTypeClass := __SYSTEM.TYPE_CLASS.TYPE_USERDEF;

	ELSE
		RETURN;
END_CASE

TryGetSystemTypeClassByGenericTypeClass := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>