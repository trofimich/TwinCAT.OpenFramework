<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="GENERIC_TYPE_CLASS" Id="{a64451b3-d527-4a0d-9cad-4900565180ca}">
    <Declaration><![CDATA[(*!
<summary>Identifies the representation described by a GENERIC_VALUE.</summary>
<description>
The tag does not validate the address or payload size and does not imply ownership. UNSPECIFIED represents an
unset type.
STRING_8 represents IEC STRING with 8-bit code units. STRING_16 represents IEC WSTRING with 16-bit code units.
These tags describe storage representation. The encoding used for text conversion is documented by each operation.
</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE GENERIC_TYPE_CLASS :
(
	UNSPECIFIED := 0,
    BOOLEAN,
    INT_8,
    INT_16,
    INT_32,
    INT_64,
    UINT_8,
    UINT_16,
    UINT_32,
    UINT_64,
    REAL_32,
    REAL_64,
    STRING_8,
    STRING_16,
    TIME_32,
    TIME_64,
    DATE_32,
    DATE_64,
    DATE_AND_TIME_32,
    DATE_AND_TIME_64,
    TIME_OF_DAY_32,
    TIME_OF_DAY_64,
    POINTER_TO,
    USER_DEFINED,
    OBJECT
) BYTE;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>