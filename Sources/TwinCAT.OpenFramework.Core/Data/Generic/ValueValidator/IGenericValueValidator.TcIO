<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IGenericValueValidator" Id="{7dad695e-3ff1-4d4a-a4f7-428b8a6f5965}">
    <Declaration><![CDATA[(*!
<summary>Defines validation of a borrowed generic value.</summary>
<description>The implementation defines acceptance criteria. Returning normally means those criteria passed; validation failures are reported by exceptions. The read-only argument does not transfer ownership.</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

INTERFACE IGenericValueValidator EXTENDS IObject]]></Declaration>
    <Method Name="Validate" Id="{e910886f-ea56-48f1-bf3c-15978736c0be}">
      <Declaration><![CDATA[(*!
<summary>Checks a generic value against implementation-defined acceptance criteria.</summary>
<description>Returns normally on acceptance; otherwise reports validation failure through an exception. validatedObjectName identifies the input in diagnostics. valueToValidate is borrowed read-only; ownership is unchanged. Exact criteria belong to the concrete validator.</description>
*)
METHOD Validate
VAR_INPUT
	validatedObjectName : WSTRING;
END_VAR
VAR_IN_OUT CONSTANT
	valueToValidate : GENERIC_VALUE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>