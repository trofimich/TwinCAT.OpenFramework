(*!
<summary>Creates and inspects borrowed system AnyType descriptors.</summary>
<description>Descriptors reference existing storage; creating one does not copy the payload or transfer ownership. The caller keeps the referenced storage alive and consistent with its type and size.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM SystemAnyTypes
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CheckIsNull" Id="{6872bbfd-fcf4-4ff1-8861-988ed289e280}">
      <Declaration><![CDATA[(*!
<summary>Detects an empty AnyType descriptor.</summary>
<description>Returns TRUE if its address or byte size is zero, or its type is TYPE_NONE. Does not dereference the address and is not a memory-lifetime check.</description>
*)
METHOD CheckIsNull : BOOL
VAR_INPUT
	value : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckIsNull := value.pValue = 0 OR_ELSE value.diSize = 0 OR_ELSE value.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_NONE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{bc62ea28-f530-4c6b-8182-b79f5d9e4fc4}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{77144c18-f2c0-4f0f-bd6d-c1cae1fcd65a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CreateAnyTypeByAny" Id="{1f2becd5-4a43-4d75-827f-7c56c084215c}">
      <Declaration><![CDATA[(*!
<summary>Copies the descriptor generated for an ANY argument.</summary>
<description>The result borrows the original payload, not a copy. Keep the source storage alive and unchanged in representation while using the descriptor; do not retain descriptors of temporary arguments.</description>
<param name="anyValue">Source ANY argument descriptor.</param>
*)
METHOD CreateAnyTypeByAny : __SYSTEM.AnyType
VAR_INPUT
	anyValue : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CreateAnyTypeByAny := anyValue;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateAnyTypeByGenericValue" Id="{73f9d3c1-a03b-4864-9d65-f396047544c5}">
      <Declaration><![CDATA[(*!
<summary>Creates a borrowed AnyType descriptor for generic storage.</summary>
<description>Checks Size before converting it to the signed DINT size field. A size above SignedInt32.MAX_VALUE raises ArgumentOutOfRangeException before any result fields are assigned. Type mapping exceptions propagate. The payload is neither accessed nor copied, and ownership is unchanged; the caller keeps it alive while the returned descriptor is used.</description>
*)
//!<param name="genericValue">Source descriptor whose address, mapped type and representable byte size form the result.</param>
METHOD CreateAnyTypeByGenericValue : __SYSTEM.AnyType
VAR_IN_OUT CONSTANT
	genericValue : GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF genericValue.Size > TO_ULINT(SignedInt32.MAX_VALUE) THEN
	Exceptions.ThrowArgumentOutOfRange(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'genericValue.Size', genericValue.Size);
END_IF

CreateAnyTypeByGenericValue.TypeClass := SystemTypeClassConvertor.GetSystemTypeClassByGenericTypeClass(genericValue.TypeClass);
CreateAnyTypeByGenericValue.pValue := genericValue.Address;
CreateAnyTypeByGenericValue.diSize := TO_DINT(genericValue.Size);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateAnyTypeByVarInfo" Id="{786b651b-8e3b-4870-8d5b-501fc8b1717d}">
      <Declaration><![CDATA[(*!
<summary>Copies the descriptor generated for an __SYSTEM.VAR_INFO argument.</summary>
<description>The result borrows the original payload, not a copy. Keep the source storage alive and unchanged in representation while using the descriptor; do not retain descriptors of temporary arguments.</description>
<param name="varInfo">Input variable information descriptor.</param>
*)
METHOD CreateAnyTypeByVarInfo : __SYSTEM.AnyType
VAR_IN_OUT CONSTANT
	varInfo : __SYSTEM.VAR_INFO;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CreateAnyTypeByVarInfo.TypeClass := varInfo.TypeClass;
CreateAnyTypeByVarInfo.pValue := varInfo.ByteAddress;
CreateAnyTypeByVarInfo.diSize := TO_DINT((varInfo.BitSize + 7) / 8);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{8304df90-847d-4024-9242-86baaf0a63ef}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{847b0818-cabd-4275-a44e-d5ee2eb75ef9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>