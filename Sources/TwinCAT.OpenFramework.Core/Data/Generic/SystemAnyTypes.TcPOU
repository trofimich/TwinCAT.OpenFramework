<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SystemAnyTypes" Id="{6a7e7caf-8e80-4ccf-abb4-b450c8a2b399}" SpecialFunc="None">
    <Declaration><![CDATA[(*
