<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="UnsignedInt32" Id="{6bac338b-229a-43e9-a30f-455531e1f310}" SpecialFunc="None">
    <Declaration><![CDATA[(*!
<summary>Provides finite bounds and zero for UnsignedInt32 values.</summary>
<description>ZERO represents an empty count; MIN_VALUE and MAX_VALUE describe the represented integer range; constants perform no conversion or runtime validation. Additional named bounds, where declared, describe narrower representations.</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM UnsignedInt32
VAR CONSTANT
	//! <summary>Zero unsigned value for empty counts and absent lengths.</summary>
	ZERO : UDINT := 0;
	MIN_VALUE : UDINT := 0;
	MAX_VALUE : UDINT := UDINT#16#FFFFFFFF;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{078f51d7-7a9e-4bef-a7f8-cb5013aa458a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c0ad2f36-6652-4fd6-8323-ef857fb2ba2a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ee80b6e7-69cd-4ea9-a37e-1cd7459c76b6}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e83e0b93-d2f7-4e66-89bd-17343024db2f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>