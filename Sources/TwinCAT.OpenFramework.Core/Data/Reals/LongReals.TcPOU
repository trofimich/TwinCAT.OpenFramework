<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LongReals" Id="{8e3c2d57-ec4d-4c6a-97da-06811177b941}" SpecialFunc="None">
    <Declaration><![CDATA[(*!
<summary>Provides finite LREAL bounds and special floating-point constants.</summary>
<description>
MIN_VALUE is the most negative finite LREAL; MAX_VALUE is the largest positive finite LREAL.
The IEEE 754 binary64 representation stores a sign, an exponent and a fraction in 64 bits.
A mask is an integer pattern used with bitwise AND to retain selected bits and clear the others.
Use these masks with the union Raw member; converting a floating value to an integer does not expose its stored bits.
The masks classify infinity, NaN and signed zero without evaluating NaN operands.
The _BITS constants are complete representations, used to choose one representation for values treated as equal.
Generic REAL/LREAL equality and hashing share the binary64 constants in LongReals after non-NaN REAL values are converted to LREAL.
Infinity constants expose their numeric value through the union Value member.
NOT_A_NUMBER remains computed with LOG(-1) for compatibility with the project's compiler; native equality does not identify NaN.
</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

//!<param name="POSITIVE_INFINITY">IEEE 754 +Infinity</param>

//!<param name="NEGATIVE_INFINITY">IEEE 754 -Infinity</param>

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM LongReals
VAR CONSTANT
	(*!
	<summary>Selects the exponent field in the stored LREAL bits.</summary>
	<description>IEEE 754 binary64 stores the exponent in bits 62..52 (bit 0 is the least significant). Raw AND EXPONENT_MASK keeps these bits and clears the sign and fraction. If the result equals EXPONENT_MASK, the value is infinity or NaN; FRACTION_MASK distinguishes the two. Apply this mask to the Raw member of the union, without converting the floating value to an integer.</description>
	*)
	EXPONENT_MASK : ULINT := ULINT#16#7FF0000000000000;
	(*!
	<summary>Selects the stored fraction field in the LREAL bits.</summary>
	<description>Raw AND FRACTION_MASK keeps bits 51..0, which store the fraction of the significand, and clears the sign and exponent. When all exponent bits are set, a zero fraction means infinity and a nonzero fraction means NaN. This field is part of the binary representation; it is not the decimal part after the decimal point.</description>
	*)
	FRACTION_MASK : ULINT := ULINT#16#000FFFFFFFFFFFFF;
	(*!
	<summary>Removes the sign bit from the stored LREAL bits.</summary>
	<description>Raw AND MAGNITUDE_MASK clears sign bit 63 and preserves the exponent and fraction. Both positive zero and negative zero then produce ZERO_BITS, allowing either zero to be recognized without floating-point comparison. The result is an integer bit pattern, not a numeric conversion or a computed floating-point absolute value.</description>
	*)
	MAGNITUDE_MASK : ULINT := ULINT#16#7FFFFFFFFFFFFFFF;
	(*!
	<summary>Provides one chosen quiet NaN bit pattern for LREAL.</summary>
	<description>NaN means not a number and has multiple IEEE 754 encodings. This constant chooses one quiet NaN representation: all exponent bits and the highest fraction bit are set, with all other bits clear. Canonical means that different encodings can be mapped to this single pattern. Generic equality and hashing use this pattern for every REAL and LREAL NaN, so equal NaN values also receive equal hashes. This is an integer bit pattern; the union Value member provides its floating-point interpretation. It is not a mask or a value to compare numerically with NaN.</description>
	*)
	CANONICAL_NAN_BITS : ULINT := ULINT#16#7FF8000000000000;

	(*!
	<summary>Provides the all-zero bit pattern representing positive LREAL zero.</summary>
	<description>Negative zero differs only in its sign bit. This constant is the integer bit representation of positive zero. Generic equality and hashing map both signed zeros to this pattern, so equal zeros also receive equal hashes. Use it with Raw or the result of Raw AND MAGNITUDE_MASK.</description>
	*)
	ZERO_BITS : ULINT := ULINT#0;

	//!<summary>Most negative finite IEEE 754 binary64 value; this is not the smallest positive value.</summary>
	MIN_VALUE : LREAL := -1.7976931348623158E+308;
	//!<summary>Largest positive finite IEEE 754 binary64 value.</summary>
	MAX_VALUE : LREAL := +1.7976931348623158E+308;

    POSITIVE_INFINITY : LREAL_UNION := (Raw := 16#7FF0000000000000); 
    NEGATIVE_INFINITY : LREAL_UNION := (Raw := 16#FFF0000000000000); 
    NOT_A_NUMBER : LREAL := LOG(-1); //LREAL_UNION := (Raw := 16#7FF8000000000000); // IEEE 754 NaN	
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{dec151f8-ad14-4f84-8a65-a10b7a729f04}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{609b9324-4979-4f22-9ee4-d3b56f82666c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{3472afc4-85a8-4119-a5ca-dd94ad244223}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bb7fe1cc-c438-48fc-b6cd-d6a3e2da25f3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
