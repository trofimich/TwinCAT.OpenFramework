(*!
<summary>Provides TIME limits, duration constants and conversions from common duration units.</summary>
<description>Conversion methods scale the input to milliseconds. The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM Times
VAR CONSTANT
	MIN_VALUE : TIME := T#0S;
	MAX_VALUE : TIME := T#49D17H2M47S295MS;

	//!<summary>Duration of one day; exclusive upper bound for time-of-day values.</summary>
	ONE_DAY : TIME := T#24h;

	//!<summary>One second expressed at TIME precision, used to scale seconds to milliseconds.</summary>
	ONE_SECOND : TIME := T#1s;

	//!<summary>Number of seconds in one day, used to separate the calendar date from a second-based timestamp.</summary>
	SECONDS_PER_DAY : UDINT := 86400;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{148a52cb-3e43-4dbc-a545-59d7740959a8}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8210793d-9d99-4b04-a539-264ebcad73ff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FromDays" Id="{390c9b6f-a634-439d-b6d0-7476a9d4912c}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in days to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInDays">Duration expressed in days.</param>
METHOD FromDays : TIME
VAR_INPUT
	timeInDays : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromDays := TO_TIME(timeInDays * 86_400_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromHours" Id="{687b243f-8af6-4e62-be38-76c24ff36452}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in hours to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInHours">Duration expressed in hours.</param>
METHOD FromHours : TIME
VAR_INPUT
	timeInHours : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromHours := TO_TIME(timeInHours * 3_600_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromMicroseconds" Id="{9d477e7d-9923-4334-8456-c1533ec4544e}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in microseconds to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInMicroseconds">Duration expressed in microseconds.</param>
METHOD FromMicroseconds : TIME
VAR_INPUT
	timeInMicroseconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromMicroseconds := TO_TIME(timeInMicroseconds / 1_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromMilliseconds" Id="{95b2f685-1540-48a1-a0b4-e10203268642}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in milliseconds to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInMilliseconds">Duration expressed in milliseconds.</param>
METHOD FromMilliseconds : TIME
VAR_INPUT
	timeInMilliseconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromMilliseconds := TO_TIME(timeInMilliseconds);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromMinutes" Id="{dfb998f2-abc0-41b3-bc54-fad6637b7e42}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in minutes to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInMinutes">Duration expressed in minutes.</param>
METHOD FromMinutes : TIME
VAR_INPUT
	timeInMinutes : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromMinutes := TO_TIME(timeInMinutes * 60_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromNanoseconds" Id="{95e8db08-3fe1-40e7-82df-99ad4605a07d}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in nanoseconds to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInNanoseconds">Duration expressed in nanoseconds.</param>
METHOD FromNanoseconds : TIME
VAR_INPUT
	timeInNanoseconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromNanoseconds := TO_TIME(timeInNanoseconds / 1_000_000);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromSeconds" Id="{a5877ac6-23c5-4568-acf5-e14d65a8d618}">
      <Declaration><![CDATA[(*!
<summary>Converts a duration in seconds to TIME.</summary>
<description>The caller supplies a finite, non-negative value whose scaled duration fits in TIME. No runtime validation is performed. Scaling uses LREAL arithmetic followed by the native TO_TIME conversion; fractional precision and rounding follow those operations.</description>
*)
//!<param name="timeInSeconds">Duration expressed in seconds.</param>
METHOD FromSeconds : TIME
VAR_INPUT
	timeInSeconds : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromSeconds := TO_TIME(timeInSeconds * 1_000);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{081d7ed7-585a-4f39-b58b-59949db0e602}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{aea78672-9cbf-4872-bd7a-c2003f26bcb2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>