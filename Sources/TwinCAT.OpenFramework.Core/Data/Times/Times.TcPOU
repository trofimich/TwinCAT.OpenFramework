<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Times" Id="{5ace14d5-853c-4d72-a3c4-1b7d3f8c8b8a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
