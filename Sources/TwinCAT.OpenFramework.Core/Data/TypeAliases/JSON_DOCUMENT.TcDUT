<TcPlcObject Version="1.1.0.1">
  <DUT Name="JSON_DOCUMENT" Id="{1c584fbf-bc67-4669-8e1b-884fc72f5a93}">
    <Declaration><![CDATA[(*!
<summary>Provides fixed-capacity storage for JSON text.</summary>
<description>Holds up to 25000 STRING bytes plus the terminator. The alias does not parse or validate JSON.</description>
*)
