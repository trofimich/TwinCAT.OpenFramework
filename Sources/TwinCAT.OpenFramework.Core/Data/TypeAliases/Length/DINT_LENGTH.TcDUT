<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="DINT_LENGTH" Id="{370b5060-1d88-4d8d-aceb-c3b1f396a9a6}">
    <Declaration><![CDATA[(*!
<summary>Represents a nonnegative DINT-sized length.</summary>
<description>The declared range is 0 through 2147483647. Units and available storage depend on the consuming operation.</description>
*)
TYPE DINT_LENGTH : DINT(0..2147483647); END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>