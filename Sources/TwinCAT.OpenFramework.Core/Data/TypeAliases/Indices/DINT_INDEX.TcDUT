<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="DINT_INDEX" Id="{7106e443-8523-4f81-9862-83fecc04cc09}">
    <Declaration><![CDATA[(*!
<summary>Represents a nonnegative index below the maximum DINT length.</summary>
<description>The declared range is 0 through 2147483646; callers must also respect the actual indexed container bounds.</description>
*)
TYPE DINT_INDEX : DINT(0..SignedInt32.MAX_VALUE - 1); END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>