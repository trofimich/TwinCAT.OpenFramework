<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Bits" Id="{ea1051e7-af64-48c6-9b9d-4d54221ed779}" SpecialFunc="None">
    <Declaration><![CDATA[(*
