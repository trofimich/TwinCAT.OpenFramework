(*!
<summary>Extracts inclusive bit ranges from BYTE, WORD, DWORD and LWORD values.</summary>
<description>Bit zero is the least significant bit. Extracted ranges are shifted to bit zero; bits outside the range are discarded.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM Bits
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{882eaad1-a2dd-49c9-890e-bf39d4412e82}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{91f3c59b-5a11-4be4-9371-e0ca99635198}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetBitsFromByte" Id="{47f438c7-c09f-45c8-a2ed-dcc0a3f88818}">
      <Declaration><![CDATA[(*!
<summary>Extracts an inclusive bit range and shifts it to the least significant bit.</summary>
<description>Returns the selected field with all higher bits cleared. Throws ArgumentOutOfRangeException for an index outside the input width, or StandardException when firstBitIndex exceeds lastBitIndex. The input value is unchanged.</description>
*)
//!<param name="value">Value containing the bit field.</param>
//!<param name="firstBitIndex">Inclusive lower bit index; zero denotes the least significant bit.</param>
//!<param name="lastBitIndex">Inclusive upper bit index.</param>
METHOD GetBitsFromByte : BYTE
VAR_INPUT
	value : BYTE;
	firstBitIndex : BYTE(0..7);
	lastBitIndex : BYTE(0..7);
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	indexOutOfRangeException : ArgumentOutOfRangeException;
	standardException : StandardException;

	upperBitShift : BYTE;
END_VAR
VAR CONSTANT
	BIT_COUNT : BYTE := SIZEOF(BYTE) * 8;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF firstBitIndex >= BIT_COUNT THEN
	indexOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'firstBitIndex', firstBitIndex);
END_IF

IF lastBitIndex >= BIT_COUNT THEN
	indexOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'lastBitIndex', lastBitIndex);
END_IF

IF firstBitIndex > lastBitIndex THEN
	formattedExceptionMessage := WideStrings.Concat255("Argument firstBitIndex = ", TO_WSTRING(firstBitIndex), " is greater than lastBitIndex = ", TO_WSTRING(lastBitIndex));

	standardException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);	
END_IF

upperBitShift := BIT_COUNT - lastBitIndex - 1;

GetBitsFromByte := SHL(value, upperBitShift);
GetBitsFromByte := SHR(GetBitsFromByte, upperBitShift + firstBitIndex);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetBitsFromDWord" Id="{c27d98c8-184f-41e1-91c5-b6e0313f2830}">
      <Declaration><![CDATA[(*!
