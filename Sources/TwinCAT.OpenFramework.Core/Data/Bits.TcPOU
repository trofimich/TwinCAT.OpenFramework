upperBitShift := BIT_COUNT - lastBitIndex - 1;

GetBitsFromWord := SHL(value, upperBitShift);
GetBitsFromWord := SHR(GetBitsFromWord, upperBitShift + firstBitIndex);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{cbb88c09-539f-4389-885b-2fa8602f4b80}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c4ae4d79-43b0-4cee-9a98-b4449b8bb601}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>