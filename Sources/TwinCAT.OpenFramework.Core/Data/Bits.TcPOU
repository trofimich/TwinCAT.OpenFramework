    <Method Name="GetBitsFromWord" Id="{5250af8a-cbf7-4154-94e5-93b6741e61a2}">
      <Declaration><![CDATA[(*!
<summary>Extracts an inclusive bit range and shifts it to the least significant bit.</summary>
<description>Returns the selected field with all higher bits cleared. Throws ArgumentOutOfRangeException for an index outside the input width, or StandardException when firstBitIndex exceeds lastBitIndex. The input value is unchanged.</description>
*)
//!<param name="value">Value containing the bit field.</param>
//!<param name="firstBitIndex">Inclusive lower bit index; zero denotes the least significant bit.</param>
//!<param name="lastBitIndex">Inclusive upper bit index.</param>
METHOD GetBitsFromWord : WORD
VAR_INPUT
