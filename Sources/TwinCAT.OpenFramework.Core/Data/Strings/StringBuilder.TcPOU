(*!
<summary>Builds a byte string in an owned, reusable dynamic buffer.</summary>
<description>STRING inputs are appended as bytes without a 255-character intermediate buffer or encoding conversion. Other ANY types retain InternalAnyToString255 conversion. AppendString255 methods remain limited by their declared input type. Input storage is borrowed only during the call; StringAddress is invalidated by buffer growth or release. Clear(FALSE) retains the buffer and clears only its first terminator; remaining bytes are not erased. Use each instance from one task. The first allocation reserves at least INITIAL_CAPACITY characters; subsequent growth doubles capacity or uses the required length if larger. If doubling exceeds the allocation size limit, only the required length is reserved. Allocation failure uses the terminal DynamicMemoryManager path. AssignToString requires enough space for the complete text and its terminator. Do not copy an instance by assignment or pass it by value while it owns an allocated buffer; use references instead. Assignment does not clone the buffer or transfer ownership. Do not overwrite an instance that still owns a buffer.</description>
*)
{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
FUNCTION_BLOCK StringBuilder EXTENDS Object
VAR CONSTANT
	//!<summary>Minimum character capacity of the first allocation, excluding the terminator.</summary>
	INITIAL_CAPACITY : UDINT := 80;

	STRING_CHAR_SIZE : BYTE := 1;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_String : POINTER TO STRING;
	{attribute 'hide'} 
	_Length : UDINT;
	{attribute 'hide'} 
	_Capacity : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{34b67e1e-1d4d-4b5f-af2a-6efd13b4a7ef}" />
    <Method Name="Append" Id="{80786741-a12b-4915-89e9-e9f6a8437fc0}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the byte string under the method's input rules.</summary>
<description>Appends a STRING directly without the 255-character conversion limit; other ANY types retain their existing conversion. Returns this builder for chaining. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL Append : REFERENCE TO StringBuilder
VAR_INPUT
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalAppend(value);

Append REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendIf" Id="{ded300a7-9567-4b8d-8608-da0a3e173fbe}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the byte string under the method's input rules.</summary>
<description>When condition is TRUE, appends using the same conversion rules as Append. Otherwise leaves the buffer unchanged. Returns this builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL AppendIf : REFERENCE TO StringBuilder
VAR_INPUT
	value : ANY;
	condition : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	InternalAppend(value);
END_IF

AppendIf REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendString" Id="{c758facf-0415-4d15-b100-4f126030229f}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the byte string under the method's input rules.</summary>
<description>Borrows a null-terminated STRING for this call and appends its text without a STRING(255) intermediate value. Returns this builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL AppendString : REFERENCE TO StringBuilder
VAR_IN_OUT CONSTANT
	value : STRING;
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
valueDescriptor.pValue := ADR(value);
valueDescriptor.diSize := TO_DINT(Tc2_Utilities.LEN2(ADR(value))) + 1;

InternalAppend(valueDescriptor);

AppendString REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendString255" Id="{2f5b2724-de01-4724-830a-faca48aa138c}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the byte string under the method's input rules.</summary>
<description>Appends the supplied STRING(255). The public input type limits this overload to 255 characters. Returns this builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL AppendString255 : REFERENCE TO StringBuilder
VAR_INPUT
	value : STRING(255);
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
valueDescriptor.pValue := ADR(value);
valueDescriptor.diSize := TO_DINT(Tc2_Utilities.LEN2(ADR(value))) + 1;

InternalAppend(valueDescriptor);

AppendString255 REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendString255If" Id="{9e857820-5d79-4de0-92e4-96cde56b2a56}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the byte string under the method's input rules.</summary>
<description>When condition is TRUE, appends the supplied STRING(255). The input type limits this overload to 255 characters. Returns this builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL AppendString255If : REFERENCE TO StringBuilder
VAR_INPUT
	value : STRING(255);
	condition : BOOL;
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
	valueDescriptor.pValue := ADR(value);
	valueDescriptor.diSize := TO_DINT(Tc2_Utilities.LEN2(ADR(value))) + 1;
	
	InternalAppend(valueDescriptor);
END_IF

AppendString255If REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendStringIf" Id="{58991056-7390-448e-8747-f0383b6b8ccb}">
      <Declaration><![CDATA[(*!
<summary>Adds a value to the byte string under the method's input rules.</summary>
<description>When condition is TRUE, appends the borrowed STRING without a STRING(255) intermediate value. Otherwise leaves the buffer unchanged. Returns this builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL AppendStringIf : REFERENCE TO StringBuilder
VAR_IN_OUT CONSTANT
	value : STRING;
END_VAR
VAR_INPUT
	condition : BOOL;
END_VAR
VAR
	valueDescriptor : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	valueDescriptor.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
	valueDescriptor.pValue := ADR(value);
	valueDescriptor.diSize := TO_DINT(Tc2_Utilities.LEN2(ADR(value))) + 1;
	
	InternalAppend(valueDescriptor);
END_IF

AppendStringIf REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AssignToString" Id="{0a303461-f7d1-498f-8e6a-c7de66a64b56}">
      <Declaration><![CDATA[(*!
<summary>Copies the complete built text into a caller-owned STRING.</summary>
<description>The target must hold all characters and one terminator. Wrong type or insufficient capacity raises the existing argument exception. An empty builder writes only the terminator. Returns whether all character bytes were copied; does not truncate. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD FINAL AssignToString : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR
	targetStringPointer : POINTER TO STRING;
	textSize : UDINT;
 
	invalidTargetStringTypeException : ArgumentTypeClassNotSupportedException;
	invalidTargetStringSizeException : TargetVariableMemoryOverflowException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	invalidTargetStringTypeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', targetString.TypeClass);
END_IF

IF TO_ULINT(targetString.diSize) < TO_ULINT(StringByteSize) THEN
	invalidTargetStringSizeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize));
END_IF

targetStringPointer := targetString.pValue;

textSize := _Length * STRING_CHAR_SIZE;
IF textSize > 0 THEN
	AssignToString := Tc2_System.MEMCPY(targetStringPointer, _String, textSize) = textSize;
ELSE
	AssignToString := TRUE;
END_IF

Tc2_System.MEMSET(targetString.pValue + textSize, 0, STRING_CHAR_SIZE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Capacity" Id="{1e6ef900-fba1-4ba8-8de8-3294582ea90f}">
      <Declaration><![CDATA[(*!
<summary>Returns the reserved character capacity.</summary>
<description>The capacity excludes the terminating zero and does not describe the current text length. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Capacity : UDINT]]></Declaration>
      <Get Name="Get" Id="{d019026a-a852-4a0c-a9af-414c165453fc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Capacity := _Capacity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{3feb1037-c4b3-4e06-a2a2-59afb847dd87}">
      <Declaration><![CDATA[(*!
<summary>Provides the diagnostic type name without copying its storage.</summary>
<description>Borrowed read-only reference. Do not modify the referenced name; keep the owning instance alive while using the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING
]]></Declaration>
      <Get Name="Get" Id="{44e92c15-94f5-4051-b164-9c70cb1085dc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{32f82a80-c61b-4a26-8ff1-0f270c0e09e3}">
      <Declaration><![CDATA[(*!
<summary>Clears the logical string, optionally releasing its buffer.</summary>
<description>Sets length to zero. With FALSE, preserves the allocation, capacity and buffer address and writes only the first null terminator; old contents beyond it are not erased. With TRUE, releases the allocation and resets capacity, invalidating borrowed buffer references. Does not allocate. Returns a reference to this builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
//!<param name="releaseMemory">TRUE releases the buffer; FALSE keeps it available for reuse without clearing its entire contents.</param>
METHOD FINAL Clear : REFERENCE TO StringBuilder
VAR_INPUT
	releaseMemory : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Length := 0;

IF _Capacity > 0 THEN
	IF releaseMemory THEN
		__DELETE(_String);	
		_Capacity := 0;	
	ELSE
		Tc2_System.MEMSET(_String, 0, STRING_CHAR_SIZE);
	END_IF	
END_IF

Clear REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearIf" Id="{9fe3a161-5d4b-4b84-8106-aa11189315d1}">
      <Declaration><![CDATA[(*!
<summary>Conditionally clears the builder.</summary>
<description>When condition is TRUE, delegates to Clear with the requested releaseMemory policy. Otherwise preserves the buffer and text. Returns this builder for chaining. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
METHOD FINAL ClearIf : REFERENCE TO StringBuilder
VAR_INPUT
	condition : BOOL;
	releaseMemory : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF condition THEN
	Clear(releaseMemory);
END_IF

ClearIf REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{7a2eb7ec-2a10-41ef-b871-8cb033f0381b}">
      <Declaration><![CDATA[(*!
<summary>Releases the builder buffer on destruction.</summary>
<description>Clears the text and releases owned dynamic storage. Borrowed buffer references become invalid; lifecycle cleanup must not raise exceptions.</description>
*)
//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear(TRUE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAppend" Id="{668d8a31-60bb-4f6d-9327-f458f63b2a0f}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends a complete STRING or the existing formatted representation of another type.</summary>
<description>The descriptor must identify valid input storage. STRING is read up to its terminator within diSize. The source may refer to the current buffer: it is copied before the old allocation is released. Other types retain the 255-character conversion. Empty input is a no-op. Growth starts at INITIAL_CAPACITY and then doubles capacity unless the required length is larger; when doubling exceeds the byte-allocation limit, growth uses only the required length. Allocation failure leaves the existing buffer intact and raises the terminal allocation error without returning normally. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)

METHOD PROTECTED FINAL InternalAppend 
VAR_IN_OUT CONSTANT
	value : __SYSTEM.AnyType;
END_VAR
VAR
	stringToAppend : STRING(255);	
	
	sourceAddress : POINTER TO BYTE;
	
	stringToAppendLength : UDINT;
	
	requiredLength : ULINT;
	
	newString : POINTER TO BYTE;
	newCapacity : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	sourceAddress := value.pValue;
	
	WHILE stringToAppendLength < TO_UDINT(value.diSize / STRING_CHAR_SIZE) AND_THEN sourceAddress[stringToAppendLength] <> 0 DO
		stringToAppendLength := stringToAppendLength + 1;
	END_WHILE
ELSE
	stringToAppend := Strings.InternalAnyToString255(value);
	
	sourceAddress := ADR(stringToAppend);
	
	stringToAppendLength := TO_UDINT(Tc2_Standard.LEN(stringToAppend));
END_IF

IF stringToAppendLength = 0 THEN
	RETURN;
END_IF

requiredLength := TO_ULINT(_Length) + stringToAppendLength;

IF requiredLength > (TO_ULINT(UnsignedInt32.MAX_VALUE) / STRING_CHAR_SIZE) - 1 THEN
	DynamicMemoryManager.RaiseAllocationFailure();
END_IF

IF requiredLength > _Capacity THEN
	newCapacity := TO_UDINT(requiredLength);
	
	IF _Capacity = 0 THEN
		IF newCapacity < INITIAL_CAPACITY THEN
			newCapacity := INITIAL_CAPACITY;
		END_IF
	ELSIF requiredLength < TO_ULINT(_Capacity) * 2 AND_THEN TO_ULINT(_Capacity) * 2 <= (TO_ULINT(UnsignedInt32.MAX_VALUE) / STRING_CHAR_SIZE) - 1 THEN
		newCapacity := TO_UDINT(TO_ULINT(_Capacity) * 2);
	END_IF

	newString := __NEW(BYTE, (STRING_CHAR_SIZE + (newCapacity * STRING_CHAR_SIZE)));
	
	IF newString = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	IF _Length > 0 THEN
		Tc2_System.MEMCPY(newString, _String, _Length * STRING_CHAR_SIZE);
	END_IF
	
	Tc2_System.MEMCPY(newString + (_Length * STRING_CHAR_SIZE), sourceAddress, stringToAppendLength * STRING_CHAR_SIZE);
	Tc2_System.MEMSET(newString + (TO_UDINT(requiredLength) * STRING_CHAR_SIZE), 0, STRING_CHAR_SIZE);

	IF _String <> 0 THEN
		__DELETE(_String);
	END_IF
	
	_String := newString;
	_Capacity := newCapacity;
ELSE
	newString := _String;
	
	Tc2_System.MEMCPY(newString + (_Length * STRING_CHAR_SIZE), sourceAddress, stringToAppendLength * STRING_CHAR_SIZE);
	Tc2_System.MEMSET(newString + (TO_UDINT(requiredLength) * STRING_CHAR_SIZE), 0, STRING_CHAR_SIZE);
END_IF

_Length := TO_UDINT(requiredLength);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{e85fed95-9d96-4e77-82f9-82b73c747842}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{800cb725-2f44-417e-b2fb-44ce8786af16}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{115e42a6-ab9e-466a-968b-e275a0a6ead2}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{23fb216a-db3f-4d6a-93fd-497b787376af}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StringAddress" Id="{91ca68a3-f5dc-4926-bdd2-2407e17bdfce}">
      <Declaration><![CDATA[(*!
<summary>Returns the borrowed address of the current text buffer.</summary>
<description>May be zero when no buffer is allocated. Reallocation, memory release or destruction invalidates the address. External writes must not bypass the builder length and capacity invariants. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL StringAddress : POINTER TO STRING]]></Declaration>
      <Get Name="Get" Id="{b3c00823-5130-4974-bbdd-4fca9cf64d09}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StringAddress := _String;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StringLength" Id="{2841cc1a-ac38-4b44-b5b1-ede0be51183a}">
      <Declaration><![CDATA[(*!
<summary>Returns the current text length in characters.</summary>
<description>Excludes the terminating zero; reading this property does not modify the builder. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL StringLength : UDINT]]></Declaration>
      <Get Name="Get" Id="{fb48f645-418d-4ed8-a141-0905ce7ac859}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StringLength := _Length;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CapacityByteSize" Id="{1e92dbea-3651-4443-86e0-4b59445a32da}">
      <Declaration><![CDATA[(*!
<summary>Returns the byte size required for the current capacity, including its terminator.</summary>
<description>This is a size calculation, not proof that a buffer is allocated. It includes one character for the terminating zero even when capacity is zero. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CapacityByteSize : UDINT]]></Declaration>
      <Get Name="Get" Id="{af03c812-08ea-4abd-9698-f3945913d75b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CapacityByteSize := STRING_CHAR_SIZE + (STRING_CHAR_SIZE * _Capacity);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StringByteSize" Id="{6a5a268b-d11b-47fb-aea6-2780f29f073d}">
      <Declaration><![CDATA[(*!
<summary>Returns the byte size required for the current text and its terminator.</summary>
<description>Includes one terminating character, also for empty text. Does not report allocated capacity. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL StringByteSize : UDINT]]></Declaration>
      <Get Name="Get" Id="{14cd6132-ca22-4cec-a306-6360ec51bdfa}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StringByteSize := STRING_CHAR_SIZE + (STRING_CHAR_SIZE * _Length);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToString255" Id="{d9c363f7-c799-429e-a0a6-eb3be5eb113d}">
      <Declaration><![CDATA[(*!
<summary>Copies the current text into a value with capacity 255.</summary>
<description>Returns an independent, possibly truncated prefix. Empty builders produce empty text. Does not change the builder or transfer its buffer. Descendants cannot override this buffer operation; allocation, length and capacity remain governed by this builder implementation.</description>
*)
METHOD FINAL ToString255 : STRING(255)]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Length > 0 THEN
	Tc2_Utilities.STRNCPY(ADR(ToString255), _String, SIZEOF(ToString255));
END_IF ]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>