<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringBuilder" Id="{8284c21b-c9e8-49a8-a6cf-7596c9e8432a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
