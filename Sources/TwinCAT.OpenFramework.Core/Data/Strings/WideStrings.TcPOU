<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStrings" Id="{a08ca29b-58ac-448f-9daf-cbacb656ba72}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides WSTRING constants and helpers for text manipulation and value formatting.</summary>
<description>Buffer ownership and size requirements are defined by each operation. ANY formatting reads the caller's value through its type descriptor. Try methods contain exceptions; this does not validate buffer lifetime or undo partial modifications.</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'}
PROGRAM WideStrings
VAR_INPUT CONSTANT
	CharSize : BYTE := 2;
	NewLine : WSTRING(1) := "$R"; 
	Empty : WSTRING(0) := "";
	//! <summary>UTF-16 byte-order mark U+FEFF, written before text to identify the byte order of its encoding.</summary>
	ByteOrderMark : WORD := 16#FEFF;
	//! <summary>UTF-16 code unit for the ellipsis character U+2026 ('…'), used to mark truncated text.</summary>
	ELLIPSIS : WORD := WORD#16#2026;
	//! <summary>UTF-16 ellipsis character U+2026 ('…') as single-character text.</summary>
	ELLIPSIS_STRING : WSTRING(1) := "$2026";
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Append" Id="{0bb8b256-f491-4a2d-9a6b-2432088dbd33}" />
    <Folder Name="Join" Id="{e5eb0b53-e510-4be2-a6fc-3cfe6def3e45}" />
    <Folder Name="Replace" Id="{a756485d-6296-418d-b791-6f297941943f}" />
    <Folder Name="Service members" Id="{9fab643e-bbff-4a9b-947d-8a7d558c89e1}" />
    <Folder Name="Split" Id="{3fe01d04-7439-4837-881a-92e26af7a9f4}" />
    <Folder Name="Trim" Id="{222b85cc-d2c6-46ad-a621-67a695bdca8e}" />
    <Method Name="AnyToString255" Id="{5eddfbb1-a4c4-4bf3-95de-4ec7342266cd}">
      <Declaration><![CDATA[(*!
<summary>Formats a supported ANY value as text of at most 255 characters.</summary>
<description>Reads the borrowed live payload of supported types. Unsupported type classes produce a diagnostic marker containing the type and size instead of interpreting the payload. The result is an independent bounded value.</description>
*)
METHOD AnyToString255 : WSTRING(255)
VAR_INPUT
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AnyToString255 := InternalAnyToString255(value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnyToStringFit255" Id="{64a10004-58ac-448f-9daf-cbacb656ba72}">
      <Declaration><![CDATA[(*!
<summary>Formats a supported ANY value as text of at most 255 characters, fitting longer strings with an ellipsis ('…').</summary>
<description>Reads the borrowed live payload of supported types. String values longer than 255 characters are truncated to 254 characters and end with U+2026 ('…'). Non-string types and strings fitting in 255 characters are formatted identically to AnyToString255.</description>
<param name="value">Borrowed live value to format.</param>
*)
METHOD AnyToStringFit255 : WSTRING(255)
VAR_INPUT
	value : ANY;
END_VAR
VAR
	valueLength : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AnyToStringFit255 := InternalAnyToString255(value);

IF value.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	valueLength := Strings.InternalGetLength(value.pValue);
	IF valueLength > 255 THEN
		AnyToStringFit255 := Tc2_Standard.WCONCAT(Tc2_Standard.WLEFT(AnyToStringFit255, 254), "…");
	END_IF
ELSIF value.TypeClass = __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	valueLength := InternalGetLength(value.pValue);
	IF valueLength > 255 THEN
		AnyToStringFit255 := Tc2_Standard.WCONCAT(Tc2_Standard.WLEFT(AnyToStringFit255, 254), "…");
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendFit" Id="{64a10001-58ac-448f-9daf-cbacb656ba72}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends one WSTRING to a caller-owned WSTRING buffer, fitting available capacity with an ellipsis ('…') if exceeded.</summary>
<description>Requires a writable WSTRING target with valid capacity metadata. If the appended text exceeds target capacity, it is truncated so the final character is U+2026 ('…') followed by a null-terminator. Raises NotSupportedException for a non-WSTRING target. Source storage is borrowed only for this call.</description>
<param name="targetString">Writable WSTRING buffer to append to.</param>
<param name="sourceString">Text to append; empty leaves the target unchanged.</param>
*)
METHOD AppendFit
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	sourceString : WSTRING;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

InternalAppendFit(targetString, ADR(sourceString));]]></ST>
      </Implementation>
    </Method>
    <Method Name="Append" Id="{ed2085a1-77d7-4a38-8551-436ba13822e3}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends one WSTRING to a caller-owned WSTRING buffer.</summary>
<description>Requires live, null-terminated strings and a writable target whose declared size describes its capacity. After validating the target type, an empty source completes without modifying the target. A non-WSTRING target raises NotSupportedException; failure of the append helper raises TargetVariableMemoryOverflowException. Source storage is borrowed only for this call.</description>
*)
//!<param name="targetString">Writable WSTRING buffer to append to.</param>
//!<param name="sourceString">Text to append; empty leaves the target unchanged.</param>
METHOD Append
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	sourceString : WSTRING;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalAppend(targetString, ADR(sourceString), 0, 0, 0, 0, 0, 0, 0, 0, 0) THEN
	Exceptions.ThrowTargetVariableMemoryOverflow(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize)); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Append255" Id="{ccf916ac-f329-40a8-9de1-90c04294dea5}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends up to ten WSTRING fragments in argument order, skipping empty fragments.</summary>
<description>Requires live, null-terminated source strings and a writable WSTRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Raises NotSupportedException for a non-WSTRING target or TargetVariableMemoryOverflowException when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call.</description>
*)
METHOD Append255
VAR_INPUT
	targetString : ANY_STRING;
	sourceString1 : WSTRING(255);
	sourceString2 : WSTRING(255) := "";
	sourceString3 : WSTRING(255) := "";
	sourceString4 : WSTRING(255) := "";
	sourceString5 : WSTRING(255) := "";
	sourceString6 : WSTRING(255) := "";
	sourceString7 : WSTRING(255) := "";
	sourceString8 : WSTRING(255) := "";
	sourceString9 : WSTRING(255) := "";
	sourceString10 : WSTRING(255) := "";
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalAppend(targetString, ADR(sourceString1), ADR(sourceString2), ADR(sourceString3), ADR(sourceString4), ADR(sourceString5), ADR(sourceString6), ADR(sourceString7), ADR(sourceString8), ADR(sourceString9), ADR(sourceString10)) THEN
	Exceptions.ThrowTargetVariableMemoryOverflow(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize)); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{1a6c82de-d589-49d7-9c77-f4f624ad8685}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9690cba0-2d05-4c7a-ad00-db2bf2465f2d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Concat255" Id="{8dba526b-4d55-4f06-81f2-ed0ad34ce538}">
      <Declaration><![CDATA[(*!
<summary>Concatenates up to sixteen text fragments without nested calls.</summary>
<description>
Fragments are appended in argument order. Empty and omitted optional fragments
are skipped; they do not prevent later fragments from being appended.
The result is limited to 255 characters; excess text is truncated by the
standard concatenation function. No dynamic memory is allocated.
</description>
*)
METHOD Concat255 : WSTRING(255)
VAR_INPUT
	string1 : WSTRING(255);
	string2 : WSTRING(255);
	string3 : WSTRING(255) := "";
	string4 : WSTRING(255) := "";
	string5 : WSTRING(255) := "";
	string6 : WSTRING(255) := "";
	string7 : WSTRING(255) := "";
	string8 : WSTRING(255) := "";
	string9 : WSTRING(255) := "";
	string10 : WSTRING(255) := "";
	string11 : WSTRING(255) := "";
	string12 : WSTRING(255) := "";
	string13 : WSTRING(255) := "";
	string14 : WSTRING(255) := "";
	string15 : WSTRING(255) := "";
	string16 : WSTRING(255) := "";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Concat255 := Tc2_Standard.WCONCAT(string1, string2);

IF Tc2_Standard.WLEN(string3) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string3);
END_IF

IF Tc2_Standard.WLEN(string4) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string4);
END_IF

IF Tc2_Standard.WLEN(string5) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string5);
END_IF

IF Tc2_Standard.WLEN(string6) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string6);
END_IF

IF Tc2_Standard.WLEN(string7) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string7);
END_IF

IF Tc2_Standard.WLEN(string8) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string8);
END_IF

IF Tc2_Standard.WLEN(string9) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string9);
END_IF

IF Tc2_Standard.WLEN(string10) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string10);
END_IF

IF Tc2_Standard.WLEN(string11) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string11);
END_IF

IF Tc2_Standard.WLEN(string12) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string12);
END_IF

IF Tc2_Standard.WLEN(string13) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string13);
END_IF

IF Tc2_Standard.WLEN(string14) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string14);
END_IF

IF Tc2_Standard.WLEN(string15) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string15);
END_IF

IF Tc2_Standard.WLEN(string16) > 0 THEN
	Concat255 := Tc2_Standard.WCONCAT(Concat255, string16);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConcatFit255" Id="{64a10003-58ac-448f-9daf-cbacb656ba72}">
      <Declaration><![CDATA[(*!
<summary>Concatenates up to sixteen text fragments, fitting within 255 characters with an ellipsis ('…') if total length is exceeded.</summary>
<description>Fragments are appended in argument order. Empty fragments are skipped. If the combined text exceeds 255 characters, the result is truncated to 254 characters and marked with a final U+2026 ('…'). No dynamic memory is allocated.</description>
<param name="string1">First text fragment.</param>
<param name="string2">Second text fragment.</param>
<param name="string3">Third text fragment.</param>
<param name="string4">Fourth text fragment.</param>
<param name="string5">Fifth text fragment.</param>
<param name="string6">Sixth text fragment.</param>
<param name="string7">Seventh text fragment.</param>
<param name="string8">Eighth text fragment.</param>
<param name="string9">Ninth text fragment.</param>
<param name="string10">Tenth text fragment.</param>
<param name="string11">Eleventh text fragment.</param>
<param name="string12">Twelfth text fragment.</param>
<param name="string13">Thirteenth text fragment.</param>
<param name="string14">Fourteenth text fragment.</param>
<param name="string15">Fifteenth text fragment.</param>
<param name="string16">Sixteenth text fragment.</param>
*)
METHOD ConcatFit255 : WSTRING(255)
VAR_INPUT
	string1 : WSTRING(255);
	string2 : WSTRING(255) := "";
	string3 : WSTRING(255) := "";
	string4 : WSTRING(255) := "";
	string5 : WSTRING(255) := "";
	string6 : WSTRING(255) := "";
	string7 : WSTRING(255) := "";
	string8 : WSTRING(255) := "";
	string9 : WSTRING(255) := "";
	string10 : WSTRING(255) := "";
	string11 : WSTRING(255) := "";
	string12 : WSTRING(255) := "";
	string13 : WSTRING(255) := "";
	string14 : WSTRING(255) := "";
	string15 : WSTRING(255) := "";
	string16 : WSTRING(255) := "";
END_VAR
VAR
	result : WSTRING(255);
	targetAny : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[targetAny.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
targetAny.pValue := ADR(result);
targetAny.diSize := SIZEOF(result);

InternalAppendFit(targetAny, ADR(string1));

IF string2 <> "" THEN
	InternalAppendFit(targetAny, ADR(string2));
END_IF

IF string3 <> "" THEN
	InternalAppendFit(targetAny, ADR(string3));
END_IF

IF string4 <> "" THEN
	InternalAppendFit(targetAny, ADR(string4));
END_IF

IF string5 <> "" THEN
	InternalAppendFit(targetAny, ADR(string5));
END_IF

IF string6 <> "" THEN
	InternalAppendFit(targetAny, ADR(string6));
END_IF

IF string7 <> "" THEN
	InternalAppendFit(targetAny, ADR(string7));
END_IF

IF string8 <> "" THEN
	InternalAppendFit(targetAny, ADR(string8));
END_IF

IF string9 <> "" THEN
	InternalAppendFit(targetAny, ADR(string9));
END_IF

IF string10 <> "" THEN
	InternalAppendFit(targetAny, ADR(string10));
END_IF

IF string11 <> "" THEN
	InternalAppendFit(targetAny, ADR(string11));
END_IF

IF string12 <> "" THEN
	InternalAppendFit(targetAny, ADR(string12));
END_IF

IF string13 <> "" THEN
	InternalAppendFit(targetAny, ADR(string13));
END_IF

IF string14 <> "" THEN
	InternalAppendFit(targetAny, ADR(string14));
END_IF

IF string15 <> "" THEN
	InternalAppendFit(targetAny, ADR(string15));
END_IF

IF string16 <> "" THEN
	InternalAppendFit(targetAny, ADR(string16));
END_IF

ConcatFit255 := result;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateSplitter" Id="{58f73e01-1198-4842-bb84-b0fc8575acd0}" FolderPath="Split\">
      <Declaration><![CDATA[(*!
<summary>Creates an enumerator over fragments of a borrowed source string.</summary>
<description>The source must remain alive and unchanged during iteration. The splitter owns its current fragment; borrowed fragment references expire on MoveNext, Reset or destruction. This method does not allocate the splitter with __NEW. The initialized result has no fragment allocation until MoveNext; assigning it must not overwrite an instance with an unreleased fragment. The caller is responsible for the result lifetime and cleanup, including Reset when abandoning iteration. Do not copy an active splitter by value; use references. Only an instance explicitly allocated with __NEW may be deleted with __DELETE.</description>
*)
//!<param name="maxCount">Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</param>
//!<param name="separator">Copied separator containing 1 to 80 characters. An empty or longer value raises ArgumentOutOfRangeException before initialization.</param>
METHOD CreateSplitter : WideStringSplittingEnumerator
VAR_IN_OUT CONSTANT
	sourceString : WSTRING;
END_VAR
VAR_INPUT
	separator : WSTRING;
	maxCount : UDINT := 0;
	trimEntries : BOOL := FALSE;
	removeEmptyEntries : BOOL := FALSE;
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(sourceString) THEN
	Exceptions.ThrowArgumentNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceString');
END_IF

IF separator = "" OR_ELSE InternalGetLength(ADR(separator)) > 80 THEN
	Exceptions.ThrowArgumentOutOfRange(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'separator', separator);
END_IF

CreateSplitter.Initialize(ADR(sourceString), separator, maxCount, trimEntries, removeEmptyEntries);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Find" Id="{fbf73ef7-e095-455c-b374-56142e92beda}">
      <Declaration><![CDATA[(*!
<summary>Finds the first exact, case-sensitive occurrence of a substring.</summary>
<description>Returns TRUE with a one-based position when found. An empty search substring matches at position 1, including in an empty source. Returns FALSE with position 0 when absent. Inputs must be live, null-terminated strings; they are borrowed only for this call and are not modified.</description>
*)
//!<param name="stringToSearchIn">Text to search.</param>
//!<param name="stringToFind">Substring to locate; empty matches at the beginning.</param>
//!<param name="position">One-based position in code units, or zero when absent.</param>
METHOD Find : BOOL
VAR_IN_OUT CONSTANT
	stringToSearchIn : WSTRING;
	stringToFind : WSTRING;
END_VAR
VAR_OUTPUT
	position : UDINT;
END_VAR
VAR
	stringToFindLength : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[position := 0;
stringToFindLength := InternalGetLength(ADR(stringToFind));

IF stringToFindLength = 0 THEN
	position := 1;
	Find := TRUE;
	RETURN;
END_IF

Find := InternalFind(ADR(stringToSearchIn), InternalGetLength(ADR(stringToSearchIn)), ADR(stringToFind), stringToFindLength, position => position);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetActualSize" Id="{f88efc62-cf38-4f16-a4e6-1677f1ebb799}">
      <Declaration><![CDATA[(*!
<summary>Returns the occupied byte size of terminated text.</summary>
<description>Includes the terminating zero. This is the current text size, not the declared or allocated capacity; the supplied string must remain valid during the call.</description>
*)
METHOD GetActualSize : UDINT
VAR_IN_OUT CONSTANT
	value : WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetActualSize := (InternalGetLength(ADR(value)) * CharSize) + CharSize;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetLength" Id="{92cb56d9-db9c-4638-bd53-1d463d8daa4a}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of characters before the terminating zero.</summary>
<description>Requires valid terminated text and excludes the terminator. Does not copy or modify the input.</description>
*)
METHOD GetLength : UDINT
VAR_IN_OUT CONSTANT
	value : WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetLength := InternalGetLength(ADR(value));]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAnyToString255" Id="{b35c56b7-7d8f-4737-8cea-d0ecbebe9e7f}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Formats a supported ANY value into a WSTRING of at most 255 characters.</summary>
<description>Borrows the value storage for this call. The descriptor must identify a live value of the stated type. The result does not retain a reference to the source. Unhandled type classes return a diagnostic marker containing the type class and descriptor size in bytes, without reading value storage, allocating heap memory or raising a formatting exception. This also applies to an unhandled type with a null data address.</description>
<param name="value">Type descriptor and address of the value to format.</param>
*)
METHOD INTERNAL InternalAnyToString255 : WSTRING(255)
VAR_IN_OUT CONSTANT
	value : __SYSTEM.AnyType;
END_VAR
VAR
	anyBool : POINTER TO BOOL;

	anyByte : POINTER TO BYTE;
	anyWord : POINTER TO WORD;
	anyDWord : POINTER TO DWORD;
	anyLWord : POINTER TO LWORD;
	
	anySInt : POINTER TO SINT;
	anyInt : POINTER TO INT;
	anyDInt : POINTER TO DINT;
	anyLInt : POINTER TO LINT;
	
	anyUSInt : POINTER TO USINT;
	anyUInt : POINTER TO UINT;
	anyUDInt : POINTER TO UDINT;
	anyULInt : POINTER TO ULINT;
	
	anyReal : POINTER TO REAL;
	anyLReal : POINTER TO LREAL;

	anyString : POINTER TO STRING(255);
	anyWString : POINTER TO WSTRING(255);
	
	anyTime : POINTER TO TIME;
	anyLTime : POINTER TO LTIME;
	anyDate : POINTER TO DATE;
	anyLDate : POINTER TO LDATE;
	anyDateAndTime : POINTER TO DATE_AND_TIME;
	anyLDateAndTime : POINTER TO LDATE_AND_TIME;
	anyTimeOfDay : POINTER TO TIME_OF_DAY;
	anyLTimeOfDay : POINTER TO LTIME_OF_DAY;

	anyPVoid : POINTER TO PVOID;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE value.TypeClass OF
	__SYSTEM.TYPE_CLASS.TYPE_BOOL:
		anyBool := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyBool^);		
	
	__SYSTEM.TYPE_CLASS.TYPE_BIT:
		anyByte := value.pValue;
		IF anyByte^ > 0 THEN
			InternalAnyToString255 := "1";		
		ELSE
			InternalAnyToString255 := "0";		
		END_IF
	
	__SYSTEM.TYPE_CLASS.TYPE_BYTE:
		anyByte := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyByte^);		
	__SYSTEM.TYPE_CLASS.TYPE_WORD:
		anyWord := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyWord^);
	__SYSTEM.TYPE_CLASS.TYPE_DWORD:
		anyDWord := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyDWord^);
	__SYSTEM.TYPE_CLASS.TYPE_LWORD:
		anyLWord := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLWord^);
		
	__SYSTEM.TYPE_CLASS.TYPE_SINT:
		anySInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anySInt^);
	__SYSTEM.TYPE_CLASS.TYPE_INT:
		anyInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyInt^);		
	__SYSTEM.TYPE_CLASS.TYPE_DINT:
		anyDInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyDInt^);
	__SYSTEM.TYPE_CLASS.TYPE_LINT:
		anyLInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLInt^);
		
	__SYSTEM.TYPE_CLASS.TYPE_USINT:
		anyUSInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyUSInt^);
	__SYSTEM.TYPE_CLASS.TYPE_UINT:
		anyUInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyUInt^);		
	__SYSTEM.TYPE_CLASS.TYPE_UDINT:
		anyUDInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyUDInt^);
	__SYSTEM.TYPE_CLASS.TYPE_ULINT:
		anyULInt := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyULInt^);

	__SYSTEM.TYPE_CLASS.TYPE_REAL:
		anyReal := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyReal^);
	__SYSTEM.TYPE_CLASS.TYPE_LREAL:
		anyLReal := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLReal^);
	
	__SYSTEM.TYPE_CLASS.TYPE_STRING:
		anyString := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyString^);
	__SYSTEM.TYPE_CLASS.TYPE_WSTRING:
		anyWString := value.pValue;
		InternalAnyToString255 := anyWString^;
	
	__SYSTEM.TYPE_CLASS.TYPE_TIME:
		anyTime := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyTime^);
	__SYSTEM.TYPE_CLASS.TYPE_LTIME:
		anyLTime := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLTime^);
	__SYSTEM.TYPE_CLASS.TYPE_DATE:
		anyDate := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyDate^);
	__SYSTEM.TYPE_CLASS.TYPE_LDATE:
		anyLDate := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLDate^);
	__SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME:
		anyDateAndTime := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyDateAndTime^);  
	__SYSTEM.TYPE_CLASS.TYPE_LDATEANDTIME:
		anyLDateAndTime := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLDateAndTime^);  
	__SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY:
		anyTimeOfDay := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyTimeOfDay^);
	__SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY:
		anyLTimeOfDay := value.pValue;
		InternalAnyToString255 := TO_WSTRING(anyLTimeOfDay^);
	
	__SYSTEM.TYPE_CLASS.TYPE_POINTER, __SYSTEM.TYPE_CLASS.TYPE_REFERENCE:
		anyPVoid := value.pValue;
		InternalAnyToString255 := TO_WSTRING(Tc2_Utilities.PVOID_TO_HEXSTR(anyPVoid^, TO_INT(SIZEOF(PVOID) * 2), FALSE));		
	
	ELSE
		InternalAnyToString255 := Concat255("<value unavailable; type class: ", TO_WSTRING(value.TypeClass), "; size: ", TO_WSTRING(value.diSize), " bytes>");
END_CASE	]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAppendFit" Id="{64a10005-58ac-448f-9daf-cbacb656ba72}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends a null-terminated WSTRING to a target descriptor, fitting available capacity with an ellipsis ('…') if exceeded.</summary>
<description>Validates target type and capacity. If the text does not fit, copies as many characters as can fit before U+2026 ('…') and appends null terminator. Returns FALSE on type mismatch or invalid target.</description>
*)
METHOD INTERNAL InternalAppendFit : BOOL
VAR_INPUT
	targetString : __SYSTEM.AnyType;
	sourceString : POINTER TO WSTRING;
END_VAR
VAR
	maxCapacity : UDINT;
	currentLength : UDINT;
	sourceLength : UDINT;
	availableChars : UDINT;
	targetWords : POINTER TO WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalAppendFit := FALSE;

IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING
	OR_ELSE targetString.pValue = 0
	OR_ELSE targetString.diSize < TO_DINT(CharSize)
THEN
	RETURN;
END_IF

IF sourceString = 0 THEN
	InternalAppendFit := TRUE;
	RETURN;
END_IF

sourceLength := TO_UDINT(Tc2_Utilities.WLEN2(sourceString));
IF sourceLength = 0 THEN
	InternalAppendFit := TRUE;
	RETURN;
END_IF

maxCapacity := TO_UDINT(targetString.diSize / TO_DINT(CharSize)) - 1;
currentLength := TO_UDINT(Tc2_Utilities.WLEN2(targetString.pValue));

IF currentLength > maxCapacity THEN
	currentLength := maxCapacity;
END_IF

targetWords := targetString.pValue;

IF currentLength + sourceLength <= maxCapacity THEN
	Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString, targetString.pValue, TO_UDINT(targetString.diSize));
ELSE
	IF maxCapacity > 0 THEN
		IF currentLength >= maxCapacity - 1 THEN
			currentLength := maxCapacity - 1;
			availableChars := 0;
		ELSE
			availableChars := maxCapacity - 1 - currentLength;
			Tc2_System.MEMCPY(targetString.pValue + (currentLength * TO_UDINT(CharSize)), sourceString, availableChars * TO_UDINT(CharSize));
		END_IF

		targetWords[currentLength + availableChars] := ELLIPSIS;
		targetWords[currentLength + availableChars + 1] := 0;
	ELSE
		targetWords[0] := 0;
	END_IF
END_IF

InternalAppendFit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAppend" Id="{0fda8c2e-c85d-41ae-b5cc-9b9c596ab7fb}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends up to ten WSTRING fragments in argument order, skipping empty fragments.</summary>
<description>Requires live, null-terminated source strings and a writable WSTRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Returns FALSE for a non-WSTRING target or when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call. Null source pointers denote omitted fragments and are skipped.</description>
*)
METHOD INTERNAL InternalAppend : BOOL
VAR_INPUT
	targetString : __SYSTEM.AnyType;
	sourceString1 : POINTER TO WSTRING;
	sourceString2 : POINTER TO WSTRING;
	sourceString3 : POINTER TO WSTRING;
	sourceString4 : POINTER TO WSTRING;
	sourceString5 : POINTER TO WSTRING;
	sourceString6 : POINTER TO WSTRING;
	sourceString7 : POINTER TO WSTRING;
	sourceString8 : POINTER TO WSTRING;
	sourceString9 : POINTER TO WSTRING;
	sourceString10 : POINTER TO WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalAppend := FALSE;

IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	RETURN;
END_IF

IF sourceString1 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString1) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString1, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString2 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString2) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString2, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString3 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString3) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString3, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString4 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString4) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString4, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString5 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString5) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString5, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString6 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString6) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString6, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString7 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString7) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString7, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString8 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString8) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString8, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString9 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString9) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString9, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString10 <> 0 AND_THEN Tc2_Utilities.WLEN2(sourceString10) > 0 THEN
	IF NOT Tc2_Utilities.WCONCAT2(targetString.pValue, sourceString10, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

InternalAppend := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalFind" Id="{06a5edf2-4fa6-4c6f-b8c2-32a4e932af0a}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Finds the first exact occurrence of a nonempty substring in buffers with supplied lengths.</summary>
<description>Lengths and the one-based result position are measured in code units, excluding terminators. Caller-provided lengths must describe accessible buffers. Returns FALSE and position 0 for an empty search substring or no match. Unlike public Find, this helper does not match an empty substring, allowing replacement and splitting loops to make progress.</description>
*)
METHOD INTERNAL InternalFind : BOOL
VAR_INPUT
	stringToSearchIn : POINTER TO WSTRING;
	stringToSearchInLength : UDINT;
	stringToFind : POINTER TO WSTRING;
	stringToFindLength : UDINT;
END_VAR
VAR_OUTPUT
	position : UDINT;
END_VAR
VAR	
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalFind := FALSE;
position := 0;

IF stringToFindLength = 0 OR_ELSE stringToSearchInLength < stringToFindLength THEN
	RETURN;
END_IF

FOR i := 0 TO stringToSearchInLength - stringToFindLength DO
	IF Tc2_System.MEMCMP(stringToSearchIn + (i * CharSize), stringToFind, stringToFindLength * CharSize) = 0 THEN
		position := i + 1;
		InternalFind := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalGetLength" Id="{28a2b8aa-3a94-4df4-930f-bfbe80fc9784}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Returns the length of text at the supplied address.</summary>
<description>Returns zero for a null address. A nonzero address must point to readable, correctly terminated text; this method does not establish pointer validity or buffer capacity.</description>
*)
METHOD INTERNAL InternalGetLength : UDINT
VAR_INPUT
	value : POINTER TO WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalGetLength := SEL(value = 0, Tc2_Utilities.WLEN2(value), 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalJoin" Id="{539a1d8c-df73-40de-ba36-7c4b6d44491c}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Builds joined text from the selected enumerated values in the supplied buffer.</summary>
<description>Clears the target before joining and consumes the enumerator from its current position. Strings of the target encoding use a borrowed reference regardless of their byte size. Other types use AsWString255 and a matching 255-character local buffer, with that conversion method's truncation and exception behavior. Returns FALSE on an incompatible target or append failure; partial text is not rolled back. Referenced data must remain valid during each append.</description>
*)
METHOD INTERNAL InternalJoin : BOOL
VAR_INPUT
	targetString : __SYSTEM.AnyType;
	separator : POINTER TO WSTRING;
	sourceEnumerator : IEnumerator;
	startIndex : UDINT;
	count : UDINT;
END_VAR
VAR
	currentValue : REFERENCE TO GENERIC_VALUE;
	string255 : WSTRING(255);
	stringReference : REFERENCE TO WSTRING;
	currentCount : UDINT;
	currentIndex : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	RETURN;
END_IF

Tc2_System.MEMSET(targetString.pValue, 0, TO_UDINT(targetString.diSize));

InternalJoin := TRUE;

WHILE sourceEnumerator.MoveNext() DO
	currentValue REF= sourceEnumerator.Current;
	
	IF NOT __ISVALIDREF(currentValue) OR_ELSE currentIndex < startIndex THEN
		currentIndex := currentIndex + 1;
   		CONTINUE;
	END_IF
	
	IF currentCount > 0 THEN
		InternalJoin := InternalJoin AND Tc2_Utilities.WCONCAT2(targetString.pValue, separator, targetString.pValue, TO_UDINT(targetString.diSize));		
	END_IF

	IF NOT InternalJoin THEN
		RETURN;
	END_IF
		
	IF currentValue.TypeClass = GENERIC_TYPE_CLASS.STRING_UTF16 THEN
		stringReference REF= currentValue.AsWStringReference();

		InternalJoin := InternalJoin AND Tc2_Utilities.WCONCAT2(targetString.pValue, ADR(stringReference), targetString.pValue, TO_UDINT(targetString.diSize));
	ELSE
		string255 := currentValue.AsWString255();

		InternalJoin := InternalJoin AND Tc2_Utilities.WCONCAT2(targetString.pValue, ADR(string255), targetString.pValue, TO_UDINT(targetString.diSize));
	END_IF
	
	IF NOT InternalJoin THEN
		RETURN;
	END_IF

	currentCount := currentCount + 1;
	currentIndex := currentIndex + 1;
	
	IF count > 0 AND_THEN currentCount >= count THEN
		RETURN;
	END_IF	
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalReplaceInSource" Id="{ba1ad49c-b07c-4f21-b23e-4e0400c679ac}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Returns FALSE if a memory operation fails or the result does not fit. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD INTERNAL InternalReplaceInSource : BOOL
VAR_INPUT
	sourceString : __SYSTEM.AnyType;
	oldSubstring : POINTER TO WSTRING;
	newSubstring : POINTER TO WSTRING;
	maxReplacements : UINT;
	skipReplacements : UINT;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
VAR
	sourceStringMemorySize : UDINT;
	sourceStringLength : UDINT;

	handledString : POINTER TO WSTRING;
	handledStringLength : UDINT;
		
	oldSubstringLength : UDINT;
	newSubstringLength : UDINT;
	checkMemorySize : BOOL;	
	
	substringPosition : UDINT;

	skipCount : UINT;
	
	memFunctionResult : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalReplaceInSource := FALSE;
replacementCount := 0;
oldSubstringLength := InternalGetLength(oldSubstring) * CharSize;

IF oldSubstringLength = 0 THEN
	InternalReplaceInSource := TRUE;
	RETURN;
END_IF

sourceStringMemorySize := TO_UDINT(sourceString.diSize);
sourceStringLength := InternalGetLength(sourceString.pValue) * CharSize;

handledString := sourceString.pValue;
handledStringLength := sourceStringLength;

newSubstringLength := InternalGetLength(newSubstring) * CharSize;
checkMemorySize := oldSubstringLength < newSubstringLength;

WHILE handledStringLength >= oldSubstringLength DO
	IF NOT InternalFind(handledString, handledStringLength / CharSize, oldSubstring, oldSubstringLength / CharSize, position => substringPosition) THEN
		EXIT;
	END_IF
	
	IF skipReplacements > 0 AND_THEN skipCount < skipReplacements THEN
		skipCount := skipCount + 1;

		handledString := handledString + oldSubstringLength + (substringPosition * CharSize) - CharSize;	
		handledStringLength := handledStringLength - oldSubstringLength - (substringPosition * CharSize) + CharSize;
		
		CONTINUE;		
	END_IF
	
	handledString := handledString + (substringPosition * CharSize) - CharSize;
	handledStringLength := handledStringLength - (substringPosition * CharSize) + CharSize;

	sourceStringLength := sourceStringLength + newSubstringLength - oldSubstringLength;
	
	IF checkMemorySize AND_THEN sourceStringLength + CharSize > sourceStringMemorySize THEN
		RETURN;
	END_IF
	
	IF oldSubstringLength <> newSubstringLength THEN
		memFunctionResult := Tc2_System.MEMMOVE(handledString + newSubstringLength, handledString + oldSubstringLength, handledStringLength - oldSubstringLength + CharSize);
		
		IF memFunctionResult < 1 THEN
			RETURN;			
		END_IF
		
		handledStringLength := handledStringLength + newSubstringLength - oldSubstringLength;
	END_IF
	
	IF newSubstringLength > 0 THEN
		memFunctionResult := Tc2_System.MEMCPY(handledString, newSubstring, newSubstringLength);

		IF memFunctionResult < 1 THEN
			RETURN;
		END_IF
	END_IF
	
	replacementCount := replacementCount + 1;
	
	IF maxReplacements > 0 AND_THEN replacementCount>= maxReplacements THEN
		EXIT;
	END_IF

	handledString := handledString + newSubstringLength;	
	handledStringLength := handledStringLength - newSubstringLength;
END_WHILE

InternalReplaceInSource := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFloat" Id="{2e2cdea4-606a-413c-b7a3-b0ef957764c5}">
      <Declaration><![CDATA[(*!
<summary>Checks the complete input text for floating-point syntax.</summary>
<description>Accepts decimal digits with an optional leading sign, at most one decimal point before an optional e/E exponent, and an optional sign immediately after the exponent marker. Requires a mantissa digit and, when an exponent is present, an exponent digit. Empty strings, whitespace and other characters are rejected. This is a lexical check, not a numeric range or representability check. The caller supplies a live null-terminated string, borrowed read-only for the call; processing is not limited to 255 characters and its cost grows with input length.</description>
*)
//!<param name="stringToCheck">Complete text to validate.</param>
METHOD IsFloat : BOOL
VAR_IN_OUT CONSTANT
    stringToCheck : WSTRING;
END_VAR
VAR
    i : UDINT;
    stringLength : UDINT;

    digitFound : BOOL;
    dotFound : BOOL;
    exponentFound : BOOL;
    exponentDigitFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFloat := FALSE;
stringLength := Tc2_Utilities.WLEN2(ADR(stringToCheck));

IF stringLength = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    // sign can be first character 
    IF i = 0 AND_THEN (stringToCheck[i] = 43 OR_ELSE stringToCheck[i] = 45) THEN
        CONTINUE;
    END_IF

    // digit 
    IF stringToCheck[i] >= 48 AND_THEN stringToCheck[i] <= 57 THEN
        IF exponentFound THEN
            exponentDigitFound := TRUE;
        ELSE
            digitFound := TRUE;
        END_IF
		
        CONTINUE;
    END_IF

    // decimal point 
    IF stringToCheck[i] = 46 THEN
        IF dotFound OR exponentFound THEN
            RETURN;
        END_IF
		
        dotFound := TRUE;
		
        CONTINUE;
    END_IF

    // exponent
    IF stringToCheck[i] = 69 OR_ELSE stringToCheck[i] = 101 THEN
        IF exponentFound OR NOT digitFound THEN
            RETURN;
        END_IF
		
        exponentFound := TRUE;
		
        CONTINUE;
    END_IF

    // sign after e/E 
    IF exponentFound AND_THEN (stringToCheck[i] = 43 OR_ELSE stringToCheck[i] = 45) THEN
        IF stringToCheck[i - 1] = 69 OR_ELSE stringToCheck[i - 1] = 101 THEN
            CONTINUE;
        ELSE
            RETURN;
        END_IF
    END_IF

    // invalid symbol 
    RETURN;
END_FOR

IF exponentFound THEN
    IsFloat := digitFound AND_THEN exponentDigitFound;
ELSE
    IsFloat := digitFound;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsInteger" Id="{24369f45-8f93-4b14-8cd6-4dede0c37bf7}">
      <Declaration><![CDATA[(*!
<summary>Checks the complete input text for signed integer syntax.</summary>
<description>Accepts decimal digits with an optional leading plus or minus sign; at least one digit is required. Empty strings, whitespace and other characters are rejected. This is a lexical check, not a numeric range or representability check. The caller supplies a live null-terminated string, borrowed read-only for the call; processing is not limited to 255 characters and its cost grows with input length.</description>
*)
//!<param name="stringToCheck">Complete text to validate.</param>
METHOD IsInteger : BOOL
VAR_IN_OUT CONSTANT
    stringToCheck : WSTRING;
END_VAR
VAR
    i : UDINT;
    stringLength : UDINT;

    digitFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsInteger := FALSE;
stringLength := Tc2_Utilities.WLEN2(ADR(stringToCheck));

IF stringLength = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    // sign can be first character 
    IF i = 0 AND_THEN (stringToCheck[i] = 43 OR_ELSE stringToCheck[i] = 45) THEN
        CONTINUE;
    END_IF

    // digit 
    IF stringToCheck[i] >= 48 AND_THEN stringToCheck[i] <= 57 THEN
		digitFound := TRUE;
		
        CONTINUE;
    END_IF

    // invalid symbol 
    RETURN;
END_FOR

IsInteger := digitFound;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsNullOrWhiteSpace" Id="{f6d91594-f8c2-4b36-b45d-e7cc6eae55c4}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the reference is absent, empty or contains only recognized whitespace.</summary>
<description>A valid reference must designate readable terminated text. Uses the whitespace characters explicitly recognized by this implementation; does not validate arbitrary addresses or normalize text.</description>
*)
METHOD IsNullOrWhiteSpace : BOOL
VAR_INPUT
	stringToCheck : REFERENCE TO WSTRING;
END_VAR
VAR
	i : DINT;
	
	stringData : POINTER TO WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsNullOrWhiteSpace := TRUE;

IF NOT __ISVALIDREF(stringToCheck) THEN
	RETURN;
END_IF

stringData := ADR(stringToCheck);

WHILE stringData[i] <> 0 DO
	CASE stringData[i] OF
		16#0020, 16#00A0, 16#1680, 16#2000, 16#2001, 16#2002, 16#2003, 16#2004, 16#2005, 16#2006, 16#2007, 16#2008, 16#2009, 
		16#200A, 16#202F, 16#205F, 16#3000, 16#2028, 16#2029, 16#0009, 16#000A, 16#000B, 16#000C, 16#000D, 16#0085:
			i := i + 1;
			
		ELSE
			IsNullOrWhiteSpace := FALSE;
			RETURN;
	END_CASE 
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsUnsignedInteger" Id="{d760fcba-a5f9-4812-95c3-31997d065dd8}">
      <Declaration><![CDATA[(*!
<summary>Checks the complete input text for unsigned integer syntax.</summary>
<description>Accepts decimal digits with an optional leading plus sign; at least one digit is required. Empty strings, whitespace and other characters are rejected. This is a lexical check, not a numeric range or representability check. The caller supplies a live null-terminated string, borrowed read-only for the call; processing is not limited to 255 characters and its cost grows with input length.</description>
*)
//!<param name="stringToCheck">Complete text to validate.</param>
METHOD IsUnsignedInteger : BOOL
VAR_IN_OUT CONSTANT
    stringToCheck : WSTRING;
END_VAR
VAR
    i : UDINT;
    stringLength : UDINT;

    digitFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsUnsignedInteger := FALSE;
stringLength := Tc2_Utilities.WLEN2(ADR(stringToCheck));

IF stringLength = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    // + can be first character 
    IF i = 0 AND_THEN stringToCheck[i] = 43 THEN
        CONTINUE;
    END_IF

    // digit 
    IF stringToCheck[i] >= 48 AND_THEN stringToCheck[i] <= 57 THEN
		digitFound := TRUE;
		
        CONTINUE;
    END_IF

    // invalid symbol 
    RETURN;
END_FOR

IsUnsignedInteger := digitFound;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Join" Id="{89b0f7d2-300b-4f0f-adfc-90540eb76ea8}" FolderPath="Join\">
      <Declaration><![CDATA[(*!
<summary>Joins selected enumerated values into the supplied WSTRING buffer with a separator.</summary>
<description>Validates the target string type and a non-null enumerator, then clears the target and advances the enumerator from its current position without resetting it. Invalid Current references are skipped. Inserts separators between included values, including empty text values. Does not dispose or retain the enumerator; its lifetime remains the caller's responsibility. Raises NotSupportedException for the wrong target type, ArgumentNotSpecifiedException for a null enumerator and TargetVariableMemoryOverflowException on append failure. Enumerator and conversion exceptions propagate. Partial text and the advanced enumerator position are not rolled back. The caller supplies live writable target storage and source data that remain valid during the operation. Strings of the target encoding are joined through a borrowed reference without a 255-character intermediate limit. Other values use AsWString255 with its default conversion policy and 255-character capacity; unsupported conversions raise an exception.</description>
*)
//!<param name="targetString">Destination buffer, including capacity for the terminator; previous contents are cleared after argument validation.</param>
//!<param name="separator">Text inserted between included values.</param>
//!<param name="sourceEnumerator">Borrowed enumerator, consumed by MoveNext without Reset.</param>
//!<param name="startIndex">Number of positions to skip among subsequent MoveNext results, including invalid Current references.</param>
//!<param name="count">Maximum number of included values; zero consumes all remaining eligible values.</param>
METHOD Join
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_INPUT
	separator : WSTRING;
	sourceEnumerator : IEnumerator;
	startIndex : UDINT := 0;
	count : UDINT := 0;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF sourceEnumerator = 0 THEN
	Exceptions.ThrowArgumentNotSpecified(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceEnumerator');
END_IF

IF NOT InternalJoin(targetString, ADR(separator), sourceEnumerator, startIndex, count) THEN
	Exceptions.ThrowTargetVariableMemoryOverflow(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize)); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{06787fa4-fd31-454c-be97-5c26e13d97fa}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{404a412b-96d2-4c44-ae43-0c154ea517e4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReplaceInSource" Id="{c35f862a-887f-4b4c-96da-6739cfbc7256}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Raises NotSupportedException for an incompatible source type and TargetVariableMemoryOverflowException if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD ReplaceInSource
VAR_INPUT
	sourceString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	oldSubstring : WSTRING;
	newSubstring : WSTRING;
END_VAR
VAR_INPUT
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
VAR	
	
	replaceResult : BOOL; 
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(sourceString.TypeClass));

	Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount) THEN
	Exceptions.ThrowTargetVariableMemoryOverflow(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceString', TO_UDINT(sourceString.diSize));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReplaceInSource255" Id="{e0f107e1-9b6f-4d77-b127-da5f2bb84170}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Raises NotSupportedException for an incompatible source type and TargetVariableMemoryOverflowException if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD ReplaceInSource255
VAR_INPUT
	sourceString : ANY_STRING;
	oldSubstring : WSTRING(255);
	newSubstring : WSTRING(255);
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
VAR	
	
	replaceResult : BOOL; 
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(sourceString.TypeClass));

	Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount) THEN
	Exceptions.ThrowTargetVariableMemoryOverflow(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceString', TO_UDINT(sourceString.diSize));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringPointerToAnyType" Id="{e7b7eb9d-23fd-4387-8408-e33d707c6233}">
      <Declaration><![CDATA[(*!
<summary>Builds a borrowed ANY descriptor for text at an address.</summary>
<description>Requires a nonzero address to valid terminated text. Records occupied bytes including the terminator, not buffer capacity; size must fit DINT. Does not copy, allocate or acquire ownership. Keep the source alive while using the descriptor.</description>
*)
METHOD StringPointerToAnyType : __System.AnyType
VAR_INPUT
	value : POINTER TO WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StringPointerToAnyType.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
StringPointerToAnyType.pValue := value;
StringPointerToAnyType.diSize := TO_DINT(GetActualSize(value^));]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringReferenceToAnyType" Id="{8467a0c9-fba0-4e3d-9b58-fb51783bbdec}">
      <Declaration><![CDATA[(*!
<summary>Builds a borrowed ANY descriptor for a string reference.</summary>
<description>Requires a valid reference to terminated text. Records occupied bytes including the terminator, not buffer capacity; size must fit DINT. Keep the source alive while using the descriptor; no ownership is transferred.</description>
*)
METHOD StringReferenceToAnyType : __System.AnyType
VAR_INPUT
	value : REFERENCE TO WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StringReferenceToAnyType.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_WSTRING;
StringReferenceToAnyType.pValue := ADR(value);
StringReferenceToAnyType.diSize := TO_DINT(GetActualSize(value));]]></ST>
      </Implementation>
    </Method>
    <Method Name="TrimChar" Id="{e2ff62b2-4701-4d44-a6fc-9b69cb60ec38}" FolderPath="Trim\">
      <Declaration><![CDATA[(*!
<summary>Removes repetitions of one character from the selected ends of a string.</summary>
<description>Modifies the supplied string in place using TrimChars and the requested trim mode. Preserves the remaining character order and requires writable terminated text.</description>
*)
METHOD TrimChar
VAR_IN_OUT
	stringToTrim : WSTRING;
END_VAR
VAR_INPUT
	trimMode : TRIM_MODE := TRIM_MODE.LEFT_AND_RIGHT;
	trimChar : WSTRING(1) := " ";
END_VAR
VAR
	trimCharArray : ARRAY [0..0] OF WSTRING(1);	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[trimCharArray[0] := trimChar;

TrimChars(stringToTrim, trimMode, trimCharArray);]]></ST>
      </Implementation>
    </Method>
    <Method Name="TrimChars" Id="{cb597a03-3a6d-40b2-92cb-bb844efea4ef}" FolderPath="Trim\">
      <Declaration><![CDATA[(*!
<summary>Removes selected character values from the requested ends of a string in place.</summary>
<description>The caller supplies a live writable null-terminated string. Left trimming moves the retained suffix, including its terminator, within the same buffer; no new storage is allocated. The trim-character array may have negative bounds. Right trimming stops after the first code unit without decrementing an unsigned index below zero.</description>
*)
METHOD TrimChars
VAR_IN_OUT
	stringToTrim : WSTRING;
END_VAR
VAR_INPUT
	trimMode : TRIM_MODE := TRIM_MODE.LEFT_AND_RIGHT;
END_VAR
VAR_IN_OUT CONSTANT
	trimChars : ARRAY [*] OF WSTRING(1);	
END_VAR
VAR
	stringLength : UDINT;
	stringData : POINTER TO WORD;
	trimCharData : POINTER TO WORD;
	
	originalCharIndex : UDINT;
	trimCharIndex : DINT;
	trimCharCount : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringData := ADR(stringToTrim);
stringLength := InternalGetLength(stringData);

IF stringLength < 1 THEN
	RETURN;
END_IF

IF trimMode = TRIM_MODE.LEFT_AND_RIGHT OR_ELSE trimMode = TRIM_MODE.LEFT THEN
	trimCharCount := 0;
	
	FOR originalCharIndex := 0 TO stringLength - 1 BY 1 DO
		FOR trimCharIndex := LOWER_BOUND(trimChars, 1) TO UPPER_BOUND(trimChars, 1) DO
			trimCharData := ADR(trimChars[trimCharIndex]);
			
			IF stringData[originalCharIndex] = trimCharData^ THEN
				trimCharCount := trimCharCount + 1;
				EXIT;
			END_IF
		END_FOR
		
		IF trimCharCount <> originalCharIndex + 1 THEN
			EXIT;
		END_IF
	END_FOR

	IF trimCharCount > 0 THEN
		stringLength := stringLength - trimCharCount;
		
		Tc2_System.MEMMOVE(stringData, (stringData + (trimCharCount * CharSize)), (stringLength * CharSize) + CharSize);		
	END_IF
END_IF

IF stringLength < 1 THEN
	RETURN;
END_IF

IF trimMode = TRIM_MODE.LEFT_AND_RIGHT OR_ELSE trimMode = TRIM_MODE.RIGHT THEN
	trimCharCount := 0;
	
	FOR originalCharIndex := stringLength TO 1 BY -1 DO
		FOR trimCharIndex := LOWER_BOUND(trimChars, 1) TO UPPER_BOUND(trimChars, 1) DO
			trimCharData := ADR(trimChars[trimCharIndex]);
			
			IF stringData[originalCharIndex - 1] = trimCharData^ THEN
				trimCharCount := trimCharCount + 1;
				EXIT;
			END_IF
		END_FOR
		
		IF trimCharCount <> stringLength - originalCharIndex + 1 THEN
			EXIT;
		END_IF
	END_FOR

	IF trimCharCount > 0 THEN
		stringLength := stringLength - trimCharCount;
		
		Tc2_System.MEMSET(stringData + (stringLength * CharSize), 0, CharSize);		
	END_IF	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryAppendFit" Id="{64a10002-58ac-448f-9daf-cbacb656ba72}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends one WSTRING to a caller-owned WSTRING buffer, fitting available capacity with an ellipsis ('…') if exceeded.</summary>
<description>Requires a writable WSTRING target with valid capacity metadata. If the appended text exceeds target capacity, it is truncated so the final character is U+2026 ('…') followed by a null-terminator. Returns TRUE if the text was appended (including when truncated); returns FALSE if target is not a valid WSTRING or has zero capacity. Catches exceptions and returns FALSE.</description>
<param name="targetString">Writable WSTRING buffer to append to.</param>
<param name="sourceString">Text to append; empty leaves the target unchanged.</param>
*)
METHOD TryAppendFit : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	sourceString : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryAppendFit := InternalAppendFit(targetString, ADR(sourceString));
__CATCH
	TryAppendFit := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryAppend" Id="{4de57109-f456-48e2-92b9-7ccc4d2d48fb}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends one WSTRING to a caller-owned buffer and reports success.</summary>
<description>Requires live, null-terminated source strings and a writable WSTRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Returns FALSE for a non-WSTRING target or when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
METHOD TryAppend : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	sourceString : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryAppend := InternalAppend(targetString, ADR(sourceString), 0, 0, 0, 0, 0, 0, 0, 0, 0);
__CATCH
	TryAppend := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryAppend255" Id="{85ee2c53-41c4-4f11-9049-314aaf814c0e}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends up to ten WSTRING fragments in argument order, skipping empty fragments.</summary>
<description>Requires live, null-terminated source strings and a writable WSTRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Returns FALSE for a non-WSTRING target or when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
METHOD TryAppend255 : BOOL
VAR_INPUT
	targetString : ANY_STRING;
	sourceString1 : WSTRING(255);
	sourceString2 : WSTRING(255) := "";
	sourceString3 : WSTRING(255) := "";
	sourceString4 : WSTRING(255) := "";
	sourceString5 : WSTRING(255) := "";
	sourceString6 : WSTRING(255) := "";
	sourceString7 : WSTRING(255) := "";
	sourceString8 : WSTRING(255) := "";
	sourceString9 : WSTRING(255) := "";
	sourceString10 : WSTRING(255) := "";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryAppend255 := InternalAppend(targetString, ADR(sourceString1), ADR(sourceString2), ADR(sourceString3), ADR(sourceString4), ADR(sourceString5), ADR(sourceString6), ADR(sourceString7), ADR(sourceString8), ADR(sourceString9), ADR(sourceString10));
__CATCH
	TryAppend255 := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryCreateSplitter" Id="{527506d6-1420-4056-93a4-b1b0eacd1e2d}" FolderPath="Split\">
      <Declaration><![CDATA[(*!
<summary>Initializes a splitter when the source has the supported string type.</summary>
<description>The source must remain alive and unchanged during iteration. The splitter owns its current fragment; borrowed fragment references expire on MoveNext, Reset or destruction. This method does not allocate the splitter with __NEW. The initialized result has no fragment allocation until MoveNext; assigning it must not overwrite an instance with an unreleased fragment. The caller is responsible for the result lifetime and cleanup, including Reset when abandoning iteration. Do not copy an active splitter by value; use references. Only an instance explicitly allocated with __NEW may be deleted with __DELETE. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Use the output only after TRUE is returned.</description>
*)
//!<param name="maxCount">Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</param>
//!<param name="separator">Copied separator containing 1 to 80 characters. An empty or longer value returns FALSE before initialization.</param>
METHOD TryCreateSplitter : BOOL
VAR_INPUT
	sourceString : ANY_STRING;
	separator : WSTRING;
	maxCount : UDINT := 0;
	trimEntries : BOOL := FALSE;
	removeEmptyEntries : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	splitter : WideStringSplittingEnumerator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
		RETURN;
	END_IF

	IF separator = "" OR_ELSE InternalGetLength(ADR(separator)) > 80 THEN
		RETURN;
	END_IF

	splitter.Initialize(sourceString.pValue, separator, maxCount, trimEntries, removeEmptyEntries);

	TryCreateSplitter := TRUE;
__CATCH
	TryCreateSplitter := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryJoin" Id="{6a88a02e-5b86-47c2-b1f3-2c945ae12a0f}" FolderPath="Join\">
      <Declaration><![CDATA[(*!
<summary>Joins enumerated values into a WSTRING buffer using a WSTRING separator.</summary>
<description>Borrows the target and enumerator during the call. Returns the internal join result, or FALSE if an exception is caught. Earlier target modifications are not rolled back on failure. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
//!<param name="separator">Wide text inserted between included values.</param>
METHOD TryJoin : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_INPUT
	separator : WSTRING;
	sourceEnumerator : IEnumerator;
	startIndex : UDINT := 0;
	count : UDINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryJoin := InternalJoin(targetString, ADR(separator), sourceEnumerator, startIndex, count);
__CATCH
	TryJoin := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryReplaceInSource" Id="{4174b626-3bd8-4d6b-815f-679d9353671f}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Returns FALSE for an incompatible source type or if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD TryReplaceInSource : BOOL
VAR_INPUT
	sourceString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	oldSubstring : WSTRING;
	newSubstring : WSTRING;
END_VAR
VAR_INPUT
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
		RETURN;
	END_IF

	TryReplaceInSource := InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount);
__CATCH
	TryReplaceInSource := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryReplaceInSource255" Id="{79d89556-eff6-43ae-9899-d26b8dfe9a56}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Returns FALSE for an incompatible source type or if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD TryReplaceInSource255 : BOOL
VAR_INPUT
	sourceString : ANY_STRING;
	oldSubstring : WSTRING(255);
	newSubstring : WSTRING(255);
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_WSTRING THEN
		RETURN;
	END_IF

	TryReplaceInSource255 := InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount);
__CATCH
	TryReplaceInSource255 := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>