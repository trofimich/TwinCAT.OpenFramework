<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringSplittingEnumerator" Id="{39677a7e-6822-49fb-a976-fd077aac311a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Enumerates allocated text fragments from a borrowed source string.</summary>
<description>Initialization requires a separator containing 1 to 80 characters, stored in a fixed buffer. The source must remain alive and unchanged during iteration. The enumerator owns the current fragment; borrowed fragment references expire on MoveNext, Reset or destruction. Allocation failure uses the terminal memory mechanism. With a nonempty separator, empty fragments are preserved when RemoveEmptyEntries is FALSE, including the final fragment after a trailing separator and one fragment for an empty source. RemoveEmptyEntries filters empty fragments after optional trimming. MaxCount still limits the number of returned fragments. Do not copy an instance by assignment or pass it by value while it owns an allocated buffer; use references instead. Assignment does not clone the buffer or transfer ownership. Do not overwrite an instance that still owns a buffer. The creator is responsible for the splitter lifetime and cleanup. Release the current fragment with Reset when abandoning iteration. Delete the splitter itself only if it was allocated with __NEW; FB_exit releases its current fragment. Statically or locally declared instances must not be passed to __DELETE. The borrowed source is never owned or freed by the splitter.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringSplittingEnumerator EXTENDS Object IMPLEMENTS IEnumerator
VAR_OUTPUT
	SourceString : POINTER TO STRING;
	SourceStringLength : UDINT;
	SourceStringSize : UDINT;
	Separator : STRING(80);
	SeparatorLength : UDINT;
	//!<summary>Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</summary>
	MaxCount : UDINT := 0;
	TrimEntries : BOOL := FALSE;
	RemoveEmptyEntries : BOOL := FALSE;	
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_CurrentString : POINTER TO STRING;
	{attribute 'hide'} 
	_CurrentStringLength : UDINT;
	{attribute 'hide'} 
	_CurrentEntry : POINTER TO STRING;
	{attribute 'hide'} 
	_CurrentEntrySize : UDINT;
	{attribute 'hide'} 
	_EntryCount : UDINT; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{dc8168cb-a7bf-4d33-9f6c-41b2c6a729dd}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{451b3de0-abf2-482f-a7cd-159e1ec34840}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Current" Id="{578ddaf1-4d15-456a-9c92-6ba01ccaf901}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed generic view of the current split fragment.</summary>
<description>The descriptor does not own the fragment. With no current fragment it is reset to a null generic value. The descriptor is reused by this getter; do not modify it or retain its payload across MoveNext, Reset or destruction. Copy the text for independent storage. Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL Current : REFERENCE TO GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{ff624da2-e0ce-48f6-a18a-67e4fe74d3a7}">
        <Declaration><![CDATA[VAR_INST
	genericValue : GENERIC_VALUE;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentEntry <> 0 AND_THEN _CurrentEntrySize > 0 THEN
	genericValue := GenericValueFactory.FromParts(GENERIC_TYPE_CLASS.STRING_ASCII, _CurrentEntry, _CurrentEntrySize, GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
ELSE
	genericValue.Reset();
END_IF

Current REF= genericValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CurrentEntry" Id="{3c87ffb4-1d5d-46d7-8e98-8f42eb9deaf3}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed reference to the current split fragment.</summary>
<description>The reference is invalid when no current fragment exists. Do not retain it across MoveNext, Reset or destruction; copy the text if it must outlive cursor advancement. Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
PROPERTY FINAL CurrentEntry : REFERENCE TO STRING
]]></Declaration>
      <Get Name="Get" Id="{df9fd113-3b9b-4abf-a069-25f1abcf0162}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentEntry <> 0 THEN
	CurrentEntry REF= _CurrentEntry^;	
END_IF ]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{91c3c83f-b495-4483-9409-84eb69a852b9}">
      <Declaration><![CDATA[(*!
<summary>Releases the cursor-owned fragment buffer.</summary>
<description>Does not release the borrowed source string. Destruction invalidates references to the current fragment and must not raise exceptions.</description>
*)
//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentEntry <> 0 THEN
	__DELETE(_CurrentEntry);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{dd46f3d0-2251-42fe-acf7-cf970e2b2bc6}">
      <Declaration><![CDATA[(*!
<summary>Sets the borrowed source and splitting options, then resets iteration.</summary>
<description>The source must remain alive and unchanged during iteration. The separator is copied into internal storage. Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
//!<param name="maxCount">Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</param>
//!<param name="separator">Separator containing 1 to 80 characters; the caller must validate its length before initialization.</param>
METHOD INTERNAL FINAL Initialize
VAR_INPUT
	sourceString : POINTER TO STRING;
END_VAR
VAR_IN_OUT CONSTANT
	separator : STRING;
END_VAR
VAR_INPUT
	maxCount : UDINT;
	trimEntries : BOOL;
	removeEmptyEntries : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.SourceString := sourceString;
THIS^.SourceStringLength := Strings.InternalGetLength(sourceString);
THIS^.SourceStringSize := THIS^.SourceStringLength + Strings.CharSize; 
THIS^.Separator := separator;
THIS^.SeparatorLength := Strings.InternalGetLength(ADR(THIS^.Separator));
THIS^.MaxCount := maxCount;
THIS^.TrimEntries := trimEntries;
THIS^.RemoveEmptyEntries := removeEmptyEntries;

_CurrentString := THIS^.SourceString;

Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveNext" Id="{b4c28f78-8b1f-47b3-af5b-cb333bb9b6f3}">
      <Declaration><![CDATA[(*!
<summary>Releases the previous fragment and advances to the next selected fragment.</summary>
<description>Returns TRUE when a new current fragment is available, FALSE at the end or when the configured limit is reached. A non-null cursor with zero remaining length represents a pending empty final fragment; a null cursor marks completed iteration. Empty fragments are returned unless RemoveEmptyEntries is TRUE, subject to MaxCount. Each fragment owns a null-terminated allocation; allocation failure invokes DynamicMemoryManager.RaiseAllocationFailure before the buffer is accessed. Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
METHOD FINAL MoveNext : BOOL
VAR
	separatorPosition : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[START:

IF _CurrentEntry <> 0 THEN
	_CurrentEntrySize := 0;	
	__DELETE(_CurrentEntry);
END_IF

IF _CurrentString = 0 OR_ELSE Separator = '' OR_ELSE (MaxCount > 0 AND_THEN _EntryCount >= MaxCount) THEN
	RETURN;
END_IF

IF Strings.InternalFind(_CurrentString, _CurrentStringLength, ADR(Separator), SeparatorLength, position => separatorPosition) THEN
	_CurrentEntrySize := separatorPosition * Strings.CharSize;
	_CurrentEntry := __NEW(BYTE, _CurrentEntrySize);

	IF _CurrentEntry = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	Tc2_System.MEMCPY(_CurrentEntry, _CurrentString, (separatorPosition - 1) * Strings.CharSize);
	Tc2_System.MEMSET(_CurrentEntry + ((separatorPosition - 1) * Strings.CharSize), 0, Strings.CharSize);

	_CurrentString := _CurrentString + ((separatorPosition - 1) * Strings.CharSize) + (SeparatorLength * Strings.CharSize);
	_CurrentStringLength := _CurrentStringLength - separatorPosition + 1 - SeparatorLength;
ELSE	
	_CurrentEntrySize := _CurrentStringLength + Strings.CharSize;	
	_CurrentEntry := __NEW(BYTE, _CurrentEntrySize);

	IF _CurrentEntry = 0 THEN
		DynamicMemoryManager.RaiseAllocationFailure();
	END_IF
	
	Tc2_System.MEMCPY(_CurrentEntry, _CurrentString, _CurrentStringLength + Strings.CharSize);
	
	_CurrentString := 0;
	_CurrentStringLength := 0;
END_IF

IF TrimEntries THEN
	Strings.TrimChar(_CurrentEntry^);
END_IF

IF RemoveEmptyEntries AND_THEN _CurrentEntry^ = '' THEN
	JMP START;
END_IF

_EntryCount := _EntryCount + 1;

MoveNext := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{eac5bc76-1c0c-415a-b31e-3c5597f64aa3}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2b679829-e2da-4785-aab9-24372420e1f5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{0c911c06-568e-4235-8bc3-600486eb4862}">
      <Declaration><![CDATA[(*!
<summary>Releases the current fragment and resets iteration to before the first entry.</summary>
<description>
Preserves splitting settings and does not allocate memory or modify the source string.
Previously borrowed fragment addresses and references become invalid.
The initialized source string must remain alive and unchanged throughout iteration.
Repeated Reset calls are allowed, including before iteration and after its end.
 Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
METHOD FINAL Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentEntry <> 0 THEN
	__DELETE(_CurrentEntry);
END_IF

_CurrentEntry := 0;
_CurrentEntrySize := 0;

_CurrentString := SourceString;
_CurrentStringLength := SourceStringLength;
_EntryCount := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{07711580-08e7-4949-b5a3-b486d7b73972}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{80ff0b12-faeb-4d39-a7b6-5a5f5617c0d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>