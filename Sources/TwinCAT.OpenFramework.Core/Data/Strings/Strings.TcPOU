(*!
<summary>Provides STRING constants and helpers for text manipulation and value formatting.</summary>
<description>Buffer ownership and size requirements are defined by each operation. ANY formatting reads the caller's value through its type descriptor. Try methods contain exceptions; this does not validate buffer lifetime or undo partial modifications.</description>
*)

{attribute 'no_explicit_call' := 'Direct call is not allowed'}
PROGRAM Strings
VAR_INPUT CONSTANT
	CharSize : BYTE := 1;
	NewLine : STRING(1) := '$R';
	Empty : STRING(0) := '';
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Any" Id="{8688dfc3-2927-467c-9f5b-91ce2217a978}" />
    <Folder Name="Append" Id="{7e7c80a5-b2b3-4398-aeb3-fcbeeedb95b0}" />
    <Folder Name="Join" Id="{23020608-d9f6-4bcd-bc2c-4f5978ed3025}" />
    <Folder Name="Replace" Id="{a7f2f348-7292-464d-8aaa-84a00bdb1d6c}" />
    <Folder Name="Service members" Id="{6eebbe56-ba8f-4c4e-a22c-3fcf35f9aa27}" />
    <Folder Name="Split" Id="{abd107b6-e51f-460b-baa2-99a9483990d2}" />
    <Folder Name="Trim" Id="{f20b62c4-34de-4080-969d-424865288d4e}" />
    <Method Name="AnyToString" Id="{b226cb15-ac0d-48f7-98b9-48ee0196d1ce}" FolderPath="Any\">
      <Declaration><![CDATA[(*!
<summary>Formats a supported ANY value as text of at most 255 characters.</summary>
<description>Reads the borrowed live payload of supported types. Unsupported type classes produce a diagnostic marker containing the type and size instead of interpreting the payload. The result is an independent bounded value.</description>
*)
METHOD AnyToString : STRING(255)
VAR_INPUT
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AnyToString := InternalAnyToString255(value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnyToString255" Id="{6ec6dde0-5575-44dd-bea2-d21349d12524}">
      <Declaration><![CDATA[(*!
<summary>Formats a supported ANY value as text of at most 255 characters.</summary>
<description>Reads the borrowed live payload of supported types. Unsupported type classes produce a diagnostic marker containing the type and size instead of interpreting the payload. The result is an independent bounded value.</description>
*)
METHOD AnyToString255 : STRING(255)
VAR_INPUT
	value : ANY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AnyToString255 := InternalAnyToString255(value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendToTarget" Id="{7d3432ad-7058-4ce7-80d2-01c9d35ec6fb}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends one STRING to a caller-owned STRING buffer.</summary>
<description>Requires live, null-terminated strings and a writable target whose declared size describes its capacity. After validating the target type, an empty source completes without modifying the target. A non-STRING target raises NotSupportedException; failure of the append helper raises TargetVariableMemoryOverflowException. Source storage is borrowed only for this call.</description>
*)
//!<param name="targetString">Writable STRING buffer to append to.</param>
//!<param name="sourceString">Text to append; empty leaves the target unchanged.</param>
METHOD AppendToTarget
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	sourceString : STRING;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	stringTypeNotSupportedException : NotSupportedException;
	targetStringMemoryOverflowException : TargetVariableMemoryOverflowException;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	stringTypeNotSupportedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF sourceString = '' THEN
	RETURN;
END_IF

IF NOT InternalAppendToTarget(targetString, ADR(sourceString), 0, 0, 0, 0, 0, 0, 0, 0, 0) THEN
	targetStringMemoryOverflowException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize)); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendToTarget255" Id="{b845707e-9f67-4676-b647-f64266f03b85}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends up to ten STRING fragments in argument order, skipping empty fragments.</summary>
<description>Requires live, null-terminated source strings and a writable STRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Raises NotSupportedException for a non-STRING target or TargetVariableMemoryOverflowException when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call.</description>
*)
METHOD AppendToTarget255
VAR_INPUT
	targetString : ANY_STRING;
	sourceString1 : STRING(255);
	sourceString2 : STRING(255) := '';
	sourceString3 : STRING(255) := '';
	sourceString4 : STRING(255) := '';
	sourceString5 : STRING(255) := '';
	sourceString6 : STRING(255) := '';
	sourceString7 : STRING(255) := '';
	sourceString8 : STRING(255) := '';
	sourceString9 : STRING(255) := '';
	sourceString10 : STRING(255) := '';
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	stringTypeNotSupportedException : NotSupportedException;
	targetStringMemoryOverflowException : TargetVariableMemoryOverflowException;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	stringTypeNotSupportedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalAppendToTarget(targetString, ADR(sourceString1), ADR(sourceString2), ADR(sourceString3), ADR(sourceString4), ADR(sourceString5), ADR(sourceString6), ADR(sourceString7), ADR(sourceString8), ADR(sourceString9), ADR(sourceString10)) THEN
	targetStringMemoryOverflowException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize)); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{81cda6c2-0106-408d-bf8b-7dd5b920c809}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{566edcc0-aa57-4ecd-95d3-18653d40dc60}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Concat255" Id="{833ffcb1-3f77-4b1a-908f-282a178d2bc7}">
      <Declaration><![CDATA[(*!
<summary>Concatenates up to sixteen text fragments without nested calls.</summary>
<description>
Fragments are appended in argument order. Empty and omitted optional fragments
are skipped; they do not prevent later fragments from being appended.
The result is limited to 255 characters; excess text is truncated by the
standard concatenation function. No dynamic memory is allocated.
</description>
*)
METHOD Concat255 : STRING(255)
VAR_INPUT
	string1 : STRING(255);
	string2 : STRING(255);
	string3 : STRING(255) := '';
	string4 : STRING(255) := '';
	string5 : STRING(255) := '';
	string6 : STRING(255) := '';
	string7 : STRING(255) := '';
	string8 : STRING(255) := '';
	string9 : STRING(255) := '';
	string10 : STRING(255) := '';
	string11 : STRING(255) := '';
	string12 : STRING(255) := '';
	string13 : STRING(255) := '';
	string14 : STRING(255) := '';
	string15 : STRING(255) := '';
	string16 : STRING(255) := '';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Concat255 := Tc2_Standard.CONCAT(string1, string2);

IF Tc2_Standard.LEN(string3) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string3);
END_IF

IF Tc2_Standard.LEN(string4) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string4);
END_IF

IF Tc2_Standard.LEN(string5) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string5);
END_IF

IF Tc2_Standard.LEN(string6) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string6);
END_IF

IF Tc2_Standard.LEN(string7) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string7);
END_IF

IF Tc2_Standard.LEN(string8) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string8);
END_IF

IF Tc2_Standard.LEN(string9) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string9);
END_IF

IF Tc2_Standard.LEN(string10) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string10);
END_IF

IF Tc2_Standard.LEN(string11) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string11);
END_IF

IF Tc2_Standard.LEN(string12) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string12);
END_IF

IF Tc2_Standard.LEN(string13) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string13);
END_IF

IF Tc2_Standard.LEN(string14) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string14);
END_IF

IF Tc2_Standard.LEN(string15) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string15);
END_IF

IF Tc2_Standard.LEN(string16) > 0 THEN
	Concat255 := Tc2_Standard.CONCAT(Concat255, string16);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateSplitter" Id="{74505d39-c9b2-47f5-a8a1-80fe0e3aaae8}" FolderPath="Split\">
      <Declaration><![CDATA[(*!
<summary>Creates an enumerator over fragments of a borrowed source string.</summary>
<description>The source must remain alive and unchanged during iteration. The splitter owns its current fragment; borrowed fragment references expire on MoveNext, Reset or destruction. This method does not allocate the splitter with __NEW. The initialized result has no fragment allocation until MoveNext; assigning it must not overwrite an instance with an unreleased fragment. The caller is responsible for the result lifetime and cleanup, including Reset when abandoning iteration. Do not copy an active splitter by value; use references. Only an instance explicitly allocated with __NEW may be deleted with __DELETE.</description>
*)
//!<param name="maxCount">Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</param>
//!<param name="separator">Copied separator containing 1 to 80 characters. An empty or longer value raises ArgumentOutOfRangeException before initialization.</param>
METHOD CreateSplitter : StringSplittingEnumerator
VAR_IN_OUT CONSTANT
	sourceString : STRING;
END_VAR
VAR_INPUT
	separator : STRING;
	maxCount : UDINT := 0;
	trimEntries : BOOL := FALSE;
	removeEmptyEntries : BOOL := FALSE;
END_VAR
VAR
	sourceStringIsNullException : ArgumentNotSpecifiedException;
	separatorOutOfRangeException : ArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(sourceString) THEN
	sourceStringIsNullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceString');
END_IF

IF separator = '' OR_ELSE InternalGetLength(ADR(separator)) > 80 THEN
	separatorOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'separator', separator);
END_IF

CreateSplitter.Initialize(ADR(sourceString), separator, maxCount, trimEntries, removeEmptyEntries);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Find" Id="{0c61da8f-b806-465e-b4f1-5bdbe54f1092}">
      <Declaration><![CDATA[(*!
<summary>Finds the first exact, case-sensitive occurrence of a substring.</summary>
<description>Returns TRUE with a one-based position when found. An empty search substring matches at position 1, including in an empty source. Returns FALSE with position 0 when absent. Inputs must be live, null-terminated strings; they are borrowed only for this call and are not modified.</description>
*)
//!<param name="stringToSearchIn">Text to search.</param>
//!<param name="stringToFind">Substring to locate; empty matches at the beginning.</param>
//!<param name="position">One-based position in code units, or zero when absent.</param>
METHOD Find : BOOL
VAR_IN_OUT CONSTANT
	stringToSearchIn : STRING;
	stringToFind : STRING;
END_VAR
VAR_OUTPUT
	position : UDINT;
END_VAR
VAR
	stringToFindLength : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[position := 0;
stringToFindLength := InternalGetLength(ADR(stringToFind));

IF stringToFindLength = 0 THEN
	position := 1;
	Find := TRUE;
	RETURN;
END_IF

Find := InternalFind(ADR(stringToSearchIn), InternalGetLength(ADR(stringToSearchIn)), ADR(stringToFind), stringToFindLength, position => position);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetActualSize" Id="{e8e8416f-8e42-44ac-ac9b-ab76e4a16eec}">
      <Declaration><![CDATA[(*!
<summary>Returns the occupied byte size of terminated text.</summary>
<description>Includes the terminating zero. This is the current text size, not the declared or allocated capacity; the supplied string must remain valid during the call.</description>
*)
METHOD GetActualSize : UDINT
VAR_IN_OUT CONSTANT
	value : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetActualSize := InternalGetLength(ADR(value)) + CharSize;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetLength" Id="{a3dc2c45-cc1a-482d-b619-dbbdf1878690}">
      <Declaration><![CDATA[(*!
<summary>Returns the number of characters before the terminating zero.</summary>
<description>Requires valid terminated text and excludes the terminator. Does not copy or modify the input.</description>
*)
METHOD GetLength : UDINT
VAR_IN_OUT CONSTANT
	value : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetLength := InternalGetLength(ADR(value));]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAnyToString255" Id="{dbd6569e-fd5b-4765-a843-fc6bef815e68}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Formats a supported ANY value into a STRING of at most 255 characters.</summary>
<description>Borrows the value storage for this call. The descriptor must identify a live value of the stated type. The result does not retain a reference to the source. Unhandled type classes return a diagnostic marker containing the type class and descriptor size in bytes, without reading value storage, allocating heap memory or raising a formatting exception. This also applies to an unhandled type with a null data address.</description>
<param name="value">Type descriptor and address of the value to format.</param>
*)
METHOD INTERNAL InternalAnyToString255 : STRING(255)
VAR_IN_OUT CONSTANT
	value : __SYSTEM.AnyType;
END_VAR
VAR
	anyBool : POINTER TO BOOL;

	anyByte : POINTER TO BYTE;
	anyWord : POINTER TO WORD;
	anyDWord : POINTER TO DWORD;
	anyLWord : POINTER TO LWORD;
	
	anySInt : POINTER TO SINT;
	anyInt : POINTER TO INT;
	anyDInt : POINTER TO DINT;
	anyLInt : POINTER TO LINT;
	
	anyUSInt : POINTER TO USINT;
	anyUInt : POINTER TO UINT;
	anyUDInt : POINTER TO UDINT;
	anyULInt : POINTER TO ULINT;
	
	anyReal : POINTER TO REAL;
	anyLReal : POINTER TO LREAL;

	anyString : POINTER TO STRING(255);
	anyWString : POINTER TO WSTRING(255);
	
	anyTime : POINTER TO TIME;
	anyLTime : POINTER TO LTIME;
	anyDate : POINTER TO DATE;
	anyDateAndTime : POINTER TO DATE_AND_TIME;
	anyTimeOfDay : POINTER TO TOD;

	anyPVoid : POINTER TO PVOID;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE value.TypeClass OF
	__SYSTEM.TYPE_CLASS.TYPE_BOOL:
		anyBool := value.pValue;
		InternalAnyToString255 := TO_STRING(anyBool^);		
	
	__SYSTEM.TYPE_CLASS.TYPE_BIT:
		anyByte := value.pValue;
		IF anyByte^ > 0 THEN
			InternalAnyToString255 := '1';		
		ELSE
			InternalAnyToString255 := '0';		
		END_IF
	
	__SYSTEM.TYPE_CLASS.TYPE_BYTE:
		anyByte := value.pValue;
		InternalAnyToString255 := TO_STRING(anyByte^);		
	__SYSTEM.TYPE_CLASS.TYPE_WORD:
		anyWord := value.pValue;
		InternalAnyToString255 := TO_STRING(anyWord^);
	__SYSTEM.TYPE_CLASS.TYPE_DWORD:
		anyDWord := value.pValue;
		InternalAnyToString255 := TO_STRING(anyDWord^);
	__SYSTEM.TYPE_CLASS.TYPE_LWORD:
		anyLWord := value.pValue;
		InternalAnyToString255 := TO_STRING(anyLWord^);
		
	__SYSTEM.TYPE_CLASS.TYPE_SINT:
		anySInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anySInt^);
	__SYSTEM.TYPE_CLASS.TYPE_INT:
		anyInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyInt^);		
	__SYSTEM.TYPE_CLASS.TYPE_DINT:
		anyDInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyDInt^);
	__SYSTEM.TYPE_CLASS.TYPE_LINT:
		anyLInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyLInt^);
		
	__SYSTEM.TYPE_CLASS.TYPE_USINT:
		anyUSInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyUSInt^);
	__SYSTEM.TYPE_CLASS.TYPE_UINT:
		anyUInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyUInt^);		
	__SYSTEM.TYPE_CLASS.TYPE_UDINT:
		anyUDInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyUDInt^);
	__SYSTEM.TYPE_CLASS.TYPE_ULINT:
		anyULInt := value.pValue;
		InternalAnyToString255 := TO_STRING(anyULInt^);

	__SYSTEM.TYPE_CLASS.TYPE_REAL:
		anyReal := value.pValue;
		InternalAnyToString255 := TO_STRING(anyReal^);
	__SYSTEM.TYPE_CLASS.TYPE_LREAL:
		anyLReal := value.pValue;
		InternalAnyToString255 := TO_STRING(anyLReal^);
	
	__SYSTEM.TYPE_CLASS.TYPE_STRING:
		anyString := value.pValue;
		InternalAnyToString255 := anyString^;
	__SYSTEM.TYPE_CLASS.TYPE_WSTRING:
		anyWString := value.pValue;
		InternalAnyToString255 := TO_STRING(anyWString^);
	
	__SYSTEM.TYPE_CLASS.TYPE_TIME:
		anyTime := value.pValue;
		InternalAnyToString255 := TO_STRING(anyTime^);
	__SYSTEM.TYPE_CLASS.TYPE_LTIME:
		anyLTime := value.pValue;
		InternalAnyToString255 := TO_STRING(anyLTime^);
	__SYSTEM.TYPE_CLASS.TYPE_DATE:
		anyDate := value.pValue;
		InternalAnyToString255 := TO_STRING(anyDate^);
	__SYSTEM.TYPE_CLASS.TYPE_DATEANDTIME:
		anyDateAndTime := value.pValue;
		InternalAnyToString255 := TO_STRING(anyDateAndTime^);  
	__SYSTEM.TYPE_CLASS.TYPE_TIMEOFDAY:
		anyTimeOfDay := value.pValue;
		InternalAnyToString255 := TO_STRING(anyTimeOfDay^);
	
	__SYSTEM.TYPE_CLASS.TYPE_POINTER, __SYSTEM.TYPE_CLASS.TYPE_REFERENCE:
		anyPVoid := value.pValue;
		InternalAnyToString255 := Tc2_Utilities.PVOID_TO_HEXSTR(anyPVoid^, TO_INT(SIZEOF(PVOID) * 2), FALSE);		
	
	ELSE
		InternalAnyToString255 := Concat255('<value unavailable; type class: ', TO_STRING(value.TypeClass), '; size: ', TO_STRING(value.diSize), ' bytes>');
END_CASE	]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalAppendToTarget" Id="{96f09b6b-a3b9-4899-b746-36fdcd4d9236}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Appends up to ten STRING fragments in argument order, skipping empty fragments.</summary>
<description>Requires live, null-terminated source strings and a writable STRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Returns FALSE for a non-STRING target or when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call. Null source pointers denote omitted fragments and are skipped.</description>
*)
METHOD INTERNAL InternalAppendToTarget : BOOL
VAR_INPUT
	targetString : __SYSTEM.AnyType;
	sourceString1 : POINTER TO STRING;
	sourceString2 : POINTER TO STRING;
	sourceString3 : POINTER TO STRING;
	sourceString4 : POINTER TO STRING;
	sourceString5 : POINTER TO STRING;
	sourceString6 : POINTER TO STRING;
	sourceString7 : POINTER TO STRING;
	sourceString8 : POINTER TO STRING;
	sourceString9 : POINTER TO STRING;
	sourceString10 : POINTER TO STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalAppendToTarget := FALSE;

IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	RETURN;
END_IF

IF sourceString1 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString1) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString1, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString2 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString2) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString2, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString3 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString3) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString3, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString4 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString4) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString4, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString5 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString5) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString5, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString6 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString6) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString6, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString7 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString7) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString7, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString8 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString8) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString8, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString9 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString9) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString9, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

IF sourceString10 <> 0 AND_THEN Tc2_Utilities.LEN2(sourceString10) > 0 THEN
	IF NOT Tc2_Utilities.CONCAT2(targetString.pValue, sourceString10, targetString.pValue, TO_UDINT(targetString.diSize)) THEN
		RETURN;
	END_IF
END_IF

InternalAppendToTarget := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalFind" Id="{5b6aff61-016c-4db4-94ed-cfbbb336515e}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Finds the first exact occurrence of a nonempty substring in buffers with supplied lengths.</summary>
<description>Lengths and the one-based result position are measured in code units, excluding terminators. Caller-provided lengths must describe accessible buffers. Returns FALSE and position 0 for an empty search substring or no match. Unlike public Find, this helper does not match an empty substring, allowing replacement and splitting loops to make progress.</description>
*)
METHOD INTERNAL InternalFind : BOOL
VAR_INPUT
	stringToSearchIn : POINTER TO STRING;
	stringToSearchInLength : UDINT;
	stringToFind : POINTER TO STRING;
	stringToFindLength : UDINT;
END_VAR
VAR_OUTPUT
	position : UDINT;
END_VAR
VAR	
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalFind := FALSE;
position := 0;

IF stringToFindLength = 0 OR_ELSE stringToSearchInLength < stringToFindLength THEN
	RETURN;
END_IF

FOR i := 0 TO stringToSearchInLength - stringToFindLength DO
	IF Tc2_System.MEMCMP(stringToSearchIn + i, stringToFind, stringToFindLength * CharSize) = 0 THEN
		position := i + 1;
		InternalFind := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalGetLength" Id="{06d76460-e6eb-42be-8f6b-fb87a2b574a4}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Returns the length of text at the supplied address.</summary>
<description>Returns zero for a null address. A nonzero address must point to readable, correctly terminated text; this method does not establish pointer validity or buffer capacity.</description>
*)
METHOD INTERNAL InternalGetLength : UDINT
VAR_INPUT
	value : POINTER TO STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalGetLength := SEL(value = 0, Tc2_Utilities.LEN2(value), 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalJoinToTarget" Id="{641619b9-d14d-4e22-94f4-454b0a713080}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Builds joined text from the selected enumerated values in the supplied buffer.</summary>
<description>Clears the target before joining and consumes the enumerator from its current position. Strings of the target encoding use a borrowed reference regardless of their byte size. Other types use AsString255 and a matching 255-character local buffer, with that conversion method's truncation and exception behavior. Returns FALSE on an incompatible target or append failure; partial text is not rolled back. Referenced data must remain valid during each append.</description>
*)
METHOD INTERNAL InternalJoinToTarget : BOOL
VAR_INPUT
	targetString : __SYSTEM.AnyType;
	separator : POINTER TO STRING;
	sourceEnumerator : IEnumerator;
	startIndex : UDINT;
	count : UDINT;
END_VAR
VAR
	currentValue : REFERENCE TO GENERIC_VALUE;
	string255 : STRING(255);
	stringReference : REFERENCE TO STRING;
	currentCount : UDINT;
	currentIndex : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	RETURN;
END_IF

Tc2_System.MEMSET(targetString.pValue, 0, TO_UDINT(targetString.diSize));

InternalJoinToTarget := TRUE;

WHILE sourceEnumerator.MoveNext() DO
	currentValue REF= sourceEnumerator.Current;
	
	IF NOT __ISVALIDREF(currentValue) OR_ELSE currentIndex < startIndex THEN
		currentIndex := currentIndex + 1;
   		CONTINUE;
	END_IF
	
	IF currentCount > 0 THEN
		InternalJoinToTarget := InternalJoinToTarget AND Tc2_Utilities.CONCAT2(targetString.pValue, separator, targetString.pValue, TO_UDINT(targetString.diSize));		
	END_IF

	IF NOT InternalJoinToTarget THEN
		RETURN;
	END_IF
		
	IF currentValue.TypeClass = GENERIC_TYPE_CLASS.STRING_ASCII THEN
		stringReference REF= currentValue.AsStringReference();

		InternalJoinToTarget := InternalJoinToTarget AND Tc2_Utilities.CONCAT2(targetString.pValue, ADR(stringReference), targetString.pValue, TO_UDINT(targetString.diSize));
	ELSE
		string255 := currentValue.AsString255();

		InternalJoinToTarget := InternalJoinToTarget AND Tc2_Utilities.CONCAT2(targetString.pValue, ADR(string255), targetString.pValue, TO_UDINT(targetString.diSize));
	END_IF
	
	IF NOT InternalJoinToTarget THEN
		RETURN;
	END_IF

	currentCount := currentCount + 1;
	currentIndex := currentIndex + 1;
	
	IF count > 0 AND_THEN currentCount >= count THEN
		RETURN;
	END_IF	
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="InternalReplaceInSource" Id="{0ac24766-5e3a-42f7-a2a0-58aa460f844f}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Returns FALSE if a memory operation fails or the result does not fit. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD INTERNAL InternalReplaceInSource : BOOL
VAR_INPUT
	sourceString : __SYSTEM.AnyType;
	oldSubstring : POINTER TO STRING;
	newSubstring : POINTER TO STRING;
	maxReplacements : UINT;
	skipReplacements : UINT;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
VAR
	sourceStringMemorySize : UDINT;
	sourceStringLength : UDINT;

	handledString : POINTER TO STRING;
	handledStringLength : UDINT;
		
	oldSubstringLength : UDINT;
	newSubstringLength : UDINT;
	checkMemorySize : BOOL;	
	
	substringPosition : UDINT;

	skipCount : UINT;
	
	memFunctionResult : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[InternalReplaceInSource := FALSE;
replacementCount := 0;
oldSubstringLength := InternalGetLength(oldSubstring);

IF oldSubstringLength = 0 THEN
	InternalReplaceInSource := TRUE;
	RETURN;
END_IF

sourceStringMemorySize := TO_UDINT(sourceString.diSize);
sourceStringLength := InternalGetLength(sourceString.pValue);

handledString := sourceString.pValue;
handledStringLength := sourceStringLength;

newSubstringLength := InternalGetLength(newSubstring);
checkMemorySize := oldSubstringLength < newSubstringLength;

WHILE handledStringLength >= oldSubstringLength DO
	IF NOT InternalFind(handledString, handledStringLength / CharSize, oldSubstring, oldSubstringLength / CharSize, position => substringPosition) THEN
		EXIT;
	END_IF
	
	IF skipReplacements > 0 AND_THEN skipCount < skipReplacements THEN
		skipCount := skipCount + 1;

		handledString := handledString + oldSubstringLength + (substringPosition * CharSize) - CharSize;	
		handledStringLength := handledStringLength - oldSubstringLength - (substringPosition * CharSize) + CharSize;
		
		CONTINUE;		
	END_IF
	
	handledString := handledString + (substringPosition * CharSize) - CharSize;
	handledStringLength := handledStringLength - (substringPosition * CharSize) + CharSize;

	sourceStringLength := sourceStringLength + newSubstringLength - oldSubstringLength;
	
	IF checkMemorySize AND_THEN sourceStringLength + CharSize > sourceStringMemorySize THEN
		RETURN;
	END_IF
	
	IF oldSubstringLength <> newSubstringLength THEN
		memFunctionResult := Tc2_System.MEMMOVE(handledString + newSubstringLength, handledString + oldSubstringLength, handledStringLength - oldSubstringLength + CharSize);
		
		IF memFunctionResult < 1 THEN
			RETURN;			
		END_IF
		
		handledStringLength := handledStringLength + newSubstringLength - oldSubstringLength;
	END_IF
	
	IF newSubstringLength > 0 THEN
		memFunctionResult := Tc2_System.MEMCPY(handledString, newSubstring, newSubstringLength);
	
		IF memFunctionResult < 1 THEN
			RETURN;			
		END_IF		
	END_IF
	
	replacementCount := replacementCount + 1;
	
	IF maxReplacements > 0 AND_THEN replacementCount>= maxReplacements THEN
		EXIT;
	END_IF

	handledString := handledString + newSubstringLength;	
	handledStringLength := handledStringLength - newSubstringLength;
END_WHILE

InternalReplaceInSource := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFloat" Id="{5cca10b4-3ba5-4176-ae1b-a21dca6dbf97}">
      <Declaration><![CDATA[(*!
<summary>Checks the complete input text for floating-point syntax.</summary>
<description>Accepts decimal digits with an optional leading sign, at most one decimal point before an optional e/E exponent, and an optional sign immediately after the exponent marker. Requires a mantissa digit and, when an exponent is present, an exponent digit. Empty strings, whitespace and other characters are rejected. This is a lexical check, not a numeric range or representability check. The caller supplies a live null-terminated string, borrowed read-only for the call; processing is not limited to 255 characters and its cost grows with input length.</description>
*)
//!<param name="stringToCheck">Complete text to validate.</param>
METHOD IsFloat : BOOL
VAR_IN_OUT CONSTANT
    stringToCheck : STRING;
END_VAR
VAR
    i : UDINT;
    stringLength : UDINT;

    digitFound : BOOL;
    dotFound : BOOL;
    exponentFound : BOOL;
    exponentDigitFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFloat := FALSE;
stringLength := Tc2_Utilities.LEN2(ADR(stringToCheck));

IF stringLength = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    // sign can be first character 
    IF i = 0 AND_THEN (stringToCheck[i] = 43 OR_ELSE stringToCheck[i] = 45) THEN
        CONTINUE;
    END_IF

    // digit 
    IF stringToCheck[i] >= 48 AND_THEN stringToCheck[i] <= 57 THEN
        IF exponentFound THEN
            exponentDigitFound := TRUE;
        ELSE
            digitFound := TRUE;
        END_IF
		
        CONTINUE;
    END_IF

    // decimal point 
    IF stringToCheck[i] = 46 THEN
        IF dotFound OR exponentFound THEN
            RETURN;
        END_IF
		
        dotFound := TRUE;
		
        CONTINUE;
    END_IF

    // exponent
    IF stringToCheck[i] = 69 OR_ELSE stringToCheck[i] = 101 THEN
        IF exponentFound OR NOT digitFound THEN
            RETURN;
        END_IF
		
        exponentFound := TRUE;
		
        CONTINUE;
    END_IF

    // sign after e/E 
    IF exponentFound AND_THEN (stringToCheck[i] = 43 OR_ELSE stringToCheck[i] = 45) THEN
        IF stringToCheck[i - 1] = 69 OR_ELSE stringToCheck[i - 1] = 101 THEN
            CONTINUE;
        ELSE
            RETURN;
        END_IF
    END_IF

    // invalid symbol 
    RETURN;
END_FOR

IF exponentFound THEN
    IsFloat := digitFound AND_THEN exponentDigitFound;
ELSE
    IsFloat := digitFound;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsInteger" Id="{64017c0a-0904-4813-83bf-5a23b0d4cfee}">
      <Declaration><![CDATA[(*!
<summary>Checks the complete input text for signed integer syntax.</summary>
<description>Accepts decimal digits with an optional leading plus or minus sign; at least one digit is required. Empty strings, whitespace and other characters are rejected. This is a lexical check, not a numeric range or representability check. The caller supplies a live null-terminated string, borrowed read-only for the call; processing is not limited to 255 characters and its cost grows with input length.</description>
*)
//!<param name="stringToCheck">Complete text to validate.</param>
METHOD IsInteger : BOOL
VAR_IN_OUT CONSTANT
    stringToCheck : STRING;
END_VAR
VAR
    i : UDINT;
    stringLength : UDINT;

    digitFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsInteger := FALSE;
stringLength := Tc2_Utilities.LEN2(ADR(stringToCheck));

IF stringLength = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    // sign can be first character 
    IF i = 0 AND_THEN (stringToCheck[i] = 43 OR_ELSE stringToCheck[i] = 45) THEN
        CONTINUE;
    END_IF

    // digit 
    IF stringToCheck[i] >= 48 AND_THEN stringToCheck[i] <= 57 THEN
		digitFound := TRUE;
		
        CONTINUE;
    END_IF

    // invalid symbol 
    RETURN;
END_FOR

IsInteger := digitFound;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsNullOrWhiteSpace" Id="{523b397c-6e9a-4d05-935a-38a2426b04e1}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the reference is absent, empty or contains only recognized whitespace.</summary>
<description>A valid reference must designate readable terminated text. Uses the whitespace characters explicitly recognized by this implementation; does not validate arbitrary addresses or normalize text.</description>
*)
METHOD IsNullOrWhiteSpace : BOOL
VAR_INPUT
	stringToCheck : REFERENCE TO STRING;
END_VAR
VAR
	i : DINT;
	
	stringData : POINTER TO BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsNullOrWhiteSpace := TRUE;

IF NOT __ISVALIDREF(stringToCheck) THEN
	RETURN;
END_IF

stringData := ADR(stringToCheck);

WHILE stringData[i] <> 0 DO
	CASE stringData[i] OF
		16#20, 16#09, 16#0A, 16#0B, 16#0C, 16#0D:
			i := i + 1;
			
		ELSE
			IsNullOrWhiteSpace := FALSE;
			RETURN;
	END_CASE 
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsUnsignedInteger" Id="{dfaddadb-137b-494a-9d2f-8a9a940574ca}">
      <Declaration><![CDATA[(*!
<summary>Checks the complete input text for unsigned integer syntax.</summary>
<description>Accepts decimal digits with an optional leading plus sign; at least one digit is required. Empty strings, whitespace and other characters are rejected. This is a lexical check, not a numeric range or representability check. The caller supplies a live null-terminated string, borrowed read-only for the call; processing is not limited to 255 characters and its cost grows with input length.</description>
*)
//!<param name="stringToCheck">Complete text to validate.</param>
METHOD IsUnsignedInteger : BOOL
VAR_IN_OUT CONSTANT
    stringToCheck : STRING;
END_VAR
VAR
    i : UDINT;
    stringLength : UDINT;

    digitFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsUnsignedInteger := FALSE;
stringLength := Tc2_Utilities.LEN2(ADR(stringToCheck));

IF stringLength = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO stringLength - 1 DO
    // + can be first character 
    IF i = 0 AND_THEN stringToCheck[i] = 43 THEN
        CONTINUE;
    END_IF

    // digit 
    IF stringToCheck[i] >= 48 AND_THEN stringToCheck[i] <= 57 THEN
		digitFound := TRUE;
		
        CONTINUE;
    END_IF

    // invalid symbol 
    RETURN;
END_FOR

IsUnsignedInteger := digitFound;]]></ST>
      </Implementation>
    </Method>
    <Method Name="JoinToTarget" Id="{f9356af7-1c6b-416a-a5c8-0029f23752d3}" FolderPath="Join\">
      <Declaration><![CDATA[(*!
<summary>Joins selected enumerated values into the supplied STRING buffer with a separator.</summary>
<description>Validates the target string type and a non-null enumerator, then clears the target and advances the enumerator from its current position without resetting it. Invalid Current references are skipped. Inserts separators between included values, including empty text values. Does not dispose or retain the enumerator; its lifetime remains the caller's responsibility. Raises NotSupportedException for the wrong target type, ArgumentNotSpecifiedException for a null enumerator and TargetVariableMemoryOverflowException on append failure. Enumerator and conversion exceptions propagate. Partial text and the advanced enumerator position are not rolled back. The caller supplies live writable target storage and source data that remain valid during the operation. Strings of the target encoding are joined through a borrowed reference without a 255-character intermediate limit. Other values use AsString255 with its default conversion policy and 255-character capacity; unsupported conversions raise an exception.</description>
*)
//!<param name="targetString">Destination buffer, including capacity for the terminator; previous contents are cleared after argument validation.</param>
//!<param name="separator">Text inserted between included values.</param>
//!<param name="sourceEnumerator">Borrowed enumerator, consumed by MoveNext without Reset.</param>
//!<param name="startIndex">Number of positions to skip among subsequent MoveNext results, including invalid Current references.</param>
//!<param name="count">Maximum number of included values; zero consumes all remaining eligible values.</param>
METHOD JoinToTarget
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_INPUT
	separator : STRING;
	sourceEnumerator : IEnumerator;
	startIndex : UDINT := 0;
	count : UDINT := 0;
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);

	stringTypeNotSupportedException : NotSupportedException;
	sourceEnumeratorNullException : ArgumentNotSpecifiedException;
	targetStringMemoryOverflowException : TargetVariableMemoryOverflowException;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF targetString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(targetString.TypeClass));

	stringTypeNotSupportedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF sourceEnumerator = 0 THEN
	sourceEnumeratorNullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceEnumerator');
END_IF

IF NOT InternalJoinToTarget(targetString, ADR(separator), sourceEnumerator, startIndex, count) THEN
	targetStringMemoryOverflowException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'targetString', TO_ULINT(targetString.diSize)); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{475cd351-78e5-4557-baf1-9d5933c3fa2e}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2b015e66-fd97-4ebe-8516-bd91f7e0b822}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReplaceInSource" Id="{f06898de-32ea-4f51-b053-1b282cb73a8a}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Raises NotSupportedException for an incompatible source type and TargetVariableMemoryOverflowException if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD ReplaceInSource
VAR_INPUT
	sourceString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	oldSubstring : STRING;
	newSubstring : STRING;
END_VAR
VAR_INPUT
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
VAR	
	stringTypeNotSupportedException : NotSupportedException;
	sourceStringMemoryOverflowException : TargetVariableMemoryOverflowException;
	
	replaceResult : BOOL; 
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(sourceString.TypeClass));

	stringTypeNotSupportedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount) THEN
	sourceStringMemoryOverflowException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceString', TO_UDINT(sourceString.diSize));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReplaceInSource255" Id="{f41fa253-7b57-4bb9-a052-ea59a6eb6bff}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Raises NotSupportedException for an incompatible source type and TargetVariableMemoryOverflowException if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD ReplaceInSource255
VAR_INPUT
	sourceString : ANY_STRING;
	oldSubstring : STRING(255);
	newSubstring : STRING(255);
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
VAR	
	stringTypeNotSupportedException : NotSupportedException;
	sourceStringMemoryOverflowException : TargetVariableMemoryOverflowException;
	
	replaceResult : BOOL; 
END_VAR
VAR
	formattedExceptionMessage : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
	formattedExceptionMessage := Tc2_Utilities.WCONCAT("Not supported type ", TO_WSTRING(sourceString.TypeClass));

	stringTypeNotSupportedException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), formattedExceptionMessage);
END_IF

IF NOT InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount) THEN
	sourceStringMemoryOverflowException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'sourceString', TO_UDINT(sourceString.diSize));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringPointerToAnyType" Id="{a10ef46f-9469-4b72-b2c7-fdc82174f321}">
      <Declaration><![CDATA[(*!
<summary>Builds a borrowed ANY descriptor for text at an address.</summary>
<description>Requires a nonzero address to valid terminated text. Records occupied bytes including the terminator, not buffer capacity; size must fit DINT. Does not copy, allocate or acquire ownership. Keep the source alive while using the descriptor.</description>
*)
METHOD StringPointerToAnyType : __System.AnyType
VAR_INPUT
	value : POINTER TO STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StringPointerToAnyType.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
StringPointerToAnyType.pValue := value;
StringPointerToAnyType.diSize := TO_DINT(GetActualSize(value^));]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringReferenceToAnyType" Id="{06b7793c-cb19-41ed-b05e-889daf02c80f}">
      <Declaration><![CDATA[(*!
<summary>Builds a borrowed ANY descriptor for a string reference.</summary>
<description>Requires a valid reference to terminated text. Records occupied bytes including the terminator, not buffer capacity; size must fit DINT. Keep the source alive while using the descriptor; no ownership is transferred.</description>
*)
METHOD StringReferenceToAnyType : __System.AnyType
VAR_INPUT
	value : REFERENCE TO STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StringReferenceToAnyType.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
StringReferenceToAnyType.pValue := ADR(value);
StringReferenceToAnyType.diSize := TO_DINT(GetActualSize(value));]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringToAnyType" Id="{ad63b85b-ddb5-45f3-baef-6d6cd1517473}" FolderPath="Any\">
      <Declaration><![CDATA[(*!
<summary>Builds a borrowed ANY descriptor for the supplied string.</summary>
<description>Records occupied bytes including the terminator, not buffer capacity; size must fit DINT. Does not copy or acquire ownership. Do not retain the descriptor beyond the source lifetime.</description>
*)
METHOD StringToAnyType : __SYSTEM.AnyType
VAR_IN_OUT CONSTANT
	value : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[StringToAnyType.TypeClass := __SYSTEM.TYPE_CLASS.TYPE_STRING;
StringToAnyType.pValue := ADR(value);
StringToAnyType.diSize := TO_DINT(GetActualSize(value));]]></ST>
      </Implementation>
    </Method>
    <Method Name="TrimChar" Id="{62b24a6d-bbc4-486f-b32e-31180d926835}" FolderPath="Trim\">
      <Declaration><![CDATA[(*!
<summary>Removes repetitions of one character from the selected ends of a string.</summary>
<description>Modifies the supplied string in place using TrimChars and the requested trim mode. Preserves the remaining character order and requires writable terminated text.</description>
*)
METHOD TrimChar
VAR_IN_OUT
	stringToTrim : STRING;
END_VAR
VAR_INPUT
	trimMode : TRIM_MODE := TRIM_MODE.LEFT_AND_RIGHT;
	trimChar : STRING(1) := ' ';
END_VAR
VAR
	trimCharArray : ARRAY [0..0] OF STRING(1);	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[trimCharArray[0] := trimChar;

TrimChars(stringToTrim, trimMode, trimCharArray);]]></ST>
      </Implementation>
    </Method>
    <Method Name="TrimChars" Id="{f8f9620e-29b0-4754-aeb8-6e676ec3c2d0}" FolderPath="Trim\">
      <Declaration><![CDATA[(*!
<summary>Removes selected character values from the requested ends of a string in place.</summary>
<description>The caller supplies a live writable null-terminated string. Left trimming moves the retained suffix, including its terminator, within the same buffer; no new storage is allocated. The trim-character array may have negative bounds. Right trimming stops after the first code unit without decrementing an unsigned index below zero.</description>
*)
METHOD TrimChars
VAR_IN_OUT
	stringToTrim : STRING;
END_VAR
VAR_INPUT
	trimMode : TRIM_MODE := TRIM_MODE.LEFT_AND_RIGHT;
END_VAR
VAR_IN_OUT CONSTANT
	trimChars : ARRAY [*] OF STRING(1);	
END_VAR
VAR
	stringLength : UDINT;
	stringData : POINTER TO BYTE;
	trimCharData : POINTER TO BYTE;
	
	originalCharIndex : UDINT;
	trimCharIndex : DINT;
	trimCharCount : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stringData := ADR(stringToTrim);
stringLength := InternalGetLength(stringData);

IF stringLength < 1 THEN
	RETURN;
END_IF

IF trimMode = TRIM_MODE.LEFT_AND_RIGHT OR_ELSE trimMode = TRIM_MODE.LEFT THEN
	trimCharCount := 0;
	
	FOR originalCharIndex := 0 TO stringLength - 1 BY 1 DO
		FOR trimCharIndex := LOWER_BOUND(trimChars, 1) TO UPPER_BOUND(trimChars, 1) DO
			trimCharData := ADR(trimChars[trimCharIndex]);
			
			IF stringData[originalCharIndex] = trimCharData^ THEN
				trimCharCount := trimCharCount + 1;
				EXIT;
			END_IF
		END_FOR
		
		IF trimCharCount <> originalCharIndex + 1 THEN
			EXIT;
		END_IF
	END_FOR

	IF trimCharCount > 0 THEN
		stringLength := stringLength - trimCharCount;
		
		Tc2_System.MEMMOVE(stringData, stringData + (trimCharCount * CharSize), (stringLength * CharSize) + CharSize);		
	END_IF
END_IF

IF stringLength < 1 THEN
	RETURN;
END_IF

IF trimMode = TRIM_MODE.LEFT_AND_RIGHT OR_ELSE trimMode = TRIM_MODE.RIGHT THEN
	trimCharCount := 0;
	
	FOR originalCharIndex := stringLength TO 1 BY -1 DO
		FOR trimCharIndex := LOWER_BOUND(trimChars, 1) TO UPPER_BOUND(trimChars, 1) DO
			trimCharData := ADR(trimChars[trimCharIndex]);
			
			IF stringData[originalCharIndex - 1] = trimCharData^ THEN
				trimCharCount := trimCharCount + 1;
				EXIT;
			END_IF
		END_FOR
		
		IF trimCharCount <> stringLength - originalCharIndex + 1 THEN
			EXIT;
		END_IF
	END_FOR

	IF trimCharCount > 0 THEN
		stringLength := stringLength - trimCharCount;
		
		Tc2_System.MEMSET(stringData + (stringLength * CharSize), 0, CharSize);		
	END_IF	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryAppendToTarget" Id="{bf1d041e-2745-49ca-b076-368f2e842cc8}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends one STRING to a caller-owned buffer and reports success.</summary>
<description>Requires live, null-terminated source strings and a writable STRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Returns FALSE for a non-STRING target or when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
METHOD TryAppendToTarget : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	sourceString : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryAppendToTarget := InternalAppendToTarget(targetString, ADR(sourceString), 0, 0, 0, 0, 0, 0, 0, 0, 0);
__CATCH
	TryAppendToTarget := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryAppendToTarget255" Id="{9c82266a-bb32-451c-9763-5118bd999fda}" FolderPath="Append\">
      <Declaration><![CDATA[(*!
<summary>Appends up to ten STRING fragments in argument order, skipping empty fragments.</summary>
<description>Requires live, null-terminated source strings and a writable STRING target with valid capacity metadata. Empty fragments do not stop processing; if all are empty, the target is unchanged and the operation succeeds. Returns FALSE for a non-STRING target or when appending fails. Processing stops on the first append failure; earlier modifications are not rolled back. Source storage is borrowed only for this call. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
METHOD TryAppendToTarget255 : BOOL
VAR_INPUT
	targetString : ANY_STRING;
	sourceString1 : STRING(255);
	sourceString2 : STRING(255) := '';
	sourceString3 : STRING(255) := '';
	sourceString4 : STRING(255) := '';
	sourceString5 : STRING(255) := '';
	sourceString6 : STRING(255) := '';
	sourceString7 : STRING(255) := '';
	sourceString8 : STRING(255) := '';
	sourceString9 : STRING(255) := '';
	sourceString10 : STRING(255) := '';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryAppendToTarget255 := InternalAppendToTarget(targetString, ADR(sourceString1), ADR(sourceString2), ADR(sourceString3), ADR(sourceString4), ADR(sourceString5), ADR(sourceString6), ADR(sourceString7), ADR(sourceString8), ADR(sourceString9), ADR(sourceString10));
__CATCH
	TryAppendToTarget255 := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryCreateSplitter" Id="{34df4a0d-a862-4e0c-8436-c7e6b40e8278}" FolderPath="Split\">
      <Declaration><![CDATA[(*!
<summary>Initializes a splitter when the source has the supported string type.</summary>
<description>The source must remain alive and unchanged during iteration. The splitter owns its current fragment; borrowed fragment references expire on MoveNext, Reset or destruction. This method does not allocate the splitter with __NEW. The initialized result has no fragment allocation until MoveNext; assigning it must not overwrite an instance with an unreleased fragment. The caller is responsible for the result lifetime and cleanup, including Reset when abandoning iteration. Do not copy an active splitter by value; use references. Only an instance explicitly allocated with __NEW may be deleted with __DELETE. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Use the output only after TRUE is returned.</description>
*)
//!<param name="maxCount">Maximum number of returned fragments; zero means unlimited. Empty fragments removed after optional trimming do not count toward the limit. Remaining text is not returned after the limit is reached and is not merged into the last fragment.</param>
//!<param name="separator">Copied separator containing 1 to 80 characters. An invalid reference, empty or longer value returns FALSE before initialization.</param>
METHOD TryCreateSplitter : BOOL
VAR_INPUT
	sourceString : ANY_STRING;
END_VAR
VAR_INPUT
	separator : STRING;
	maxCount : UDINT := 0;
	trimEntries : BOOL := FALSE;
	removeEmptyEntries : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	splitter : StringSplittingEnumerator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
		RETURN;
	END_IF

	IF separator = '' OR_ELSE InternalGetLength(ADR(separator)) > 80 THEN
		RETURN;
	END_IF

	splitter.Initialize(sourceString.pValue, separator, maxCount, trimEntries, removeEmptyEntries);

	TryCreateSplitter := TRUE;
__CATCH
	TryCreateSplitter := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryJoinToTarget" Id="{a81f6dab-b206-48bb-a5a8-39b9933d426e}" FolderPath="Join\">
      <Declaration><![CDATA[(*!
<summary>Joins enumerated values into a caller-owned STRING buffer.</summary>
<description>Borrows and advances the enumerator from its current position. Clears the target before joining; previous target contents and enumerator position are not restored on failure. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
METHOD TryJoinToTarget : BOOL
VAR_INPUT
	targetString : ANY_STRING;
END_VAR
VAR_INPUT
	separator : STRING;
	sourceEnumerator : IEnumerator;
	startIndex : UDINT := 0;
	count : UDINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryJoinToTarget := InternalJoinToTarget(targetString, ADR(separator), sourceEnumerator, startIndex, count);
__CATCH
	TryJoinToTarget := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryReplaceInSource" Id="{6cd9fde4-681b-4169-adb0-283364fff827}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Returns FALSE for an incompatible source type or if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD TryReplaceInSource : BOOL
VAR_INPUT
	sourceString : ANY_STRING;
END_VAR
VAR_IN_OUT CONSTANT
	oldSubstring : STRING;
	newSubstring : STRING;
END_VAR
VAR_INPUT
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
		RETURN;
	END_IF

	TryReplaceInSource := InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount);
__CATCH
	TryReplaceInSource := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryReplaceInSource255" Id="{9f1f7515-63df-42e0-8ebb-d9a7a98ddbf5}" FolderPath="Replace\">
      <Declaration><![CDATA[(*!
<summary>Replaces matching substrings in the supplied text buffer.</summary>
<description>Replaces exact, case-sensitive, non-overlapping occurrences in place. An empty oldSubstring succeeds without changes and sets replacementCount to zero. An empty newSubstring deletes matched text. Zero maxReplacements means no replacement limit; skipReplacements skips the first matching occurrences. Returns FALSE for an incompatible source type or if replacement cannot complete. Replacement is not atomic. If the next replacement would exceed buffer capacity, it is not performed; completed replacements remain, replacementCount reports their count, and the valid source remains null-terminated. These guarantees concern capacity failure with valid input buffers, not invalid memory access. The caller supplies live buffers of the correct encoding; sourceString must be writable and its size must include space for the terminator. Catches exceptions and returns FALSE; terminal allocation state is preserved for the task boundary. Partial writes are not rolled back. Valid buffer lifetime and capacity remain caller preconditions.</description>
*)
//!<param name="oldSubstring">Text to replace; empty performs no replacements.</param>
//!<param name="newSubstring">Replacement text; empty deletes each selected match.</param>
//!<param name="replacementCount">Number of completed replacements.</param>
METHOD TryReplaceInSource255 : BOOL
VAR_INPUT
	sourceString : ANY_STRING;
	oldSubstring : STRING(255);
	newSubstring : STRING(255);
	maxReplacements : UINT := 0;
	skipReplacements : UINT := 0;
END_VAR
VAR_OUTPUT
	replacementCount : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF sourceString.TypeClass <> __SYSTEM.TYPE_CLASS.TYPE_STRING THEN
		RETURN;
	END_IF

	TryReplaceInSource255 := InternalReplaceInSource(sourceString, ADR(oldSubstring), ADR(newSubstring), maxReplacements, skipReplacements, replacementCount => replacementCount);
__CATCH
	TryReplaceInSource255 := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>