<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ERROR" Id="{180a9e25-68c0-4c96-ae5f-287c5c722d87}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Stores a copied error state independently of transient exception objects.</summary>
<description>
Diagnostic string inputs are borrowed only during the call; retained diagnostic text is copied into owned
storage. Clear resets timestamps to LongDateAndTimes.EPOCH.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FINAL ERROR EXTENDS READ_ONLY_ERROR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Clear" Id="{bd8970f1-368c-495e-b105-e7dc2fa26d3d}">
      <Declaration><![CDATA[(*!
<summary>Clears diagnostic text and resets timestamps to the epoch.</summary>
<description>Restores ERROR severity without releasing the instance.</description>
*)
METHOD Clear]]></Declaration>
      <Implementation>
        <ST><![CDATA[Severity := ERROR_SEVERITY.ERROR;

TopSource := '';
RootSource := '';

TopMessage := "";
RootMessage := "";

LocalTimestamp := LongDateAndTimes.EPOCH;	
UtcTimestamp := LongDateAndTimes.EPOCH;	]]></ST>
      </Implementation>
    </Method>
    <Method Name="Fill" Id="{60f74742-6b8e-4a2a-9509-b711eda516e3}">
      <Declaration><![CDATA[(*!
<summary>Copies supplied diagnostics into the error state.</summary>
<description>
Long diagnostic strings are borrowed read-only for this call; their references are not retained. Pass
variables or literals, and store computed expressions in local variables before calling.
</description>
*)
METHOD INTERNAL Fill
VAR_INPUT
	severity : ERROR_SEVERITY;
	topSource : STRING(255);
	rootSource : STRING(255);
END_VAR
VAR_IN_OUT CONSTANT
	topMessage : ERROR_MESSAGE;
	rootMessage : ERROR_MESSAGE;
END_VAR
VAR_INPUT
	localTimestamp : LDATE_AND_TIME;	
	utcTimestamp : LDATE_AND_TIME;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Severity := severity;
	
THIS^.TopSource := topSource;
THIS^.RootSource := rootSource;
	
THIS^.TopMessage := topMessage;
THIS^.RootMessage := rootMessage;
 	
THIS^.LocalTimestamp := localTimestamp;	
THIS^.UtcTimestamp := utcTimestamp;	]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMessage" Id="{a94b2a72-17d2-4097-a27b-ad6cd57b13b4}">
      <Declaration><![CDATA[(*!
<summary>Changes the stored diagnostic message.</summary>
<description>
Sets TopMessage and RootMessage to the specified message text.
</description>
*)
METHOD SetMessage
VAR_INPUT
	message : ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TopMessage := message;
RootMessage := message;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSeverity" Id="{0fe3526d-fbb4-403c-80ed-7c073f10ca8a}">
      <Declaration><![CDATA[(*!
<summary>Changes the stored diagnostic severity.</summary>
<description>
Other error fields and timestamps are unchanged. Does not raise the stored error or execute an exception
policy.
</description>
*)
METHOD SetSeverity
VAR_INPUT
	severity : ERROR_SEVERITY;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Severity := severity;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSource" Id="{9d363613-4ffa-416e-bef8-b6285cfc4e5b}">
      <Declaration><![CDATA[(*!
<summary>Formats and stores the error source description.</summary>
<description>
Constructs a qualified source name from namespace, class, and POU names and sets TopSource and RootSource.
</description>
*)
METHOD SetSource
VAR_INPUT
	sourceNamespaceName : STRING(255);
	sourceClassName : STRING(255);
	sourcePOUName : STRING(255);
END_VAR
VAR
	source : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[source := sourceNamespaceName;

IF source <> '' AND_THEN sourceClassName <> '' THEN
	source := Strings.ConcatFit255(source, '.', sourceClassName);
ELSIF sourceClassName <> '' THEN
	source := sourceClassName;
END_IF

IF source <> '' AND_THEN sourcePOUName <> '' THEN
	source := Strings.ConcatFit255(source, '.', sourcePOUName);
ELSIF sourcePOUName <> '' THEN
	source := sourcePOUName;
END_IF

TopSource := source;
RootSource := source;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
