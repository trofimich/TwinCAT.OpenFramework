(*!
<summary>Provides LDATE_AND_TIME limits, the epoch and date/time formatting with selectable separators.</summary>
<description>Formatting removes the type prefix from the native text representation. Each separator can contain one character or be empty to omit that separator. No time-zone conversion is performed.</description>
*)
{attribute 'no_explicit_call' := 'Direct call is not allowed'} 
PROGRAM LongDateAndTimes
VAR CONSTANT
	//!<summary>Earliest timestamp in the documented signed 64-bit nanosecond range.</summary>
	MIN_VALUE : LDATE_AND_TIME := LDT#1677-9-21-0:12:43.145224192;

	//!<summary>Latest timestamp in the documented signed 64-bit nanosecond range.</summary>
	MAX_VALUE : LDATE_AND_TIME := LDT#2262-4-11-23:47:16.854775807;

	//!<summary>Zero timestamp, also used when clearing diagnostic timestamps.</summary>
	EPOCH : LDATE_AND_TIME := LDT#1970-1-1-0:0:0;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{32f4e9c0-d85f-47fa-9030-ab2a61f48646}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0a883567-d531-4b79-bebf-a310e767e671}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c3cdb8a4-c2ff-43ef-87fb-0df200eedbbd}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7e5b5981-95ae-4a92-92e8-f5679b08be22}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToString" Id="{ba00e9fa-ef5e-496b-9555-124640d5ae44}">
      <Declaration><![CDATA[(*!
<summary>Formats the date and time without the type prefix, using the supplied separators.</summary>
<description>Empty separators remove the corresponding delimiters. Date and time fields retain their native order and padding; any fractional-second suffix is preserved.</description>
*)
//!<param name="value">Date and time to format without time-zone conversion.</param>
//!<param name="dateValuesSeparator">Separator between year, month and day; empty omits both delimiters.</param>
//!<param name="dateAndTimeSeparator">Separator between date and time; empty omits it.</param>
//!<param name="timeValuesSeparator">Separator between hours, minutes and seconds; empty omits both delimiters.</param>
METHOD ToString : STRING
VAR_INPUT
	value : LDATE_AND_TIME;
	dateValuesSeparator : STRING(1) := '_';
	dateAndTimeSeparator : STRING(1) := '-';
	timeValuesSeparator : STRING(1) := '_';
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ToString := TO_STRING(value);

ToString := Tc2_Standard.DELETE(ToString, 4, 1);

(* Replace from right to left so empty separators do not shift pending positions. *)
ToString := Tc2_Standard.REPLACE(ToString, timeValuesSeparator, 1, 17);
ToString := Tc2_Standard.REPLACE(ToString, timeValuesSeparator, 1, 14);
ToString := Tc2_Standard.REPLACE(ToString, dateAndTimeSeparator, 1, 11);
ToString := Tc2_Standard.REPLACE(ToString, dateValuesSeparator, 1, 8);
ToString := Tc2_Standard.REPLACE(ToString, dateValuesSeparator, 1, 5);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToWideString" Id="{6f976291-a1ce-4599-b7c9-23f1dff08c8c}">
      <Declaration><![CDATA[(*!
<summary>Formats the date and time without the type prefix, using the supplied separators.</summary>
<description>Empty separators remove the corresponding delimiters. Date and time fields retain their native order and padding; any fractional-second suffix is preserved.</description>
*)
//!<param name="value">Date and time to format without time-zone conversion.</param>
//!<param name="dateValuesSeparator">Separator between year, month and day; empty omits both delimiters.</param>
//!<param name="dateAndTimeSeparator">Separator between date and time; empty omits it.</param>
//!<param name="timeValuesSeparator">Separator between hours, minutes and seconds; empty omits both delimiters.</param>
METHOD ToWideString : WSTRING
VAR_INPUT
	value : LDATE_AND_TIME;
	dateValuesSeparator : WSTRING(1) := "_";
	dateAndTimeSeparator : WSTRING(1) := "-";
	timeValuesSeparator : WSTRING(1) := "_";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ToWideString := TO_WSTRING(value);

ToWideString := Tc2_Standard.WDELETE(ToWideString, 4, 1);

(* Replace from right to left so empty separators do not shift pending positions. *)
ToWideString := Tc2_Standard.WREPLACE(ToWideString, timeValuesSeparator, 1, 17);
ToWideString := Tc2_Standard.WREPLACE(ToWideString, timeValuesSeparator, 1, 14);
ToWideString := Tc2_Standard.WREPLACE(ToWideString, dateAndTimeSeparator, 1, 11);
ToWideString := Tc2_Standard.WREPLACE(ToWideString, dateValuesSeparator, 1, 8);
ToWideString := Tc2_Standard.WREPLACE(ToWideString, dateValuesSeparator, 1, 5);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>