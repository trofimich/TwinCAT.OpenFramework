<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DenyAllActionsPermissionsPolicy" Id="{a7584d7c-0677-4d64-970c-2a07620ed1b3}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Rejects every action request and provides a diagnostic reason.</summary>
<description>
The policy retains no request references and transfers no ownership.
Null action or requester references are defensively described as &lt;unspecified&gt;,
but remain invalid arguments under the IActionPermissionPolicy contract.
Names are expected to be nonempty; an empty name is reported as &lt;empty&gt;.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'} 
FUNCTION_BLOCK DenyAllActionsPermissionsPolicy EXTENDS Object IMPLEMENTS IActionPermissionPolicy
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CheckActionPermission" Id="{d72b856c-b0a2-4eae-a2e9-6ef99ba01f5f}">
      <Declaration><![CDATA[(*!
<summary>Returns FALSE and writes the rejection reason when a valid reason buffer is supplied.</summary>
<description>
All three input references must be non-null and refer to live objects during the call.
Name and GetName are read once each when needed; their exceptions are not caught.
The evaluating object does not affect this unconditional rejection.
 Descendants cannot change this unconditional policy; implement IActionPermissionPolicy separately for conditional decisions.</description>
*)

METHOD FINAL CheckActionPermission : BOOL
VAR_INPUT
	actionDescriptor : INamed;
	requestingObject : IObject;
	evaluatingObject : IObject;
END_VAR
VAR_IN_OUT
	rejectReason : WSTRING(255);
END_VAR
VAR
	actionName : WSTRING;
	requesterName : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckActionPermission := FALSE;

IF __ISVALIDREF(rejectReason) THEN
	actionName := SEL(actionDescriptor = 0, actionDescriptor.Name, "<unspecified>");
	requesterName := SEL(requestingObject = 0, requestingObject.GetName(), "<unspecified>");

	actionName := SEL(actionName = "", actionName, "<empty>");
	requesterName := SEL(requesterName = "", requesterName, "<empty>");

	rejectReason := WideStrings.Concat255(actionName, " action for ", requesterName, " object is denied by permission policy");
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a6e4648f-61b8-4a07-9d31-556d4e4b1094}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cf63f76b-13f0-4401-a20a-ecf97cf45bb4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{4e80db76-0be7-4534-a935-36068dce91f1}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a2a3f4be-b456-425d-9430-8b502fbc1a34}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b5568351-0057-49d6-a005-62126069e659}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary address is valid.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{83366eb8-d700-4124-8648-db3dfc18cc81}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>