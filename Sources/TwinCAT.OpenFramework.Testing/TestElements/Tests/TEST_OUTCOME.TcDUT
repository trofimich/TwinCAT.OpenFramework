(*!
<summary>Defines the execution outcome of an individual test scenario.</summary>
<description>
Tracks whether a test has not yet run, is currently executing across cycles, passed all assertions, failed an
assertion or invariant, or was explicitly skipped.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE TEST_OUTCOME :
(
	NOT_RUN := 0,
	RUNNING := 1,
	PASSED := 2,
	FAILED := 3,
	SKIPPED := 4
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
