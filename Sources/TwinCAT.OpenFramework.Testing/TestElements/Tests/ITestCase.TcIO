<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITestCase" Id="{f5480a3d-b442-4c07-8857-37f89dee6825}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Receives assertion failures for one individual test.</summary>
<description>
Groups use ITestElement and do not receive leaf assertions. A failure is copied only while the case is running.
</description>
*)

INTERFACE ITestCase EXTENDS ITestElement]]></Declaration>
    <Method Name="RecordFailure" Id="{b03b0614-c7c6-48c7-b3a2-81ceb190a89a}">
      <Declaration><![CDATA[(*!
<summary>Copies the first failure of the running case; later diagnostics do not replace it.</summary>
*)
METHOD RecordFailure
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
