<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SingleCycleTest" Id="{59b4a65d-4a05-4722-819a-36c8562f296a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
