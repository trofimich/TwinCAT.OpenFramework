(*!
<summary>Base class for one test whose body completes in a single PLC scheduling cycle.</summary>
<description>
Override ExecuteTest with the checks. Returning from the body requests completion automatically.
BeforeTest and AfterTest are optional scenario hooks. Constructor name identifies the case in reports.
Run through TestRunner, directly or inside a TestGroup. A complete run and its reporting may span more cycles
than the body. All instance access belongs to one task without reentry; other tasks need other instances.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ABSTRACT SingleCycleTest EXTENDS TestCase]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{aba7bd54-5472-4bef-8617-736ab163a181}" />
    <Folder Name="Overriden methods" Id="{cf9920fa-5d20-449d-822c-735801bafbec}" />
    <Method Name="ExecuteTest" Id="{f7894cdc-7848-47ac-aeb9-55a4677731f3}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Implements the scenario body without runner guards or enumeration.</summary>
<description>
Keep persistent state in instance fields. Reporting a failure does not abort the current callback.
</description>
*)
METHOD PROTECTED ABSTRACT ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunCycle" Id="{6045f532-2fae-4f40-9d43-ddf9bb628fbb}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Runs the body once and requests automatic completion.</summary>
*)
METHOD PROTECTED FINAL RunCycle]]></Declaration>
      <Implementation>
        <ST><![CDATA[ExecuteTest();
Complete();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>