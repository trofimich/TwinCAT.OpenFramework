<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MultiCycleTest" Id="{8cda74e3-1495-4278-a836-9bfd4a77697a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Base class for one test that waits or advances state across PLC scheduling cycles.</summary>
<description>
Override ExecuteTest with one bounded step. Return to await the next task cycle; call Complete when done.
BeforeTest prepares once and AfterTest cleans up once, including failure. Timeout defaults to one second;
zero disables it. A nonzero deadline is checked before every body after the first. Completion accepted in an
earlier cycle is never replaced by a later timeout. Timing sums nominal task periods, not wall-clock time.
Use a typed enumeration in the derived FB when the scenario needs a state machine. No numeric step API is used.
Each instance belongs to one task without reentry. Constructor name identifies the case in reports.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ABSTRACT MultiCycleTest EXTENDS TestCase
VAR
	_Timeout : TIME := T#1S;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{98482b8c-7888-4861-a59f-76e437685054}" />
    <Folder Name="Overriden methods" Id="{be69990e-9557-417e-92ef-495421a2aa82}" />
    <Method Name="ExecuteTest" Id="{b3d39995-4289-4606-8b3b-4785f67f7348}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Implements the scenario body without runner guards or enumeration.</summary>
<description>
Keep persistent state in instance fields. Reporting a failure does not abort the current callback.
</description>
*)
METHOD PROTECTED ABSTRACT ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunCycle" Id="{02dee6c8-7b88-4050-a8e1-c794b74bbb8d}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[(*!
<summary>Checks the deadline before advancing one body cycle.</summary>
*)
METHOD PROTECTED FINAL RunCycle]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Timeout > T#0S AND_THEN _Elapsed >= TO_LTIME(_Timeout) THEN
	RecordFailure(message := "Multi-cycle test exceeded deadline");
ELSE
	ExecuteTest();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Timeout" Id="{4d60ae0e-cb4d-4b54-94f1-05165d4c6498}">
      <Declaration><![CDATA[(*!
<summary>Gets or configures the whole-scenario deadline; zero disables it.</summary>
<description>
Configure before execution or after completion. Mutation during a run raises StandardException
because the operation is invalid in the current state, regardless of the requested deadline value.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Timeout : TIME]]></Declaration>
      <Get Name="Get" Id="{cc9d6102-f10e-46d8-afe8-09f863d61320}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Timeout := _Timeout;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c3a260af-290f-4cac-b3f7-4e8cd3385e54}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF IsRunning THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Cannot change an active test deadline"
	);
END_IF

_Timeout := Timeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
