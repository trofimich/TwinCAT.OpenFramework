(*!
<summary>Indicates whether a test body needs more scheduling cycles or has finished on the current cycle.</summary>
<description>
BUSY (0) is the default uninitialized value and keeps the test running across subsequent cycles unless a failure
or deadline terminates the run. DONE (1) requests normal completion after the current cycle returns.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE TEST_CYCLE_RESULT :
(
	BUSY := 0,
	DONE := 1
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>

