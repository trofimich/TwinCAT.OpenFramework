<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IParentTestElement" Id="{78c61850-3583-4050-a944-313c19c24cfe}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes borrowed direct children of a test element in fixed execution order.</summary>
<description>
ChildCount is stable throughout the element's lifetime; each direct child occupies one non-null slot.
GetChildByIndex borrows a child without resetting or executing it and transfers no allocation ownership.
Children and parent links obey ITestElement lifetime and lifecycle rules. Observations belong to the owning
task without reentry or cross-task synchronization. An empty composition has ChildCount zero and no valid index.
</description>
*)

INTERFACE IParentTestElement EXTENDS ITestElement]]></Declaration>
    <Property Name="ChildCount" Id="{6df6b6fd-b6cd-46b9-b34a-1f3793fca8a4}">
      <Declaration><![CDATA[(*!
<summary>Reports the fixed number of direct children, including zero for an empty composition.</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY FINAL ChildCount : TOF_Core.INT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{aa4c0bc2-236c-448a-8510-180a2e3ed0e1}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="GetChildByIndex" Id="{0e344f6d-c551-40be-a433-1694385106a1}">
      <Declaration><![CDATA[(*!
<summary>Borrows a direct child by its zero-based position in fixed execution order.</summary>
<description>
Available before the first Reset and after a failed Reset, provided the backing array and selected slot exist.
Missing storage or a null selected slot raises DataMemberNotSpecifiedException. Storage is checked first;
an index outside zero through ChildCount minus one raises ArgumentOutOfRangeException.
Does not mutate or execute the child, repeat whole-tree validation, or transfer ownership.
The child must remain alive while the interface is used; use only from the tree's owning task without reentry.
</description>
<param name="index">Zero-based direct-child position; an empty composition has no valid value.</param>
*)
METHOD GetChildByIndex : ITestElement
VAR_INPUT
	index : TOF_Core.INT_LENGTH;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
