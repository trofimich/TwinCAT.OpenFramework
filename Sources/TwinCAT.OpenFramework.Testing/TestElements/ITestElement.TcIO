(*!
<summary>Common cyclic execution contract for an individual test or a group of tests.</summary>
<description>
A live element occupies one slot of one tree. Its parent is assigned at construction and remains unchanged.
Its parent, descendants, reporter and tested resources remain alive and stable during a run.
All execution, configuration and observation of a tree belong to one cyclic task without reentry.
Separate tasks use disjoint trees, reporters and mutable tested resources; this interface provides no synchronization.
Execute advances at most one leaf body per call. A completed element ignores Execute until Reset.
Counts describe leaf results only. Empty groups finish successfully with zero tests.
Custom implementations must preserve parent links and all lifecycle rules; callback exceptions abort the runner.
</description>
*)

INTERFACE ITestElement EXTENDS TOF_Core.INamed, TOF_Core.IExecutable]]></Declaration>
    <Property Name="Duration" Id="{23217c5a-7bcd-413f-868c-8dd1a1ae446f}">
      <Declaration><![CDATA[(*!
<summary>Reports nominal execution duration accumulated from calling task periods.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Duration : TIME]]></Declaration>
      <Get Name="Get" Id="{c847d1d2-ec18-4efc-bcc1-534e1ac18833}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="FailedCount" Id="{847324ac-ec0f-4822-8490-31b62cf3cce0}">
      <Declaration><![CDATA[(*!
<summary>Counts failed leaf tests in this element.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FailedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{8f690972-77ee-4a79-9123-9bb8df605655}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="GetPath" Id="{f2e41811-b03a-4130-9a08-811e55bfcca0}">
      <Declaration><![CDATA[(*!
<summary>Builds the full display path from the root through this element.</summary>
<description>
Joins nonempty names with '/', including this element's name. A nameless root returns an empty path.
The result is a copied WSTRING bounded to 255 characters; overflow preserves the root prefix and ends with an ellipsis.
Reads the live Parent and Name properties without caching or changing the tree. All providers must remain alive
and stable during the call; use only in the owning task without reentry. Can be called before Reset.
A cyclic Parent chain raises StandardException to prevent an endless traversal. Provider exceptions propagate;
no element state or ownership is changed. Valid traversal uses fixed local strings without recursion or heap allocation.
</description>
*)
METHOD GetPath : WSTRING(255)]]></Declaration>
    </Method>
    <Property Name="IsFinished" Id="{5b672cd9-b8bc-4c21-91cc-29f125fd3f14}">
      <Declaration><![CDATA[(*!
<summary>Reports whether this element has completed.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY IsFinished : BOOL]]></Declaration>
      <Get Name="Get" Id="{e46c8031-4485-4e72-b736-9a1e43d0ebae}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="IsRunning" Id="{b5ebedb3-0e0d-418c-a657-53b3406d5acd}">
      <Declaration><![CDATA[(*!
<summary>Reports whether this element has started and has not completed.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY IsRunning : BOOL]]></Declaration>
      <Get Name="Get" Id="{87216d77-1bc7-40c3-bc20-fe2e10386d80}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Parent" Id="{4fde6d76-9127-46b9-98cb-8dd7929f935f}">
      <Declaration><![CDATA[(*!
<summary>Returns the group assigned at construction, or zero for a root.</summary>
<description>
Borrowed lifetime association. Reset and execution do not change it; the parent must remain alive.
Root registration with a runner does not bind Parent; a root must belong to one runner only.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Parent : ITestElement]]></Declaration>
      <Get Name="Get" Id="{32543d01-f617-4bfc-b84d-88dfa567a393}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="PassedCount" Id="{d1751c10-885f-4f63-a234-43d7a2d751a8}">
      <Declaration><![CDATA[(*!
<summary>Counts passed leaf tests in this element.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY PassedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{2dccfc05-41b7-4c3b-a1ac-8ef5732695ac}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Reset" Id="{6bdba6f8-2a7c-49ae-886d-7d690a5f0ab9}">
      <Declaration><![CDATA[(*!
<summary>Prepares a fresh run and borrows the reporter.</summary>
<description>
Call before first execution, after completion, or after an aborted run once resources are safe.
This is not cancellation: it does not execute test teardown. The reporter may be zero to suppress reporting.
Group reset recursively resets descendants. External callback exceptions propagate; partial reset is possible.
</description>
*)
METHOD Reset
VAR_INPUT
	reporter : ITestReporter;
END_VAR]]></Declaration>
    </Method>
    <Property Name="SkippedCount" Id="{10f8696d-5c9b-4e11-ba87-981a62fce916}">
      <Declaration><![CDATA[(*!
<summary>Counts skipped leaf tests in this element.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SkippedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{dd1b73a6-62d0-4bde-a872-db3bfaed76c2}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>
