<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITestElement" Id="{ec9df852-1c70-4234-b970-c636a8d48b27}">
    <Declaration><![CDATA[(*
