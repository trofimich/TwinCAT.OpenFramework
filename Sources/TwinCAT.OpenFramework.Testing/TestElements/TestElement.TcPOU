<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestElement" Id="{643696b2-4079-4318-bb67-0551c73b3953}" SpecialFunc="None">
    <Declaration><![CDATA[(*
