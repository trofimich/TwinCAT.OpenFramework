<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITestReporter" Id="{681ed28b-976d-4e3d-a09a-aa5f84cb6989}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Receives run boundaries and one terminal result per leaf test.</summary>
<description>
Callbacks execute synchronously in the owning runner task. Inputs are borrowed for the call only.
Do not retain them, reenter the tree, or share mutable reporter state between tasks. An exception aborts the
runner with ExitCode -1; output may be incomplete and the callback is not retried. Group paths are bounded
slash-separated display names. Groups do not emit synthetic test results or nested suite callbacks.
ReportTestCaseResult requires PASSED, FAILED or SKIPPED; other outcomes are invalid configuration.
Individual test names are bounded to 80 wide characters, matching INamed; group paths retain their 255-character bound.
</description>
*)

INTERFACE ITestReporter EXTENDS TOF_Core.IObject]]></Declaration>
    <Method Name="ReportRunStart" Id="{6bb99788-6f00-431f-9b5c-62be8af6fae6}">
      <Declaration><![CDATA[(*!
<summary>Begins a run with the number of direct root elements.</summary>
*)
METHOD ReportRunStart
VAR_INPUT
	totalElements : UDINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ReportRunEnd" Id="{6f87717f-47a0-4822-a839-b190d0373946}">
      <Declaration><![CDATA[(*!
<summary>Completes a run with aggregated leaf counts and nominal duration.</summary>
*)
METHOD ReportRunEnd
VAR_INPUT
	totalTests : UDINT;
	passedTests : UDINT;
	failedTests : UDINT;
	skippedTests : UDINT;
	duration : TIME;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ReportTestCaseResult" Id="{2bd548df-db84-4b62-8a79-e87ba0e0d027}">
      <Declaration><![CDATA[(*!
<summary>Receives one terminal leaf outcome and its first copied diagnostic.</summary>
<param name="testName">Individual name of at most 80 wide characters; longer input uses IEC truncation.</param>
*)
METHOD ReportTestCaseResult
VAR_INPUT
	groupPath : WSTRING(255);
	testName : WSTRING;
	outcome : TEST_OUTCOME;
	duration : TIME;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
