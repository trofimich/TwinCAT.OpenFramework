<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CurrentNamespace" Id="{7fbdfc81-facd-416a-8284-7e0f397f7a6d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exposes the compiler-initialized namespace of the Testing library.</summary>
<description>Static internal storage; Name is a borrowed read-only view and requires no cyclic execution.</description>
*)

{attribute 'no_explicit_call' := 'do not call this POU directly'}
PROGRAM INTERNAL CurrentNamespace
VAR
	{attribute 'hide'} 
	_NamespaceExtractor : NamespaceExtractor;
	_ClassName : STRING := __POUNAME();
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Name" Id="{18130325-9c7d-4aa2-83fb-79a118015491}">
      <Declaration><![CDATA[(*!
<summary>Returns the compiler-initialized library namespace.</summary>
<description>Borrowed read-only reference to static storage. Do not modify it through the reference.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Name : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b742559a-71e1-4c73-8028-dbb41e34cf0a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name REF= _NamespaceExtractor.CurrentNamespace;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{5c054a1d-83db-46a5-9726-8025d143cd99}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete metadata provider name for its lifetime.</summary>
<description>Borrowed read-only storage; callers must not modify it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dd5e6aa5-438c-4ed2-a7d6-baf105f02a19}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{40ebb8d6-1ce3-4b63-8769-ef9970c7551b}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized library namespace.</summary>
<description>Borrowed read-only storage; callers must not modify it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bca9ff00-7851-4aad-9f0d-046e09420a9d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceExtractor.CurrentNamespace;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
