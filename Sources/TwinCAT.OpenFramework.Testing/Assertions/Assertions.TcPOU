    <Method Name="ThatTimeOfDay" Id="{e1c6e82b-d7f7-42ff-b709-f09124264461}">
      <Declaration><![CDATA[(*!
<summary>Begins a fluent chain on a copied TIME_OF_DAY value.</summary>
<description>
