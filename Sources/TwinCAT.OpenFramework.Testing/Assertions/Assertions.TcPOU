<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Assertions" Id="{c5c66080-dd7b-4c29-a18b-311b570421e8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides fluent test assertion entry points on values, variables, and objects.</summary>
<description>
TestCase owns and binds this instance before its first callback.
Typed That methods copy actual values into independent persistent contexts; generic That borrows a live variable.
Contexts do not call one another; shared services only report failures and implement floating value policy.
Finish one immediate chain before starting another, regardless of operand type. Do not retain a returned
context or use this provider across tasks or reentrantly. Every entry verifies that its owning case is running.
An optional copied message prefixes every assertion failure in the chain and is replaced on the next entry.
Typed contexts apply ordinary IEC input conversions; select the entry matching the intended operand type.
Do not copy this provider by value: its contexts retain borrowed links to the owning test case and actual storage.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK Assertions EXTENDS TOF_Core.Object
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();	
END_VAR
VAR	
	_AssertionContext : AssertionContext;
	
	_BoolContext : BoolAssertionContext;
	_SIntContext : SIntAssertionContext;
	_IntContext : IntAssertionContext;
	_DIntContext : DIntAssertionContext;
	_LIntContext : LIntAssertionContext;
	_USIntContext : USIntAssertionContext;
	_UIntContext : UIntAssertionContext;
	_UDIntContext : UDIntAssertionContext;
	_ULIntContext : ULIntAssertionContext;
	_ByteContext : ByteAssertionContext;
	_WordContext : WordAssertionContext;
	_DWordContext : DWordAssertionContext;
	_LWordContext : LWordAssertionContext;
	_RealContext : RealAssertionContext;
	_LongRealContext : LongRealAssertionContext;
	_StringContext : StringAssertionContext;
	_WideStringContext : WideStringAssertionContext;
	_TimeContext : TimeAssertionContext;
	_LongTimeContext : LongTimeAssertionContext;
	_DateContext : DateAssertionContext;
	_LongDateContext : LongDateAssertionContext;
	_DateTimeContext : DateTimeAssertionContext;
	_LongDateTimeContext : LongDateTimeAssertionContext;
	_TimeOfDayContext : TimeOfDayAssertionContext;
	_LongTimeOfDayContext : LongTimeOfDayAssertionContext;
	_PointerContext : PointerAssertionContext;
	
	_TestCase : ITestCase;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{aff23fec-d37f-4bc7-96c2-5daacbaa23fd}" />
    <Method Name="Bind" Id="{1913e0b8-2c8b-43b6-8306-497c1e985bff}" FolderPath="Service methods\">
      <Declaration><![CDATA[//! <summary>Borrows the owning test case for assertion failure reporting throughout the run.</summary>
METHOD INTERNAL FINAL Bind
VAR_INPUT
	testCase : ITestCase;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TestCase := testCase;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{cedffaae-8285-44cb-bcfe-0800716d4289}">
      <Declaration><![CDATA[//! <summary>Provides assertion-provider metadata.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3bbc52bc-acd6-497c-89cc-695cade470a5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c7f12d6c-b6aa-4761-9b18-ee3561c92802}">
      <Declaration><![CDATA[(*!
<summary>Returns the namespace name of this assertion provider.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e644b974-2ba7-41f2-80ec-99ae442f8b8a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="requireRunningCase" Id="{e679a173-3157-4879-950f-0cc9d7dd7207}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Rejects assertion entry outside a running owning case before context mutation.</summary>
<description>
Raises DataMemberNotSpecifiedException when no running test case is bound.
</description>
*)
METHOD PRIVATE requireRunningCase]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _TestCase = 0 OR_ELSE NOT _TestCase.IsRunning THEN
	TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		dataMemberName := '_TestCase'
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{28eb59cc-ef59-4b98-aa57-665d8ddd68a2}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>
Uses XSIZEOF on the instance. Does not include separately allocated payloads or prove that an arbitrary
address is valid.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{86a31974-0b8b-46fb-9bf1-fc591abf2b82}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="That" Id="{22cd1d79-b8bb-472f-b99d-fbbc46d0167c}">
      <Declaration><![CDATA[(*!
<summary>Begins a fluent assertion chain on the provided actual value.</summary>
<description>
Borrows actual storage for this expression; actual must be a variable. Use typed entry points for literals
and expression results. Starting another chain replaces that entry's operand and message.
Calling That without a running owning case raises DataMemberNotSpecifiedException.
Equality follows GENERIC_VALUE byte/value semantics; FB operands do not invoke Object.Equals.
For object equality, use ThatBool on the Boolean result of its explicit Equals call.
</description>
<param name="actual">Live variable borrowed through the immediate chain.</param>
<param name="message">Optional copied prefix for every failure in this chain; default empty.</param>
*)
METHOD That : REFERENCE TO AssertionContext
VAR_INPUT
	actual : ANY;
	message : WSTRING(255) := "";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[requireRunningCase();

_AssertionContext.Prepare(actual := actual, testCase := _TestCase, message := message);

That REF= _AssertionContext;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ThatBool" Id="{d6ee4e28-cb94-42d5-9f84-888d1e16a02e}">
      <Declaration><![CDATA[(*!
<summary>Begins a fluent chain on a copied BOOL value.</summary>
<description>
Accepts literals, variables and expression results through a concrete IEC input type.
Requires a running owning case; otherwise raises DataMemberNotSpecifiedException.
Finish this chain before starting another. The message applies to every assertion in the chain.
</description>
<param name="actual">Value copied after ordinary IEC conversion to BOOL.</param>
<param name="message">Optional copied diagnostic prefix; default empty replaces the previous prefix.</param>
*)
METHOD ThatBool : REFERENCE TO BoolAssertionContext
VAR_INPUT
	actual : BOOL;
	message : WSTRING(255) := "";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[requireRunningCase();

_BoolContext.Prepare(actual := actual, testCase := _TestCase, message := message);

ThatBool REF= _BoolContext;]]></ST>
      </Implementation>
    </Method>
