(*!
<summary>Provides fluent assertions on a copied LDATE_AND_TIME value.</summary>
<description>
Copies actual into persistent instance storage before the entry method returns; literals and expression
results therefore remain valid throughout the immediate chain. Owns no heap allocation or pointed-to resource.
The message prefixes every failure until the next preparation. Finish one chain before starting another on
the owning Assertions provider. Use only from the owning test callback on one task, without reentry.
Obtain this context from the owning provider; direct unprepared use is unsupported.
Expected arguments use the declared IEC type; ordinary compiler conversions happen before comparison.
This context does not depend on another assertion context.
Object metadata is available before preparation; inherited equality compares instance identity.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LongDateTimeAssertionContext EXTENDS TOF_Core.Object
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Actual : LDATE_AND_TIME;
	_TestCase : ITestCase;
	_Message : WSTRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{f1e9d44c-a5c7-4e9b-917a-3c46c3b02b45}" />
    <Property Name="ClassName" Id="{5bd2e045-3d25-4b46-a6e1-40a4a4a1b8e3}">
      <Declaration><![CDATA[(*!
<summary>Provides the implementation class name.</summary>
<description>
Borrowed read-only reference to compiler-initialized storage, valid throughout the instance lifetime.
Do not modify the returned reference; no ownership is transferred.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dc35daa9-f5f2-43d6-bb82-9c9f44a472e3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="IsGreaterThan" Id="{07b5a565-3a32-4726-8904-ab0bd9faeaea}">
      <Declaration><![CDATA[(*!
<summary>Asserts that the actual value is strictly greater than expected.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to LDATE_AND_TIME.</param>
*)
METHOD FINAL IsGreaterThan : REFERENCE TO LongDateTimeAssertionContext
VAR_INPUT
	expected : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual <= expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected value > "
	);
END_IF

IsGreaterThan REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsGreaterThanOrEquals" Id="{af40cccc-0fbf-4384-9eb9-c54aaf1b9201}">
      <Declaration><![CDATA[(*!
<summary>Asserts that the actual value meets the inclusive lower boundary.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to LDATE_AND_TIME.</param>
*)
METHOD FINAL IsGreaterThanOrEquals : REFERENCE TO LongDateTimeAssertionContext
VAR_INPUT
	expected : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual < expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected value >= "
	);
END_IF

IsGreaterThanOrEquals REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsLessThan" Id="{29ba6a00-5e23-4c86-a754-a67ceda5e5d6}">
      <Declaration><![CDATA[(*!
<summary>Asserts that the actual value is strictly less than expected.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to LDATE_AND_TIME.</param>
*)
METHOD FINAL IsLessThan : REFERENCE TO LongDateTimeAssertionContext
VAR_INPUT
	expected : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual >= expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected value < "
	);
END_IF

IsLessThan REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsLessThanOrEquals" Id="{db50ba69-7355-49ad-9ef8-1c5eb8644f68}">
      <Declaration><![CDATA[(*!
<summary>Asserts that the actual value meets the inclusive upper boundary.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to LDATE_AND_TIME.</param>
*)
METHOD FINAL IsLessThanOrEquals : REFERENCE TO LongDateTimeAssertionContext
VAR_INPUT
	expected : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual > expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected value <= "
	);
END_IF

IsLessThanOrEquals REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{52a7a24b-2000-498d-80de-bdc1664fbcae}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace.</summary>
<description>
Borrowed read-only reference to the compiler-initialized namespace, valid throughout the instance lifetime.
Do not modify the returned reference; no ownership is transferred.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4eca83c7-5904-469d-bffd-5526ba35da35}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="NotToBe" Id="{e0ef136e-2083-41a8-b865-70900e066766}">
      <Declaration><![CDATA[(*!
<summary>Asserts inequality with the expected value.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to LDATE_AND_TIME.</param>
*)
METHOD FINAL NotToBe : REFERENCE TO LongDateTimeAssertionContext
VAR_INPUT
	expected : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual = expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected value not to be: "
	);
END_IF

NotToBe REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Prepare" Id="{fa36be80-dc34-45c9-97b4-e5e396b3bc91}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Copies the actual operand and replaces the chain-wide message.</summary>
<description>
Called by the owning Assertions provider after it verifies the running test case.
No pointer to this method's input storage is retained. The receiver is borrowed until the next preparation;
the owning provider keeps it alive throughout the immediate chain.
</description>
<param name="actual">Value copied into this context.</param>
<param name="testCase">Borrowed failure receiver for the immediate chain.</param>
<param name="message">Copied diagnostic prefix, including empty to clear the previous prefix.</param>
*)
METHOD INTERNAL FINAL Prepare
VAR_INPUT
	actual : LDATE_AND_TIME;
	testCase : ITestCase;
	message : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Actual := actual;
_TestCase := testCase;
_Message := message;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{ecc20e91-7492-4ae8-9850-f11b2a4072bc}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>
Includes inline fields and nested instances, but excludes separately allocated payloads.
Obtaining the size does not transfer ownership or validate an arbitrary address.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8dac0ac5-b8e6-4b40-ae3a-adc0960f7b5a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToBe" Id="{8e6dfd13-5ad3-4462-89b4-723c00946d7c}">
      <Declaration><![CDATA[(*!
<summary>Asserts equality with the expected value.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to LDATE_AND_TIME.</param>
*)
METHOD FINAL ToBe : REFERENCE TO LongDateTimeAssertionContext
VAR_INPUT
	expected : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual <> expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected: "
	);
END_IF

ToBe REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="failComparison" Id="{6ab38615-d707-4468-8506-469151d0e68f}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Formats a failed typed predicate and reports it with the chain message.</summary>
<description>
Does not change operands or chain state. The receiver retains its first failure. Reporting exceptions
propagate to the enclosing test callback handler; an unprepared receiver is a configuration error.
</description>
<param name="expected">Typed expected operand used only for this diagnostic.</param>
<param name="expectation">Prefix identifying the failed predicate.</param>
*)
METHOD PRIVATE failComparison
VAR_INPUT
	expected : LDATE_AND_TIME;
	expectation : WSTRING(40);
END_VAR
VAR
	actualText : WSTRING(255);
	expectedText : WSTRING(255);
	diagnostic : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[actualText := TO_WSTRING(_Actual);
expectedText := TO_WSTRING(expected);

diagnostic := TOF_Core.WideStrings.Concat255(
	expectation,
	expectedText,
	", but was: ",
	actualText
);

TestServices.ReportAssertionFailure(
	testCase := _TestCase,
	message := _Message,
	sourceClassName := ClassName,
	defaultMessage := diagnostic
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>