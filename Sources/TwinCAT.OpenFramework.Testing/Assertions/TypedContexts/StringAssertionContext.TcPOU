<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringAssertionContext" Id="{4fb39879-ad3a-41b5-a8ce-cee9e5cb013e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
