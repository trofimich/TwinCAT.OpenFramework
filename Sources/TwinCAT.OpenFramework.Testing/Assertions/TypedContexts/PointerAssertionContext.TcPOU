<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PointerAssertionContext" Id="{ef150886-3cc1-43ea-8f0a-72a9ccabf3a7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides fluent assertions on a copied PVOID value.</summary>
<description>
Copies actual into persistent instance storage before the entry method returns; literals and expression
results therefore remain valid throughout the immediate chain. Owns no heap allocation or pointed-to resource.
The message prefixes every failure until the next preparation. Finish one chain before starting another on
the owning Assertions provider. Use only from the owning test callback on one task, without reentry.
Obtain this context from the owning provider; direct unprepared use is unsupported.
Expected arguments use the declared IEC type; ordinary compiler conversions happen before comparison.
This context does not depend on another assertion context.
Object metadata is available before preparation; inherited equality compares instance identity.
Copies the pointer value into a POINTER TO BYTE slot and never dereferences its target.
Equality compares addresses without generic conversion. Failed comparisons format the numeric addresses.
For interfaces and references, use ThatBool with the explicit null or validity predicate.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK PointerAssertionContext EXTENDS TOF_Core.Object
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Actual : POINTER TO BYTE;
	_TestCase : ITestCase;
	_Message : WSTRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{77fbd341-540d-46ce-b589-44a8b1472357}" />
    <Property Name="ClassName" Id="{c9758411-b19e-43b9-a4f9-dc77ff2674fd}">
      <Declaration><![CDATA[(*!
<summary>Provides the implementation class name.</summary>
<description>
Borrowed read-only reference to compiler-initialized storage, valid throughout the instance lifetime.
Do not modify the returned reference; no ownership is transferred.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2ce02c95-82c2-44c4-9337-c0af5a2d5493}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="IsNotNull" Id="{f32284b0-3eda-4e08-9fdd-64628e06154f}">
      <Declaration><![CDATA[(*!
<summary>Asserts that the copied pointer value is non-null.</summary>
<description>
Records failure without interrupting the callback; preserves the chain message.
</description>
*)
METHOD FINAL IsNotNull : REFERENCE TO PointerAssertionContext]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual = TOF_Core.Memory.NULL_ADDRESS THEN
	TestServices.ReportAssertionFailure(
		testCase := _TestCase,
		message := _Message,
		sourceClassName := ClassName,
		defaultMessage := "Expected: non-null object/pointer, but was null (0)"
	);
END_IF

IsNotNull REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsNull" Id="{bf79b9a0-6517-4597-8b7d-aefdc8256180}">
      <Declaration><![CDATA[(*!
<summary>Asserts that the copied pointer value is null.</summary>
<description>
Records failure without interrupting the callback; preserves the chain message.
</description>
*)
METHOD FINAL IsNull : REFERENCE TO PointerAssertionContext]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual <> TOF_Core.Memory.NULL_ADDRESS THEN
	TestServices.ReportAssertionFailure(
		testCase := _TestCase,
		message := _Message,
		sourceClassName := ClassName,
		defaultMessage := "Expected: null (0), but was non-zero address"
	);
END_IF

IsNull REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{c1d683c4-58ea-4afe-a88d-58a59275c78f}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace.</summary>
<description>
Borrowed read-only reference to the compiler-initialized namespace, valid throughout the instance lifetime.
Do not modify the returned reference; no ownership is transferred.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3193f0c1-ee52-415e-bb17-1e5418fe54b6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="NotToBe" Id="{f0af9a13-0f21-44ba-a571-bebff7e953d9}">
      <Declaration><![CDATA[(*!
<summary>Asserts inequality with the expected value.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to PVOID.</param>
*)
METHOD FINAL NotToBe : REFERENCE TO PointerAssertionContext
VAR_INPUT
	expected : PVOID;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual = expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected value not to be: "
	);
END_IF

NotToBe REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Prepare" Id="{adecc314-5dcb-4c73-bcf6-7e3267de0653}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Copies the actual operand and replaces the chain-wide message.</summary>
<description>
Called by the owning Assertions provider after it verifies the running test case.
No pointer to this method's input storage is retained. The receiver is borrowed until the next preparation;
the owning provider keeps it alive throughout the immediate chain.
</description>
<param name="actual">Value copied into this context.</param>
<param name="testCase">Borrowed failure receiver for the immediate chain.</param>
<param name="message">Copied diagnostic prefix, including empty to clear the previous prefix.</param>
*)
METHOD INTERNAL FINAL Prepare
VAR_INPUT
	actual : PVOID;
	testCase : ITestCase;
	message : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Actual := actual;
_TestCase := testCase;
_Message := message;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{ab605870-d5b5-4ff8-aae6-792b6f250f01}">
      <Declaration><![CDATA[(*!
<summary>Reports the byte size of this concrete instance.</summary>
<description>
Includes inline fields and nested instances, but excludes separately allocated payloads.
Obtaining the size does not transfer ownership or validate an arbitrary address.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f5f94f75-9c3c-4a27-ac68-b5b8177b4711}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToBe" Id="{7fafdcb3-8018-46cc-a575-eefc7cdf1c38}">
      <Declaration><![CDATA[(*!
<summary>Asserts equality with the expected value.</summary>
<description>
Records failure without interrupting the callback; preserves the message for the rest of the chain.
</description>
<param name="expected">Expected value converted by the compiler to PVOID.</param>
*)
METHOD FINAL ToBe : REFERENCE TO PointerAssertionContext
VAR_INPUT
	expected : PVOID;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Actual <> expected THEN
	failComparison(
		expected := expected,
		expectation := "Expected: "
	);
END_IF

ToBe REF= THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="failComparison" Id="{d3bce1f9-5936-4fce-81b2-9e1b9ff6dc1a}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Formats a failed typed predicate and reports it with the chain message.</summary>
<description>
Does not change operands or chain state. The receiver retains its first failure. Reporting exceptions
propagate to the enclosing test callback handler; an unprepared receiver is a configuration error.
</description>
<param name="expected">Typed expected operand used only for this diagnostic.</param>
<param name="expectation">Prefix identifying the failed predicate.</param>
*)
METHOD PRIVATE failComparison
VAR_INPUT
	expected : PVOID;
	expectation : WSTRING(40);
END_VAR
VAR
	actualText : WSTRING(255);
	expectedText : WSTRING(255);
	diagnostic : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[actualText := TO_WSTRING(TO_ULINT(_Actual));
expectedText := TO_WSTRING(TO_ULINT(expected));

diagnostic := TOF_Core.WideStrings.Concat255(
	expectation,
	expectedText,
	", but was: ",
	actualText
);

TestServices.ReportAssertionFailure(
	testCase := _TestCase,
	message := _Message,
	sourceClassName := ClassName,
	defaultMessage := diagnostic
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>