    <Method Name="processInputs" Id="{f4b382a5-61c7-4fc2-8dd7-c14e4c747422}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE FINAL processInputs
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;

	i : Core.INT_INDEX;

	child : IChildAutomationComponent;
	
	inputDevice : IInputDevice;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnBeforeDevicesProcessInput();
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_BEFORE_CHILDREN_PROCESS_INPUT);

	ProcessException(exception, exceptionHandlingResult, "OnBeforeDevicesProcessInput error");
__ENDTRY

FOR i := 0 TO ChildCount - 1 DO
	child := TryGetChildByIndex(i);

	IF NOT child.Enabled OR_ELSE NOT __QUERYINTERFACE(child, inputDevice) THEN
		CONTINUE;
	END_IF

	inputDevice.ProcessInput(); 

	IF inputDevice.HasError AND_THEN inputDevice.Error.Severity = Core.ERROR_SEVERITY.CRITICAL THEN
		exceptionHandlingResult := OnHandleChildCriticalError(inputDevice);
		
		ProcessChildError(inputDevice.Error, exceptionHandlingResult, Core.WideStrings.Concat255("Child[", TO_WSTRING(i), "(", inputDevice.Name, ")].ProcessInput error"));
	END_IF	
END_FOR

__TRY
	OnAfterDevicesProcessInput();
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_AFTER_CHILDREN_PROCESS_INPUT);

	ProcessException(exception, exceptionHandlingResult, "OnAfterDevicesProcessInput error");
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="processOutputs" Id="{95a8f436-d6af-4bcd-974f-69577ba853fe}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PRIVATE FINAL processOutputs
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;

	i : Core.INT_INDEX;
	
	child : IChildAutomationComponent;
	
	outputDevice : IOutputDevice;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnBeforeDevicesProcessOutput();
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_BEFORE_CHILDREN_PROCESS_OUTPUT);

	ProcessException(exception, exceptionHandlingResult, "OnBeforeDevicesProcessOutput error");
__ENDTRY

FOR i := 0 TO ChildCount - 1 DO
	child := TryGetChildByIndex(i);
	
	IF NOT child.Enabled OR_ELSE NOT __QUERYINTERFACE(child, outputDevice) THEN
		CONTINUE;
	END_IF

	outputDevice.ProcessOutput(); 
	
	IF outputDevice.HasError AND_THEN outputDevice.Error.Severity = Core.ERROR_SEVERITY.CRITICAL THEN
		exceptionHandlingResult := OnHandleChildCriticalError(outputDevice);
		
		ProcessChildError(outputDevice.Error, exceptionHandlingResult, Core.WideStrings.Concat255("Child[", TO_WSTRING(i), "(", outputDevice.Name, ")].ProcessOutput error"));
	END_IF
END_FOR

__TRY
	OnAfterDevicesProcessOutput();
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_AFTER_CHILDREN_PROCESS_OUTPUT);

	ProcessException(exception, exceptionHandlingResult, "OnAfterDevicesProcessOutput error");
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{0fac72fb-ac13-45be-8a20-c7e96145e4d2}">
      <Declaration><![CDATA[METHOD FINAL Reset
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;
	
	i : INT;
		
	child : IChildAutomationComponent;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enabled OR_ELSE _OperationalState <> OPERATIONAL_STATE.STOPPED THEN
	RETURN;
END_IF

_Error.Clear();

__TRY
	OnBeforeChildrenReset();
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_BEFORE_CHILDREN_RESET);

	ProcessException(exception, exceptionHandlingResult, "OnBeforeChildrenReset error");

	IF exceptionHandlingResult = PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT THEN
		RETURN;
	END_IF
__ENDTRY

FOR i := 0 TO ChildCount - 1 DO
	child := TryGetChildByIndex(i);
	
	IF child.Enabled THEN
		child.Reset();
		
		IF child.HasError AND_THEN child.Error.Severity = Core.ERROR_SEVERITY.CRITICAL THEN
			exceptionHandlingResult := OnHandleChildCriticalError(child);
			
			ProcessChildError(child.Error, exceptionHandlingResult, Core.WideStrings.Concat255("Child[", TO_WSTRING(i), "(", child.Name, ")].Reset error"));

			RETURN;
		END_IF
	END_IF
END_FOR

__TRY
	OnAfterChildrenReset();
	
	SetOperationalState(OPERATIONAL_STATE.WORKING, "Reset");
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_AFTER_CHILDREN_RESET);

	ProcessException(exception, exceptionHandlingResult, "OnAfterChildrenReset error");

	IF exceptionHandlingResult = PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT THEN
		RETURN;
	END_IF
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{da5c54bb-6397-492a-8106-733766e78f84}">
      <Declaration><![CDATA[METHOD FINAL Stop
VAR_INPUT
	reason : WSTRING(255) := "External stop";
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	

	i : INT;
	
	child : IChildAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Enabled OR_ELSE _OperationalState <> OPERATIONAL_STATE.WORKING THEN
	RETURN;
END_IF

SetOperationalState(OPERATIONAL_STATE.STOPPED, reason);

FOR i := 0 TO ChildCount - 1 DO
	__TRY
		child := TryGetChildByIndex(i); 
		
		IF child.Enabled AND_THEN child.OperationalState = OPERATIONAL_STATE.WORKING THEN		
			child.Stop(Core.WideStrings.Concat255("Parent (", Name, ") stopped. Reason: ", reason));
		END_IF			
	__CATCH(exceptionCode)
		exception := Core.ExceptionManager.GetLastException(exceptionCode);	
		
		Core.LogManager.TryLogException(exception, Core.ERROR_SEVERITY.CRITICAL, "AutomationComponent", "AutomationComponent.Stop");
	__ENDTRY
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetChildByIndex" Id="{37f2f3fc-162d-4554-90ba-2cd93bca68c5}">
      <Declaration><![CDATA[METHOD ABSTRACT TryGetChildByIndex : IChildAutomationComponent
VAR_INPUT
	index : Core.INT_INDEX;
END_VAR]]></Declaration>
