    <Property Name="ChildCount" Id="{c2bf4044-8c3f-4694-b502-03d7c6837fdf}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT ChildCount : Core.INT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{f5f13569-9317-494e-8ad7-d932f7599918}">
        <Declaration><![CDATA[]]></Declaration>
