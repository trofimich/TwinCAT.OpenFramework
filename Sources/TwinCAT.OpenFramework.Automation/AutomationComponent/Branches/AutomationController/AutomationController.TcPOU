(*!
<summary>Coordinates the root of an automation component tree and its controller plugins.</summary>
<description>
Use the inherited BroadcastEvent to deliver events to this controller and its descendants. The inherited
BubbleEvent receives events at the root without forwarding them further. Both operations use synchronous
borrowed delivery and do not transfer event ownership. Indexed Try lookups return borrowed interfaces or null
and do not propagate exceptions. Fatal allocation observations return null without clearing the latch.
<h2>Cycle callbacks and outputs</h2>
Plugin callbacks run in <c>WORKING</c> and <c>STOPPED</c> even while disabled, independently of enabled I/O
and working or stopped hooks. <c>INITIALIZING</c> and <c>INVALID</c> receive no cycle callbacks.
<note type="information">
A state transition during output processing skips remaining outputs and the after-output hook. Completed
writes remain effective. A pass started in <c>STOPPED</c> proceeds while the branch stays in that state.
</note>
</description>
*)

FUNCTION_BLOCK ABSTRACT AutomationController 
VAR_GENERIC CONSTANT
	{attribute 'hide'} 
    _ChildCount : TOF_Core.INT_LENGTH := 0;
END_VAR
EXTENDS BranchAutomationComponent IMPLEMENTS IAutomationController
VAR
	{attribute 'hide'} 
	_Plugins : POINTER TO IAutomationControllerPlugin;
	{attribute 'hide'} 
    _PluginCount : TOF_Core.INT_LENGTH := 0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden methods" Id="{12dd965a-14f3-4011-a256-fed7220cb094}">
      <Folder Name="Execute" Id="{f114ade2-b900-4e1c-859d-e87215b7686a}" />
    </Folder>
    <Method Name="AssignPlugins" Id="{8ecfbab2-2d01-45ac-a54d-14ba97f3016f}">
      <Declaration><![CDATA[(*!
<summary>Registers a borrowed array of controller plugins for cycle callbacks.</summary>
<description>
Assign from the controller task before use. Keep the array and its plugin instances live and stable during
callback dispatch. The number of entries must fit INT_LENGTH. An invalid reference leaves the prior array
in place. Callbacks run during both WORKING and STOPPED, including while the controller is disabled.
</description>
<param name="plugins">Stable plugin array borrowed by the controller.</param>
*)
METHOD PROTECTED AssignPlugins
VAR_IN_OUT CONSTANT
	plugins : ARRAY [*] OF IAutomationControllerPlugin;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(plugins) THEN
	_Plugins := plugins;
	_PluginCount := TO_INT(1 + UPPER_BOUND(plugins, 1) - LOWER_BOUND(plugins, 1));
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ChildCount" Id="{9220f711-cd6b-4535-afb7-2d29bd70dbf0}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL ChildCount : TOF_Core.INT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{7ecd62bb-cc61-4886-a3b7-812711794d0b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildCount := _ChildCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{b6d998b9-573d-4770-83de-0928458fcc43}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF IChildAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{b6ba42f9-ee1b-4d18-84e7-5d5ae248c53f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnAfterExecute" Id="{c3b115f5-1f5b-4065-8927-f57c8b59a3f3}" FolderPath="Overriden methods\Execute\">
      <Declaration><![CDATA[(*!
<summary>Processes child outputs after the working or stopped phase.</summary>
<description>
Execute checks Enabled before entering this phase. An enabled controller processes outputs in both WORKING
and STOPPED.
A state transition during output processing skips remaining outputs and the after-output hook.
Completed writes remain effective. A pass started in STOPPED proceeds while the branch stays in that state.
OnCycleEnd can still dispatch plugin callbacks when this phase is skipped.
</description>
*)
METHOD PROTECTED FINAL OnAfterExecute
VAR
	entryRevision : UDINT;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;	
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;

	childCriticalErrorReaction : CHILD_CRITICAL_ERROR_REACTION;

	i : TOF_Core.INT_INDEX;
	
	child : IChildAutomationComponent;
	
	outputDevice : IOutputLeafAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[entryRevision := _OperationalStateRevision;

__TRY
	OnBeforeChildrenProcessOutput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnBeforeChildrenProcessOutput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnBeforeChildrenProcessOutput error"
	);
__ENDTRY

FOR i := 0 TO ChildCount - 1 DO
	IF _OperationalStateRevision <> entryRevision THEN
		RETURN;
	END_IF

	child := TryGetChildByIndex(index := i);
	
	IF child = 0 OR_ELSE NOT child.Enabled OR_ELSE NOT __QUERYINTERFACE(child, outputDevice) THEN
		CONTINUE;
	END_IF

	IF _OperationalStateRevision <> entryRevision THEN
		RETURN;
	END_IF

	outputDevice.ProcessOutput(); 
	
	IF outputDevice.HasError AND_THEN outputDevice.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL THEN
		childCriticalErrorReaction := HandleChildCriticalError(childWithError := outputDevice);
		
		ProcessChildError(
			childError := outputDevice.Error,
			childErrorReaction := childCriticalErrorReaction,
			childErrorSourceHint := TOF_Core.WideStrings.Concat255(
				"Child[",
				TO_WSTRING(i),
				"](",
				outputDevice.Name,
				").ProcessOutput error"
			)
		);
	END_IF
END_FOR

IF _OperationalStateRevision <> entryRevision THEN
	RETURN;
END_IF

__TRY
	OnAfterChildrenProcessOutput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnAfterChildrenProcessOutput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnAfterChildrenProcessOutput error"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeExecute" Id="{3242870c-aa52-4580-929a-ba469938843b}" FolderPath="Overriden methods\Execute\">
      <Declaration><![CDATA[(*!
<summary>Processes child inputs before the working or stopped phase.</summary>
<description>
Execute checks Enabled after OnCycleStart before entering this phase. An enabled controller processes
inputs in both WORKING and STOPPED.
While the branch remains enabled, a transition to STOPPED continues the input pass through the remaining
enabled input children and the after-input hook. Input callbacks must support execution in STOPPED.
</description>
*)
METHOD PROTECTED FINAL OnBeforeExecute
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;	
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;

	childCriticalErrorReaction : CHILD_CRITICAL_ERROR_REACTION;

	i : TOF_Core.INT_INDEX;

	child : IChildAutomationComponent;
	
	inputDevice : IInputLeafAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnBeforeChildrenProcessInput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnBeforeChildrenProcessInput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnBeforeChildrenProcessInput error"
	);
__ENDTRY

FOR i := 0 TO ChildCount - 1 DO
	child := TryGetChildByIndex(index := i);

	IF child = 0 OR_ELSE NOT child.Enabled OR_ELSE NOT __QUERYINTERFACE(child, inputDevice) THEN
		CONTINUE;
	END_IF

	inputDevice.ProcessInput(); 

	IF inputDevice.HasError AND_THEN inputDevice.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL THEN
		childCriticalErrorReaction := HandleChildCriticalError(childWithError := inputDevice);
		
		ProcessChildError(
			childError := inputDevice.Error,
			childErrorReaction := childCriticalErrorReaction,
			childErrorSourceHint := TOF_Core.WideStrings.Concat255(
				"Child[",
				TO_WSTRING(i),
				"](",
				inputDevice.Name,
				").ProcessInput error"
			)
		);
	END_IF	
END_FOR

__TRY
	OnAfterChildrenProcessInput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnAfterChildrenProcessInput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnAfterChildrenProcessInput error"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="PluginCount" Id="{c48dfd84-c0df-4e03-b68e-6081a02a9f8d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL PluginCount : TOF_Core.INT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{5dc2143c-2fd9-40fa-82bb-d9ba834aa42a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[PluginCount := _PluginCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TryGetChildByIndex" Id="{e253c3d3-f38f-4322-83c6-97a9fd0aeb2c}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed child by its zero-based index.</summary>
<description>
Returns null when the entry is unavailable, the index is out of range or a nested call raises an exception.
Fatal allocation observations before or after the storage getter return null and preserve the latch for
the outer task boundary. Does not transfer ownership or extend lifetime. Getter exceptions are contained.
</description>
*)
METHOD FINAL TryGetChildByIndex : IChildAutomationComponent
VAR_INPUT
	index : TOF_Core.INT_INDEX;
END_VAR
VAR
	childStorage : REFERENCE TO ARRAY [0.._ChildCount - 1] OF IChildAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF TOF_Core.DynamicMemoryManager.HasAllocationFailed OR_ELSE index < 0 OR_ELSE index >= _ChildCount THEN
		RETURN;
	END_IF

	childStorage REF= Children;

	IF NOT TOF_Core.DynamicMemoryManager.HasAllocationFailed AND_THEN __ISVALIDREF(childStorage) THEN
		TryGetChildByIndex := childStorage[index];
	END_IF
__CATCH
	TryGetChildByIndex := 0;
__ENDTRY

IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	TryGetChildByIndex := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetPluginByIndex" Id="{ec5a9acc-4e3a-430c-bc3c-dbbed33a62ee}">
      <Declaration><![CDATA[(*!
<summary>Returns a borrowed plugin by its zero-based index.</summary>
<description>
Returns null when the entry is unavailable, the index is out of range or a nested call raises an exception.
Fatal allocation observations return null and preserve the latch for the task boundary.
Does not transfer ownership or extend lifetime; no exception may escape.
</description>
*)
METHOD FINAL TryGetPluginByIndex : IAutomationControllerPlugin
VAR_INPUT
	index : TOF_Core.INT_INDEX;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
		RETURN;
	END_IF

	IF _Plugins <> 0 AND_THEN index >= 0 AND_THEN index < _PluginCount THEN
		TryGetPluginByIndex := _Plugins[index];
	END_IF
__CATCH
	TryGetPluginByIndex := 0;
__ENDTRY

IF TOF_Core.DynamicMemoryManager.HasAllocationFailed THEN
	TryGetPluginByIndex := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Validate" Id="{fd0d162a-dd4e-4a58-a453-d5799968f0d2}" FolderPath="Overriden methods\">
      <Declaration><![CDATA[METHOD PROTECTED FINAL Validate
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ChildCount > 0 AND_THEN NOT __ISVALIDREF(Children) THEN
	TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		dataMemberName := 'Children'
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCycleStart" Id="{0d765623-7ab6-4c29-a807-e8fd960b4578}">
      <Declaration><![CDATA[(*!
<summary>Dispatches OnBeforeControllerExecute to controller plugins before child input processing.</summary>
<description>
Plugins receive this callback in WORKING and STOPPED, including while disabled. Changes to Enabled affect
input processing in this call. Plugins must check Enabled before performing technological actions.
Plugin failures follow the controller exception policy. Completed callback effects are retained.
</description>
*)
METHOD PROTECTED FINAL OnCycleStart
VAR
	i : TOF_Core.INT_INDEX;
	plugin : IAutomationControllerPlugin;

	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO PluginCount - 1 DO
	plugin := TryGetPluginByIndex(index := i);
	
	IF plugin <> 0 THEN
		__TRY
			plugin.OnBeforeControllerExecute(controller := THIS^);
		__CATCH(exceptionCode)		
			exception := TOF_Core.ExceptionManager.GetLastException(
				exceptionCode := exceptionCode,
				catchPointNamespaceName := NamespaceName,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);
							
			exceptionReaction := OnHandleException(
				exception := exception,
				failedMethodName := TOF_Core.Strings.Concat255('plugin[', TO_STRING(i), '].OnBeforeControllerExecute')
			);
		
			ProcessException(
				exception := exception,
				exceptionReaction := exceptionReaction,
				exceptionSourceHint := TOF_Core.WideStrings.Concat255("plugin[", TO_WSTRING(i), "].OnBeforeControllerExecute error")
			);
		__ENDTRY		
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCycleEnd" Id="{64ee0609-7786-43bc-95d8-90525d7889f1}">
      <Declaration><![CDATA[(*!
<summary>Dispatches OnAfterControllerExecute so plugins can observe the resulting controller state.</summary>
<description>
Plugins receive this callback even when the enabled phases were skipped. An escaping failure can end Execute
before dispatch. Plugins must check Enabled before performing technological actions. Plugin failures follow
the controller exception policy. Completed callback effects are retained.
</description>
*)
METHOD PROTECTED FINAL OnCycleEnd
VAR
	i : TOF_Core.INT_INDEX;
	plugin : IAutomationControllerPlugin;

	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO PluginCount - 1 DO
	plugin := TryGetPluginByIndex(index := i);
	
	IF plugin <> 0 THEN
		__TRY
			plugin.OnAfterControllerExecute(controller := THIS^);
		__CATCH(exceptionCode)		
			exception := TOF_Core.ExceptionManager.GetLastException(
				exceptionCode := exceptionCode,
				catchPointNamespaceName := NamespaceName,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);
							
			exceptionReaction := OnHandleException(
				exception := exception,
				failedMethodName := TOF_Core.Strings.Concat255('plugin[', TO_STRING(i), '].OnAfterControllerExecute')
			);
		
			ProcessException(
				exception := exception,
				exceptionReaction := exceptionReaction,
				exceptionSourceHint := TOF_Core.WideStrings.Concat255("plugin[", TO_WSTRING(i), "].OnAfterControllerExecute error")
			);
		__ENDTRY		
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>