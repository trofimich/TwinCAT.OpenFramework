<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomationController" Id="{6b707d9d-36a1-4196-b85e-da052ddd92c8}" SpecialFunc="None">
    <Declaration><![CDATA[(*

