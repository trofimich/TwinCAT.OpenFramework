<TcPlcObject Version="1.1.0.1">
  <POU Name="HmiAutomationComponentElement" Id="{dfcc69f0-a3dd-4c3d-a891-2d135d1b66d4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
