(*!
<summary>Exchanges commands and status between an HMI and an automation component.</summary>
<description>
Derived elements supply component identity and invoke the protected update methods. Error timestamps are reset
to the epoch when no error is reported. Commands received in AutomationComponentCommands are consumed and reset
within the element instance upon dispatch. External HMI systems must write directly to the element's
AutomationComponentCommands symbol or read back the reset state for command handshake.
</description>
*)

FUNCTION_BLOCK ABSTRACT HmiAutomationComponentElement
VAR_INPUT
	AutomationComponentCommands : HMI_AUTOMATION_COMPONENT_COMMANDS;
END_VAR
VAR_OUTPUT
	AutomationComponentStatuses : HMI_AUTOMATION_COMPONENT_STATUSES;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{68bc9c5e-2bbb-41cc-9f58-1693b2fff252}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the concrete HMI element.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c765939a-c5a7-4ad9-9d08-f290090d46bf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{bda4d4aa-e177-4633-8aad-fea890343f42}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace of the concrete HMI element.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ABSTRACT NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c9ed4c86-67cf-4c3c-ac55-ac69db7570aa}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ProcessAutomationComponentCommands" Id="{207422e4-4aeb-4d7d-a75d-782bbafe57cc}">
      <Declaration><![CDATA[(*!
<summary>Dispatches pending HMI commands to the target automation component.</summary>
<description>
Executes Enable, Disable, or Reset on the target component according to the flags in AutomationComponentCommands.
Resets the dispatched command flags in AutomationComponentCommands to FALSE within the element instance memory.
A null component reference causes an immediate return without mutating commands. External HMI systems must write
directly to the element's AutomationComponentCommands symbol or read back the reset state for command handshake.
</description>
<param name="automationComponent">Target component receiving the dispatched commands.</param>
*)
METHOD PROTECTED ProcessAutomationComponentCommands
VAR_INPUT
	automationComponent : IAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF automationComponent = 0 THEN
	RETURN;
END_IF

IF AutomationComponentCommands.Disable THEN
	automationComponent.Disable();
ELSIF AutomationComponentCommands.Enable THEN
	automationComponent.Enable(includeChildren := TRUE);
END_IF

AutomationComponentCommands.Disable := FALSE;
AutomationComponentCommands.Enable := FALSE;

IF AutomationComponentCommands.Reset THEN
	automationComponent.Reset();
	AutomationComponentCommands.Reset := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateAutomationComponentStatuses" Id="{7f185188-8a4b-421d-8d7b-e49d8614968d}">
      <Declaration><![CDATA[(*!
<summary>Copies current component status to the HMI outputs.</summary>
<description>
A null component leaves outputs unchanged. When no error is reported, clears error text and resets error
timestamps to LongDateAndTimes.EPOCH.
</description>
*)
METHOD PROTECTED UpdateAutomationComponentStatuses
VAR_INPUT
	automationComponent : IAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF automationComponent = 0 THEN
	RETURN;
END_IF

AutomationComponentStatuses.Enabled := automationComponent.Enabled;

AutomationComponentStatuses.HasError := automationComponent.HasError;

IF automationComponent.HasError THEN
	AutomationComponentStatuses.ErrorMessage := automationComponent.Error.ToString(
		sourceDisplayMode := TOF_Core.ERROR_SOURCE_DISPLAY_MODE.HIDDEN,
		timestampDisplayMode := TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN
	);
	AutomationComponentStatuses.ErrorSource := automationComponent.Error.GetSource(appendRootSource := TRUE);	
	AutomationComponentStatuses.ErrorLocalTimestamp := automationComponent.Error.LocalTimestamp;
	AutomationComponentStatuses.ErrorUtcTimestamp := automationComponent.Error.UtcTimestamp;
ELSE
	AutomationComponentStatuses.ErrorMessage := "";
	AutomationComponentStatuses.ErrorSource := '';	
	AutomationComponentStatuses.ErrorLocalTimestamp := TOF_Core.LongDateAndTimes.EPOCH;
	AutomationComponentStatuses.ErrorUtcTimestamp := TOF_Core.LongDateAndTimes.EPOCH;
END_IF

AutomationComponentStatuses.OperationalState := automationComponent.OperationalState;
AutomationComponentStatuses.OperationalStateName := TO_STRING(AutomationComponentStatuses.OperationalState);
AutomationComponentStatuses.OperationalStateReason := automationComponent.OperationalStateReason;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>