(*!
<summary>Defines lifecycle extension hooks for an automation controller.</summary>
<description>
Plugins intercept controller execution cycles to execute custom logic before input processing and after output
processing. Both callbacks also run while disabled in WORKING or STOPPED. Input, working or stopped,
and output phases remain gated by Enabled. Check controller.Enabled before technological actions. A before
callback may enable or disable this cycle; an after callback cannot undo completed I/O. INITIALIZING and
INVALID receive no callbacks. Arguments are borrowed for the synchronous call. Do not recursively execute
the controller.
</description>
*)

INTERFACE IAutomationControllerPlugin EXTENDS __SYSTEM.IQueryInterface]]></Declaration>
    <Method Name="OnAfterControllerExecute" Id="{74692b1f-e693-4fbd-b9c0-cccf39583549}">
      <Declaration><![CDATA[(*!
<summary>Services the controller after its enabled execution phases.</summary>
<description>
Also called while disabled in WORKING or STOPPED. Check Enabled before technological actions. The
controller is borrowed for this synchronous call; do not recursively execute it. Failures use its policy.
</description>
*)
METHOD OnAfterControllerExecute
VAR_INPUT
	controller : IAutomationController;
END_VAR]]></Declaration>
    </Method>
    <Method Name="OnBeforeControllerExecute" Id="{e34f4211-71a0-47a6-9215-681c63206f5c}">
      <Declaration><![CDATA[(*!
<summary>Services the controller before its enabled execution phases.</summary>
<description>
Also called while disabled in WORKING or STOPPED. Check Enabled before technological actions. The
controller is borrowed for this synchronous call; do not recursively execute it. Failures use its policy.
</description>
*)
METHOD OnBeforeControllerExecute
VAR_INPUT
	controller : IAutomationController;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>