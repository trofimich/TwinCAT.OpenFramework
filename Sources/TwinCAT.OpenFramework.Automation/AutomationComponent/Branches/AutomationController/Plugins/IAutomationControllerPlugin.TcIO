(*!
<summary>Defines lifecycle extension hooks for an automation controller.</summary>
<description>
Plugins intercept controller execution cycles to execute custom logic before input processing and after output
processing.
</description>
*)

INTERFACE IAutomationControllerPlugin EXTENDS __SYSTEM.IQueryInterface]]></Declaration>
    <Method Name="OnAfterControllerExecute" Id="{74692b1f-e693-4fbd-b9c0-cccf39583549}">
      <Declaration><![CDATA[(*!
<summary>Executes custom logic immediately after the controller finishes cyclic execution.</summary>
<param name="controller">Automation controller instance executing the cycle.</param>
*)
METHOD OnAfterControllerExecute
VAR_INPUT
	controller : IAutomationController;
END_VAR]]></Declaration>
    </Method>
    <Method Name="OnBeforeControllerExecute" Id="{e34f4211-71a0-47a6-9215-681c63206f5c}">
      <Declaration><![CDATA[(*!
<summary>Executes custom logic immediately before the controller begins cyclic execution.</summary>
<param name="controller">Automation controller instance executing the cycle.</param>
*)
METHOD OnBeforeControllerExecute
VAR_INPUT
	controller : IAutomationController;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>