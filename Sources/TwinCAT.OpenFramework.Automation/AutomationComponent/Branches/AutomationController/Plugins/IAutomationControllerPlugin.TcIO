<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IAutomationControllerPlugin" Id="{11f4ca86-c242-4443-b1d6-97f70e22041e}">
    <Declaration><![CDATA[(*
