{attribute 'no_explicit_call' := 'do not call this function block directly'} 
PROGRAM ChildCriticalErrorHandlingPolicies
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_SetErrorAndStop : SetErrorAndStopAfterCriticalChildErrorHandlingPolicy; 
	{attribute 'hide'} 
	_SetErrorAndContinue : SetErrorAndContinueAfterChildCriticalErrorHandlingPolicy; 
	{attribute 'hide'} 
	_Ignore : IgnoreChildCriticalErrorHandlingPolicy; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{411cd22a-9274-4d3a-8c7f-29ea3684a9ea}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2ed13241-152a-4988-b4a6-27136b1cacd6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Ignore" Id="{267ef87b-ef80-44fe-b855-8b277a33fdc5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Ignore : IChildCriticalErrorHandlingPolicy]]></Declaration>
