        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Ignore := _Ignore;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{79889f58-c974-4177-a610-167e9105708f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : STRING]]></Declaration>
