        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName := CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SetErrorAndContinue" Id="{96b0c083-8362-4667-a3fb-758df3b2564f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SetErrorAndContinue : IChildCriticalErrorHandlingPolicy]]></Declaration>
