PROPERTY SetErrorAndStop : IChildCriticalErrorHandlingPolicy]]></Declaration>
      <Get Name="Get" Id="{e14074a4-3731-48ad-ab47-497f8f34cacd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
