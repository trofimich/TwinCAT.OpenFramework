<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IChildCriticalErrorHandlingPolicy" Id="{547b6b32-97b1-4f6b-819d-55883abf3536}">
    <Declaration><![CDATA[(*
