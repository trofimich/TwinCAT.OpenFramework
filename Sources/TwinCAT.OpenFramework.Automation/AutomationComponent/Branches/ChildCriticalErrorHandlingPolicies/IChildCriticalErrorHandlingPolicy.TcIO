(*!
<summary>Strategy for handling critical errors reported by child components.</summary>
<description>
Determines the reaction of a parent component when one of its children enters an error state.
</description>
*)

INTERFACE IChildCriticalErrorHandlingPolicy EXTENDS TOF_Core.IObject]]></Declaration>
    <Method Name="HandleChildCriticalError" Id="{c8eef88d-a8ad-4501-b597-98276c3d795c}">
      <Declaration><![CDATA[(*!
<summary>Evaluates child error and determines the reaction to apply to the parent component.</summary>
<param name="childWithError">Child component that reported the error.</param>
<param name="handlingObject">Parent component handling the failure.</param>
<description>Returns CHILD_CRITICAL_ERROR_REACTION indicating the action to perform.</description>
*)
METHOD HandleChildCriticalError : CHILD_CRITICAL_ERROR_REACTION
VAR_INPUT
	childWithError : IChildAutomationComponent;
	handlingObject : TOF_Core.IObject;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>