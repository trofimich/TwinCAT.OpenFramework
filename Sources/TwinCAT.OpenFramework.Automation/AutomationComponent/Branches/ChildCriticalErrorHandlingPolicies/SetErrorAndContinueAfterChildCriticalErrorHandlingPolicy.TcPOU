<TcPlcObject Version="1.1.0.1">
  <POU Name="SetErrorAndContinueAfterChildCriticalErrorHandlingPolicy" Id="{931907ff-f865-432f-ab0d-7f9f25bff484}" SpecialFunc="None">
    <Declaration><![CDATA[(*

