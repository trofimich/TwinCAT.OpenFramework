(*!
<summary>Policy that sets parent error but continues cyclic execution.</summary>
<description>
Returns CHILD_CRITICAL_ERROR_REACTION.SET_ERROR_AND_CONTINUE when a child component fails.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SetErrorAndContinueAfterChildCriticalErrorHandlingPolicy EXTENDS TOF_Core.Object IMPLEMENTS IChildCriticalErrorHandlingPolicy
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{b5c5ec87-7113-42c9-a9b1-fcaab1bf4332}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the policy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{117bd844-8c89-46cf-87f8-a048ccab2400}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="HandleChildCriticalError" Id="{57b6ea3c-6704-4243-9d3c-afa36e5e0362}">
      <Declaration><![CDATA[(*!
<summary>Returns CHILD_CRITICAL_ERROR_REACTION.SET_ERROR_AND_CONTINUE for the child error.</summary>
<param name="childWithError">Child component that reported the error.</param>
<param name="handlingObject">Parent component handling the failure.</param>
*)
METHOD HandleChildCriticalError : CHILD_CRITICAL_ERROR_REACTION
VAR_INPUT
	childWithError : IChildAutomationComponent;
	handlingObject : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[HandleChildCriticalError := CHILD_CRITICAL_ERROR_REACTION.SET_ERROR_AND_CONTINUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{d3613df1-4666-45c8-bc96-384d41ebf4c5}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace of the policy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{db0cd3c5-d174-4e3e-b485-493f2b6711d0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3c5b3a4a-0df8-4e23-9ced-915e97489dd3}">
      <Declaration><![CDATA[(*!
<summary>Gets instance memory footprint in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ffe7c504-c6a6-4356-9587-6e2bc32017ca}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>