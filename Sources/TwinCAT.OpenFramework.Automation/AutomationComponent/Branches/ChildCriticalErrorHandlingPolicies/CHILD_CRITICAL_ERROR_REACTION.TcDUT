<TcPlcObject Version="1.1.0.1">
  <DUT Name="CHILD_CRITICAL_ERROR_REACTION" Id="{de63cc21-73bf-4346-89d6-b7f6b8cc3b51}">
    <Declaration><![CDATA[(*
