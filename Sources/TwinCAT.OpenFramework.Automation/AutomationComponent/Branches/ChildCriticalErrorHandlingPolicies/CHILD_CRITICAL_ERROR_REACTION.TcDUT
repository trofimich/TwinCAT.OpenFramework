(*!
<summary>Defines reactions for handling critical errors reported by child components.</summary>
<description>
Returned by IChildCriticalErrorHandlingPolicy implementations to determine whether the parent component
should stop execution, continue running with an error state, or ignore the child failure.
</description>
*)

{attribute 'qualified_only'}
{attribute 'to_string'}
TYPE CHILD_CRITICAL_ERROR_REACTION :
(
	(*! <summary>Transition parent into error state and trigger component stop.</summary> *)
	SET_ERROR_AND_STOP,
	(*! <summary>Transition parent into error state but continue cyclic execution.</summary> *)
	SET_ERROR_AND_CONTINUE,
	(*! <summary>Ignore child error and take no action on parent component.</summary> *)
	IGNORE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>