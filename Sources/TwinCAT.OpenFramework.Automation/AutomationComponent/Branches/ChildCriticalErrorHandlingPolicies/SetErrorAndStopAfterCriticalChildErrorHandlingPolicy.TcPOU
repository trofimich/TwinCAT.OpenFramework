<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SetErrorAndStopAfterCriticalChildErrorHandlingPolicy" Id="{5be19687-5896-4226-b47c-26458a7d859c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: Â© 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Policy that sets parent error and stops execution.</summary>
<description>
Returns CHILD_CRITICAL_ERROR_REACTION.SET_ERROR_AND_STOP when a child component fails.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SetErrorAndStopAfterCriticalChildErrorHandlingPolicy EXTENDS TOF_Core.Object IMPLEMENTS IChildCriticalErrorHandlingPolicy
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{c3c249ae-3e71-47cd-833a-ebe53454f256}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the policy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c5fd7ef4-3108-4b86-bb8a-96ff306768e8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="HandleChildCriticalError" Id="{ba114f1f-4aca-4f4f-a45b-fc62360ec443}">
      <Declaration><![CDATA[(*!
<summary>Returns CHILD_CRITICAL_ERROR_REACTION.SET_ERROR_AND_STOP for the child error.</summary>
<param name="childWithError">Child component that reported the error.</param>
<param name="handlingObject">Parent component handling the failure.</param>
*)
METHOD HandleChildCriticalError : CHILD_CRITICAL_ERROR_REACTION
VAR_INPUT
	childWithError : IChildAutomationComponent;
	handlingObject : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[HandleChildCriticalError := CHILD_CRITICAL_ERROR_REACTION.SET_ERROR_AND_STOP;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{97943208-7921-4ea2-b732-3b05f533c90b}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace of the policy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9db14fa4-2e05-4d46-b35a-060afce0c205}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7929300a-4d63-4c62-a957-6e16e150d391}">
      <Declaration><![CDATA[(*!
<summary>Gets instance memory footprint in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4289bb88-e4e4-4c8e-8a53-766c5973d390}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>