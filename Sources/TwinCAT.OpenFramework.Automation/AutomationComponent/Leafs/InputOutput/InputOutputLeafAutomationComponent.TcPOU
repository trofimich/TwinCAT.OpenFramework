<TcPlcObject Version="1.1.0.1">
  <POU Name="InputOutputLeafAutomationComponent" Id="{d3cfaf06-a014-47b7-8cf6-98a0cc083f94}" SpecialFunc="None">
    <Declaration><![CDATA[(*
