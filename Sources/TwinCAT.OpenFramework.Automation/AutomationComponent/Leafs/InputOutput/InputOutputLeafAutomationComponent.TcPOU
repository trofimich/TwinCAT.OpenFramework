(*!
<summary>Base leaf automation component providing both cyclic input and output processing.</summary>
<description>
Derived components override OnProcessInput and OnProcessOutput to interact with field devices.
ProcessInput and ProcessOutput execute the hooks within guarded TRY/CATCH blocks.
</description>
*)

FUNCTION_BLOCK ABSTRACT InputOutputLeafAutomationComponent EXTENDS LeafAutomationComponent
	IMPLEMENTS IInputLeafAutomationComponent, IOutputLeafAutomationComponent
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{c65c0bbf-e1ef-43ca-a18f-3c425c65c3bc}" />
    <Method Name="OnProcessInput" Id="{94e71efd-bb71-4095-9cb0-5f4f8a38c0d8}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Override to perform cyclic reading of input data.</summary>
*)
METHOD PROTECTED ABSTRACT OnProcessInput]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnProcessOutput" Id="{6751103a-6dfb-417d-8b22-87cbdffa3af8}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Override to perform cyclic writing of output data.</summary>
*)
METHOD PROTECTED ABSTRACT OnProcessOutput]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessInput" Id="{c8339c8d-4067-4f4a-a590-969bcf06fcfd}">
      <Declaration><![CDATA[(*!
<summary>Invokes OnProcessInput with standardized exception handling and error dispatching.</summary>
*)
METHOD FINAL ProcessInput
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnProcessInput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnProcessInput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnProcessInput error"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessOutput" Id="{a26c06ee-82b7-4764-95fa-cf1bbe29daa3}">
      <Declaration><![CDATA[(*!
<summary>Invokes OnProcessOutput with standardized exception handling and error dispatching.</summary>
*)
METHOD FINAL ProcessOutput
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnProcessOutput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnProcessOutput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnProcessOutput error"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>