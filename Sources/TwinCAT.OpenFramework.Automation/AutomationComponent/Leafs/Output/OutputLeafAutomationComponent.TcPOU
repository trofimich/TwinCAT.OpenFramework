(*!
<summary>Base leaf automation component providing cyclic output processing.</summary>
<description>
Derived components override OnProcessOutput to write commands to hardware or actuators.
ProcessOutput executes the hook within a guarded TRY/CATCH block.
</description>
*)

FUNCTION_BLOCK ABSTRACT OutputLeafAutomationComponent EXTENDS LeafAutomationComponent
	IMPLEMENTS IOutputLeafAutomationComponent
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{79900fc6-701a-41aa-8938-d0017f4e6cae}" />
    <Method Name="OnProcessOutput" Id="{041a293e-47c2-48cc-bc87-e724beae058b}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Override to perform cyclic writing of output data.</summary>
*)
METHOD PROTECTED ABSTRACT OnProcessOutput]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessOutput" Id="{e860c3bd-fe5d-4af5-8b65-0b4dfced7747}">
      <Declaration><![CDATA[(*!
<summary>Invokes OnProcessOutput with standardized exception handling and error dispatching.</summary>
*)
METHOD FINAL ProcessOutput
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnProcessOutput();
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnProcessOutput');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnProcessOutput error"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>