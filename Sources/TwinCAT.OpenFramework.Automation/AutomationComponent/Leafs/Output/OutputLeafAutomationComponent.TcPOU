<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="OutputLeafAutomationComponent" Id="{105b6dfa-d76f-4477-807a-cf1396dca32a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
