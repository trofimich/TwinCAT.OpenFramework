(*!
<summary>Base automation component representing a leaf node in the component hierarchy.</summary>
<description>
Leaf components have no children and represent terminal devices, sensors, or actuators.
Events received at this level bubble upwards to the parent component unless propagation is stopped.
Lifecycle methods execute leaf-specific state transitions and invoke overridable hooks.
</description>
*)

FUNCTION_BLOCK ABSTRACT LeafAutomationComponent EXTENDS AutomationComponent IMPLEMENTS IChildAutomationComponent
VAR
	{attribute 'hide'} 
	_Parent : IParentAutomationComponent;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{ca4cde0e-9a44-45fe-a0e4-7b7ca4e0c8a7}" />
    <Method Name="BubbleEvent" Id="{42cce6a6-4219-41f5-a23e-d08f59aa4482}">
      <Declaration><![CDATA[(*!
<summary>Dispatches event locally and bubbles it up to the parent component.</summary>
<param name="event">The event to dispatch.</param>
*)
METHOD FINAL BubbleEvent
VAR_INPUT
	event : TOF_Core.IEvent;
END_VAR
VAR
	stopPropagation : BOOL;
	
	parentAsBubbleEventDispatcher : TOF_Core.IBubbleEventDispatcher;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnEventReceived(event := event, stopPropagation => stopPropagation);

IF stopPropagation THEN
	RETURN;
END_IF

IF __QUERYINTERFACE(Parent, parentAsBubbleEventDispatcher) THEN
	parentAsBubbleEventDispatcher.BubbleEvent(event := event);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Disable" Id="{e7be34cc-e7d9-4568-8b6a-522ee606d568}">
      <Declaration><![CDATA[(*!
<summary>Disables the leaf component and invokes OnDisable.</summary>
*)
METHOD FINAL Disable
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	disabling : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Enabled OR_ELSE disabling THEN
	RETURN;
END_IF

disabling := TRUE;

__TRY
	OnDisable();
	
	_Enabled := FALSE;
	
	disabling := FALSE;	
__CATCH(exceptionCode)
	disabling := FALSE;
	
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Enable" Id="{f7b45f9a-e580-4c1c-b27c-81b9ee1ab687}">
      <Declaration><![CDATA[(*!
<summary>Enables the leaf component and invokes OnEnable.</summary>
<param name="includeChildren">Ignored for leaf components as they have no children.</param>
*)
METHOD FINAL Enable
VAR_INPUT
	includeChildren : BOOL := TRUE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	enabling : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Enabled OR_ELSE enabling THEN
	RETURN;
END_IF

enabling := TRUE;

__TRY
	OnEnable();
	
	IF _Parent <> 0 AND_THEN NOT _Parent.Enabled THEN
		_Parent.Enable(includeChildren := FALSE);
	END_IF
	
	_Enabled := TRUE;
	
	enabling := FALSE;
__CATCH(exceptionCode)
	enabling := FALSE;
	
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{54d74276-cad2-4fd8-8917-0010f6191e07}">
      <Declaration><![CDATA[(*!
<summary>Advances leaf cyclic execution in the WORKING state by invoking OnWorking.</summary>
*)
{attribute 'estimated-stack-usage' := '99'}
METHOD FINAL Execute
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;	
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF NOT Enabled
	OR_ELSE (_OperationalState <> OPERATIONAL_STATE.WORKING AND_THEN _OperationalState <> OPERATIONAL_STATE.STOPPED)
THEN
	RETURN;
END_IF

CASE _OperationalState OF
	OPERATIONAL_STATE.WORKING:
		// automatic non-critical error recovering
		IF _OperationalState = OPERATIONAL_STATE.WORKING
	AND_THEN HasError
	AND_THEN _Error.Severity <> TOF_Core.ERROR_SEVERITY.CRITICAL
THEN
			_Error.Clear();
			
			__TRY
				OnRecover();
			__CATCH(exceptionCode)		
				exception := TOF_Core.ExceptionManager.GetLastException(
					exceptionCode := exceptionCode,
					catchPointNamespaceName := NamespaceName,
					catchPointPOUName := __POUNAME(),
					catchPointPosition := __POSITION()
				);
								
				exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnRecover');
			
				ProcessException(
					exception := exception,
					exceptionReaction := exceptionReaction,
					exceptionSourceHint := "OnRecover error"
				);
			
				IF exceptionReaction = TOF_Core.EXCEPTION_REACTION.SET_ERROR_AND_STOP THEN
					RETURN;
				END_IF		
			__ENDTRY
		END_IF
		
		__TRY
			OnWorking();
		__CATCH(exceptionCode)
			exception := TOF_Core.ExceptionManager.GetLastException(
				exceptionCode := exceptionCode,
				catchPointNamespaceName := NamespaceName,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);	
		
			exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnWorking');
		
			ProcessException(
				exception := exception,
				exceptionReaction := exceptionReaction,
				exceptionSourceHint := "OnWorking error"
			);
		
			IF exceptionReaction = TOF_Core.EXCEPTION_REACTION.SET_ERROR_AND_STOP THEN
				RETURN;		
			END_IF
		__ENDTRY
		
	OPERATIONAL_STATE.STOPPED:
		__TRY
			OnStopped();
		__CATCH(exceptionCode)
			exception := TOF_Core.ExceptionManager.GetLastException(
				exceptionCode := exceptionCode,
				catchPointNamespaceName := NamespaceName,
				catchPointPOUName := __POUNAME(),
				catchPointPosition := __POSITION()
			);	
		
			exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnStopped');
		
			TOF_Core.LogManager.TryLogException(
				exception := exception,
				severity := GetErrorSeverityByExceptionReaction(exceptionReaction := exceptionReaction),
				topic1 := "AutomationComponent",
				topic2 := "AutomationComponent.OnStopped"
			);
		__ENDTRY	
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{3ffe21cc-32bd-4767-9934-eaac8121d03b}">
      <Declaration><![CDATA[(*!
<summary>Initializes a new instance of the leaf component.</summary>
<param name="name">Descriptive name of the component.</param>
<param name="parent">Parent automation component in the hierarchy.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : IParentAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Parent := parent;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{3f657450-0a0b-4d21-8c85-c39655b515b8}">
      <Declaration><![CDATA[(*!
<summary>Initializes the leaf component and invokes OnInitializing.</summary>
*)
METHOD FINAL Initialize : BOOL
VAR
	thisAsParentComponent : IChildAutomationComponent;
	parent : IAutomationComponent;
	
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _OperationalState <> OPERATIONAL_STATE.INITIALIZING THEN
	Initialize := _OperationalState <> OPERATIONAL_STATE.INVALID;
	
	RETURN;
END_IF

__TRY
	Initialize := OnInitializing();
	
	IF Initialize THEN
		SetOperationalState(state := OPERATIONAL_STATE.WORKING, reason := "Successfull initialization");
	ELSE
		IF _InitializationTimer.PT = T#0S THEN
			_InitializationTimer.PT := Parameters.InitializationTimeout;
		END_IF
		
		_InitializationTimer(IN := TRUE);
		
		IF _InitializationTimer.Q THEN		
			TOF_Core.Exceptions.ThrowTimeout(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				timeoutValue := _InitializationTimer.PT,
				operationName := "Initialization"
			);
		END_IF
		
		IF __QUERYINTERFACE(THIS^, thisAsParentComponent) AND_THEN (parent := thisAsParentComponent.Parent) = 0 THEN
			TOF_Core.Exceptions.ThrowDataMemberNotSpecified(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				dataMemberName := 'Parent'
			);						
		END_IF
	END_IF	
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	
	ProcessException(
		exception := exception,
		exceptionReaction := TOF_Core.EXCEPTION_REACTION.SET_ERROR_AND_CONTINUE,
		exceptionSourceHint := "Initialization error"
	);					
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnDisable" Id="{da5e244e-35a1-47cd-8144-7c7c3577035d}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked when the leaf component is disabled.</summary>
*)
METHOD PROTECTED OnDisable]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnEnable" Id="{7ab79cf0-ed24-4ab4-b074-f58d9b879980}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked when the leaf component is enabled.</summary>
*)
METHOD PROTECTED OnEnable]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnInitializing" Id="{87d0edb2-3f9d-4cdc-be5a-51ee4854c5ea}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked to perform custom initialization for the leaf component.</summary>
<description>Returns TRUE when initialization completes successfully.</description>
*)
METHOD PROTECTED OnInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnInitializing := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{1437f653-2dca-4516-a643-9a7052ba8f91}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked when the leaf component is reset from an error state.</summary>
*)
METHOD PROTECTED OnReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopped" Id="{38cbad82-8eb7-4619-bb79-98729012ae5d}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked when the leaf component stops execution.</summary>
*)
METHOD PROTECTED OnStopped]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnWorking" Id="{02692fef-98a0-451c-b7a8-b233e155c1c5}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*!
<summary>Hook invoked during cyclic execution when the leaf component is in the WORKING state.</summary>
*)
METHOD PROTECTED OnWorking]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Parent" Id="{8fb3d4d7-c400-4c92-9c99-1346029f28e7}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets the parent automation component in the hierarchy.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Parent : IParentAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{91af78c8-f2e0-4384-ac9d-b26f89ba6059}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Parent := _Parent;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{39108ecc-e8fc-41d2-84a8-8d829dba9e49}">
      <Declaration><![CDATA[(*!
<summary>Resets the leaf component from an error state and transitions back to WORKING.</summary>
*)
METHOD FINAL Reset
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;	
	exceptionReaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enabled OR_ELSE _OperationalState <> OPERATIONAL_STATE.STOPPED THEN
	RETURN;
END_IF

_Error.Clear();

__TRY
	OnReset();
	
	SetOperationalState(state := OPERATIONAL_STATE.WORKING, reason := "Reset");
__CATCH(exceptionCode)		
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
					
	exceptionReaction := OnHandleException(exception := exception, failedMethodName := 'OnReset');

	ProcessException(
		exception := exception,
		exceptionReaction := exceptionReaction,
		exceptionSourceHint := "OnReset error"
	);

	IF exceptionReaction = TOF_Core.EXCEPTION_REACTION.SET_ERROR_AND_STOP THEN
		RETURN;
	END_IF
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{73828ae5-99ee-4c51-a656-702f6c6b2044}">
      <Declaration><![CDATA[(*!
<summary>Stops the leaf component and transitions to the STOPPED state.</summary>
<param name="reason">Descriptive reason for stopping.</param>
*)
METHOD FINAL Stop
VAR_INPUT
	reason : WSTRING(255) := "External stop";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Enabled OR_ELSE _OperationalState <> OPERATIONAL_STATE.WORKING THEN
	RETURN;
END_IF

SetOperationalState(state := OPERATIONAL_STATE.STOPPED, reason := reason);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>