//!<param name="INITIALIZING">Start state for self and children initialization</param>

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE OPERATIONAL_STATE :
(
	INITIALIZING := 0, 
    WORKING, (*!<description>Normal working mode after successful initialization</description>*)
	STOPPED, (*!<description>Recoverable stopped state. Entered after Stop or critical runtime error. Reset required to return to WORKING</description>*)
    INVALID (*!<description>Any error occured during initialization, final state</description>*)
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>