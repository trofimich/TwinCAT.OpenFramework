<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="OPERATIONAL_STATE" Id="{3a7a0191-f562-4dbc-a295-c4fdddac5490}">
    <Declaration><![CDATA[(*
