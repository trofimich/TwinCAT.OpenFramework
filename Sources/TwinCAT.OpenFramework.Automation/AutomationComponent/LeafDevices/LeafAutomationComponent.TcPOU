FUNCTION_BLOCK ABSTRACT LeafAutomationComponent EXTENDS AutomationComponent IMPLEMENTS IChildAutomationComponent
VAR
	{attribute 'hide'} 
	_Parent : IParentAutomationComponent;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods to override" Id="{ca4cde0e-9a44-45fe-a0e4-7b7ca4e0c8a7}" />
    <Folder Name="Service members" Id="{81a3b43d-cdb7-4e7a-83bc-cc98c2841ff6}" />
    <Method Name="Disable" Id="{e7be34cc-e7d9-4568-8b6a-522ee606d568}">
      <Declaration><![CDATA[METHOD FINAL Disable
VAR
	i : Core.INT_INDEX;
	
	child : IChildAutomationComponent;
END_VAR
VAR_INST
	disabling : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Enabled OR_ELSE disabling THEN
	RETURN;
END_IF

disabling := TRUE;

__TRY
	OnDisable();
	
	_Enabled := FALSE;
	
	disabling := FALSE;	
__CATCH		
	disabling := FALSE;
	
	Core.ExceptionManager.ReThrowLastException();
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="doStop" Id="{f333eb21-b71b-4972-8498-b93becfb200d}" FolderPath="Service members\">
      <Declaration><![CDATA[METHOD PRIVATE FINAL doStop
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;

	i : Core.INT_INDEX;
	
	child : IChildAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	OnStopped();
__CATCH(exceptionCode)
	exception := Core.ExceptionManager.GetLastException(exceptionCode);	

	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_BEFORE_CHILDREN_STOPPED);

	Core.LogManager.TryLogException(exception, GetErrorSeverityByExceptionHandlingResult(exceptionHandlingResult), "AutomationComponent", "AutomationComponent.OnStopped");
__ENDTRY	]]></ST>
      </Implementation>
    </Method>
    <Method Name="doWork" Id="{46f293df-6067-4ed2-89a9-1abc8005afc8}" FolderPath="Service members\">
      <Declaration><![CDATA[METHOD PRIVATE FINAL doWork
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;

	i : Core.INT_INDEX;
	
	child : IChildAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// automatic non-critical error recovering
IF _OperationalState = OPERATIONAL_STATE.WORKING AND_THEN HasError AND_THEN _Error.Severity <> Core.ERROR_SEVERITY.CRITICAL THEN
	_Error.Clear();
	
	__TRY
		OnRecover();
	__CATCH(exceptionCode)		
		exception := Core.ExceptionManager.GetLastException(exceptionCode);
						
		exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_RECOVER);
	
		ProcessException(exception, exceptionHandlingResult, "OnRecover error");
	
		IF exceptionHandlingResult = PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT THEN
			RETURN;
		END_IF		
	__ENDTRY
END_IF

__TRY
	OnWorking();
__CATCH(exceptionCode)
	exception := Core.ExceptionManager.GetLastException(exceptionCode);	

	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_BEFORE_CHILDREN_WORKING);

	ProcessException(exception, exceptionHandlingResult, "OnBeforeChildrenWorking error");

	IF exceptionHandlingResult = PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT THEN
		RETURN;		
	END_IF
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Enable" Id="{f7b45f9a-e580-4c1c-b27c-81b9ee1ab687}">
      <Declaration><![CDATA[METHOD FINAL Enable
VAR_INPUT
	includeChildren : BOOL := TRUE;
END_VAR
VAR
	i : Core.INT_INDEX;
	
	child : IChildAutomationComponent;

	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
END_VAR
VAR_INST
	enabling : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Enabled OR_ELSE enabling THEN
	RETURN;
END_IF

enabling := TRUE;

__TRY
	OnEnable();
	
	IF _Parent <> 0 AND_THEN NOT _Parent.Enabled THEN
		_Parent.Enable(FALSE);
	END_IF
	
	_Enabled := TRUE;
	
	enabling := FALSE;
__CATCH		
	enabling := FALSE;
	
	Core.ExceptionManager.ReThrowLastException();
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{54d74276-cad2-4fd8-8917-0010f6191e07}">
      <Declaration><![CDATA[METHOD FINAL Execute
VAR
	inputDevice : IInputDevice;	
	outputDevice : IOutputDevice;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enabled OR_ELSE (_OperationalState <> OPERATIONAL_STATE.WORKING AND_THEN _OperationalState <> OPERATIONAL_STATE.STOPPED) THEN
	RETURN;
END_IF

IF __QUERYINTERFACE(THIS^, inputDevice) THEN
	inputDevice.ProcessInput();
END_IF

CASE _OperationalState OF
	OPERATIONAL_STATE.WORKING:
		doWork();
		
	OPERATIONAL_STATE.STOPPED:
		doStop();	
END_CASE

IF __QUERYINTERFACE(THIS^, outputDevice) THEN
	outputDevice.ProcessOutput();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{3ffe21cc-32bd-4767-9934-eaac8121d03b}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	(* if TRUE, the retain variables are initialized (warm start / cold start)*)
	bInitRetains	: BOOL;
	(* if TRUE, the instance afterwards gets moved into the copy code (online change)*)
	bInCopyCode	: BOOL;
	name : WSTRING;
	parent : IParentAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Parent := parent;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{3f657450-0a0b-4d21-8c85-c39655b515b8}">
      <Declaration><![CDATA[METHOD FINAL Initialize : BOOL
VAR
	i : Core.INT_INDEX;
	
	thisAsParentComponent : IChildAutomationComponent;
	parent : IAutomationComponent;
	child : IChildAutomationComponent;
	
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;
	
	initializationTimeoutException : Core.TimeoutException;
	notSpecifiedException : Core.DataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _OperationalState <> OPERATIONAL_STATE.INITIALIZING THEN
	Initialize := _OperationalState <> OPERATIONAL_STATE.INVALID;
	
	RETURN;
END_IF

__TRY
	_InitializationTimer(IN := TRUE, PT := Parameters.InitializationTimeout);
	
	IF _InitializationTimer.Q THEN		
		initializationTimeoutException.ThrowByObject(THIS^, __POUNAME(), __POSITION(), _InitializationTimer.PT, Core.WideStrings.Concat255("Initialization timeout ", TO_WSTRING(_InitializationTimer.PT), " elapsed"));
	END_IF
	
	IF __QUERYINTERFACE(THIS^, thisAsParentComponent) AND_THEN (parent := thisAsParentComponent.Parent) = 0 THEN
		notSpecifiedException.ThrowByObject(THIS^, __POUNAME(), __POSITION(), 'Parent');						
	END_IF

	Initialize := OnInitializing();
	
	IF Initialize THEN
		SetOperationalState(OPERATIONAL_STATE.WORKING, "Successfull initialization");
	END_IF	
__CATCH(exceptionCode)
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
	
	ProcessException(exception, PROBLEM_HANDLING_RESULT.SET_ERROR, "Initialization error");					
__ENDTRY]]></ST>
      </Implementation>
    </Method>
