    <Method Name="OnHandleException" Id="{da7bc9d0-a837-4507-a946-cf4521973f6b}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD PROTECTED OnHandleException : PROBLEM_HANDLING_RESULT
VAR_INPUT
	exception : Core.IException;
	exceptionCatchPoint : EXCEPTION_CATCH_POINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnHandleException := PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnInitializing" Id="{87d0edb2-3f9d-4cdc-be5a-51ee4854c5ea}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD PROTECTED OnInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnInitializing := TRUE;]]></ST>
      </Implementation>
    </Method>
