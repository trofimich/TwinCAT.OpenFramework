    <Property Name="Parent" Id="{8fb3d4d7-c400-4c92-9c99-1346029f28e7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL Parent : IParentAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{91af78c8-f2e0-4384-ac9d-b26f89ba6059}">
        <Declaration><![CDATA[]]></Declaration>
