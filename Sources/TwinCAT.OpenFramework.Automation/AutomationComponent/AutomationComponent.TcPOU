	childErrorSourceHint : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(childError) OR_ELSE childError.Empty OR_ELSE childError.Severity <> Core.ERROR_SEVERITY.CRITICAL THEN
	RETURN;
END_IF

IF OperationalState <> OPERATIONAL_STATE.INITIALIZING THEN
	CASE childErrorHandlingResult OF
		PROBLEM_HANDLING_RESULT.SET_ERROR:
			IF _Error.Empty THEN
				_Error := childError;
				_Error.SetSeverity(Core.ERROR_SEVERITY.ERROR);
			END_IF		
		
		PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT:
			IF _Error.Empty OR_ELSE _Error.Severity < Core.ERROR_SEVERITY.CRITICAL THEN
				_Error := childError;
				_Error.SetSeverity(Core.ERROR_SEVERITY.CRITICAL);
			END_IF	
			
			IF OperationalState = OPERATIONAL_STATE.WORKING THEN
				Stop(childErrorSourceHint);		
			END_IF
	END_CASE
ELSE
	_Error := childError;
	
	SetOperationalState(OPERATIONAL_STATE.INVALID, childErrorSourceHint);		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessException" Id="{c8063572-3da9-4eb4-bd36-833c249f0127}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PROTECTED ProcessException
VAR_INPUT
	exception : Core.IException;  
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;	
	exceptionSourceHint : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF exception = 0 OR_ELSE exception.Empty THEN
	RETURN;
END_IF

IF OperationalState <> OPERATIONAL_STATE.INITIALIZING THEN
	Core.LogManager.TryLogException(exception, GetErrorSeverityByExceptionHandlingResult(exceptionHandlingResult));
	
	CASE exceptionHandlingResult OF
		PROBLEM_HANDLING_RESULT.SET_ERROR:
			IF _Error.Empty THEN
				exception.ToError(_Error, Core.ERROR_SEVERITY.ERROR);
			END_IF		
		
		PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT:
			IF _Error.Empty OR_ELSE _Error.Severity < Core.ERROR_SEVERITY.CRITICAL THEN
				exception.ToError(_Error, Core.ERROR_SEVERITY.CRITICAL);
			END_IF	
			
			IF OperationalState = OPERATIONAL_STATE.WORKING THEN
				Stop(exceptionSourceHint);		
			END_IF
	END_CASE
ELSE
	Core.LogManager.TryLogException(exception, Core.ERROR_SEVERITY.CRITICAL);
			
	exception.ToError(_Error, Core.ERROR_SEVERITY.CRITICAL);

	Stop(exceptionSourceHint);		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{d9e3b1b6-5f1c-4e0c-b7fb-2f75b7f46fbb}">
      <Declaration><![CDATA[METHOD FINAL Reset
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;
	
	i : Core.INT_INDEX;
		
	child : IChildAutomationComponent;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enabled OR_ELSE _OperationalState <> OPERATIONAL_STATE.STOPPED THEN
	RETURN;
END_IF

_Error.Clear();

__TRY
	OnBeforeChildrenReset();
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_BEFORE_CHILDREN_RESET);

	ProcessException(exception, exceptionHandlingResult, "OnBeforeChildrenReset error");

	IF exceptionHandlingResult = PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT THEN
		RETURN;
	END_IF
__ENDTRY

FOR i := 0 TO InternalChildCount - 1 DO
	child := InternalTryGetChildByIndex(i);
	
	IF child.Enabled THEN
		child.Reset();
		
		IF child.HasError AND_THEN child.Error.Severity = Core.ERROR_SEVERITY.CRITICAL THEN
			exceptionHandlingResult := OnHandleChildCriticalError(child);
			
			ProcessChildError(child.Error, exceptionHandlingResult, Core.WideStrings.Concat255("Child[", TO_WSTRING(i), "(", child.Name, ")].Reset error"));

			RETURN;
		END_IF
	END_IF
END_FOR

__TRY
	OnAfterChildrenReset();
	
	SetOperationalState(OPERATIONAL_STATE.WORKING, "Reset");
__CATCH(exceptionCode)		
	exception := Core.ExceptionManager.GetLastException(exceptionCode);
					
	exceptionHandlingResult := OnHandleException(exception, EXCEPTION_CATCH_POINT.ON_AFTER_CHILDREN_RESET);

	ProcessException(exception, exceptionHandlingResult, "OnAfterChildrenReset error");

	IF exceptionHandlingResult = PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT THEN
		RETURN;
	END_IF
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOperationalState" Id="{7e5ac7e2-185d-4ec3-b6e7-9e31ed957150}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD INTERNAL SetOperationalState
VAR_INPUT
	state : OPERATIONAL_STATE;
	reason : WSTRING(255);
END_VAR
VAR
	previousState : OPERATIONAL_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OperationalStateReason := reason;

IF _OperationalState = state THEN
	RETURN;
END_IF

previousState := _OperationalState;

_OperationalState := state;

__TRY
	OnOperationalStateChanged(previousState);
__CATCH
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{7d81c2ed-cf1e-4941-91df-b5092c404637}">
      <Declaration><![CDATA[{attribute 'TcRpcEnable':='1'}
METHOD FINAL Stop
VAR_INPUT
	reason : WSTRING(255) := "External stop";
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : Core.IException;	

	i : Core.INT_INDEX;
	
	child : IChildAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Enabled OR_ELSE _OperationalState <> OPERATIONAL_STATE.WORKING THEN
	RETURN;
END_IF

SetOperationalState(OPERATIONAL_STATE.STOPPED, reason);

FOR i := 0 TO InternalChildCount - 1 DO
	__TRY
		child := InternalTryGetChildByIndex(i); 
		
		IF child.Enabled AND_THEN child.OperationalState = OPERATIONAL_STATE.WORKING THEN		
			child.Stop(Core.WideStrings.Concat255("Parent (", Name, ") stopped. Reason: ", reason));
		END_IF			
	__CATCH(exceptionCode)
		exception := Core.ExceptionManager.GetLastException(exceptionCode);	
		
		Core.LogManager.TryLogException(exception, Core.ERROR_SEVERITY.CRITICAL, "AutomationComponent", "AutomationComponent.Stop");
	__ENDTRY
END_FOR]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>