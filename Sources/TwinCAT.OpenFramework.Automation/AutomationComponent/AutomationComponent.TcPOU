	{attribute 'hide'} 
	_OperationalState : OPERATIONAL_STATE;	
	{attribute 'hide'} 
	_OperationalStateReason : WSTRING(255);	

	_InitializationTimer : Tc2_Standard.TON;
	
	{attribute 'hide'} 
	_Error : Core.ERROR;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
