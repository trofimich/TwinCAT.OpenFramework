    <Method Name="OnOperationalStateChanged" Id="{dd76bd0f-568b-4bbf-812c-974cfb78aee7}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD PROTECTED OnOperationalStateChanged
VAR_INPUT
	previousState : OPERATIONAL_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="OperationalState" Id="{f3ab473a-80e6-4bd6-b784-752a1cb14670}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL OperationalState : OPERATIONAL_STATE]]></Declaration>
      <Get Name="Get" Id="{7d4b34b5-9ddf-46c0-9b80-9ef6df164cce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[OperationalState := _OperationalState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="OperationalStateReason" Id="{f68dd7cb-5882-4a97-880b-c0e34a9a06a5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL OperationalStateReason : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{165bb29f-d77b-4b59-a0e9-8113a39adaab}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[OperationalStateReason REF= _OperationalStateReason;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ProcessChildError" Id="{078f9fd6-7339-4d22-92c2-4a63371d65ff}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PROTECTED ProcessChildError
VAR_INPUT
	childError : REFERENCE TO Core.ERROR;  
	childErrorHandlingResult : PROBLEM_HANDLING_RESULT;	
	childErrorSourceHint : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(childError) OR_ELSE childError.Empty OR_ELSE childError.Severity <> Core.ERROR_SEVERITY.CRITICAL THEN
	RETURN;
END_IF

IF OperationalState <> OPERATIONAL_STATE.INITIALIZING THEN
	CASE childErrorHandlingResult OF
		PROBLEM_HANDLING_RESULT.SET_ERROR:
			IF _Error.Empty THEN
				_Error := childError;
				_Error.SetSeverity(Core.ERROR_SEVERITY.ERROR);
			END_IF		
		
		PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT:
			IF _Error.Empty OR_ELSE _Error.Severity < Core.ERROR_SEVERITY.CRITICAL THEN
				_Error := childError;
				_Error.SetSeverity(Core.ERROR_SEVERITY.CRITICAL);
			END_IF	
			
			IF OperationalState = OPERATIONAL_STATE.WORKING THEN
				Stop(childErrorSourceHint);		
			END_IF
	END_CASE
ELSE
	_Error := childError;
	
	SetOperationalState(OPERATIONAL_STATE.INVALID, childErrorSourceHint);		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessException" Id="{7e03d0ad-992f-40a8-92de-f216a0c3449a}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PROTECTED ProcessException
VAR_INPUT
	exception : Core.IException;  
	exceptionHandlingResult : PROBLEM_HANDLING_RESULT;	
	exceptionSourceHint : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF exception = 0 OR_ELSE exception.Empty THEN
	RETURN;
END_IF

IF OperationalState <> OPERATIONAL_STATE.INITIALIZING THEN
	Core.LogManager.TryLogException(exception, GetErrorSeverityByExceptionHandlingResult(exceptionHandlingResult));
	
	CASE exceptionHandlingResult OF
		PROBLEM_HANDLING_RESULT.SET_ERROR:
			IF _Error.Empty THEN
				exception.ToError(_Error, Core.ERROR_SEVERITY.ERROR);
			END_IF		
		
		PROBLEM_HANDLING_RESULT.SET_ERROR_AND_STOP_COMPONENT:
			IF _Error.Empty OR_ELSE _Error.Severity < Core.ERROR_SEVERITY.CRITICAL THEN
				exception.ToError(_Error, Core.ERROR_SEVERITY.CRITICAL);
			END_IF	
			
			IF OperationalState = OPERATIONAL_STATE.WORKING THEN
				Stop(exceptionSourceHint);		
			END_IF
	END_CASE
ELSE
	Core.LogManager.TryLogException(exception, Core.ERROR_SEVERITY.CRITICAL);
			
	exception.ToError(_Error, Core.ERROR_SEVERITY.CRITICAL);

	SetOperationalState(OPERATIONAL_STATE.INVALID, exceptionSourceHint);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{d9e3b1b6-5f1c-4e0c-b7fb-2f75b7f46fbb}">
      <Declaration><![CDATA[METHOD ABSTRACT Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOperationalState" Id="{5277f682-bec2-4af0-819a-10cc9e1fbd19}" FolderPath="Service methods\">
      <Declaration><![CDATA[METHOD PROTECTED SetOperationalState
VAR_INPUT
	state : OPERATIONAL_STATE;
	reason : WSTRING(255);
END_VAR
VAR
	previousState : OPERATIONAL_STATE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OperationalStateReason := reason;

IF _OperationalState = state THEN
	RETURN;
END_IF

previousState := _OperationalState;

_OperationalState := state;

__TRY
	OnOperationalStateChanged(previousState);
__CATCH
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{7d81c2ed-cf1e-4941-91df-b5092c404637}">
      <Declaration><![CDATA[METHOD ABSTRACT Stop
VAR_INPUT
	reason : WSTRING(255) := "External stop";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>