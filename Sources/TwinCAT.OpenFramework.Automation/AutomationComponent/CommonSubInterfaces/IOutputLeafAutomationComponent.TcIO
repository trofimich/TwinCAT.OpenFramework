(*!
<summary>Represents a leaf automation component that performs cyclic output processing.</summary>
<description>
Invoked during the output phase of the component tree cycle to write physical outputs or command actuators.
</description>
*)

INTERFACE IOutputLeafAutomationComponent EXTENDS IChildAutomationComponent]]></Declaration>
    <Method Name="ProcessOutput" Id="{5eb289e0-048e-4fb1-b4b5-450d3a21a673}">
      <Declaration><![CDATA[(*!
<summary>Performs cyclic writing and processing of output data.</summary>
*)
METHOD ProcessOutput]]></Declaration>
    </Method>
