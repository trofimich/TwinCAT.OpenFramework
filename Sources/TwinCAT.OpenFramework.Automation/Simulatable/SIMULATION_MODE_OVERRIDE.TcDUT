(*!
<summary>Defines simulation mode override behavior for child components.</summary>
<description>
Allows individual child components to follow the parent's simulation state or explicitly force simulation ON or OFF.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE SIMULATION_MODE_OVERRIDE :
(
	(*! <summary>Inherit simulation mode from parent component.</summary> *)
	INHERITED := 0,
	(*! <summary>Force simulation mode ON regardless of parent setting.</summary> *)
	ON,
	(*! <summary>Force simulation mode OFF regardless of parent setting.</summary> *)
	OFF
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>