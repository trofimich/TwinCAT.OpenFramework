(*!
<summary>Represents a child automation component whose simulation override can be configured.</summary>
*)

INTERFACE IChildConfigurableSimulatable EXTENDS IChildSimulatable
]]></Declaration>
    <Method Name="SetSimulationModeOverride" Id="{b0ed9d3c-7f83-40a4-b58c-915e8a072ecc}">
      <Declaration><![CDATA[(*!
<summary>Configures the simulation mode override setting for this child component.</summary>
<param name="value">Override setting (INHERITED, ON, or OFF).</param>
*)
METHOD SetSimulationModeOverride
VAR_INPUT
	value : SIMULATION_MODE_OVERRIDE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>