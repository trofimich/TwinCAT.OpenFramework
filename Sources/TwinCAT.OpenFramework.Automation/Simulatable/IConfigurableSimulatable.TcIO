(*!
<summary>Represents an automation component with configurable simulation mode.</summary>
*)

INTERFACE IConfigurableSimulatable EXTENDS ISimulatable
]]></Declaration>
    <Method Name="SetSimulationMode" Id="{2ec04501-b180-403d-934c-f7710f1907a0}">
      <Declaration><![CDATA[(*!
<summary>Sets whether simulation mode is enabled for the component.</summary>
<param name="value">TRUE to enable simulation mode, FALSE to use physical hardware.</param>
*)
METHOD SetSimulationMode
VAR_INPUT
	value : BOOL;
END_VAR]]></Declaration>
    </Method>
  </Itf>
