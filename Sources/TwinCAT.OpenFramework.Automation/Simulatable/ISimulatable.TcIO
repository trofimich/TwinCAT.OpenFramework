(*!
<summary>Represents an automation component capable of operating in simulation mode.</summary>
<description>
Provides read access to the active simulation mode status.
</description>
*)

INTERFACE ISimulatable EXTENDS TOF_Core.IObject
]]></Declaration>
    <Property Name="SimulationMode" Id="{f5dfb847-33cc-4380-a1cf-0d2edbb1a6ef}">
      <Declaration><![CDATA[(*!
<summary>Gets whether simulation mode is currently active.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SimulationMode : BOOL]]></Declaration>
      <Get Name="Get" Id="{26bbacea-8cbd-4c03-a1df-2721a1043836}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
