(*!
<summary>Provides cyclic execution and initialization state of automation components.</summary>
<description>
Execute advances the supplied components. State and StateName describe runner initialization;
CodeExecutionPhase exposes the shared execution phase.
</description>
*)

INTERFACE IAutomationRunner EXTENDS TOF_Core.IObject]]></Declaration>
    <Property Name="CodeExecutionPhase" Id="{aa90aabc-47e1-438d-b39b-b0749d55f7f7}">
      <Declaration><![CDATA[(*!
<summary>Gets whether the runner is currently executing components.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CodeExecutionPhase : BOOL]]></Declaration>
      <Get Name="Get" Id="{b9accd21-5017-4f04-92db-b6d7a1d77485}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Method Name="Execute" Id="{43b25f17-24a8-4738-8b58-a34b4ca8299e}">
      <Declaration><![CDATA[(*!
<summary>Initializes and advances cyclic execution of the registered components.</summary>
<param name="components">Array of root automation components to execute.</param>
*)
METHOD FINAL Execute
VAR_IN_OUT CONSTANT
	components : ARRAY [*] OF IAutomationComponent;
END_VAR]]></Declaration>
    </Method>
    <Property Name="State" Id="{67795c22-5567-4678-a754-1c0f3c5ade49}">
      <Declaration><![CDATA[(*!
<summary>Gets current initialization and operational state of the runner.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL State : AUTOMATION_RUNNER_STATE]]></Declaration>
      <Get Name="Get" Id="{fb95b05a-71ee-4fbb-b12d-3b4b27b06a7a}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="StateName" Id="{c3740711-6982-474a-957a-4fff61ca98ad}">
      <Declaration><![CDATA[(*!
<summary>Gets string representation of current runner state.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY StateName : STRING]]></Declaration>
      <Get Name="Get" Id="{457a8b5e-1646-48ee-9ef4-f8250d06162a}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>