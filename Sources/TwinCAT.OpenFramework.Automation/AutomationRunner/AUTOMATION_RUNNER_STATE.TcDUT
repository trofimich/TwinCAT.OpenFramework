//!<param name="INITIALIZING">Start state, acts until at least one unit has not completed initialization</param>

//!<param name="RUNNING">Normal running</param>

//!<param name="INVALID">Any initialization error occurred</param>

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE AUTOMATION_RUNNER_STATE :
(
	INITIALIZING := 0, 
    RUNNING := 1, 
    INVALID := 2 
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>