(*!
<summary>Defines the execution states of an automation runner.</summary>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE AUTOMATION_RUNNER_STATE :
(
	INITIALIZING := 0, (*!<description>Start state, active until all components complete initialization.</description>*)
	RUNNING := 1,      (*!<description>Normal cyclic execution of automation components.</description>*)
	INVALID := 2       (*!<description>Any fatal initialization error occurred; runner execution halted.</description>*)
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>