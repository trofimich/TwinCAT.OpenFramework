(*!
<summary>
Beckhoff EL5001_EX: Extended 1-channel SSI encoder terminal with diagnostics.
</summary>
<description>
Extends EL5001 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL5001_EX EXTENDS EL5001 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>