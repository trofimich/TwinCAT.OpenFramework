<TcPlcObject Version="1.1.0.1">
  <DUT Name="INCREMENTAL_ENCODER_COUNTER_INPUT_CHANNEL" Id="{29f09c50-d0c9-46aa-9f0c-045dd35af63c}">
    <Declaration><![CDATA[(*
