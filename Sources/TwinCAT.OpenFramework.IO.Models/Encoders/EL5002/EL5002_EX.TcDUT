(*!
<summary>
Beckhoff EL5002_EX: Extended 2-channel SSI encoder terminal with diagnostics.
</summary>
<description>
Extends EL5002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL5002_EX EXTENDS EL5002 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>