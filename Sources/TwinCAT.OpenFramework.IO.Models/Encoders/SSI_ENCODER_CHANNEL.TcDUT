(*!
<summary>
Beckhoff SSI absolute encoder channel process image.
</summary>
<description>
Encapsulates 16-bit status word and 32-bit position value for synchronous serial interface (SSI) absolute encoders.
</description>
*)
TYPE SSI_ENCODER_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : UDINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>