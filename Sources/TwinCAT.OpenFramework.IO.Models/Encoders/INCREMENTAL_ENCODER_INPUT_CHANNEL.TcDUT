<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="INCREMENTAL_ENCODER_INPUT_CHANNEL" Id="{6405443f-1275-4de4-a57c-09eb949b6716}">
    <Declaration><![CDATA[(*
