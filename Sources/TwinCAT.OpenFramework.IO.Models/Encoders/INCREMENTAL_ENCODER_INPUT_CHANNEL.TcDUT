(*!
<summary>
Beckhoff incremental encoder input channel process image.
</summary>
<description>
Encapsulates 16-bit status word, 32-bit position value, and 32-bit captured latch value.
</description>
*)
TYPE INCREMENTAL_ENCODER_INPUT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : UDINT;
	Latch AT %I* : UDINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>