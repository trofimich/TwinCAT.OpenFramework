(*!
<summary>
Beckhoff incremental encoder output channel process image.
</summary>
<description>
Encapsulates 16-bit control word and 32-bit preset position value.
</description>
*)
TYPE INCREMENTAL_ENCODER_OUTPUT_CHANNEL :
STRUCT
	Control AT %Q* : WORD;
	SetValue AT %Q* : UDINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>