(*!
<summary>
Beckhoff EL5151_EX: Extended 1-channel 24 V incremental encoder terminal with diagnostics.
</summary>
<description>
Extends EL5151 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL5151_EX EXTENDS EL5151 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>