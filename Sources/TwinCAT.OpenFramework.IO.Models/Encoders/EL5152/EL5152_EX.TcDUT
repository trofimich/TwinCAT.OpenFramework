(*!
<summary>
Beckhoff EL5152_EX: Extended 2-channel 24 V incremental encoder terminal with diagnostics.
</summary>
<description>
Extends EL5152 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL5152_EX EXTENDS EL5152 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>