(*!
<summary>
Beckhoff PWM output channel process image.
</summary>
<description>
Encapsulates 16-bit signed integer duty cycle output (0..32767 represents 0..100% duty cycle).
</description>
*)
TYPE PWM_OUTPUT_CHANNEL :
STRUCT
	DutyCycle AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>