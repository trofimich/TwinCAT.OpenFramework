(*!
<summary>
Beckhoff pulse train output feedback status process image.
</summary>
<description>
Encapsulates 16-bit status word for pulse train and frequency generator terminals.
</description>
*)
TYPE PULSE_TRAIN_INPUT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
