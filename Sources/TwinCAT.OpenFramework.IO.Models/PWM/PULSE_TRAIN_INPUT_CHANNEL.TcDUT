<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="PULSE_TRAIN_INPUT_CHANNEL" Id="{4c0f269e-41c0-4c75-b43f-95c4c16947af}">
    <Declaration><![CDATA[(*
