<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="PULSE_TRAIN_OUTPUT_CHANNEL" Id="{5d7f4d75-f5c7-49da-b5e2-08576f30b40f}">
    <Declaration><![CDATA[(*
