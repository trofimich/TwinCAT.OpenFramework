(*!
<summary>
Beckhoff pulse train output command process image.
</summary>
<description>
Encapsulates 16-bit control word and 32-bit frequency/target value for pulse train terminals.
</description>
*)
TYPE PULSE_TRAIN_OUTPUT_CHANNEL :
STRUCT
	Control AT %Q* : WORD;
	Frequency AT %Q* : DINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>