(*!
<summary>
Beckhoff EL2502_EX: Extended 2-channel PWM output terminal with diagnostics.
</summary>
<description>
Extends EL2502 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics. Note:
Output terminal does not feature InputToggle.
</description>
*)
TYPE EL2502_EX EXTENDS EL2502 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>