(*!
<summary>
Beckhoff EL2521_EX: Extended 1-channel pulse train terminal with diagnostics.
</summary>
<description>
Extends EL2521 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL2521_EX EXTENDS EL2521 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>