(*!
<summary>
Beckhoff EL1512_EX: Extended 2-channel counter terminal with diagnostics.
</summary>
<description>
Extends EL1512 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL1512_EX EXTENDS EL1512 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>