(*!
<summary>
Beckhoff EL1512: 2-channel up/down counter terminal (24 V DC).
</summary>
<description>
Process image mapping structure for the EL1512 2-channel up/down counter terminal with integrated digital inputs.
</description>
*)
TYPE EL1512 :
STRUCT
	Ch1 : COUNTER_CHANNEL;
	Ch2 : COUNTER_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
