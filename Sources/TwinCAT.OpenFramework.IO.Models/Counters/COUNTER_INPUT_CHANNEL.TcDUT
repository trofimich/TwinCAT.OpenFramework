(*!
<summary>
Beckhoff counter input channel process image.
</summary>
<description>
Encapsulates 16-bit status word and 32-bit unsigned counter value (CounterValue : UDINT) for fast counter
terminals.
</description>
*)
TYPE COUNTER_INPUT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	CounterValue AT %I* : UDINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>