(*!
<summary>
Beckhoff EL1502_EX: Extended 2-channel counter terminal with diagnostics.
</summary>
<description>
Extends EL1502 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL1502_EX EXTENDS EL1502 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>