(*!
<summary>
Beckhoff counter output control channel process image.
</summary>
<description>
Encapsulates 16-bit control word and 32-bit unsigned preset counter value (SetCounterValue : UDINT) for fast
counter terminals.
</description>
*)
TYPE COUNTER_OUTPUT_CHANNEL :
STRUCT
	Control AT %Q* : WORD;
	SetCounterValue AT %Q* : UDINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>