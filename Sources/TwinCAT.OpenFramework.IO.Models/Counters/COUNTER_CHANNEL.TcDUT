(*!
<summary>
Beckhoff bidirectional counter channel process image.
</summary>
<description>
Aggregates input status/value (COUNTER_INPUT_CHANNEL) and output control/preset (COUNTER_OUTPUT_CHANNEL) for one counter channel.
</description>
*)
TYPE COUNTER_CHANNEL :
STRUCT
	In : COUNTER_INPUT_CHANNEL;
	Out : COUNTER_OUTPUT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>