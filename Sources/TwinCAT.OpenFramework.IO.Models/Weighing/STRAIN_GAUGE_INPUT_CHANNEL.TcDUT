(*!
<summary>
Beckhoff strain gauge / resistor bridge input channel process image.
</summary>
<description>
Encapsulates a 16-bit status word and a 32-bit signed integer calculated load/value for measuring bridge
terminals (e.g. EL3356).
</description>
*)
TYPE STRAIN_GAUGE_INPUT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : DINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>