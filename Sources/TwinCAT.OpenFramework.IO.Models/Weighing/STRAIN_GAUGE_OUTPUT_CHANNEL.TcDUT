(*!
<summary>
Beckhoff strain gauge / resistor bridge output control channel process image.
</summary>
<description>
Encapsulates a 16-bit control word for calibration, tare, and filtering commands on measuring bridge terminals
(e.g. EL3356).
</description>
*)
TYPE STRAIN_GAUGE_OUTPUT_CHANNEL :
STRUCT
	Control AT %Q* : WORD;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>