(*!
<summary>
Beckhoff EL3356_EX: Extended 1-channel load cell terminal with diagnostics.
</summary>
<description>
Extends EL3356 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3356_EX EXTENDS EL3356 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>