(*!
<summary>
Beckhoff bidirectional strain gauge / resistor bridge channel process image.
</summary>
<description>
Aggregates input status/value (STRAIN_GAUGE_INPUT_CHANNEL) and output control (STRAIN_GAUGE_OUTPUT_CHANNEL) for one measuring bridge channel.
</description>
*)
TYPE STRAIN_GAUGE_CHANNEL :
STRUCT
	In : STRAIN_GAUGE_INPUT_CHANNEL;
	Out : STRAIN_GAUGE_OUTPUT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
