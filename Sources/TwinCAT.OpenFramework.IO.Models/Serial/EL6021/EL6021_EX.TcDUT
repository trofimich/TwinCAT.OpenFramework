(*!
<summary>
Beckhoff EL6021_EX: Extended 1-channel serial interface terminal with diagnostics.
</summary>
<description>
Extends EL6021 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL6021_EX EXTENDS EL6021 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>