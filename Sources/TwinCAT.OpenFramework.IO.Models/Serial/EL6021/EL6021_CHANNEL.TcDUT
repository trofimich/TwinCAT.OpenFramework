(*!
<summary>
Beckhoff EL6021: Serial RS422/RS485 communication channel process image.
</summary>
<description>
Encapsulates 22-byte input (InData) and output (OutData) process data for the EL6021 RS422/RS485 interface.
</description>
*)
TYPE EL6021_CHANNEL :
STRUCT
	InData AT %I* : EL6xxx22ByteInData;
	OutData AT %Q* : EL6xxx22ByteOutData;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>