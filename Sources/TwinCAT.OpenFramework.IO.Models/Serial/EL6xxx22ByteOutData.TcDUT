(*!
<summary>
Beckhoff EL6xxx: 22-byte serial communication output process image.
</summary>
<description>
Encapsulates a 16-bit control word and a 22-byte transmit data buffer for EL6xxx serial interface terminals.
</description>
*)
TYPE EL6xxx22ByteOutData :
STRUCT
	Control : WORD;     
	Data : ARRAY [0..21] OF BYTE; 
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>