<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="EP6002_0002_EX" Id="{ab272ca6-b85a-43ae-9f5e-2a03d6b465c5}">
    <Declaration><![CDATA[(*
