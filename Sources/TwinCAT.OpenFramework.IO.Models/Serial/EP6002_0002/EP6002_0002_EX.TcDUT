(*!
<summary>
Beckhoff EP6002_0002_EX: Extended 2-channel serial interface EtherCAT Box with diagnostics.
</summary>
<description>
Extends EP6002_0002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EP6002_0002_EX EXTENDS EP6002_0002 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>