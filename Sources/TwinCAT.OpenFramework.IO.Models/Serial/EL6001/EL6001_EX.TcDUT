(*!
<summary>
Beckhoff EL6001_EX: Extended 1-channel serial interface terminal with diagnostics.
</summary>
<description>
Extends EL6001 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL6001_EX EXTENDS EL6001 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>