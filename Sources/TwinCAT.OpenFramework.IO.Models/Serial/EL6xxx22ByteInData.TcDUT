(*!
<summary>
Beckhoff EL6xxx: 22-byte serial communication input process image.
</summary>
<description>
Encapsulates a 16-bit status word and a 22-byte received data buffer for EL6xxx serial interface terminals.
</description>
*)
TYPE EL6xxx22ByteInData :
STRUCT
	Status : WORD;     
	Data : ARRAY [0..21] OF BYTE; 
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>