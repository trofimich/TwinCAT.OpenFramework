(*!
<summary>
Beckhoff EL6002: Serial RS232 communication channel process image.
</summary>
<description>
Encapsulates 22-byte input (InData) and output (OutData) process data for the EL6002 RS232 interface.
</description>
*)
TYPE EL6002_CHANNEL :
STRUCT
	InData AT %I* : EL6xxx22ByteInData;
	OutData AT %Q* : EL6xxx22ByteOutData;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>