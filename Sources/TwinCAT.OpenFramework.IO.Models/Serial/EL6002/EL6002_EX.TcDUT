(*!
<summary>
Beckhoff EL6002_EX: Extended 2-channel serial interface terminal with diagnostics.
</summary>
<description>
Extends EL6002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL6002_EX EXTENDS EL6002 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>