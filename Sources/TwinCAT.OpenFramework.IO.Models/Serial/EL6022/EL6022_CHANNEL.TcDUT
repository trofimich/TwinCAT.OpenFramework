(*!
<summary>
Beckhoff EL6022: Serial communication channel process image.
</summary>
<description>
Encapsulates 22-byte input (InData) and output (OutData) process data for one RS422/RS485 communication
channel.
</description>
*)
TYPE EL6022_CHANNEL :
STRUCT
	InData AT %I* : EL6xxx22ByteInData;
	OutData AT %Q* : EL6xxx22ByteOutData;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>