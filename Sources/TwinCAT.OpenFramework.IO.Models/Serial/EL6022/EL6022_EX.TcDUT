<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="EL6022_EX" Id="{9fb93882-ca11-4e2e-ad6f-dc6ce40c84ca}">
    <Declaration><![CDATA[(*
