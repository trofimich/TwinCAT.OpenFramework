(*!
<summary>
Beckhoff EL6022_EX: Extended 2-channel serial interface terminal with diagnostics.
</summary>
<description>
Extends EL6022 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL6022_EX EXTENDS EL6022 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>