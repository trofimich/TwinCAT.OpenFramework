(*!
<summary>
Beckhoff EL1809_EX: Extended 16-channel HD digital input terminal with diagnostics.
</summary>
<description>
Extends EL1809 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL1809_EX EXTENDS EL1809:
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>