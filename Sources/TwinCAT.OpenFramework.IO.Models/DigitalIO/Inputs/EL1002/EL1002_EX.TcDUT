<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="EL1002_EX" Id="{f3aca9c2-9157-4f43-a17c-e2c2b5dbd6e0}">
    <Declaration><![CDATA[(*
