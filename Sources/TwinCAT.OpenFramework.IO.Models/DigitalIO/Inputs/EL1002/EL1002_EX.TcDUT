(*!
<summary>
Beckhoff EL1002_EX: Extended 2-channel digital input terminal with diagnostics.
</summary>
<description>
Extends EL1002 with EtherCAT Working Counter and slave state diagnostics. Note: Simple digital terminals do
not feature CoE mailbox, hence ADS address is not present.
</description>
*)
TYPE EL1002_EX EXTENDS EL1002:
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>