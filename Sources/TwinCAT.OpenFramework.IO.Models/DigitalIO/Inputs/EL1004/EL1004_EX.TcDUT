(*!
<summary>
Beckhoff EL1004_EX: Extended 4-channel digital input terminal with diagnostics.
</summary>
<description>
Extends EL1004 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL1004_EX EXTENDS EL1004:
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
