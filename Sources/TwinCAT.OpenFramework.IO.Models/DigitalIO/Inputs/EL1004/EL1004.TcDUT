(*!
<summary>
Beckhoff EL1004: 4-channel digital input terminal (24 V DC, 3 ms filter).
</summary>
<description>
Process image mapping structure for the EL1004 EtherCAT terminal with 4 discrete 24 V DC inputs.
</description>
*)
TYPE EL1004 :
STRUCT
	Ch1 AT %I* : BOOL;
	Ch2 AT %I* : BOOL;
	Ch3 AT %I* : BOOL;
	Ch4 AT %I* : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
