(*!
<summary>
Beckhoff EP1008_0001_EX: Extended 8-channel digital input EtherCAT Box (24 V DC, 3 ms filter, M8) with
diagnostics.
</summary>
<description>
Extends EP1008_0001 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EP1008_0001_EX EXTENDS EP1008_0001 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>