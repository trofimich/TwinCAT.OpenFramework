(*!
<summary>
Beckhoff EL1008_EX: Extended 8-channel digital input terminal with diagnostics.
</summary>
<description>
Extends EL1008 with EtherCAT Working Counter and slave state diagnostics. Note: Simple digital terminals do
not feature CoE mailbox, hence ADS address is not present.
</description>
*)
TYPE EL1008_EX EXTENDS EL1008 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>