(*!
<summary>
Beckhoff EL1018_EX: Extended 8-channel fast digital input terminal with diagnostics.
</summary>
<description>
Extends EL1018 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL1018_EX EXTENDS EL1018:
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>