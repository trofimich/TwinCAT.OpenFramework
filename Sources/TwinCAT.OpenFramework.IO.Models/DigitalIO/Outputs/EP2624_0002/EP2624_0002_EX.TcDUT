(*!
<summary>
Beckhoff EP2624_0002_EX: Extended 4-channel relay output EtherCAT Box (230 V AC / 30 V DC, make/NO contact,
M12) with diagnostics.
</summary>
<description>
Extends EP2624_0002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EP2624_0002_EX EXTENDS EP2624_0002 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>