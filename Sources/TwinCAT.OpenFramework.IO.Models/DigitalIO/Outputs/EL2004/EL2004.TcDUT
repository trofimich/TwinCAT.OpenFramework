(*!
<summary>
Beckhoff EL2004: 4-channel digital output terminal (24 V DC, 0.5 A).
</summary>
<description>
Process image mapping structure for the EL2004 EtherCAT terminal with 4 discrete 24 V DC 0.5 A outputs.
</description>
*)
TYPE EL2004 :
STRUCT
	Ch1 AT %Q* : BOOL;
	Ch2 AT %Q* : BOOL;
	Ch3 AT %Q* : BOOL;
	Ch4 AT %Q* : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
