(*!
<summary>
Beckhoff EL2809_EX: Extended 16-channel HD digital output terminal with diagnostics.
</summary>
<description>
Extends EL2809 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL2809_EX EXTENDS EL2809 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
