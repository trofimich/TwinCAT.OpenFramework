(*!
<summary>
Beckhoff EL2008: 8-channel digital output terminal (24 V DC, 0.5 A).
</summary>
<description>
Process image mapping structure for the EL2008 EtherCAT terminal with 8 discrete 24 V DC 0.5 A outputs.
</description>
*)
TYPE EL2008 :
STRUCT
	Ch1 AT %Q* : BOOL;
	Ch2 AT %Q* : BOOL;
	Ch3 AT %Q* : BOOL;
	Ch4 AT %Q* : BOOL;
	Ch5 AT %Q* : BOOL;
	Ch6 AT %Q* : BOOL;
	Ch7 AT %Q* : BOOL;
	Ch8 AT %Q* : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
