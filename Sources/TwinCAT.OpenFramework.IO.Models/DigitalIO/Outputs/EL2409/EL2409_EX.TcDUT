(*!
<summary>
Beckhoff EL2409_EX: Extended 16-channel HD digital output terminal with diagnostics.
</summary>
<description>
Extends EL2409 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL2409_EX EXTENDS EL2409 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
