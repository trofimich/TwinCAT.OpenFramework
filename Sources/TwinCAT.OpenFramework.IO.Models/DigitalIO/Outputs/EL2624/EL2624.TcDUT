TYPE EL2624 :
STRUCT
	Ch1 AT %Q* : BOOL;
	Ch2 AT %Q* : BOOL;
	Ch3 AT %Q* : BOOL;
	Ch4 AT %Q* : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
