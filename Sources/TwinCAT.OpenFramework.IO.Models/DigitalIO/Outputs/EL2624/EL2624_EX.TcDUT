(*!
<summary>
Beckhoff EL2624_EX: Extended 4-channel relay output terminal with diagnostics.
</summary>
<description>
Extends EL2624 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL2624_EX EXTENDS EL2624 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
