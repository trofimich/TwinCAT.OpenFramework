(*!
<summary>
Beckhoff EL2622_EX: Extended 2-channel relay output terminal with diagnostics.
</summary>
<description>
Extends EL2622 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL2622_EX EXTENDS EL2622 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
END_STRUCT
END_TYPE]]></Declaration>
