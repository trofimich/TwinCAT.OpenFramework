(*!
<summary>
Beckhoff EP2008_0002_EX: Extended 8-channel digital output EtherCAT Box (24 V DC, 0.5 A, M12) with diagnostics.
</summary>
<description>
Extends EP2008_0002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EP2008_0002_EX EXTENDS EP2008_0002 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>