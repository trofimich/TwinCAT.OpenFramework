(*!
<summary>
Beckhoff EL3413_EX: Extended 3-phase power measurement terminal up to 690 V AC with diagnostics.
</summary>
<description>
Extends EL3413 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3413_EX EXTENDS EL3413 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>