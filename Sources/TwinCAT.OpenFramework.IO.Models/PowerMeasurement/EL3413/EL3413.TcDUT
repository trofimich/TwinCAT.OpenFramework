(*!
<summary>
Beckhoff EL3413: 3-phase power measurement terminal up to 690 V AC.
</summary>
<description>
Process image mapping structure for the EL3413 EtherCAT 3-phase power and energy measurement terminal (phases L1, L2, L3).
</description>
*)
TYPE EL3413 :
STRUCT
	L1 : POWER_MEASUREMENT_CHANNEL;
	L2 : POWER_MEASUREMENT_CHANNEL;
	L3 : POWER_MEASUREMENT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>