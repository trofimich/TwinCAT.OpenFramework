(*!
<summary>
Beckhoff 3-phase power measurement input channel process image.
</summary>
<description>
Encapsulates real-time cyclic measured values for one electrical phase (Current, Voltage, ActivePower, Index,
VariantValue).
</description>
*)
TYPE POWER_MEASUREMENT_INPUT_CHANNEL :
STRUCT
	Current AT %I* : UDINT;
	Voltage AT %I* : UDINT;
	ActivePower AT %I* : DINT;
	Index AT %I* : USINT;
	VariantValue AT %I* : DINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>