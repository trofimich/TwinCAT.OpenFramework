<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="POWER_MEASUREMENT_INPUT_CHANNEL" Id="{e5bc775e-2fa1-45da-8ce0-eba3e93d260b}">
    <Declaration><![CDATA[(*
