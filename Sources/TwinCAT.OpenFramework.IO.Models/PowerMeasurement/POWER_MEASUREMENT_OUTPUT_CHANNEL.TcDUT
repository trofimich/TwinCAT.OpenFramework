(*!
<summary>
Beckhoff 3-phase power measurement output control channel process image.
</summary>
<description>
Encapsulates variable output value selection index (0: Apparent power, 1: Reactive power, 2: Energy, 3:
CosPhi, 4: Frequency).
</description>
*)
TYPE POWER_MEASUREMENT_OUTPUT_CHANNEL :
STRUCT
	Index AT %Q* : USINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>