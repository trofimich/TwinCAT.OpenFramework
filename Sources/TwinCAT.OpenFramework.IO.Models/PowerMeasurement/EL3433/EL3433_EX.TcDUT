(*!
<summary>
Beckhoff EL3433_EX: Extended 3-phase power measurement terminal with internal 10 A current measurement with
diagnostics.
</summary>
<description>
Extends EL3433 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3433_EX EXTENDS EL3433 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>