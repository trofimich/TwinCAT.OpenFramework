(*!
<summary>
Beckhoff EL3433: 3-phase power measurement terminal with internal 10 A current measurement.
</summary>
<description>
Process image mapping structure for the EL3433 EtherCAT 3-phase power and energy measurement terminal (phases
L1, L2, L3).
</description>
*)
TYPE EL3433 :
STRUCT
	L1 : POWER_MEASUREMENT_CHANNEL;
	L2 : POWER_MEASUREMENT_CHANNEL;
	L3 : POWER_MEASUREMENT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>