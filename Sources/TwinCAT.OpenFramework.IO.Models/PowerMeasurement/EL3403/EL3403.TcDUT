(*!
<summary>
Beckhoff EL3403: 3-phase power measurement terminal up to 500 V AC (1 A / 5 A external CT).
</summary>
<description>
Process image mapping structure for the EL3403 EtherCAT 3-phase power and energy measurement terminal (phases L1, L2, L3).
</description>
*)
TYPE EL3403 :
STRUCT
	L1 : POWER_MEASUREMENT_CHANNEL;
	L2 : POWER_MEASUREMENT_CHANNEL;
	L3 : POWER_MEASUREMENT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>