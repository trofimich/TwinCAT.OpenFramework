(*!
<summary>
Beckhoff EL3403_EX: Extended 3-phase power measurement terminal up to 500 V AC (1 A / 5 A external CT) with
diagnostics.
</summary>
<description>
Extends EL3403 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3403_EX EXTENDS EL3403 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>