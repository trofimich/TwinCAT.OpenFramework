(*!
<summary>
Beckhoff bidirectional power measurement phase channel process image.
</summary>
<description>
Aggregates input measured values (POWER_MEASUREMENT_INPUT_CHANNEL) and output index selector (POWER_MEASUREMENT_OUTPUT_CHANNEL) for one electrical phase.
</description>
*)
TYPE POWER_MEASUREMENT_CHANNEL :
STRUCT
	In : POWER_MEASUREMENT_INPUT_CHANNEL;
	Out : POWER_MEASUREMENT_OUTPUT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>