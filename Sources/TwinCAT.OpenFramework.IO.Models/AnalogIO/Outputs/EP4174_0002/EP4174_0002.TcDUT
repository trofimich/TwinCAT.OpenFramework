(*!
<summary>
Beckhoff EP4174-0002: 4-channel configurable analog output EtherCAT Box (-10..+10 V, 0/4..20 mA, 16-bit, M12).
</summary>
<description>
Process image mapping structure for the EP4174-0002 EtherCAT Box IP67 module with 4 multi-range analog
outputs.
</description>
*)
TYPE EP4174_0002 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
