(*!
<summary>
Beckhoff EP4174_0002_EX: Extended 4-channel configurable analog output EtherCAT Box with diagnostics.
</summary>
<description>
Extends EP4174_0002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EP4174_0002_EX EXTENDS EP4174_0002 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>