(*!
<summary>
Beckhoff EL4004_EX: Extended 4-channel analog output terminal with diagnostics.
</summary>
<description>
Extends EL4004 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL4004_EX EXTENDS EL4004 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>