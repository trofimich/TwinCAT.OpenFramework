(*!
<summary>
Beckhoff EL4004: 4-channel analog output terminal (0 .. 10 V, 12-bit).
</summary>
<description>
Process image mapping structure for the EL4004 EtherCAT terminal with 4 analog output channels (0 .. 10 V,
12-bit).
</description>
*)
TYPE EL4004 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>