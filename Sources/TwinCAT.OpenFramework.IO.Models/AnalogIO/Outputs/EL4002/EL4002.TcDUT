(*!
<summary>
Beckhoff EL4002: 2-channel analog output terminal (0 .. 10 V, 12-bit).
</summary>
<description>
Process image mapping structure for the EL4002 EtherCAT terminal with 2 analog output channels (0 .. 10 V, 12-bit).
</description>
*)
TYPE EL4002 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
