(*!
<summary>
Beckhoff EL4002_EX: Extended 2-channel analog output terminal with diagnostics.
</summary>
<description>
Extends EL4002 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL4002_EX EXTENDS EL4002 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>