(*!
<summary>
Beckhoff EL4021_EX: Extended 1-channel analog output terminal (4 .. 20 mA, 12-bit) with diagnostics.
</summary>
<description>
Extends EL4021 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL4021_EX EXTENDS EL4021 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>