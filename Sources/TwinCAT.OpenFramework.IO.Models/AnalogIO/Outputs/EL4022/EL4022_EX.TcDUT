(*!
<summary>
Beckhoff EL4022_EX: Extended 2-channel analog output terminal (4 .. 20 mA, 12-bit) with diagnostics.
</summary>
<description>
Extends EL4022 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL4022_EX EXTENDS EL4022 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>