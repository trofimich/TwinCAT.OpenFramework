(*!
<summary>
Beckhoff EL4122: 2-channel analog output terminal (4 .. 20 mA, 16-bit).
</summary>
<description>
Process image mapping structure for the EL4122 EtherCAT terminal with 2 analog output channel(s).
</description>
*)
TYPE EL4122 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
