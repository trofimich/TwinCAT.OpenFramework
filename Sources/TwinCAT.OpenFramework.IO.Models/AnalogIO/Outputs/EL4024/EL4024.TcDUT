(*!
<summary>
Beckhoff EL4024: 4-channel analog output terminal (4 .. 20 mA, 12-bit).
</summary>
<description>
Process image mapping structure for the EL4024 EtherCAT terminal with 4 analog output channel(s).
</description>
*)
TYPE EL4024 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>