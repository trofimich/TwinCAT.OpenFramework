(*!
<summary>
Beckhoff EL4024_EX: Extended 4-channel analog output terminal (4 .. 20 mA, 12-bit) with diagnostics.
</summary>
<description>
Extends EL4024 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL4024_EX EXTENDS EL4024 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>