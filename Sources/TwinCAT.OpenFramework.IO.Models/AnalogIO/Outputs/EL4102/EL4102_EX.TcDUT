(*!
<summary>
Beckhoff EL4102_EX: Extended 2-channel analog output terminal (0 .. 10 V, 16-bit) with diagnostics.
</summary>
<description>
Extends EL4102 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL4102_EX EXTENDS EL4102 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>