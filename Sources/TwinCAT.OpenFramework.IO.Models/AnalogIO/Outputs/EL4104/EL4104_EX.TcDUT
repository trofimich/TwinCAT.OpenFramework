(*!
<summary>
Beckhoff EL4104_EX: Extended 4-channel analog output terminal (0 .. 10 V, 16-bit) with diagnostics.
</summary>
<description>
Extends EL4104 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL4104_EX EXTENDS EL4104 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>