(*!
<summary>
Beckhoff EL4104: 4-channel analog output terminal (0 .. 10 V, 16-bit).
</summary>
<description>
Process image mapping structure for the EL4104 EtherCAT terminal with 4 analog output channel(s).
</description>
*)
TYPE EL4104 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>