(*!
<summary>
Beckhoff EL4124_EX: Extended 4-channel analog output terminal (4 .. 20 mA, 16-bit) with diagnostics.
</summary>
<description>
Extends EL4124 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL4124_EX EXTENDS EL4124 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>