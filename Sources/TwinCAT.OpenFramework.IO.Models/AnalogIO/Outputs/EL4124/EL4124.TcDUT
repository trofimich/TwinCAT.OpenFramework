(*!
<summary>
Beckhoff EL4124: 4-channel analog output terminal (4 .. 20 mA, 16-bit).
</summary>
<description>
Process image mapping structure for the EL4124 EtherCAT terminal with 4 analog output channel(s).
</description>
*)
TYPE EL4124 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>