(*!
<summary>
Beckhoff EL4008_EX: Extended 8-channel analog output terminal with diagnostics.
</summary>
<description>
Extends EL4008 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL4008_EX EXTENDS EL4008 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>