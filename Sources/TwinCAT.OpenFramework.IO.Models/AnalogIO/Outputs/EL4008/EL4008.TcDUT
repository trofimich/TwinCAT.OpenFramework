(*!
<summary>
Beckhoff EL4008: 8-channel analog output terminal (0 .. 10 V, 12-bit).
</summary>
<description>
Process image mapping structure for the EL4008 EtherCAT terminal with 8 analog output channels (0 .. 10 V, 12-bit).
</description>
*)
TYPE EL4008 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
	Ch5 AT %Q* : INT;
	Ch6 AT %Q* : INT;
	Ch7 AT %Q* : INT;
	Ch8 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>