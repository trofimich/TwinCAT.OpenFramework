(*!
<summary>
Beckhoff EL4001_EX: Extended 1-channel analog output terminal with diagnostics.
</summary>
<description>
Extends EL4001 with EtherCAT Working Counter and slave state diagnostics.
</description>
*)
TYPE EL4001_EX EXTENDS EL4001 :
STRUCT
	WcState AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>