(*!
<summary>
Beckhoff EL4134: 4-channel analog output terminal (-10 V .. +10 V, 16-bit).
</summary>
<description>
Process image mapping structure for the EL4134 EtherCAT terminal with 4 analog output channel(s).
</description>
*)
TYPE EL4134 :
STRUCT
	Ch1 AT %Q* : INT;
	Ch2 AT %Q* : INT;
	Ch3 AT %Q* : INT;
	Ch4 AT %Q* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>