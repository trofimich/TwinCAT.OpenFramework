(*!
<summary>
Beckhoff EL3201_EX: Extended 1-channel RTD terminal with diagnostics.
</summary>
<description>
Extends EL3201 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3201_EX EXTENDS EL3201 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>