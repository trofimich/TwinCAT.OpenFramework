(*!
<summary>
Beckhoff EL3008: 8-channel analog input terminal (-10 V .. +10 V, 12-bit).
</summary>
<description>
Process image mapping structure for the EL3008 EtherCAT terminal with 8 analog input channels.
</description>
*)
TYPE EL3008 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
	Ch5 : ANALOG_INPUT_INT_CHANNEL;
	Ch6 : ANALOG_INPUT_INT_CHANNEL;
	Ch7 : ANALOG_INPUT_INT_CHANNEL;
	Ch8 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>