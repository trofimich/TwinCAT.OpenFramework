(*!
<summary>
Beckhoff EL3008_EX: Extended 8-channel analog input terminal with diagnostics.
</summary>
<description>
Extends EL3008 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3008_EX EXTENDS EL3008 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>