(*!
<summary>
Beckhoff EL3052: 2-channel analog input terminal (4 .. 20 mA, 12-bit single-ended).
</summary>
<description>
Process image mapping structure for the EL3052 EtherCAT terminal with 2 analog input channel(s).
</description>
*)
TYPE EL3052 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
