(*!
<summary>
Beckhoff EL3052_EX: Extended 2-channel analog input terminal (4 .. 20 mA, 12-bit single-ended) with
diagnostics.
</summary>
<description>
Extends EL3052 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3052_EX EXTENDS EL3052 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>