(*!
<summary>
Beckhoff EL3318_EX: Extended 8-channel thermocouple terminal with diagnostics.
</summary>
<description>
Extends EL3318 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3318_EX EXTENDS EL3318 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>