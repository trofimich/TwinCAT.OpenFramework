(*!
<summary>
Beckhoff EL3058: 8-channel analog input terminal (4 .. 20 mA, 12-bit single-ended).
</summary>
<description>
Process image mapping structure for the EL3058 EtherCAT terminal with 8 analog input channel(s).
</description>
*)
TYPE EL3058 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
	Ch5 : ANALOG_INPUT_INT_CHANNEL;
	Ch6 : ANALOG_INPUT_INT_CHANNEL;
	Ch7 : ANALOG_INPUT_INT_CHANNEL;
	Ch8 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>