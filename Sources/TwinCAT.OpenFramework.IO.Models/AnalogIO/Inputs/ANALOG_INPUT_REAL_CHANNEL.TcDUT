(*!
<summary>
Beckhoff floating-point analog input channel process image.
</summary>
<description>
Encapsulates a 16-bit status word and a 32-bit single-precision REAL process value '%I*' for multi-range
analog input channels.
</description>
*)
TYPE ANALOG_INPUT_REAL_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : REAL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>