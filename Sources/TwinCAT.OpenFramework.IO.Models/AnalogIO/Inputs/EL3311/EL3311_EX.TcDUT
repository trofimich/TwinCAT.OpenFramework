(*!
<summary>
Beckhoff EL3311_EX: Extended 1-channel thermocouple terminal with diagnostics.
</summary>
<description>
Extends EL3311 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3311_EX EXTENDS EL3311 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>