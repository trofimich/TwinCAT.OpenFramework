(*!
<summary>
Beckhoff EL3001_EX: Extended 1-channel analog input terminal with diagnostics.
</summary>
<description>
Extends EL3001 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3001_EX EXTENDS EL3001 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>