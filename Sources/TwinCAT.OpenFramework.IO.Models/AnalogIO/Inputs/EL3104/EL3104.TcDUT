(*!
<summary>
Beckhoff EL3104: 4-channel analog input terminal (-10 V .. +10 V, 16-bit differential).
</summary>
<description>
Process image mapping structure for the EL3104 EtherCAT terminal with 4 analog input channel(s).
</description>
*)
TYPE EL3104 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>