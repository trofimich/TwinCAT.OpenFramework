(*!
<summary>
Beckhoff EL3104_EX: Extended 4-channel analog input terminal (-10 V .. +10 V, 16-bit differential) with diagnostics.
</summary>
<description>
Extends EL3104 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3104_EX EXTENDS EL3104 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>