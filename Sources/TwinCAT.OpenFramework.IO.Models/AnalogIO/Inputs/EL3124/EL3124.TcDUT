(*!
<summary>
Beckhoff EL3124: 4-channel analog input terminal (4 .. 20 mA, 16-bit differential).
</summary>
<description>
Process image mapping structure for the EL3124 EtherCAT terminal with 4 analog input channel(s).
</description>
*)
TYPE EL3124 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>