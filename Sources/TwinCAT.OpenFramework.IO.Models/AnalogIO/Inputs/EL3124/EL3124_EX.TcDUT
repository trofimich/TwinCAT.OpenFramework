(*!
<summary>
Beckhoff EL3124_EX: Extended 4-channel analog input terminal (4 .. 20 mA, 16-bit differential) with
diagnostics.
</summary>
<description>
Extends EL3124 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3124_EX EXTENDS EL3124 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>