(*!
<summary>
Beckhoff EL3054: 4-channel analog input terminal (4 .. 20 mA, 12-bit single-ended).
</summary>
<description>
Process image mapping structure for the EL3054 EtherCAT terminal with 4 analog input channel(s).
</description>
*)
TYPE EL3054 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>