(*!
<summary>
Beckhoff EL3314_EX: Extended 4-channel thermocouple terminal with diagnostics.
</summary>
<description>
Extends EL3314 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3314_EX EXTENDS EL3314 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>