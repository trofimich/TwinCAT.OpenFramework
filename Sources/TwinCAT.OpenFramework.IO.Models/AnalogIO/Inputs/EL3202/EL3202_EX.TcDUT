(*!
<summary>
Beckhoff EL3202_EX: Extended 2-channel RTD terminal with diagnostics.
</summary>
<description>
Extends EL3202 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3202_EX EXTENDS EL3202 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>