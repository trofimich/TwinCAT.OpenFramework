(*!
<summary>
Beckhoff EL3078: 8-channel multi-range analog input terminal (REAL values).
</summary>
<description>
Process image mapping structure for the EL3078 EtherCAT terminal with 8 multi-range analog input channels outputting REAL floating-point values.
</description>
*)
TYPE EL3078 :
STRUCT
	Ch1 : ANALOG_INPUT_REAL_CHANNEL;
	Ch2 : ANALOG_INPUT_REAL_CHANNEL;
	Ch3 : ANALOG_INPUT_REAL_CHANNEL;
	Ch4 : ANALOG_INPUT_REAL_CHANNEL;
	Ch5 : ANALOG_INPUT_REAL_CHANNEL;
	Ch6 : ANALOG_INPUT_REAL_CHANNEL;
	Ch7 : ANALOG_INPUT_REAL_CHANNEL;
	Ch8 : ANALOG_INPUT_REAL_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>