(*!
<summary>
Beckhoff EL3078_EX: Extended 8-channel multi-range analog input terminal with diagnostics.
</summary>
<description>
Extends EL3078 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3078_EX EXTENDS EL3078 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>