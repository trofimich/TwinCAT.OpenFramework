(*!
<summary>
Beckhoff 32-bit analog input channel process image.
</summary>
<description>
Encapsulates a 16-bit status word and a 32-bit signed double-integer raw value '%I*' for high-resolution analog input channels.
</description>
*)
TYPE ANALOG_INPUT_DINT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : DINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>