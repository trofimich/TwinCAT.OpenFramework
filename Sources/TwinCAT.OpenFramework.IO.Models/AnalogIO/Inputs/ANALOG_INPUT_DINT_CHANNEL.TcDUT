<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <DUT Name="ANALOG_INPUT_DINT_CHANNEL" Id="{e1249f0f-d9e2-42b4-bd30-7be25c0a0c6a}">
    <Declaration><![CDATA[(*
