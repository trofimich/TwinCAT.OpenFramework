(*!
<summary>
Beckhoff EL3204: 4-channel RTD resistance thermometer terminal (Pt100, Pt1000, Ni120...).
</summary>
<description>
Process image mapping structure for the EL3204 4-channel RTD temperature input terminal.
</description>
*)
TYPE EL3204 :
STRUCT
	Ch1 : RTD_INPUT_CHANNEL;
	Ch2 : RTD_INPUT_CHANNEL;
	Ch3 : RTD_INPUT_CHANNEL;
	Ch4 : RTD_INPUT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>