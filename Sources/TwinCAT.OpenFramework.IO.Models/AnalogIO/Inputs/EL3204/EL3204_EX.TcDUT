(*!
<summary>
Beckhoff EL3204_EX: Extended 4-channel RTD terminal with diagnostics.
</summary>
<description>
Extends EL3204 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3204_EX EXTENDS EL3204 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>