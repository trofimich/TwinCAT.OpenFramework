(*!
<summary>
Beckhoff Thermocouple temperature sensor channel process image.
</summary>
<description>
Encapsulates 16-bit status word and signed 16-bit integer temperature value (0.1 deg C per digit, e.g. 253 = 25.3 deg C) with cold junction compensation.
</description>
*)
TYPE THERMOCOUPLE_INPUT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>