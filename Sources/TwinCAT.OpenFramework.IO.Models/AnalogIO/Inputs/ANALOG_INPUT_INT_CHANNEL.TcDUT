(*!
<summary>
Beckhoff 16-bit analog input channel process image.
</summary>
<description>
Encapsulates a 16-bit status word and a 16-bit signed integer raw value '%I*' for standard analog input channels.
</description>
*)
TYPE ANALOG_INPUT_INT_CHANNEL :
STRUCT
	Status AT %I* : WORD;
	Value AT %I* : INT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>