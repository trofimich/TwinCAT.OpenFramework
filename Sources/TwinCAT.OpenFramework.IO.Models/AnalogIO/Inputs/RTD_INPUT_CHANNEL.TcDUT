<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="RTD_INPUT_CHANNEL" Id="{0b592c54-c809-420f-be6b-3d999e9b6f51}">
    <Declaration><![CDATA[(*
