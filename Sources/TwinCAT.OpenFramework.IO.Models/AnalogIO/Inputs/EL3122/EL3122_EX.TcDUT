(*!
<summary>
Beckhoff EL3122_EX: Extended 2-channel analog input terminal (4 .. 20 mA, 16-bit differential) with
diagnostics.
</summary>
<description>
Extends EL3122 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3122_EX EXTENDS EL3122 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>