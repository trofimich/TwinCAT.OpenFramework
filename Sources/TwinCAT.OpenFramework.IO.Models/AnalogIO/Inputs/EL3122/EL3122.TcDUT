(*!
<summary>
Beckhoff EL3122: 2-channel analog input terminal (4 .. 20 mA, 16-bit differential).
</summary>
<description>
Process image mapping structure for the EL3122 EtherCAT terminal with 2 analog input channel(s).
</description>
*)
TYPE EL3122 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>