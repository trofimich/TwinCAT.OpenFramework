(*!
<summary>
Beckhoff EL3002: 2-channel analog input terminal (-10 V .. +10 V, 12-bit).
</summary>
<description>
Process image mapping structure for the EL3002 EtherCAT terminal with 2 analog input channels.
</description>
*)
TYPE EL3002 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
