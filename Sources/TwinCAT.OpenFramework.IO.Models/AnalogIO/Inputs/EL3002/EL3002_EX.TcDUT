(*!
<summary>
Beckhoff EL3002_EX: Extended 2-channel analog input terminal with diagnostics.
</summary>
<description>
Extends EL3002 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3002_EX EXTENDS EL3002 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>