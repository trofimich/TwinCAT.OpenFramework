(*!
<summary>
Beckhoff EL3004: 4-channel analog input terminal (-10 V .. +10 V, 12-bit).
</summary>
<description>
Process image mapping structure for the EL3004 EtherCAT terminal with 4 analog input channels.
</description>
*)
TYPE EL3004 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>