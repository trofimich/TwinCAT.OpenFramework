	Ch3 : RTD_INPUT_CHANNEL;
	Ch4 : RTD_INPUT_CHANNEL;
	Ch5 : RTD_INPUT_CHANNEL;
	Ch6 : RTD_INPUT_CHANNEL;
	Ch7 : RTD_INPUT_CHANNEL;
	Ch8 : RTD_INPUT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
