(*!
<summary>
Beckhoff EL3208_EX: Extended 8-channel RTD terminal with diagnostics.
</summary>
<description>
Extends EL3208 with EtherCAT Working Counter, slave state, and CoE mailbox ADS address diagnostics.
</description>
*)
TYPE EL3208_EX EXTENDS EL3208 :
STRUCT
	WcState AT %I* : BOOL;
	InputToggle AT %I* : BOOL;
	State AT %I* : UINT;
	AdsAddr AT %I* : Global.AMSADDR;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>