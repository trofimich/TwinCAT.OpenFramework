(*!
<summary>
Beckhoff EP3174-0002: 4-channel configurable analog input EtherCAT Box (-10..+10 V, 0/4..20 mA, 16-bit, M12).
</summary>
<description>
Process image mapping structure for the EP3174-0002 EtherCAT Box IP67 module with 4 multi-range analog inputs.
</description>
*)
TYPE EP3174_0002 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
	Ch3 : ANALOG_INPUT_INT_CHANNEL;
	Ch4 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
