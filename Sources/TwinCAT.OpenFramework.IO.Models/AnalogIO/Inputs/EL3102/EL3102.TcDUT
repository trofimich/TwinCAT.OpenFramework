(*!
<summary>
Beckhoff EL3102: 2-channel analog input terminal (-10 V .. +10 V, 16-bit differential).
</summary>
<description>
Process image mapping structure for the EL3102 EtherCAT terminal with 2 analog input channel(s).
</description>
*)
TYPE EL3102 :
STRUCT
	Ch1 : ANALOG_INPUT_INT_CHANNEL;
	Ch2 : ANALOG_INPUT_INT_CHANNEL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>