<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ITimer" Id="{48689db6-2a88-4baa-afb2-9879b912e6f4}">
    <Declaration><![CDATA[(*!
<summary>Exposes a task-driven timer's interval, observations and restart operation.</summary>
<description>Drive the timer through the inherited task lifecycle. Reading observations does not advance time;
the implementation updates them while executing. Timer-specific TON behavior is documented by Timer.</description>
*)
INTERFACE ITimer EXTENDS TOF_Tasks.ITask]]></Declaration>
    <Property Name="Elapsed" Id="{65834b8f-b730-4fea-9c2a-df9357a8a87e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Reports the timer's latest elapsed observation.</summary>
<description>Reading does not update or consume the observation. For Timer this is TON.Q, retained after
normal completion until Reset or restart; it is not independently a successful task-completion result.</description>
*)
PROPERTY Elapsed : BOOL]]></Declaration>
      <Get Name="Get" Id="{5d233c01-dc6d-4140-812f-10b6675984d3}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="ElapsedTime" Id="{6be46376-d7c5-403e-aee6-fae9d20ed935}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Returns the latest elapsed-time observation without advancing the timer.</summary>
<description>For Timer this is TON.ET from the most recent TON evaluation, not a live clock read.
Reset clears the observation.</description>
*)
PROPERTY ElapsedTime : TIME]]></Declaration>
      <Get Name="Get" Id="{86906748-573a-4363-89bf-e929ab4689a6}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Interval" Id="{9f58246e-11d4-40f2-bdfb-fcd044bf8727}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Gets or sets the configured timer interval.</summary>
<description>For Timer, assignment changes TON.PT without a reset, start or immediate observation update.
Use SetIntervalAndRestart to apply an interval and begin timing it from zero.</description>
*)
PROPERTY Interval : TIME]]></Declaration>
      <Get Name="Get" Id="{9ce0c5a5-d97f-4b20-83a7-395189cc87b8}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{fde3a764-d52d-491a-83df-f731b46a066a}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Method Name="SetIntervalAndRestart" Id="{c817cee2-d504-4502-8d64-33ad72dda540}">
      <Declaration><![CDATA[(*!
<summary>Prepare a restart, then set the interval and start timing immediately.</summary>
<description>
If stopping or Reset fails, return FALSE without changing the interval.
If Start fails after preparation, the new interval remains configured.
No deferred restart is scheduled. Call outside task callbacks.
</description>
*)

METHOD SetIntervalAndRestart : BOOL
VAR_INPUT
	interval : TIME;
END_VAR]]></Declaration>
    </Method>
    <Property Name="Triggered" Id="{62331caa-0a29-423d-9d27-d148f730ec3a}">
      <Declaration><![CDATA[(*!
<summary>Reports completion in the Execute that observes the timer elapsed.</summary>
<description>For the ordinary Timer, includes a zero interval and adds no stopping cycle. Read after Execute.
The pulse is cleared by the next Execute, Reset or successful restart; reading does not consume it.</description>
*)

{attribute 'monitoring' := 'call'}

PROPERTY Triggered : BOOL]]></Declaration>
      <Get Name="Get" Id="{8093b050-d68f-420c-9a07-84bf79b0e4d3}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>