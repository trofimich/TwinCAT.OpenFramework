(*!
<summary>The wrapper around Tc2_Standard.TON</summary>
<description>A cyclic Execute that observes TON.Q completes the ordinary timer and exposes Triggered in the same call.
Positive intervals are anchored by Start. Zero intervals first evaluate TON in Execute and trigger immediately.
Keep calling Execute once per cycle to clear the completion pulse. Restart after completion can reset and
start a new interval in the same cycle. Descendants with asynchronous stopping must define their own timing.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK Timer EXTENDS TOF_Tasks.Task IMPLEMENTS ITimer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_Timer : Tc2_Standard.TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden" Id="{e8e109c1-c323-41d3-976d-ad132843052d}" />
    <Folder Name="Service methods" Id="{17c60b3b-2ccc-4ae2-b3fd-3cb473267b3a}" />
    <Property Name="ClassName" Id="{0828dabd-7de7-477c-986f-c786e04b967d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3f63a584-2023-4c98-a2f5-3b49c3985277}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Elapsed" Id="{dfe87d81-9323-4048-8c6f-2afb631eafa3}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Reports the TON output from its most recent evaluation.</summary>
<description>
Reading does not advance the timer or clear the result. Normal completion leaves Elapsed TRUE until
Reset or restart resets TON. Elapsed alone does not identify the task's stop reason; use Triggered
for the completion pulse and FinalStopReason for the retained task result.
</description>
*)
PROPERTY Elapsed : BOOL]]></Declaration>
      <Get Name="Get" Id="{71f313ff-0d69-4ef6-afaf-35249c1b82f3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Elapsed := _Timer.Q;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ElapsedTime" Id="{cd5b8d23-e037-4bad-b1e3-c6dd7fb5fe54}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Returns the elapsed time from the most recent TON evaluation.</summary>
<description>
The getter reads TON.ET without updating it. During a run, Execute updates this observation;
time between evaluations is not reflected by reading the property. Reset clears TON.ET.
Stopping the task alone does not reset TON or make this a live clock while stopped.
</description>
*)
PROPERTY ElapsedTime : TIME]]></Declaration>
      <Get Name="Get" Id="{03323e00-9d0d-430e-a045-4085f6cb1f30}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ElapsedTime := _Timer.ET;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Interval" Id="{14e1338e-e20d-460b-b041-25f6a05cc695}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Gets or sets the preset interval supplied to TON.</summary>
<description>
Assignment changes TON.PT without resetting TON, starting the task or updating Elapsed and ElapsedTime.
The next TON evaluation uses the current preset. Use SetIntervalAndRestart when a new interval must
start from zero. A zero interval completes on the first Execute after a successful start.
</description>
*)
PROPERTY Interval : TIME]]></Declaration>
      <Get Name="Get" Id="{5bd88fb1-8256-4e13-9e51-2bea89b182b8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Interval := _Timer.PT;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{42068178-9189-4fec-b08c-457db6a1ded3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Timer.PT := Interval;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NamespaceName" Id="{f1f0d0b3-db02-4789-831f-2263654e66c8}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e9a9667f-a2a8-4547-a3a3-9172b4fa8f30}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnBeforeStart" Id="{2b402ec3-9cc6-4215-98ac-29e0f381dbf7}" FolderPath="Overriden\">
      <Declaration><![CDATA[(*!
<summary>Anchor the positive interval to Start, without waiting for Execute.</summary>
<description>
Zero does not call TON here; its first Execute evaluates TON and completes without an additional cycle.
</description>
*)

METHOD PROTECTED OnBeforeStart]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Timer.PT > TOF_Core.Times.MIN_VALUE THEN
	_Timer(IN := TRUE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnReset" Id="{73360413-ae55-4852-9d32-e7e3c5d9b238}" FolderPath="Overriden\">
      <Declaration><![CDATA[(*!
<summary>Resets TON so the next start begins a fresh interval.</summary>
<description>Evaluates TON with IN FALSE, clearing Q and ET. Overrides must call the base implementation
to preserve this timer reset behavior.</description>
*)
METHOD PROTECTED OnReset ]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer(IN := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{7ef78b76-773d-489d-bd9b-3058c24424bd}" FolderPath="Overriden\">
      <Declaration><![CDATA[(*!
<summary>Evaluates TON once and reports completion as soon as Q is TRUE.</summary>
<description>Includes a zero interval. The base Task immediately advances synchronous stopping, so the ordinary
Timer reaches STOPPED and Triggered in the same Execute. Does not restart or reset TON.</description>
<param name="processingState">DONE when TON.Q is TRUE; otherwise the default BUSY.</param>
<param name="stopReasonMessage">No diagnostic message is added by normal timing.</param>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer(IN := TRUE);

IF _Timer.Q THEN
	processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="prepareRestart" Id="{3cef7253-4ef2-453f-abbd-64f6cb774bfb}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Advance stopping once, without waiting in a loop.</summary>
<description>
A descendant with asynchronous cleanup may require further Execute calls
before a restart can succeed. Call from the lifecycle owner, outside callbacks.
</description>
*)

METHOD PRIVATE prepareRestart : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF State.Running THEN
	// Cancel may refuse because stopping is already in progress; advance it anyway.
	Cancel();
	
	Execute();

	IF State.Running THEN
		RETURN;
	END_IF
END_IF

prepareRestart := Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Restart" Id="{3b032b6e-1e78-42bd-b714-902472c46556}">
      <Declaration><![CDATA[(*!
<summary>Restarts the timer from zero, including while running.</summary>
<description>
FALSE means stopping, Reset or Start failed; no deferred restart is scheduled. Call outside task callbacks.
On success Start begins timing; Execute detects completion.
</description>
*)

METHOD Restart : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT prepareRestart() THEN
	RETURN;
END_IF

Restart := Start();]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{48430939-6703-4604-a8f2-f77a92c70c4f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c14e43b5-b54a-44d1-8ef3-bf1ede3346c2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetIntervalAndRestart" Id="{f4b50be1-59c2-498b-b0b6-e742f30e0dc5}">
      <Declaration><![CDATA[(*!
<summary>Prepare a restart, then set the interval and start timing immediately.</summary>
<description>
If stopping or Reset fails, return FALSE without changing the interval.
If Start fails after preparation, the new interval remains configured.
No deferred restart is scheduled. Call outside task callbacks.
</description>
*)

METHOD SetIntervalAndRestart : BOOL
VAR_INPUT
	interval : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT prepareRestart() THEN
	RETURN;
END_IF

_Timer.PT := interval;

SetIntervalAndRestart := Start();]]></ST>
      </Implementation>
    </Method>
    <Property Name="Triggered" Id="{a5955db5-1801-4da6-8fb4-f5bd42f9b8a4}">
      <Declaration><![CDATA[(*!
<summary>Reports successful timer completion in the Execute that observes TON.Q.</summary>
<description>Read after Execute. Remains TRUE until the next Execute, Reset or successful restart.
Repeated reads have no side effects. The ordinary Timer needs no additional stopping cycle.
Descendant callbacks that reset the task during completion can clear this observation before Execute returns.</description>
*)

{attribute 'monitoring' := 'call'}

PROPERTY Triggered : BOOL]]></Declaration>
      <Get Name="Get" Id="{e857186c-ea2b-4d5e-92c9-ec18619c4145}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Triggered := State.Stopped
	AND_THEN State.StateChanged
	AND_THEN FinalStopReason.WorkDone
	AND_THEN _Timer.Q;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>