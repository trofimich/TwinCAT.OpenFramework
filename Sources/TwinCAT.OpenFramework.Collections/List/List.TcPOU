(*!
<summary>Stores an ordered sequence of generic values with fixed or dynamic capacity.</summary>
<description>
CreateEnumerator allocates an independent cursor owned by its caller.
The collection must remain alive while that cursor is used.
Dynamic growth preserves the existing buffer on allocation failure and invokes the terminal allocation-failure mechanism.
Sort passes generic descriptors directly to its borrowed ordering strategy, preserving OBJECT and USER_DEFINED categories.
Successful insertion transfers disposal responsibility for owned payload; borrowed payload must remain alive while stored. The caller-side descriptor copy is not reset and must not be released again after transfer. Independent owning aliases and overlapping owned allocations are unsupported. Entries retain order and duplicates. Same-allocation replacement preserves ownership without releasing retained storage. Get, FindSingle and enumerators only borrow payload. ContainsGeneric defaults to releasing its query. Validators are borrowed for the collection lifetime. No locking or mutation-version checks are implemented; callbacks that mutate the collection can invalidate in-progress operations.
Generic lookup with requested query release also attempts cleanup on lookup failure before propagating the captured exception; terminal OOM takes precedence.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK List 
VAR_GENERIC CONSTANT
 	{attribute 'hide'} 
   _StaticCapacity : TOF_Core.DINT_LENGTH := 0;
END_VAR
EXTENDS TOF_Core.Object IMPLEMENTS IList
VAR_INPUT
	//! <summary>Number of slots added when dynamic storage is full; must be positive when growth is required.</summary>
	DefaultDynamicAllocationElementCount : BYTE := 10;	
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'} 
	_ValueValidator : TOF_Core.IGenericValueValidator;

	{attribute 'hide'} 
	_Array : POINTER TO TOF_Core.GENERIC_VALUE;
	{attribute 'hide'} 
	_StaticArray : ARRAY [0.._StaticCapacity - 1] OF TOF_Core.GENERIC_VALUE;
	
	{attribute 'hide'} 
	_DynamicCapacity : TOF_Core.DINT_LENGTH;
	{attribute 'hide'} 
	_Length : TOF_Core.DINT_LENGTH;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service methods" Id="{3188279f-4192-4144-9219-d1281be18b24}" />
    <Method Name="AllocateMemory" Id="{7805ad4a-1088-4228-99dd-d8b7fe4579c3}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Grows the dynamic element buffer while preserving existing values.</summary>
<description>
Static instances return without allocation. A positive increment must fit DINT capacity and the UDINT allocation-byte limit; invalid ranges raise ArgumentOutOfRangeException before storage changes. A null allocation invokes the terminal allocation-failure mechanism before copying or deleting the old buffer. Existing descriptors are moved without cloning payload; incoming ownership is not accepted by this helper.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD PROTECTED FINAL AllocateMemory 
VAR_INPUT
	elementCount : TOF_Core.DINT_LENGTH;
END_VAR
VAR CONSTANT
	ENTRY_ALLOCATION_SIZE : ULINT := XSIZEOF(TOF_Core.GENERIC_VALUE);
END_VAR
VAR
	newMemory : POINTER TO TOF_Core.GENERIC_VALUE;
	newCapacity : ULINT;

	rangeException : TOF_Core.ArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Dynamic THEN
	RETURN;
END_IF

IF elementCount <= TOF_Core.SignedInt32.ZERO THEN
	rangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'elementCount', elementCount);
END_IF

newCapacity := TO_ULINT(_DynamicCapacity) + TO_ULINT(elementCount);
IF newCapacity > TO_ULINT(TOF_Core.SignedInt32.MAX_VALUE)
	OR_ELSE newCapacity > TO_ULINT(TOF_Core.UnsignedInt32.MAX_VALUE) / ENTRY_ALLOCATION_SIZE
THEN
	rangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'capacity', newCapacity);
END_IF

newMemory := __NEW(BYTE, TO_UDINT(ENTRY_ALLOCATION_SIZE * newCapacity));
IF newMemory = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

IF _Length > TOF_Core.SignedInt32.ZERO THEN
	Tc2_System.MEMCPY(newMemory, _Array, TO_UDINT(ENTRY_ALLOCATION_SIZE * TO_ULINT(_Length)));
END_IF

IF _Array <> 0 THEN
	__DELETE(_Array);
END_IF

_DynamicCapacity := TO_DINT(newCapacity);
_Array := newMemory;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendCopy" Id="{c48f84f5-3206-4f8e-a06b-95fdd5877efa}">
      <Declaration><![CDATA[(*!
<summary>Copies a value and appends the owned descriptor.</summary>
<description>
Borrows the original during the call. isObject = TRUE requires a live Object FB instance implementing ICloneable; other data is copied as bytes without recursively cloning references. A prepared copy is released if insertion fails before acceptance; exceptions propagate. Engine-managed exception objects are unsupported. index is meaningful only on success.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL AppendCopy : IList
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	index : TOF_Core.DINT_INDEX;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	genericValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[genericValue := TOF_Core.GenericValueFactory.FromAnyType(value, isObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY);

__TRY
	AppendCopy := AppendGeneric(genericValue, index => index);
__CATCH(exceptionCode)
	genericValue.Release();
	
	TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendGeneric" Id="{f1ff6a71-50a0-45d9-ae86-164a44b67bf8}">
      <Declaration><![CDATA[(*!
<summary>Appends a descriptor to the list.</summary>
<description>
Successful insertion transfers disposal responsibility for owned payload; borrowed payload must remain alive while stored. The caller-side descriptor copy is not reset and must not be released again after transfer. Independent owning aliases and overlapping owned allocations are unsupported. Delegates to InsertGeneric; index is meaningful only on success.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL AppendGeneric : IList
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR
VAR_OUTPUT
	index : TOF_Core.DINT_INDEX;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[index := _Length;

AppendGeneric := InsertGeneric(index, value);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Capacity" Id="{f88ebbc6-043e-4384-9aab-efeb366abd1b}">
      <Declaration><![CDATA[(*!
<summary>Reports the currently allocated number of slots.</summary>
<description>
Units are bytes for ByteList and entries for other collections. Static capacity is fixed; dynamic capacity can change on growth or clearing. This is not a guarantee that the next allocation succeeds.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Capacity : TOF_Core.DINT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{e0e73894-ad23-446a-99c0-aacf7f854d6b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Capacity := SEL(_StaticCapacity = 0, _StaticCapacity, _DynamicCapacity);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{33e07dae-fed5-4e1d-8f43-eee6214a3816}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f6501ffd-91a8-433d-945c-613d26b30c47}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{6eeb2dd8-b2fb-4bd3-af28-3d4655f329b4}">
      <Declaration><![CDATA[(*!
<summary>Removes all entries and releases dynamic backing storage.</summary>
<description>
Owned payload is released best effort through GENERIC_VALUE.Release; borrowed storage is not freed. Static capacity and the borrowed validator are retained. Dynamic capacity becomes zero. Returns this collection and invalidates positions and views. Cleanup callbacks must not reenter mutation.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL Clear : IList
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear := THIS^;

FOR i := 0 TO _Length - 1 DO
	_Array[i].Release();						
END_FOR	

_Length := 0;
_DynamicCapacity := 0;

IF _Array <> 0 AND_THEN Dynamic THEN
	__DELETE(_Array);	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{6470b115-1732-45d7-86e6-432cfb852dab}">
      <Declaration><![CDATA[(*!
<summary>Searches for a value using default generic equality.</summary>
<description>
Borrows the ANY argument during a linear search without cloning or releasing it. isObject = TRUE means a live Object FB instance, not a pointer or interface variable. Equality exceptions propagate; callbacks that mutate the collection can invalidate traversal.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL Contains : BOOL
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR
	genericValue : TOF_Core.GENERIC_VALUE;
	i : TOF_Core.DINT_INDEX;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[genericValue := TOF_Core.GenericValueFactory.FromAnyType(value, isObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);

FOR i := 0 TO _Length - 1 DO
	IF _Array[i].Equals(genericValue) THEN
		Contains := TRUE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="ContainsGeneric" Id="{4f27da2f-dece-43c4-8992-282ab34ccb18}">
      <Declaration><![CDATA[(*!
<summary>Searches for an equal generic value and optionally releases the query.</summary>
<description>
Uses GENERIC_VALUE.Equals in a linear search. releaseValue defaults to TRUE: after a completed search, Release is called on the local query copy, including on a miss. Caller-side aliases are not reset. The query must not own storage retained by the collection. Requested release is attempted after both successful lookup and lookup failure. Before cleanup, the original framework exception is retained and a borrowed static system exception is cloned to preserve its code, catch point and timestamps across cleanup callbacks. The captured exception is then propagated through ExceptionManager.Throw in the current cyclic task; native errors use the framework SystemException representation. If capturing the system exception fails with terminal OOM, query cleanup is still attempted and terminal OOM takes precedence. Terminal allocation state is never cleared. Release is best effort and does not prove successful deallocation. Cleanup callbacks must not reenter collection mutation.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL ContainsGeneric : BOOL
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
	releaseValue : BOOL := TRUE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;

	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	FOR i := 0 TO _Length - 1 DO
		IF _Array[i].Equals(value) THEN
			ContainsGeneric := TRUE;
			EXIT;
		END_IF
	END_FOR
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
__ENDTRY

IF releaseValue THEN
	IF caughtException <> 0 AND_THEN NOT caughtException.IsDynamicInstance THEN
		__TRY
			__QUERYINTERFACE(caughtException.Clone(), caughtException);
		__CATCH(exceptionCode)
			value.Release();

			TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
		__ENDTRY
	END_IF

	value.Release();
END_IF

IF caughtException <> 0 THEN
	TOF_Core.ExceptionManager.Throw(caughtException);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateEnumerator" Id="{9c229dd9-393b-46ff-976f-739fe26eedc5}">
      <Declaration><![CDATA[(*!
<summary>Creates an independent enumerator owned by the caller.</summary>
<description>
The caller must explicitly release the enumerator and keep this collection alive while using it.
Allocation failure invokes DynamicMemoryManager.RaiseAllocationFailure without a heap exception;
it is terminal and is not returned as a recoverable null result.
</description>
*)
METHOD CreateEnumerator : TOF_Core.IEnumerator
VAR
	enumerator : POINTER TO ListEnumerator;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[enumerator := __NEW(ListEnumerator(list := THIS^));

IF enumerator = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

CreateEnumerator := enumerator^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Dynamic" Id="{166b951e-511c-4d32-bb47-240a0b602e17}">
      <Declaration><![CDATA[(*!
<summary>Reports whether storage can grow dynamically.</summary>
<description>
Static capacity zero selects dynamic storage. Dynamic collections can still fail to allocate.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Dynamic : BOOL]]></Declaration>
      <Get Name="Get" Id="{629e79ca-4190-4ac7-928c-69e20f8bf579}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Dynamic := _StaticCapacity = 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Empty" Id="{6c336543-2ac9-4adb-b317-6015c15c963c}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the collection has no entries.</summary>
<description>
Reflects Length; not a check of payload lifetime or memory health.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{cbbea261-31d9-4fda-a46a-9b7d9838e2ea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Empty := _Length <= 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{8d8b7b19-3218-490a-a08e-e708f6895db1}">
      <Declaration><![CDATA[(*!
<summary>Releases owned payload and backing storage during destruction.</summary>
<description>
Calls Clear; lifecycle methods and payload cleanup callbacks must not raise exceptions or reenter mutation. Payload release is best effort, not proof of successful destruction. No separate copy-code ownership handoff is implemented.
</description>
*)
//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; 
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{7bc30a89-0227-48d6-bfc1-e831cfff4350}">
      <Declaration><![CDATA[(*!
<summary>Binds the optional validator and inline storage during initialization.</summary>
<description>
The validator is borrowed and must remain alive while used; it is not invoked here. Static storage is bound without allocation. Lifecycle methods must not raise exceptions. No explicit online-change relocation repair is implemented.
</description>
*)
//!<param name="bInitRetains">if TRUE, the retain variables are initialized (warm start / cold start)</param>

//!<param name="bInCopyCode">if TRUE, the instance afterwards gets moved into the copy code (online change)</param>

METHOD FB_init : BOOL
VAR_INPUT
	
	bInitRetains	: BOOL;
	
	bInCopyCode	: BOOL;
	valueValidator : TOF_Core.IGenericValueValidator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ValueValidator := valueValidator;

IF NOT Dynamic THEN
	_Array := ADR(_StaticArray); 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindSingle" Id="{5bd8df97-f8f3-46ed-97e0-2baa71205501}">
      <Declaration><![CDATA[(*!
<summary>Finds a predicate match in the requested traversal direction.</summary>
<description>
skip counts matches, not visited entries. A null predicate or no match returns FALSE; outputs are meaningful only on TRUE. The result is borrowed even if IsMemoryOwner is TRUE. Predicate input uses AsAnyType without preserving the explicit generic OBJECT category. Predicate exceptions propagate; callbacks must not mutate the traversed collection.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL FindSingle : BOOL
VAR_INPUT
	predicate : TOF_Core.IPredicate;
	skip : UDINT := 0;
	searchDirection : TOF_Core.SEARCH_DIRECTION := TOF_Core.SEARCH_DIRECTION.FROM_BEGINNING;
END_VAR
VAR_OUTPUT
	value : TOF_Core.GENERIC_VALUE;
	index : TOF_Core.DINT_INDEX;
END_VAR
VAR
	startSearchIndex : DINT;
	maxSearchIndex : DINT;
	indexStep : DINT;
	
	i : DINT;
	
	currentValue : __SYSTEM.AnyType;

	skippedMatchCount : UDINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[index := 0;
	
IF TO_DINT(skip) >= _Length OR_ELSE predicate = 0 THEN
	RETURN;
END_IF

startSearchIndex := SEL(searchDirection = TOF_Core.SEARCH_DIRECTION.FROM_BEGINNING, _Length - 1, 0);
maxSearchIndex := SEL(searchDirection = TOF_Core.SEARCH_DIRECTION.FROM_BEGINNING, 0, _Length - 1);
indexStep := SEL(searchDirection = TOF_Core.SEARCH_DIRECTION.FROM_BEGINNING, -1, 1);

FOR i := startSearchIndex TO maxSearchIndex BY indexStep DO
	currentValue := _Array[i].AsAnyType();
	
	IF predicate.Check(currentValue) THEN
		IF skip = skippedMatchCount THEN
			value := _Array[i];
			index := i;
			FindSingle := TRUE;
			RETURN;
		ELSE
			skippedMatchCount := skippedMatchCount + 1;
		END_IF
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="Full" Id="{142088f9-89b6-4514-9bf8-182d44bd5096}">
      <Declaration><![CDATA[(*!
<summary>Reports whether fixed-capacity storage has no free slot.</summary>
<description>
Dynamic collections report FALSE even when Length equals Capacity. This does not guarantee available heap memory.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Full : BOOL]]></Declaration>
      <Get Name="Get" Id="{60f38d2d-7d5e-4f53-bd6e-39eabf1a5689}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Full := _StaticCapacity <> 0 AND_THEN _Length >= _StaticCapacity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Get" Id="{35156606-e33f-4fd7-a3f8-50e4c6feea06}">
      <Declaration><![CDATA[(*!
<summary>Borrows the descriptor at a zero-based list position.</summary>
<description>
An out-of-range index raises an exception. Returned descriptors and payload are borrowed, not clones. Do not modify descriptor metadata or release payload through this view, even when IsMemoryOwner is TRUE. Keep the source and borrowed storage alive; mutation or destruction can invalidate the view.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL Get : REFERENCE TO TOF_Core.GENERIC_VALUE
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < 0 OR_ELSE index >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index', index);
END_IF

Get REF= _Array[index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="InsertCopy" Id="{7c5e7ea9-1602-45c2-9555-47aa08559820}">
      <Declaration><![CDATA[(*!
<summary>Copies a value and inserts it at the requested position.</summary>
<description>
Borrows the original during the call. isObject = TRUE requires a live Object FB instance implementing ICloneable; other data is copied as bytes without recursively cloning references. A prepared copy is released if insertion fails before acceptance; exceptions propagate. Engine-managed exception objects are unsupported. The position may range from zero through Length inclusive.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL InsertCopy : IList
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	genericValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[genericValue := TOF_Core.GenericValueFactory.FromAnyType(value, isObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY);

__TRY
	InsertCopy := InsertGeneric(index, genericValue);
__CATCH(exceptionCode)
	genericValue.Release();
	
	TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="InsertGeneric" Id="{2dcf43ab-5d4d-40f0-ba4f-54f191c32509}">
      <Declaration><![CDATA[(*!
<summary>Inserts a descriptor and shifts subsequent entries to the right.</summary>
<description>
Successful insertion transfers disposal responsibility for owned payload; borrowed payload must remain alive while stored. The caller-side descriptor copy is not reset and must not be released again after transfer. Independent owning aliases and overlapping owned allocations are unsupported. index may range from zero through Length inclusive. Invalid indices and full static storage raise exceptions. Validation precedes insertion. Dynamic growth rejects nonpositive increments and unrepresentable capacity or allocation sizes before insertion.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL InsertGeneric : IList
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
	value : TOF_Core.GENERIC_VALUE;	
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;
	staticCollectionFullException : TOF_Core.StaticCollectionFullException;
	
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < 0 OR_ELSE index > _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index', index);
END_IF

IF _ValueValidator <> 0 THEN
	_ValueValidator.Validate(GetName(), value);
END_IF

InsertGeneric := THIS^;

IF _Length >= Capacity THEN
	IF Dynamic THEN
		AllocateMemory(DefaultDynamicAllocationElementCount);
	ELSE
		staticCollectionFullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), GetName(), TO_UDINT(Capacity));
	END_IF
END_IF

_Length := _Length + 1;

i := _Length - 1;

WHILE i > index DO
	_Array[i] := _Array[i - 1];	
	i := i - 1;
END_WHILE

_Array[i] := value;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Length" Id="{8b78c4a9-2b51-4df9-a89b-35d75f4063d7}">
      <Declaration><![CDATA[(*!
<summary>Reports the number of stored entries.</summary>
<description>
Units are bytes for ByteList and entries for other collections. Existing positions range from zero through Length minus one.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Length : TOF_Core.DINT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{40434b4f-ac59-4ed2-adb0-38a6ead17ebd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Length := _Length;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{790d2c44-7c10-4ff7-8e9f-92d4936a4655}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace for diagnostics.</summary>
<description>
Borrowed read-only reference to compiler-initialized metadata; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dfd8ff83-c535-4eea-abbd-5a05ac36fe99}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RemoveAt" Id="{0e28301b-e63b-49ca-a697-ef9528fc2481}">
      <Declaration><![CDATA[(*!
<summary>Removes an existing list entry and compacts subsequent entries.</summary>
<description>
Invalid indices raise an exception. Owned payload is released best effort through GENERIC_VALUE.Release; borrowed payload is not freed. Returns this list. Positions and descriptor references may change; cleanup callbacks must not reenter mutation.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL RemoveAt : IList
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;

	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < 0 OR_ELSE index >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index', index);
END_IF

RemoveAt := THIS^;

_Array[index].Release();			

IF index < _Length - 1 THEN
	Tc2_System.MEMMOVE(ADR(_Array[index]), ADR(_Array[index + 1]), TO_UDINT(SIZEOF(TOF_Core.GENERIC_VALUE) * (_Length - index - 1)));
END_IF

(*FOR	i := index TO _Length - 2 DO
	_Array[i] := _Array[i + 1];
END_FOR*)			

_Array[_Length - 1].Reset();	

_Length := _Length - 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveFirst" Id="{ab28382f-e74f-44a6-bee2-f905f3030356}">
      <Declaration><![CDATA[(*!
<summary>Removes the first list entry equal to a borrowed query.</summary>
<description>
Uses default GENERIC_VALUE equality; isObject = TRUE requires a live Object FB instance. Reports removed on a successful match and returns this list. Owned stored payload is released; the query is not adopted or separately released. Equality exceptions propagate.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL RemoveFirst : IList
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	removed : BOOL;
END_VAR
VAR
	genericValue : TOF_Core.GENERIC_VALUE;
	i : TOF_Core.DINT_INDEX;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RemoveFirst := THIS^;

IF _Length > 0 THEN
	genericValue := TOF_Core.GenericValueFactory.FromAnyType(value, isObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
	
	FOR i := 0 TO _Length - 1 DO
		IF _Array[i].Equals(genericValue) THEN
			RemoveAt(i);
			removed := TRUE;
			RETURN;
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveMatched" Id="{e5cc38ae-8b20-4e35-acc9-fcd84e9d10bd}">
      <Declaration><![CDATA[(*!
<summary>Removes predicate matches while traversing from the end.</summary>
<description>
skip counts matches from the end. A null predicate or maxRemoved = 0 performs no removal. Removes at most maxRemoved matching entries after skipping the requested matches. Stops immediately after reaching the limit, without invoking the predicate for remaining entries. Predicate exceptions propagate after any completed removals, without rollback. removedCount counts completed removals. Callbacks must not mutate the traversed collection.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL RemoveMatched : IList
VAR_INPUT
	predicate : TOF_Core.IPredicate;
	skip : UDINT := 0;
	maxRemoved : UDINT := TOF_Core.UnsignedInt32.MAX_VALUE;
END_VAR
VAR_OUTPUT
	removedCount : DINT;
END_VAR
VAR
	i : DINT;

	currentValue : __SYSTEM.AnyType;

	skippedMatchCount : UDINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RemoveMatched := THIS^;

IF TO_DINT(skip) >= _Length OR_ELSE predicate = 0 OR_ELSE maxRemoved = TOF_Core.UnsignedInt32.MIN_VALUE THEN
	RETURN;
END_IF

FOR i := _Length - 1 TO 0 BY -1 DO
	currentValue := _Array[i].AsAnyType();
	
	IF predicate.Check(currentValue) THEN
		IF skip <= skippedMatchCount THEN
			RemoveAt(i);
			removedCount := removedCount + 1;

			IF TO_UDINT(removedCount) >= maxRemoved THEN
				EXIT;
			END_IF
		ELSE
			skippedMatchCount := skippedMatchCount + 1;
		END_IF
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="restoreHeapFrom" Id="{1a1c5c77-8af0-4f17-a539-272de7e4b0a4}" FolderPath="Service methods\">
      <Declaration><![CDATA[(*!
<summary>Restores the heap order below a root within the active sort range.</summary>
<description>Requires valid indices and the same live comparer used by Sort. Addresses complete GENERIC_VALUE entries through typed array indexing, compares their descriptors without converting categories and swaps entries in place. Comparer exceptions propagate; completed swaps are not rolled back.</description>
*)
METHOD PRIVATE restoreHeapFrom
VAR_INPUT
    rootIndex : DINT;
    heapSize : DINT;
    comparer : TOF_Core.IComparer;
    direction : TOF_Core.SORT_DIRECTION;
END_VAR
VAR
    currentIndex : DINT;
    childIndex : DINT;
    selectedIndex : DINT;

    comparisonResult : TOF_Core.COMPARISON_RESULT;

    value1, value2 : POINTER TO TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[currentIndex := rootIndex;

WHILE (currentIndex * 2 + 1) < heapSize DO
    childIndex := currentIndex * 2 + 1;
    selectedIndex := currentIndex;

    value1 := ADR(_Array[selectedIndex]);
    value2 := ADR(_Array[childIndex]);

    comparisonResult := comparer.Compare(value1^, value2^);

    IF direction = TOF_Core.SORT_DIRECTION.ASCENDING THEN
        IF comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND THEN
            selectedIndex := childIndex;
        END_IF
    ELSE
        IF comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND THEN
            selectedIndex := childIndex;
        END_IF
    END_IF

    IF (childIndex + 1) < heapSize THEN
        value1 := ADR(_Array[selectedIndex]);
        value2 := ADR(_Array[childIndex + 1]);

        comparisonResult := comparer.Compare(value1^, value2^);

        IF direction = TOF_Core.SORT_DIRECTION.ASCENDING THEN
            IF comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND THEN
                selectedIndex := childIndex + 1;
            END_IF
        ELSE
            IF comparisonResult = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND THEN
                selectedIndex := childIndex + 1;
            END_IF
        END_IF
    END_IF

    IF selectedIndex = currentIndex THEN
        RETURN;
    END_IF

    Swap(currentIndex, selectedIndex);
	
    currentIndex := selectedIndex;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{b8f1c23e-6bde-4d17-b77f-f3d1373a6f6b}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this function-block instance.</summary>
<description>
Measured in bytes; includes inline storage but excludes separately allocated buffers, payload and enumerators.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0c60dbce-56ff-4644-ae28-c3c705772b31}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetCopy" Id="{e9638d43-e88c-48cb-a07f-937c5e87c232}">
      <Declaration><![CDATA[(*!
<summary>Copies a value and stores it through SetGeneric.</summary>
<description>
Borrows the original during the call. isObject = TRUE requires a live Object FB instance implementing ICloneable; other data is copied as bytes without recursively cloning references. A prepared copy is released if insertion fails before acceptance; exceptions propagate. Engine-managed exception objects are unsupported. Any index output is meaningful only on success.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL SetCopy : IList
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	genericValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[genericValue := TOF_Core.GenericValueFactory.FromAnyType(value, isObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY);

__TRY
	SetCopy := SetGeneric(index, genericValue);
__CATCH(exceptionCode)
	genericValue.Release();
	
	TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetGeneric" Id="{28fb4746-7d53-4b08-a432-54d437f989bb}">
      <Declaration><![CDATA[(*!
<summary>Replaces the descriptor at an existing list position.</summary>
<description>
Successful replacement transfers disposal responsibility for owned payload; borrowed payload must remain alive while stored. The caller-side descriptor copy is not reset and must not be released again after transfer. Invalid indices and rejected validation raise exceptions before replacement. Reusing the same allocation preserves existing ownership or accepts incoming ownership without releasing that allocation. Aliases must have compatible disposal semantics; independently owned aliases and overlapping owned ranges are unsupported. A different displaced allocation is released best effort after installing the new descriptor. Cleanup callbacks must not reenter collection mutation.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL SetGeneric : IList
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
	value : TOF_Core.GENERIC_VALUE;	
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;

	displacedValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < TOF_Core.SignedInt32.ZERO OR_ELSE index >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index', index);
END_IF

IF _ValueValidator <> 0 THEN
	_ValueValidator.Validate(GetName(), value);
END_IF

SetGeneric := THIS^;

displacedValue := _Array[index];
IF displacedValue.Address = value.Address THEN
	IF displacedValue.IsMemoryOwner AND_THEN NOT value.IsMemoryOwner THEN
		value := TOF_Core.GenericValueFactory.FromParts(value.TypeClass, value.Address, value.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY);
	END_IF

	displacedValue.Reset();
END_IF

_Array[index] := value;
displacedValue.Release();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Sort" Id="{cd2a8a15-72bb-44f7-9e5d-ecb76fed56a8}">
      <Declaration><![CDATA[(*!
<summary>Reorders entries in place using the supplied generic-value ordering strategy.</summary>
<description>The comparer and payload are borrowed. For two or more entries, the caller must supply a live, compatible comparer with a consistent order. Descriptors retain their type categories, including OBJECT. Comparer callbacks must not modify operands or the collection. Exceptions propagate and completed swaps are not rolled back. Returns this list; ownership of entries is unchanged. Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="comparer">Borrowed ordering strategy for the stored generic values.</param>
//!<param name="direction">Requested ordering direction.</param>
METHOD FINAL Sort : IList
VAR_INPUT
	comparer : TOF_Core.IComparer;
	direction : TOF_Core.SORT_DIRECTION := TOF_Core.SORT_DIRECTION.ASCENDING;
END_VAR
VAR
    argumentNullException : TOF_Core.ArgumentNotSpecifiedException;

    i : DINT;
    j : DINT;
    startIndex : DINT;
    endIndex : DINT;

    comparisonResult : TOF_Core.COMPARISON_RESULT;

    value1, value2 : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Sort := THIS^;

IF _Length <= 1 THEN
    RETURN;
END_IF

// Insertion sort is faster for small lists, otherwise use heap sort
IF _Length <= 16 THEN
    FOR i := 1 TO _Length - 1 DO
        j := i;

        WHILE j > 0 DO
            value1 := _Array[j - 1];
            value2 := _Array[j];

            comparisonResult := comparer.Compare(value1, value2);

            IF direction = TOF_Core.SORT_DIRECTION.ASCENDING THEN
                IF comparisonResult <> TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND THEN
                    EXIT;
                END_IF
            ELSE
                IF comparisonResult <> TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND THEN
                    EXIT;
                END_IF
            END_IF

            Swap(j - 1, j);
			
            j := j - 1;
        END_WHILE
    END_FOR

    RETURN;
END_IF

// Build heap
startIndex := (_Length / 2) - 1;

WHILE startIndex >= 0 DO
    restoreHeapFrom(startIndex, _Length, comparer, direction);
	
    startIndex := startIndex - 1;
END_WHILE

// Extract heap root into the final sorted position
endIndex := _Length - 1;

WHILE endIndex > 0 DO
    Swap(0, endIndex);
	
    restoreHeapFrom(0, endIndex, comparer, direction);
	
    endIndex := endIndex - 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Swap" Id="{eb0e8297-edd7-472f-a573-82e2ae740339}">
      <Declaration><![CDATA[(*!
<summary>Exchanges two positions without cloning or releasing payload.</summary>
<description>
Returns this list. Different indices must be valid or an exception is raised. Current implementation returns immediately for equal indices without validating them. Payload ownership is preserved.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL Swap : IList
VAR_INPUT
	index1 : TOF_Core.DINT_INDEX;
	index2 : TOF_Core.DINT_INDEX;
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;
	tmp : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Swap := THIS^;

IF index1 = index2 THEN
	RETURN;
ELSIF index1 < 0 OR_ELSE index1 >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index1', index1);
ELSIF index2 < 0 OR_ELSE index2 >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index2', index2);
END_IF

tmp := _Array[index1];
_Array[index1] := _Array[index2];
_Array[index2] := tmp;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ValueValidator" Id="{b948083e-197f-42c4-870d-0ac963bd346a}">
      <Declaration><![CDATA[(*!
<summary>Exposes the configured value validator.</summary>
<description>
Borrowed optional reference fixed at initialization. Zero means no validator. The collection does not own or release it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ValueValidator : TOF_Core.IGenericValueValidator]]></Declaration>
      <Get Name="Get" Id="{cb2fa504-489a-4e73-8b3c-20c2650b6edd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ValueValidator := _ValueValidator;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
