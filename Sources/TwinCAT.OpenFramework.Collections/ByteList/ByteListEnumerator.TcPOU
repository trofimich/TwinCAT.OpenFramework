<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListEnumerator" Id="{0eaa5e30-f578-440b-bf42-b39d6e892a5e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Enumerates a borrowed collection using an independent cursor.</summary>
<description>
The source must be non-null, outlive the cursor and remain structurally unchanged during traversal. The caller explicitly releases a dynamically created cursor. Current borrows a byte cached in this cursor, not the source buffer; it never transfers ownership.
MoveNext stops advancing at the end position of an unchanged source; repeated exhausted calls return FALSE until Reset.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK ByteListEnumerator EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IEnumerator
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_List : IReadOnlyByteList;
	{attribute 'hide'} 
	_CurrentIndex : DINT := -1;
	
	{attribute 'hide'} 
	_CurrentByte : BYTE;
	{attribute 'hide'} 
	_GenericValue : TOF_Core.GENERIC_VALUE;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{d0ef8e8d-8cab-4592-a439-a079fcf6b703}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0311af57-34ad-4839-8f64-45605666dbff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Current" Id="{34633660-6766-4502-8d0b-2f6866bc7750}">
      <Declaration><![CDATA[(*!
<summary>Exposes a read-only borrowed view of the current entry.</summary>
<description>
Reading Current before the first successful MoveNext, after Reset or after exhaustion yields an empty descriptor. At a valid position, the source byte is copied into cursor-local storage and the returned descriptor borrows that storage, including when the byte value is zero. Do not modify or release the descriptor. Keep the cursor alive while using the view; subsequent Current access can overwrite its cached byte. Cursor movement or reset invalidates the previous view contract.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Current : REFERENCE TO TOF_Core.GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{a7991f02-dccd-4bc0-a616-ec473de5b639}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentIndex >= 0 AND_THEN _CurrentIndex < _List.Length THEN
	_CurrentByte := _List.Get(_CurrentIndex); 
	_GenericValue := TOF_Core.GenericValueFactory.FromParts(TOF_Core.GENERIC_TYPE_CLASS.UINT_8, ADR(_CurrentByte), 1, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
ELSE
	_GenericValue.Reset();
END_IF 

Current REF= _GenericValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CurrentByte" Id="{110179b3-6f98-4cf4-ae85-eec25b6472ac}">
      <Declaration><![CDATA[(*!
<summary>Returns the current entry in its concrete representation.</summary>
<description>
Use only after MoveNext returns TRUE and before the next cursor or source change. No result is promised outside a valid position. The byte is returned by value.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL CurrentByte : BYTE]]></Declaration>
      <Get Name="Get" Id="{15812a15-c7f7-49c5-8a38-6b883ff80d77}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentIndex >= 0 AND_THEN _CurrentIndex < _List.Length THEN
	CurrentByte := _List.Get(_CurrentIndex); 
END_IF ]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{64a9e57e-1291-4061-b0c2-def30792e0f4}">
      <Declaration><![CDATA[(*!
<summary>Binds the borrowed source for enumeration.</summary>
<description>
The source must be non-null and outlive the cursor. Only the reference is assigned; no allocation, callbacks or throwing validation are performed.
</description>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	list : IReadOnlyByteList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveNext" Id="{bb301441-6417-4b6a-8920-265d238eecbf}">
      <Declaration><![CDATA[(*!
<summary>Advances the cursor to the next source position.</summary>
<description>
The source must be live, non-null and structurally unchanged during traversal. TRUE identifies a current entry. The index advances only while below source Length and stops at the end position. Repeated exhausted calls return FALSE without incrementing the index; reading Current yields an empty descriptor. Reset allows traversal from the beginning again. No snapshot or mutation detection is provided.
 Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
{attribute "object_name" := "MoveNext"}
METHOD FINAL MoveNext : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentIndex < _List.Length THEN
	_CurrentIndex := _CurrentIndex + 1;
END_IF

MoveNext := _CurrentIndex < _List.Length;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{3f49bd54-cf7c-48ab-b476-040534a96221}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace for diagnostics.</summary>
<description>
Borrowed read-only reference to compiler-initialized metadata; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{04eab4d1-eee5-42eb-828c-34eca7f6264d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{1a671f16-85bb-4034-972d-cf14ae393e20}">
      <Declaration><![CDATA[(*!
<summary>Places the cursor before the first source entry.</summary>
<description>
The next MoveNext starts at zero. Does not modify the source or release payload; reading Current now yields an empty descriptor.
 Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
{attribute "object_name" := "Reset"}
METHOD FINAL Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CurrentIndex := -1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{108df5a2-3a30-4039-b541-048811bab97b}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this function-block instance.</summary>
<description>
Measured in bytes; includes inline storage but excludes separately allocated buffers, payload and enumerators.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{de7624c7-c9a3-4045-8ace-16907f6279e5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
