<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IReadOnlyByteList" Id="{a843c369-9e00-00a1-32fa-d03c5ab85265}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides indexed byte access and first-match searching.</summary>
<description>
Indices are zero-based. Get returns a byte value. Enumeration borrows the source, which must remain alive and structurally unchanged during traversal.
</description>
*)

INTERFACE IReadOnlyByteList EXTENDS ICollection
]]></Declaration>
    <Method Name="Find" Id="{3f29ee40-326e-4872-b375-7e35c81e45f0}">
      <Declaration><![CDATA[(*!
<summary>Finds the first occurrence of a byte.</summary>
<description>
Searches from zero. TRUE makes index valid; on FALSE no index is promised. The collection is unchanged.
</description>
*)
METHOD Find : BOOL
VAR_INPUT
	value : BYTE;
END_VAR
VAR_OUTPUT
	index : TOF_Core.DINT_INDEX;
END_VAR]]></Declaration>
    </Method>
    <Method Name="Get" Id="{27925820-f345-0e43-1a3c-84ba47105d29}">
      <Declaration><![CDATA[(*!
<summary>Returns the byte at an existing zero-based position.</summary>
<description>
Raises an exception when backing storage is absent or the index is outside Length. The result is a byte copy.
</description>
*)
METHOD Get : BYTE
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>