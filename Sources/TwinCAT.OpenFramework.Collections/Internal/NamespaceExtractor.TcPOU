FUNCTION_BLOCK INTERNAL NamespaceExtractor
VAR_OUTPUT
	(*!
<summary>Receives the library namespace from compiler initialization.</summary>
<description>
CurrentNamespace is populated by init_namespace and used as read-only diagnostic metadata. No runtime extraction or allocation is performed.
</description>
*)

{attribute 'init_namespace'} 
	CurrentNamespace : STRING;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>