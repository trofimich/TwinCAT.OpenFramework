<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CurrentNamespace" Id="{d0d30f2d-b5ef-411b-a26a-5471b49c1d92}" SpecialFunc="None">
    <Declaration><![CDATA[(*
