(*!
<summary>Exposes the compiler-initialized namespace of Collections.</summary>
<description>
Internal metadata provider; Name borrows the extractor string and must not be modified. Do not execute this program explicitly.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this POU directly'}
PROGRAM INTERNAL CurrentNamespace
VAR
	{attribute 'hide'} 
	_NamespaceExtractor : NamespaceExtractor;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Name" Id="{d81efea1-8190-4909-bfda-0451a9113803}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized namespace string.</summary>
<description>
Read-only metadata backed by NamespaceExtractor; callers must not modify it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Name : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0aa210e0-fb32-4a5b-bdad-8914a0728202}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name REF= _NamespaceExtractor.CurrentNamespace;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>