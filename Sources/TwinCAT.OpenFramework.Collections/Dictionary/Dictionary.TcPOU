(*!
<summary>Stores key-value entries with fixed or dynamic capacity.</summary>
<description>
CreateEnumerator allocates an independent cursor owned by its caller.
The collection must remain alive while that cursor is used.
SetGeneric retains an existing matching key and replaces its value.
SetGeneric preserves disposal responsibility when the same allocation is reused; transferred
caller-side owning aliases must not be released again.
Lookup uses GENERIC_VALUE equality/hashing or the borrowed keyEqualityComparer supplied once through
FB_init. Pass zero explicitly to use default key equality and hashing.
Empty keys are supported unless rejected by a validator.
Raw queries create borrowed descriptors with an explicit object flag.
Entries and enumeration have no guaranteed order; positions are storage slots, not sorted ranks.
Do not modify stored descriptors through returned references.
SetCopy cleans up prepared copies if preparation of the second copy or insertion fails before
ownership is accepted.
Try lookup/removal operations contain exceptions without rolling back partial effects.
Generic query arguments are borrowed by default.
Explicitly requested release in Try operations is attempted even after lookup failure; caller-side
owning aliases are not reset.
OBJECT keys are permitted when their descriptors refer to live Object instances.
A borrowed key (IsMemoryOwner = FALSE) is not owned or destroyed by the dictionary; its owner must
keep it alive for every operation that may access the stored key.
An owned key must not be deleted or transferred to another owner through a caller-side alias.
While a key is stored, do not change data used by the active comparison rules, its equality/hash
results, or equality-relevant comparer configuration.
Remove the entry before such a change, then insert it again.
Queries and callbacks must not mutate keys or reenter collection mutation.
Do not use explicit query release to dispose of a stored key or other storage still retained by the
collection.
An address-based identity index must be rebuilt after address relocation; stale indices must not be
used.
Borrowing does not pin an object or extend its lifetime.
A copied object has its own identity; lookup using the original requires an equality strategy under
which original and copy are equal.
Default OBJECT lookup delegates to Object.Equals/GetHashCode; fields unrelated to equality/hash may
change.
The index caches hashes and must be discarded and populated again after equality-relevant address
relocation before further lookup.
Static index storage adds 12 bytes per capacity slot and three pointers plus the comparer reference.
Dynamic entries and the 12-byte-per-slot index share one allocation; growth temporarily retains both
old and new allocations.
Expected bucket lookup is constant time plus hashing/equality costs, worst case linear; compaction
and rebuilding after removal are linear in capacity and Length.
Validators are borrowed for the collection lifetime. No internal locking is implemented. Concurrent access involving mutation requires caller coordination; this implementation does not provide a concurrent-container guarantee.
Generic lookup with requested query release also attempts cleanup on lookup failure before propagating the captured exception; terminal OOM takes precedence.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK Dictionary
VAR_GENERIC CONSTANT
 	{attribute 'hide'}
   _StaticCapacity : TOF_Core.DINT_LENGTH := 0;
END_VAR
EXTENDS TOF_Core.Object IMPLEMENTS IDictionary
VAR_INPUT
	//! <summary>Number of slots added when dynamic storage is full; must be positive when growth is required.</summary>
	DefaultDynamicAllocationElementCount : BYTE := 10;
END_VAR
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();

	{attribute 'hide'}
	_KeyValidator : TOF_Core.IGenericValueValidator;
	{attribute 'hide'}
	_ValueValidator : TOF_Core.IGenericValueValidator;
	{attribute 'hide'}
	_KeyEqualityComparer : TOF_Core.IEqualityComparer;

	{attribute 'hide'}
	_Array : POINTER TO TOF_Core.GENERIC_KEY_VALUE_PAIR;
	{attribute 'hide'}
	_StaticArray : ARRAY [0.._StaticCapacity - 1] OF TOF_Core.GENERIC_KEY_VALUE_PAIR;

	{attribute 'hide'}
	_Hashes : POINTER TO UDINT;
	{attribute 'hide'}
	_Buckets : POINTER TO DINT;
	{attribute 'hide'}
	_NextIndices : POINTER TO DINT;

	{attribute 'hide'}
	_StaticHashes : ARRAY [0.._StaticCapacity - 1] OF UDINT;
	{attribute 'hide'}
	_StaticBuckets : ARRAY [0.._StaticCapacity - 1] OF DINT;
	{attribute 'hide'}
	_StaticNextIndices : ARRAY [0.._StaticCapacity - 1] OF DINT;

	{attribute 'hide'}
	_DynamicCapacity : TOF_Core.DINT_LENGTH;
	{attribute 'hide'}
	_Length : TOF_Core.DINT_LENGTH;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Service members" Id="{e2c68c01-e8ea-425f-ba6b-6175fdff734e}" />
    <Method Name="AllocateMemory" Id="{0e7f768a-1410-4b70-bf65-58b5d6436902}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Grows the combined entry and hash-index buffer before accepting incoming ownership.</summary>
<description>
Static collections return without allocation.
A positive increment must fit DINT capacity and the UDINT allocation-byte limit, including 12 index
bytes per slot.
One allocation contains entries, cached hashes, bucket heads and links.
Allocation failure preserves the old buffer, index, capacity and payload ownership and sets terminal
allocation state.
Existing descriptors and hashes are copied; rebuilding links invokes no equality/hash callbacks.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD PROTECTED FINAL AllocateMemory
VAR_INPUT
	elementCount : TOF_Core.DINT_LENGTH;
END_VAR
VAR CONSTANT
	ENTRY_ALLOCATION_SIZE : ULINT := XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR) + XSIZEOF(UDINT) + 2 * XSIZEOF(DINT);
END_VAR
VAR
	newMemory : POINTER TO BYTE;
	newHashes : POINTER TO UDINT;
	newCapacity : ULINT;

	rangeException : TOF_Core.ArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Dynamic THEN
	RETURN;
END_IF

IF elementCount <= TOF_Core.SignedInt32.ZERO THEN
	rangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'elementCount', elementCount);
END_IF

newCapacity := TO_ULINT(_DynamicCapacity) + TO_ULINT(elementCount);
IF newCapacity > TO_ULINT(TOF_Core.SignedInt32.MAX_VALUE)
	OR_ELSE newCapacity > TO_ULINT(TOF_Core.UnsignedInt32.MAX_VALUE) / ENTRY_ALLOCATION_SIZE
THEN
	rangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'capacity', newCapacity);
END_IF

newMemory := __NEW(BYTE, TO_UDINT(ENTRY_ALLOCATION_SIZE * newCapacity));
IF newMemory = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

newHashes := newMemory + TO_UDINT(XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR) * newCapacity);
IF _Length > TOF_Core.SignedInt32.ZERO THEN
	Tc2_System.MEMCPY(newMemory, _Array, TO_UDINT(XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR) * TO_ULINT(_Length)));
	Tc2_System.MEMCPY(newHashes, _Hashes, TO_UDINT(XSIZEOF(UDINT) * TO_ULINT(_Length)));
END_IF

IF _Array <> 0 THEN
	__DELETE(_Array);
END_IF

_Array := newMemory;
_Hashes := newHashes;
_Buckets := newMemory + TO_UDINT((XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR) + XSIZEOF(UDINT)) * newCapacity);
_NextIndices := newMemory + TO_UDINT((XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR) + XSIZEOF(UDINT) + XSIZEOF(DINT)) * newCapacity);
_DynamicCapacity := TO_DINT(newCapacity);

RebuildIndex();]]></ST>
      </Implementation>
    </Method>
    <Property Name="Capacity" Id="{4579ce74-1fcb-413c-9ce9-78988f96faab}">
      <Declaration><![CDATA[(*!
<summary>Reports the currently allocated number of slots.</summary>
<description>
Units are bytes for ByteList and entries for other collections. Static capacity is fixed; dynamic capacity can change on growth or clearing. This is not a guarantee that the next allocation succeeds.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Capacity : TOF_Core.DINT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{d4ee678a-0174-4756-8c66-8b386c7b16d8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Capacity := SEL(_StaticCapacity = 0, _StaticCapacity, _DynamicCapacity);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{2ba03c75-6849-4d3f-be0a-7ec3bb3723e7}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete type name for diagnostics.</summary>
<description>
Borrowed read-only reference to instance metadata; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{16dbbed6-7d92-472a-aa65-fa307ed9f2d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{6bbda434-8ecb-447c-84e2-06549ff7293c}">
      <Declaration><![CDATA[(*!
<summary>Removes all entries and releases dynamic entry and index storage.</summary>
<description>
Owned payload cleanup is best effort.
The collection is marked empty before disposal; cleanup callbacks must not reenter mutation.
Static capacity and the lifetime comparer/validators are retained.
Dynamic capacity becomes zero.
Uses no allocation or equality/hash callbacks and leaves static buckets empty for reuse.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL Clear : IDictionary
VAR
	index : DINT;
	entryCount : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear := THIS^;
entryCount := _Length;
_Length := 0;

FOR index := 0 TO entryCount - 1 DO
	_Array[index].Key.Release();
	_Array[index].Value.Release();
END_FOR

IF Dynamic THEN
	IF _Array <> 0 THEN
		__DELETE(_Array);
	END_IF

	_Array := 0;
	_Hashes := 0;
	_Buckets := 0;
	_NextIndices := 0;
	_DynamicCapacity := 0;
ELSE
	RebuildIndex();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ContainsGenericKey" Id="{40e3952b-e79c-43eb-86c3-ebc7badec7a9}">
      <Declaration><![CDATA[(*!
<summary>Reports whether a matching entry exists for a borrowed generic query.</summary>
<description>
The query is borrowed by default.
Explicit release requests disposal of owned query storage after lookup completes, including a
missing result.
Requested release is attempted after both successful lookup and lookup failure. Before cleanup, the original framework exception is retained and a borrowed static system exception is cloned to preserve its code, catch point and timestamps across cleanup callbacks. The captured exception is then propagated through ExceptionManager.Throw in the current cyclic task; native errors use the framework SystemException representation. If capturing the system exception fails with terminal OOM, query cleanup is still attempted and terminal OOM takes precedence. Terminal allocation state is never cleared. Release is best effort and does not prove successful deallocation. Cleanup callbacks must not reenter collection mutation.
Release resets only the local descriptor copy; the caller must have disposal rights and must not
reuse or release owning aliases afterwards.
Borrowed payload is not freed.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL ContainsGenericKey : BOOL
VAR_INPUT
	key : TOF_Core.GENERIC_VALUE;
	releaseKey : BOOL := FALSE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	ContainsGenericKey := FindKeyIndex(key);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
__ENDTRY

IF releaseKey THEN
	IF caughtException <> 0 AND_THEN NOT caughtException.IsDynamicInstance THEN
		__TRY
			__QUERYINTERFACE(caughtException.Clone(), caughtException);
		__CATCH(exceptionCode)
			key.Release();

			TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
		__ENDTRY
	END_IF

	key.Release();
END_IF

IF caughtException <> 0 THEN
	TOF_Core.ExceptionManager.Throw(caughtException);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ContainsKey" Id="{59c7babd-f6ce-449c-a373-7928830c9806}">
      <Declaration><![CDATA[(*!
<summary>Reports whether a matching raw query exists.</summary>
<description>
The raw ANY argument is borrowed without cloning or ownership transfer. keyIsObject = TRUE requires
a live Object function-block instance, not a pointer or interface variable.
FALSE uses ordinary runtime type mapping.
The caller keeps the query storage alive for the call.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="keyIsObject">Explicitly interprets the raw argument as a live Object instance.</param>
METHOD FINAL ContainsKey : BOOL
VAR_INPUT
	key : ANY;
	keyIsObject : BOOL := FALSE;
END_VAR
VAR
	genericKey : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[genericKey := TOF_Core.GenericValueFactory.FromAnyType(key, keyIsObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);

ContainsKey := FindKeyIndex(genericKey);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateEnumerator" Id="{5e86c797-07a7-40e5-a54a-edd93009219c}">
      <Declaration><![CDATA[(*!
<summary>Creates an independent enumerator owned by the caller.</summary>
<description>
The caller must explicitly release the enumerator and keep this collection alive while using it.
Allocation failure invokes DynamicMemoryManager.RaiseAllocationFailure without a heap exception; it
is terminal and is not returned as a recoverable null result.
</description>
*)
METHOD CreateEnumerator : TOF_Core.IEnumerator
VAR
	enumerator : POINTER TO DictionaryEnumerator;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[enumerator := __NEW(DictionaryEnumerator(dictionary := THIS^));

IF enumerator = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

CreateEnumerator := enumerator^;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Dynamic" Id="{b841ae6e-f9a7-47ff-a1db-5860e360fe74}">
      <Declaration><![CDATA[(*!
<summary>Reports whether storage can grow dynamically.</summary>
<description>
Static capacity zero selects dynamic storage. Dynamic collections can still fail to allocate.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Dynamic : BOOL]]></Declaration>
      <Get Name="Get" Id="{f184ffad-d4eb-4a8e-99c4-8d96a1f69b20}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Dynamic := _StaticCapacity = 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Empty" Id="{a58c59ac-639e-495e-b1ee-a36c99015b1b}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the collection has no entries.</summary>
<description>
Reflects Length; not a check of payload lifetime or memory health.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{dbc1e4f8-7406-4eaf-9da1-eff90caad1f2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Empty := _Length <= 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{bab70cb4-1255-41fe-9739-25af7a0667fe}">
      <Declaration><![CDATA[(*!
<summary>Releases collection payload and dynamic entry/index storage during destruction.</summary>
<description>
Calls the non-allocating Clear path without invoking equality/hash callbacks.
Owned payload release is best effort and cannot guarantee successful deallocation; cleanup callbacks
must not throw or reenter mutation.
</description>
*)
//!<param name="bInCopyCode">if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).</param>

METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Clear();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{ac120052-60c8-4ef6-b53b-c0cb0524ef2e}">
      <Declaration><![CDATA[(*!
<summary>Binds validators, the lifetime equality strategy and static storage.</summary>
<description>
The key comparer is borrowed for the entire collection lifetime. Supply it explicitly; zero selects
GENERIC_VALUE default equality and hashing.
Keep it alive and its equality-relevant configuration stable.
There is no subsequent comparer replacement.
Initialization binds existing storage without allocating or calling validators, comparers or other
throwing paths.
</description>
*)
//!<param name="bInitRetains">if TRUE, the retain variables are initialized (warm start / cold start)</param>

//!<param name="bInCopyCode">if TRUE, the instance afterwards gets moved into the copy code (online change)</param>

//!<param name="keyEqualityComparer">Borrowed key equality and hash strategy; pass zero explicitly for the GENERIC_VALUE defaults.</param>
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL;
	bInCopyCode : BOOL;

	keyValidator : TOF_Core.IGenericValueValidator;
	valueValidator : TOF_Core.IGenericValueValidator;
	keyEqualityComparer : TOF_Core.IEqualityComparer;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_KeyValidator := keyValidator;
_ValueValidator := valueValidator;
_KeyEqualityComparer := keyEqualityComparer;

IF NOT Dynamic THEN
	_Array := ADR(_StaticArray);
	_Hashes := ADR(_StaticHashes);
	_Buckets := ADR(_StaticBuckets);
	_NextIndices := ADR(_StaticNextIndices);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindKeyIndex" Id="{0002c577-30ed-4f40-b96a-46bdc85d8d43}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Finds an equal key through its hash bucket.</summary>
<description>
Borrows the descriptor and payload without changing ownership.
The configured equality strategy computes the query hash once; equal hash codes are resolved with
Equals.
Callback exceptions propagate before mutation.
On a miss supposedIndex is the append position. hashCode is valid after a completed lookup,
including a miss.
No ordering or sorted rank is provided.
Bucket heads and links encode entry index plus one; zero ends a chain.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD PROTECTED FINAL FindKeyIndex : BOOL
VAR_INPUT
	key : TOF_Core.GENERIC_VALUE;
END_VAR
VAR_OUTPUT
	supposedIndex : DINT;
	hashCode : UDINT;
END_VAR
VAR
	entryLink : DINT;
	entryIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FindKeyIndex := FALSE;
supposedIndex := _Length;
hashCode := key.GetHashCode(_KeyEqualityComparer);

IF _Length = TOF_Core.SignedInt32.ZERO THEN
	RETURN;
END_IF

entryLink := _Buckets[TO_DINT(hashCode MOD TO_UDINT(Capacity))];
WHILE entryLink <> TOF_Core.SignedInt32.ZERO DO
	entryIndex := entryLink - 1;

	IF _Hashes[entryIndex] = hashCode
		AND_THEN _Array[entryIndex].Key.Equals(key, _KeyEqualityComparer)
	THEN
		supposedIndex := entryIndex;
		FindKeyIndex := TRUE;
		RETURN;
	END_IF

	entryLink := _NextIndices[entryIndex];
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Full" Id="{53b8c3fd-110b-4c67-b4e2-17a8556ee413}">
      <Declaration><![CDATA[(*!
<summary>Reports whether fixed-capacity storage has no free slot.</summary>
<description>
Dynamic collections report FALSE even when Length equals Capacity. This does not guarantee available heap memory.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Full : BOOL]]></Declaration>
      <Get Name="Get" Id="{f12c1899-0fd5-49f4-ba5e-3d78e3119cee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Full := _StaticCapacity <> 0 AND_THEN _Length >= _StaticCapacity;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetGenericKeyPosition" Id="{fbc764d5-47dd-4dd0-9946-aee3ff7c213c}">
      <Declaration><![CDATA[(*!
<summary>Returns the matching entry position, or a negative value when absent.</summary>
<description>
The query is borrowed by default.
Explicit release requests disposal of owned query storage after lookup completes, including a
missing result.
Requested release is attempted after both successful lookup and lookup failure. Before cleanup, the original framework exception is retained and a borrowed static system exception is cloned to preserve its code, catch point and timestamps across cleanup callbacks. The captured exception is then propagated through ExceptionManager.Throw in the current cyclic task; native errors use the framework SystemException representation. If capturing the system exception fails with terminal OOM, query cleanup is still attempted and terminal OOM takes precedence. Terminal allocation state is never cleared. Release is best effort and does not prove successful deallocation. Cleanup callbacks must not reenter collection mutation.
Release resets only the local descriptor copy; the caller must have disposal rights and must not
reuse or release owning aliases afterwards.
Borrowed payload is not freed.
The position is a current storage slot with no sorted-rank guarantee; mutation may invalidate it.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL GetGenericKeyPosition : DINT
VAR_INPUT
	key : TOF_Core.GENERIC_VALUE;
	releaseKey : BOOL := FALSE;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	IF NOT FindKeyIndex(key, supposedIndex => GetGenericKeyPosition) THEN
		GetGenericKeyPosition := -1;
	END_IF
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(exceptionCode, NamespaceName, __POUNAME(), __POSITION());
__ENDTRY

IF releaseKey THEN
	IF caughtException <> 0 AND_THEN NOT caughtException.IsDynamicInstance THEN
		__TRY
			__QUERYINTERFACE(caughtException.Clone(), caughtException);
		__CATCH(exceptionCode)
			key.Release();

			TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
		__ENDTRY
	END_IF

	key.Release();
END_IF

IF caughtException <> 0 THEN
	TOF_Core.ExceptionManager.Throw(caughtException);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetKeyPosition" Id="{bf8491de-1d63-4391-a1d1-4fca0379c7f2}">
      <Declaration><![CDATA[(*!
<summary>Returns the matching storage position, or a negative value when absent.</summary>
<description>
The raw ANY argument is borrowed without cloning or ownership transfer. keyIsObject = TRUE requires
a live Object function-block instance, not a pointer or interface variable.
FALSE uses ordinary runtime type mapping.
The caller keeps the query storage alive for the call.
The position is a current storage slot with no sorted-rank guarantee; mutation may invalidate it.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="keyIsObject">Explicitly interprets the raw argument as a live Object instance.</param>
METHOD FINAL GetKeyPosition : DINT
VAR_INPUT
	key : ANY;
	keyIsObject : BOOL := FALSE;
END_VAR
VAR
	genericKey : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[genericKey := TOF_Core.GenericValueFactory.FromAnyType(key, keyIsObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);

IF NOT FindKeyIndex(genericKey, supposedIndex => GetKeyPosition) THEN
	GetKeyPosition := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetKeyValuePairByIndex" Id="{0291fd9f-109a-4434-bc5f-58af2ff03ea5}">
      <Declaration><![CDATA[(*!
<summary>Borrows the entry at a current storage position.</summary>
<description>
The index must be within Length and is not a sorted rank; otherwise an exception is raised.
The returned descriptor reference and payload remain collection-owned or borrowed from their
original owner.
Do not mutate the descriptor or dispose of its payload through this view.
Mutation or destruction may invalidate the reference.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL GetKeyValuePairByIndex : REFERENCE TO TOF_Core.GENERIC_KEY_VALUE_PAIR
VAR_INPUT
	index : DINT;
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < 0 OR_ELSE index >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index', index);
END_IF

GetKeyValuePairByIndex REF= _Array[index];]]></ST>
      </Implementation>
    </Method>
    <Property Name="KeyValidator" Id="{52c0707f-97df-4ed1-8258-5a683039419a}">
      <Declaration><![CDATA[(*!
<summary>Exposes the configured key validator.</summary>
<description>
Borrowed optional reference fixed at initialization. Zero means no validator. The collection does not own or release it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL KeyValidator : TOF_Core.IGenericValueValidator]]></Declaration>
      <Get Name="Get" Id="{8949dd5c-a7b6-4a91-8f61-a9e0809a5ba9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[KeyValidator := _KeyValidator;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Length" Id="{ccfee7c1-4417-440d-a786-d1356b8baab2}">
      <Declaration><![CDATA[(*!
<summary>Reports the number of stored entries.</summary>
<description>
Units are bytes for ByteList and entries for other collections. Existing positions range from zero through Length minus one.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Length : TOF_Core.DINT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{f9766b78-b24d-4be8-b437-f12592493950}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Length := _Length;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{45fa0035-e600-4ccb-b146-2204785bdabc}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace for diagnostics.</summary>
<description>
Borrowed read-only reference to compiler-initialized metadata; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b925d4d4-6228-46c6-8c9f-36930724e6b8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RebuildIndex" Id="{c8924d9e-dfa9-49f6-8af7-39afa616fca7}" FolderPath="Service members\">
      <Declaration><![CDATA[(*!
<summary>Rebuilds bucket chains from cached hashes after entry relocation or capacity changes.</summary>
<description>
Requires bound index storage for positive capacity and valid hashes for every live entry.
Does not allocate, access payload or invoke callbacks.
This only rebuilds links; it does not recompute hashes after equality-relevant payload or address
changes.
</description>
*)
METHOD PRIVATE RebuildIndex
VAR
	index : DINT;
	bucketIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Capacity = TOF_Core.SignedInt32.ZERO THEN
	RETURN;
END_IF

Tc2_System.MEMSET(_Buckets, 0, TO_UDINT(XSIZEOF(DINT) * TO_ULINT(Capacity)));
FOR index := 0 TO _Length - 1 DO
	bucketIndex := TO_DINT(_Hashes[index] MOD TO_UDINT(Capacity));
	_NextIndices[index] := _Buckets[bucketIndex];
	_Buckets[bucketIndex] := index + 1;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveAt" Id="{6ffe1d1b-7166-4447-9a30-c1b0e902f1f1}">
      <Declaration><![CDATA[(*!
<summary>Removes the entry at a current storage position.</summary>
<description>
The index must be within Length and is not a sorted rank.
Entries after the removed slot are compacted and bucket links rebuilt from cached hashes before
owned payload cleanup.
Index compaction and rebuilding invoke no equality/hash callbacks and allocate no storage.
Invalid indices raise an exception.
Positions and borrowed entry references may be invalidated.
Payload disposal is best effort through GENERIC_VALUE.Release.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL RemoveAt : IDictionary
VAR_INPUT
	index : DINT;
END_VAR
VAR
	argumentOutOfRangeException : TOF_Core.ArgumentOutOfRangeException;
	removedPair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < TOF_Core.SignedInt32.ZERO OR_ELSE index >= _Length THEN
	argumentOutOfRangeException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), 'index', index);
END_IF

RemoveAt := THIS^;
removedPair := _Array[index];

IF index < _Length - 1 THEN
	Tc2_System.MEMMOVE(ADR(_Array[index]), ADR(_Array[index + 1]), TO_UDINT(XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR) * TO_ULINT(_Length - index - 1)));
	Tc2_System.MEMMOVE(ADR(_Hashes[index]), ADR(_Hashes[index + 1]), TO_UDINT(XSIZEOF(UDINT) * TO_ULINT(_Length - index - 1)));
END_IF

_Array[_Length - 1].Key.Reset();
_Array[_Length - 1].Value.Reset();
_Length := _Length - 1;
RebuildIndex();

removedPair.Key.Release();
removedPair.Value.Release();]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{2f97742f-3611-48c7-bd16-2c4c86e43b99}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this function-block instance.</summary>
<description>
Measured in bytes; includes inline storage but excludes separately allocated buffers, payload and enumerators.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6d517caa-0175-488d-870c-e5bd38c78f1e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetCopy" Id="{de4fc0d3-020e-46c6-9a06-31b5ceb0b6d1}">
      <Declaration><![CDATA[(*!
<summary>Creates owned copies of a key and value and stores them through SetGeneric.</summary>
<description>
Original arguments remain borrowed.
Object copying requires the factory's ICloneable contract; byte copying is shallow.
Copies prepared by this call are released if copying the second argument or SetGeneric fails before
accepting ownership.
Cleanup does not release the original arguments.
Exceptions propagate after cleanup; terminal allocation state is not cleared.
The returned index is meaningful only on success.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="key">Source key storage, borrowed during copying.</param>
//!<param name="value">Source value storage, borrowed during copying.</param>
//!<param name="keyIsObject">Explicitly interprets the key as object storage.</param>
//!<param name="valueIsObject">Explicitly interprets the value as object storage.</param>
METHOD FINAL SetCopy : IDictionary
VAR_INPUT
	key : ANY;
	value : ANY;
	keyIsObject : BOOL := FALSE;
	valueIsObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	index : DINT;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	genericKeyValue : TOF_Core.GENERIC_VALUE;
	genericValueValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	genericKeyValue := TOF_Core.GenericValueFactory.FromAnyType(key, keyIsObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY);
	genericValueValue := TOF_Core.GenericValueFactory.FromAnyType(value, valueIsObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.CLONE_ORIGINAL_VALUE_AND_OWNS_MEMORY);

	SetCopy := SetGeneric(genericKeyValue, genericValueValue, index => index);
__CATCH(exceptionCode)
	genericKeyValue.Release();
	genericValueValue.Release();

	TOF_Core.ExceptionManager.ReThrowLastException(exceptionCode := exceptionCode, catchPointNamespaceName := NamespaceName, catchPointPOUName := __POUNAME(), catchPointPosition := __POSITION());
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetGeneric" Id="{94cffa05-38c9-49b3-9002-78aa4f07bd4c}">
      <Declaration><![CDATA[(*!
<summary>Stores a key-value pair, retaining the existing key when a matching entry is updated.</summary>
<description>
Uses the lifetime equality/hash strategy, with no ordering guarantee.
Empty descriptors are permitted unless rejected by a validator.
A successful call accepts owned arguments; borrowed payload must remain alive while stored.
Validation, lookup and growth occur before acceptance; failure before acceptance leaves incoming
ownership with the caller.
An unused owned incoming key and a displaced owned value are released after the new entry is
installed, unless their allocation is retained.
Reusing the same allocation preserves existing ownership or accepts incoming ownership; it never
returns ownership implicitly.
When key and value alias one allocation, the key descriptor holds the pair's disposal
responsibility.
Input descriptor copies are not reset in the caller: transferred owning aliases must not be released
or reused as owners.
Aliases must describe the same allocation with compatible disposal semantics; overlapping owned
ranges and ownership already held by another entry or owner are not supported.
Callbacks must not mutate or reenter this collection.
Cleanup is best effort through GENERIC_VALUE.Release and does not guarantee successful deallocation.
The index output is valid only on success.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="key">Incoming key descriptor; owned storage is transferred on success.</param>
//!<param name="value">Incoming value descriptor; owned storage is transferred on success.</param>
METHOD FINAL SetGeneric : IDictionary
VAR_INPUT
	key : TOF_Core.GENERIC_VALUE;
	value : TOF_Core.GENERIC_VALUE;
END_VAR
VAR_OUTPUT
	index : DINT;
END_VAR
VAR
	staticCollectionFullException : TOF_Core.StaticCollectionFullException;

	genericKeyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
	displacedValue : TOF_Core.GENERIC_VALUE;
	unusedKey : TOF_Core.GENERIC_VALUE;

	supposedIndex : DINT;
	hashCode : UDINT;
	bucketIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _KeyValidator <> 0 THEN
	_KeyValidator.Validate(GetName(), key);
END_IF

IF _ValueValidator <> 0 THEN
	_ValueValidator.Validate(GetName(), value);
END_IF

SetGeneric := THIS^;

genericKeyValuePair.Key := key;
genericKeyValuePair.Value := value;

IF FindKeyIndex(genericKeyValuePair.Key, supposedIndex => supposedIndex, hashCode => hashCode) THEN
	genericKeyValuePair.Key := _Array[supposedIndex].Key;
	displacedValue := _Array[supposedIndex].Value;
	unusedKey := key;

	IF displacedValue.IsMemoryOwner THEN
		IF displacedValue.Address = genericKeyValuePair.Key.Address THEN
			IF NOT genericKeyValuePair.Key.IsMemoryOwner THEN
				genericKeyValuePair.Key := TOF_Core.GenericValueFactory.FromParts(genericKeyValuePair.Key.TypeClass, genericKeyValuePair.Key.Address, genericKeyValuePair.Key.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY);
			END_IF

			displacedValue.Reset();
		ELSIF displacedValue.Address = genericKeyValuePair.Value.Address THEN
			IF NOT genericKeyValuePair.Value.IsMemoryOwner THEN
				genericKeyValuePair.Value := TOF_Core.GenericValueFactory.FromParts(genericKeyValuePair.Value.TypeClass, genericKeyValuePair.Value.Address, genericKeyValuePair.Value.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY);
			END_IF

			displacedValue.Reset();
		END_IF
	END_IF

	IF unusedKey.IsMemoryOwner THEN
		IF unusedKey.Address = genericKeyValuePair.Key.Address THEN
			IF NOT genericKeyValuePair.Key.IsMemoryOwner THEN
				genericKeyValuePair.Key := TOF_Core.GenericValueFactory.FromParts(genericKeyValuePair.Key.TypeClass, genericKeyValuePair.Key.Address, genericKeyValuePair.Key.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY);
			END_IF

			unusedKey.Reset();
		ELSIF unusedKey.Address = genericKeyValuePair.Value.Address THEN
			IF NOT genericKeyValuePair.Value.IsMemoryOwner THEN
				genericKeyValuePair.Value := TOF_Core.GenericValueFactory.FromParts(genericKeyValuePair.Value.TypeClass, genericKeyValuePair.Value.Address, genericKeyValuePair.Value.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY);
			END_IF

			unusedKey.Reset();
		ELSIF unusedKey.Address = displacedValue.Address AND_THEN displacedValue.IsMemoryOwner THEN
			unusedKey.Reset();
		END_IF
	END_IF
ELSE
	IF _Length >= Capacity THEN
		IF Dynamic THEN
			AllocateMemory(DefaultDynamicAllocationElementCount);
		ELSE
			staticCollectionFullException.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), GetName(), TO_UDINT(Capacity));
		END_IF
	END_IF
END_IF

IF genericKeyValuePair.Key.Address = genericKeyValuePair.Value.Address
	AND_THEN genericKeyValuePair.Value.IsMemoryOwner
THEN
	IF NOT genericKeyValuePair.Key.IsMemoryOwner THEN
		genericKeyValuePair.Key := TOF_Core.GenericValueFactory.FromParts(genericKeyValuePair.Key.TypeClass, genericKeyValuePair.Key.Address, genericKeyValuePair.Key.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY);
	END_IF

	genericKeyValuePair.Value := TOF_Core.GenericValueFactory.FromParts(genericKeyValuePair.Value.TypeClass, genericKeyValuePair.Value.Address, genericKeyValuePair.Value.Size, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
END_IF

_Array[supposedIndex] := genericKeyValuePair;

IF supposedIndex = _Length THEN
	_Hashes[supposedIndex] := hashCode;
	bucketIndex := TO_DINT(hashCode MOD TO_UDINT(Capacity));
	_NextIndices[supposedIndex] := _Buckets[bucketIndex];
	_Buckets[bucketIndex] := supposedIndex + 1;
	_Length := _Length + 1;
END_IF

displacedValue.Release();
unusedKey.Release();

index := supposedIndex;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetValueByGenericKey" Id="{91c4f97e-734f-49f0-8ee6-5d284893d86b}">
      <Declaration><![CDATA[(*!
<summary>Attempts to find a value by its key.</summary>
<description>
Returns TRUE when a value is found.
Use the output only on TRUE; no payload is cloned.
Catches exceptions without propagating them or clearing terminal allocation state.
Partial changes are not rolled back.
The query is borrowed by default.
When releaseKey is explicitly TRUE, attempts to release the supplied generic argument after
lookup/removal even on failure.
The caller must have disposal rights and must not reuse aliases of an owned argument after release.
A successful output is a borrowed descriptor copy; IsMemoryOwner does not transfer disposal rights
to the caller.
Stored payload must not be released through the output.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL TryGetValueByGenericKey : BOOL
VAR_INPUT
	key : TOF_Core.GENERIC_VALUE;
	releaseKey : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	TryGetValueByGenericKey := FindKeyIndex(key, supposedIndex => index);

	IF TryGetValueByGenericKey THEN
		value := _Array[index].Value;
	END_IF
__CATCH
	TryGetValueByGenericKey := FALSE;
__ENDTRY

IF releaseKey THEN
	__TRY
		key.Release();
	__CATCH
		TryGetValueByGenericKey := FALSE;
	__ENDTRY
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetValueByKey" Id="{b4d9a44b-a711-4e6d-854a-ec939d35bf59}">
      <Declaration><![CDATA[(*!
<summary>Attempts to find a value by its key.</summary>
<description>
Returns TRUE when a value is found.
Use the output only on TRUE; no payload is cloned.
Catches exceptions without propagating them or clearing terminal allocation state.
Partial changes are not rolled back.
The raw ANY argument is borrowed without cloning or ownership transfer. keyIsObject = TRUE requires
a live Object function-block instance, not a pointer or interface variable.
FALSE uses ordinary runtime type mapping.
The caller keeps the query storage alive for the call.
A successful output is a borrowed descriptor copy; IsMemoryOwner does not transfer disposal rights
to the caller.
Stored payload must not be released through the output.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="keyIsObject">Explicitly interprets the raw argument as a live Object instance.</param>
METHOD FINAL TryGetValueByKey : BOOL
VAR_INPUT
	key : ANY;
	keyIsObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	genericKey : TOF_Core.GENERIC_VALUE;
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	genericKey := TOF_Core.GenericValueFactory.FromAnyType(key, keyIsObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);

	TryGetValueByKey := FindKeyIndex(genericKey, supposedIndex => index);

	IF TryGetValueByKey THEN
		value := _Array[index].Value;
	END_IF
__CATCH
	TryGetValueByKey := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryRemoveByGenericKey" Id="{10b34f7a-b8be-47f1-a4a7-3163f5be0125}">
      <Declaration><![CDATA[(*!
<summary>Attempts to remove a matching entry.</summary>
<description>
Returns the collection for chaining. removed is TRUE only after the matching entry has been removed;
FALSE means no completed removal was reported.
Removal is not transactional and does not prove successful destruction of an owned payload.
Catches exceptions without propagating them or clearing terminal allocation state.
Partial changes are not rolled back.
The query is borrowed by default.
When releaseKey is explicitly TRUE, attempts to release the supplied generic argument after
lookup/removal even on failure.
The caller must have disposal rights and must not reuse aliases of an owned argument after release.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
METHOD FINAL TryRemoveByGenericKey : IDictionary
VAR_INPUT
	key : TOF_Core.GENERIC_VALUE;
	releaseKey : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	removed : BOOL;
END_VAR
VAR
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryRemoveByGenericKey := THIS^;
removed := FALSE;

__TRY
	IF FindKeyIndex(key, supposedIndex => index) THEN
		RemoveAt(index);
		removed := TRUE;
	END_IF
__CATCH
	removed := FALSE;
__ENDTRY

IF releaseKey THEN
	__TRY
		key.Release();
	__CATCH
		removed := FALSE;
	__ENDTRY
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryRemoveByKey" Id="{26dd05f9-9b20-404d-aa51-3d260ab46bbe}">
      <Declaration><![CDATA[(*!
<summary>Attempts to remove a matching entry.</summary>
<description>
Returns the collection for chaining. removed is TRUE only after the matching entry has been removed;
FALSE means no completed removal was reported.
Removal is not transactional and does not prove successful destruction of an owned payload.
Catches exceptions without propagating them or clearing terminal allocation state.
Partial changes are not rolled back.
The raw ANY argument is borrowed without cloning or ownership transfer. keyIsObject = TRUE requires
a live Object function-block instance, not a pointer or interface variable.
FALSE uses ordinary runtime type mapping.
The caller keeps the query storage alive for the call.
 Descendants cannot override this storage operation; capacity, indexing and disposal remain governed by this collection implementation.</description>
*)
//!<param name="keyIsObject">Explicitly interprets the raw argument as a live Object instance.</param>
METHOD FINAL TryRemoveByKey : IDictionary
VAR_INPUT
	key : ANY;
	keyIsObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	removed : BOOL;
END_VAR
VAR
	genericKey : TOF_Core.GENERIC_VALUE;
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryRemoveByKey := THIS^;
removed := FALSE;

__TRY
	genericKey := TOF_Core.GenericValueFactory.FromAnyType(key, keyIsObject, TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);

	IF FindKeyIndex(genericKey, supposedIndex => index) THEN
		RemoveAt(index);
		removed := TRUE;
	END_IF
__CATCH
	removed := FALSE;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="ValueValidator" Id="{831db6d3-dee8-4415-ad30-71b123ae4207}">
      <Declaration><![CDATA[(*!
<summary>Exposes the configured value validator.</summary>
<description>
Borrowed optional reference fixed at initialization. Zero means no validator. The collection does not own or release it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ValueValidator : TOF_Core.IGenericValueValidator]]></Declaration>
      <Get Name="Get" Id="{52469eaf-8f30-472d-88de-bba617044269}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ValueValidator := _ValueValidator;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>