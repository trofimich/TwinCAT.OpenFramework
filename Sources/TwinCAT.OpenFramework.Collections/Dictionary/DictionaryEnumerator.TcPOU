<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DictionaryEnumerator" Id="{2f365963-7036-4f79-8584-bc80ea1e769d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Enumerates the current storage slots of a Dictionary.</summary>
<description>
The source is borrowed and must outlive the cursor.
Enumeration has no guaranteed ordering.
Do not mutate the source during traversal.
Current is a borrowed view and must not be released or modified as an owning descriptor; it is
invalidated by cursor advancement/reset or source mutation.
The caller owns and explicitly releases a dynamically created cursor.
MoveNext stops advancing at the end position of an unchanged source; repeated exhausted calls return FALSE until Reset.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK DictionaryEnumerator EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IEnumerator
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	{attribute 'hide'} 
	_Dictionary : IReadOnlyDictionary;
	{attribute 'hide'} 
	_CurrentIndex : DINT := -1;
	
	{attribute 'hide'} 
	_GenericKeyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
	{attribute 'hide'} 
	_GenericValue : TOF_Core.GENERIC_VALUE;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{839d6121-03b1-4336-9ccf-f78a04cd0cb5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e0aa9b3a-9a64-4398-b874-5ed4b802f8a8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Current" Id="{9d7a3084-f2d9-46a4-babc-c0d4307e4c92}">
      <Declaration><![CDATA[(*!
<summary>Exposes a read-only borrowed view of the current entry.</summary>
<description>
Reading Current before the first successful MoveNext, after Reset or after exhaustion yields an empty descriptor. Otherwise payload is borrowed, with no disposal rights. Do not modify or release the descriptor. The view may change on subsequent property access, cursor movement or source mutation. The outer USER_DEFINED value points to cursor-local GENERIC_KEY_VALUE_PAIR storage; nested descriptors borrow collection payload.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Current : REFERENCE TO TOF_Core.GENERIC_VALUE]]></Declaration>
      <Get Name="Get" Id="{f0a9af6e-a818-4733-9637-b26e3a47ceb1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentIndex >= 0 AND_THEN _CurrentIndex < _Dictionary.Length THEN
	_GenericKeyValuePair := _Dictionary.GetKeyValuePairByIndex(_CurrentIndex); 
	_GenericValue := TOF_Core.GenericValueFactory.FromParts(TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED, ADR(_GenericKeyValuePair), SIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR), TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY);
ELSE
	_GenericValue.Reset();
END_IF 

Current REF= _GenericValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CurrentKeyValuePair" Id="{a11fa9ca-d7fd-47e7-8c94-382211eba30f}">
      <Declaration><![CDATA[(*!
<summary>Returns the current entry in its concrete representation.</summary>
<description>
Use only after MoveNext returns TRUE and before the next cursor or source change. No result is promised outside a valid position. Nested descriptors borrow payload; their owner flags do not transfer disposal rights.
</description>
*)
PROPERTY FINAL CurrentKeyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR]]></Declaration>
      <Get Name="Get" Id="{587ce946-29e3-488a-a34c-6505b64fa177}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _CurrentIndex >= 0 AND_THEN _CurrentIndex < _Dictionary.Length THEN
	CurrentKeyValuePair := _Dictionary.GetKeyValuePairByIndex(_CurrentIndex); 
END_IF ]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{5f1ac79b-7b16-408a-a050-ca6526d9c743}">
      <Declaration><![CDATA[(*!
<summary>Binds the borrowed source for enumeration.</summary>
<description>
The source must be non-null and outlive the cursor. Only the reference is assigned; no allocation, callbacks or throwing validation are performed.
</description>
*)
//!<param name="bInitRetains">if TRUE, the retain variables are initialized (warm start / cold start)</param>

//!<param name="bInCopyCode">if TRUE, the instance afterwards gets moved into the copy code (online change)</param>

METHOD FB_init : BOOL
VAR_INPUT
	
	bInitRetains	: BOOL;
	
	bInCopyCode	: BOOL;
	dictionary : IReadOnlyDictionary;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Dictionary := dictionary;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveNext" Id="{a3b96f77-158c-4502-97c9-c508c77c0dd2}">
      <Declaration><![CDATA[(*!
<summary>Advances the cursor to the next source position.</summary>
<description>
The source must be live, non-null and structurally unchanged during traversal. TRUE identifies a current entry. The index advances only while below source Length and stops at the end position. Repeated exhausted calls return FALSE without incrementing the index; reading Current yields an empty descriptor. Reset allows traversal from the beginning again. No snapshot or mutation detection is provided.
</description>
*)
{attribute "object_name" := "MoveNext"}
METHOD FINAL MoveNext : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _CurrentIndex < _Dictionary.Length THEN
	_CurrentIndex := _CurrentIndex + 1;
END_IF

MoveNext := _CurrentIndex < _Dictionary.Length;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{2825246a-435d-4d7f-beb7-b17a1356bf70}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace for diagnostics.</summary>
<description>
Borrowed read-only reference to compiler-initialized metadata; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{88723d2e-40ed-4daf-8b32-5e90b0fb1460}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{ffc13050-106a-4a43-ad03-55630a53602f}">
      <Declaration><![CDATA[(*!
<summary>Places the cursor before the first source entry.</summary>
<description>
The next MoveNext starts at zero. Does not modify the source or release payload; reading Current now yields an empty descriptor.
 Descendants cannot override this cursor operation; advancement, reset and borrowed current views use the same cursor state.</description>
*)
{attribute "object_name" := "Reset"}
METHOD FINAL Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CurrentIndex := -1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{1db19b22-0572-4a68-948e-fa84d0bb1deb}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this function-block instance.</summary>
<description>
Measured in bytes; includes inline storage but excludes separately allocated buffers, payload and enumerators.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ee09e011-6acd-46b1-94f4-d278acd0fb55}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>