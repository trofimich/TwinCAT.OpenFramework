<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="ICollection" Id="{88466dc8-666c-4063-b375-dbc726fa5d68}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides collection size, capacity and enumeration.</summary>
<description>
Does not transfer ownership of the collection. CreateEnumerator follows IEnumerable: the caller owns the dynamic cursor and keeps the source alive. Full describes fixed-capacity exhaustion, not heap availability. No synchronization or snapshot guarantee is supplied by this interface.
</description>
*)

INTERFACE ICollection EXTENDS TOF_Core.IEnumerable]]></Declaration>
    <Property Name="Capacity" Id="{56b307d1-ec01-41de-a52d-e2ddce80689b}">
      <Declaration><![CDATA[(*!
<summary>Reports the currently allocated number of slots.</summary>
<description>
Units are bytes for ByteList and entries for other collections. Static capacity is fixed; dynamic capacity can change on growth or clearing. This is not a guarantee that the next allocation succeeds.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Capacity : TOF_Core.DINT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{b9b2523a-170b-48ec-8fab-7905ca7bf501}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Dynamic" Id="{33e6a1c2-e912-4eca-9a59-f13dc9912415}">
      <Declaration><![CDATA[(*!
<summary>Reports whether storage can grow dynamically.</summary>
<description>
Static capacity zero selects dynamic storage. Dynamic collections can still fail to allocate.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Dynamic : BOOL]]></Declaration>
      <Get Name="Get" Id="{98e31b22-daaf-483c-87d1-6db7ee0d6f5d}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Empty" Id="{02e68302-3095-475a-b7b9-21345376de43}">
      <Declaration><![CDATA[(*!
<summary>Reports whether the collection has no entries.</summary>
<description>
Reflects Length; not a check of payload lifetime or memory health.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Empty : BOOL]]></Declaration>
      <Get Name="Get" Id="{eb18a4bf-0cab-414a-a650-1f395537e584}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Full" Id="{b66def3d-f2b2-481d-bd94-8b72d2315bd7}">
      <Declaration><![CDATA[(*!
<summary>Reports whether fixed-capacity storage has no free slot.</summary>
<description>
Dynamic collections report FALSE even when Length equals Capacity. This does not guarantee available heap memory.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Full : BOOL]]></Declaration>
      <Get Name="Get" Id="{c62c8187-8a30-4190-8d73-9b81a0882685}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
    <Property Name="Length" Id="{e9a44572-350f-40ad-8ef9-8514a88899ac}">
      <Declaration><![CDATA[(*!
<summary>Reports the number of stored entries.</summary>
<description>
Units are bytes for ByteList and entries for other collections. Existing positions range from zero through Length minus one.
</description>
*)
{attribute 'OPC.UA.DA.Property' := '1'}
{attribute 'monitoring' := 'call'}
PROPERTY Length : TOF_Core.DINT_LENGTH]]></Declaration>
      <Get Name="Get" Id="{5ddd92df-6da5-4999-92aa-172cf2503033}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>