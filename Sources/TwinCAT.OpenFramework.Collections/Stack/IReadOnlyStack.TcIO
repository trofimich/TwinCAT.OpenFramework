<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IReadOnlyStack" Id="{94cbf4d1-33a1-402f-b2f4-27b023013cf8}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides LIFO top inspection, indexed access and membership queries.</summary>
<description>
Returned descriptors and payload are borrowed, not clones. Do not modify descriptor metadata or release payload through this view, even when IsMemoryOwner is TRUE. Keep the source and borrowed storage alive; mutation or destruction can invalidate the view. ContainsGeneric currently defaults to releasing an owned query.
</description>
*)

INTERFACE IReadOnlyStack EXTENDS ICollection]]></Declaration>
    <Method Name="Contains" Id="{1450cb08-2792-4975-b817-1cc492c16cdf}">
      <Declaration><![CDATA[(*!
<summary>Searches for a value using default generic equality.</summary>
<description>
Borrows the ANY argument during a linear search without cloning or releasing it. isObject = TRUE means a live Object FB instance, not a pointer or interface variable. Equality exceptions propagate; callbacks that mutate the collection can invalidate traversal.
</description>
*)
METHOD Contains : BOOL
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ContainsGeneric" Id="{e97ca595-c012-4f3f-b7d3-7bd90a82369d}">
      <Declaration><![CDATA[(*!
<summary>Searches for an equal generic value and optionally releases the query.</summary>
<description>
Uses GENERIC_VALUE.Equals in a linear search. releaseValue defaults to TRUE: after a completed search, Release is called on the local query copy, including on a miss. Caller-side aliases are not reset. The query must not own storage retained by the collection. Requested release is attempted after both successful lookup and lookup failure. Before cleanup, the original framework exception is retained and a borrowed static system exception is cloned to preserve its code, catch point and timestamps across cleanup callbacks. The captured exception is then propagated through ExceptionManager.Throw in the current cyclic task; native errors use the framework SystemException representation. If capturing the system exception fails with terminal OOM, query cleanup is still attempted and terminal OOM takes precedence. Terminal allocation state is never cleared. Release is best effort and does not prove successful deallocation. Cleanup callbacks must not reenter collection mutation.
</description>
*)
METHOD ContainsGeneric : BOOL
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
	releaseValue : BOOL := TRUE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="GetByIndex" Id="{5ec4c288-9eb7-4b5c-a0ce-4c22e147a86a}">
      <Declaration><![CDATA[(*!
<summary>Borrows the descriptor at a zero-based stack position.</summary>
<description>
Position zero is the top; increasing indices move toward the bottom. An out-of-range index raises an exception. Returned descriptors and payload are borrowed, not clones. Do not modify descriptor metadata or release payload through this view, even when IsMemoryOwner is TRUE. Keep the source and borrowed storage alive; mutation or destruction can invalidate the view.
</description>
*)
METHOD GetByIndex : REFERENCE TO TOF_Core.GENERIC_VALUE
VAR_INPUT
	index : TOF_Core.DINT_INDEX;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="Peek" Id="{449b17e3-c2c8-4388-a70d-0d34c2a0654c}">
      <Declaration><![CDATA[(*!
<summary>Borrows the LIFO top without removing it.</summary>
<description>
An empty stack raises CollectionEmptyException. Returned descriptors and payload are borrowed, not clones. Do not modify descriptor metadata or release payload through this view, even when IsMemoryOwner is TRUE. Keep the source and borrowed storage alive; mutation or destruction can invalidate the view.
</description>
*)
METHOD Peek : REFERENCE TO TOF_Core.GENERIC_VALUE]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>