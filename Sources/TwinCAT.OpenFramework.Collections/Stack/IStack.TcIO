<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IStack" Id="{3a9eb651-9ae6-484a-a55d-6a5fe610d480}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides LIFO insertion and destructive top removal.</summary>
<description>
Successful insertion transfers disposal responsibility for owned payload; borrowed payload must remain alive while stored. The caller-side descriptor copy is not reset and must not be released again after transfer. Independent owning aliases and overlapping owned allocations are unsupported. Peek borrows the top; RemoveLast releases it rather than transferring it to the caller. Clear releases owned payload and dynamic backing storage.
</description>
*)

INTERFACE IStack EXTENDS IReadOnlyStack]]></Declaration>
    <Method Name="Clear" Id="{ccafc413-425f-4936-ab3b-6dea587d82eb}">
      <Declaration><![CDATA[(*!
<summary>Removes all entries and releases dynamic backing storage.</summary>
<description>
Owned payload is released best effort through GENERIC_VALUE.Release; borrowed storage is not freed. Static capacity and the borrowed validator are retained. Dynamic capacity becomes zero. Returns this collection and invalidates positions and views. Cleanup callbacks must not reenter mutation.
</description>
*)
METHOD Clear : IStack]]></Declaration>
    </Method>
    <Method Name="PushCopy" Id="{098e52d5-407a-4f5d-a071-ef32736a569c}">
      <Declaration><![CDATA[(*!
<summary>Copies a value and appends it to the stack top.</summary>
<description>
Borrows the original during the call. isObject = TRUE requires a live Object FB instance implementing ICloneable; other data is copied as bytes without recursively cloning references. A prepared copy is released if insertion fails before acceptance; exceptions propagate. Engine-managed exception objects are unsupported.
</description>
*)
METHOD PushCopy : IStack
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="PushGeneric" Id="{7c0a4fbf-2989-46c0-bcc9-ee65e124e937}">
      <Declaration><![CDATA[(*!
<summary>Pushes a descriptor onto the stack top.</summary>
<description>
Successful insertion transfers disposal responsibility for owned payload; borrowed payload must remain alive while stored. The caller-side descriptor copy is not reset and must not be released again after transfer. Independent owning aliases and overlapping owned allocations are unsupported. Full static storage raises an exception. A configured validator is invoked once before any capacity growth or ownership acceptance. Validation failure leaves the buffer, Length and incoming ownership unchanged; its exception propagates. Validator callbacks must not mutate this collection.
</description>
*)
METHOD PushGeneric : IStack
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="RemoveLast" Id="{b76215e8-4e44-4efc-964d-e51e9e2b47cc}">
      <Declaration><![CDATA[(*!
<summary>Removes the LIFO top without transferring it to the caller.</summary>
<description>
An empty stack raises CollectionEmptyException. Owned top storage is released best effort, not returned to the caller. Remaining descriptors are not moved; removal takes constant time apart from payload cleanup. Returns this stack; positions and views may change. Cleanup callbacks must not reenter mutation.
</description>
*)
METHOD RemoveLast : IStack]]></Declaration>
    </Method>
    <Property Name="ValueValidator" Id="{c5bf078b-d770-4b61-b1d8-7bb95e746685}">
      <Declaration><![CDATA[(*!
<summary>Exposes the configured value validator.</summary>
<description>
Borrowed optional reference fixed at initialization. Zero means no validator. The collection does not own or release it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ValueValidator : TOF_Core.IGenericValueValidator]]></Declaration>
      <Get Name="Get" Id="{a3b81f16-2608-466f-a4dd-f3ff3c0c7f09}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>