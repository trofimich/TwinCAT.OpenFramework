<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IUniqueDataSet" Id="{f9f012c7-8793-47aa-8dd0-be7334854f04}">
    <Declaration><![CDATA[(*!
<summary>Stores unique generic values.</summary>
<description>
SetGeneric replaces a matching entry with the incoming descriptor.
SetGeneric preserves disposal responsibility when the same allocation is reused; transferred
caller-side owning aliases must not be released again.
Try lookup/removal operations contain exceptions without rolling back partial effects.
Generic query arguments are borrowed by default.
Explicitly requested release in Try operations is attempted even after lookup failure; caller-side
owning aliases are not reset.
Lookup uses one equality/hash strategy fixed for the collection lifetime; zero selects GENERIC_VALUE
default equality and hashing.
A custom comparer is borrowed, stays alive and retains stable equality-relevant configuration.
Empty descriptors are supported unless rejected by a validator.
No entry or enumeration order is guaranteed; a position is a current storage slot, not a sorted
rank.
Do not modify stored descriptors through returned references.
Borrowed elements, including OBJECT instances, stay alive while stored and remain caller-owned.
Owned payload must not be deleted through external aliases.
Keep equality/hash-relevant data and comparer configuration stable; remove before changing them,
then insert again.
Fields unrelated to equality/hash may change.
Callbacks must not mutate elements or reenter collection mutation.
Explicit query release must not dispose of retained storage.
Default OBJECT lookup delegates to Object.Equals/GetHashCode; Clone has its own identity.
Discard and populate the index again after equality-relevant address relocation before further
lookup.
</description>
*)
(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

INTERFACE IUniqueDataSet EXTENDS IReadOnlyUniqueDataSet]]></Declaration>
    <Method Name="Clear" Id="{ddce01fd-5f04-4aef-87c8-ac49cf8b71f7}">
      <Declaration><![CDATA[(*!
<summary>Removes all entries and releases owned payload.</summary>
<description>
Disposal is best effort.
Dynamic entry and index storage are released; static capacity and lifetime comparer/validators are
retained.
References, positions and active enumeration are invalidated.
Cleanup callbacks must not reenter mutation.
</description>
*)
METHOD Clear : IUniqueDataSet]]></Declaration>
    </Method>
    <Method Name="RemoveAt" Id="{71a2af55-d19f-482e-bf37-654e8a1f9098}">
      <Declaration><![CDATA[(*!
<summary>Removes the entry at a current storage position.</summary>
<description>
The index must be within Length and is not a sorted rank.
Removal invalidates positions and references as entries are compacted; owned payload disposal is
best effort.
Invalid indices raise an exception.
</description>
*)
METHOD RemoveAt : IUniqueDataSet
VAR_INPUT
	index : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="SetCopy" Id="{60af6d45-3064-4e73-ba49-58ce69244884}">
      <Declaration><![CDATA[(*!
<summary>Copies a value and stores it through SetGeneric.</summary>
<description>
Borrows the original during the call. isObject = TRUE requires a live Object FB instance implementing ICloneable; other data is copied as bytes without recursively cloning references. A prepared copy is released if insertion fails before acceptance; exceptions propagate. Engine-managed exception objects are unsupported. Any index output is meaningful only on success.
</description>
*)
METHOD SetCopy : IUniqueDataSet
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	index : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="SetGeneric" Id="{ecbdd0eb-8919-4b32-8f19-f2322b1a580a}">
      <Declaration><![CDATA[(*!
<summary>Inserts a value or replaces the matching entry with the incoming descriptor.</summary>
<description>
Uses the lifetime equality/hash strategy, with no ordering guarantee.
Empty descriptors are permitted unless rejected by a validator.
A successful call accepts incoming owned storage; borrowed payload must remain alive while stored.
Validation, lookup and growth precede acceptance; failure before acceptance leaves ownership with
the caller.
A displaced owned allocation is released after replacement.
Reusing the same allocation does not release it and preserves existing ownership or accepts incoming
ownership, without implicitly returning ownership to the caller.
Caller-side descriptor copies are not reset; transferred owning aliases must not be released or
reused as owners.
Aliases must have compatible disposal semantics; overlapping owned ranges and ownership already held
by another entry or owner are not supported.
Callbacks must not mutate or reenter this collection.
Cleanup through GENERIC_VALUE.Release is best effort and does not guarantee deallocation.
The index output is valid only on success.
</description>
*)
//!<param name="value">Incoming descriptor; owned storage is transferred on success.</param>
METHOD SetGeneric : IUniqueDataSet
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR
VAR_OUTPUT
	index : DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="TryRemove" Id="{73753b11-50c4-4d9c-983d-8174d1faeadd}">
      <Declaration><![CDATA[(*!
<summary>Attempts to remove a matching entry.</summary>
<description>
Returns the collection for chaining. removed is TRUE only after the matching entry has been removed;
FALSE means no completed removal was reported.
Removal is not transactional and does not prove successful destruction of an owned payload.
Catches exceptions without propagating them or clearing terminal allocation state.
Partial changes are not rolled back.
The raw ANY argument is borrowed without cloning or ownership transfer. isObject = TRUE requires a
live Object function-block instance, not a pointer or interface variable.
FALSE uses ordinary runtime type mapping.
The caller keeps the query storage alive for the call.
</description>
*)
//!<param name="isObject">Explicitly interprets the raw argument as a live Object instance.</param>
METHOD TryRemove : IUniqueDataSet
VAR_INPUT
	value : ANY;
	isObject : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	removed : BOOL;
END_VAR]]></Declaration>
    </Method>
    <Method Name="TryRemoveGeneric" Id="{0059fbed-a0d6-474f-b407-bda925a1c57f}">
      <Declaration><![CDATA[(*!
<summary>Attempts to remove a matching entry.</summary>
<description>
Returns the collection for chaining. removed is TRUE only after the matching entry has been removed;
FALSE means no completed removal was reported.
Removal is not transactional and does not prove successful destruction of an owned payload.
Catches exceptions without propagating them or clearing terminal allocation state.
Partial changes are not rolled back.
The query is borrowed by default.
When releaseValue is explicitly TRUE, attempts to release the supplied generic argument after
lookup/removal even on failure.
The caller must have disposal rights and must not reuse aliases of an owned argument after release.
</description>
*)
METHOD TryRemoveGeneric : IUniqueDataSet
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
	releaseValue : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	removed : BOOL;
END_VAR]]></Declaration>
    </Method>
    <Property Name="ValueValidator" Id="{ebfadc3c-2e56-43d6-ac43-43033e432180}">
      <Declaration><![CDATA[(*!
<summary>Exposes the configured value validator.</summary>
<description>
Borrowed optional reference fixed at initialization. Zero means no validator. The collection does not own or release it.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ValueValidator : TOF_Core.IGenericValueValidator]]></Declaration>
      <Get Name="Get" Id="{8b8435a3-9bad-48d9-b433-8a1776785693}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>