(*!
<summary>Runs the OpenFramework test tree and the independent runner contract suite.</summary>
<description>
RepeatMainTestsRequest rearms the main tree on the controller task after a completed run. The same test instances
run again and the independent runner contract suite keeps its result. For ADS, start from a fresh application
initialization and leave the repeat request unset while reading the result. The main runner logs to ADS and
retains JUnit XML for a completed run. Instances must not be copied because their test fixtures and reporter
contain non-copyable state.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TestAutomationController EXTENDS TOF_Automation.AutomationController<0>
VAR_INPUT
	(*!
	<summary>Requests one repeat of the main test tree from TwinCAT Watch.</summary>
	<description>
	Write TRUE once after the main runner reports its totals. The controller clears the request on its next working
	cycle. Requests before completion or after a runner abort are discarded. Do not force this input.
	</description>
	*)
	RepeatMainTestsRequest : BOOL;
END_VAR
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	//! <summary>Checks the testing framework with a separate driver and independent expectations.</summary>
	_TestRunnerTest : TestRunnerContractTest;

	//! <summary>Owns the I/O symbols and the fixture borrowed by the test runner.</summary>
	_IOModelsTest : IOModelsTestFixture;
	
	//! <summary>Runs the general OpenFramework.Testing regression suites.</summary>
	_JsonConfigurationRunner : JsonConfigurationTestRunner(ioModelsFixture := _IOModelsTest);

	//! <summary>Owns the ADS summary and JUnit document for the main runner.</summary>
	_MainTestReporter : MainTestReporter;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{808e2bb2-4cf4-4bed-af77-c4b90dfaf272}">
      <Declaration><![CDATA[PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{68e5d592-b357-4d3f-a459-568d988331ee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{9a23e807-4502-4ff5-a340-bb5707bed577}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{48e70ac4-e138-48c7-8d5b-78bb20caab4a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{9ca5477b-09fe-4c45-990a-565a2307423e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c5c86d10-aae1-44b0-b97e-fba9982acf76}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TestsFinished" Id="{cfd506fc-fda1-47ad-a0b3-d40c3424c589}">
      <Declaration><![CDATA[(*!
<summary>Reports whether both suites have a final result.</summary>
<description>TRUE includes failed scenarios and an aborted main run.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY TestsFinished : BOOL]]></Declaration>
      <Get Name="Get" Id="{b8c11147-9db6-4eac-90ab-bf9e58a1d549}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[TestsFinished := _JsonConfigurationRunner.IsFinished AND_THEN _TestRunnerTest.IsFinished;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MainTestExitCode" Id="{b0ea1a65-3ec0-40f0-a3fd-c0bbc8815d14}">
      <Declaration><![CDATA[(*!
<summary>Reports the main suite failed test count or -1 if the run aborted.</summary>
<description>Read after TestsFinished is TRUE.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY MainTestExitCode : DINT]]></Declaration>
      <Get Name="Get" Id="{fb6254d5-f1f8-485b-bc82-283d35937dc2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[MainTestExitCode := _JsonConfigurationRunner.ExitCode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ContractTestFailures" Id="{abdf4799-d135-4a69-a041-3598c376eac2}">
      <Declaration><![CDATA[(*!
<summary>Reports how many independent contract scenarios failed.</summary>
<description>Read after TestsFinished is TRUE.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ContractTestFailures : DINT]]></Declaration>
      <Get Name="Get" Id="{400fd0e4-e384-483d-940f-45fc8731641d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ContractTestFailures := _TestRunnerTest.FailedTests;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MainTestDiagnostic" Id="{e1acc9c0-1aa9-44c2-8667-9983682a0cbd}">
      <Declaration><![CDATA[(*!
<summary>Returns the main suite abort diagnostic or the ADS failure summary.</summary>
<description>Empty until a main suite failure or abort is reported.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY MainTestDiagnostic : TOF_Core.ERROR_MESSAGE]]></Declaration>
      <Get Name="Get" Id="{4333241b-722e-46df-a84b-be4f0307edaf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT _JsonConfigurationRunner.IsFinished THEN
	RETURN;
END_IF

IF _JsonConfigurationRunner.ExitCode < TOF_Core.SignedInt32.ZERO THEN
	MainTestDiagnostic := _JsonConfigurationRunner.CallbackMessage;
ELSIF _JsonConfigurationRunner.ExitCode > TOF_Core.SignedInt32.ZERO THEN
	MainTestDiagnostic := _MainTestReporter.LastRunSummary;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ContractTestDiagnostic" Id="{e46ea294-30c3-401e-81f3-46511942909e}">
      <Declaration><![CDATA[(*!
<summary>Returns the first failed independent contract scenario and its diagnostic.</summary>
<description>Empty until the suite finishes with a failure.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ContractTestDiagnostic : STRING(255)]]></Declaration>
      <Get Name="Get" Id="{09e2865d-8be2-484d-a7c1-79c87ee37ea7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _TestRunnerTest.IsFinished THEN
	ContractTestDiagnostic := _TestRunnerTest.FirstFailureMessage;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MainJUnitContentLength" Id="{45be1050-d24a-4360-b562-71ace89f6054}">
      <Declaration><![CDATA[(*!
<summary>Reports the main JUnit document's byte count without its terminating zero.</summary>
<description>
Read after TestsFinished. A zero result means there is no completed document for the current main run.
Read the chunks before a repeat request or application reset.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY MainJUnitContentLength : UDINT]]></Declaration>
      <Get Name="Get" Id="{2671e409-f3ab-42b0-9704-14ac5b9f4c64}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _JsonConfigurationRunner.IsFinished
	AND_THEN _JsonConfigurationRunner.ExitCode >= TOF_Core.SignedInt32.ZERO
THEN
	MainJUnitContentLength := _MainTestReporter.JUnitContentLength;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReadMainJUnitChunk" Id="{d51dcf79-96ea-423a-bfb3-e17eff77b6c1}">
      <Declaration><![CDATA[(*!
<summary>Returns up to 1023 bytes of the completed main JUnit document to the ADS client.</summary>
<description>
Read after TestsFinished and before a repeat or application reset. Returns an empty string if no current
document is ready or the offset is outside it. Chunk copies use PLC memory and return ASCII text to ADS.
</description>
<param name="offset">Zero-based byte offset in the document.</param>
*)
{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC ReadMainJUnitChunk : STRING(1023)
VAR_INPUT
	offset : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReadMainJUnitChunk := '';

IF offset < MainJUnitContentLength THEN
	ReadMainJUnitChunk := _MainTestReporter.ReadJUnitChunk(offset := offset);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenInitializing" Id="{7eb0201c-467e-450b-88ec-fbe32ba9c9b2}">
      <Declaration><![CDATA[(*!
<summary>Attaches the controller-owned reporter before the main runner starts.</summary>
<description>Returns TRUE after configuring the idle runner, whose first Execute follows initialization.</description>
*)
METHOD PROTECTED OnAfterChildrenInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_JsonConfigurationRunner.Reporter := _MainTestReporter;
OnAfterChildrenInitializing := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeChildrenWorking" Id="{f0394797-3eeb-44c9-847b-75920f0bbead}">
      <Declaration><![CDATA[(*!
<summary>Advances filesystem test-root preparation, the independent contract suite, and the general test tree.</summary>
<description>
One controller task owns FileTestRoot. Suites observe its readiness instead of issuing competing root-create
requests. The independent suite has its own assertions and result reporting. AutomationRunner cleans task
memory after both test paths. Keep calling the controller so root and scenario cleanup can finish.
Consumes the repeat request before advancing the main runner and keeps the existing test instances.
</description>
*)
METHOD PROTECTED OnBeforeChildrenWorking
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	lastExMessage : TOF_Core.ERROR_MESSAGE;
	logMessage : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FileTestRoot.Execute();
_TestRunnerTest.Execute();

__TRY
	IF RepeatMainTestsRequest THEN
		RepeatMainTestsRequest := FALSE;

		IF _JsonConfigurationRunner.IsFinished
			AND_THEN _JsonConfigurationRunner.ExitCode >= TOF_Core.SignedInt32.ZERO
		THEN
			_JsonConfigurationRunner.Reset();
		END_IF
	END_IF

	_JsonConfigurationRunner.Execute(cleanupTaskMemory := FALSE);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	lastExMessage := exception.GetMessage(
		showSource := TRUE,
		timestampDisplayMode := TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL
	);
	logMessage := TO_STRING(lastExMessage);

	Tc2_System.ADSLOGSTR(
		msgCtrlMask := Tc2_System.Global_Variables.ADSLOG_MSGTYPE_ERROR,
		msgFmtStr := 'CRITICAL: _JsonConfigurationRunner threw: %s',
		strArg := logMessage
	);

	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{f40e5ad6-7a53-4a63-913b-db682a7c26c5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b6cba390-e08d-46b6-8503-4a7f2b18b1a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StartRequest" Id="{51469ead-ef1f-4035-91bd-fc88dd6dc76f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY StartRequest : BOOL]]></Declaration>
      <Get Name="Get" Id="{85844015-c398-4fea-800c-924fcc442941}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StartRequest := TRUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
