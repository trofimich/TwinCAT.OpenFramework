<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="LogFilter" Id="{a3a9bf30-d5a5-47cf-b4ee-55ca6a681ea6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
