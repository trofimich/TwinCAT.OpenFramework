(*!
<summary>Suppresses test log output and optionally simulates reuse of a native diagnostic during logging.</summary>
<description>Probe state belongs to the calling cyclic task. The filter never retains the borrowed exception.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LogFilter EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.ILogFilter
VAR
	_SecondaryExceptionPending : ARRAY [1..TOF_Core.System.TASK_COUNT] OF BOOL;
	_AllowProbedLog : ARRAY [1..TOF_Core.System.TASK_COUNT] OF BOOL;
END_VAR
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{cae48fd3-c4fa-4ca2-868f-5de6218356a4}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0975c72d-6209-4578-829a-a4591272bc5e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{68024585-ccb0-40a1-b903-f0eeb9d6b824}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2aec628d-2163-4d74-b6e4-af288f4660b2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{85c32638-abaa-4f8a-acf0-0653e4aebcdd}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8e3c09a4-76e1-4529-a461-2e5e2464bde1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ShouldLog" Id="{32b9de1c-02d2-47a5-837f-c1e69ba1998b}">
      <Declaration><![CDATA[(*!
<summary>Suppresses log entries by default and exercises an optional one-shot native diagnostic probe.</summary>
<description>The armed probe overwrites the task wrapper and returns the selection specified when armed.</description>
*)
METHOD ShouldLog : BOOL
VAR_IN_OUT CONSTANT
	category : TOF_Core.LOG_CATEGORY;
	topics : ARRAY [*] OF WSTRING;		
END_VAR
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ShouldLog := FALSE;
taskIndex := TOF_Core.System.GetCurrentTaskIndex();

IF taskIndex >= 1
	AND_THEN taskIndex <= TOF_Core.System.TASK_COUNT
	AND_THEN _SecondaryExceptionPending[taskIndex]
THEN
	_SecondaryExceptionPending[taskIndex] := FALSE;
	TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ACCESS_VIOLATION,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	ShouldLog := _AllowProbedLog[taskIndex];
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSecondaryExceptionProbe" Id="{923620dc-252b-43bf-ab55-0111d4df69a4}">
      <Declaration><![CDATA[(*!
<summary>Enables or cancels one simulated secondary native diagnostic in the calling test task.</summary>
<description>Each cyclic task owns its slot. Other tasks keep their configured filter behavior.</description>
<param name="enabled">TRUE arms the next logging callback. FALSE cancels a pending probe.</param>
<param name="allowLog">Logging decision for the armed callback. The default suppresses the entry.</param>
*)
METHOD SetSecondaryExceptionProbe
VAR_INPUT
	enabled : BOOL;
	allowLog : BOOL := FALSE;
END_VAR
VAR
	taskIndex : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[taskIndex := TOF_Core.System.GetCurrentTaskIndex();

IF taskIndex >= 1 AND_THEN taskIndex <= TOF_Core.System.TASK_COUNT THEN
	_SecondaryExceptionPending[taskIndex] := enabled;
	_AllowProbedLog[taskIndex] := allowLog;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>