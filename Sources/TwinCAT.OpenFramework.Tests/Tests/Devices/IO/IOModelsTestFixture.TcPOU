		converter := converter
	);
	channelStorage : ARRAY [0..31] OF BYTE;
	unboundChannel : REFERENCE TO TOF_IOModels.ANALOG_INPUT_REAL_CHANNEL;
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_REAL_CHANNEL;
	rawValue : REAL;
	rawStatus : WORD;
	valueOffset : UDINT;
	statusOffset : UDINT;
	originalBytes : ARRAY [0..31] OF BYTE;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[channel := ADR(channelStorage);

IF SIZEOF(channel^) > SIZEOF(channelStorage) THEN
