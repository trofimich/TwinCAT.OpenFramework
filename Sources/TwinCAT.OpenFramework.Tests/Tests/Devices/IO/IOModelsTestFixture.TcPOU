(*!
<summary>Holds the existing I/O symbols and runs the model scenarios for the test group.</summary>
<description>
Keep the mapped field names and types at the controller-owned instance path used by the test project.
PDO cases inspect type and byte width through ANY without reading or writing process-image payloads.
Binding cases use fresh local consumers and simulated channels with a live fixture-owned automation parent.
Use from one task. Actual EtherCAT mapping and online change require separate verification.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK IOModelsTestFixture IMPLEMENTS IIOModelsTestFixture
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	//! <summary>Bit 6 flags a measurement or hardware error in the simulated channel status word.</summary>
	_ChannelErrorStatus : WORD := WORD#16#0040;
	//! <summary>Initial content outside the simulated fields to expose unintended buffer writes.</summary>
	_UnusedBufferByte : BYTE := BYTE#16#A5;
END_VAR
VAR
	_PulseTrain : TOF_IOModels.EL2521;
	_CounterEncoder : TOF_IOModels.EL5152;
	_LatchedEncoder : TOF_IOModels.EL5151;
	_PowerMeasurement : TOF_IOModels.EL3413_EX;
	_GlobalStatusPowerMeasurement : TOF_IOModels.EL3403;
	_DirectPowerMeasurement : TOF_IOModels.EL3433;
	_Counter : TOF_IOModels.EL1502;
	_Load : TOF_IOModels.EL3356;
	_Pwm : TOF_IOModels.EL2502;
	_Serial : TOF_IOModels.EL6022;
	_DiscreteOutput : TOF_IOModels.EP2624_0002_EX;
	_SixteenChannelInput : TOF_IOModels.EP1809_0021_EX;
	_SixteenChannelOutput : TOF_IOModels.EP2809_0021_EX;
	_MultiRangeInput : TOF_IOModels.EL3078;
	_FieldAnalogInput : TOF_IOModels.EP3174_0002_EX;
	_FieldAnalogOutput : TOF_IOModels.EP4174_0002_EX;
	_FieldSerial : TOF_IOModels.EP6001_0002_EX;

	//! <summary>Live parent borrowed by the simulated analog consumers.</summary>
	_AutomationRoot : MockAutomationController(name := "IOModelsRoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteScenario" Id="{a755ca70-cd0c-48e0-90d8-d84d22a621cd}">
      <Declaration><![CDATA[(*!
<summary>Runs one IO model scenario and reports to the current case.</summary>
<description>Use from the owning test task. The fixture never retains assertions.</description>
<param name="scenario">Scenario assigned to the caller.</param>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD ExecuteScenario
VAR_INPUT
	scenario : IO_MODELS_TEST_SCENARIO;
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE scenario OF
	IO_MODELS_TEST_SCENARIO.PULSE_TRAIN:
		testPulseTrain(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.ENCODER_CHANNELS:
		testEncoderChannels(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.POWER_MEASUREMENT:
		testPowerMeasurement(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.AUXILIARY:
		testAuxiliary(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.COUNTER_AND_LOAD:
		testCounterAndLoad(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.SERIAL_AND_DIAGNOSTICS:
		testSerialAndDiagnostics(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.DISCRETE_CATALOG:
		testDiscreteCatalog(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.ANALOG_REPRESENTATIONS:
		testAnalogRepresentations(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.DINT_BINDING:
		testDintBinding(assertions := assertions);

	IO_MODELS_TEST_SCENARIO.REAL_BINDING:
		testRealBinding(assertions := assertions);
ELSE
	assertions.ThatBool(actual := FALSE, message := "Unknown IO model scenario").IsTrue();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkField" Id="{7b303b11-0bd5-4957-8b2d-806b72f7f1c1}">
      <Declaration><![CDATA[(*!
<summary>Compares a field descriptor with independent PDO expectations.</summary>
<description>Does not dereference or retain the payload. Pass a model field variable.</description>
<param name="assertions">Valid assertion context of the active case.</param>
<param name="value">Model field whose IEC representation is inspected.</param>
<param name="expectedType">IEC type class required by the selected PDO.</param>
<param name="expectedSize">Required field width in bytes, excluding aggregate padding.</param>
<param name="fieldName">Field identifier used in diagnostic messages.</param>
*)
METHOD PRIVATE checkField
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
	value : ANY;
	expectedType : __SYSTEM.TYPE_CLASS;
	expectedSize : DINT;
	fieldName : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[assertions.ThatUDInt(
	actual := TO_UDINT(value.TypeClass),
	message := TOF_Core.WideStrings.Concat255(fieldName, " type")
).ToBe(expected := TO_UDINT(expectedType));
assertions.ThatDInt(
	actual := value.diSize,
	message := TOF_Core.WideStrings.Concat255(fieldName, " byte width")
).ToBe(expected := expectedSize);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testPulseTrain" Id="{e562aa14-8c06-4be8-aa20-d0383a176e14}">
      <Declaration><![CDATA[(*!
<summary>Checks the pulse train command and feedback field representations.</summary>
<description>Compares compiler descriptors against independent PDO field expectations.</description>
<param name="assertions">Valid assertion context of the active case.</param>
*)
METHOD PRIVATE testPulseTrain
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.Out.Control,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := "_PulseTrain.Ch1.Out.Control"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.Out.Frequency,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UINT,
	expectedSize := 2,
	fieldName := "_PulseTrain.Ch1.Out.Frequency"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.Out.TargetCounterValue,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UDINT,
	expectedSize := 4,
	fieldName := "_PulseTrain.Ch1.Out.TargetCounterValue"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.Out.CounterControl,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := "_PulseTrain.Ch1.Out.CounterControl"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.Out.SetCounterValue,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UDINT,
	expectedSize := 4,
	fieldName := "_PulseTrain.Ch1.Out.SetCounterValue"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.In.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := "_PulseTrain.Ch1.In.Status"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.In.CounterStatus,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := "_PulseTrain.Ch1.In.CounterStatus"
);
checkField(
	assertions := assertions,
	value := _PulseTrain.Ch1.In.CounterValue,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UDINT,
	expectedSize := 4,
	fieldName := "_PulseTrain.Ch1.In.CounterValue"
);]]></ST>
      </Implementation>
    </Method>
