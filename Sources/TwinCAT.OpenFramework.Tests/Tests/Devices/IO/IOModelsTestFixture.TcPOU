statusOffset := TO_UDINT(ADR(channel^.Status) - ADR(channel^));

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	channelStorage[i] := _UnusedBufferByte;
END_FOR

rawValue := REAL#-12.75;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	originalBytes[i] := channelStorage[i];
END_FOR

IF NOT analogInput.Initialize() THEN
	assertions.ThatBool(actual := FALSE, message := "The analog input must initialize").IsTrue();

	RETURN;
END_IF

analogInput.BindToReal32IO(rawValues := channel^);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.BoundToIO,
	message := "Valid channel must bind"
).IsTrue();
assertions.ThatLongReal(
	actual := analogInput.Value,
	message := "The fractional REAL value must survive binding"
).ToBe(expected := LREAL#-12.75);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	assertions.ThatByte(
		actual := channelStorage[i],
		message := TOF_Core.WideStrings.Concat255("Binding and processing changed byte ", TO_WSTRING(i))
	).ToBe(expected := originalBytes[i]);
END_FOR

rawStatus := _ChannelErrorStatus;
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.HasError,
	message := "Live channel error must be reported"
).IsTrue();
assertions.ThatBool(
	actual := analogInput.Status.Error,
	message := "Live channel must expose the sampled error bit"
).IsTrue();
analogInput.BindToReal32IO(rawValues := unboundChannel);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.BoundToIO,
	message := "Invalid reference must unbind value"
).IsFalse();
assertions.ThatBool(
	actual := analogInput.Status.Error,
	message := "Invalid reference must unbind status"
).IsFalse();

rawValue := REAL#23.5;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	originalBytes[i] := channelStorage[i];
END_FOR

analogInput.BindToReal32IO(rawValues := channel^);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.BoundToIO,
	message := "Recovered channel must bind again"
).IsTrue();
assertions.ThatLongReal(
	actual := analogInput.Value,
	message := "Rebinding must read the updated source"
).ToBe(expected := LREAL#23.5);
assertions.ThatBool(
	actual := analogInput.HasError,
	message := "Rebinding to recovered status must clear error"
).IsFalse();
analogInput.BindToReal32IO(rawValues := unboundChannel);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	assertions.ThatByte(
		actual := channelStorage[i],
		message := TOF_Core.WideStrings.Concat255(
			"Rebinding, processing or unbinding changed byte ",
			TO_WSTRING(i)
		)
	).ToBe(expected := originalBytes[i]);
END_FOR]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
