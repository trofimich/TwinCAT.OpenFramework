checkField(
	assertions := assertions,
	value := _FieldAnalogInput.Ch4.Value,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_INT,
	expectedSize := 2,
	fieldName := "_FieldAnalogInput.Ch4.Value"
);
checkField(
	assertions := assertions,
	value := _FieldAnalogOutput.Ch4,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_INT,
	expectedSize := 2,
	fieldName := "_FieldAnalogOutput.Ch4"
);
checkField(
	assertions := assertions,
	value := _FieldSerial.Ch1.InData.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := "_FieldSerial.Ch1.InData.Status"
);
checkField(
	assertions := assertions,
	value := _FieldSerial.Ch1.OutData.Control,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := "_FieldSerial.Ch1.OutData.Control"
);

assertions.ThatUDInt(
	actual := SIZEOF(_FieldAnalogInput.AdsAddr),
	message := "_FieldAnalogInput retains the supported CoE ADS endpoint"
).ToBe(expected := 8);
assertions.ThatUDInt(
	actual := SIZEOF(_FieldAnalogOutput.AdsAddr),
	message := "_FieldAnalogOutput retains the supported CoE ADS endpoint"
).ToBe(expected := 8);
assertions.ThatUDInt(
	actual := SIZEOF(_FieldSerial.AdsAddr),
	message := "_FieldSerial retains the supported CoE ADS endpoint"
).ToBe(expected := 8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDintBinding" Id="{2475ad90-6c71-42ff-84da-8a14de0bcdda}">
      <Declaration><![CDATA[(*!
<summary>Checks signed DINT input binding, recovery, unbinding and source preservation.</summary>
<description>Builds a fresh simulated channel in ordinary storage. Offsets describe the PLC layout.</description>
<param name="assertions">Valid assertion context of the active case.</param>
*)
METHOD PRIVATE testDintBinding
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	analogInput : TOF_Devices_IO.AnalogInput(
		name := "DintModelInput",
		parent := _AutomationRoot,
		converter := converter
	);
	channelStorage : ARRAY [0..31] OF BYTE;
	unboundChannel : REFERENCE TO TOF_IOModels.ANALOG_INPUT_DINT_CHANNEL;
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_DINT_CHANNEL;
	rawValue : DINT;
	rawStatus : WORD;
	valueOffset : UDINT;
	statusOffset : UDINT;
	originalBytes : ARRAY [0..31] OF BYTE;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[channel := ADR(channelStorage);

IF SIZEOF(channel^) > SIZEOF(channelStorage) THEN
	assertions.ThatBool(
		actual := FALSE,
		message := "Simulated channel storage is too small"
	).IsTrue();

	RETURN;
END_IF

valueOffset := TO_UDINT(ADR(channel^.Value) - ADR(channel^));
statusOffset := TO_UDINT(ADR(channel^.Status) - ADR(channel^));

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	channelStorage[i] := _UnusedBufferByte;
END_FOR

rawValue := DINT#-123456789;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	originalBytes[i] := channelStorage[i];
END_FOR

IF NOT analogInput.Initialize() THEN
	assertions.ThatBool(actual := FALSE, message := "The analog input must initialize").IsTrue();

	RETURN;
END_IF

analogInput.BindToInt32IO(rawValues := channel^);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.BoundToIO,
	message := "Valid channel must bind"
).IsTrue();
assertions.ThatLongReal(
	actual := analogInput.Value,
	message := "The signed DINT value must survive binding"
).ToBe(expected := LREAL#-123456789.0);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	assertions.ThatByte(
		actual := channelStorage[i],
		message := TOF_Core.WideStrings.Concat255("Binding and processing changed byte ", TO_WSTRING(i))
	).ToBe(expected := originalBytes[i]);
END_FOR

rawStatus := _ChannelErrorStatus;
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.HasError,
	message := "Live channel error must be reported"
).IsTrue();
assertions.ThatBool(
	actual := analogInput.Status.Error,
	message := "Live channel must expose the sampled error bit"
).IsTrue();
analogInput.BindToInt32IO(rawValues := unboundChannel);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.BoundToIO,
	message := "Invalid reference must unbind value"
).IsFalse();
assertions.ThatBool(
	actual := analogInput.Status.Error,
	message := "Invalid reference must unbind status"
).IsFalse();

rawValue := DINT#7654321;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(channelStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	originalBytes[i] := channelStorage[i];
END_FOR

analogInput.BindToInt32IO(rawValues := channel^);
analogInput.ProcessInput();
assertions.ThatBool(
	actual := analogInput.BoundToIO,
	message := "Recovered channel must bind again"
).IsTrue();
assertions.ThatLongReal(
	actual := analogInput.Value,
	message := "Rebinding must read the updated source"
).ToBe(expected := LREAL#7654321.0);
assertions.ThatBool(
	actual := analogInput.HasError,
	message := "Rebinding to recovered status must clear error"
).IsFalse();
analogInput.BindToInt32IO(rawValues := unboundChannel);

FOR i := LOWER_BOUND(channelStorage, 1) TO UPPER_BOUND(channelStorage, 1) DO
	assertions.ThatByte(
		actual := channelStorage[i],
		message := TOF_Core.WideStrings.Concat255(
			"Rebinding, processing or unbinding changed byte ",
			TO_WSTRING(i)
		)
	).ToBe(expected := originalBytes[i]);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRealBinding" Id="{8386f9d4-8b12-4cfa-b392-358126f21adf}">
      <Declaration><![CDATA[(*!
<summary>Checks fractional REAL input binding, recovery, unbinding and source preservation.</summary>
<description>Builds a fresh simulated channel in ordinary storage. Offsets describe the PLC layout.</description>
<param name="assertions">Valid assertion context of the active case.</param>
*)
METHOD PRIVATE testRealBinding
