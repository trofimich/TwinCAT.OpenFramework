<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="RangeAnalogValueConverter32BitTest" Id="{30645fc0-4662-4b4c-a071-89c33806d197}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks integer conversion on a 24-bit scale and a descending raw scale that uses more than 24 bits.</summary>
<description>Verifies interpolation, raw saturation and preservation of the 32-bit representation.</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RangeAnalogValueConverter32BitTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{947376d0-fa44-440a-b286-4c38fa832803}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name for the lifetime of this instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c3655dab-f76e-484f-b319-842faa65c91c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{5c9e40aa-0d48-4210-b31b-e1bc8d29f4db}">
      <Declaration><![CDATA[(*!
<summary>Checks five ascending points in each direction and clamping and interpolation on the descending scale.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR CONSTANT
	analogPoints : ARRAY [0..4] OF LREAL := [0, 2.5, 5, 7.5, 10];
	expectedRaw : ARRAY [0..4] OF DINT := [
		TOF_Core.SignedInt32.MIN_24BIT_VALUE, -4194304, -1, 4194303, TOF_Core.SignedInt32.MAX_24BIT_VALUE
	];
	rawInputs : ARRAY [0..4] OF DINT := [
		TOF_Core.SignedInt32.MIN_24BIT_VALUE, -4194304, 0, 4194304, TOF_Core.SignedInt32.MAX_24BIT_VALUE
	];
END_VAR
VAR
	i : DINT;
	zeroToTen : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0,
		maxAnalogValue := 10,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := TOF_Core.SignedInt32.MIN_24BIT_VALUE),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := TOF_Core.SignedInt32.MAX_24BIT_VALUE)
	);
	descendingRaw : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := -10,
		maxAnalogValue := 30,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := 20000000),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := -12000000)
	);

	rawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	analogValue : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(analogPoints, 1) TO UPPER_BOUND(analogPoints, 1) DO
	rawValue := zeroToTen.ConvertAnalogValueToRawValue(
		analogValue := analogPoints[i],
		rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
	);
	Assert.ThatDInt(
		actual := rawValue.Int32,
		message := TOF_Core.WideStrings.Concat255("Analog to raw at ", TO_WSTRING(analogPoints[i]))
	).ToBe(expected := expectedRaw[i]);

	analogValue := zeroToTen.ConvertRawValueToAnalogValue(
		rawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := rawInputs[i]),
		rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
	);
	Assert.ThatLongReal(
		actual := analogValue,
		message := TOF_Core.WideStrings.Concat255("Raw to analog at ", TO_WSTRING(rawInputs[i]))
	).ToBe(expected := analogPoints[i], tolerance := 0.01);
END_FOR

// Check the descending scale independently of the ascending fixture.
rawValue := descendingRaw.ConvertAnalogValueToRawValue(
	analogValue := -20,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatDInt(
	actual := rawValue.Int32,
	message := "Analog to raw clamps to its first raw endpoint"
).ToBe(expected := 20000000);

rawValue := descendingRaw.ConvertAnalogValueToRawValue(
	analogValue := 0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatDInt(
	actual := rawValue.Int32,
	message := "Analog to raw preserves values beyond 24 bits"
).ToBe(expected := 12000000);

rawValue := descendingRaw.ConvertAnalogValueToRawValue(
	analogValue := 40,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatDInt(
	actual := rawValue.Int32,
	message := "Analog to raw clamps to its last raw endpoint"
).ToBe(expected := -12000000);

analogValue := descendingRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := 21000000),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog clamps above the first raw endpoint"
).ToBe(expected := -10);

analogValue := descendingRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := -4000000),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog interpolates a descending raw value"
).ToBe(expected := 20);

analogValue := descendingRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromInt32(value := -13000000),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog clamps below the last raw endpoint"
).ToBe(expected := 30);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{7e98702a-b479-4bfe-880d-4b6f6193b3d6}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized namespace for the lifetime of this instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{eea77291-7d04-43fe-96e4-e719373929f9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a434b7bb-361a-4f15-9e62-12eff6e126cb}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{36efd640-ee13-47a3-b758-39837ee03a1b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>