(*!
<summary>Comprehensive test suite for TwinCAT_OpenFramework_Devices_IO components.</summary>
<description>
Verifies digital inputs/outputs, contact inversion, analog scaling, status decoding,
online change preservation, and division-by-zero defense.
</description>
*)

FUNCTION_BLOCK DevicesIOTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestDigitalInputNormallyOpen();
TestDigitalInputNormallyClosed();
TestDigitalInputUnbound();
TestDigitalOutputNormallyOpen();
TestDigitalOutputNormallyClosed();
TestDirectAnalogValueConverter();
TestAnalogInputScalingAndScalarBinding();
TestAnalogInputChannelStatusAndErrorReporting();
TestAnalogInputStatusBitDecoding();
TestAnalogOutputScaling();
TestDynamicRangeAnalogValueConverter();
TestStaticConverterCopiesLimits();
TestRangeConverterBoundaryClampingAndZeroDivision();]]></ST>
    </Implementation>
    <Folder Name="Tests" Id="{05bec5d2-befe-4cef-97e6-8d538d591d5f}" />
    <Property Name="ClassName" Id="{28d8276f-144b-4734-bf03-a7bcd2dbd76b}">
