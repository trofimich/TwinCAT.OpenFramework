(*!
<summary>Comprehensive test suite for TwinCAT_OpenFramework_Devices_IO components.</summary>
<description>
Verifies digital inputs/outputs, contact inversion, analog scaling, status decoding,
online change preservation, and division-by-zero defense.
Also verifies analog input diagnostics through both cyclic phases and analog output processing with equal raw limits.
IO fixtures borrow the suite-owned automation root so required-parent initialization is valid.
</description>
*)

FUNCTION_BLOCK DevicesIOTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	//! <summary>Live parent borrowed by the IO fixtures for the suite lifetime.</summary>
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR
VAR CONSTANT
	//! <summary>Bit 6 of the simulated process word indicates a channel measurement or hardware error.</summary>
	_ChannelErrorStatus : WORD := WORD#16#0040;
	_ChannelErrorMessage : WSTRING := "Analog input channel reports error";
	_ConversionErrorMessage : WSTRING := "Injected analog input conversion failure.";
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestDigitalInputNormallyOpen();
TestDigitalInputNormallyClosed();
TestDigitalInputUnbound();
TestDigitalOutputNormallyOpen();
TestDigitalOutputNormallyClosed();
TestDirectAnalogValueConverter();
TestAnalogInputScalingAndScalarBinding();
TestAnalogInputChannelStatusAndErrorReporting();
TestAnalogInputConverterRecovery();
TestAnalogInputCriticalConversionError();
TestAnalogInputStatusWordIsolation();
TestAnalogInputStatusBitDecoding();
TestAnalogOutputScaling();
TestAnalogOutputEqualRawLimits();
TestDynamicRangeAnalogValueConverter();
TestStaticConverterCopiesLimits();
TestRangeConverterBoundaryClampingAndZeroDivision();]]></ST>
    </Implementation>
    <Folder Name="Tests" Id="{05bec5d2-befe-4cef-97e6-8d538d591d5f}" />
    <Property Name="ClassName" Id="{28d8276f-144b-4734-bf03-a7bcd2dbd76b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{efb9b6cb-8bdc-45c6-bce6-8f55ec0576da}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{9f90b4ab-cf97-42cd-8f96-0d7f48df40b6}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c1d05b40-90a8-4995-a1de-5e63eacfb1bd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TestAnalogInputChannelStatusAndErrorReporting" Id="{5a961e5a-271f-46e9-928d-54f0f50a72df}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks channel error lifetime across complete cycles, recovery, and unbinding.</summary>
<description>
Uses two ordinary words as the Status/Value process image and a typed channel view; no located inputs are written.
The component and simulated channel live in the same call. The fault and recovery cycles run ProcessInput()
and Execute(). Binding must leave source data intact, and an invalid reference must clear the binding
before a subsequent valid rebind.
The IO fixture borrows the suite-owned automation root for valid initialization.
</description>
*)
METHOD PRIVATE TestAnalogInputChannelStatusAndErrorReporting
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	ai : AnalogInputRecoveryProbe(name := "AI_Chan", parent := _AutomationRoot, converter := converter);
	//! <summary>Status word at offset 0 and signed 16-bit value bits at offset 1.</summary>
	channelData : ARRAY [0..1] OF WORD;
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
	unboundChannel : REFERENCE TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
	i : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogInputChannelStatusAndErrorReporting');

AssertTrue(Condition := ai.Initialize(), Message := 'The analog input must initialize');
channel := ADR(channelData);
channelData[0] := WORD#16#0000;
channelData[1] := WORD#1000;
ai.BindToInt16IO(rawValues := channel^);
AssertTrue(Condition := ai.BoundToIO, Message := 'A valid simulated channel must bind');
AssertTrue(
	Condition := channelData[0] = WORD#16#0000 AND_THEN channelData[1] = WORD#1000,
	Message := 'Binding must leave both source words unchanged'
);
ai.ProcessInput();
ai.Execute();

AssertFalse(
	Condition := ai.HasError,
	Message := 'A healthy channel must have no error after the full cycle'
);

AssertEquals_LREAL(
	Expected := LREAL#1000.0,
	Actual := ai.Value,
	Delta := LREAL#0.0,
	Message := 'The bound component must read the simulated raw value'
);

// Hold bit 6 across two complete input and execution phases.
channelData[0] := _ChannelErrorStatus;

FOR i := 1 TO 2 DO
	ai.ProcessInput();

	AssertTrue(
		Condition := ai.Status.Error
			AND_THEN ai.StatusWord = _ChannelErrorStatus
			AND_THEN ai.HasError
			AND_THEN ai.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR
			AND_THEN ai.Error.TopMessage = _ChannelErrorMessage,
		Message := 'A sampled bit 6 must report the channel error after ProcessInput'
	);

	ai.Execute();

	AssertTrue(
		Condition := ai.StatusWord = _ChannelErrorStatus
			AND_THEN ai.HasError
			AND_THEN ai.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR
			AND_THEN ai.Error.TopMessage = _ChannelErrorMessage
			AND_THEN ai.OperationalState = TOF_Automation.OPERATIONAL_STATE.WORKING
			AND_THEN ai.RecoveryCalls = UDINT#0,
		Message := 'A persistent channel error must survive Execute without stopping or recovering the leaf'
	);
END_FOR

channelData[0] := WORD#0;
ai.ProcessInput();

AssertTrue(
	Condition := NOT ai.Status.Error AND_THEN ai.StatusWord = WORD#0 AND_THEN NOT ai.HasError,
	Message := 'Sampling a clear bit 6 must clear the channel diagnostic in the input phase'
);

ai.Execute();

AssertTrue(
	Condition := ai.StatusWord = WORD#0
		AND_THEN NOT ai.HasError
		AND_THEN ai.Error.Empty
		AND_THEN ai.RecoveryCalls = UDINT#0,
	Message := 'The recovered channel must remain clear after Execute without a recovery callback'
);

channelData[0] := _ChannelErrorStatus;
channelData[1] := WORD#2000;
ai.ProcessInput();
ai.Execute();
ai.BindToInt16IO(rawValues := unboundChannel);

AssertTrue(
	Condition := NOT ai.BoundToIO AND_THEN ai.StatusWord = _ChannelErrorStatus AND_THEN ai.HasError,
	Message := 'Unbinding clears the value link while keeping the last sample until input processing'
);

ai.ProcessInput();

AssertTrue(
	Condition := NOT ai.Status.Error AND_THEN ai.StatusWord = WORD#0 AND_THEN NOT ai.HasError,
	Message := 'Input processing without a status binding must clear the sampled status and channel error'
);

ai.Execute();

AssertTrue(
	Condition := ai.StatusWord = WORD#0
		AND_THEN NOT ai.HasError
		AND_THEN ai.Error.Empty
		AND_THEN ai.RecoveryCalls = UDINT#0,
	Message := 'The unbound input must remain clear after Execute'
);
AssertTrue(
	Condition := channelData[0] = WORD#16#0040 AND_THEN channelData[1] = WORD#2000,
	Message := 'Unbinding must leave source data unchanged'
);
channelData[0] := WORD#16#0000;
ai.BindToInt16IO(rawValues := channel^);
ai.ProcessInput();
AssertTrue(Condition := ai.BoundToIO, Message := 'A valid channel must bind again after unbinding');
AssertEquals_LREAL(
	Expected := LREAL#2000.0,
	Actual := ai.Value,
	Delta := LREAL#0.0,
	Message := 'Rebinding must read the current source value'
);
AssertTrue(
	Condition := channelData[0] = WORD#16#0000 AND_THEN channelData[1] = WORD#2000,
	Message := 'Input processing and rebinding must leave source data unchanged'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogInputConverterRecovery" Id="{28128c83-149a-4993-b57e-12d154202bf6}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks non-critical conversion recovery with an independent channel diagnostic.</summary>
<description>
Executes both input and working phases. Exercises channel recovery first and then converter recovery first.
</description>
*)
METHOD PRIVATE TestAnalogInputConverterRecovery
VAR
	converter : AnalogInputConverterProbe;
	analogInput : AnalogInputRecoveryProbe(
		name := "AI_ConversionRecovery",
		parent := _AutomationRoot,
		converter := converter
	);
	//! <summary>Simulated status word at offset 0 and signed INT value bits at offset 1.</summary>
	channelData : ARRAY [0..1] OF WORD;
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogInputConverterRecovery');

AssertTrue(Condition := analogInput.Initialize(), Message := 'The analog input must initialize');
analogInput.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndContinue;
channel := ADR(channelData);
channelData[0] := WORD#0;
channelData[1] := WORD#100;
analogInput.BindToInt16IO(rawValues := channel^);
analogInput.ProcessInput();
analogInput.Execute();
AssertTrue(Condition := analogInput.Value = LREAL#100.0, Message := 'The initial conversion must succeed');

converter.failureMessage := _ConversionErrorMessage;
channelData[1] := WORD#200;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.HasError
		AND_THEN analogInput.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage,
	Message := 'Converter failure on a healthy channel must survive Execute'
);
AssertTrue(
	Condition := analogInput.Value = LREAL#100.0 AND_THEN analogInput.RecoveryCalls = UDINT#0,
	Message := 'A failed conversion must preserve the last value and defer recovery'
);

// Use different exception text to distinguish retaining the original error from copying a later one.
converter.failureMessage := "Repeated analog input conversion failure.";
channelData[0] := _ChannelErrorStatus;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.StatusWord = _ChannelErrorStatus
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage,
	Message := 'The converter diagnostic must take precedence while both errors are active'
);

channelData[0] := WORD#0;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.StatusWord = WORD#0
		AND_THEN analogInput.HasError
		AND_THEN analogInput.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage
		AND_THEN analogInput.RecoveryCalls = UDINT#0,
	Message := 'Channel recovery must preserve the failing converter diagnostic'
);

converter.failureMessage := "";
analogInput.ProcessInput();

AssertTrue(
	Condition := analogInput.Value = LREAL#200.0
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage,
	Message := 'A successful input phase must update Value and leave recovery to Execute'
);

analogInput.Execute();

AssertTrue(
	Condition := NOT analogInput.HasError AND_THEN analogInput.RecoveryCalls = UDINT#1,
	Message := 'Execute must clear the recovered conversion error and call OnRecover once'
);

// A new conversion failure must be reported even when the channel fails in the same phase.
channelData[0] := _ChannelErrorStatus;
channelData[1] := WORD#300;
converter.failureMessage := _ConversionErrorMessage;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.StatusWord = _ChannelErrorStatus
		AND_THEN analogInput.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage,
	Message := 'An active channel error must not block capture of a new conversion failure'
);

// Recover the converter first, with the channel fault still active.
converter.failureMessage := "";
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.HasError
		AND_THEN analogInput.Error.TopMessage = _ChannelErrorMessage
		AND_THEN analogInput.Value = LREAL#300.0
		AND_THEN analogInput.RecoveryCalls = UDINT#2,
	Message := 'Converter recovery must expose the still-active channel error'
);

channelData[0] := WORD#0;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := NOT analogInput.HasError AND_THEN analogInput.RecoveryCalls = UDINT#2,
	Message := 'Channel recovery must clear its diagnostic without another recovery callback'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogInputCriticalConversionError" Id="{8c0f7ac8-52ab-4f38-bd54-211e21ff74a7}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks that successful input and channel recovery preserve a critical conversion error until Reset().</summary>
*)
METHOD PRIVATE TestAnalogInputCriticalConversionError
VAR
	converter : AnalogInputConverterProbe;
	analogInput : AnalogInputRecoveryProbe(
		name := "AI_CriticalConversion",
		parent := _AutomationRoot,
		converter := converter
	);
	//! <summary>Simulated status word at offset 0 and signed INT value bits at offset 1.</summary>
	channelData : ARRAY [0..1] OF WORD;
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogInputCriticalConversionError');

AssertTrue(Condition := analogInput.Initialize(), Message := 'The analog input must initialize');
analogInput.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndStop;
channel := ADR(channelData);
channelData[0] := _ChannelErrorStatus;
channelData[1] := WORD#100;
analogInput.BindToInt16IO(rawValues := channel^);
converter.failureMessage := _ConversionErrorMessage;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED
		AND_THEN analogInput.HasError
		AND_THEN analogInput.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage,
	Message := 'The critical conversion error must stop the leaf and take precedence over the channel error'
);

converter.failureMessage := "";
channelData[0] := WORD#0;
analogInput.ProcessInput();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED
		AND_THEN analogInput.StatusWord = WORD#0
		AND_THEN analogInput.Value = LREAL#100.0
		AND_THEN analogInput.HasError
		AND_THEN analogInput.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL
		AND_THEN analogInput.Error.TopMessage = _ConversionErrorMessage,
	Message := 'Successful input with a healthy channel must preserve the critical diagnostic while stopped'
);

analogInput.Reset();
analogInput.Execute();

AssertTrue(
	Condition := analogInput.OperationalState = TOF_Automation.OPERATIONAL_STATE.WORKING
		AND_THEN NOT analogInput.HasError
		AND_THEN analogInput.RecoveryCalls = UDINT#0,
	Message := 'Reset must clear the critical diagnostic and restore WORKING'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogInputScalingAndScalarBinding" Id="{c581e3af-9611-430d-86c2-cb29575e0e08}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks scalar analog input scaling with a live automation parent.</summary>
*)
METHOD PRIVATE TestAnalogInputScalingAndScalarBinding
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	ai : TOF_Devices_IO.AnalogInput(name := "AI_Scalar", parent := _AutomationRoot, converter := converter);
	rawInt : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogInputScalingAndScalarBinding');

ai.Initialize();
ai.BindToInt16Value(rawInt);

AssertTrue(
	Condition := ai.BoundToIO,
	Message := 'AnalogInput should be BoundToIO after BindToInt16Value'
);

rawInt := 5678;
ai.ProcessInput();

AssertEquals_LREAL(
	Expected := 5678.0,
	Actual := ai.Value,
	Delta := 0.001,
	Message := 'AnalogInput.Value should match raw INT input'
);

AssertFalse(
	Condition := ai.HasError,
	Message := 'AnalogInput should work without error when status is unbound'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogInputStatusBitDecoding" Id="{0af81e5e-f0ce-4444-90a4-51c249db8b35}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD PRIVATE TestAnalogInputStatusBitDecoding
VAR
	statusFB : TOF_Devices_IO.ANALOG_INPUT_STATUS;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogInputStatusBitDecoding');

statusFB.SetStatus(status := 16#0001);
AssertTrue(Condition := statusFB.Underrange, Message := 'Bit 0 must be Underrange');

statusFB.SetStatus(status := 16#0002);
AssertTrue(Condition := statusFB.Overrange, Message := 'Bit 1 must be Overrange');

statusFB.SetStatus(status := 16#0004);
AssertTrue(Condition := statusFB.ValueSmallerOrEqualLimit1, Message := 'Bit 2 must be Limit 1 smaller');

statusFB.SetStatus(status := 16#0008);
AssertTrue(Condition := statusFB.ValueBiggerOrEqualLimit1, Message := 'Bit 3 must be Limit 1 bigger');

statusFB.SetStatus(status := 16#0010);
AssertTrue(Condition := statusFB.ValueSmallerOrEqualLimit2, Message := 'Bit 4 must be Limit 2 smaller');

statusFB.SetStatus(status := 16#0020);
AssertTrue(Condition := statusFB.ValueBiggerOrEqualLimit2, Message := 'Bit 5 must be Limit 2 bigger');

statusFB.SetStatus(status := 16#0040);
AssertTrue(Condition := statusFB.Error, Message := 'Bit 6 must be Error');
AssertFalse(Condition := statusFB.TxPDOState, Message := 'Bit 6 must NOT be TxPDOState');

statusFB.SetStatus(status := 16#4000);
AssertTrue(Condition := statusFB.TxPDOState, Message := 'Bit 14 must be TxPDOState');
AssertFalse(Condition := statusFB.Error, Message := 'Bit 14 must NOT be Error');

statusFB.SetStatus(status := 16#8000);
AssertTrue(Condition := statusFB.TxPDOToggle, Message := 'Bit 15 must be TxPDOToggle');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogInputStatusWordIsolation" Id="{335fbac9-5b8b-4096-832f-b6f95332a5d8}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks optional sampled status access through an existing read-only analog input interface.</summary>
<description>
Writes through the legacy decoded status reference and modifies a local copy of StatusWord. Only a
subsequent ProcessInput() updates the authoritative sample and channel diagnostic.
</description>
*)
METHOD PRIVATE TestAnalogInputStatusWordIsolation
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	analogInput : TOF_Devices_IO.AnalogInput(name := "AI_StatusWord", parent := _AutomationRoot, converter := converter);
	inputView : TOF_Devices_IO.IReadOnlyAnalogInput;
	statusProvider : TOF_Devices_IO.IAnalogInputStatusProvider;
	legacyStatus : REFERENCE TO TOF_Devices_IO.ANALOG_INPUT_STATUS;
	statusCopy : WORD;
	//! <summary>Simulated status word at offset 0 and signed INT value bits at offset 1.</summary>
	channelData : ARRAY [0..1] OF WORD;
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogInputStatusWordIsolation');

AssertTrue(Condition := analogInput.Initialize(), Message := 'The analog input must initialize');
inputView := analogInput;

IF NOT __QUERYINTERFACE(inputView, statusProvider) OR_ELSE statusProvider = 0 THEN
	AssertTrue(Condition := FALSE, Message := 'IReadOnlyAnalogInput must support querying IAnalogInputStatusProvider');
	testFinished := TRUE;
	TEST_FINISHED();

	RETURN;
END_IF

AssertTrue(Condition := statusProvider.StatusWord = WORD#0, Message := 'StatusWord must start at zero');

channel := ADR(channelData);
channelData[0] := _ChannelErrorStatus;
channelData[1] := WORD#0;
analogInput.BindToInt16IO(rawValues := channel^);
inputView.ProcessInput();

legacyStatus REF= inputView.Status;
legacyStatus.SetStatus(status := WORD#0);
statusCopy := statusProvider.StatusWord;
statusCopy.6 := FALSE;
inputView.Execute();

AssertTrue(
	Condition := statusCopy = WORD#0
		AND_THEN NOT inputView.Status.Error
		AND_THEN statusProvider.StatusWord = _ChannelErrorStatus
		AND_THEN inputView.HasError
		AND_THEN inputView.Error.TopMessage = _ChannelErrorMessage,
	Message := 'Mutating the legacy view or local copy must leave the sampled word and diagnostic intact'
);

inputView.ProcessInput();
inputView.Execute();

AssertTrue(
	Condition := inputView.Status.Error AND_THEN statusProvider.StatusWord = _ChannelErrorStatus,
	Message := 'Input processing must refresh the legacy view from the sampled word'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogOutputEqualRawLimits" Id="{d5cdac20-868a-4137-92ea-1695e7840988}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks that analog output processing writes the shared raw limit in each bound output type.</summary>
<description>
Uses distinct engineering limits and equal raw limits with ordinary output variables. The INT16 case also
checks that the converter clears the union's upper bytes even when the source limits contain nonzero upper bytes.
</description>
*)
METHOD PRIVATE TestAnalogOutputEqualRawLimits
VAR
	minEngineeringValue : LREAL := 0.0;
	maxEngineeringValue : LREAL := 100.0;
	minRawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	maxRawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	converter : TOF_Devices_IO.DynamicRangeAnalogValueConverter(
		minAnalogValue := minEngineeringValue,
		maxAnalogValue := maxEngineeringValue,
		minRawValue := minRawValue,
		maxRawValue := maxRawValue
	);
	analogOutput : TOF_Devices_IO.AnalogOutput(name := "AO_EqualRawLimits", parent := _AutomationRoot, converter := converter);

	rawInt16Output : INT;
	rawInt32Output : DINT;
	rawReal32Output : REAL;
	convertedValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogOutputEqualRawLimits');

analogOutput.Initialize();
analogOutput.Value := 50.0;

// Fill the upper two bytes of the INT16 limit to verify that they are cleared in the result.
minRawValue.Int32 := DINT#16#12340000;
minRawValue.Int16 := INT#-1;
maxRawValue := minRawValue;

analogOutput.BindToInt16IO(rawVariable := rawInt16Output);
analogOutput.ProcessOutput();

AssertEquals_INT(
	Expected := INT#-1,
	Actual := rawInt16Output,
	Message := 'Equal INT16 limits must be written to the bound INT output'
);

convertedValue := converter.ConvertAnalogValueToRawValue(
	analogValue := analogOutput.Value,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);

AssertEquals_DINT(
	Expected := DINT#16#0000FFFF,
	Actual := convertedValue.Int32,
	Message := 'The INT16 result must have zero upper bytes'
);

minRawValue.Int32 := DINT#-1;
maxRawValue := minRawValue;

analogOutput.BindToInt32IO(rawVariable := rawInt32Output);
analogOutput.ProcessOutput();

AssertEquals_DINT(
	Expected := DINT#-1,
	Actual := rawInt32Output,
	Message := 'Equal INT32 limits must be written to the bound DINT output'
);

minRawValue.Real32 := REAL#1.0;
maxRawValue := minRawValue;

analogOutput.BindToReal32IO(rawVariable := rawReal32Output);
analogOutput.ProcessOutput();

AssertEquals_REAL(
	Expected := REAL#1.0,
	Actual := rawReal32Output,
	Delta := REAL#0.0,
	Message := 'Equal REAL32 limits must be written to the bound REAL output'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAnalogOutputScaling" Id="{463c0651-8c73-48f5-a3f4-e4301b9a64b9}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks analog output scaling with a live automation parent.</summary>
*)
METHOD PRIVATE TestAnalogOutputScaling
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	ao : TOF_Devices_IO.AnalogOutput(name := "AO_Test", parent := _AutomationRoot, converter := converter);
	rawInt : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestAnalogOutputScaling');

ao.Initialize();
ao.BindToInt16IO(rawInt);

ao.Value := 750.0;
ao.ProcessOutput();

AssertEquals_INT(
	Expected := 750,
	Actual := rawInt,
	Message := 'Raw INT output should match 750'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestStaticConverterCopiesLimits" Id="{03a71e03-fe32-4124-8d38-f41f4c781972}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks that static converter construction copies limits independently of the input unions.</summary>
<description>
Mutates constructor inputs after construction and checks the original conversion limits remain effective.
Real online change requires runtime relocation and is verified manually; explicit FB_init is not a simulation.
</description>
*)
METHOD PRIVATE TestStaticConverterCopiesLimits
VAR
	minRaw : TOF_Devices_IO.RAW_ANALOG_VALUE;
	maxRaw : TOF_Devices_IO.RAW_ANALOG_VALUE := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 1000);
	staticConv : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 100.0,
		minRawValue := minRaw,
		maxRawValue := maxRaw
	);
	resultRaw : TOF_Devices_IO.RAW_ANALOG_VALUE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestStaticConverterCopiesLimits');

// Changing source unions must not change the stored constructor limits.
maxRaw.Int32 := 0;

AssertEquals_LREAL(
	Expected := 100.0,
	Actual := staticConv.MaxAnalogValue,
	Delta := 0.001,
	Message := 'Constructor must preserve the configured analog maximum'
);

resultRaw := staticConv.ConvertAnalogValueToRawValue(
	analogValue := 50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);

AssertEquals_INT(
	Expected := 500,
	Actual := resultRaw.Int16,
	Message := 'Conversion must use copied raw limits after the source changes'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDigitalInputNormallyClosed" Id="{2167409e-64ee-4888-8669-dade645d3964}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks normally closed input inversion with a live automation parent.</summary>
*)
METHOD PRIVATE TestDigitalInputNormallyClosed
VAR
	input : TOF_Devices_IO.DigitalInput(name := "DI_NC", parent := _AutomationRoot);
	rawBool : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDigitalInputNormallyClosed');

input.Initialize();
input.ContactType := TOF_Devices_IO.CONTACT_TYPE.NORMALLY_CLOSED;
input.BindToIO(rawBool);

rawBool := FALSE;
input.ProcessInput();
AssertTrue(Condition := input.Value, Message := 'Value should be inverted TRUE for NC contact');

rawBool := TRUE;
input.ProcessInput();
AssertFalse(Condition := input.Value, Message := 'Value should be inverted FALSE for NC contact');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDigitalInputNormallyOpen" Id="{97a80229-f525-4940-a93b-c52885970efb}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks normally open input changes with a live automation parent.</summary>
*)
METHOD PRIVATE TestDigitalInputNormallyOpen
VAR
	input : TOF_Devices_IO.DigitalInput(name := "DI_NO", parent := _AutomationRoot);
	rawBool : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDigitalInputNormallyOpen');

input.Initialize();
input.BindToIO(rawBool);

AssertTrue(Condition := input.BoundToIO, Message := 'DigitalInput should be bound to IO');

rawBool := FALSE;
input.ProcessInput();
AssertFalse(Condition := input.Value, Message := 'Value should be FALSE');

rawBool := TRUE;
input.ProcessInput();
AssertTrue(Condition := input.Value, Message := 'Value should be TRUE');
AssertTrue(Condition := input.Changed, Message := 'Changed should be TRUE on transition');

input.ProcessInput();
AssertFalse(Condition := input.Changed, Message := 'Changed should be FALSE when state remains same');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDigitalInputUnbound" Id="{e5a734a7-8b5d-4901-a846-c4ceb69476f6}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks unbound input behavior with a live automation parent.</summary>
*)
METHOD PRIVATE TestDigitalInputUnbound
VAR
	input : TOF_Devices_IO.DigitalInput(name := "DI_Unbound", parent := _AutomationRoot);
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDigitalInputUnbound');

input.Initialize();
AssertFalse(Condition := input.BoundToIO, Message := 'BoundToIO should be FALSE');

input.ProcessInput();
AssertFalse(Condition := input.Value, Message := 'Value should default to FALSE');
AssertFalse(Condition := input.HasError, Message := 'Unbound input should not report error');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDigitalOutputNormallyClosed" Id="{0c8fcbb8-c7fa-4f2e-8492-357d7f39096a}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks normally closed output inversion with a live automation parent.</summary>
*)
METHOD PRIVATE TestDigitalOutputNormallyClosed
VAR
	output : TOF_Devices_IO.DigitalOutput(name := "DO_NC", parent := _AutomationRoot);
	rawBool : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDigitalOutputNormallyClosed');

output.Initialize();
output.ContactType := TOF_Devices_IO.CONTACT_TYPE.NORMALLY_CLOSED;
output.BindToIO(rawBool);

output.Value := TRUE;
output.ProcessOutput();
AssertFalse(Condition := rawBool, Message := 'rawBool should be inverted FALSE for NC contact');

output.Value := FALSE;
output.ProcessOutput();
AssertTrue(Condition := rawBool, Message := 'rawBool should be inverted TRUE for NC contact');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDigitalOutputNormallyOpen" Id="{d2d18fb3-44f6-40f7-81b7-8645fe09312c}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks logical output changes before processing and their acknowledgement after processing.</summary>
<description>
Changed compares the current value with the last processed value in both transition directions.
The IO fixture borrows the suite-owned automation root for valid initialization.
</description>
*)
METHOD PRIVATE TestDigitalOutputNormallyOpen
VAR
	output : TOF_Devices_IO.DigitalOutput(name := "DO_NO", parent := _AutomationRoot);
	rawBool : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDigitalOutputNormallyOpen');

output.Initialize();
output.BindToIO(rawValue := rawBool);

output.Value := TRUE;
AssertTrue(Condition := output.Changed, Message := 'Changed must be TRUE before processing a new value');
output.ProcessOutput();
AssertTrue(Condition := rawBool, Message := 'rawBool should be TRUE');
AssertFalse(Condition := output.Changed, Message := 'Processing acknowledges the current value');

output.Value := FALSE;
AssertTrue(Condition := output.Changed, Message := 'The reverse transition must also be pending');
output.ProcessOutput();
AssertFalse(Condition := output.Changed, Message := 'Processing acknowledges the reverse transition');
AssertFalse(Condition := rawBool, Message := 'rawBool should be FALSE');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDirectAnalogValueConverter" Id="{51d606a6-291a-4faf-bed3-2b0ad9e9fb73}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD PRIVATE TestDirectAnalogValueConverter
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	rawUnion : TOF_Devices_IO.RAW_ANALOG_VALUE;
	valLReal : LREAL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDirectAnalogValueConverter');

// INT16
rawUnion := converter.ConvertAnalogValueToRawValue(
	analogValue := 1234.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_INT(Expected := 1234, Actual := rawUnion.Int16, Message := 'INT16 raw value 1:1');

valLReal := converter.ConvertRawValueToAnalogValue(
	rawValue := rawUnion,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_LREAL(Expected := 1234.0, Actual := valLReal, Delta := 0.001, Message := 'INT16 analog value 1:1');

// INT32
rawUnion := converter.ConvertAnalogValueToRawValue(
	analogValue := 100000.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
AssertEquals_DINT(Expected := 100000, Actual := rawUnion.Int32, Message := 'INT32 raw value 1:1');

valLReal := converter.ConvertRawValueToAnalogValue(
	rawValue := rawUnion,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
AssertEquals_LREAL(Expected := 100000.0, Actual := valLReal, Delta := 0.001, Message := 'INT32 analog value 1:1');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDynamicRangeAnalogValueConverter" Id="{3d70f566-2dfa-4ac4-bb14-e177ec39f47f}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD PRIVATE TestDynamicRangeAnalogValueConverter
VAR
	minA : LREAL := 0.0;
	maxA : LREAL := 100.0;
	minR : TOF_Devices_IO.RAW_ANALOG_VALUE;
	maxR : TOF_Devices_IO.RAW_ANALOG_VALUE;
	dynConv : TOF_Devices_IO.DynamicRangeAnalogValueConverter(
		minA, maxA, minR, maxR
	);
	rawUnion : TOF_Devices_IO.RAW_ANALOG_VALUE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestDynamicRangeAnalogValueConverter');

minR.Int32 := 0;
minR.Int16 := 0;
maxR.Int32 := 0;
maxR.Int16 := 1000;

rawUnion := dynConv.ConvertAnalogValueToRawValue(
	analogValue := 50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_INT(Expected := 500, Actual := rawUnion.Int16, Message := 'Initial dynamic scale');

// Modify max range dynamically at runtime
maxA := 200.0;

rawUnion := dynConv.ConvertAnalogValueToRawValue(
	analogValue := 50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_INT(Expected := 250, Actual := rawUnion.Int16, Message := 'Dynamically updated scale');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestRangeConverterBoundaryClampingAndZeroDivision" Id="{5e71ef60-8586-4c7d-9327-9418b0a980ee}" FolderPath="Tests\">
      <Declaration><![CDATA[(*!
<summary>Checks clamping and equal-limit conversion with raw limits supplied at construction.</summary>
<description>Constructor arguments contain the final raw values before the static converter copies them.</description>
*)
METHOD PRIVATE TestRangeConverterBoundaryClampingAndZeroDivision
VAR
	minRaw : TOF_Devices_IO.RAW_ANALOG_VALUE;
	clampConv : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 100.0,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 1000)
	);
	zeroConv : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 0.0,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0)
	);
	rawResult : TOF_Devices_IO.RAW_ANALOG_VALUE;
	analogResult : LREAL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'TestRangeConverterBoundaryClampingAndZeroDivision');

minRaw.Int32 := 0;
minRaw.Int16 := 0;

// Test clamping above maximum
rawResult := clampConv.ConvertAnalogValueToRawValue(
	analogValue := 150.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_INT(Expected := 1000, Actual := rawResult.Int16, Message := 'Clamped to max limit');

// Test clamping below minimum
rawResult := clampConv.ConvertAnalogValueToRawValue(
	analogValue := -50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_INT(Expected := 0, Actual := rawResult.Int16, Message := 'Clamped to min limit');

// Test equal limits (0 to 0) defense against Division by Zero
analogResult := zeroConv.ConvertRawValueToAnalogValue(
	rawValue := minRaw,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
AssertEquals_LREAL(
	Expected := 0.0,
	Actual := analogResult,
	Delta := 0.001,
	Message := 'Equal limits must safely return without Division by Zero'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>