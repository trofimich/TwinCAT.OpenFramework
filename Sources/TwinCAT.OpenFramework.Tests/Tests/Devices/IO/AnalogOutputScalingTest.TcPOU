<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AnalogOutputScalingTest" Id="{4ace37ab-816c-4339-abb9-aa1d155852c4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks direct analog output processing for a bound INT16 value.

Uses a live case-owned automation parent and fresh local device fixtures on every run.
The scenario reads and writes ordinary simulated storage within one task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AnalogOutputScalingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	// Live parent borrowed by the method-local simulated device.
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{16723a4b-4261-459b-8403-90317d1668ed}">
      <Declaration><![CDATA[(* Checks direct analog output processing for a bound INT16 value. *)
METHOD PROTECTED ExecuteTest
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	analogOutput : TOF_Devices_IO.AnalogOutput(name := "AO_Test", parent := _AutomationRoot, converter := converter);
	rawOutput : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[analogOutput.Initialize();
analogOutput.BindToInt16IO(rawVariable := rawOutput);

analogOutput.Value := 750.0;
analogOutput.ProcessOutput();

Assert.ThatInt(
	actual := rawOutput,
	message := "Raw INT output should match 750"
).ToBe(expected := 750);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{21c8e7e4-fd39-4de5-95c7-b70de6980f16}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3ba647c5-acbc-4cd4-895e-075b0c88aed0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{313841be-7ada-49d8-9970-db5914e2cfbc}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{783907fd-dad6-4a52-a118-a1ca46950546}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5221818f-89ef-45a6-8d39-a163041dde48}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d9785026-c99e-4167-9cb5-61052fbf0334}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
