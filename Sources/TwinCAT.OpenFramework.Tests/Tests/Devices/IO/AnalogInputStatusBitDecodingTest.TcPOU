(*
Checks status flags for individual bits and their reset.

Uses fresh method-local fixtures in a single task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AnalogInputStatusBitDecodingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c52dd20a-8197-486c-bbdc-69c336f8ca5c}">
      <Declaration><![CDATA[(* Checks status flags for individual bits and their reset. *)
METHOD PROTECTED ExecuteTest
VAR
	status : TOF_Devices_IO.ANALOG_INPUT_STATUS;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[status.SetStatus(status := 16#0001);
Assert.ThatBool(
	actual := status.Underrange,
	message := "Bit 0 must be Underrange"
).IsTrue();

status.SetStatus(status := 16#0002);
Assert.ThatBool(
	actual := status.Overrange,
	message := "Bit 1 must be Overrange"
).IsTrue();

status.SetStatus(status := 16#0004);
Assert.ThatBool(
	actual := status.ValueSmallerOrEqualLimit1,
	message := "Bit 2 must be Limit 1 smaller"
).IsTrue();

status.SetStatus(status := 16#0008);
Assert.ThatBool(
	actual := status.ValueBiggerOrEqualLimit1,
	message := "Bit 3 must be Limit 1 bigger"
).IsTrue();

status.SetStatus(status := 16#0010);
Assert.ThatBool(
	actual := status.ValueSmallerOrEqualLimit2,
	message := "Bit 4 must be Limit 2 smaller"
).IsTrue();

status.SetStatus(status := 16#0020);
Assert.ThatBool(
	actual := status.ValueBiggerOrEqualLimit2,
	message := "Bit 5 must be Limit 2 bigger"
).IsTrue();

status.SetStatus(status := 16#0040);
Assert.ThatBool(
	actual := status.Error,
	message := "Bit 6 must be Error"
).IsTrue();
Assert.ThatBool(
	actual := status.TxPDOState,
	message := "Bit 6 must NOT be TxPDOState"
).IsFalse();

status.SetStatus(status := 16#4000);
Assert.ThatBool(
	actual := status.TxPDOState,
	message := "Bit 14 must be TxPDOState"
).IsTrue();
Assert.ThatBool(
	actual := status.Error,
	message := "Bit 14 must NOT be Error"
).IsFalse();

status.SetStatus(status := 16#8000);
Assert.ThatBool(
	actual := status.TxPDOToggle,
	message := "Bit 15 must be TxPDOToggle"
).IsTrue();

status.SetStatus(status := WORD#16#C040);

Assert.ThatBool(
	actual := status.Error AND_THEN status.TxPDOState AND_THEN status.TxPDOToggle,
	message := "Bits 6, 14 and 15 must be independently active together"
).IsTrue();

status.SetStatus(status := WORD#0);

Assert.ThatBool(
	actual := NOT status.Error AND_THEN NOT status.TxPDOState AND_THEN NOT status.TxPDOToggle,
	message := "A zero status word must clear all three diagnostic flags"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{8f879ea0-fd66-46fd-ad97-cee682da8cd6}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5e02bd97-5f47-47ea-ae5f-43c93504e323}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
