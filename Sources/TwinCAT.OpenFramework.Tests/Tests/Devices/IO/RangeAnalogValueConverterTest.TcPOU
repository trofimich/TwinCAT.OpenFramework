(*!
<summary>Groups the three raw representations tested by the range converter suite.</summary>
<description>
Owns persistent child storage and fixed parent associations. Use in one task without reentry and do not copy the group.
Children is borrowed and must not be modified by application code. Constructor callbacks are not used.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RangeAnalogValueConverterTest EXTENDS TOF_Testing.TestGroup<3>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Test16Bit : RangeAnalogValueConverter16BitTest(name := "Test16Bit", parent := THIS^);
	_Test32Bit : RangeAnalogValueConverter32BitTest(name := "Test32Bit", parent := THIS^);
	_Test32Real : RangeAnalogValueConverter32RealTest(name := "Test32Real", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_Test16Bit,
		_Test32Bit,
		_Test32Real
	];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{3a70d424-b9aa-43e8-ae82-e6e3b348fcf7}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed array of this concrete group; do not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{59c5bb8e-cb9f-4013-ad08-7751882ea92d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{8d4d507f-46be-4526-a369-376788bb5a90}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d3e8a331-9150-434e-89fe-51b5432ad77e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{53d46b4f-752d-4973-98c9-8d9f4b8a93e6}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{19582c34-ba89-45dc-a127-2d14f2d0132c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{4e9cb01b-26c4-42f1-ae05-0e7d93b05e42}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{17ce538b-fea6-43df-9420-ac9cafcbffab}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>