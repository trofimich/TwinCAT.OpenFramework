<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DirectAnalogValueConverterTest" Id="{f23e0487-9aca-4c45-9b85-5bdf577e183b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
