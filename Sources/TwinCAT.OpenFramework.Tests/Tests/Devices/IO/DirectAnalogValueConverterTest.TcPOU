(*
Checks direct conversion of INT16, INT32 and REAL32 in both directions.

Uses fresh method-local fixtures in a single task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DirectAnalogValueConverterTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{0648e831-9d08-4b29-aba9-94bd6542f07d}">
      <Declaration><![CDATA[(* Checks direct conversion of INT16, INT32 and REAL32 in both directions. *)
METHOD PROTECTED ExecuteTest
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	rawResult : TOF_Devices_IO.RAW_ANALOG_VALUE;
	engineeringValue : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// INT16
rawResult := converter.ConvertAnalogValueToRawValue(
	analogValue := 1234.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatInt(
	actual := rawResult.Int16,
	message := "INT16 raw value 1:1"
).ToBe(expected := 1234);

engineeringValue := converter.ConvertRawValueToAnalogValue(
	rawValue := rawResult,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatLongReal(
	actual := engineeringValue,
	message := "INT16 analog value 1:1"
).ToBe(expected := 1234.0, tolerance := 0.001);

// INT32
rawResult := converter.ConvertAnalogValueToRawValue(
	analogValue := 100000.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatDInt(
	actual := rawResult.Int32,
	message := "INT32 raw value 1:1"
).ToBe(expected := 100000);

engineeringValue := converter.ConvertRawValueToAnalogValue(
	rawValue := rawResult,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT32
);
Assert.ThatLongReal(
	actual := engineeringValue,
	message := "INT32 analog value 1:1"
).ToBe(expected := 100000.0, tolerance := 0.001);

// REAL32 preserves both sign and fraction.
rawResult := converter.ConvertAnalogValueToRawValue(
	analogValue := LREAL#-12.75,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);

Assert.ThatReal(
	actual := rawResult.Real32,
	message := "Direct conversion must preserve the fractional REAL32 output"
).ToBe(expected := REAL#-12.75);

engineeringValue := converter.ConvertRawValueToAnalogValue(
	rawValue := rawResult,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);

Assert.ThatLongReal(
	actual := engineeringValue,
	message := "Direct conversion must preserve the fractional REAL32 input"
).ToBe(expected := LREAL#-12.75);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{5f9cc2d5-d25c-47c5-b927-228909f70c0e}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{41e8beef-4409-401e-97e6-f29fb169e0ef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b917dc10-fdba-49cf-ba1b-c94098b91c48}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8c590890-e583-47d3-b636-bb4bae2697ed}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{672c5713-40d4-4e15-8feb-8eb966fadb5d}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{36973167-4cd3-4ac1-a29b-c8dc28c21c1f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
