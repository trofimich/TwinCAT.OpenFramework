<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DigitalInputNormallyClosedTest" Id="{abee0954-0b0f-4551-b518-c01467414f49}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks input inversion for a normally closed contact.

Uses a live case-owned automation parent and fresh local device fixtures on every run.
The scenario reads and writes ordinary simulated storage within one task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DigitalInputNormallyClosedTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	// Live parent borrowed by the method-local simulated device.
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c9ff93da-5480-4635-8a84-36bb1862c3d8}">
      <Declaration><![CDATA[(* Checks input inversion for a normally closed contact. *)
METHOD PROTECTED ExecuteTest
VAR
	input : TOF_Devices_IO.DigitalInput(name := "DI_NC", parent := _AutomationRoot);
	rawInput : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[input.Initialize();
input.ContactType := TOF_Devices_IO.CONTACT_TYPE.NORMALLY_CLOSED;
input.BindToIO(rawValue := rawInput);

rawInput := FALSE;
input.ProcessInput();
Assert.ThatBool(
	actual := input.Value,
	message := "Value should be inverted TRUE for NC contact"
).IsTrue();

rawInput := TRUE;
input.ProcessInput();
Assert.ThatBool(
	actual := input.Value,
	message := "Value should be inverted FALSE for NC contact"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{4c3d2a6c-cf35-43fa-9523-9da68990790f}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f4b58111-a571-4052-af93-85a92a0aa28c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{dd41f36c-e9d2-4503-8b17-8863b91b141a}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a2474043-973c-4e10-995f-ab4e31f82096}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{60ce3482-2ce0-49f6-b825-bff8a5c9a0db}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e3bd5180-df3c-407b-b294-889afbf7aab4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
