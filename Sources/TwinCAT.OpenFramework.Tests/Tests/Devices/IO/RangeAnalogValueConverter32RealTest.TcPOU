<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RangeAnalogValueConverter32RealTest" Id="{410bff69-4294-42a1-a5f1-8a253cc0eb6a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks asymmetric fractional REAL32 scaling in both directions.

All expected values are exact binary fractions. The inputs expose unintended integer conversion.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RangeAnalogValueConverter32RealTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{894feee6-9385-4096-b48a-1c9c696d44f5}">
      <Declaration><![CDATA[(* Borrows the concrete class name for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d77a47ae-9722-4cbc-ab42-c79b1ddafa85}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{7ad94157-ab87-4fa0-ae4a-bcb4453db38b}">
      <Declaration><![CDATA[(* Checks fixed interpolation and clamping expectations in both conversion directions. *)
METHOD PROTECTED ExecuteTest
VAR
	fractionalRaw : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := -4,
		maxAnalogValue := 12,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromReal32(value := -2.75),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromReal32(value := 1.75)
	);

	rawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	analogValue : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[rawValue := fractionalRaw.ConvertAnalogValueToRawValue(
	analogValue := -8,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatReal(
	actual := rawValue.Real32,
	message := "Analog to raw clamps below its engineering minimum"
).ToBe(expected := -2.75);

rawValue := fractionalRaw.ConvertAnalogValueToRawValue(
	analogValue := 2,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatReal(
	actual := rawValue.Real32,
	message := "Analog to raw preserves fractional interpolation"
).ToBe(expected := -1.0625);

rawValue := fractionalRaw.ConvertAnalogValueToRawValue(
	analogValue := 8,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatReal(
	actual := rawValue.Real32,
	message := "Analog to raw preserves positive fractional interpolation"
).ToBe(expected := 0.625);

rawValue := fractionalRaw.ConvertAnalogValueToRawValue(
	analogValue := 16,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatReal(
	actual := rawValue.Real32,
	message := "Analog to raw clamps above its engineering maximum"
).ToBe(expected := 1.75);

analogValue := fractionalRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromReal32(value := -3),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog clamps below the fractional raw minimum"
).ToBe(expected := -4);

analogValue := fractionalRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromReal32(value := -1.0625),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog preserves the fractional raw input"
).ToBe(expected := 2);

analogValue := fractionalRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromReal32(value := 0.625),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog preserves the positive fractional raw input"
).ToBe(expected := 8);

analogValue := fractionalRaw.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromReal32(value := 2),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.REAL32
);
Assert.ThatLongReal(
	actual := analogValue,
	message := "Raw to analog clamps above the fractional raw maximum"
).ToBe(expected := 12);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{599a8955-4d50-42a5-8b2f-7c6186dc7ac2}">
      <Declaration><![CDATA[(* Borrows the compiler-initialized namespace for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b26e643c-6bd1-4c12-b2de-bec3eb0a198d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{87c48ebd-72e1-4238-857a-06ee531421d3}">
      <Declaration><![CDATA[(* Reports the complete concrete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c5eaa671-4cae-4076-bf76-f9401ea9f88f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
