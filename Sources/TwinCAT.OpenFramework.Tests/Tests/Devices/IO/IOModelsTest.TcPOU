<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IOModelsTest" Id="{79556a98-7c71-488a-956a-8b2d0f837253}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks selected IO model field contracts and simulated DINT/REAL channel binding.</summary>
<description>
Expected field representations and widths come from Beckhoff PDO specifications, not the model declarations.
ANY descriptors inspect type/size without reading or writing located input payloads. Binding scenarios use
persistent ordinary byte buffers and consumers; no located input variable is assigned and no hardware is required.
Compiled offsets locate fields within those buffers, not within EtherCAT packets. XAE mapping remains a manual check.
Catalog cases cover the corrected EP1809-0021/EP2809-0021 names and the EL3078 Real32 PDO representation.
Use one task and do not copy the suite while its consumers borrow the suite-owned storage.
IO fixtures borrow the suite-owned automation root so required-parent initialization is valid.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK IOModelsTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_PulseTrain : TOF_IOModels.EL2521;
	_CounterEncoder : TOF_IOModels.EL5152;
	_LatchedEncoder : TOF_IOModels.EL5151;
	_PowerMeasurement : TOF_IOModels.EL3413_EX;
	_GlobalStatusPowerMeasurement : TOF_IOModels.EL3403;
	_DirectPowerMeasurement : TOF_IOModels.EL3433;
	_Counter : TOF_IOModels.EL1502;
	_Load : TOF_IOModels.EL3356;
	_Pwm : TOF_IOModels.EL2502;
	_Serial : TOF_IOModels.EL6022;
	_DiscreteOutput : TOF_IOModels.EP2624_0002_EX;
	_SixteenChannelInput : TOF_IOModels.EP1809_0021_EX;
	_SixteenChannelOutput : TOF_IOModels.EP2809_0021_EX;
	_MultiRangeInput : TOF_IOModels.EL3078;
	_FieldAnalogInput : TOF_IOModels.EP3174_0002_EX;
	_FieldAnalogOutput : TOF_IOModels.EP4174_0002_EX;
	_FieldSerial : TOF_IOModels.EP6001_0002_EX;

	//! <summary>Live parent borrowed by the persistent IO consumers.</summary>
	_AutomationRoot : MockAutomationController(name := "IOModelsRoot");
	_Converter : TOF_Devices_IO.DirectAnalogValueConverter;
	_DintInput : TOF_Devices_IO.AnalogInput(name := "DintModelInput", parent := _AutomationRoot, converter := _Converter);
	_RealInput : TOF_Devices_IO.AnalogInput(name := "RealModelInput", parent := _AutomationRoot, converter := _Converter);
	//! <summary>Persistent ordinary storage for simulated inputs; capacity is guarded before access.</summary>
	_DintStorage : ARRAY [0..31] OF BYTE;
	_RealStorage : ARRAY [0..31] OF BYTE;
	_UnboundDint : REFERENCE TO TOF_IOModels.ANALOG_INPUT_DINT_CHANNEL;
	_UnboundReal : REFERENCE TO TOF_IOModels.ANALOG_INPUT_REAL_CHANNEL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[testPulseTrain();
testEncoderChannels();
testPowerMeasurement();
testAuxiliary();
testCounterAndLoad();
testSerialAndDiagnostics();
testDiscreteCatalog();
testAnalogRepresentations();
testDintBinding();
testRealBinding();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{4075a133-1ee4-4c20-b497-7b9ae22b70ad}">
      <Declaration><![CDATA[//! <summary>Borrows the static concrete suite name; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0f77ad29-664d-4d04-8420-f6d39bf474d0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[ClassName REF= _ClassName;]]></ST></Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a4d709d7-fa7e-4804-8b03-362999478a7b}">
      <Declaration><![CDATA[//! <summary>Borrows project namespace storage for the suite lifetime; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ebcc2d62-1508-4096-b5de-68785bead295}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST></Implementation>
      </Get>
    </Property>
    <Method Name="checkField" Id="{e27ca8c9-a144-4128-bc7c-54834e7e5382}">
      <Declaration><![CDATA[(*!
<summary>Compares the compiler-provided field descriptor with an independent PDO type/width expectation.</summary>
<description>Does not dereference or retain the ANY payload. Every caller passes a persistent field variable.</description>
<param name="value">Field variable whose IEC representation is inspected.</param>
<param name="expectedType">IEC type class required by the selected PDO.</param>
<param name="expectedSize">Required PDO field width in bytes, excluding aggregate padding.</param>
<param name="fieldName">Field identifier included in assertion diagnostics.</param>
*)
METHOD PRIVATE checkField
VAR_INPUT
	value : ANY;
	expectedType : __SYSTEM.TYPE_CLASS;
	expectedSize : DINT;
	fieldName : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertEquals_UDINT(
	Expected := TO_UDINT(expectedType),
	Actual := TO_UDINT(value.TypeClass),
	Message := fieldName
);
AssertEquals_DINT(
	Expected := expectedSize,
	Actual := value.diSize,
	Message := fieldName
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testPulseTrain" Id="{18661af0-82d4-4a0b-8a70-7090e4f5e2b7}">
      <Declaration><![CDATA[(*!
<summary>Checks field widths and IEC representations against the selected Beckhoff PDO specification.</summary>
<description>Checks an independent PDO specification or simulated input; no EtherCAT target is accessed.</description>
*)
METHOD PRIVATE testPulseTrain

VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'testPulseTrain');

checkField(
	value := _PulseTrain.Ch1.Out.Control,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_PulseTrain.Ch1.Out.Control'
);
checkField(
	value := _PulseTrain.Ch1.Out.Frequency,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UINT,
	expectedSize := 2,
	fieldName := '_PulseTrain.Ch1.Out.Frequency'
);
checkField(
	value := _PulseTrain.Ch1.Out.TargetCounterValue,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UDINT,
	expectedSize := 4,
	fieldName := '_PulseTrain.Ch1.Out.TargetCounterValue'
);
checkField(
	value := _PulseTrain.Ch1.Out.CounterControl,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_PulseTrain.Ch1.Out.CounterControl'
);
checkField(
	value := _PulseTrain.Ch1.Out.SetCounterValue,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UDINT,
	expectedSize := 4,
	fieldName := '_PulseTrain.Ch1.Out.SetCounterValue'
);
checkField(
	value := _PulseTrain.Ch1.In.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_PulseTrain.Ch1.In.Status'
);
checkField(
	value := _PulseTrain.Ch1.In.CounterStatus,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_PulseTrain.Ch1.In.CounterStatus'
);
checkField(
	value := _PulseTrain.Ch1.In.CounterValue,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UDINT,
	expectedSize := 4,
	fieldName := '_PulseTrain.Ch1.In.CounterValue'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
