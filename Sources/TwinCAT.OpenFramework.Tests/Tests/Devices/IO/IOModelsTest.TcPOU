    <Method Name="testSerialAndDiagnostics" Id="{d4ab624e-4e5e-4dba-b09c-492347372b09}">
      <Declaration><![CDATA[(*!
<summary>Checks field widths and IEC representations against the selected Beckhoff PDO specification.</summary>
<description>Checks an independent PDO specification or simulated input; no EtherCAT target is accessed.</description>
*)
METHOD PRIVATE testSerialAndDiagnostics

VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'testSerialAndDiagnostics');

checkField(
	value := _Serial.Ch1.InData.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_Serial.Ch1.InData.Status'
);
checkField(
	value := _Serial.Ch1.OutData.Control,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_Serial.Ch1.OutData.Control'
);
checkField(
	value := _PowerMeasurement.WcState,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_PowerMeasurement.WcState'
);
checkField(
	value := _PowerMeasurement.InputToggle,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_PowerMeasurement.InputToggle'
);
checkField(
	value := _PowerMeasurement.State,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UINT,
	expectedSize := 2,
	fieldName := '_PowerMeasurement.State'
);
checkField(
	value := _DiscreteOutput.WcState,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_DiscreteOutput.WcState'
);
checkField(
	value := _DiscreteOutput.State,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UINT,
	expectedSize := 2,
	fieldName := '_DiscreteOutput.State'
);
AssertEquals_UDINT(
	Expected := 22,
	Actual := SIZEOF(_Serial.Ch1.InData.Data),
	Message := 'Serial receive payload is 22 bytes'
);
AssertEquals_UDINT(
	Expected := 22,
	Actual := SIZEOF(_Serial.Ch1.OutData.Data),
	Message := 'Serial transmit payload is 22 bytes'
);
AssertEquals_UDINT(
	Expected := 8,
	Actual := SIZEOF(_PowerMeasurement.AdsAddr),
	Message := 'ADS address is NetId plus port'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDintBinding" Id="{22c983e0-25a2-4a9d-bb15-d2b68a1192a4}">
      <Declaration><![CDATA[(*!
<summary>Checks live signed/fractional compound input binding, recovery, unbinding and source preservation.</summary>
<description>Checks an independent PDO specification or simulated input; no EtherCAT target is accessed.</description>
*)
METHOD PRIVATE testDintBinding
VAR
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_DINT_CHANNEL;
	rawValue : DINT;
	rawStatus : WORD;
	valueOffset : UDINT;
	statusOffset : UDINT;
	originalBytes : ARRAY [0..31] OF BYTE;
	i : DINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'testDintBinding');

channel := ADR(_DintStorage);

IF SIZEOF(channel^) > SIZEOF(_DintStorage) THEN
	AssertTrue(
		Condition := FALSE,
		Message := 'Simulated channel storage is too small'
	);
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

valueOffset := TO_UDINT(ADR(channel^.Value) - ADR(channel^));
statusOffset := TO_UDINT(ADR(channel^.Status) - ADR(channel^));
rawValue := DINT#-123456789;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(_DintStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(_DintStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := 0 TO 31 DO
	originalBytes[i] := _DintStorage[i];
END_FOR

_DintInput.Initialize();
_DintInput.BindToInt32IO(rawValues := channel^);
_DintInput.ProcessInput();
AssertTrue(
	Condition := _DintInput.BoundToIO,
	Message := 'Valid channel must bind'
);
AssertEquals_LREAL(
	Expected := LREAL#-123456789.0,
	Actual := _DintInput.Value,
	Delta := 0.0,
	Message := 'Signed or fractional raw value must survive binding'
);

FOR i := 0 TO 31 DO
	AssertEquals_BYTE(
		Expected := originalBytes[i],
		Actual := _DintStorage[i],
		Message := 'Binding and processing must preserve the entire source buffer'
	);
END_FOR

rawStatus := WORD#16#0040;
Tc2_System.MEMCPY(
	destAddr := ADR(_DintStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);
_DintInput.ProcessInput();
AssertTrue(
	Condition := _DintInput.HasError,
	Message := 'Live channel error must be reported'
);
_DintInput.BindToInt32IO(rawValues := _UnboundDint);
_DintInput.ProcessInput();
AssertFalse(
	Condition := _DintInput.BoundToIO,
	Message := 'Invalid reference must unbind value'
);
AssertFalse(
	Condition := _DintInput.Status.Error,
	Message := 'Invalid reference must unbind status'
);

rawValue := DINT#7654321;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(_DintStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(_DintStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := 0 TO 31 DO
	originalBytes[i] := _DintStorage[i];
END_FOR

_DintInput.BindToInt32IO(rawValues := channel^);
_DintInput.ProcessInput();
AssertTrue(
	Condition := _DintInput.BoundToIO,
	Message := 'Recovered channel must bind again'
);
AssertEquals_LREAL(
	Expected := LREAL#7654321.0,
	Actual := _DintInput.Value,
	Delta := 0.0,
	Message := 'Rebinding must read the updated source'
);
AssertFalse(
	Condition := _DintInput.HasError,
	Message := 'Rebinding to recovered status must clear error'
);
_DintInput.BindToInt32IO(rawValues := _UnboundDint);

FOR i := 0 TO 31 DO
	AssertEquals_BYTE(
		Expected := originalBytes[i],
		Actual := _DintStorage[i],
		Message := 'Rebinding, processing and unbinding must preserve source bytes'
	);
END_FOR

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRealBinding" Id="{ffb65c6f-d713-4172-9310-56421a6325b5}">
      <Declaration><![CDATA[(*!
<summary>Checks live signed/fractional compound input binding, recovery, unbinding and source preservation.</summary>
<description>Checks an independent PDO specification or simulated input; no EtherCAT target is accessed.</description>
*)
METHOD PRIVATE testRealBinding
VAR
	channel : POINTER TO TOF_IOModels.ANALOG_INPUT_REAL_CHANNEL;
	rawValue : REAL;
	rawStatus : WORD;
	valueOffset : UDINT;
	statusOffset : UDINT;
	originalBytes : ARRAY [0..31] OF BYTE;
	i : DINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'testRealBinding');

channel := ADR(_RealStorage);

IF SIZEOF(channel^) > SIZEOF(_RealStorage) THEN
	AssertTrue(
		Condition := FALSE,
		Message := 'Simulated channel storage is too small'
	);
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

valueOffset := TO_UDINT(ADR(channel^.Value) - ADR(channel^));
statusOffset := TO_UDINT(ADR(channel^.Status) - ADR(channel^));
rawValue := REAL#-12.75;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(_RealStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(_RealStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := 0 TO 31 DO
	originalBytes[i] := _RealStorage[i];
END_FOR

_RealInput.Initialize();
_RealInput.BindToReal32IO(rawValues := channel^);
_RealInput.ProcessInput();
AssertTrue(
	Condition := _RealInput.BoundToIO,
	Message := 'Valid channel must bind'
);
AssertEquals_LREAL(
	Expected := LREAL#-12.75,
	Actual := _RealInput.Value,
	Delta := 0.0,
	Message := 'Signed or fractional raw value must survive binding'
);

FOR i := 0 TO 31 DO
	AssertEquals_BYTE(
		Expected := originalBytes[i],
		Actual := _RealStorage[i],
		Message := 'Binding and processing must preserve the entire source buffer'
	);
END_FOR

rawStatus := WORD#16#0040;
Tc2_System.MEMCPY(
	destAddr := ADR(_RealStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);
_RealInput.ProcessInput();
AssertTrue(
	Condition := _RealInput.HasError,
	Message := 'Live channel error must be reported'
);
_RealInput.BindToReal32IO(rawValues := _UnboundReal);
_RealInput.ProcessInput();
AssertFalse(
	Condition := _RealInput.BoundToIO,
	Message := 'Invalid reference must unbind value'
);
AssertFalse(
	Condition := _RealInput.Status.Error,
	Message := 'Invalid reference must unbind status'
);

rawValue := REAL#23.5;
rawStatus := WORD#0;
Tc2_System.MEMCPY(
	destAddr := ADR(_RealStorage[valueOffset]),
	srcAddr := ADR(rawValue),
	n := SIZEOF(rawValue)
);
Tc2_System.MEMCPY(
	destAddr := ADR(_RealStorage[statusOffset]),
	srcAddr := ADR(rawStatus),
	n := SIZEOF(rawStatus)
);

FOR i := 0 TO 31 DO
	originalBytes[i] := _RealStorage[i];
END_FOR

_RealInput.BindToReal32IO(rawValues := channel^);
_RealInput.ProcessInput();
AssertTrue(
	Condition := _RealInput.BoundToIO,
	Message := 'Recovered channel must bind again'
);
AssertEquals_LREAL(
	Expected := LREAL#23.5,
	Actual := _RealInput.Value,
	Delta := 0.0,
	Message := 'Rebinding must read the updated source'
);
AssertFalse(
	Condition := _RealInput.HasError,
	Message := 'Rebinding to recovered status must clear error'
);
_RealInput.BindToReal32IO(rawValues := _UnboundReal);

FOR i := 0 TO 31 DO
	AssertEquals_BYTE(
		Expected := originalBytes[i],
		Actual := _RealStorage[i],
		Message := 'Rebinding, processing and unbinding must preserve source bytes'
	);
END_FOR

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDiscreteCatalog" Id="{ab474bbe-8977-4023-929d-088d80e9c218}">
      <Declaration><![CDATA[(*!
<summary>Checks the corrected 16-channel EP product types and their boundary endpoints.</summary>
<description>
Uses Beckhoff ESI endpoint expectations; actual linking and mailbox absence require XAE inspection.
</description>
*)
METHOD PRIVATE testDiscreteCatalog
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'testDiscreteCatalog');

checkField(
	value := _SixteenChannelInput.Ch01,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelInput.Ch01'
);
checkField(
	value := _SixteenChannelInput.Ch16,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelInput.Ch16'
);
checkField(
	value := _SixteenChannelInput.WcState,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelInput.WcState'
);
checkField(
	value := _SixteenChannelInput.InputToggle,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelInput.InputToggle'
);
checkField(
	value := _SixteenChannelInput.State,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UINT,
	expectedSize := 2,
	fieldName := '_SixteenChannelInput.State'
);
checkField(
	value := _SixteenChannelOutput.Ch01,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelOutput.Ch01'
);
checkField(
	value := _SixteenChannelOutput.Ch16,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelOutput.Ch16'
);
checkField(
	value := _SixteenChannelOutput.WcState,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_SixteenChannelOutput.WcState'
);
checkField(
	value := _SixteenChannelOutput.State,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_UINT,
	expectedSize := 2,
	fieldName := '_SixteenChannelOutput.State'
);
checkField(
	value := _DiscreteOutput.Ch1,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_DiscreteOutput.Ch1'
);
checkField(
	value := _DiscreteOutput.Ch4,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_BOOL,
	expectedSize := 1,
	fieldName := '_DiscreteOutput.Ch4'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testAnalogRepresentations" Id="{7c169933-3ad5-4c19-a320-1976604f4c7c}">
      <Declaration><![CDATA[(*!
<summary>Checks EL3078 Real32 and the preserved analog/serial EP endpoints.</summary>
<description>
Uses Beckhoff ESI endpoint expectations; actual linking and mailbox absence require XAE inspection.
</description>
*)
METHOD PRIVATE testAnalogRepresentations
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'testAnalogRepresentations');

checkField(
	value := _MultiRangeInput.Ch1.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_MultiRangeInput.Ch1.Status'
);
checkField(
	value := _MultiRangeInput.Ch1.Value,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_REAL,
	expectedSize := 4,
	fieldName := '_MultiRangeInput.Ch1.Value'
);
checkField(
	value := _MultiRangeInput.Ch8.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_MultiRangeInput.Ch8.Status'
);
checkField(
	value := _MultiRangeInput.Ch8.Value,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_REAL,
	expectedSize := 4,
	fieldName := '_MultiRangeInput.Ch8.Value'
);
checkField(
	value := _FieldAnalogInput.Ch4.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_FieldAnalogInput.Ch4.Status'
);
checkField(
	value := _FieldAnalogInput.Ch4.Value,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_INT,
	expectedSize := 2,
	fieldName := '_FieldAnalogInput.Ch4.Value'
);
checkField(
	value := _FieldAnalogOutput.Ch4,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_INT,
	expectedSize := 2,
	fieldName := '_FieldAnalogOutput.Ch4'
);
checkField(
	value := _FieldSerial.Ch1.InData.Status,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_FieldSerial.Ch1.InData.Status'
);
checkField(
	value := _FieldSerial.Ch1.OutData.Control,
	expectedType := __SYSTEM.TYPE_CLASS.TYPE_WORD,
	expectedSize := 2,
	fieldName := '_FieldSerial.Ch1.OutData.Control'
);

AssertEquals_UDINT(
	Expected := 8,
	Actual := SIZEOF(_FieldAnalogInput.AdsAddr),
	Message := '_FieldAnalogInput retains the supported CoE ADS endpoint'
);
AssertEquals_UDINT(
	Expected := 8,
	Actual := SIZEOF(_FieldAnalogOutput.AdsAddr),
	Message := '_FieldAnalogOutput retains the supported CoE ADS endpoint'
);
AssertEquals_UDINT(
	Expected := 8,
	Actual := SIZEOF(_FieldSerial.AdsAddr),
	Message := '_FieldSerial retains the supported CoE ADS endpoint'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>