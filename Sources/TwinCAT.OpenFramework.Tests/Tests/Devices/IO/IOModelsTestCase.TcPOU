<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IOModelsTestCase" Id="{a385496c-69b2-4053-a89c-98beee8a75d8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs one IO model scenario and reports its own outcome.</summary>
<description>Borrows its group as the scenario provider. Use the group and its cases from a single task.</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK IOModelsTestCase EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Fixture : IIOModelsTestFixture;
	_Scenario : IO_MODELS_TEST_SCENARIO;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{23f311b8-ef96-48d1-8c32-d2e934e0aa1d}">
      <Declaration><![CDATA[(*!
<summary>Stores the case scenario and its borrowed provider without invoking it.</summary>
<param name="name">Name reported for the individual case.</param>
<param name="parent">Group that owns this case.</param>
<param name="fixture">Scenario provider that outlives the case.</param>
<param name="scenario">Scenario selected for the case.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	fixture : IIOModelsTestFixture;
	scenario : IO_MODELS_TEST_SCENARIO;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_Fixture := fixture;
	_Scenario := scenario;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{3c242d86-4862-429f-8228-a22396c1c3f2}">
      <Declaration><![CDATA[(*!
<summary>Executes the selected scenario using the assertion context of this run.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Fixture = 0 THEN
	RecordFailure(message := "Missing IO model scenario provider");

	RETURN;
END_IF

assertions REF= Assert;
_Fixture.ExecuteScenario(scenario := _Scenario, assertions := assertions);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{85fee63b-38c5-41cf-bf20-e26fd7348132}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dcb1f06f-f8da-4734-9597-b82b39369828}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c40f7db5-69af-4dbc-a658-cbfc6b879114}">
      <Declaration><![CDATA[(*!
<summary>Borrows the project namespace name. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a8e192de-1fb1-4a1e-a01d-e954ec5aad56}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{4b35546b-0a51-42c9-a304-2903e3f98293}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{412676f7-b8e2-47fd-826c-aa53ab35c9e9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
