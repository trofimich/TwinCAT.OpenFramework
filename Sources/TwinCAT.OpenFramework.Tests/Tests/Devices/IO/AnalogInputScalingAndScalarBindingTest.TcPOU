SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks scalar INT16 binding and positive and negative input values.

Uses a live case-owned automation parent and fresh local device fixtures on every run.
The scenario reads and writes ordinary simulated storage within one task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AnalogInputScalingAndScalarBindingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	// Live parent borrowed by the method-local simulated device.
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{83052bcc-187a-477e-986d-a457148425a5}">
      <Declaration><![CDATA[(* Checks scalar INT16 binding and positive and negative input values. *)
METHOD PROTECTED ExecuteTest
VAR
	converter : TOF_Devices_IO.DirectAnalogValueConverter;
	analogInput : TOF_Devices_IO.AnalogInput(name := "AI_Scalar", parent := _AutomationRoot, converter := converter);
	rawInput : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[analogInput.Initialize();
analogInput.BindToInt16Value(rawValue := rawInput);

Assert.ThatBool(
	actual := analogInput.BoundToIO,
	message := "AnalogInput should be BoundToIO after BindToInt16Value"
).IsTrue();

rawInput := 5678;
analogInput.ProcessInput();

Assert.ThatLongReal(
	actual := analogInput.Value,
	message := "AnalogInput.Value should match raw INT input"
).ToBe(expected := 5678.0, tolerance := 0.001);

Assert.ThatBool(
	actual := analogInput.HasError,
	message := "AnalogInput should work without error when status is unbound"
).IsFalse();

rawInput := INT#-1234;
analogInput.ProcessInput();

Assert.ThatLongReal(
	actual := analogInput.Value,
	message := "Scalar input processing must preserve the INT16 sign"
).ToBe(expected := LREAL#-1234.0);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6d73bd62-6bfa-49dc-ae6a-03b4cfa97410}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5c0d7d75-74b5-4db8-bff2-adb943fe081a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1a5d5c9a-b753-401f-9e69-2b016e511fd2}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{949d7944-8be1-4cfd-989e-5e1812b83801}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{af2b9357-3c7c-43aa-bd9a-8d625e28f0ca}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8a9b890d-8a32-4944-aebb-3c5de5c1004b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
