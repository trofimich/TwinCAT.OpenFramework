<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AnalogInputScalingAndScalarBindingTest" Id="{34e9d6aa-3a90-4250-824c-8a44f0e2cd93}" SpecialFunc="None">
    <Declaration><![CDATA[(*
