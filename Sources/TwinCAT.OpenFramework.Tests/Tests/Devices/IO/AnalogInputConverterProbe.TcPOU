<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AnalogInputConverterProbe" Id="{8bbd52ce-f172-48f7-b399-9ac0c53b5746}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides pass-through conversion with a selectable input failure for diagnostics tests.</summary>
<description>Uses the direct converter for successful input conversion and all output conversion.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FINAL AnalogInputConverterProbe EXTENDS TOF_Devices_IO.DirectAnalogValueConverter
VAR_INPUT
	//! <summary>Raises a standard exception with this text on input conversion when the message is nonempty.</summary>
	failureMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ConvertRawValueToAnalogValue" Id="{c0d33f0c-4c7a-423b-91f5-52647365f688}">
      <Declaration><![CDATA[(*!
<summary>Converts the raw input or raises the injected failure for the input's exception policy.</summary>
<param name="rawValue">Raw channel value.</param>
<param name="rawValueType">Representation of the raw value.</param>
*)
METHOD ConvertRawValueToAnalogValue : LREAL
VAR_INPUT
	rawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	rawValueType : TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF failureMessage <> "" THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := failureMessage
	);
END_IF

ConvertRawValueToAnalogValue := SUPER^.ConvertRawValueToAnalogValue(
	rawValue := rawValue,
	rawValueType := rawValueType
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
