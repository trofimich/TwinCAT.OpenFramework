<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicRangeAnalogValueConverterTest" Id="{0f28cc33-5f83-4818-9a0c-a90b49419956}" SpecialFunc="None">
    <Declaration><![CDATA[(*
