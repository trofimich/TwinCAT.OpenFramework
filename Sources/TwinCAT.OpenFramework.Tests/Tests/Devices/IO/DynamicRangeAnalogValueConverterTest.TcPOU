(*
Checks live changes of referenced engineering and raw limits.

Uses fresh method-local fixtures in a single task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicRangeAnalogValueConverterTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{450ccd1e-e6a9-4ba8-93a3-a1cad96bbdf9}">
      <Declaration><![CDATA[(* Checks live changes of referenced engineering and raw limits. *)
METHOD PROTECTED ExecuteTest
VAR
	minimumEngineeringValue : LREAL := 0.0;
	maximumEngineeringValue : LREAL := 100.0;
	minimumRawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	maximumRawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	converter : TOF_Devices_IO.DynamicRangeAnalogValueConverter(
		minAnalogValue := minimumEngineeringValue,
		maxAnalogValue := maximumEngineeringValue,
		minRawValue := minimumRawValue,
		maxRawValue := maximumRawValue
	);
	rawResult : TOF_Devices_IO.RAW_ANALOG_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[minimumRawValue.Int32 := 0;
minimumRawValue.Int16 := 0;
maximumRawValue.Int32 := 0;
maximumRawValue.Int16 := 1000;

rawResult := converter.ConvertAnalogValueToRawValue(
	analogValue := 50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatInt(
	actual := rawResult.Int16,
	message := "Initial dynamic scale"
).ToBe(expected := 500);

// Change the referenced engineering limit.
maximumEngineeringValue := 200.0;

rawResult := converter.ConvertAnalogValueToRawValue(
	analogValue := 50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatInt(
	actual := rawResult.Int16,
	message := "Dynamically updated scale"
).ToBe(expected := 250);

maximumRawValue.Int16 := INT#2000;
rawResult := converter.ConvertAnalogValueToRawValue(
	analogValue := LREAL#50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);

Assert.ThatInt(
	actual := rawResult.Int16,
	message := "Changing the referenced raw maximum must update the scale"
).ToBe(expected := INT#500);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{f3111f2f-bff8-4fa1-8680-735bfe65aeba}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2a3e0426-407e-44e1-b9ad-1541f793b400}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{3f2e59d1-1dc9-4c20-9461-bdda43db5862}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0ff83154-0e50-4841-bb11-d32dfebbeaea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{900bec67-b843-4846-a959-facd350d2a13}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{32965159-cbdf-4aab-99ef-00f10b2dc30f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
