<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IOModelsTestGroup" Id="{f4cd0c85-f6e0-4c50-8eef-4aba8d138aa6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups PDO representation and simulated analog input binding scenarios.</summary>
<description>
Owns ten persistent cases and their fixed child array. Borrows the runner field containing the interface to
the controller-owned model fixture. The runner, fixture and children share one task and lifetime.
The group must not be copied because its children are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK IOModelsTestGroup EXTENDS TOF_Testing.TestGroup<10> IMPLEMENTS IIOModelsTestFixture
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_FixtureSlot : POINTER TO IIOModelsTestFixture;
END_VAR
VAR
	_PulseTrain : IOModelsTestCase(
		name := "testPulseTrain",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.PULSE_TRAIN
	);
	_EncoderChannels : IOModelsTestCase(
		name := "testEncoderChannels",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.ENCODER_CHANNELS
	);
	_PowerMeasurement : IOModelsTestCase(
		name := "testPowerMeasurement",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.POWER_MEASUREMENT
	);
	_Auxiliary : IOModelsTestCase(
		name := "testAuxiliary",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.AUXILIARY
	);
	_CounterAndLoad : IOModelsTestCase(
		name := "testCounterAndLoad",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.COUNTER_AND_LOAD
	);
	_SerialAndDiagnostics : IOModelsTestCase(
		name := "testSerialAndDiagnostics",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.SERIAL_AND_DIAGNOSTICS
	);
	_DiscreteCatalog : IOModelsTestCase(
		name := "testDiscreteCatalog",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.DISCRETE_CATALOG
	);
	_AnalogRepresentations : IOModelsTestCase(
		name := "testAnalogRepresentations",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.ANALOG_REPRESENTATIONS
	);
	_DintBinding : IOModelsTestCase(
		name := "testDintBinding",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.DINT_BINDING
	);
	_RealBinding : IOModelsTestCase(
		name := "testRealBinding",
		parent := THIS^,
		fixture := THIS^,
		scenario := IO_MODELS_TEST_SCENARIO.REAL_BINDING
	);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_PulseTrain,
		_EncoderChannels,
		_PowerMeasurement,
		_Auxiliary,
		_CounterAndLoad,
		_SerialAndDiagnostics,
		_DiscreteCatalog,
		_AnalogRepresentations,
		_DintBinding,
		_RealBinding
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{f7859096-bb75-4421-b708-ed59ce6f7b8d}">
      <Declaration><![CDATA[(*!
<summary>Stores the address of the runner-owned fixture slot.</summary>
<description>Does not read the slot during initialization. The slot stays alive until after the group exits.</description>
<param name="name">Display name of the group.</param>
<param name="parent">Owning group or zero for a runner root.</param>
<param name="fixtureSlot">Address of the stable variable holding the controller fixture interface.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	fixtureSlot : POINTER TO IIOModelsTestFixture;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_FixtureSlot := fixtureSlot;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteScenario" Id="{87189697-b94a-4061-a6aa-bdd694d82958}">
      <Declaration><![CDATA[(*!
<summary>Runs one IO model scenario and reports to the current case.</summary>
<description>Use from the owning test task. The fixture never retains assertions.</description>
<param name="scenario">Scenario assigned to the caller.</param>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD ExecuteScenario
VAR_INPUT
	scenario : IO_MODELS_TEST_SCENARIO;
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	fixture : IIOModelsTestFixture;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _FixtureSlot <> 0 THEN
	fixture := _FixtureSlot^;
END_IF

IF fixture = 0 THEN
	assertions.ThatBool(actual := FALSE, message := "Missing IO model fixture").IsTrue();

	RETURN;
END_IF

fixture.ExecuteScenario(scenario := scenario, assertions := assertions);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Children" Id="{06e23896-453b-4ad9-93bc-d521de689632}">
      <Declaration><![CDATA[(*!
<summary>Borrows the persistent case array. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{913d4017-e244-4205-a1a2-ad3b3c13000d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{d834c2fb-7290-43ab-ac3a-371193b0a987}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5c4151c9-2ec3-499c-90ba-befee8900f4c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{8e754a94-155e-45a6-9c36-9079ea29020c}">
      <Declaration><![CDATA[(*!
<summary>Borrows the project namespace name. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2136584e-7f1a-44f2-b502-7c5b61945a0c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a5c341ed-0e35-4460-9b25-6d15057b1e04}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f51e6fd2-71c7-46f5-a2f6-5fca548ce3d8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
