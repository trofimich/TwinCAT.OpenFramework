(*!
<summary>Exposes the IO model scenarios to a single-cycle test case.</summary>
*)

INTERFACE IIOModelsTestFixture]]></Declaration>
    <Method Name="ExecuteScenario" Id="{8b017c76-2568-4ae5-ba68-45bf441b54cf}">
      <Declaration><![CDATA[(*!
<summary>Runs one IO model scenario and reports to the current case.</summary>
<description>Use from the owning test task. The fixture never retains assertions.</description>
<param name="scenario">Scenario assigned to the caller.</param>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD ExecuteScenario
VAR_INPUT
	scenario : IO_MODELS_TEST_SCENARIO;
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
    </Method>
  </Itf>
