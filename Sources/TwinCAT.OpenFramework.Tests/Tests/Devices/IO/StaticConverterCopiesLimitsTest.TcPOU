<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticConverterCopiesLimitsTest" Id="{cc0326de-065d-4c04-9f6b-dc18eeb7e59e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
