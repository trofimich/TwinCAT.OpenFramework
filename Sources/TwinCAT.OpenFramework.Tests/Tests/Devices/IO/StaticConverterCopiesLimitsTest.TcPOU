(*!
<summary>Checks independent copies of the configured converter limits.</summary>
<description>
Uses fresh method-local fixtures in a single task cycle.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticConverterCopiesLimitsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{46a68645-e5fa-41bb-8a0b-e2c052a8cd97}">
      <Declaration><![CDATA[(*!
<summary>Checks independent copies of the configured converter limits.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	minRaw : TOF_Devices_IO.RAW_ANALOG_VALUE;
	maxRaw : TOF_Devices_IO.RAW_ANALOG_VALUE := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 1000);
	converter : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 100.0,
		minRawValue := minRaw,
		maxRawValue := maxRaw
	);
	resultRaw : TOF_Devices_IO.RAW_ANALOG_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Changing source unions must not change the stored constructor limits.
maxRaw.Int32 := 0;

Assert.ThatLongReal(
	actual := converter.MaxAnalogValue,
	message := "Constructor must preserve the configured analog maximum"
).ToBe(expected := 100.0, tolerance := 0.001);

resultRaw := converter.ConvertAnalogValueToRawValue(
	analogValue := 50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);

Assert.ThatInt(
	actual := resultRaw.Int16,
	message := "Conversion must use copied raw limits after the source changes"
).ToBe(expected := 500);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{fd370106-b7f3-440d-8afe-83cff526ae1b}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{352350eb-d115-4bc5-ba19-08779c990264}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ac059068-bed8-4081-93b1-9172c0c1a0c0}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dc171621-b899-45dd-8702-e1509b4a0473}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{cf8499fd-ed0a-4bf7-8a55-a972d07db39f}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7d9c5c8b-693d-4b59-9e9f-6a97ea7c9c3e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
