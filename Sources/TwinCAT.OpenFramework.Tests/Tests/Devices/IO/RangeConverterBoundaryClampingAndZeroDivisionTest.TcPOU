(*
Checks clamping and conversion with equal limits.

Uses fresh method-local fixtures in a single task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RangeConverterBoundaryClampingAndZeroDivisionTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{bec58634-3db7-400f-b9d8-9ee5550aa084}">
      <Declaration><![CDATA[(* Checks clamping and conversion with equal limits. *)
METHOD PROTECTED ExecuteTest
VAR
	minRaw : TOF_Devices_IO.RAW_ANALOG_VALUE;
	clampingConverter : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 100.0,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 1000)
	);
	equalLimitsConverter : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 0.0,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0)
	);
	rawResult : TOF_Devices_IO.RAW_ANALOG_VALUE;
	analogResult : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[minRaw.Int32 := 0;
minRaw.Int16 := 0;

// Test clamping above maximum
rawResult := clampingConverter.ConvertAnalogValueToRawValue(
	analogValue := 150.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatInt(
	actual := rawResult.Int16,
	message := "Clamped to max limit"
).ToBe(expected := 1000);

// Test clamping below minimum
rawResult := clampingConverter.ConvertAnalogValueToRawValue(
	analogValue := -50.0,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatInt(
	actual := rawResult.Int16,
	message := "Clamped to min limit"
).ToBe(expected := 0);

// Test equal limits (0 to 0) defense against Division by Zero
analogResult := equalLimitsConverter.ConvertRawValueToAnalogValue(
	rawValue := minRaw,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);
Assert.ThatLongReal(
	actual := analogResult,
	message := "Equal limits must safely return without Division by Zero"
).ToBe(expected := 0.0, tolerance := 0.001);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{79fbd76d-3423-4fe7-ad5d-25a2b8af0abf}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3d1fea1c-6fcb-4d83-b317-f975f43f2e84}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7af7b5a1-e3d9-464e-82a3-a86fd8ca75ad}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e5a4d522-fae9-4f72-93ea-279662370ed4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{60342af6-b4f6-4847-9429-1aba7a46f535}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4895352b-4736-4d4a-99f6-51ab0c49d10d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
