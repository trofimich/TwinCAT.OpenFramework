<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RangeConverterBoundaryClampingAndZeroDivisionTest" Id="{0ecc9723-c631-4617-9621-62aba81db0f8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
