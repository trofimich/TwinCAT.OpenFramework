<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DevicesIOTestGroup" Id="{285dd7fd-1659-44bf-b5ba-390dc1a10611}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups digital and analog device, simulated channel and conversion cases.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DevicesIOTestGroup EXTENDS TOF_Testing.TestGroup<17>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_TestDigitalInputNormallyOpen : DigitalInputNormallyOpenTest(name := "TestDigitalInputNormallyOpen", parent := THIS^);
	_TestDigitalInputNormallyClosed : DigitalInputNormallyClosedTest(
		name := "TestDigitalInputNormallyClosed",
		parent := THIS^
	);
	_TestDigitalInputUnbound : DigitalInputUnboundTest(name := "TestDigitalInputUnbound", parent := THIS^);
	_TestDigitalOutputNormallyOpen : DigitalOutputNormallyOpenTest(
		name := "TestDigitalOutputNormallyOpen",
		parent := THIS^
	);
	_TestDigitalOutputNormallyClosed : DigitalOutputNormallyClosedTest(
		name := "TestDigitalOutputNormallyClosed",
		parent := THIS^
	);
	_TestDirectAnalogValueConverter : DirectAnalogValueConverterTest(
		name := "TestDirectAnalogValueConverter",
		parent := THIS^
	);
	_TestAnalogInputScalingAndScalarBinding : AnalogInputScalingAndScalarBindingTest(
		name := "TestAnalogInputScalingAndScalarBinding",
		parent := THIS^
	);
	_TestAnalogInputChannelStatusAndErrorReporting : AnalogInputChannelStatusAndErrorReportingTest(
		name := "TestAnalogInputChannelStatusAndErrorReporting",
		parent := THIS^
	);
	_TestAnalogInputConverterRecovery : AnalogInputConverterRecoveryTest(
		name := "TestAnalogInputConverterRecovery",
		parent := THIS^
	);
	_TestAnalogInputCriticalConversionError : AnalogInputCriticalConversionErrorTest(
		name := "TestAnalogInputCriticalConversionError",
		parent := THIS^
	);
	_TestAnalogInputStatusWordIsolation : AnalogInputStatusWordIsolationTest(
		name := "TestAnalogInputStatusWordIsolation",
		parent := THIS^
	);
	_TestAnalogInputStatusBitDecoding : AnalogInputStatusBitDecodingTest(
		name := "TestAnalogInputStatusBitDecoding",
		parent := THIS^
	);
	_TestAnalogOutputScaling : AnalogOutputScalingTest(name := "TestAnalogOutputScaling", parent := THIS^);
	_TestAnalogOutputEqualRawLimits : AnalogOutputEqualRawLimitsTest(
		name := "TestAnalogOutputEqualRawLimits",
		parent := THIS^
	);
	_TestDynamicRangeAnalogValueConverter : DynamicRangeAnalogValueConverterTest(
		name := "TestDynamicRangeAnalogValueConverter",
		parent := THIS^
	);
	_TestStaticConverterCopiesLimits : StaticConverterCopiesLimitsTest(
		name := "TestStaticConverterCopiesLimits",
		parent := THIS^
	);
	_TestRangeConverterBoundaryClampingAndZeroDivision : RangeConverterBoundaryClampingAndZeroDivisionTest(
		name := "TestRangeConverterBoundaryClampingAndZeroDivision",
		parent := THIS^
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_TestDigitalInputNormallyOpen,
		_TestDigitalInputNormallyClosed,
		_TestDigitalInputUnbound,
		_TestDigitalOutputNormallyOpen,
		_TestDigitalOutputNormallyClosed,
		_TestDirectAnalogValueConverter,
		_TestAnalogInputScalingAndScalarBinding,
		_TestAnalogInputChannelStatusAndErrorReporting,
		_TestAnalogInputConverterRecovery,
		_TestAnalogInputCriticalConversionError,
		_TestAnalogInputStatusWordIsolation,
		_TestAnalogInputStatusBitDecoding,
		_TestAnalogOutputScaling,
		_TestAnalogOutputEqualRawLimits,
		_TestDynamicRangeAnalogValueConverter,
		_TestStaticConverterCopiesLimits,
		_TestRangeConverterBoundaryClampingAndZeroDivision
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{b71d3749-45b9-4246-be5f-2c8c421d9b16}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{1ab1370c-1d99-49fd-a6ba-9097911c1431}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{34b1bbe0-059b-4a6b-8d39-627ada69e926}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5f77fce7-0b0d-4a33-8ff3-d7a5065b1f18}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{88b38260-8d3e-46fe-acaf-0593d5de0540}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ad276b0a-0f9e-4cff-82e0-b3f9e97899d8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f6451331-bd11-4fe0-a224-55ce74714645}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{43d19851-76b7-4b01-bf5a-2014161d3d43}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
