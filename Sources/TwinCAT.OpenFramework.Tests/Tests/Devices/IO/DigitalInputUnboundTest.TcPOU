<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DigitalInputUnboundTest" Id="{97c1f8c4-5377-41c7-9dab-d4389069199e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks the unbound input value and diagnostic state.</summary>
<description>
Uses a live case-owned automation parent and fresh local device fixtures on every run.
The scenario reads and writes ordinary simulated storage within one task cycle.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DigitalInputUnboundTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	//! <summary>Live parent borrowed by the method-local simulated device.</summary>
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{7d0b4e1a-d210-46a3-b858-0a35b379bbd5}">
      <Declaration><![CDATA[(*!
<summary>Checks the unbound input value and diagnostic state.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	input : TOF_Devices_IO.DigitalInput(name := "DI_Unbound", parent := _AutomationRoot);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[input.Initialize();
Assert.ThatBool(
	actual := input.BoundToIO,
	message := "BoundToIO should be FALSE"
).IsFalse();

input.ProcessInput();
Assert.ThatBool(
	actual := input.Value,
	message := "Value should default to FALSE"
).IsFalse();
Assert.ThatBool(
	actual := input.HasError,
	message := "Unbound input should not report error"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{f206978a-b583-4fa4-811d-6a5173ba9bb2}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7cd5f3c4-c0ac-4350-a020-87abf12decf2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{3d14ef06-71ea-490e-ba7a-a4bb81b9d453}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c129acfc-23e0-4165-901d-b9dc256f603d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{ba2a935a-37dc-4e01-b8a9-bade6fb98577}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{20f946b5-490c-4fac-88ce-74c8204d8eb7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
