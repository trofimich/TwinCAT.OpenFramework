(*!
<summary>Records automatic execution error recoveries for analog input tests.</summary>
<description>Uses the inherited analog input constructor, processing, and error handling.</description>
*)
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FINAL AnalogInputRecoveryProbe EXTENDS TOF_Devices_IO.AnalogInput
VAR
	_RecoveryCalls : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="OnRecover" Id="{df5058c8-ef9e-4ead-b573-aadfe29f3931}">
      <Declaration><![CDATA[(*!
<summary>Counts the recovery callback issued by Execute().</summary>
*)
METHOD PROTECTED OnRecover]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RecoveryCalls := _RecoveryCalls + UDINT#1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="RecoveryCalls" Id="{8dbae345-0861-4232-b263-6e426b022de5}">
      <Declaration><![CDATA[(*!
<summary>Gets the number of recovery callbacks received by this instance.</summary>
*)
PROPERTY RecoveryCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{c278a49e-d1bc-405a-aa6b-7d4e98e7ab0c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RecoveryCalls := _RecoveryCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
