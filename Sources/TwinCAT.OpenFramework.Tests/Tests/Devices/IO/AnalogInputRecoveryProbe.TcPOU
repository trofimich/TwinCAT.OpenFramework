<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AnalogInputRecoveryProbe" Id="{651d0ebf-17f4-4020-a80c-5bdcb4d1cb93}" SpecialFunc="None">
    <Declaration><![CDATA[(*
