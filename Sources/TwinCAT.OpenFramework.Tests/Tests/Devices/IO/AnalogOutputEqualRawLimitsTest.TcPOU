(*
Checks output with equal raw limits for INT16, INT32 and REAL32.

Uses a live case-owned automation parent and fresh local device fixtures on every run.
The scenario reads and writes ordinary simulated storage within one task cycle.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AnalogOutputEqualRawLimitsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	// Live parent borrowed by the method-local simulated device.
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a9e67963-8996-4093-8929-e0ccd31eae69}">
      <Declaration><![CDATA[(* Checks output with equal raw limits for INT16, INT32 and REAL32. *)
METHOD PROTECTED ExecuteTest
VAR
	minEngineeringValue : LREAL := 0.0;
	maxEngineeringValue : LREAL := 100.0;
	minRawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	maxRawValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
	converter : TOF_Devices_IO.DynamicRangeAnalogValueConverter(
		minAnalogValue := minEngineeringValue,
		maxAnalogValue := maxEngineeringValue,
		minRawValue := minRawValue,
		maxRawValue := maxRawValue
	);
	analogOutput : TOF_Devices_IO.AnalogOutput(
		name := "AO_EqualRawLimits",
		parent := _AutomationRoot,
		converter := converter
	);

	rawInt16Output : INT;
	rawInt32Output : DINT;
	rawReal32Output : REAL;
	convertedValue : TOF_Devices_IO.RAW_ANALOG_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[analogOutput.Initialize();
analogOutput.Value := 50.0;

// Fill the upper two bytes of the INT16 limit to verify that they are cleared in the result.
minRawValue.Int32 := DINT#16#12340000;
minRawValue.Int16 := INT#-1;
maxRawValue := minRawValue;

analogOutput.BindToInt16IO(rawVariable := rawInt16Output);
analogOutput.ProcessOutput();

Assert.ThatInt(
	actual := rawInt16Output,
	message := "Equal INT16 limits must be written to the bound INT output"
).ToBe(expected := INT#-1);

convertedValue := converter.ConvertAnalogValueToRawValue(
	analogValue := analogOutput.Value,
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);

Assert.ThatDInt(
	actual := convertedValue.Int32,
	message := "The INT16 result must have zero upper bytes"
).ToBe(expected := DINT#16#0000FFFF);

minRawValue.Int32 := DINT#-1;
maxRawValue := minRawValue;

analogOutput.BindToInt32IO(rawVariable := rawInt32Output);
analogOutput.ProcessOutput();

Assert.ThatDInt(
	actual := rawInt32Output,
	message := "Equal INT32 limits must be written to the bound DINT output"
).ToBe(expected := DINT#-1);

minRawValue.Real32 := REAL#1.0;
maxRawValue := minRawValue;

analogOutput.BindToReal32IO(rawVariable := rawReal32Output);
analogOutput.ProcessOutput();

Assert.ThatReal(
	actual := rawReal32Output,
	message := "Equal REAL32 limits must be written to the bound REAL output"
).ToBe(expected := REAL#1.0);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6a94c1b5-4d48-4200-bae0-076b326c4981}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2100e160-891d-4988-8e92-69f954c5ae40}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{84d0bc00-bad3-4723-96d2-35f762cf6194}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dd28a64d-71b5-4d02-9f34-a7b61e27fa7f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{65871be4-f2ee-452c-84a9-d6dcf112cc01}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9369a612-ba0c-4b86-a7de-81a803ce5983}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
