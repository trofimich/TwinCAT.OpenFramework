<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AnalogOutputEqualRawLimitsTest" Id="{eb522c63-9341-43e4-baa9-a26d42b7da8f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
