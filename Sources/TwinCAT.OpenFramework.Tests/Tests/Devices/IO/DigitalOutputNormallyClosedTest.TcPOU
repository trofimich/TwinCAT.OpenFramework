(*!
<summary>Checks normally closed output inversion in both directions.</summary>
<description>
Uses a live case-owned automation parent and fresh local device fixtures on every run.
The scenario reads and writes ordinary simulated storage within one task cycle.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DigitalOutputNormallyClosedTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	//! <summary>Live parent borrowed by the method-local simulated device.</summary>
	_AutomationRoot : MockAutomationController(name := "DevicesIORoot");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a633293f-2364-4c1e-8cbf-dab1c2f2f682}">
      <Declaration><![CDATA[(*!
<summary>Checks normally closed output inversion in both directions.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	output : TOF_Devices_IO.DigitalOutput(name := "DO_NC", parent := _AutomationRoot);
	rawOutput : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[output.Initialize();
output.ContactType := TOF_Devices_IO.CONTACT_TYPE.NORMALLY_CLOSED;
output.BindToIO(rawValue := rawOutput);

output.Value := TRUE;
output.ProcessOutput();
Assert.ThatBool(
	actual := rawOutput,
	message := "rawOutput should be inverted FALSE for NC contact"
).IsFalse();

output.Value := FALSE;
output.ProcessOutput();
Assert.ThatBool(
	actual := rawOutput,
	message := "rawOutput should be inverted TRUE for NC contact"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{57eb1bab-49ed-4f6f-be13-c706a6a90fb9}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{97f1122e-b192-4b53-8a1e-84df94748354}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{99280e5a-6dc4-464d-af7d-bf3acfa4118f}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{55026486-ae19-4ee5-b3a2-a05182b45ec3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d7e6e404-821b-439b-ab9c-bd398d1009a1}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{57671341-9703-48a5-b739-5c1f793f7eac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
