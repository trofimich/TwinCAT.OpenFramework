<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DigitalOutputNormallyClosedTest" Id="{8c896343-6b61-417c-a243-d1df96b40980}" SpecialFunc="None">
    <Declaration><![CDATA[(*
