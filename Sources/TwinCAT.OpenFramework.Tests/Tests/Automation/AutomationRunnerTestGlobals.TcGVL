(*!
<summary>Provides shared fixtures with early initialization for automation runner tests.</summary>
<description>
Initialized in early slot 40500 so empty sentinel arrays are available during POU variable construction.
</description>
*)

{attribute 'qualified_only'}
{attribute 'global_init_slot' := '40500'}
VAR_GLOBAL CONSTANT
	EmptyComponents : ARRAY [0..-1] OF TOF_Automation.IAutomationComponent := [];
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>

