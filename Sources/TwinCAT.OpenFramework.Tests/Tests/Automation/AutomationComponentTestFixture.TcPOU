          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="testChildErrorPolicyIgnore" Id="{cedf0b23-09e5-4ba0-9074-5ffa2338d79b}">
      <Declaration><![CDATA[(*!
<summary>Checks continued child traversal with Ignore.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testChildErrorPolicyIgnore
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IgnoreComposite.Initialize();
_IgnoreComposite.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.Ignore;
_IgnoreComposite.ChildA.FailOnWorking := TRUE;

FOR i := 1 TO 3 DO
	_IgnoreComposite.Execute();
END_FOR

assertions.ThatDInt(
	actual := TO_DINT(_IgnoreComposite.ChildA.OperationalState),
	message := "ChildA should stop on critical error"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));

assertions.ThatDInt(
	actual := TO_DINT(_IgnoreComposite.OperationalState),
	message := "Composite should remain WORKING when policy is Ignore"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));

assertions.ThatBool(
	actual := _IgnoreComposite.HasError,
	message := "Composite should not have error when policy is Ignore"
).IsFalse();

assertions.ThatInt(
	actual := _IgnoreComposite.ChildB.WorkingCount,
	message := "Later child must execute in every cycle with a retained critical sibling error"
).ToBe(expected := 3);
assertions.ThatInt(
	actual := _IgnoreComposite.AfterWorkingCount,
	message := "After-working hook must run after every continued traversal"
).ToBe(expected := 3);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testChildErrorPolicySetErrorAndContinue" Id="{b315547d-a34b-41a4-b87d-b61abed38d88}">
      <Declaration><![CDATA[(*!
<summary>Checks continued child traversal with a copied noncritical error.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testChildErrorPolicySetErrorAndContinue
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ContinueComposite.Initialize();
_ContinueComposite.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndContinue;
_ContinueComposite.ChildA.FailOnWorking := TRUE;

FOR i := 1 TO 3 DO
	_ContinueComposite.Execute();
END_FOR

assertions.ThatBool(
	actual := _ContinueComposite.HasError,
	message := "Composite should record error when child fails with SetErrorAndContinue"
).IsTrue();

assertions.ThatDInt(
	actual := TO_DINT(_ContinueComposite.OperationalState),
	message := "Composite should remain WORKING when policy is SetErrorAndContinue"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));

assertions.ThatInt(
	actual := _ContinueComposite.ChildB.WorkingCount,
	message := "Later child must execute in every cycle with a retained critical sibling error"
).ToBe(expected := 3);
assertions.ThatInt(
	actual := _ContinueComposite.AfterWorkingCount,
	message := "After-working hook must run after every continued traversal"
).ToBe(expected := 3);
assertions.ThatInt(
	actual := _ContinueComposite.RecoverCount,
	message := "Parent must not invoke OnRecover while faulted child remains critical"
).ToBe(expected := 0);

_ContinueComposite.ChildA.FailOnWorking := FALSE;
_ContinueComposite.ChildA.Reset();
_ContinueComposite.Execute();

assertions.ThatBool(
	actual := _ContinueComposite.HasError,
	message := "Parent should clear its copied error once the faulted child recovers"
).IsFalse();
assertions.ThatInt(
	actual := _ContinueComposite.RecoverCount,
	message := "Parent must invoke OnRecover once after the faulted child recovers"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _ContinueComposite.ChildA.WorkingCount,
	message := "Recovered child should resume working execution"
).ToBe(expected := 2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testChildErrorPolicySetErrorAndStop" Id="{e8cc700f-272c-4c08-a7eb-0862e3f07a19}">
      <Declaration><![CDATA[(*!
<summary>Checks stopping before later children after a critical child failure.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testChildErrorPolicySetErrorAndStop
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StopComposite.Initialize();
_StopComposite.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndStop;
_StopComposite.ChildA.FailOnWorking := TRUE;

_StopComposite.Execute();

assertions.ThatBool(
	actual := _StopComposite.HasError,
	message := "Composite should record error when child fails with SetErrorAndStop"
).IsTrue();

assertions.ThatDInt(
	actual := TO_DINT(_StopComposite.OperationalState),
	message := "Composite should transition to STOPPED when policy is SetErrorAndStop"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));

assertions.ThatInt(
	actual := _StopComposite.ChildB.WorkingCount,
	message := "Stop policy must not execute later children"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _StopComposite.AfterWorkingCount,
	message := "Stop policy must not complete the working phase"
).ToBe(expected := 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEnableDisable" Id="{b6cb30f8-5e7d-4476-add6-9e9e38f4f21b}">
      <Declaration><![CDATA[(*!
<summary>Checks leaf enablement with a live parent.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testEnableDisable
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EnableDisableLeaf.Initialize();

_EnableDisableLeaf.Disable();
assertions.ThatBool(actual := _EnableDisableLeaf.Enabled, message := "Leaf should be disabled").IsFalse();
assertions.ThatInt(
	actual := _EnableDisableLeaf.DisableCount,
	message := "DisableCount should be 1"
).ToBe(expected := 1);

_EnableDisableLeaf.Execute();
assertions.ThatInt(
	actual := _EnableDisableLeaf.WorkingCount,
	message := "Disabled leaf must not execute OnWorking"
).ToBe(expected := 0);

_EnableDisableLeaf.Enable(includeChildren := TRUE);
assertions.ThatBool(actual := _EnableDisableLeaf.Enabled, message := "Leaf should be enabled").IsTrue();
assertions.ThatInt(
	actual := _EnableDisableLeaf.EnableCount,
	message := "EnableCount should be 1"
).ToBe(expected := 1);

_EnableDisableLeaf.Execute();
assertions.ThatInt(
	actual := _EnableDisableLeaf.WorkingCount,
	message := "Enabled leaf should execute OnWorking"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEventBroadcasting" Id="{5a6a5bf9-c08d-4d12-8f1c-aef448c47b7f}">
      <Declaration><![CDATA[(*!
<summary>Checks broadcast delivery to two children.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testEventBroadcasting
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BroadcastComposite.BroadcastEvent(event := _BroadcastEvent);

assertions.ThatInt(
	actual := _BroadcastComposite.ChildA.LastReceivedEventId,
	message := "ChildA should receive broadcast event"
).ToBe(expected := 30);

assertions.ThatInt(
	actual := _BroadcastComposite.ChildB.LastReceivedEventId,
	message := "ChildB should receive broadcast event"
).ToBe(expected := 30);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEventBubbling" Id="{37a4cb2d-2fd9-497f-867e-c821815bbfba}">
      <Declaration><![CDATA[(*!
<summary>Checks event bubbling through a live parent.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testEventBubbling
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BubbleComposite.ChildA.BubbleEvent(event := _BubbleEvent);

assertions.ThatInt(
	actual := _BubbleComposite.ChildA.LastReceivedEventId,
	message := "ChildA should receive event locally"
).ToBe(expected := 10);

assertions.ThatInt(
	actual := _BubbleComposite.LastReceivedEventId,
	message := "Parent composite should receive bubbled event"
).ToBe(expected := 10);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEventBubblingStopPropagation" Id="{63e5301f-7d0e-46c2-b660-9a8fd6441d17}">
      <Declaration><![CDATA[(*!
<summary>Checks local bubbling termination.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testEventBubblingStopPropagation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StopBubbleComposite.ChildA.StopPropagationOnEvent := TRUE;
_StopBubbleComposite.ChildA.BubbleEvent(event := _StopBubbleEvent);

assertions.ThatInt(
	actual := _StopBubbleComposite.ChildA.LastReceivedEventId,
	message := "ChildA should receive event locally"
).ToBe(expected := 20);

assertions.ThatInt(
	actual := _StopBubbleComposite.EventReceivedCount,
	message := "Parent composite must not receive event when propagation stopped"
).ToBe(expected := 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInputOutputPhases" Id="{a95f43c3-aaca-40f8-833f-48cd04b1fc6d}">
      <Declaration><![CDATA[(*!
<summary>Checks direct leaf input, work and output calls.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testInputOutputPhases
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_InputOutputLeaf.Initialize();

_InputOutputLeaf.ProcessInput();
assertions.ThatInt(
	actual := _InputOutputLeaf.ProcessInputCount,
	message := "ProcessInputCount should be 1"
).ToBe(expected := 1);

_InputOutputLeaf.Execute();
assertions.ThatInt(
	actual := _InputOutputLeaf.WorkingCount,
	message := "WorkingCount should be 1"
).ToBe(expected := 1);

_InputOutputLeaf.ProcessOutput();
assertions.ThatInt(
	actual := _InputOutputLeaf.ProcessOutputCount,
	message := "ProcessOutputCount should be 1"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testLifecycleTransitions" Id="{6ad1dc41-ea41-4682-ab91-3e07c56d8206}">
      <Declaration><![CDATA[(*!
<summary>Checks leaf lifecycle transitions with a live parent.</summary>
<description>
Uses the suite-owned root as the borrowed parent. Fixtures contain no cleanup-dependent local resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testLifecycleTransitions
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[assertions.ThatDInt(
	actual := TO_DINT(_LifecycleLeaf.OperationalState),
	message := "Initial state should be INITIALIZING"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INITIALIZING));

_LifecycleLeaf.Initialize();
assertions.ThatDInt(
	actual := TO_DINT(_LifecycleLeaf.OperationalState),
	message := "State should be WORKING after Initialize"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));

_LifecycleLeaf.Execute();
assertions.ThatInt(actual := _LifecycleLeaf.WorkingCount, message := "WorkingCount should be 1").ToBe(expected := 1);

_LifecycleLeaf.Stop(reason := "Manual test stop");
assertions.ThatDInt(
	actual := TO_DINT(_LifecycleLeaf.OperationalState),
	message := "State should be STOPPED after Stop"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatWideString(
	actual := _LifecycleLeaf.OperationalStateReason,
	message := "OperationalStateReason should match stop reason"
).ToBe(expected := "Manual test stop");

_LifecycleLeaf.Reset();
assertions.ThatDInt(
	actual := TO_DINT(_LifecycleLeaf.OperationalState),
	message := "State should return to WORKING after Reset"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));]]></ST>
      </Implementation>
    </Method>
    <Method Name="testResetChildPolicies" Id="{f6b21d16-2786-43ee-9847-8d2fbf22400e}">
      <Declaration><![CDATA[(*!
<summary>Checks reset traversal and parent recovery for all three critical-child policies.</summary>
<description>
Runs once on a fresh fixture. Borrowed objects remain live for the call.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testResetChildPolicies
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResetIgnoreBranch.Initialize();
_ResetContinueBranch.Initialize();
_ResetStopBranch.Initialize();
_ResetIgnoreBranch.Stop(reason := "Reset regression");
_ResetContinueBranch.Stop(reason := "Reset regression");
_ResetStopBranch.Stop(reason := "Reset regression");
_ResetIgnoreBranch.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.Ignore;
_ResetContinueBranch.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndContinue;
_ResetStopBranch.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndStop;
_ResetIgnoreBranch.ChildA.ThrowOnReset := TRUE;
_ResetContinueBranch.ChildA.ThrowOnReset := TRUE;
_ResetStopBranch.ChildA.ThrowOnReset := TRUE;

_ResetIgnoreBranch.Reset();
_ResetContinueBranch.Reset();
_ResetStopBranch.Reset();

assertions.ThatDInt(
	actual := TO_DINT(_ResetIgnoreBranch.OperationalState),
	message := "Ignore resumes parent despite stopped child"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatDInt(
	actual := TO_DINT(_ResetContinueBranch.OperationalState),
	message := "Continue resumes parent despite stopped child"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatDInt(
	actual := TO_DINT(_ResetStopBranch.OperationalState),
	message := "Stop refuses parent recovery"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatInt(
	actual := _ResetIgnoreBranch.ChildB.ResetCount,
	message := "Ignore resets later child"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _ResetContinueBranch.ChildB.ResetCount,
	message := "Continue resets later child"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _ResetStopBranch.ChildB.ResetCount,
	message := "Stop ends reset traversal"
).ToBe(expected := 0);
assertions.ThatBool(
	actual := _ResetIgnoreBranch.HasError,
	message := "Ignore leaves the child diagnostic local"
).IsFalse();
assertions.ThatBool(
	actual := _ResetContinueBranch.HasError,
	message := "Continue retains the child diagnostic"
).IsTrue();
assertions.ThatDInt(
	actual := TO_DINT(_ResetContinueBranch.Error.Severity),
	message := "Continue downgrades copied severity"
).ToBe(expected := TO_DINT(TOF_Core.ERROR_SEVERITY.ERROR));
assertions.ThatBool(actual := _ResetStopBranch.HasError, message := "Stop records critical child failure").IsTrue();
assertions.ThatDInt(
	actual := TO_DINT(_ResetIgnoreBranch.ChildA.OperationalState),
	message := "Failed child stays stopped"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatDInt(
	actual := TO_DINT(_ResetContinueBranch.ChildA.OperationalState),
	message := "Continue does not revive failed child"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));]]></ST>
      </Implementation>
    </Method>
    <Method Name="testResetFromStoppedHook" Id="{cac2de5e-6ff7-48f9-bb10-e3a725af8152}">
      <Declaration><![CDATA[(*!
<summary>Checks that reset from a stopped hook is not undone by the current traversal.</summary>
<description>
Runs once on a fresh fixture. Borrowed objects remain live for the call.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testResetFromStoppedHook
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CallbackResetComposite.Initialize();
_CallbackResetComposite.Stop(reason := "Callback reset regression");
_CallbackResetComposite.ResetOnBeforeChildrenStopped := TRUE;
_CallbackResetComposite.Execute();

assertions.ThatDInt(
	actual := TO_DINT(_CallbackResetComposite.OperationalState),
	message := "Callback reset resumes the parent"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatDInt(
	actual := TO_DINT(_CallbackResetComposite.ChildA.OperationalState),
	message := "Current doStop must not stop reset ChildA"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatDInt(
	actual := TO_DINT(_CallbackResetComposite.ChildB.OperationalState),
	message := "Current doStop must not stop reset ChildB"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatInt(
	actual := _CallbackResetComposite.ChildA.WorkingCount,
	message := "Recovery does not restart working traversal within the stopped phase"
).ToBe(expected := 0);

_CallbackResetComposite.Execute();

assertions.ThatInt(
	actual := _CallbackResetComposite.ChildA.WorkingCount,
	message := "ChildA works next cycle"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _CallbackResetComposite.ChildB.WorkingCount,
	message := "ChildB works next cycle"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _CallbackResetComposite.AfterWorkingCount,
	message := "Working traversal completes"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testParentValidation" Id="{95489a2b-a29d-4faa-bab8-27a95f8bf71a}">
      <Declaration><![CDATA[(*!
<summary>Checks parent rejection before ready and pending initialization hooks.</summary>
<description>
Runs once on a fresh fixture. Borrowed objects remain live for the call.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testParentValidation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OrphanPendingLeaf.InitReturnValue := FALSE;
_OrphanPendingBranch.ChildA.InitReturnValue := FALSE;
_ValidPendingLeaf.InitReturnValue := FALSE;

initialized := _OrphanReadyLeaf.Initialize();
assertions.ThatBool(actual := initialized, message := "Ready orphan leaf must fail").IsFalse();
initialized := _OrphanPendingLeaf.Initialize();
assertions.ThatBool(actual := initialized, message := "Pending orphan leaf must fail").IsFalse();
initialized := _OrphanReadyBranch.Initialize();
assertions.ThatBool(actual := initialized, message := "Ready orphan branch must fail").IsFalse();
initialized := _OrphanPendingBranch.Initialize();
assertions.ThatBool(actual := initialized, message := "Pending orphan branch must fail").IsFalse();
assertions.ThatInt(
	actual := _OrphanReadyLeaf.InitializeCount,
	message := "Ready leaf hook must not run"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _OrphanPendingLeaf.InitializeCount,
	message := "Pending leaf hook must not run"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _OrphanReadyBranch.BeforeInitializeCount,
	message := "Ready branch hook must not run"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _OrphanPendingBranch.BeforeInitializeCount,
	message := "Pending branch hook must not run"
).ToBe(expected := 0);
assertions.ThatDInt(
	actual := TO_DINT(_OrphanReadyLeaf.OperationalState),
	message := "Orphan leaf is terminal INVALID"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INVALID));
assertions.ThatDInt(
	actual := TO_DINT(_OrphanReadyBranch.OperationalState),
	message := "Orphan branch is terminal INVALID"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INVALID));
assertions.ThatBool(
	actual := _OrphanPendingLeaf.HasError,
	message := "Missing parent produces a copied error"
).IsTrue();
assertions.ThatBool(
	actual := _OrphanPendingBranch.HasError,
	message := "Missing parent produces a branch error"
).IsTrue();

initialized := _ValidPendingLeaf.Initialize();
assertions.ThatBool(actual := initialized, message := "Valid pending leaf reports incomplete work").IsFalse();
assertions.ThatDInt(
	actual := TO_DINT(_ValidPendingLeaf.OperationalState),
	message := "Valid pending leaf remains initializing"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INITIALIZING));
assertions.ThatInt(
	actual := _ValidPendingLeaf.InitializeCount,
	message := "Valid leaf hook is invoked"
).ToBe(expected := 1);
_ValidPendingLeaf.InitReturnValue := TRUE;
initialized := _ValidPendingLeaf.Initialize();
assertions.ThatBool(actual := initialized, message := "Valid leaf can finish initialization").IsTrue();
initialized := _EmptyRoot.Initialize();
assertions.ThatBool(actual := initialized, message := "Empty root composition is valid").IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInitializationFailureResult" Id="{63231abf-efaa-4553-8ef7-8505d8721fbc}">
      <Declaration><![CDATA[(*!
<summary>Checks failure results, preflight and propagation through two branch levels.</summary>
<description>
Runs once on a fresh fixture. Borrowed objects remain live for the call.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testInitializationFailureResult
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FirstNullBranch.Children[0] := 0;
_SecondNullBranch.Children[1] := 0;
_ThrowingChildBranch.ChildA.ThrowOnInitializing := TRUE;
_FailureOuterBranch.Children[0] := _FailureInnerBranch;
_FailureInnerBranch.Children[1] := 0;

initialized := _FirstNullBranch.Initialize();
assertions.ThatBool(actual := initialized, message := "First null slot must not return success").IsFalse();
initialized := _SecondNullBranch.Initialize();
assertions.ThatBool(actual := initialized, message := "Later null slot must not return success").IsFalse();
assertions.ThatInt(
	actual := _FirstNullBranch.BeforeInitializeCount,
	message := "Null slot rejection precedes branch callbacks"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _SecondNullBranch.ChildA.InitializeCount,
	message := "Later null slot rejection precedes earlier child callbacks"
).ToBe(expected := 0);
initialized := _ThrowingChildBranch.Initialize();
assertions.ThatBool(
	actual := initialized,
	message := "Failed child initialization must not return success"
).IsFalse();
assertions.ThatDInt(
	actual := TO_DINT(_ThrowingChildBranch.OperationalState),
	message := "Parent immediately propagates INVALID child"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INVALID));
assertions.ThatInt(
	actual := _ThrowingChildBranch.ChildB.InitializeCount,
	message := "No later child initializes after a terminal child failure"
).ToBe(expected := 0);
assertions.ThatBool(
	actual := _ThrowingChildBranch.HasError,
	message := "Child failure is copied to parent"
).IsTrue();
initialized := _FailureOuterBranch.Initialize();
assertions.ThatBool(actual := initialized, message := "Nested invalid branch must not appear ready").IsFalse();
assertions.ThatDInt(
	actual := TO_DINT(_FailureInnerBranch.OperationalState),
	message := "Inner branch is INVALID"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INVALID));
assertions.ThatDInt(
	actual := TO_DINT(_FailureOuterBranch.OperationalState),
	message := "Outer branch immediately becomes INVALID"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INVALID));
assertions.ThatBool(actual := _FailureOuterBranch.HasError, message := "Nested error survives propagation").IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testIndexedLookupContainment" Id="{0c020768-9368-4167-904d-6a0212aabb5b}">
      <Declaration><![CDATA[(*!
<summary>Checks borrowed lookup identity, bounds and throwing or missing storage.</summary>
<description>
Catches unexpected escapes into an explicit test failure. Terminal OOM is excluded from this shared
suite and is verified separately in an isolated application. No fixture owns cleanup-dependent resources.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testIndexedLookupContainment
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expected : TOF_Automation.IChildAutomationComponent;
	actual : TOF_Automation.IChildAutomationComponent;
	exceptionEscaped : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	expected := _LookupComposite.ChildA;
	actual := _LookupComposite.TryGetChildByIndex(index := 0);
	assertions.ThatBool(actual := actual = expected, message := "Composite lookup returns the borrowed child").IsTrue();
	actual := _LookupComposite.TryGetChildByIndex(index := 2);
	assertions.ThatBool(actual := actual = 0, message := "Out-of-range lookup returns null").IsTrue();
	_LookupComposite.ThrowOnGetChildren := TRUE;
	actual := _LookupComposite.TryGetChildByIndex(index := 0);
	assertions.ThatBool(actual := actual = 0, message := "Composite getter exception is contained").IsTrue();
	_LookupComposite.ThrowOnGetChildren := FALSE;
	_LookupComposite.MissingChildrenReference := TRUE;
	actual := _LookupComposite.TryGetChildByIndex(index := 0);
	assertions.ThatBool(actual := actual = 0, message := "Missing composite storage returns null").IsTrue();
	expected := _LookupController.Child;
	actual := _LookupController.TryGetChildByIndex(index := 0);
	assertions.ThatBool(actual := actual = expected, message := "Controller lookup returns borrowed child").IsTrue();
	_LookupController.ThrowOnGetChildren := TRUE;
	actual := _LookupController.TryGetChildByIndex(index := 0);
	assertions.ThatBool(actual := actual = 0, message := "Controller getter exception is contained").IsTrue();
	_LookupController.ThrowOnGetChildren := FALSE;
	_LookupController.MissingChildrenReference := TRUE;
	actual := _LookupController.TryGetChildByIndex(index := 0);
	assertions.ThatBool(actual := actual = 0, message := "Missing controller storage returns null").IsTrue();
__CATCH(exceptionCode)
	exceptionEscaped := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := exceptionEscaped,
	message := "No exception may escape an indexed Try lookup"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testControllerPluginRecovery" Id="{4ac70a53-0707-40af-bb98-6d5894cb1d1b}">
      <Declaration><![CDATA[(*!
<summary>Checks disabled HMI service, same-cycle guards and stopped-tree reset.</summary>
<description>
Uses real base HMI command/status methods. An injected failure while disabled must require Reset.
All borrowed fixtures remain live for the call; no cleanup-dependent resources are owned locally.
</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testControllerPluginRecovery
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	actualPlugin : TOF_Automation.IAutomationControllerPlugin;
	expectedPlugin : TOF_Automation.IAutomationControllerPlugin;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HmiController.ConfigurePlugins(plugins := _HmiPlugins);
_HmiController.Execute();
assertions.ThatInt(
	actual := _HmiPlugin.BeforeCount,
	message := "Initializing root has no plugin service"
).ToBe(expected := 0);
_HmiController.Initialize();
expectedPlugin := _HmiPlugin;
actualPlugin := _HmiController.TryGetPluginByIndex(index := 0);
assertions.ThatBool(
	actual := actualPlugin = expectedPlugin,
	message := "Plugin lookup preserves borrowed identity"
).IsTrue();
actualPlugin := _HmiController.TryGetPluginByIndex(index := 1);
assertions.ThatBool(actual := actualPlugin = 0, message := "Missing plugin index returns null").IsTrue();
_HmiPlugin.AutomationComponentCommands.Disable := TRUE;
_HmiController.Execute();

assertions.ThatBool(actual := _HmiController.Enabled, message := "HMI Disable reaches the root").IsFalse();
assertions.ThatBool(
	actual := _HmiPlugin.AutomationComponentCommands.Disable,
	message := "Disable command is consumed"
).IsFalse();
assertions.ThatBool(
	actual := _HmiPlugin.AutomationComponentStatuses.Enabled,
	message := "Disabled status is refreshed"
).IsFalse();
assertions.ThatInt(
	actual := _HmiController.Child.ProcessInputCount,
	message := "Disable skips same-cycle input"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _HmiController.Child.WorkingCount,
	message := "Disable skips same-cycle work"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _HmiController.Child.ProcessOutputCount,
	message := "Disable skips same-cycle output"
).ToBe(expected := 0);
_HmiController.Execute();
assertions.ThatInt(
	actual := _HmiPlugin.BeforeCount,
	message := "Disabled root keeps before service"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _HmiPlugin.AfterCount,
	message := "Disabled root keeps after service"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _HmiController.Child.WorkingCount,
	message := "Disabled interval has no work"
).ToBe(expected := 0);
_HmiPlugin.AutomationComponentCommands.Enable := TRUE;
_HmiController.Execute();

assertions.ThatBool(actual := _HmiController.Enabled, message := "The same HMI channel can re-enable root").IsTrue();
assertions.ThatBool(
	actual := _HmiPlugin.AutomationComponentStatuses.Enabled,
	message := "Enabled status is refreshed"
).IsTrue();
assertions.ThatBool(
	actual := _HmiPlugin.AutomationComponentCommands.Enable,
	message := "Enable command is consumed"
).IsFalse();
assertions.ThatInt(
	actual := _HmiController.Child.ProcessInputCount,
	message := "Input resumes on Enable"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _HmiController.Child.WorkingCount,
	message := "Work resumes on Enable"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _HmiController.Child.ProcessOutputCount,
	message := "Output resumes on Enable"
).ToBe(expected := 1);
_HmiController.Stop(reason := "HMI stopped recovery regression");
_HmiController.Execute();
assertions.ThatInt(
	actual := _HmiController.Child.StopCount,
	message := "Enabled stopped hooks still run"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _HmiController.Child.ProcessInputCount,
	message := "Stopped root retains input"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _HmiController.Child.ProcessOutputCount,
	message := "Stopped root retains output"
).ToBe(expected := 2);
_HmiPlugin.AutomationComponentCommands.Reset := TRUE;
_HmiController.Execute();
assertions.ThatDInt(
	actual := TO_DINT(_HmiController.OperationalState),
	message := "HMI Reset resumes root"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatInt(
	actual := _HmiController.Child.WorkingCount,
	message := "HMI Reset resumes child work"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _HmiPlugin.AfterCount,
	message := "Every managed cycle refreshes status"
).ToBe(expected := 5);

_HmiPlugin.AutomationComponentCommands.Disable := TRUE;
_HmiController.Execute();
_HmiPlugin.ThrowOnBeforeExecute := TRUE;
_HmiController.Execute();
assertions.ThatDInt(
	actual := TO_DINT(_HmiController.OperationalState),
	message := "Failed disabled service must require Reset"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatBool(
	actual := _HmiController.HasError,
	message := "Disabled plugin failure retains its copied error"
).IsTrue();
assertions.ThatInt(
	actual := _HmiController.Child.WorkingCount,
	message := "Disabled fault does no work"
).ToBe(expected := 2);
_HmiPlugin.ThrowOnBeforeExecute := FALSE;
_HmiPlugin.AutomationComponentCommands.Enable := TRUE;
_HmiPlugin.AutomationComponentCommands.Reset := TRUE;
_HmiController.Execute();
assertions.ThatBool(
	actual := _HmiController.HasError,
	message := "Explicit recovery clears the plugin failure"
).IsFalse();
assertions.ThatBool(
	actual := _HmiPlugin.AutomationComponentCommands.Reset,
	message := "Recovery Reset is consumed"
).IsFalse();
assertions.ThatInt(
	actual := _HmiController.Child.WorkingCount,
	message := "Enable and Reset resume work"
).ToBe(expected := 3);

_InvalidHmiController.ConfigurePlugins(plugins := _HmiPlugins);
_InvalidHmiController.MissingChildrenReference := TRUE;
_InvalidHmiController.Initialize();
_InvalidHmiController.Execute();
assertions.ThatInt(
	actual := _HmiPlugin.BeforeCount,
	message := "INVALID root has no before service"
).ToBe(expected := 8);
assertions.ThatInt(
	actual := _HmiPlugin.AfterCount,
	message := "INVALID root has no after service"
).ToBe(expected := 8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDuplicateChild" Id="{1327d08f-923a-4aea-a471-ba43b9cac6c6}">
      <Declaration><![CDATA[(*!
<summary>Checks that a duplicate child invalidates a branch before initialization callbacks.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testDuplicateChild
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DuplicateBranch.Children[1] := _DuplicateBranch.Children[0];
_DuplicateBranch.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.Ignore;

assertions.ThatBool(actual := _DuplicateBranch.Initialize(), message := "Invalid composition must fail").IsFalse();
assertions.ThatBool(
	actual := _DuplicateBranch.OperationalState = TOF_Automation.OPERATIONAL_STATE.INVALID,
	message := "Branch must enter INVALID"
).IsTrue();
assertions.ThatBool(
	actual := _DuplicateBranch.HasError AND_THEN _DuplicateBranch.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Branch must retain a critical error"
).IsTrue();
assertions.ThatWideString(
	actual := _DuplicateBranch.OperationalStateReason,
	message := "Diagnosis identifies the conflicting slots"
).ToBe(expected := "Duplicate: Children[1] (ChildA) duplicates Children[0]");
assertions.ThatInt(
	actual := _DuplicateBranch.BeforeInitializeCount,
	message := "Branch hook must not run"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _DuplicateBranch.ChildA.InitializeCount,
	message := "First child must not start"
).ToBe(expected := 0);
assertions.ThatBool(
	actual := _DuplicateBranch.Initialize(),
	message := "Invalid branch must remain terminal"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testMismatchedChildParent" Id="{defb8d16-dd3a-43c1-bd28-f62afc5c0b67}">
      <Declaration><![CDATA[(*!
<summary>Checks that a mismatched parent invalidates a branch before initialization callbacks.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testMismatchedChildParent
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_WrongParentBranch.Children[1] := _ForeignChildLeaf;
_WrongParentBranch.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.Ignore;

assertions.ThatBool(actual := _WrongParentBranch.Initialize(), message := "Invalid composition must fail").IsFalse();
assertions.ThatBool(
	actual := _WrongParentBranch.OperationalState = TOF_Automation.OPERATIONAL_STATE.INVALID,
	message := "Branch must enter INVALID"
).IsTrue();
assertions.ThatBool(
	actual := _WrongParentBranch.HasError
		AND_THEN _WrongParentBranch.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Branch must retain a critical error"
).IsTrue();
assertions.ThatWideString(
	actual := _WrongParentBranch.OperationalStateReason,
	message := "Diagnosis identifies the conflicting slot"
).ToBe(expected := "WrongParent: Children[1] (Foreign) has a different Parent");
assertions.ThatInt(
	actual := _WrongParentBranch.BeforeInitializeCount,
	message := "Branch hook must not run"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _WrongParentBranch.ChildA.InitializeCount,
	message := "First child must not start"
).ToBe(expected := 0);
assertions.ThatBool(
	actual := _WrongParentBranch.Initialize(),
	message := "Invalid branch must remain terminal"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOutputPhaseStop" Id="{154414b1-03d6-4059-87c7-fb667495ae97}">
      <Declaration><![CDATA[(*!
<summary>Checks interrupted controller and composite output passes and the following stopped pass.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testOutputPhaseStop
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OutputStopBranch.Initialize();
_OutputStopBranch.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndStop;
_OutputStopBranch.ChildA.ThrowOnNextOutput := TRUE;
_OutputStopBranch.ProcessOutput();
assertions.ThatBool(
	actual := _OutputStopBranch.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED,
	message := "Branch stops"
).IsTrue();
assertions.ThatInt(
	actual := _OutputStopBranch.ChildA.ProcessOutputCount,
	message := "First output already ran"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _OutputStopBranch.ChildB.ProcessOutputCount,
	message := "Later output is deferred"
).ToBe(expected := 0);
assertions.ThatInt(
	actual := _OutputStopBranch.AfterOutputCount,
	message := "Interrupted branch skips after hook"
).ToBe(expected := 0);

_OutputStopBranch.ProcessOutput();
assertions.ThatInt(
	actual := _OutputStopBranch.ChildA.ProcessOutputCount,
	message := "Stopped pass starts at slot 0"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _OutputStopBranch.ChildB.ProcessOutputCount,
	message := "Stopped pass reaches slot 1"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _OutputStopBranch.AfterOutputCount,
	message := "Stopped pass completes"
).ToBe(expected := 1);

_OutputStopController.Initialize();
_OutputStopController.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndStop;
_OutputStopController.Child.ThrowOnNextOutput := TRUE;
_OutputStopController.Execute();
assertions.ThatInt(
	actual := _OutputStopController.Child.ProcessOutputCount,
	message := "Controller output ran"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _OutputStopController.AfterOutputCount,
	message := "Interrupted last slot skips hook"
).ToBe(expected := 0);

_OutputStopController.Execute();
assertions.ThatInt(
	actual := _OutputStopController.Child.ProcessOutputCount,
	message := "Stopped controller writes"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _OutputStopController.AfterOutputCount,
	message := "Stopped controller finishes"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOutputPhaseContinuation" Id="{44e98aa6-3df2-4668-9182-c4e7b3e09d21}">
      <Declaration><![CDATA[(*!
<summary>Checks sibling writes under Ignore and Continue and interruption after a stop/reset callback.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testOutputPhaseContinuation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OutputPoliciesBranch.Initialize();
_OutputPoliciesBranch.ChildCriticalErrorHandlingPolicy := TOF_Automation.ChildCriticalErrorHandlingPolicies.Ignore;
_OutputPoliciesBranch.ChildA.ThrowOnNextOutput := TRUE;
_OutputPoliciesBranch.ProcessOutput();
assertions.ThatInt(
	actual := _OutputPoliciesBranch.ChildB.ProcessOutputCount,
	message := "Ignore reaches next output"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _OutputPoliciesBranch.AfterOutputCount,
	message := "Ignore completes the pass"
).ToBe(expected := 1);

_OutputPoliciesBranch.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndContinue;
_OutputPoliciesBranch.ProcessOutput();
assertions.ThatInt(
	actual := _OutputPoliciesBranch.ChildB.ProcessOutputCount,
	message := "Continue reaches next output"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _OutputPoliciesBranch.AfterOutputCount,
	message := "Continue completes the pass"
).ToBe(expected := 2);

_OutputPoliciesBranch.StopAndResetBeforeOutput := TRUE;
_OutputPoliciesBranch.ProcessOutput();
assertions.ThatBool(
	actual := _OutputPoliciesBranch.OperationalState = TOF_Automation.OPERATIONAL_STATE.WORKING,
	message := "Reset restored work"
).IsTrue();
assertions.ThatInt(
	actual := _OutputPoliciesBranch.ChildA.ProcessOutputCount,
	message := "Obsolete pass skips first output"
).ToBe(expected := 2);
assertions.ThatInt(
	actual := _OutputPoliciesBranch.AfterOutputCount,
	message := "Obsolete pass skips after hook"
).ToBe(expected := 2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkPrimaryErrorCopy" Id="{bd3e4189-a2f8-4f72-8889-d676e9e3f230}">
      <Declaration><![CDATA[(*!
<summary>Checks the component snapshot after the real filter reuses the task-local native exception.</summary>
<param name="leaf">Fixture in the required lifecycle state.</param>
<param name="reaction">Runtime reaction under test.</param>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE checkPrimaryErrorCopy
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
	leaf : REFERENCE TO MockLeafAutomationComponent;
	reaction : TOF_Core.EXCEPTION_REACTION;
END_VAR
VAR
	primary : TOF_Core.IException;
	primaryMessage : TOF_Core.ERROR_MESSAGE;
	handlerThrew : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[primary := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ARRAYBOUNDS,
	catchPointNamespaceName := CurrentNamespace.Name,
	catchPointPOUName := __POUNAME(),
	catchPointPosition := __POSITION()
);
primaryMessage := primary.GetMessage();
MAIN.DiagnosticLogFilter.SetSecondaryExceptionProbe(enabled := TRUE);

__TRY
	leaf.ApplyExceptionReaction(exception := primary, reaction := reaction);
__CATCH
	handlerThrew := TRUE;
__ENDTRY

MAIN.DiagnosticLogFilter.SetSecondaryExceptionProbe(enabled := FALSE);
assertions.ThatBool(actual := handlerThrew, message := "Processing the native diagnostic must complete").IsFalse();
assertions.ThatBool(
	actual := primary.GetMessage() <> primaryMessage,
	message := "Filter must overwrite the borrowed wrapper"
).IsTrue();
assertions.ThatBool(
	actual := leaf.Error.TopMessage = primaryMessage,
	message := "Component must retain the primary message"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testPrimaryErrorBeforeLogging" Id="{a0aab0f9-ef5a-4301-86b4-927276397380}">
      <Declaration><![CDATA[(*!
<summary>Checks primary diagnostic capture for initialization, continue and stop reactions.</summary>
<description>Uses the installed test filter and task-local native wrapper without generating a hardware fault.</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testPrimaryErrorBeforeLogging
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[checkPrimaryErrorCopy(
	assertions := assertions,
	leaf := _InitializingProbeLeaf,
	reaction := TOF_Core.EXCEPTION_REACTION.IGNORE
);
assertions.ThatBool(
	actual := _InitializingProbeLeaf.OperationalState = TOF_Automation.OPERATIONAL_STATE.INVALID
		AND_THEN _InitializingProbeLeaf.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Initialization failure always records a critical error"
).IsTrue();

_WorkingProbeLeaf.Initialize();
checkPrimaryErrorCopy(
	assertions := assertions,
	leaf := _WorkingProbeLeaf,
	reaction := TOF_Core.EXCEPTION_REACTION.SET_ERROR_AND_CONTINUE
);
assertions.ThatBool(
	actual := _WorkingProbeLeaf.OperationalState = TOF_Automation.OPERATIONAL_STATE.WORKING
		AND_THEN _WorkingProbeLeaf.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR,
	message := "Continue records an error and keeps the component working"
).IsTrue();
checkPrimaryErrorCopy(
	assertions := assertions,
	leaf := _WorkingProbeLeaf,
	reaction := TOF_Core.EXCEPTION_REACTION.SET_ERROR_AND_STOP
);
assertions.ThatBool(
	actual := _WorkingProbeLeaf.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED
		AND_THEN _WorkingProbeLeaf.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Stop replaces the lower severity error and stops the component"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInputPhaseStop" Id="{239ba1d7-c8d0-4830-b6e0-60d2379391f4}">
      <Declaration><![CDATA[(*!
<summary>Checks input completion and stopped dispatch after the first input faults in a nested branch.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testInputPhaseStop
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_InputStopController.Children[0] := _InputStopBranch;
_InputStopController.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndStop;
_InputStopController.Initialize();
_InputStopBranch.ChildA.ThrowOnNextInput := TRUE;
_InputStopController.Execute();

assertions.ThatBool(
	actual := _InputStopController.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED
		AND_THEN _InputStopBranch.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED,
	message := "Critical input fault must stop both branches"
).IsTrue();
assertions.ThatInt(
	actual := _InputStopBranch.ChildB.ProcessInputCount,
	message := "Later input runs in the same scan"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _InputStopBranch.AfterInputCount,
	message := "Composite completes its input pass"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _InputStopController.AfterInputCount,
	message := "Controller completes its input pass"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _InputStopBranch.ChildB.WorkingCount,
	message := "Working logic must not follow the stop"
).ToBe(expected := 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testResetAndRecoverIgnoreExceptionPolicy" Id="{776514b8-ff92-4c66-ba5d-c7fcef6d2825}">
      <Declaration><![CDATA[(*!
<summary>Checks that Reset and OnRecover failures always stop with a critical error regardless of policy.</summary>
<description>The branch fixture recovers from a copied error after explicitly resetting its stopped child.</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testResetAndRecoverIgnoreExceptionPolicy
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResetPolicyLeaf.Initialize();
_ResetPolicyLeaf.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndContinue;
_ResetPolicyLeaf.Stop(reason := "Policy test stop");
_ResetPolicyLeaf.ThrowOnReset := TRUE;
_ResetPolicyLeaf.Reset();
assertions.ThatDInt(
	actual := TO_DINT(_ResetPolicyLeaf.OperationalState),
	message := "Failed leaf OnReset must remain STOPPED even with SetErrorAndContinue"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatBool(
	actual := _ResetPolicyLeaf.HasError
		AND_THEN _ResetPolicyLeaf.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Failed leaf OnReset must record a critical error"
).IsTrue();

_BeforeResetPolicyBranch.Initialize();
_BeforeResetPolicyBranch.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndContinue;
_BeforeResetPolicyBranch.Stop(reason := "Policy test stop");
_BeforeResetPolicyBranch.ThrowOnBeforeReset := TRUE;
_BeforeResetPolicyBranch.Reset();
assertions.ThatDInt(
	actual := TO_DINT(_BeforeResetPolicyBranch.OperationalState),
	message := "Failed OnBeforeChildrenReset must remain STOPPED even with SetErrorAndContinue"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatBool(
	actual := _BeforeResetPolicyBranch.HasError
		AND_THEN _BeforeResetPolicyBranch.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Failed OnBeforeChildrenReset must record a critical error"
).IsTrue();
assertions.ThatInt(
	actual := _BeforeResetPolicyBranch.ChildA.ResetCount,
	message := "Failed OnBeforeChildrenReset must not reset children"
).ToBe(expected := 0);

_AfterResetPolicyBranch.Initialize();
_AfterResetPolicyBranch.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndContinue;
_AfterResetPolicyBranch.Stop(reason := "Policy test stop");
_AfterResetPolicyBranch.ThrowOnAfterReset := TRUE;
_AfterResetPolicyBranch.Reset();
assertions.ThatDInt(
	actual := TO_DINT(_AfterResetPolicyBranch.OperationalState),
	message := "Failed OnAfterChildrenReset must remain STOPPED even with SetErrorAndContinue"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatBool(
	actual := _AfterResetPolicyBranch.HasError
		AND_THEN _AfterResetPolicyBranch.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Failed OnAfterChildrenReset must record a critical error"
).IsTrue();

_RecoverPolicyLeaf.Initialize();
_RecoverPolicyLeaf.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndContinue;
_RecoverPolicyLeaf.FailOnWorking := TRUE;
_RecoverPolicyLeaf.Execute();
_RecoverPolicyLeaf.FailOnWorking := FALSE;
_RecoverPolicyLeaf.ThrowOnRecover := TRUE;
_RecoverPolicyLeaf.Execute();
assertions.ThatDInt(
	actual := TO_DINT(_RecoverPolicyLeaf.OperationalState),
	message := "Failed leaf OnRecover must stop even with SetErrorAndContinue"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatBool(
	actual := _RecoverPolicyLeaf.HasError
		AND_THEN _RecoverPolicyLeaf.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Failed leaf OnRecover must record a critical error"
).IsTrue();
assertions.ThatInt(
	actual := _RecoverPolicyLeaf.RecoverCount,
	message := "Leaf OnRecover must run once"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _RecoverPolicyLeaf.WorkingCount,
	message := "Failed leaf OnRecover must skip OnWorking"
).ToBe(expected := 1);

_RecoverPolicyBranch.Initialize();
_RecoverPolicyBranch.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndContinue;
_RecoverPolicyBranch.ChildCriticalErrorHandlingPolicy :=
	TOF_Automation.ChildCriticalErrorHandlingPolicies.SetErrorAndContinue;
_RecoverPolicyBranch.ChildA.ExceptionHandlingPolicy := TOF_Core.ExceptionHandlingPolicies.SetErrorAndStop;
_RecoverPolicyBranch.ChildA.FailOnWorking := TRUE;
_RecoverPolicyBranch.Execute();
assertions.ThatBool(
	actual := _RecoverPolicyBranch.ChildA.OperationalState = TOF_Automation.OPERATIONAL_STATE.STOPPED
		AND_THEN _RecoverPolicyBranch.ChildA.HasError
		AND_THEN _RecoverPolicyBranch.ChildA.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "The injected working failure must stop the child with a critical error"
).IsTrue();
assertions.ThatBool(
	actual := _RecoverPolicyBranch.OperationalState = TOF_Automation.OPERATIONAL_STATE.WORKING
		AND_THEN _RecoverPolicyBranch.HasError
		AND_THEN _RecoverPolicyBranch.Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR,
	message := "The branch must stay working with a copied error until the child resets"
).IsTrue();

_RecoverPolicyBranch.ChildA.FailOnWorking := FALSE;
_RecoverPolicyBranch.ChildA.Reset();
_RecoverPolicyBranch.ThrowOnRecover := TRUE;
_RecoverPolicyBranch.Execute();
assertions.ThatDInt(
	actual := TO_DINT(_RecoverPolicyBranch.OperationalState),
	message := "Failed branch OnRecover must stop even with SetErrorAndContinue"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatBool(
	actual := _RecoverPolicyBranch.HasError
		AND_THEN _RecoverPolicyBranch.Error.Severity = TOF_Core.ERROR_SEVERITY.CRITICAL,
	message := "Failed branch OnRecover must record a critical error"
).IsTrue();
assertions.ThatInt(
	actual := _RecoverPolicyBranch.RecoverCount,
	message := "Branch OnRecover must run once"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _RecoverPolicyBranch.ChildA.WorkingCount,
	message := "Failed branch OnRecover must skip children working traversal"
).ToBe(expected := 1);
assertions.ThatInt(
	actual := _RecoverPolicyBranch.ChildB.WorkingCount,
	message := "Failed branch OnRecover must skip later children working traversal"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testAfterChildrenInitializingAndTimeoutPropagation" Id="{94b072a0-60ec-44de-b79f-eb3e5b7f0fe0}">
      <Declaration><![CDATA[(*!
<summary>Checks sequential child-to-branch initialization completion and timeout normalization.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testAfterChildrenInitializingAndTimeoutPropagation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AfterInitBranch.ChildA.InitReturnValue := FALSE;
_AfterInitBranch.AfterInitReturnValue := FALSE;
_AfterInitBranch.ChildB.InitializationTimeout := T#15S;

assertions.ThatBool(
	actual := _AfterInitBranch.Initialize(),
	message := "Branch remains initializing while ChildA is pending"
).IsFalse();
assertions.ThatInt(
	actual := _AfterInitBranch.AfterInitializeCount,
	message := "OnAfterChildrenInitializing must not run before all children initialize"
).ToBe(expected := 0);
assertions.ThatBool(
	actual := _AfterInitBranch.InitializationTimeout = T#15S,
	message := "Branch initialization timeout must expand to match child timeout"
).IsTrue();

_AfterInitBranch.ChildA.InitReturnValue := TRUE;
assertions.ThatBool(
	actual := _AfterInitBranch.Initialize(),
	message := "Branch remains initializing while OnAfterChildrenInitializing returns FALSE"
).IsFalse();
assertions.ThatInt(
	actual := _AfterInitBranch.AfterInitializeCount,
	message := "OnAfterChildrenInitializing runs once all children are ready"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := TO_DINT(_AfterInitBranch.OperationalState),
	message := "Branch stays INITIALIZING when OnAfterChildrenInitializing returns FALSE"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INITIALIZING));

_AfterInitBranch.AfterInitReturnValue := TRUE;
assertions.ThatBool(
	actual := _AfterInitBranch.Initialize(),
	message := "Branch completes initialization when OnAfterChildrenInitializing returns TRUE"
).IsTrue();
assertions.ThatInt(
	actual := _AfterInitBranch.AfterInitializeCount,
	message := "OnAfterChildrenInitializing runs again to finish initialization"
).ToBe(expected := 2);
assertions.ThatDInt(
	actual := TO_DINT(_AfterInitBranch.OperationalState),
	message := "Branch transitions to WORKING once OnAfterChildrenInitializing succeeds"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));

_TimeoutNormLeaf.InitializationTimeout := T#10S;
_TimeoutNormLeaf.InitializationTimeout := T#0S;
assertions.ThatBool(
	actual := _TimeoutNormLeaf.InitializationTimeout = TOF_Automation.Parameters.InitializationTimeout,
	message := "Assigning T#0S must immediately resolve InitializationTimeout to global default"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDisabledChildStopResetAndHmiCommandConsumption" Id="{8768e2d4-cff1-4584-a648-4a2a051302f3}">
      <Declaration><![CDATA[(*!
<summary>Checks disabled child stop/reset/enable semantics and single-shot HMI command consumption.</summary>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD PRIVATE testDisabledChildStopResetAndHmiCommandConsumption
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	exceptionEscaped : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DisabledChildBranch.Initialize();
_DisabledChildBranch.ChildA.Disable();
_DisabledChildBranch.Stop(reason := "Branch stop with disabled child");
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.OperationalState),
	message := "Branch enters STOPPED"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.ChildB.OperationalState),
	message := "Enabled child enters STOPPED"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.ChildA.OperationalState),
	message := "Disabled WORKING child must also transition to STOPPED"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));

_DisabledChildBranch.Reset();
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.OperationalState),
	message := "Branch resumes WORKING on Reset"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.ChildB.OperationalState),
	message := "Enabled child resumes WORKING on Reset"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.ChildA.OperationalState),
	message := "Disabled child remains STOPPED when branch resets"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));
assertions.ThatInt(
	actual := _DisabledChildBranch.ChildA.ResetCount,
	message := "Disabled child must not execute OnReset during branch Reset"
).ToBe(expected := 0);

_DisabledChildBranch.ChildA.Enable(includeChildren := TRUE);
assertions.ThatBool(actual := _DisabledChildBranch.ChildA.Enabled, message := "ChildA is enabled").IsTrue();
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.ChildA.OperationalState),
	message := "Enabling a stopped child must not auto-reset it"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.STOPPED));

_DisabledChildBranch.ChildA.Reset();
assertions.ThatDInt(
	actual := TO_DINT(_DisabledChildBranch.ChildA.OperationalState),
	message := "Explicit Reset restores the re-enabled child to WORKING"
).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.WORKING));
assertions.ThatInt(
	actual := _DisabledChildBranch.ChildA.ResetCount,
	message := "Explicit Reset invokes OnReset once"
).ToBe(expected := 1);

_CmdHmiController.ConfigurePlugins(plugins := _CmdHmiPlugins);
_CmdHmiController.Initialize();
_CmdHmiPlugin.AutomationComponentCommands.Disable := TRUE;
_CmdHmiController.Execute();
assertions.ThatBool(
	actual := _CmdHmiController.Enabled,
	message := "HMI Disable succeeds before fault injection"
).IsFalse();

_CmdHmiController.Child.ThrowOnEnable := TRUE;
_CmdHmiPlugin.AutomationComponentCommands.Enable := TRUE;

__TRY
	_CmdHmiController.Execute();
__CATCH(exceptionCode)
	exceptionEscaped := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := exceptionEscaped,
	message := "Controller cycle service contains plugin Enable failure"
).IsFalse();
assertions.ThatBool(
	actual := _CmdHmiPlugin.AutomationComponentCommands.Enable,
	message := "HMI Enable flag must be cleared even when Enable raises an exception"
).IsFalse();
assertions.ThatBool(
	actual := _CmdHmiController.HasError,
	message := "Controller records the failed Enable command error"
).IsTrue();
assertions.ThatBool(
	actual := _CmdHmiController.Enabled,
	message := "Failed Enable must leave controller disabled"
).IsFalse();

_CmdHmiController.Execute();
assertions.ThatInt(
	actual := _CmdHmiController.Child.EnableCount,
	message := "Consumed HMI Enable command must not repeat on subsequent cycles"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AdvanceInitializationTimeout" Id="{ede64760-260a-40c3-b31e-921bc93c684e}">
      <Declaration><![CDATA[(*!
<summary>Advances one cycle of the initialization timeout scenario.</summary>
<description>Reports the child error and INVALID state. Fifty calls bound lack of progress.</description>
<param name="assertions">Valid assertion context borrowed from the active case.</param>
*)
METHOD AdvanceInitializationTimeout : TOF_Testing.TEST_CYCLE_RESULT
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR_INST
	cycleCount : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AdvanceInitializationTimeout := TOF_Testing.TEST_CYCLE_RESULT.DONE;

IF cycleCount = 0 THEN
	_TimeoutComposite.ChildA.InitReturnValue := FALSE;
	_TimeoutComposite.ChildA.InitializationTimeout := T#1MS;
	_TimeoutComposite.InitializationTimeout := T#5S;
END_IF

cycleCount := cycleCount + 1;
_TimeoutComposite.Initialize();

IF _TimeoutComposite.ChildA.OperationalState = TOF_Automation.OPERATIONAL_STATE.INVALID OR_ELSE cycleCount >= 50 THEN
	assertions.ThatBool(
		actual := _TimeoutComposite.ChildA.HasError,
		message := TO_WSTRING(TOF_Core.Strings.Concat255(
			'Child timeout: child=', TO_STRING(_TimeoutComposite.ChildA.OperationalState),
			', parent=', TO_STRING(_TimeoutComposite.OperationalState),
			', PT=', TO_STRING(_TimeoutComposite.ChildA.InitializationTimeout),
			', init calls=', TO_STRING(_TimeoutComposite.ChildA.InitializeCount),
			', returns=', TO_STRING(_TimeoutComposite.ChildA.InitReturnValue)
		))
	).IsTrue();
	assertions.ThatDInt(
		actual := TO_DINT(_TimeoutComposite.ChildA.OperationalState),
		message := "Initialization timeout must put the child in INVALID"
	).ToBe(expected := TO_DINT(TOF_Automation.OPERATIONAL_STATE.INVALID));
	assertions.ThatBool(
		actual := _TimeoutComposite.ChildA.InitializeCount > 1,
		message := "The parent must allow repeated child initialization before timeout"
	).IsTrue();
ELSE
	AdvanceInitializationTimeout := TOF_Testing.TEST_CYCLE_RESULT.BUSY;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
