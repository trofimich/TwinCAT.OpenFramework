<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomationComponentTestCase" Id="{539ed20f-c987-435d-9bc2-50e3d6d452cb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Runs one automation component scenario in an isolated fixture.

Owns a freshly allocated fixture for the active run. AfterTest releases it after success or a reported
exception. A concrete pointer preserves FB_exit for the fixture and its nested resource owners.
Use one task. Do not copy the test case while it owns a fixture.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomationComponentTestCase EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Scenario : AUTOMATION_COMPONENT_TEST_SCENARIO;
	_Fixture : POINTER TO AutomationComponentTestFixture;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{e21bea5d-f495-47c0-8255-c4844a55b2e9}">
      <Declaration><![CDATA[(*
Selects the scenario without allocating its fixture.
name — Name reported for this case.
parent — Group that owns this case.
scenario — Scenario selected for the case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	scenario : AUTOMATION_COMPONENT_TEST_SCENARIO;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_Scenario := scenario;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{99754db6-5e4b-4d56-86e1-06a9b2f21d9e}">
      <Declaration><![CDATA[(*
Allocates a fresh fixture and runs the selected scenario.

Terminal allocation failure is raised at the task boundary after case handling.
*)
METHOD PROTECTED ExecuteTest
VAR
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Fixture := __NEW(AutomationComponentTestFixture);

IF _Fixture = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();

	RETURN;
END_IF

assertions REF= Assert;
_Fixture^.ExecuteScenario(scenario := _Scenario, assertions := assertions);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{ac04e650-5217-47d3-bb37-48d9ced549f7}">
      <Declaration><![CDATA[(*
Releases the fixture before the case outcome is published.

The framework records an exception from teardown. Clear the stored alias before releasing.
*)
METHOD PROTECTED AfterTest
VAR
	fixture : POINTER TO AutomationComponentTestFixture;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fixture := _Fixture;
_Fixture := 0;

IF fixture <> 0 THEN
	__DELETE(fixture);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{b6ee1d00-7204-4014-884c-6174651a21d2}">
      <Declaration><![CDATA[(*
Releases an active fixture if the case is unloaded before its teardown.

The fixture and its nested FB_exit paths complete without exceptions.
bInCopyCode — TwinCAT copy-code exit marker. The previous instance leaves copied storage alive.
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode AND_THEN _Fixture <> 0 THEN
	__DELETE(_Fixture);
END_IF

FB_exit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{e5db47dd-42dc-4a03-8151-11003399d67e}">
      <Declaration><![CDATA[(* Borrows the concrete class name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2c22e41b-c2e4-4189-8de1-bf27f15015b7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{181278a1-326d-4093-8bc7-7cb2a6f794c1}">
      <Declaration><![CDATA[(* Borrows the project namespace name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{40c813c7-abcd-4b7a-885d-6ea816dbc553}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9b7ac916-61a6-442a-a149-63e5d5630f02}">
      <Declaration><![CDATA[(* Reports the complete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{345469e4-faaf-4525-a916-08abb7961f8e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
