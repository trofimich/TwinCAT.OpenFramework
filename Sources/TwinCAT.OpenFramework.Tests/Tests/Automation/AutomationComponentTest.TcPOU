<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="AutomationComponentTest" Id="{868ccbaa-9d67-4f69-9202-500917194d54}" SpecialFunc="None">
    <Declaration><![CDATA[(*
