(*!
<summary>Exercises automation component lifecycle, policies, event routing and runner execution.</summary>
<description>
Owns the timeout root, timeout composite and heavy regression fixtures as persistent instance fields so
constructor dependencies remain valid without consuming per-call task stack frames. All valid child fixtures
borrow a suite-owned parent. Regression cases cover retained child faults, callback reset, child hierarchy
validation, required dependencies, initialization results, lookup containment and disabled HMI recovery.
Do not copy bound fixtures. Fatal OOM requires isolated manual verification, outside this shared suite.
</description>
*)

FUNCTION_BLOCK AutomationComponentTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	//! <summary>Persistent parent dependency for the initialization-timeout composite.</summary>
	_TimeoutRoot : MockAutomationController(name := "TimeoutRoot");
	//! <summary>Persistent composite borrowing the suite-owned root throughout the timeout scenario.</summary>
	_TimeoutComposite : MockCompositeAutomationComponent(name := "CompTimeout", parent := _TimeoutRoot);

	// Persistent fixtures for single-run regression methods to avoid large stack frames
	_ResetIgnoreBranch : MockCompositeAutomationComponent(name := "ResetIgnore", parent := _TimeoutRoot);
	_ResetContinueBranch : MockCompositeAutomationComponent(name := "ResetContinue", parent := _TimeoutRoot);
	_ResetStopBranch : MockCompositeAutomationComponent(name := "ResetStop", parent := _TimeoutRoot);

	_OrphanReadyLeaf : MockLeafAutomationComponent(name := "OrphanReadyLeaf", parent := 0);
	_OrphanPendingLeaf : MockLeafAutomationComponent(name := "OrphanPendingLeaf", parent := 0);
	_OrphanReadyBranch : MockCompositeAutomationComponent(name := "OrphanReadyBranch", parent := 0);
	_OrphanPendingBranch : MockCompositeAutomationComponent(name := "OrphanPendingBranch", parent := 0);
	_ValidPendingLeaf : MockLeafAutomationComponent(name := "ValidPendingLeaf", parent := _TimeoutRoot);
	_EmptyRoot : MockAutomationController(name := "EmptyRoot");

	_FirstNullBranch : MockCompositeAutomationComponent(name := "FirstNull", parent := _TimeoutRoot);
	_SecondNullBranch : MockCompositeAutomationComponent(name := "SecondNull", parent := _TimeoutRoot);
	_ThrowingChildBranch : MockCompositeAutomationComponent(name := "ThrowingChild", parent := _TimeoutRoot);
	_FailureOuterBranch : MockCompositeAutomationComponent(name := "OuterBranch", parent := _TimeoutRoot);
	_FailureInnerBranch : MockCompositeAutomationComponent(name := "InnerBranch", parent := _FailureOuterBranch);

	_LookupComposite : MockCompositeAutomationComponent(name := "LookupComposite", parent := _TimeoutRoot);
	_LookupController : MockPluginAutomationController(name := "LookupController");

	_HmiPlugin : MockHmiControllerPlugin;
	_HmiPlugins : ARRAY [0..0] OF TOF_Automation.IAutomationControllerPlugin := [_HmiPlugin];
	_HmiController : MockPluginAutomationController(name := "HmiController");
	_InvalidHmiController : MockPluginAutomationController(name := "InvalidHmiController");

	_OutputStopBranch : MockCompositeAutomationComponent(name := "OutputBranch", parent := _TimeoutRoot);
	_OutputStopController : MockPluginAutomationController(name := "OutputController");

	_InputStopController : MockPluginAutomationController(name := "InputController");
	_InputStopBranch : MockCompositeAutomationComponent(name := "InputBranch", parent := _InputStopController);

	_LifecycleLeaf : MockLeafAutomationComponent(name := "TestLeaf", parent := _TimeoutRoot);
	_EnableDisableLeaf : MockLeafAutomationComponent(name := "EnDisLeaf", parent := _TimeoutRoot);
	_IgnoreComposite : MockCompositeAutomationComponent(name := "CompIgnore", parent := _TimeoutRoot);
	_ContinueComposite : MockCompositeAutomationComponent(name := "CompContinue", parent := _TimeoutRoot);
	_StopComposite : MockCompositeAutomationComponent(name := "CompStop", parent := _TimeoutRoot);
	_BubbleComposite : MockCompositeAutomationComponent(name := "CompBubble", parent := _TimeoutRoot);
	_BubbleEvent : MockAutomationEvent(sourceObject := 0, eventId := 10, payload := "BubblePayload");
	_StopBubbleComposite : MockCompositeAutomationComponent(name := "CompStopBubble", parent := _TimeoutRoot);
	_StopBubbleEvent : MockAutomationEvent(sourceObject := 0, eventId := 20, payload := "StopPayload");
	_BroadcastComposite : MockCompositeAutomationComponent(name := "CompBcast", parent := _TimeoutRoot);
	_BroadcastEvent : MockAutomationEvent(sourceObject := 0, eventId := 30, payload := "BcastPayload");
	_InputOutputLeaf : MockLeafAutomationComponent(name := "IOLeaf", parent := _TimeoutRoot);
	_OutputPoliciesBranch : MockCompositeAutomationComponent(name := "OutputPolicies", parent := _TimeoutRoot);
	_InitializingProbeLeaf : MockLeafAutomationComponent(name := "InitProbe", parent := _TimeoutRoot);
	_WorkingProbeLeaf : MockLeafAutomationComponent(name := "WorkProbe", parent := _TimeoutRoot);
	_CallbackResetComposite : MockCompositeAutomationComponent(name := "CallbackReset", parent := _TimeoutRoot);
	_DuplicateBranch : MockCompositeAutomationComponent(name := "Duplicate", parent := _TimeoutRoot);
	_WrongParentBranch : MockCompositeAutomationComponent(name := "WrongParent", parent := _TimeoutRoot);
	_ForeignChildLeaf : MockLeafAutomationComponent(name := "Foreign", parent := _TimeoutRoot);

	_ResetPolicyLeaf : MockLeafAutomationComponent(name := "ResetPolicyLeaf", parent := _TimeoutRoot);
	_BeforeResetPolicyBranch : MockCompositeAutomationComponent(name := "BeforeResetPolicy", parent := _TimeoutRoot);
	_AfterResetPolicyBranch : MockCompositeAutomationComponent(name := "AfterResetPolicy", parent := _TimeoutRoot);
	_RecoverPolicyLeaf : MockLeafAutomationComponent(name := "RecoverPolicyLeaf", parent := _TimeoutRoot);
	_RecoverPolicyBranch : MockCompositeAutomationComponent(name := "RecoverPolicyBranch", parent := _TimeoutRoot);

	_AfterInitBranch : MockCompositeAutomationComponent(name := "AfterInitBranch", parent := _TimeoutRoot);
	_TimeoutNormLeaf : MockLeafAutomationComponent(name := "TimeoutNormLeaf", parent := _TimeoutRoot);

	_DisabledChildBranch : MockCompositeAutomationComponent(name := "DisabledChildBranch", parent := _TimeoutRoot);
	_CmdHmiPlugin : MockHmiControllerPlugin;
	_CmdHmiPlugins : ARRAY [0..0] OF TOF_Automation.IAutomationControllerPlugin := [_CmdHmiPlugin];
	_CmdHmiController : MockPluginAutomationController(name := "CmdHmiController");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestLifecycleTransitions();
TestInitializationTimeout();
TestEnableDisable();
TestChildErrorPolicyIgnore();
TestChildErrorPolicySetErrorAndContinue();
TestChildErrorPolicySetErrorAndStop();
TestEventBubbling();
TestEventBubblingStopPropagation();
TestEventBroadcasting();
TestInputOutputPhases();
TestOutputPhaseStop();
TestInputPhaseStop();
TestOutputPhaseContinuation();
TestPrimaryErrorBeforeLogging();
TestRunnerHappyPath();
TestRunnerNullComponentGuard();
TestResetChildPolicies();
TestResetFromStoppedHook();
TestParentValidation();
TestDuplicateChild();
TestMismatchedChildParent();
TestInitializationFailureResult();
TestIndexedLookupContainment();
TestControllerPluginRecovery();
TestResetAndRecoverIgnoreExceptionPolicy();
TestAfterChildrenInitializingAndTimeoutPropagation();
TestDisabledChildStopResetAndHmiCommandConsumption();]]></ST>
    </Implementation>
    <Folder Name="Tests" Id="{fb544209-7e1e-40ef-9afd-dd619da7a44f}" />
    <Property Name="ClassName" Id="{8d30d36f-229f-45b8-98a3-42f3c16137ca}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{da1ce19b-635a-4944-a338-87161ce3b2c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{fbb21eda-3e59-4edf-9ec4-e41100b95e70}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fc26d2d6-436b-45af-b43c-7338982e90f7}">
