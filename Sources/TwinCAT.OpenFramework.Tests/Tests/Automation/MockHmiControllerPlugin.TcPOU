<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MockHmiControllerPlugin" Id="{e8f698ff-509b-44df-a7ef-c1d1b153a787}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Dispatches HMI base commands and records both controller-service callbacks.</summary>
<description>
Uses the base HMI command and status storage. One task owns each instance; no controller reference
is retained between calls. An optional before-service fault exercises the controller exception policy.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK MockHmiControllerPlugin EXTENDS TOF_Automation.HmiAutomationComponentElement
	IMPLEMENTS TOF_Automation.IAutomationControllerPlugin
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_BeforeCount : INT;
	_AfterCount : INT;
	_ThrowOnBeforeExecute : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{738a3fd4-9776-4d9e-9c30-e628e2f2834f}">
      <Declaration><![CDATA[(*!
<summary>Borrows the static concrete class name.</summary>
*)
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7fdb3998-410b-4ec7-ae52-dab7bea7a256}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{24ab77b2-fc53-47c6-b1ef-816387c49eac}">
      <Declaration><![CDATA[(*!
<summary>Borrows the library namespace.</summary>
*)
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7290db3b-53e1-4d37-bfc3-cb4cce01e5d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="BeforeCount" Id="{d82798bc-e64e-4657-90e8-a13ad4cd4ce1}">
      <Declaration><![CDATA[(*!
<summary>Gets the number of completed Before hook calls.</summary>
*)
PROPERTY BeforeCount : INT]]></Declaration>
      <Get Name="Get" Id="{7bdb0445-d9b1-4eee-940d-952fa13b15b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[BeforeCount := _BeforeCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AfterCount" Id="{afff6dcd-9a79-4f77-8a96-99388bbb9e0a}">
      <Declaration><![CDATA[(*!
<summary>Gets the number of completed After hook calls.</summary>
*)
PROPERTY AfterCount : INT]]></Declaration>
      <Get Name="Get" Id="{9e773fe8-c724-4c22-bcbf-067a2ae161e6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AfterCount := _AfterCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnBeforeControllerExecute" Id="{a29c7cec-1f34-4e0f-a885-8f18bbf94d30}">
      <Declaration><![CDATA[(*!
<summary>Records the before callback, optionally fails, and dispatches HMI commands.</summary>
<description>
The injected exception exercises stop policy while disabled. This callback never performs technological
work and retains no exception or controller reference.
</description>
*)
METHOD OnBeforeControllerExecute
VAR_INPUT
	controller : TOF_Automation.IAutomationController;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BeforeCount := _BeforeCount + 1;
IF _ThrowOnBeforeExecute THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected before-plugin service failure."
	);
END_IF

ProcessAutomationComponentCommands(automationComponent := controller);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterControllerExecute" Id="{4eedb6d9-a6c6-41af-9080-a66405ec733d}">
      <Declaration><![CDATA[(*!
<summary>Records the after callback and services HMI statuses.</summary>
<description>
Runs even while disabled; this callback performs service only and does not execute technological work.
</description>
*)
METHOD OnAfterControllerExecute
VAR_INPUT
	controller : TOF_Automation.IAutomationController;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AfterCount := _AfterCount + 1;
UpdateAutomationComponentStatuses(automationComponent := controller);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ThrowOnBeforeExecute" Id="{68229830-db8e-4eb9-988c-b38a2403c4ce}">
      <Declaration><![CDATA[(*!
<summary>Controls a failure before HMI command dispatch.</summary>
*)
PROPERTY ThrowOnBeforeExecute : BOOL]]></Declaration>
      <Get Name="Get" Id="{79539456-9e14-48d0-82a3-1b172f33966f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnBeforeExecute := _ThrowOnBeforeExecute;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0ef7b2fe-0337-408a-a02f-775ca730effb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnBeforeExecute := ThrowOnBeforeExecute;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
