(*! <summary>Orders the top-level runner calls and publication of their observations.</summary> *)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE RUNNER_TEST_PHASE :
(
	CHECK_CONSTRUCTION,
	INITIALIZE_ROOTS,
	EXECUTE_ROOTS,
	CHECK_NULL_ROOT,
	CHECK_EMPTY_ROOTS,
	CHECK_DUPLICATE_ROOT,
	PUBLISH_RESULTS,
	FINISHED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
