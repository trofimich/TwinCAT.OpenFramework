<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MockAutomationEvent" Id="{484732bc-21d8-456a-8928-3cf9da7a3a2e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
