(*!
<summary>Mock event used for verifying event delivery and propagation in automation tests.</summary>
*)

FUNCTION_BLOCK MockAutomationEvent EXTENDS TOF_Core.Event
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	_EventId : INT;
	{attribute 'hide'}
	_Payload : WSTRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{75ac35b6-2d32-4a1a-ab7d-3f7e194683d1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2de7ed2b-bd5e-485e-8907-69111dd1908f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EventId" Id="{78642e4e-01ca-474b-9a2c-0266d2634f76}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY EventId : INT]]></Declaration>
      <Get Name="Get" Id="{3116f21a-a97b-47e1-801c-a5f4478366e2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[EventId := _EventId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{a4cde239-da60-4e55-9729-fb672efaa96f}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	sourceObject : TOF_Core.IObject;
	eventId : INT;
	payload : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EventId := eventId;
_Payload := payload;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{2e52e9fd-f621-440a-8f5a-90e7c54e35e5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1ca1261f-4487-4a50-85cb-0b4b1f8addcb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Payload" Id="{d74babe8-2936-4a3e-9dac-deb16fe7bd7d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Payload : REFERENCE TO WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{c07b3550-11e9-405d-b1d8-4b512d25c831}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Payload REF= _Payload;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{de4610c9-bf89-4eca-bb7f-f3125c415ff9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9612add8-2872-4f77-9836-cdb8e4439648}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>