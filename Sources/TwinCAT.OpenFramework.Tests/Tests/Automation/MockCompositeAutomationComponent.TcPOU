(*
Mock composite with two leaves, callback observations and explicit storage faults.

Self-bound child relationships require a live instance that is not copied.
*)

FUNCTION_BLOCK MockCompositeAutomationComponent EXTENDS TOF_Automation.CompositeAutomationComponent<2>
VAR_OUTPUT
	// Number of completed output passes observed by the after-output hook.
	AfterOutputCount : INT;
	// Counts completed input passes.
	AfterInputCount : INT;
END_VAR
VAR_INPUT
	// Stops and immediately resets this branch in the opening output hook.
	StopAndResetBeforeOutput : BOOL;
END_VAR
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_ChildA : MockLeafAutomationComponent(name := "ChildA", parent := THIS^);
	_ChildB : MockLeafAutomationComponent(name := "ChildB", parent := THIS^);
	
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent :=
	[
		_ChildA,
		_ChildB
	];
	
	_ThrowOnGetChildren : BOOL;
	_MissingChildrenReference : BOOL;
	_ResetOnBeforeChildrenStopped : BOOL;
	_BeforeInitializeCount : INT;
	_AfterWorkingCount : INT;

	_EventReceivedCount : INT;
	_LastReceivedEventId : INT;
	_AfterInitializeCount : INT;
	_AfterInitReturnValue : BOOL := TRUE;
	_RecoverCount : INT;
	_ThrowOnRecover : BOOL;
	_ThrowOnBeforeReset : BOOL;
	_ThrowOnAfterReset : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ChildA" Id="{5b2f8381-ffe1-4bbf-8665-2d21d0d7b7d3}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ChildA : REFERENCE TO MockLeafAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{30a0f874-95d1-45d0-b57c-521912446187}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildA REF= _ChildA;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ChildB" Id="{b6f18521-3fa3-43f6-a17c-4af9ced6bd97}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ChildB : REFERENCE TO MockLeafAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{20234a26-d0ed-449c-a706-1fb2c34cd9ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildB REF= _ChildB;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{a69de2da-8ae4-4029-8194-69664ded7b50}">
      <Declaration><![CDATA[(*
Returns test child storage or the configured missing/throwing fault.

The borrowed array and its self-bound children must not be copied. Faults exercise lookup containment
and validation before initialization hooks.
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{2f00b5a8-2b5b-4f30-b422-77d147e70d15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ThrowOnGetChildren THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected Children getter failure."
	);
END_IF

IF _MissingChildrenReference THEN
	Children REF= 0;
ELSE
	Children REF= _Children;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{9af18252-e82a-44a8-8f73-309b4c2a139a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f4bbd852-f99b-49e7-ab68-70b523c8fe6b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EventReceivedCount" Id="{1d8f7e73-b3d3-476e-af95-d1be237e2cf6}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY EventReceivedCount : INT]]></Declaration>
      <Get Name="Get" Id="{96d44aa0-97b1-4b00-af83-448011627e34}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[EventReceivedCount := _EventReceivedCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{68cee9ff-ba44-4ec4-be24-3c36635da9ee}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Automation.IParentAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="LastReceivedEventId" Id="{32827c6e-c385-43b0-b35b-84d7724f2f5d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY LastReceivedEventId : INT]]></Declaration>
      <Get Name="Get" Id="{d6be0dd9-3f9b-4b4c-94a5-d6abfdf73949}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LastReceivedEventId := _LastReceivedEventId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{507bd594-225e-4b0c-a3b8-5897e64d4d6d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{247cf68e-28a6-4ab8-8cc2-1babc87aa0ff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEventReceived" Id="{ef875f1f-52e0-40c3-b55f-9607be167100}">
      <Declaration><![CDATA[METHOD OnEventReceived
VAR_INPUT
	event : TOF_Core.IEvent;
END_VAR
VAR_OUTPUT
	stopPropagation : BOOL;
END_VAR
VAR
	mockEv : POINTER TO MockAutomationEvent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EventReceivedCount := _EventReceivedCount + 1;

IF __QUERYPOINTER(event, mockEv) THEN
	_LastReceivedEventId := mockEv^.EventId;
END_IF

stopPropagation := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{d38baae4-6381-436a-89b2-962fd446411c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f31906ad-0d55-4daf-89a4-c615e2acb32b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ThrowOnGetChildren" Id="{b9a2026b-b04a-4e8a-b58a-31fcd1f68ca2}">
      <Declaration><![CDATA[(* Controls an exception from the Children getter. *)
{attribute 'monitoring' := 'call'}
PROPERTY ThrowOnGetChildren : BOOL]]></Declaration>
      <Get Name="Get" Id="{c095e8b9-e5bd-4bd3-84d3-488118641d16}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnGetChildren := _ThrowOnGetChildren;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b683e324-504f-44f6-a6a8-5b793198c448}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnGetChildren := ThrowOnGetChildren;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="MissingChildrenReference" Id="{ef792f84-ca7b-4e06-9524-b7b0e25e1aad}">
      <Declaration><![CDATA[(* Controls a missing Children storage reference. *)
{attribute 'monitoring' := 'call'}
PROPERTY MissingChildrenReference : BOOL]]></Declaration>
      <Get Name="Get" Id="{1e531314-79e7-461e-b65b-1bfc43ff1f9d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[MissingChildrenReference := _MissingChildrenReference;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{be387924-aee3-4a7b-92eb-f5bf86e1c99b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_MissingChildrenReference := MissingChildrenReference;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ResetOnBeforeChildrenStopped" Id="{b18bfd76-bbf1-4a61-9bee-f5f32cf0d0cd}">
      <Declaration><![CDATA[(* Requests one Reset from the next before-stopped hook. *)
{attribute 'monitoring' := 'call'}
PROPERTY ResetOnBeforeChildrenStopped : BOOL]]></Declaration>
      <Get Name="Get" Id="{77651eec-cb18-4b7c-ad03-076cea20e111}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResetOnBeforeChildrenStopped := _ResetOnBeforeChildrenStopped;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{689bd6bb-7e3f-4cfb-bfd6-3904ab6a44c0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ResetOnBeforeChildrenStopped := ResetOnBeforeChildrenStopped;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="BeforeInitializeCount" Id="{9ad1bf26-aad5-4405-8f40-8e44edecc381}">
      <Declaration><![CDATA[(* Gets the number of completed BeforeInitialize hook calls. *)
PROPERTY BeforeInitializeCount : INT]]></Declaration>
      <Get Name="Get" Id="{433e513e-594a-4294-83c3-0a529d4a6fdf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[BeforeInitializeCount := _BeforeInitializeCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AfterWorkingCount" Id="{5b6cbafd-6210-44ec-ae37-66c22bf51624}">
      <Declaration><![CDATA[(* Gets the number of completed AfterWorking hook calls. *)
PROPERTY AfterWorkingCount : INT]]></Declaration>
      <Get Name="Get" Id="{fc62d877-05bc-491b-ac4f-a529d51bab79}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AfterWorkingCount := _AfterWorkingCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnBeforeChildrenInitializing" Id="{60672aff-0eb9-45c1-aa92-ca8588ccba94}">
      <Declaration><![CDATA[(* Records entry into the branch initialization hook. *)
METHOD PROTECTED OnBeforeChildrenInitializing]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BeforeInitializeCount := _BeforeInitializeCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenWorking" Id="{7a687f84-3167-400a-b7c7-17f520e2dd58}">
      <Declaration><![CDATA[(* Records completion of working-child traversal. *)
METHOD PROTECTED OnAfterChildrenWorking]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AfterWorkingCount := _AfterWorkingCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeChildrenStopped" Id="{1adc44e1-f15c-4b26-b54c-032fd4398c9f}">
      <Declaration><![CDATA[(*
Optionally resumes the tree from within its stopped-cycle callback.

Consumes the request before Reset so it cannot trigger a repeated request from this hook.
*)
METHOD PROTECTED OnBeforeChildrenStopped]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ResetOnBeforeChildrenStopped THEN
	_ResetOnBeforeChildrenStopped := FALSE;
	Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenProcessOutput" Id="{14dd1a0b-7c6b-4453-8ef1-1aa6b93f8c9a}">
      <Declaration><![CDATA[(* Counts completed output passes. *)
METHOD PROTECTED OnAfterChildrenProcessOutput]]></Declaration>
      <Implementation>
        <ST><![CDATA[AfterOutputCount := AfterOutputCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeChildrenProcessOutput" Id="{b6c975f5-f847-47cb-b551-988041b82a79}">
      <Declaration><![CDATA[(* Optionally changes state twice before the first output. *)
METHOD PROTECTED OnBeforeChildrenProcessOutput]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF StopAndResetBeforeOutput THEN
	Stop(reason := "Injected stop before output");
	Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenProcessInput" Id="{12f371bc-f191-480d-8937-e3bc77f7121e}">
      <Declaration><![CDATA[(* Records completion of this branch's input traversal. *)
METHOD PROTECTED OnAfterChildrenProcessInput]]></Declaration>
      <Implementation>
        <ST><![CDATA[AfterInputCount := AfterInputCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenInitializing" Id="{63bddca5-ad5c-4d00-b7ed-8376fdc6ce1a}">
      <Declaration><![CDATA[(* Counts after-children initialization calls and returns the configured completion flag. *)
METHOD PROTECTED OnAfterChildrenInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AfterInitializeCount := _AfterInitializeCount + 1;
OnAfterChildrenInitializing := _AfterInitReturnValue;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenReset" Id="{cc4b00b5-adfe-4d52-bbb1-7fe7440c7d80}">
      <Declaration><![CDATA[(* Optionally raises a fault during the after-children reset hook. *)
METHOD PROTECTED OnAfterChildrenReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ThrowOnAfterReset THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected OnAfterChildrenReset failure."
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeChildrenReset" Id="{1ef53de6-f1f2-4949-96ae-b0b05185eb87}">
      <Declaration><![CDATA[(* Optionally raises a fault during the before-children reset hook. *)
METHOD PROTECTED OnBeforeChildrenReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ThrowOnBeforeReset THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected OnBeforeChildrenReset failure."
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRecover" Id="{5abe7c50-7778-41b9-92ed-a9b9f09f59ba}">
      <Declaration><![CDATA[(* Records OnRecover calls and optionally raises a recovery fault. *)
METHOD PROTECTED OnRecover]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RecoverCount := _RecoverCount + 1;

IF _ThrowOnRecover THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected branch OnRecover failure."
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="AfterInitializeCount" Id="{7ff668fc-9803-475e-90e3-0eb9615bd5ca}">
      <Declaration><![CDATA[(* Gets the number of completed OnAfterChildrenInitializing hook calls. *)
{attribute 'monitoring' := 'call'}
PROPERTY AfterInitializeCount : INT]]></Declaration>
      <Get Name="Get" Id="{2c73a6dd-f4b1-43a5-83c9-ba242ba91503}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AfterInitializeCount := _AfterInitializeCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AfterInitReturnValue" Id="{4d52e684-75f9-4d13-9b79-96671aef4df6}">
      <Declaration><![CDATA[(* Controls the return value of OnAfterChildrenInitializing. *)
{attribute 'monitoring' := 'call'}
PROPERTY AfterInitReturnValue : BOOL]]></Declaration>
      <Get Name="Get" Id="{868fa9b5-aca6-4a38-aaf7-f79e43e49cbf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AfterInitReturnValue := _AfterInitReturnValue;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{fa0ddb07-56ff-423e-a0ec-894cab7874ab}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_AfterInitReturnValue := AfterInitReturnValue;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RecoverCount" Id="{a752b33e-b33c-4846-a635-2759f5ed6b2c}">
      <Declaration><![CDATA[(* Gets the number of OnRecover calls recorded by this mock composite. *)
{attribute 'monitoring' := 'call'}
PROPERTY RecoverCount : INT]]></Declaration>
      <Get Name="Get" Id="{0a000e1f-2310-4a36-8afa-cb47724ef6b7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RecoverCount := _RecoverCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ThrowOnAfterReset" Id="{1f51118a-abbe-49e2-807e-2c10ab98554e}">
      <Declaration><![CDATA[(* Controls the OnAfterChildrenReset fault injected by regression tests. *)
{attribute 'monitoring' := 'call'}
PROPERTY ThrowOnAfterReset : BOOL]]></Declaration>
      <Get Name="Get" Id="{3297192b-14d2-4776-a9bf-0fd84d6cf270}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnAfterReset := _ThrowOnAfterReset;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c719c85f-46f0-45f6-a130-dd91d067457e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnAfterReset := ThrowOnAfterReset;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ThrowOnBeforeReset" Id="{44402637-6335-4f3c-a5d4-399aca4643bf}">
      <Declaration><![CDATA[(* Controls the OnBeforeChildrenReset fault injected by regression tests. *)
{attribute 'monitoring' := 'call'}
PROPERTY ThrowOnBeforeReset : BOOL]]></Declaration>
      <Get Name="Get" Id="{bb536b3b-6b1c-4e2f-a853-c72d2f6fb14f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnBeforeReset := _ThrowOnBeforeReset;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{8eb305ba-669c-460e-b5e3-25d47397daa6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnBeforeReset := ThrowOnBeforeReset;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ThrowOnRecover" Id="{daf53efb-5776-4912-8d7b-40b5a9ac7768}">
      <Declaration><![CDATA[(* Controls the OnRecover fault injected by regression tests. *)
{attribute 'monitoring' := 'call'}
PROPERTY ThrowOnRecover : BOOL]]></Declaration>
      <Get Name="Get" Id="{99b5f75d-2abe-49dc-a14b-cd403709c489}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnRecover := _ThrowOnRecover;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{963e1603-2708-471f-89d8-6f684b5c1ade}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnRecover := ThrowOnRecover;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>
