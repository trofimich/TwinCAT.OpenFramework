<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MockCompositeAutomationComponent" Id="{753b742a-b2b2-40a3-ac59-10035c24b148}" SpecialFunc="None">
    <Declaration><![CDATA[(*
