(*!
<summary>Mock composite component hosting two mock leaves for hierarchy and routing tests.</summary>
*)

FUNCTION_BLOCK MockCompositeAutomationComponent EXTENDS TOF_Automation.CompositeAutomationComponent<2>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_ChildA : MockLeafAutomationComponent("ChildA", THIS^);
	_ChildB : MockLeafAutomationComponent("ChildB", THIS^);
	
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent;
	
	_EventReceivedCount : INT;
	_LastReceivedEventId : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ChildA" Id="{5b2f8381-ffe1-4bbf-8665-2d21d0d7b7d3}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ChildA : REFERENCE TO MockLeafAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{30a0f874-95d1-45d0-b57c-521912446187}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildA REF= _ChildA;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ChildB" Id="{b6f18521-3fa3-43f6-a17c-4af9ced6bd97}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ChildB : REFERENCE TO MockLeafAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{20234a26-d0ed-449c-a706-1fb2c34cd9ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildB REF= _ChildB;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{a69de2da-8ae4-4029-8194-69664ded7b50}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY FINAL Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{2f00b5a8-2b5b-4f30-b422-77d147e70d15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{9af18252-e82a-44a8-8f73-309b4c2a139a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f4bbd852-f99b-49e7-ab68-70b523c8fe6b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EventReceivedCount" Id="{1d8f7e73-b3d3-476e-af95-d1be237e2cf6}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY EventReceivedCount : INT]]></Declaration>
      <Get Name="Get" Id="{96d44aa0-97b1-4b00-af83-448011627e34}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[EventReceivedCount := _EventReceivedCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{68cee9ff-ba44-4ec4-be24-3c36635da9ee}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Automation.IParentAutomationComponent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Children[0] := _ChildA;
_Children[1] := _ChildB;]]></ST>
      </Implementation>
    </Method>
    <Property Name="LastReceivedEventId" Id="{32827c6e-c385-43b0-b35b-84d7724f2f5d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY LastReceivedEventId : INT]]></Declaration>
      <Get Name="Get" Id="{d6be0dd9-3f9b-4b4c-94a5-d6abfdf73949}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[LastReceivedEventId := _LastReceivedEventId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{507bd594-225e-4b0c-a3b8-5897e64d4d6d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{247cf68e-28a6-4ab8-8cc2-1babc87aa0ff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnEventReceived" Id="{ef875f1f-52e0-40c3-b55f-9607be167100}">
      <Declaration><![CDATA[METHOD OnEventReceived
VAR_INPUT
	event : TOF_Core.IEvent;
END_VAR
VAR_OUTPUT
	stopPropagation : BOOL;
END_VAR
VAR
	mockEv : POINTER TO MockAutomationEvent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EventReceivedCount := _EventReceivedCount + 1;

IF __QUERYPOINTER(event, mockEv) THEN
	_LastReceivedEventId := mockEv^.EventId;
END_IF

stopPropagation := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{d38baae4-6381-436a-89b2-962fd446411c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f31906ad-0d55-4daf-89a4-c615e2acb32b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
