<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomationChildInitializationTimeoutTest" Id="{ef66d2a6-ff4f-4fc7-af7b-b467f210ddab}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks that an incomplete child enters INVALID after its initialization timeout.

Owns a fresh simulated automation fixture and advances one initialization call per PLC cycle.
The fixture limits attempts to fifty calls. No native resources or hardware are involved.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomationChildInitializationTimeoutTest EXTENDS TOF_Testing.MultiCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Fixture : POINTER TO AutomationComponentTestFixture;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="BeforeTest" Id="{ad56f804-69d2-4d2b-92db-e2ed7851b84d}">
      <Declaration><![CDATA[(* Creates the fixture, whose attempt limit bounds the scenario. *)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timeout := T#0S;
_Fixture := __NEW(AutomationComponentTestFixture);

IF _Fixture = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{68ce8353-07ce-46f5-a2a9-eaf2157cff2a}">
      <Declaration><![CDATA[(* Advances one child initialization call and reports completion when the result is observable. *)
METHOD PROTECTED ExecuteTest : TOF_Testing.TEST_CYCLE_RESULT
VAR
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[assertions REF= Assert;
ExecuteTest := _Fixture^.AdvanceInitializationTimeout(assertions := assertions);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{8bbc3447-c73b-4ecf-8cd3-a07b1b6ef66e}">
      <Declaration><![CDATA[(* Releases the fixture before publishing the result, after success or failure. *)
METHOD PROTECTED AfterTest
VAR
	fixture : POINTER TO AutomationComponentTestFixture;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fixture := _Fixture;
_Fixture := 0;

IF fixture <> 0 THEN
	__DELETE(fixture);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{e86534fa-61d7-418b-942f-01669a6f3a99}">
      <Declaration><![CDATA[(*
Releases a still-owned fixture when the case is unloaded.
bInCopyCode — TwinCAT copy-code exit marker. Leave copied ownership with the new instance.
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode AND_THEN _Fixture <> 0 THEN
	__DELETE(_Fixture);
END_IF

FB_exit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{f9034aa0-fe7f-4026-892a-f0019c2aa13d}">
      <Declaration><![CDATA[(* Borrows the concrete class name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{35b5c624-e1ec-4a4a-a1f6-25f59f519340}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7e6c6592-ed82-4975-b9f3-bda648ba45d9}">
      <Declaration><![CDATA[(* Borrows the project namespace name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9ae8a4f7-95fa-46c9-a12f-d8a92ccc7931}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{50199e84-22dc-4b75-b41f-a85c79acb177}">
      <Declaration><![CDATA[(* Reports the complete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d0fd14b8-c0e1-48aa-891b-3e2d46ddfa15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
