<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MockPluginAutomationController" Id="{0457d7ec-5f28-430a-bbb8-105b9f518dc6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Hosts one leaf and borrowed plugins for controller-cycle regression tests.</summary>
<description>
Instances contain self-bound child interfaces and must not be copied. One task owns each instance;
plugin arrays must remain live for all calls that service them.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK MockPluginAutomationController EXTENDS TOF_Automation.AutomationController<1>
VAR_OUTPUT
	//! <summary>Number of completed output passes observed by the after-output hook.</summary>
	AfterOutputCount : INT;
	//! <summary>Counts completed input passes.</summary>
	AfterInputCount : INT;
END_VAR
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Child : MockLeafAutomationComponent(name := "PluginChild", parent := THIS^);
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent := [_Child];
	_MissingChildrenReference : BOOL;
	_ThrowOnGetChildren : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{af616dba-6ba9-4572-b777-b560ace00bfb}">
      <Declaration><![CDATA[(*!
<summary>Borrows the static concrete class name.</summary>
*)
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e4350643-b65b-4e64-af50-6ddc7207e985}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7c3769ca-2c06-477f-88e4-f6bec0e06375}">
      <Declaration><![CDATA[(*!
<summary>Borrows the library namespace.</summary>
*)
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1f8ba484-f5b1-45ba-a5ae-aa97e19398bf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f1782120-5a93-47ca-9fdb-394082d29b9a}">
      <Declaration><![CDATA[(*!
<summary>Gets the size of this complete root instance.</summary>
*)
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c088809d-2ccd-4f1e-8173-a42e74e72e8f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Child" Id="{fd73f972-eae2-4079-bd5a-7e1f0c1b1fba}">
      <Declaration><![CDATA[(*!
<summary>Borrows the root-owned leaf for lifecycle and I/O observations.</summary>
*)
PROPERTY Child : REFERENCE TO MockLeafAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{1813daa1-134e-400c-b47f-caba7b2b47a6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Child REF= _Child;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MissingChildrenReference" Id="{53613bc0-aee4-444b-b718-3184809c063c}">
      <Declaration><![CDATA[(*!
<summary>Controls a missing child storage reference.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY MissingChildrenReference : BOOL]]></Declaration>
      <Get Name="Get" Id="{30a94ccb-b44b-47b3-8435-d39591c5723f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[MissingChildrenReference := _MissingChildrenReference;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{86ccf7b3-709b-429b-8bd7-65e73006d8ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_MissingChildrenReference := MissingChildrenReference;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ThrowOnGetChildren" Id="{59c10fa4-e4fd-4a05-bf0b-1751dac6fdcc}">
      <Declaration><![CDATA[(*!
<summary>Controls an exception from the Children getter.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ThrowOnGetChildren : BOOL]]></Declaration>
      <Get Name="Get" Id="{20e7dedc-5981-4e4f-bcb0-3db7a11a0f90}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnGetChildren := _ThrowOnGetChildren;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{673fc8b2-60c3-4ade-92d6-eb11c0b6b89a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnGetChildren := ThrowOnGetChildren;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Children" Id="{33f7a3d4-61f5-4961-be9a-e464946c7b26}">
      <Declaration><![CDATA[(*!
<summary>Borrows the root-owned child array or injects a configured getter fault.</summary>
*)
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Automation.IChildAutomationComponent]]></Declaration>
      <Get Name="Get" Id="{a8439837-d454-4637-a198-38528c8b8e0e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _ThrowOnGetChildren THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected controller Children getter failure."
	);
END_IF

IF _MissingChildrenReference THEN
	Children REF= 0;
ELSE
	Children REF= _Children;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConfigurePlugins" Id="{d9606f04-64ee-4d63-80f9-42c7e6a18e0f}">
      <Declaration><![CDATA[(*!
<summary>Borrows a plugin array for the regression scenario.</summary>
<description>
The caller keeps the array and plugins live until this controller is no longer serviced. No ownership
is transferred. Call before execution from the owning task.
</description>
*)
METHOD ConfigurePlugins
VAR_IN_OUT CONSTANT
	plugins : ARRAY [*] OF TOF_Automation.IAutomationControllerPlugin;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssignPlugins(plugins := plugins);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenProcessOutput" Id="{452b3a09-8904-4ed4-9549-cd70d5ad533e}">
      <Declaration><![CDATA[(*!
<summary>Counts completed output passes.</summary>
*)
METHOD PROTECTED OnAfterChildrenProcessOutput]]></Declaration>
      <Implementation>
        <ST><![CDATA[AfterOutputCount := AfterOutputCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterChildrenProcessInput" Id="{54723682-dc78-4ba3-850e-3693488116a1}">
      <Declaration><![CDATA[(*! <summary>Records completion of this branch's input traversal.</summary> *)
METHOD PROTECTED OnAfterChildrenProcessInput]]></Declaration>
      <Implementation>
        <ST><![CDATA[AfterInputCount := AfterInputCount + 1;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
