<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomationRunnerObservationTest" Id="{9bc943b3-cbf5-4fa1-9879-77073e97a670}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Reports the selected result published by the dedicated automation runner test task.

Reads synchronized immutable diagnostics. A ten-second timer bounds the wait in the observing task.
Repeated runs re-read the publication. Reinitialize the application to execute the producer again.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomationRunnerObservationTest EXTENDS TOF_Testing.MultiCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	// Maximum real-time wait for publication.
	_PublicationTimeout : TIME := T#10S;
END_VAR
VAR
	_CheckInvalidRoots : BOOL;
	_Deadline : Tc2_Standard.TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{c36351b7-192b-4f0a-bd0e-300f149b4309}">
      <Declaration><![CDATA[(*
Selects which published runner diagnostic this case reports.
name — Name reported for this case.
parent — Group that owns this case.
checkInvalidRoots — TRUE reads root validation. FALSE reads the normal execution result.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	checkInvalidRoots : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_CheckInvalidRoots := checkInvalidRoots;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeTest" Id="{946c4198-f883-4d5a-ad63-e330c2b54e83}">
      <Declaration><![CDATA[(* Clears the publication timer for a new runtime or Reset run. *)
METHOD PROTECTED OnBeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timeout := T#0S;
_Deadline(IN := FALSE, PT := _PublicationTimeout);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{761db4f3-d928-4a0e-8ac1-721eac0960cc}">
      <Declaration><![CDATA[(* Polls synchronized publication once and reports the result when ready. *)
METHOD PROTECTED ExecuteTest : TOF_Testing.TEST_CYCLE_RESULT
VAR
	happyPathFailure : STRING(255);
	invalidRootsFailure : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Deadline(IN := TRUE, PT := _PublicationTimeout);
ExecuteTest := TOF_Testing.TEST_CYCLE_RESULT.DONE;

IF AutomationRunnerTestProgram.ReadResults(
	happyPathFailure => happyPathFailure,
	invalidRootsFailure => invalidRootsFailure
) THEN
	IF _CheckInvalidRoots THEN
		Assert.ThatString(actual := invalidRootsFailure, message := TO_WSTRING(invalidRootsFailure)).ToBe(expected := '');
	ELSE
		Assert.ThatString(actual := happyPathFailure, message := TO_WSTRING(happyPathFailure)).ToBe(expected := '');
	END_IF
ELSIF _Deadline.Q THEN
	RecordFailure(message := "RunnerTestTask did not publish within ten seconds");
ELSE
	ExecuteTest := TOF_Testing.TEST_CYCLE_RESULT.BUSY;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{8c00e182-a4b7-4054-a007-70ef2998f16f}">
      <Declaration><![CDATA[(* Borrows the concrete class name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6d2c23c8-b499-4339-9574-0fa2b63dc7e7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c0770d79-8d39-4f25-9ff6-ee09dc41dd10}">
      <Declaration><![CDATA[(* Borrows the project namespace name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5720d827-35c1-48a7-bdb0-a8176cd216c6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{49395866-0c1e-480b-af49-50823b55e596}">
      <Declaration><![CDATA[(* Reports the complete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{cb94653d-b6ee-40ca-97d9-8076f4d55634}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
