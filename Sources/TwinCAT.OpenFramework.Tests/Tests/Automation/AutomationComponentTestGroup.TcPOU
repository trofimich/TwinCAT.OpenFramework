(*!
<summary>Groups automation lifecycle, policy, event, diagnostics and runner scenarios.</summary>
<description>Owns the fixed case tree and runs its leaves in order in the controller task.</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomationComponentTestGroup EXTENDS TOF_Testing.TestGroup<27>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_LifecycleTransitions : AutomationComponentTestCase(
		name := "TestLifecycleTransitions",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.LIFECYCLE_TRANSITIONS
	);
	_InitializationTimeout : AutomationChildInitializationTimeoutTest(name := "TestInitializationTimeout", parent := THIS^);
	_EnableDisable : AutomationComponentTestCase(
		name := "TestEnableDisable",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.ENABLE_DISABLE
	);
	_ChildErrorPolicyIgnore : AutomationComponentTestCase(
		name := "TestChildErrorPolicyIgnore",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.CHILD_ERROR_POLICY_IGNORE
	);
	_ChildErrorPolicySetErrorAndContinue : AutomationComponentTestCase(
		name := "TestChildErrorPolicySetErrorAndContinue",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.CHILD_ERROR_POLICY_SET_ERROR_AND_CONTINUE
	);
	_ChildErrorPolicySetErrorAndStop : AutomationComponentTestCase(
		name := "TestChildErrorPolicySetErrorAndStop",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.CHILD_ERROR_POLICY_SET_ERROR_AND_STOP
	);
	_EventBubbling : AutomationComponentTestCase(
		name := "TestEventBubbling",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.EVENT_BUBBLING
	);
	_EventBubblingStopPropagation : AutomationComponentTestCase(
		name := "TestEventBubblingStopPropagation",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.EVENT_BUBBLING_STOP_PROPAGATION
	);
	_EventBroadcasting : AutomationComponentTestCase(
		name := "TestEventBroadcasting",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.EVENT_BROADCASTING
	);
	_InputOutputPhases : AutomationComponentTestCase(
		name := "TestInputOutputPhases",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.INPUT_OUTPUT_PHASES
	);
	_OutputPhaseStop : AutomationComponentTestCase(
		name := "TestOutputPhaseStop",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.OUTPUT_PHASE_STOP
	);
	_InputPhaseStop : AutomationComponentTestCase(
		name := "TestInputPhaseStop",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.INPUT_PHASE_STOP
	);
	_OutputPhaseContinuation : AutomationComponentTestCase(
		name := "TestOutputPhaseContinuation",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.OUTPUT_PHASE_CONTINUATION
	);
	_PrimaryErrorBeforeLogging : AutomationComponentTestCase(
		name := "TestPrimaryErrorBeforeLogging",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.PRIMARY_ERROR_BEFORE_LOGGING
	);
	_RunnerHappyPath : AutomationRunnerObservationTest(
		name := "TestRunnerHappyPath",
		parent := THIS^,
		checkInvalidRoots := FALSE
	);
	_RunnerNullComponentGuard : AutomationRunnerObservationTest(
		name := "TestRunnerNullComponentGuard",
		parent := THIS^,
		checkInvalidRoots := TRUE
	);
	_ResetChildPolicies : AutomationComponentTestCase(
		name := "TestResetChildPolicies",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.RESET_CHILD_POLICIES
	);
	_ResetFromStoppedHook : AutomationComponentTestCase(
		name := "TestResetFromStoppedHook",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.RESET_FROM_STOPPED_HOOK
	);
	_ParentValidation : AutomationComponentTestCase(
		name := "TestParentValidation",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.PARENT_VALIDATION
	);
	_DuplicateChild : AutomationComponentTestCase(
		name := "TestDuplicateChild",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.DUPLICATE_CHILD
	);
	_MismatchedChildParent : AutomationComponentTestCase(
		name := "TestMismatchedChildParent",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.MISMATCHED_CHILD_PARENT
	);
	_InitializationFailureResult : AutomationComponentTestCase(
		name := "TestInitializationFailureResult",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.INITIALIZATION_FAILURE_RESULT
	);
	_IndexedLookupContainment : AutomationComponentTestCase(
		name := "TestIndexedLookupContainment",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.INDEXED_LOOKUP_CONTAINMENT
	);
	_ControllerPluginRecovery : AutomationComponentTestCase(
		name := "TestControllerPluginRecovery",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.CONTROLLER_PLUGIN_RECOVERY
	);
	_ResetAndRecoverIgnoreExceptionPolicy : AutomationComponentTestCase(
		name := "TestResetAndRecoverIgnoreExceptionPolicy",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.RESET_AND_RECOVER_IGNORE_EXCEPTION_POLICY
	);
	_AfterChildrenInitializingAndTimeoutPropagation : AutomationComponentTestCase(
		name := "TestAfterChildrenInitializingAndTimeoutPropagation",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.AFTER_CHILDREN_INITIALIZING_AND_TIMEOUT_PROPAGATION
	);
	_DisabledChildStopResetAndHmiCommandConsumption : AutomationComponentTestCase(
		name := "TestDisabledChildStopResetAndHmiCommandConsumption",
		parent := THIS^,
		scenario := AUTOMATION_COMPONENT_TEST_SCENARIO.DISABLED_CHILD_STOP_RESET_AND_HMI_COMMAND_CONSUMPTION
	);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_LifecycleTransitions,
		_InitializationTimeout,
		_EnableDisable,
		_ChildErrorPolicyIgnore,
		_ChildErrorPolicySetErrorAndContinue,
		_ChildErrorPolicySetErrorAndStop,
		_EventBubbling,
		_EventBubblingStopPropagation,
		_EventBroadcasting,
		_InputOutputPhases,
		_OutputPhaseStop,
		_InputPhaseStop,
		_OutputPhaseContinuation,
		_PrimaryErrorBeforeLogging,
		_RunnerHappyPath,
		_RunnerNullComponentGuard,
		_ResetChildPolicies,
		_ResetFromStoppedHook,
		_ParentValidation,
		_DuplicateChild,
		_MismatchedChildParent,
		_InitializationFailureResult,
		_IndexedLookupContainment,
		_ControllerPluginRecovery,
		_ResetAndRecoverIgnoreExceptionPolicy,
		_AfterChildrenInitializingAndTimeoutPropagation,
		_DisabledChildStopResetAndHmiCommandConsumption
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{4c0c1217-728a-4128-b4ec-620bd4b01985}">
      <Declaration><![CDATA[(*!
<summary>Borrows the persistent case array. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{9f36d01b-c07a-4c05-8cc0-c5581adb4f42}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{7c5074a0-8fa5-4332-81b9-22c7a6ea6c6c}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9c285f77-a454-4fa0-bd58-284c63145429}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{4d9ca0d5-b0b3-47b0-9f1c-053e3e62b74c}">
      <Declaration><![CDATA[(*!
<summary>Borrows the project namespace name. Callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{556f7c5d-5095-48eb-84f2-789822fdf0d0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{93cdec16-8dfd-43e1-a7f6-022a37b2a0d4}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b083da81-2e08-4dff-b02a-47b0621edf6e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
