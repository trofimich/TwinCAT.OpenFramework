      <Declaration><![CDATA[(* Records the OnRecover call and optionally injects an exception. *)
METHOD PROTECTED OnRecover]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RecoverCount := _RecoverCount + 1;

IF _ThrowOnRecover THEN
