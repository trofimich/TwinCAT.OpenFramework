    <Method Name="OnWorking" Id="{739d0f66-08d3-465b-b7a1-458c0649f3ae}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD PROTECTED OnWorking]]></Declaration>
      <Implementation>
        <ST><![CDATA[_WorkingCount := _WorkingCount + 1;

IF _FailOnWorking THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Mock leaf failure on working"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
