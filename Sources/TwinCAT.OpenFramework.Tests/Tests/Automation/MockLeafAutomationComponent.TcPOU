    <Method Name="OnEventReceived" Id="{0c87de76-5092-4e69-b2f2-bf3d5f3a3ac8}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD OnEventReceived
VAR_INPUT
	event : TOF_Core.IEvent;
END_VAR
VAR_OUTPUT
	stopPropagation : BOOL;
END_VAR
VAR
	mockEv : POINTER TO MockAutomationEvent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EventReceivedCount := _EventReceivedCount + 1;

IF __QUERYPOINTER(event, mockEv) THEN
	_LastReceivedEventId := mockEv^.EventId;
END_IF

stopPropagation := _StopPropagationOnEvent;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnInitializing" Id="{6fb51265-efad-48f5-a686-62ad9bd26b0a}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD PROTECTED OnInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_InitializeCount := _InitializeCount + 1;
OnInitializing := _InitReturnValue;]]></ST>
      </Implementation>
    </Method>
