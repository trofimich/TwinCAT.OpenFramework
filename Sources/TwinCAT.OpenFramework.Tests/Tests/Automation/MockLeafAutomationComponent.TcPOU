    <Method Name="ApplyExceptionReaction" Id="{5c891c44-9149-4457-adb2-6048d59c3797}">
      <Declaration><![CDATA[(*
Exercises the inherited exception handler with a borrowed diagnostic in the fixture's current state.
exception — Task-local exception that remains live for the call.
reaction — Runtime reaction to apply.
*)
METHOD ApplyExceptionReaction
VAR_INPUT
	exception : TOF_Core.IException;
	reaction : TOF_Core.EXCEPTION_REACTION;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ProcessException(exception := exception, exceptionReaction := reaction, exceptionSourceHint := "Injected primary failure");]]></ST>
      </Implementation>
    </Method>
  </POU>
