(* Mock leaf for lifecycle hooks, I/O phases, initialization/reset faults and event routing. *)

FUNCTION_BLOCK MockLeafAutomationComponent EXTENDS TOF_Automation.InputOutputLeafAutomationComponent
VAR_INPUT
	// Raises one output fault after the output call has been counted.
	ThrowOnNextOutput : BOOL;
	// Raises one fault during input acquisition.
	ThrowOnNextInput : BOOL;
END_VAR
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	_InitializeCount : INT;
	{attribute 'hide'}
	_WorkingCount : INT;
	{attribute 'hide'}
	_ProcessInputCount : INT;
	{attribute 'hide'}
	_ProcessOutputCount : INT;
	{attribute 'hide'}
	_ResetCount : INT;
	{attribute 'hide'}
	_StopCount : INT;
	{attribute 'hide'}
	_EnableCount : INT;
	{attribute 'hide'}
	_DisableCount : INT;
	{attribute 'hide'}
	_EventReceivedCount : INT;
	{attribute 'hide'}
	_LastReceivedEventId : INT;
	{attribute 'hide'}
	_StopPropagationOnEvent : BOOL;
	{attribute 'hide'}
	_InitReturnValue : BOOL := TRUE;
	{attribute 'hide'}
	_FailOnWorking : BOOL;
	_ThrowOnInitializing : BOOL;
	_ThrowOnReset : BOOL;
	_RecoverCount : INT;
	_ThrowOnRecover : BOOL;
	_ThrowOnEnable : BOOL;
	_ThrowOnDisable : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
