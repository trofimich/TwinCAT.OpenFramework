    <Method Name="OnDisable" Id="{d2427892-1a02-494e-bfe1-cdea7c7139be}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(* Records the OnDisable call and optionally injects an exception. *)
METHOD PROTECTED OnDisable]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DisableCount := _DisableCount + 1;

IF _ThrowOnDisable THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected OnDisable failure."
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnEnable" Id="{536c9e62-ae74-4c2a-be87-73caf5b19d2b}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(* Records the OnEnable call and optionally injects an exception. *)
METHOD PROTECTED OnEnable]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EnableCount := _EnableCount + 1;

IF _ThrowOnEnable THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected OnEnable failure."
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnEventReceived" Id="{0c87de76-5092-4e69-b2f2-bf3d5f3a3ac8}" FolderPath="Methods to override\">
      <Declaration><![CDATA[METHOD OnEventReceived
VAR_INPUT
	event : TOF_Core.IEvent;
END_VAR
VAR_OUTPUT
	stopPropagation : BOOL;
END_VAR
VAR
	mockEv : POINTER TO MockAutomationEvent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_EventReceivedCount := _EventReceivedCount + 1;

IF __QUERYPOINTER(event, mockEv) THEN
	_LastReceivedEventId := mockEv^.EventId;
END_IF

stopPropagation := _StopPropagationOnEvent;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnInitializing" Id="{6fb51265-efad-48f5-a686-62ad9bd26b0a}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(*
Records the OnInitializing call and optionally injects an exception.

The exception exercises production conversion into a copied component error; the hook does not own it.
*)
METHOD PROTECTED OnInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_InitializeCount := _InitializeCount + 1;

IF _ThrowOnInitializing THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected OnInitializing failure."
	);
END_IF

OnInitializing := _InitReturnValue;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnProcessInput" Id="{16a990da-11aa-4e60-bc1c-debaa2275464}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(* Counts input calls and raises an armed input fault once. *)
METHOD PROTECTED OnProcessInput]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ProcessInputCount := _ProcessInputCount + 1;

IF ThrowOnNextInput THEN
	ThrowOnNextInput := FALSE;
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected input failure"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnProcessOutput" Id="{13d5c65e-afd4-4d9c-a902-9000ddab6569}" FolderPath="Methods to override\">
      <Declaration><![CDATA[(* Counts output calls and optionally injects a one-shot fault after the observed effect. *)
METHOD PROTECTED OnProcessOutput]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ProcessOutputCount := _ProcessOutputCount + 1;

IF ThrowOnNextOutput THEN
	ThrowOnNextOutput := FALSE;
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected output failure"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
