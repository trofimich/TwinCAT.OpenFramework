(*
Checks the native wrapper message in HIDDEN, LOCAL and UTC modes.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SystemExceptionTimestampFormattingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{2c6ac86b-4219-41fc-a242-e028683b0364}">
      <Declaration><![CDATA[(*
Checks the native wrapper message in HIDDEN, LOCAL and UTC modes.

Uses the borrowed wrapper during one callback. The timestamp expectations use the IEC conversion of
captured values and a separately assembled expected message.
*)
METHOD PROTECTED ExecuteTest
VAR
	exception : TOF_Core.IException;
	hidden : TOF_Core.ERROR_MESSAGE;
	message : TOF_Core.ERROR_MESSAGE;
	expected : WSTRING(255);
	formattingFailed : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ACCESS_VIOLATION,
	catchPointNamespaceName := 'TimestampTest',
	catchPointPOUName := 'NativeCatch',
	catchPointPosition := 'P1'
);

IF exception = 0 THEN
	RecordFailure(message := "The captured native code must provide a wrapper");
	RETURN;
END_IF

hidden := exception.GetMessage(timestampDisplayMode := TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN);
Assert.ThatBool(
	actual := Tc2_Standard.WRIGHT(STR := hidden, SIZE := 31) = "TimestampTest.NativeCatch at P1",
	message := "The hidden timestamp mode must end with the supplied catch location"
).IsTrue();

expected := Tc2_Utilities.WCONCAT(STR1 := hidden, STR2 := " at ");
expected := Tc2_Utilities.WCONCAT(STR1 := expected, STR2 := TO_WSTRING(exception.LocalTimestamp));
formattingFailed := FALSE;

// A formatter exception is recorded for this mode before proceeding to the next check.
__TRY
	message := exception.GetMessage(timestampDisplayMode := TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL);
__CATCH
	formattingFailed := TRUE;
__ENDTRY

Assert.ThatBool(
	actual := NOT formattingFailed AND_THEN message = expected,
	message := "LOCAL must append its captured timestamp"
).IsTrue();

expected := Tc2_Utilities.WCONCAT(STR1 := hidden, STR2 := " at ");
expected := Tc2_Utilities.WCONCAT(STR1 := expected, STR2 := TO_WSTRING(exception.UtcTimestamp));
expected := Tc2_Utilities.WCONCAT(STR1 := expected, STR2 := "UTC");
formattingFailed := FALSE;

// A formatter exception is recorded for this mode before proceeding to the next check.
__TRY
	message := exception.GetMessage(timestampDisplayMode := TOF_Core.TIMESTAMP_DISPLAY_MODE.UTC);
__CATCH
	formattingFailed := TRUE;
__ENDTRY

Assert.ThatBool(
	actual := NOT formattingFailed AND_THEN message = expected,
	message := "UTC must append its captured timestamp and UTC suffix"
).IsTrue();

message := exception.GetMessage(timestampDisplayMode := TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN);
Assert.ThatBool(
	actual := message = hidden,
	message := "Timestamp formatting must preserve the underlying diagnostic"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{981ad815-2bf8-4329-b7e5-a2ce87a55d1d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{11f663e2-dcde-45ce-b8ae-111be164bd13}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7302e617-f19e-437f-97b7-e0ac1e859d37}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c12b7034-59b7-40c2-874f-39325b978ebe}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5f4c46b7-fe9e-4c6e-8ee0-501fd05f0108}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{5b79ecec-6691-4d47-9387-b1e75de529d1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
