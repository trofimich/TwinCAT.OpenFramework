<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SystemExceptionTimestampFormattingTest" Id="{e83b71ae-bb4e-4244-9728-daa0918d9f8f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
