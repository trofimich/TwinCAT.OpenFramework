<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AggregateExceptionBoundedMessageTest" Id="{2554335a-8f4c-431b-bf31-5e17f62834b8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks that a long aggregate diagnostic is terminated and ends in an ellipsis.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AggregateExceptionBoundedMessageTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Aggregate : TOF_Core.AggregateException;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c925eba0-3c06-43e8-8fe2-e661cff1b46a}">
      <Declaration><![CDATA[(*
Checks that a long aggregate diagnostic is terminated and ends in an ellipsis.

Three entries share a capacity-sized cause. Checks the bounded full listing and the snapshot with a short
aggregate summary and a shortened root. The persistent reference array is released in OnAfterTest.
*)
METHOD PROTECTED ExecuteTest
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	cause : TOF_Core.IStandardException;
	payload : TOF_Core.ERROR_MESSAGE;
	message : TOF_Core.ERROR_MESSAGE;
	snapshot : TOF_Core.ERROR;
	payloadUnits : POINTER TO WORD;
	messageUnits : POINTER TO WORD;
	i : UDINT;
END_VAR
VAR CONSTANT
	MESSAGE_CAPACITY : UDINT := TOF_Core.Parameters.ERROR_MESSAGE_WIDE_CHAR_SIZE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Make an ASCII payload whose length scales with the documented diagnostic capacity.
payloadUnits := ADR(payload);

FOR i := 0 TO MESSAGE_CAPACITY - 1 DO
	payloadUnits[i] := WORD#16#0058; // Uppercase X makes the retained prefix distinguishable from the ellipsis.
END_FOR

payloadUnits[MESSAGE_CAPACITY] := TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE);

// Obtain one dynamic cause so repeated entries exercise permitted sharing.
__TRY
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := payload
	);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

IF NOT __QUERYINTERFACE(caught, cause) THEN
	RecordFailure(message := "A task-owned payload is required for the aggregate length check");
	RETURN;
END_IF

_Aggregate.AddInnerException(innerException := cause);
_Aggregate.AddInnerException(innerException := cause);
_Aggregate.AddInnerException(innerException := cause);
message := _Aggregate.GetMessage();

messageUnits := ADR(message);

IF messageUnits[MESSAGE_CAPACITY] <> TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE) THEN
	RecordFailure(message := "The last storage unit must terminate the aggregate diagnostic");
	RETURN;
END_IF

Assert.ThatUDInt(
	actual := TOF_Core.WideStrings.GetLength(value := message),
	message := "The bounded aggregate message must fill the available character capacity"
).ToBe(expected := MESSAGE_CAPACITY);
Assert.ThatBool(
	actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "3 aggregated exceptions$R0:") = 1,
	message := "The bounded message must retain the aggregate header and the first entry marker"
).IsTrue();
Assert.ThatBool(
	actual := messageUnits[MESSAGE_CAPACITY - 2] = WORD#16#0058,
	message := "The bounded message must retain cause text immediately before the ellipsis"
).IsTrue();
Assert.ThatBool(
	actual := messageUnits[MESSAGE_CAPACITY - 1] = TOF_Core.WideStrings.ELLIPSIS,
	message := "The final character must be an ellipsis"
).IsTrue();

_Aggregate.ToError(targetError := snapshot, severity := TOF_Core.ERROR_SEVERITY.CRITICAL);
message := snapshot.ToString();
Assert.ThatBool(
	actual := snapshot.RootMessage = payload AND_THEN snapshot.TopMessage = "3 aggregated exceptions",
	message := "Formatting must preserve the full root in the snapshot"
).IsTrue();
Assert.ThatBool(
	actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "3 aggregated exceptions -> X") = 1
		AND_THEN messageUnits[MESSAGE_CAPACITY - 2] = WORD#16#0058
		AND_THEN messageUnits[MESSAGE_CAPACITY - 1] = TOF_Core.WideStrings.ELLIPSIS
		AND_THEN messageUnits[MESSAGE_CAPACITY] = 0,
	message := "A short aggregate summary must leave the unused space for the long root"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{da596345-5a78-4729-b445-ef794f46aef9}">
      <Declaration><![CDATA[(*
Clears the caller-owned aggregate storage before the result is reported.

Safe after partial setup or repeated Clear. The task memory manager retains ownership of dynamic causes.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Aggregate.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{0583e574-cfb6-4c76-9ded-1b12e65bf318}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{60d99622-b8b3-4d56-bc98-16b9192d666d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{55078304-e630-4323-b2a4-adce39836f0b}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ffa225cd-9c4e-49be-a96b-9778e1e0b8e5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{decd74a7-f436-4301-9d3b-ac96926ad372}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3cbe2884-d542-4cb8-b882-6634e08f5dda}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
