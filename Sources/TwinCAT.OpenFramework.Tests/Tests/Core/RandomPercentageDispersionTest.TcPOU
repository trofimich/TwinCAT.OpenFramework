(*!
<summary>Checks percentage dispersion for both signs and bound forwarding.</summary>
<description>
Owns a generator used by one PLC task. Each run checks the same bounds against fresh samples.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RandomPercentageDispersionTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Random : TOF_Core.Random;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{e8ae1443-b5ec-4849-b500-ae628b1abbdc}">
      <Declaration><![CDATA[(*!
<summary>Samples positive and negative bases and checks exact outcomes for zero and clamped dispersion.</summary>
<description>
The generated ranges have independently calculated endpoints. Enabled bounds cover deterministic cases
outside the generated interval. The test makes no assumptions about sample sequence or distribution.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	value : LREAL;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[value := _Random.GetWithDispersionPercent(baseValue := LREAL#-40.0, dispersionPercent := LREAL#0.0);
Assert.ThatLongReal(
	actual := value,
	message := "Zero percent must return the negative base"
).ToBe(expected := LREAL#-40.0);

value := _Random.GetWithDispersionPercent(
	baseValue := LREAL#80.0,
	dispersionPercent := LREAL#25.0,
	minValue := LREAL#110.0
);
Assert.ThatLongReal(
	actual := value,
	message := "Percentage dispersion must forward the lower bound"
).ToBe(expected := LREAL#110.0);

value := _Random.GetWithDispersionPercent(
	baseValue := LREAL#-40.0,
	dispersionPercent := LREAL#25.0,
	maxValue := LREAL#-60.0
);
Assert.ThatLongReal(
	actual := value,
	message := "Percentage dispersion must forward the upper bound"
).ToBe(expected := LREAL#-60.0);

FOR i := 1 TO 21 DO
	value := _Random.GetWithDispersionPercent(baseValue := LREAL#80.0, dispersionPercent := LREAL#25.0);
	Assert.ThatLongReal(
		actual := value,
		message := "Positive base sample below 60"
	).IsGreaterThanOrEquals(expected := LREAL#60.0);
	Assert.ThatLongReal(
		actual := value,
		message := "Positive base sample above 100"
	).IsLessThanOrEquals(expected := LREAL#100.0);

	value := _Random.GetWithDispersionPercent(baseValue := LREAL#-40.0, dispersionPercent := LREAL#25.0);
	Assert.ThatLongReal(
		actual := value,
		message := "Negative base sample below -50"
	).IsGreaterThanOrEquals(expected := LREAL#-50.0);
	Assert.ThatLongReal(
		actual := value,
		message := "Negative base sample above -30"
	).IsLessThanOrEquals(expected := LREAL#-30.0);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{c31b6d4c-9ea9-4bf4-b80f-c47136a828e6}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3e901119-6332-4797-9ebd-22408c663b8d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a27fc323-3f7f-4f74-bbf8-2ae7c5043f97}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f6b8e1b0-be2a-47bb-80b1-485f8666d2b8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1ffae4b1-24f2-4284-af37-582e6af39fb1}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f10e7bb6-c0f0-472b-b74e-afc3d84fbdf2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
