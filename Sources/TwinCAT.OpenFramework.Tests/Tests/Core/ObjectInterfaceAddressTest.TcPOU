<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ObjectInterfaceAddressTest" Id="{50301169-c256-4097-9740-c6af70175781}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks interface-to-instance address conversion for a static object and for null.

Uses an owned static fixture. The converted address is borrowed and compared only in the calling task.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ObjectInterfaceAddressTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Probe : ObjectExitProbe;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c3f58b6e-6421-4dd3-9590-a3d5650d5f05}">
      <Declaration><![CDATA[(* Converts the live static interface, then checks that a null input does not reuse the address. *)
METHOD PROTECTED ExecuteTest
VAR
	instance : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[instance := _Probe;
Assert.ThatBool(
	actual := TOF_Core.Memory.GetAddressFromInterface(interfaceInstance := instance) = ADR(_Probe),
	message := "The static interface must resolve to the complete probe address"
).IsTrue();

instance := 0;
Assert.ThatBool(
	actual := TOF_Core.Memory.GetAddressFromInterface(interfaceInstance := instance) = 0,
	message := "A null interface must return zero after a successful conversion"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{65deeded-bb32-4287-beeb-73aebbde8ba9}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7fc96a06-9ab4-4dd9-a0b1-1a76d7996a28}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{fb7385d6-619b-4c96-b677-967eaadb0aba}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2a904551-d8a7-47b0-8c42-9690217eadcb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5994c79d-bb34-4a5e-98c8-6dfd0a2f1a25}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9612ca37-d224-40a4-8494-31cfefa1f0e2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
