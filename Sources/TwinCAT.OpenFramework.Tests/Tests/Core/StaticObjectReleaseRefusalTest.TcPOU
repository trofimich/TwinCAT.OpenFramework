<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticObjectReleaseRefusalTest" Id="{3588a667-0015-4023-a91f-9899435a30bf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks that the dynamic release helper refuses to destroy a static object.</summary>
<description>
Owns a static probe and a persistent exit counter. Each run binds and clears the counter before making the
release request. The test executes in one PLC task and keeps the probe at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticObjectReleaseRefusalTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Probe : ObjectExitProbe;
	_ExitCount : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{cf6cdd24-7012-4741-8aad-d7f13d8ffd6d}">
      <Declaration><![CDATA[(*!
<summary>Checks refusal, preserved interface identity and absence of a concrete exit call.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	instance : TOF_Core.IObject;
	originalInstance : TOF_Core.IObject;
	released : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExitCount := 0;
_Probe.ObserveExit(counter := _ExitCount);
instance := _Probe;
originalInstance := instance;
released := TOF_Core.Memory.TryReleaseDynamicObject(instance := instance);

Assert.ThatBool(actual := released, message := "Static instance release must be refused").IsFalse();
Assert.ThatBool(
	actual := instance = originalInstance,
	message := "Refusal must preserve the original static interface"
).IsTrue();
Assert.ThatUDInt(
	actual := _ExitCount,
	message := "Refusal must not call the static probe FB_exit"
).ToBe(expected := 0);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{d3f14891-5ed0-41c0-b04e-65bf5fc98c3c}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{47c2515c-7188-40e6-8b89-9b6435489a68}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0dfad748-bea5-4762-8baa-08ac1a8c650f}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c46d23bb-c77a-401d-b9c7-662c70b4d396}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{649cde9f-fcd1-417e-ad6d-9e1c71390600}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3412c6aa-4bb8-4877-b688-81ab1a0c01a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
