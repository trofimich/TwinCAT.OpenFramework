(*!
<summary>Static test adapter exposing the inherited formatter with deterministic inputs.</summary>
*)

FUNCTION_BLOCK ExceptionTimestampProbe EXTENDS TOF_Core.StandardException]]></Declaration>
    <Implementation><ST><![CDATA[]]></ST></Implementation>
    <Method Name="FormatTimestamp" Id="{e6c4f6eb-9a61-4bbc-bc62-687bec77c8fb}">
      <Declaration><![CDATA[METHOD FormatTimestamp : TOF_Core.ERROR_MESSAGE
VAR_INPUT
	mode : TOF_Core.TIMESTAMP_DISPLAY_MODE;
	localTime : LDATE_AND_TIME;
	utcTime : LDATE_AND_TIME;
END_VAR
VAR
	builder : TOF_Core.WideStringBuilder;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AppendTimestampDescription(builder, mode, localTime, utcTime);
builder.AssignToString(FormatTimestamp);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
