(*!
<summary>Checks the shared exception timestamp formatter with fixed local and UTC inputs.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ExceptionTimestampFormattingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Probe : ExceptionTimestampProbe;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{01905673-230c-49a9-a77d-67b48680610c}">
      <Declaration><![CDATA[(*!
<summary>Checks the shared exception timestamp formatter with fixed local and UTC inputs.</summary>
<description>
Calls the existing adapter with deterministic timestamps. The result uses the exception diagnostic capacity.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR CONSTANT
	LOCAL_TIMESTAMP : LDATE_AND_TIME := LDT#2026-10-06-15:04:05;
	UTC_TIMESTAMP : LDATE_AND_TIME := LDT#2026-10-06-12:04:05;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[message := _Probe.FormatTimestamp(
	mode := TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN,
	localTime := LOCAL_TIMESTAMP,
	utcTime := UTC_TIMESTAMP
);
Assert.ThatBool(
	actual := message = "",
	message := "Hidden timestamp must leave an empty target unchanged"
).IsTrue();

message := _Probe.FormatTimestamp(
	mode := TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL,
	localTime := LOCAL_TIMESTAMP,
	utcTime := UTC_TIMESTAMP
);
Assert.ThatBool(
	actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "15:04:05") > 0,
	message := "LOCAL formatting must use local time"
).IsTrue();
Assert.ThatBool(
	actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "UTC") = 0,
	message := "LOCAL formatting must omit the UTC suffix"
).IsTrue();

message := _Probe.FormatTimestamp(
	mode := TOF_Core.TIMESTAMP_DISPLAY_MODE.UTC,
	localTime := LOCAL_TIMESTAMP,
	utcTime := UTC_TIMESTAMP
);
Assert.ThatBool(
	actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "12:04:05") > 0,
	message := "UTC formatting must use UTC time"
).IsTrue();
Assert.ThatBool(
	actual := Tc2_Standard.WRIGHT(STR := message, SIZE := 3) = "UTC",
	message := "UTC formatting must retain the UTC suffix"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{48ba5f7a-23a6-407a-a7ec-5e8f58d47db7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8b24143c-cf6a-44ed-90e2-fbcf20b672c5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f9261996-ba25-4a20-9327-4feda1a099b9}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{61eab1e5-f484-4159-a2b0-61f956a91394}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6a2508bd-0659-4eea-9997-949db2c0c593}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{814f2448-5e95-46d1-98b5-b5afd8f20af5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
