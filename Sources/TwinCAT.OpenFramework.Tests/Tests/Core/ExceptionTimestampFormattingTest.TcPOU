<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ExceptionTimestampFormattingTest" Id="{76085225-1ee6-44d4-93ca-ab172fd77d7f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
