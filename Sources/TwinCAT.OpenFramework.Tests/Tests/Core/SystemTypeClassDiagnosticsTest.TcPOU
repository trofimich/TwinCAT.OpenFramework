(*!
<summary>Checks runtime type names in exceptions and unsupported-value diagnostics.</summary>
<description>
Uses run-local fixtures and references that are used only within the executing PLC task.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SystemTypeClassDiagnosticsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{02785df1-9535-41a4-9c1c-372360700b6c}">
      <Declaration><![CDATA[(*!
<summary>Checks runtime names in public string rejection messages and unsupported-value markers.</summary>
<description>
Catches deliberate type errors to inspect the message while the task-owned exception is alive.
Checks the exception type and exact message. A failed append must preserve its target.
Unsupported arrays must retain a readable TYPE_ARRAY marker and size.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	narrowTarget : STRING(10) := 'keep';
	wideTarget : WSTRING(10) := "keep";
	narrowMessage : STRING(255);
	wideMessage : WSTRING(255);
	unsupportedValue : ARRAY [0..0] OF DINT;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	notSupportedException : TOF_Core.INotSupportedException;
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Capture the deliberate type error so its specific payload can be checked.
__TRY
	TOF_Core.WideStrings.AppendFit255(narrowTarget, "x");
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

IF __QUERYINTERFACE(caughtException, notSupportedException) THEN
	message := caughtException.GetMessage();
	Assert.ThatBool(
		actual := message = "Not supported type TYPE_STRING",
		message := "WideStrings.AppendFit255 must name TYPE_STRING in the exception message"
	).IsTrue();
ELSE
	RecordFailure(message := "WideStrings.AppendFit255 must reject TYPE_STRING with NotSupportedException");
END_IF

caughtException := 0;

// Capture the deliberate type error so its specific payload can be checked.
__TRY
	TOF_Core.Strings.AppendFit255(wideTarget, 'x');
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

IF __QUERYINTERFACE(caughtException, notSupportedException) THEN
	message := caughtException.GetMessage();
	Assert.ThatBool(
		actual := message = "Not supported type TYPE_WSTRING",
		message := "Strings.AppendFit255 must name TYPE_WSTRING in the exception message"
	).IsTrue();
ELSE
	RecordFailure(message := "Strings.AppendFit255 must reject TYPE_WSTRING with NotSupportedException");
END_IF

Assert.ThatBool(actual := narrowTarget = 'keep', message := "Rejected STRING target changed").IsTrue();
Assert.ThatBool(actual := wideTarget = "keep", message := "Rejected WSTRING target changed").IsTrue();

narrowMessage := TOF_Core.Strings.AnyToString255(value := unsupportedValue);
wideMessage := TOF_Core.WideStrings.AnyToString255(value := unsupportedValue);
Assert.ThatBool(
	actual := TOF_Core.Strings.Contains(stringToSearchIn := narrowMessage, stringToFind := 'type class: TYPE_ARRAY'),
	message := "STRING marker must identify the unsupported DINT array"
).IsTrue();
Assert.ThatBool(
	actual := TOF_Core.WideStrings.Contains(
		stringToSearchIn := wideMessage,
		stringToFind := "type class: TYPE_ARRAY"
	),
	message := "WSTRING marker must identify the unsupported DINT array"
).IsTrue();
Assert.ThatBool(
	actual := TOF_Core.Strings.Contains(stringToSearchIn := narrowMessage, stringToFind := 'size: 4 bytes'),
	message := "STRING marker must include the size of one DINT"
).IsTrue();
Assert.ThatBool(
	actual := TOF_Core.WideStrings.Contains(stringToSearchIn := wideMessage, stringToFind := "size: 4 bytes"),
	message := "WSTRING marker must include the size of one DINT"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{955fd722-f334-40cd-bc20-4fbcc19cf882}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{58ac773a-71de-49c4-896f-7e42c474660c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{46f33f53-61f6-4b4f-bb52-d5496a3e4140}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{40dc465e-9206-4ba1-8b64-bf1a479ccb89}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5df1f7f8-405a-4715-879a-13934b4206f3}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f147cb69-7079-4642-bfb7-ab9c8f24285a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
