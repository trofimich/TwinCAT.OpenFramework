<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericValueTestGroup" Id="{038b7d43-5264-4319-a6b8-ab574afe5a4e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups generic storage, ordering, conversion and runtime type diagnostics.</summary>
<description>
Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK GenericValueTestGroup EXTENDS TOF_Testing.TestGroup<8>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_LongStrings : GenericLongStringOrderingTest(name := "LongStringOrdering", parent := THIS^);
	_StringPrefixes : GenericStringPrefixOrderingTest(name := "StringPrefixAndEncodingOrder", parent := THIS^);
	_NaNs : GenericNaNOrderingTest(name := "NaNOrdering", parent := THIS^);
	_MixedNumericPrecision : GenericMixedNumericPrecisionTest(name := "MixedNumericPrecision", parent := THIS^);
	_ConversionPairs : GenericConversionPairsTest(name := "SupportedConversionPairs", parent := THIS^);
	_TypeClassFormatting : SystemTypeClassFormattingTest(name := "SystemTypeClassFormatting", parent := THIS^);
	_TypeClassDiagnostics : SystemTypeClassDiagnosticsTest(name := "TypeClassDiagnostics", parent := THIS^);
	_BorrowedWrites : GenericBorrowedWritesTest(name := "ChangesCompatibleValues", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_LongStrings,
		_StringPrefixes,
		_NaNs,
		_MixedNumericPrecision,
		_ConversionPairs,
		_TypeClassFormatting,
		_TypeClassDiagnostics,
		_BorrowedWrites
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{d4e0fab8-62d5-402e-b493-3f273855c941}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{ad68b7c1-a2de-421b-b494-747c53aac85b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{4825a842-8b78-4d37-b537-9f12957c13bb}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{02746a8c-a48f-458b-9d42-b7549405b550}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7c7ff893-96de-4ace-b7d9-25e5fddeac19}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ff579da4-a99e-4a65-b7f6-c32764785788}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{367e18c1-6e40-4817-a568-e5e9a4b8bbf1}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9910d15d-9555-4da6-a390-7de4b12be899}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
