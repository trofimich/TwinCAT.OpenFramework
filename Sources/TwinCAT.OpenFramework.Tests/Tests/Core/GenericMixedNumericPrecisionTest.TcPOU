<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericMixedNumericPrecisionTest" Id="{4674b2c9-83e5-4283-98d5-ab1a2da19388}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks integer-to-floating comparisons at exact representation boundaries.

Uses run-local fixtures and references that are used only within the executing PLC task.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK GenericMixedNumericPrecisionTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{d3d8e885-55af-42a3-9e4d-690228dc967c}">
      <Declaration><![CDATA[(*
Checks exact integer-to-floating ordering at precision, range and fractional boundaries.

Uses independent expected directions for both operand orders. Values around 2^53 reproduce the transitivity
defect caused by converting integers to LREAL. Raw patterns cover signed zero, subnormal and infinite values.
*)
METHOD PROTECTED ExecuteTest
VAR
	signedInteger : LINT;
	unsignedInteger : ULINT;
	floatingValue : LREAL;
	narrowReal : REAL;
	realBits : TOF_Core.LREAL_UNION;
	integerValue : TOF_Core.GENERIC_VALUE;
	realValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[integerValue := TOF_Core.GenericValueFactory.FromLIntReference(value := signedInteger);
realValue := TOF_Core.GenericValueFactory.FromLRealReference(value := floatingValue);
floatingValue := LREAL#9007199254740992.0;
signedInteger := LINT#9007199254740993;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Integer one above 2^53"
);
signedInteger := LINT#9007199254740992;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	scenario := "Integer equal to 2^53"
);
signedInteger := LINT#9007199254740991;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Integer one below 2^53"
);

floatingValue := LREAL#-9007199254740992.0;
signedInteger := LINT#-9007199254740993;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Integer below negative 2^53"
);
signedInteger := LINT#-9007199254740991;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Integer above negative 2^53"
);

floatingValue := LREAL#9223372036854775808.0;
signedInteger := TOF_Core.SignedInt64.MAX_VALUE;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "LINT maximum against 2^63"
);
floatingValue := LREAL#-9223372036854775808.0;
signedInteger := TOF_Core.SignedInt64.MIN_VALUE;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	scenario := "LINT minimum against negative 2^63"
);

integerValue := TOF_Core.GenericValueFactory.FromULIntReference(value := unsignedInteger);
floatingValue := LREAL#18446744073709551616.0;
unsignedInteger := TOF_Core.UnsignedInt64.MAX_VALUE;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "ULINT maximum against 2^64"
);
floatingValue := LREAL#9223372036854775808.0;
unsignedInteger := ULINT#9223372036854775809;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Unsigned integer one above 2^63"
);

integerValue := TOF_Core.GenericValueFactory.FromLIntReference(value := signedInteger);
signedInteger := -1;
floatingValue := LREAL#-0.5;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Negative integer against negative half"
);
signedInteger := 0;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Zero against negative half"
);
floatingValue := LREAL#0.5;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Zero against positive half"
);
signedInteger := 1;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Positive integer against positive half"
);
signedInteger := 42;
floatingValue := LREAL#42.0;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	scenario := "Equal positive integral operands"
);
floatingValue := LREAL#42.5;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Positive integer against a larger fraction"
);
floatingValue := LREAL#-42.5;
signedInteger := -42;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Negative integer against a smaller fraction"
);

realValue := TOF_Core.GenericValueFactory.FromLRealReference(value := realBits.Value);
signedInteger := 0;
realBits.Raw := ULINT#16#8000000000000000;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	scenario := "Integer zero against negative floating zero"
);
realBits.Raw := ULINT#1;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Zero against the smallest positive LREAL subnormal"
);
realBits.Raw := ULINT#16#7FF0000000000000;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	scenario := "Zero against positive infinity"
);
realBits.Raw := ULINT#16#FFF0000000000000;
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Zero against negative infinity"
);

narrowReal := REAL#16777216.0;
signedInteger := LINT#16777217;
realValue := TOF_Core.GenericValueFactory.FromRealReference(value := narrowReal);
assertOrder(
	first := integerValue,
	second := realValue,
	expected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	scenario := "Integer above the REAL precision limit"
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="assertOrder" Id="{16a7c9b1-576a-43a3-a259-cd018b11477a}">
      <Declaration><![CDATA[(*
Checks a numeric comparison and its reverse against an independently supplied expected direction.

Borrows both descriptors for assertions; no payload mutation or ownership transfer occurs.
first — First numeric descriptor.
second — Second numeric descriptor.
expected — Expected comparison of first with second.
scenario — Boundary name included in assertion failures.
*)
METHOD PRIVATE assertOrder
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
	expected : TOF_Core.COMPARISON_RESULT;
	scenario : WSTRING(255);
END_VAR
VAR
	reversedExpected : TOF_Core.COMPARISON_RESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE expected OF
	TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND:
		reversedExpected := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND:
		reversedExpected := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND:
		reversedExpected := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
END_CASE

Assert.ThatSInt(
	actual := TO_SINT(first.CompareTo(otherValue := second)),
	message := Tc2_Utilities.WCONCAT(STR1 := "Integer first: ", STR2 := scenario)
).ToBe(expected := TO_SINT(expected));
Assert.ThatSInt(
	actual := TO_SINT(second.CompareTo(otherValue := first)),
	message := Tc2_Utilities.WCONCAT(STR1 := "Float first: ", STR2 := scenario)
).ToBe(expected := TO_SINT(reversedExpected));]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{1d4a7872-bb0e-400e-85a7-021a3f4a0ec1}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{53275125-7fde-466b-a01e-f300278ce7c2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{08ae1bd8-aaf9-4932-898e-56375ff7936e}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{380120de-832b-44a3-8017-af917c7406eb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{71f30c4b-8019-4af8-9526-2fb168894cb1}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{13071a4f-4685-4365-b1bd-05d4cfc4c7e1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
