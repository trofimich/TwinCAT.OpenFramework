<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ExceptionTestGroup" Id="{ece4285a-5c48-4c35-b9d8-0e82a220ff53}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups exception transport, diagnostics, cloning and graph contract tests.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ExceptionTestGroup EXTENDS TOF_Testing.TestGroup<13>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_NotImplemented : NotImplementedExceptionTest(name := "SimpleException", parent := THIS^);
	_StandardChain : StandardExceptionChainTest(name := "StandardExceptions", parent := THIS^);
	_Aggregate : AggregateExceptionPropagationTest(name := "AggregateException", parent := THIS^);
	_SavedFramework : SavedFrameworkExceptionRethrowTest(name := "RethrowSavedFrameworkException", parent := THIS^);
	_NativeRethrow : SystemExceptionRethrowTest(name := "RethrowSystemExceptionAfterFramework", parent := THIS^);
	_TimestampFormatting : ExceptionTimestampFormattingTest(name := "TimestampFormatting", parent := THIS^);
	_SystemTimestamp : SystemExceptionTimestampFormattingTest(
		name := "SystemExceptionTimestampFormatting",
		parent := THIS^
	);
	_SystemClone : SystemExceptionCloneTest(name := "SystemExceptionClone", parent := THIS^);
	_AggregateClone : AggregateExceptionCloneTest(name := "AggregateCloneLifetime", parent := THIS^);
	_ArgumentTypeClone : ArgumentTypeExceptionCloneTest(name := "ArgumentTypeCloneIdentity", parent := THIS^);
	_GraphRejection : ExceptionGraphRejectionTest(name := "GraphRejection", parent := THIS^);
	_BoundedMessage : AggregateExceptionBoundedMessageTest(name := "BoundedMessage", parent := THIS^);
	_AggregateGrowth : AggregateExceptionGrowthTest(name := "AggregateBufferGrowth", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_NotImplemented,
		_StandardChain,
		_Aggregate,
		_SavedFramework,
		_NativeRethrow,
		_TimestampFormatting,
		_SystemTimestamp,
		_SystemClone,
		_AggregateClone,
		_ArgumentTypeClone,
		_GraphRejection,
		_BoundedMessage,
		_AggregateGrowth
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{d639930a-a7d4-4967-9be8-fb99de8e99ec}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{61795337-a5da-4a37-b571-9b46feaa8eff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{19156c56-ed21-44be-9ac1-27a0d27cc9f4}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bbfa242c-c7c2-40fa-8837-2ca8af149a53}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{cc5f09b9-85fd-4355-8797-e35455d044d3}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c86ebd85-96d9-4ee3-b552-abf3707b80c3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f3aec485-3a98-47b0-b8ee-e80f8d88306a}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9e3949e7-752d-4e18-a697-cb3da0f268a8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
