<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericLongStringOrderingTest" Id="{dc6b6d7b-f6a3-48f6-bc39-8ac377bde4cc}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Compares strings that differ after character 255.</summary>
<description>
Uses run-local fixtures and references that are used only within the executing PLC task.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK GenericLongStringOrderingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{6ee81047-740f-4e60-b772-73d26890ac2c}">
      <Declaration><![CDATA[(*!
<summary>Checks ordering after a 299-character common prefix in both string encodings.</summary>
<description>
Includes narrow, wide and mixed operands, reverse order and equality beyond 255 characters.
Both 300-character fixtures contain ASCII and explicitly terminate their buffers at offset 300.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	narrowFirst : STRING(300);
	narrowSecond : STRING(300);
	wideFirst : WSTRING(300);
	wideSecond : WSTRING(300);
	wideFirstData : POINTER TO WORD;
	wideSecondData : POINTER TO WORD;
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[wideFirstData := ADR(wideFirst);
wideSecondData := ADR(wideSecond);

// SA0175: Construct and explicitly terminate 300-byte ASCII operands.
{analysis -175}
FOR i := 0 TO 299 DO
	narrowFirst[i] := BYTE#16#61;
	narrowSecond[i] := BYTE#16#61;
	wideFirstData[i] := WORD#16#61;
	wideSecondData[i] := WORD#16#61;
END_FOR

narrowSecond[299] := BYTE#16#62;
narrowFirst[300] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);
narrowSecond[300] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);
{analysis +175}
wideSecondData[299] := WORD#16#62;
wideFirstData[300] := TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE);
wideSecondData[300] := TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE);
first := TOF_Core.GenericValueFactory.FromStringReference(value := narrowFirst);
second := TOF_Core.GenericValueFactory.FromStringReference(value := narrowSecond);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "Narrow ordering must include characters after position 255"
).IsTrue();

first := TOF_Core.GenericValueFactory.FromWStringReference(value := wideFirst);
second := TOF_Core.GenericValueFactory.FromWStringReference(value := wideSecond);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "Wide ordering must include characters after position 255"
).IsTrue();

first := TOF_Core.GenericValueFactory.FromStringReference(value := narrowFirst);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "Mixed ordering must include the complete narrow and wide strings"
).IsTrue();
Assert.ThatBool(
	actual := second.CompareTo(otherValue := first) = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	message := "Reversing mixed operands must reverse the result"
).IsTrue();

second := TOF_Core.GenericValueFactory.FromWStringReference(value := wideFirst);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	message := "Equal long strings must compare equal across encodings"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{c6b8d611-affd-4f5e-a276-a3390c757ffd}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{35b2ba80-0deb-4468-8dba-68cfd845917e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1aba7c9d-0d9e-4f04-9a64-ad7a230ebdfa}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{86bbebde-0cd1-4599-872d-5a68da2c673a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e3a6eebb-442e-40fe-88cd-24d9fecbf308}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{bd181f51-0858-49bc-aca8-39b044558729}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
