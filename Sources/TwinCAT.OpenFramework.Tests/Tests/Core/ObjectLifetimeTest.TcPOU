FUNCTION_BLOCK ObjectLifetimeTest EXTENDS TcUnit.FB_TestSuite]]></Declaration>
    <Implementation>
      <ST><![CDATA[DeleteTypedPointer();
DeleteThroughIObject();
GetInstanceAddress();
RefuseStaticObjectRelease();]]></ST>
    </Implementation>
    <Method Name="DeleteTypedPointer" Id="{f354db45-429e-4325-b3eb-404aceb1acd4}">
      <Declaration><![CDATA[METHOD DeleteTypedPointer
VAR
	probe : POINTER TO ObjectExitProbe;
	exitCount : UDINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

probe := __NEW(ObjectExitProbe);
IF probe = 0 THEN
	AssertEquals_BOOL(TRUE, FALSE, 'Probe allocation failed');
ELSE
	probe^.ObserveExit(exitCount);
	__DELETE(probe);

	AssertEquals_UDINT(1, exitCount, 'Typed deletion must call the concrete FB_exit once');
END_IF

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeleteThroughIObject" Id="{a91708c6-1023-4b4f-9905-b8c3c7f7ff17}">
      <Declaration><![CDATA[METHOD DeleteThroughIObject
VAR
	probe : POINTER TO ObjectExitProbe;
	instance : TOF_Core.IObject;
	exitCount : UDINT;
	released : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

probe := __NEW(ObjectExitProbe);
IF probe = 0 THEN
	AssertEquals_BOOL(TRUE, FALSE, 'Probe allocation failed');
ELSE
	probe^.ObserveExit(exitCount);
	instance := probe^;
	AssertEquals_BOOL(TRUE, TOF_Core.Memory.GetAddressFromInterface(instance) = probe, 'Dynamic interface must resolve to the complete instance address');
	released := TOF_Core.Memory.TryReleaseDynamicObject(instance);

	AssertEquals_BOOL(TRUE, released, 'Dynamic object release was refused');
	IF released THEN
		// The typed pointer is now a dangling alias; never delete or dereference it.
		probe := 0;
		AssertEquals_BOOL(TRUE, instance = 0, 'Release must clear the passed interface');
		AssertEquals_UDINT(1, exitCount, 'Release through IObject must call the concrete FB_exit once');
		AssertEquals_BOOL(FALSE, TOF_Core.Memory.TryReleaseDynamicObject(instance), 'Repeated release must be a no-op');
		AssertEquals_UDINT(1, exitCount, 'Repeated release must not call FB_exit again');
	ELSE
		// Refused release leaves the instance alive; clean up through its exact type.
		__DELETE(probe);
		instance := 0;
	END_IF
END_IF

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetInstanceAddress" Id="{79968e37-2251-45b8-bdc6-0e2ff7af86bc}">
      <Declaration><![CDATA[METHOD GetInstanceAddress
VAR
	instance : TOF_Core.IObject;
END_VAR
VAR_INST
	probe : ObjectExitProbe;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

instance := probe;
AssertEquals_BOOL(TRUE, TOF_Core.Memory.GetAddressFromInterface(instance) = ADR(probe), 'Static interface must resolve to the complete instance address');
instance := 0;
AssertEquals_BOOL(TRUE, TOF_Core.Memory.GetAddressFromInterface(instance) = 0, 'Null interface must return zero after a successful conversion');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="RefuseStaticObjectRelease" Id="{d1759f9d-5e57-470c-92c1-533d09a37a77}">
      <Declaration><![CDATA[METHOD RefuseStaticObjectRelease
VAR
	instance : TOF_Core.IObject;
END_VAR
VAR_INST
	probe : ObjectExitProbe;
	exitCount : UDINT;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

probe.ObserveExit(exitCount);
instance := probe;
AssertEquals_BOOL(FALSE, TOF_Core.Memory.TryReleaseDynamicObject(instance), 'Static instance release must be refused');
AssertEquals_BOOL(TRUE, instance = probe, 'Refused release must preserve the interface');
AssertEquals_UDINT(0, exitCount, 'Refused release must not call FB_exit');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
