<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ObjectLifetimeTest" Id="{fd3e4307-69aa-4ebb-9fda-16de60cd1902}" SpecialFunc="None">
    <Declaration><![CDATA[(*

.. <legal notes>

