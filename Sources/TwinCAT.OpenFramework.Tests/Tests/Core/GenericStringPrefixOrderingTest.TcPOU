<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericStringPrefixOrderingTest" Id="{dee3f485-1457-4462-b649-cc05a2506efa}" SpecialFunc="None">
    <Declaration><![CDATA[(*
