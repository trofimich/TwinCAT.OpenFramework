(*!
<summary>Checks mixed-encoding prefixes and unsigned code units.</summary>
<description>
Uses run-local fixtures and references that are used only within the executing PLC task.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK GenericStringPrefixOrderingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{cf36a3f7-5a51-4897-9cf0-08b2e2a3ea3a}">
      <Declaration><![CDATA[(*!
<summary>Checks terminators, prefixes and unsigned Latin-1 code units in mixed string comparisons.</summary>
<description>
Uses terminated buffers and confirms both operand directions without encoding conversions.
The FF fixture deliberately writes one Latin-1 byte rather than a UTF-8 sequence.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	narrow : STRING(2);
	wide : WSTRING(2);
	wideData : POINTER TO WORD;
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[first := TOF_Core.GenericValueFactory.FromStringReference(value := narrow);
second := TOF_Core.GenericValueFactory.FromWStringReference(value := wide);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	message := "Empty strings must compare equal across encodings"
).IsTrue();

narrow := 'a';
wide := "ab";
first := TOF_Core.GenericValueFactory.FromStringReference(value := narrow);
second := TOF_Core.GenericValueFactory.FromWStringReference(value := wide);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "A prefix must precede a longer string"
).IsTrue();
Assert.ThatBool(
	actual := second.CompareTo(otherValue := first) = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	message := "A longer string must follow its prefix"
).IsTrue();

// SA0175: The test requires one Latin-1 FF code unit, not a UTF-8 sequence, followed by a terminator.
{analysis -175}
narrow[0] := BYTE#16#FF;
narrow[1] := BYTE#0;
{analysis +175}
wideData := ADR(wide);
wideData[0] := WORD#16#FF;
wideData[1] := WORD#0;
first := TOF_Core.GenericValueFactory.FromStringReference(value := narrow);
second := TOF_Core.GenericValueFactory.FromWStringReference(value := wide);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	message := "Latin-1 FF must widen to code unit 00FF"
).IsTrue();

wideData[0] := WORD#16#100;
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "Latin-1 FF must precede UTF-16 0100"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ce3728fd-6b14-43ff-b070-9fca95d6fc1e}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{85cef461-bf7f-4e77-bee2-d59c6574bd8b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{94cfed44-7fb9-447f-8915-2a3b412a9a24}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0517cf48-80a8-433d-9f7a-1a21cb423ea6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{44bbd3c4-23d8-4744-8bd9-45b6b9c7666b}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{185942ff-4893-4ecf-8d7b-98f7227cc47d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
