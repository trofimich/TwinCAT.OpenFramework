<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ObjectLifetimeTestGroup" Id="{82b368af-9ffc-4979-8aa2-5c02948bfc6b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups the four object lifetime cases.</summary>
<description>
Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ObjectLifetimeTestGroup EXTENDS TOF_Testing.TestGroup<4>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_TypedDeletion : DynamicObjectDisposalTest(
		name := "DeleteTypedPointer",
		parent := THIS^,
		releaseThroughInterface := FALSE
	);
	_InterfaceDeletion : DynamicObjectDisposalTest(
		name := "DeleteThroughIObject",
		parent := THIS^,
		releaseThroughInterface := TRUE
	);
	_Address : ObjectInterfaceAddressTest(name := "GetInstanceAddress", parent := THIS^);
	_StaticRefusal : StaticObjectReleaseRefusalTest(name := "RefuseStaticObjectRelease", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_TypedDeletion,
		_InterfaceDeletion,
		_Address,
		_StaticRefusal
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{95643e18-34a2-46a9-9870-4071660356ee}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{46013f3d-f48b-410e-8ec3-d524af95a067}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{9563817f-a3e5-4d88-bd85-1c0d927f7266}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{353ec692-706c-44e3-b729-1b3a807c9be0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{80ad2d7c-015a-49d0-9621-1cebe4958892}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d9bcc4fb-fa24-4697-aacf-49ebc777b482}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{72bcab15-c3e8-4647-b9af-c95b25cc97ab}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{59116f74-9353-4a7a-8e6c-1982baaf8a90}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
