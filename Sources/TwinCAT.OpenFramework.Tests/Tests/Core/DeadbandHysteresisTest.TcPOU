<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DeadbandHysteresisTest" Id="{18dd4568-f11a-4cec-9f1e-07eaaf531161}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks threshold equality, latching direction and restart behavior.

Each execution configures the persistent hysteresis instance before evaluating inputs.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DeadbandHysteresisTest EXTENDS TOF_Testing.SingleCycleTest
VAR
	_Hysteresis : TOF_Core.DeadbandHysteresis;
END_VAR
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a257090b-d594-4bf9-8adf-c9b8ce264720}">
      <Declaration><![CDATA[(*
Exercises rising, falling and zero-width bands at and across their thresholds.

Reconfigures while latched and observes an in-band input before it can latch again.
*)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Hysteresis.RestartWithDeadband(
	latchValue := 10,
	absoluteDeadband := 2,
	mode := TOF_Core.HYSTERESIS_MODE.LATCH_ON_RISE_RESET_ON_FALL
);
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 9),
	message := "Rising starts clear inside the band"
).IsFalse();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 10),
	message := "Rising latches at equality"
).IsTrue();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 8),
	message := "Rising retains state at the reset threshold"
).IsTrue();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 7),
	message := "Rising clears below reset"
).IsFalse();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 10),
	message := "Rising relatches before reconfiguration"
).IsTrue();

_Hysteresis.RestartWithResetValue(latchValue := 8, resetValue := 10);
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 9),
	message := "Restart clears the previous latch"
).IsFalse();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 8),
	message := "Falling latches at equality"
).IsTrue();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 10),
	message := "Falling retains state at the reset threshold"
).IsTrue();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 11),
	message := "Falling clears above reset"
).IsFalse();

_Hysteresis.RestartWithResetValue(latchValue := 5, resetValue := 5);
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 6),
	message := "Equal thresholds select falling mode"
).IsFalse();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 5),
	message := "Zero band latches at equality"
).IsTrue();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 5),
	message := "Zero band stays latched at equality"
).IsTrue();
Assert.ThatBool(
	actual := _Hysteresis.Evaluate(currentValue := 6),
	message := "Zero band clears above the threshold"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{f0427f13-1b98-4a72-a9a5-306920605654}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7b84806b-d132-4d91-b192-14aac3826fc9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{32dd70d2-f607-465f-a9ff-dc6d9820d860}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d6c79d9d-72dd-4a76-8d4c-705a1b860a14}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a22626b0-df15-412f-856b-bec5f158cd43}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3f161575-ca2a-4f12-8ae4-ec02699218f3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
