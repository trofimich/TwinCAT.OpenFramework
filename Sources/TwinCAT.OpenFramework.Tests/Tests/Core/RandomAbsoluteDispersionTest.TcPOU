<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RandomAbsoluteDispersionTest" Id="{70f7b36d-6374-4f42-9bd6-22c0fd1f07a5}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks absolute dispersion and independent output clamps.</summary>
<description>
Owns a generator used by one PLC task. Each run checks the same bounds against fresh samples.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RandomAbsoluteDispersionTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Random : TOF_Core.Random;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{bd814188-2ec2-4d28-93fa-70a22c7528d5}">
      <Declaration><![CDATA[//! <summary>Checks zero dispersion and bounds that must clamp independently of the generated sample.</summary>
METHOD PROTECTED ExecuteTest
VAR
	value : LREAL;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[value := _Random.GetWithDispersion(baseValue := LREAL#12.5, dispersion := LREAL#0.0);
Assert.ThatLongReal(actual := value, message := "Zero dispersion must return the base").ToBe(expected := LREAL#12.5);

value := _Random.GetWithDispersion(baseValue := LREAL#100.0, dispersion := LREAL#10.0, minValue := LREAL#120.0);
Assert.ThatLongReal(
	actual := value,
	message := "Lower bound alone must clamp any sample"
).ToBe(expected := LREAL#120.0);

value := _Random.GetWithDispersion(baseValue := LREAL#100.0, dispersion := LREAL#10.0, maxValue := LREAL#80.0);
Assert.ThatLongReal(actual := value, message := "Upper bound alone must clamp any sample").ToBe(expected := LREAL#80.0);

FOR i := 1 TO 21 DO
	value := _Random.GetWithDispersion(baseValue := LREAL#100.0, dispersion := LREAL#10.0);
	Assert.ThatLongReal(
	actual := value,
	message := "Absolute dispersion sample below 90"
).IsGreaterThanOrEquals(
		expected := LREAL#90.0
	);
	Assert.ThatLongReal(
	actual := value,
	message := "Absolute dispersion sample above 110"
).IsLessThanOrEquals(
		expected := LREAL#110.0
	);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{5e788ffb-fa0c-4d12-80a1-75242a6282ab}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1802a401-5f28-452b-8eef-a98603de327c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{fdf9a300-b1e4-42ab-9200-35ae2b508d3b}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bb691c65-f18e-4349-b32e-39d62d4f0b0e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7ce4fc59-3452-417e-a4cb-a42aef41defb}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{31dc69fe-f1ee-4efb-95c9-aa6366cbc377}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
