<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RandomTestGroup" Id="{008127da-1d29-426c-8db8-cdda9ad0decd}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups random range and dispersion contracts.</summary>
<description>
Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RandomTestGroup EXTENDS TOF_Testing.TestGroup<3>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Range : RandomRangeTest(name := "GetInRange", parent := THIS^);
	_AbsoluteDispersion : RandomAbsoluteDispersionTest(name := "GetWithDispersion", parent := THIS^);
	_PercentageDispersion : RandomPercentageDispersionTest(name := "GetWithDispersionPercent", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_Range,
		_AbsoluteDispersion,
		_PercentageDispersion
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{9b197514-8263-48e1-894a-7ced9fe65293}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{f1f49ab5-8bb8-42e9-a96b-7c7a50cb7434}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{a0400552-1ac5-4053-bd1f-3c271bfcd9c3}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dbd576a2-f221-4de1-b5b4-719baf8a9e0b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{92f1d6c1-0c72-4314-89ac-86d7534cd4a5}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3dbf596e-f616-4124-ae81-8861078b1d1a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e8fc0770-fa62-4297-9e3b-bb368e175187}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3857c72b-09ff-461b-8464-33e714035b72}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
