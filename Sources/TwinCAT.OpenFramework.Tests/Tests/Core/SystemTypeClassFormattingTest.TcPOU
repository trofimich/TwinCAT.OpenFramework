<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SystemTypeClassFormattingTest" Id="{47a0a99c-d260-46b4-99c9-dfeb6148c628}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks symbolic runtime names and unknown code formatting.</summary>
<description>
Uses run-local fixtures and references that are used only within the executing PLC task.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SystemTypeClassFormattingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a88f5498-519f-4bbf-b6c5-53dd6e083fc6}">
      <Declaration><![CDATA[(*!
<summary>Checks symbolic runtime names in both encodings and lossless formatting of unknown codes.</summary>
<description>
Covers reference, pointer, text, sentinel and Build 4026 extended categories. Injects an unknown raw DWORD
to exercise the fallback without requiring an enum conversion outside the declared values.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	typeClasses : ARRAY [0..7] OF __SYSTEM.TYPE_CLASS := [
		__SYSTEM.TYPE_CLASS.TYPE_BOOL,
		__SYSTEM.TYPE_CLASS.TYPE_REFERENCE,
		__SYSTEM.TYPE_CLASS.TYPE_POINTER,
		__SYSTEM.TYPE_CLASS.TYPE_STRING,
		__SYSTEM.TYPE_CLASS.TYPE_WSTRING,
		__SYSTEM.TYPE_CLASS.TYPE_NONE,
		__SYSTEM.TYPE_CLASS.TYPE_ANYSTRING,
		__SYSTEM.TYPE_CLASS.TYPE_LTIMEOFDAY
	];
	expectedNames : ARRAY [0..7] OF STRING(80) := [
		'TYPE_BOOL', 'TYPE_REFERENCE', 'TYPE_POINTER', 'TYPE_STRING',
		'TYPE_WSTRING', 'TYPE_NONE', 'TYPE_ANYSTRING', 'TYPE_LTIMEOFDAY'
	];
	typeClass : __SYSTEM.TYPE_CLASS;
	unknownCode : DWORD := DWORD#16#FFFFFFFF;
	narrowName : STRING(80);
	caseName : WSTRING(80);
	wideName : WSTRING(80);

	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO 7 DO
	narrowName := TOF_Core.SystemTypeClassConvertor.ToString(typeClass := typeClasses[i]);
	wideName := TOF_Core.SystemTypeClassConvertor.ToWideString(typeClass := typeClasses[i]);
	caseName := TO_WSTRING(expectedNames[i]);
	Assert.ThatBool(
		actual := narrowName = expectedNames[i],
		message := Tc2_Utilities.WCONCAT(STR1 := "Incorrect STRING name for ", STR2 := caseName)
	).IsTrue();
	Assert.ThatBool(
		actual := wideName = caseName,
		message := Tc2_Utilities.WCONCAT(STR1 := "Incorrect WSTRING name for ", STR2 := caseName)
	).IsTrue();
END_FOR

// Preserve all 32 bits of an unknown runtime code, including the unsigned high bit.
Tc2_System.MEMCPY(destAddr := ADR(typeClass), srcAddr := ADR(unknownCode), n := SIZEOF(typeClass));
narrowName := TOF_Core.SystemTypeClassConvertor.ToString(typeClass := typeClass);
wideName := TOF_Core.SystemTypeClassConvertor.ToWideString(typeClass := typeClass);
Assert.ThatBool(
	actual := narrowName = '4294967295',
	message := "STRING fallback must retain the unsigned code"
).IsTrue();
Assert.ThatBool(
	actual := wideName = "4294967295",
	message := "WSTRING fallback must retain the unsigned code"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{985194e6-9c8a-41e4-8a64-d8a5c82d0af3}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4f45588f-8a82-4bfb-9feb-912a4135d037}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{826c4858-4e7f-431b-acb0-c08fe3def7fa}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{03688061-aa74-4601-842d-3da074200f96}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{0ef01d2c-ddfe-4fa2-80db-51a72a6c3002}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{2c3829c2-30df-43c3-8ed3-6805859fbcd5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
