<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GenericNaNOrderingTest" Id="{0b4bee44-e621-417e-8cb3-4c7c981e7148}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks NaN ordering across widths and number categories.

Uses run-local fixtures and references that are used only within the executing PLC task.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK GenericNaNOrderingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a160cb7e-efc9-41ca-940b-2b5e7b1bb5bb}">
      <Declaration><![CDATA[(*
Checks that every NaN precedes non-NaN numbers and NaN encodings compare equal.

Constructs quiet and signaling NaN bit patterns without floating-point arithmetic. Includes both widths,
integers, negative infinity, reverse order and ordinary finite ordering.
*)
METHOD PROTECTED ExecuteTest
VAR
	narrowNaN : TOF_Core.REAL_UNION;
	wideNaN : TOF_Core.LREAL_UNION;
	negativeInfinity : TOF_Core.LREAL_UNION;
	integer : LINT;
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[narrowNaN.Raw := UDINT#16#7F800001;
wideNaN.Raw := ULINT#16#FFF8000000000011;
negativeInfinity.Raw := ULINT#16#FFF0000000000000;
first := TOF_Core.GenericValueFactory.FromRealReference(value := narrowNaN.Value);
second := TOF_Core.GenericValueFactory.FromLRealReference(value := wideNaN.Value);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	message := "Signaling REAL NaN and quiet LREAL NaN must compare equal"
).IsTrue();
Assert.ThatBool(
	actual := second.CompareTo(otherValue := first) = TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
	message := "NaN equality must be symmetric across widths"
).IsTrue();

second := TOF_Core.GenericValueFactory.FromLRealReference(value := negativeInfinity.Value);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "NaN must precede negative infinity"
).IsTrue();
Assert.ThatBool(
	actual := second.CompareTo(otherValue := first) = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	message := "Negative infinity must follow NaN"
).IsTrue();

second := TOF_Core.GenericValueFactory.FromLIntReference(value := integer);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "NaN must precede an integer"
).IsTrue();
Assert.ThatBool(
	actual := second.CompareTo(otherValue := first) = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	message := "An integer must follow NaN"
).IsTrue();

wideNaN.Raw := ULINT#16#7FF0000000000001;
first := TOF_Core.GenericValueFactory.FromLRealReference(value := wideNaN.Value);
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND,
	message := "Signaling LREAL NaN must be classified before conversion or comparison"
).IsTrue();

wideNaN.Value := LREAL#1.0;
Assert.ThatBool(
	actual := first.CompareTo(otherValue := second) = TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND,
	message := "Ordinary finite numeric ordering must remain unchanged"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{392d0796-9237-4054-9cab-62cbb3b86254}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dc18c34e-86b7-430a-891b-1c0f3ed9b826}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f3f05118-1f19-4ac0-914c-a0053e1d765f}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{92752a2b-94cf-4d34-b7aa-d7f4933ab819}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b97e8e83-5aae-4a97-a45f-3ce6d39d606e}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{db920f13-b9bb-4400-9386-e3780d0f7c89}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
