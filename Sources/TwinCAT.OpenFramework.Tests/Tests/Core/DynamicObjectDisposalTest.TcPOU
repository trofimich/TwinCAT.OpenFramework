<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicObjectDisposalTest" Id="{bfdaaae5-2b6b-4c2f-9223-88b99d45678d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Verifies concrete destruction through typed deletion or IObject.

Owns one dynamic probe at a time. The exit counter remains live through deletion. The test uses each
ownership path once per run and executes in one PLC task. AfterTest deletes only a probe still owned by this case.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicObjectDisposalTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_ReleaseThroughInterface : BOOL;
	_OwnedProbe : POINTER TO ObjectExitProbe;
	_ExitCount : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{ec56bfb4-4070-4fbe-a53b-25b7d89ddf32}">
      <Declaration><![CDATA[(*
Selects the disposal route for this case.
name — Display name of this case.
parent — Group that owns this case.
releaseThroughInterface — TRUE selects Memory.TryReleaseDynamicObject. FALSE selects typed __DELETE.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	releaseThroughInterface : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ReleaseThroughInterface := releaseThroughInterface;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{365fb8bf-21f8-48d0-96ff-105ef6bec622}">
      <Declaration><![CDATA[(*
Allocates a fresh probe and verifies its concrete exit count.

A failed allocation follows the fatal allocation boundary. The exit counter is cleared before each allocation.
*)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExitCount := 0;
_OwnedProbe := __NEW(ObjectExitProbe);

IF _OwnedProbe = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	RETURN;
END_IF

_OwnedProbe^.ObserveExit(counter := _ExitCount);

IF _ReleaseThroughInterface THEN
	checkInterfaceRelease();
ELSE
	deleteOwnedProbe();
	Assert.ThatUDInt(
		actual := _ExitCount,
		message := "Typed deletion must call the concrete FB_exit once"
	).ToBe(expected := 1);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkInterfaceRelease" Id="{6a0f048b-4567-4e05-9e1a-e16ae5061fdc}">
      <Declaration><![CDATA[(*
Checks interface address resolution, destruction and repeat release of the cleared interface.

After passing the interface to the release helper, does not dereference or re-delete the former allocation.
A repeated call is allowed only after confirmed success with a null interface.
*)
METHOD PRIVATE checkInterfaceRelease
VAR
	instance : TOF_Core.IObject;
	released : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[instance := _OwnedProbe^;
Assert.ThatBool(
	actual := TOF_Core.Memory.GetAddressFromInterface(interfaceInstance := instance) = _OwnedProbe,
	message := "The dynamic interface must resolve to the complete probe address"
).IsTrue();

// Give up the typed alias before an operation that can leave the object partially destroyed.
_OwnedProbe := 0;
released := TOF_Core.Memory.TryReleaseDynamicObject(instance := instance);
Assert.ThatBool(actual := released, message := "Live dynamic probe release must succeed").IsTrue();
Assert.ThatBool(actual := instance = 0, message := "Release must clear the passed interface").IsTrue();
Assert.ThatUDInt(
	actual := _ExitCount,
	message := "Interface release must call the concrete FB_exit once"
).ToBe(expected := 1);

IF NOT released OR_ELSE instance <> 0 THEN
	RETURN;
END_IF

released := TOF_Core.Memory.TryReleaseDynamicObject(instance := instance);
Assert.ThatBool(actual := released, message := "Repeated release of the cleared interface must return FALSE").IsFalse();
Assert.ThatBool(actual := instance = 0, message := "Repeated release must leave the interface clear").IsTrue();
Assert.ThatUDInt(
	actual := _ExitCount,
	message := "Repeated release must not call FB_exit again"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{3da45e33-83cb-4490-939a-e19ed1598176}">
      <Declaration><![CDATA[(* Cleans up a probe still owned by the case after an interrupted preparation. *)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _OwnedProbe <> 0 THEN
	deleteOwnedProbe();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="deleteOwnedProbe" Id="{9e50ba62-8c73-4701-8221-b51fc3fdb1be}">
      <Declaration><![CDATA[(*
Deletes the live probe through its exact type and clears the ownership field before deletion.

Call only when this case still owns the live allocation. The probe implements a non-throwing exit.
*)
METHOD PRIVATE deleteOwnedProbe
VAR
	probe : POINTER TO ObjectExitProbe;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[probe := _OwnedProbe;
_OwnedProbe := 0;
__DELETE(probe);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ede3dd37-b426-47f1-b971-3a98db05b02c}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f86fb1dc-0a97-4a61-b1d4-72354e1b8eff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f249a0c1-1a67-4781-aed7-d256f049d2ab}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b1f19bfc-b23f-4b3c-abd8-5202600974cd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{64d91b23-9109-4d22-bbd7-5887d228fe7b}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{2456d9be-2edd-41cc-a0d4-919db62e55ea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
