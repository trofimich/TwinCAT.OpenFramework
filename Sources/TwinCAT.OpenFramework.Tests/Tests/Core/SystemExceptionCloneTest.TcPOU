(*
Checks a direct clone before and after the task-local system wrapper is reconfigured.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK SystemExceptionCloneTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{304d1fcd-4720-44e8-be57-2a0a618a80f6}">
      <Declaration><![CDATA[(*
Checks a direct clone before and after the task-local system wrapper is reconfigured.

Supplies native codes to the adapter without raising a native exception. The clone is valid until task cleanup.
*)
METHOD PROTECTED ExecuteTest
VAR
	original : TOF_Core.IException;
	reconfigured : TOF_Core.IException;
	clonedObject : TOF_Core.IObject;
	cloned : TOF_Core.ISystemException;
	expected : TOF_Core.ERROR_MESSAGE;
	actual : TOF_Core.ERROR_MESSAGE;
	localTimestamp : LDATE_AND_TIME;
	utcTimestamp : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[original := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_OUT_OF_MEMORY,
	catchPointNamespaceName := 'CloneTest',
	catchPointPOUName := 'OriginalCatch',
	catchPointPosition := 'P1'
);

IF original = 0 THEN
	RecordFailure(message := "The native code must produce a shared wrapper");
	RETURN;
END_IF

expected := original.GetMessage();
localTimestamp := original.LocalTimestamp;
utcTimestamp := original.UtcTimestamp;
clonedObject := original.Clone();

IF NOT __QUERYINTERFACE(clonedObject, cloned) THEN
	RecordFailure(message := "A SystemException clone must implement ISystemException");
	RETURN;
END_IF

Assert.ThatBool(
	actual := cloned.IsDynamicInstance AND_THEN cloned.SelfAddress <> original.SelfAddress,
	message := "The clone must be a distinct task-managed instance"
).IsTrue();

reconfigured := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_NOEXCEPTION,
	catchPointNamespaceName := 'Changed',
	catchPointPOUName := 'Changed',
	catchPointPosition := 'P2'
);
Assert.ThatBool(
	actual := reconfigured = original AND_THEN original.Empty,
	message := "The same shared wrapper must be empty after reconfiguration"
).IsTrue();
Assert.ThatBool(
	actual := cloned.ExceptionCode = __SYSTEM.ExceptionCode.RTSEXCPT_OUT_OF_MEMORY,
	message := "The clone must retain the captured native code"
).IsTrue();

actual := cloned.GetMessage();
Assert.ThatBool(
	actual := actual = expected AND_THEN Tc2_Standard.WFIND(STR1 := actual, STR2 := "CloneTest.OriginalCatch at P1") > 0,
	message := "The clone must retain the original diagnostic and catch location"
).IsTrue();
Assert.ThatBool(
	actual := cloned.LocalTimestamp = localTimestamp AND_THEN cloned.UtcTimestamp = utcTimestamp,
	message := "The clone must retain both captured timestamps"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{0b49763c-80f1-4b41-823a-395c775a3391}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{76cbe67a-df97-4438-ad71-11cd1faaae86}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{593c0e84-e366-402d-85e7-3a468b017115}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8fcd8407-0aa4-4c60-865a-fdcb8541b637}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f6af564f-71dc-455d-a084-cb2d1620d640}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{debdc56d-8165-420a-a824-7ae88a086c69}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
