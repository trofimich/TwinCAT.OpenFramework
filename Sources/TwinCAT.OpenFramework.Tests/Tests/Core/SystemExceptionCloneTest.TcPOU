<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SystemExceptionCloneTest" Id="{b08a4e83-4da1-4f60-bec4-ee57cfeda7ca}" SpecialFunc="None">
    <Declaration><![CDATA[(*
