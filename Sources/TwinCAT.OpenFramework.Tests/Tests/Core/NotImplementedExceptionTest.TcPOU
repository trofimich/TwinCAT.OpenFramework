<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="NotImplementedExceptionTest" Id="{1f425439-344f-4835-a196-a7033dd58a12}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks concrete exception transport and diagnostics for an unimplemented POU.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK NotImplementedExceptionTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{570ae85f-b37b-4e84-834b-8aa0f62ea1c1}">
      <Declaration><![CDATA[(*
Checks concrete exception transport and diagnostics for an unimplemented POU.

Injects a fixed source location so the expected text and metadata are independent of this test's name.
*)
METHOD PROTECTED ExecuteTest
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	typed : TOF_Core.INotImplementedException;
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Raise one exception to exercise the transport from the facade to the catch.
__TRY
	TOF_Core.Exceptions.ThrowNotImplemented(
		sourceNamespaceName := 'Tests',
		sourceClassName := 'ExceptionFixture',
		sourcePOUName := 'UnimplementedOperation',
		sourcePosition := 'P1'
	);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

IF NOT __QUERYINTERFACE(caught, typed) THEN
	RecordFailure(message := "ThrowNotImplemented must propagate NotImplementedException");
	RETURN;
END_IF

message := typed.GetMessage();
Assert.ThatBool(
	actual := message = "Program organization unit 'Tests.ExceptionFixture.UnimplementedOperation()' is not implemented",
	message := "NotImplementedException must name the supplied POU"
).IsTrue();
Assert.ThatBool(
	actual := typed.SourcePosition = 'P1',
	message := "NotImplementedException must preserve the throw position"
).IsTrue();
Assert.ThatBool(
	actual := typed.IsDynamicInstance,
	message := "Facade transport must yield a task-managed exception"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{1cca93d4-60b3-4d62-a02f-78319a8fd7ec}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{86d82185-841d-46a9-85e2-3a4f29f7afbd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{d165e129-fddc-4426-8f2d-bf9ef55af412}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{10ba0527-7dd5-4d02-aad6-88ba706fdb0e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6686685a-180e-4fb0-9af9-60be3c68dba3}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c77d7e16-76b9-4e4b-97b7-91b73bcf4a25}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
