(*
Identifies the cyclic step of the auto-disposed object registry growth and reuse regression test.
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE DYNAMIC_MEMORY_REGISTRY_GROWTH_PHASE :
(
	REGISTER_GROWING_BATCH,
	VERIFY_GROWING_BATCH_AND_REUSE,
	VERIFY_REUSED_BATCH
);
END_TYPE]]></Declaration>
  </DUT>
