<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RandomRangeTest" Id="{5add9fe6-8949-468d-810d-3c825c4cb768}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks random scaling and a single-point interval.</summary>
<description>
Owns a generator used by one PLC task. Each run checks the same bounds against fresh samples.
The runner binds assertions to the instance address. Keep the instance at that address for its run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RandomRangeTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Random : TOF_Core.Random;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{725e6b80-50b1-41aa-9d4f-11fdc2e3ad75}">
      <Declaration><![CDATA[//! <summary>Checks a single-point range and samples an inclusive interval.</summary>
METHOD PROTECTED ExecuteTest
VAR
	value : LREAL;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[value := _Random.GetInRange(minValue := LREAL#-7.5, maxValue := LREAL#-7.5);
Assert.ThatLongReal(
	actual := value,
	message := "A single-point range must return its bound"
).ToBe(expected := LREAL#-7.5);

FOR i := 1 TO 21 DO
	value := _Random.GetInRange(minValue := LREAL#100.0, maxValue := LREAL#200.0);
	Assert.ThatLongReal(
		actual := value,
		message := "GetInRange sample below 100"
	).IsGreaterThanOrEquals(expected := LREAL#100.0);
	Assert.ThatLongReal(
		actual := value,
		message := "GetInRange sample above 200"
	).IsLessThanOrEquals(expected := LREAL#200.0);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{9255680a-e814-437d-b18b-d3511be2031c}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b33b3207-5386-4868-beb5-998b28eaa25d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1f80554d-ac78-4dd6-bccf-241e8d56379b}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f9593dfa-3baf-4782-928c-b687fa58c71a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{8dfbe9e1-337c-4bdc-89ba-d245d894582d}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{bdb5698d-fb64-4d21-bc66-4eff730b312d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
