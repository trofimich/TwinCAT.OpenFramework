<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ArgumentTypeExceptionCloneTest" Id="{52c2c0cd-eeaf-4537-a855-4513631432bb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks concrete identity and copied fields of a populated argument-type exception clone.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ArgumentTypeExceptionCloneTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{bc104f89-f99e-4d71-8ee9-b11bb7f228b2}">
      <Declaration><![CDATA[(*
Checks concrete identity and copied fields of a populated argument-type exception clone.

Copies the configured source within the current task cycle. Clears the source before reading the registered clone.
*)
METHOD PROTECTED ExecuteTest
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	source : TOF_Core.ArgumentTypeNotSupportedException;
	thrown : TOF_Core.IArgumentTypeNotSupportedException;
	clonedObject : TOF_Core.IObject;
	cloned : TOF_Core.IArgumentTypeNotSupportedException;
	localTimestamp : LDATE_AND_TIME;
	utcTimestamp : LDATE_AND_TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Configure the source through its normal Throw API and catch the resulting framework payload.
__TRY
	source.Throw(
		sourceNamespaceName := 'Tests',
		sourceClassName := 'ArgumentFixture',
		sourcePOUName := 'Reject',
		sourcePosition := 'P1',
		argumentName := 'value',
		argumentTypeName := 'UNSUPPORTED_TYPE'
	);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

IF NOT __QUERYINTERFACE(caught, thrown) THEN
	RecordFailure(message := "ArgumentTypeNotSupportedException must preserve its type on Throw");
	RETURN;
END_IF

localTimestamp := source.LocalTimestamp;
utcTimestamp := source.UtcTimestamp;
clonedObject := source.Clone();
source.Clear();

IF NOT __QUERYINTERFACE(clonedObject, cloned) THEN
	RecordFailure(message := "Clone must implement IArgumentTypeNotSupportedException");
	RETURN;
END_IF

Assert.ThatBool(
	actual := cloned.IsDynamicInstance AND_THEN cloned.SelfAddress <> source.SelfAddress,
	message := "The clone must be distinct from the caller-owned template"
).IsTrue();
Assert.ThatBool(
	actual := cloned.SourceMessage
		= "Argument 'value' has not supported type 'UNSUPPORTED_TYPE' in 'Tests.ArgumentFixture.Reject()'",
	message := "The clone must preserve the argument name, unsupported type and POU"
).IsTrue();
Assert.ThatBool(
	actual := cloned.SourceFullPOUName = 'Tests.ArgumentFixture.Reject()' AND_THEN cloned.SourcePosition = 'P1',
	message := "The clone must preserve its original source metadata"
).IsTrue();
Assert.ThatBool(
	actual := cloned.LocalTimestamp = localTimestamp AND_THEN cloned.UtcTimestamp = utcTimestamp,
	message := "The clone must preserve both occurrence timestamps"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a83da300-55bf-4e04-a09b-4c4a79611819}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{872a8ba6-9d57-4b33-8bb4-330fc8bbd446}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2cb0eb87-3fc4-4cfd-a5a3-70109099f05f}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8aeddb1d-897f-454e-93ca-92588bf2b4e7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{06c23293-028a-44cf-87d2-58ba7e64fc47}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{67dab1d2-069d-410e-8514-c567d2bace46}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
