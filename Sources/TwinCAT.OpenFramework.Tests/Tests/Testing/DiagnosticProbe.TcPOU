<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DiagnosticProbe" Id="{65accacb-a8a3-4896-af58-7b7e86fb66f6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exercises native errors, failing exception formatting and long copied diagnostics.</summary>
<description>
The existing ThrowingGetMessageException fixture preserves its concrete type when cloned. This scenario
keeps both exception templates in persistent storage and borrows no exception beyond its task cycle.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DiagnosticProbe EXTENDS TOF_Testing.SingleCycleTest
VAR_INPUT
	ThrowNative : BOOL;
	ThrowOnGetMessage : BOOL;
END_VAR
VAR_OUTPUT
	BodyCalls : UDINT;
	TeardownCalls : UDINT;
END_VAR
VAR
	_Exception : TOF_Core.StandardException;
	_FormattingFailure : ThrowingGetMessageException;
	_LongMessage : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="BeforeTest" Id="{1978f708-f48c-4005-b861-56ccba8a5e17}">
      <Declaration><![CDATA[(*!
<summary>Clears per-run observations.</summary>
*)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[BodyCalls := 0;
TeardownCalls := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{39a4ae43-3c84-4b42-82ea-2fb249fb403e}">
      <Declaration><![CDATA[(*!
<summary>Raises one selected error after recording one body invocation.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[BodyCalls := BodyCalls + 1;

IF ThrowNative THEN
	Tc2_System.F_RaiseException(ExceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ARRAYBOUNDS);
ELSIF ThrowOnGetMessage THEN
	_FormattingFailure.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Original exception with a failing formatter"
	);
ELSE
	_LongMessage := "Long diagnostic: ";

	FOR i := 1 TO 400 DO
		TOF_Core.WideStrings.AppendFit(targetString := _LongMessage, sourceString := "x");
	END_FOR

	TOF_Core.WideStrings.AppendFit(targetString := _LongMessage, sourceString := " END_OF_LONG_DIAGNOSTIC");
	_Exception.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := _LongMessage
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{7a909403-f049-45b6-8eb3-b54903de73f0}">
      <Declaration><![CDATA[(*!
<summary>Records one cleanup after the captured error.</summary>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[TeardownCalls := TeardownCalls + 1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{07741af3-7755-4e6d-bcd9-4d71b602b9c0}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7da9a258-0165-4734-bb40-7c3cb2ab9b76}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{237170e2-fabc-4354-9e26-ffe5cee83855}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2b3c6715-c600-4530-af83-4d5d4a0a154f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1204ae2a-d6fe-410d-a500-39fae12b5092}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{eb9de179-8f4f-4e38-b1c8-a73d6cad65ed}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
