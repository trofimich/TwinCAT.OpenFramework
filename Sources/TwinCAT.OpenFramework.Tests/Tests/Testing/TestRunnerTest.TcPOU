<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="TestRunnerTest" Id="{959461be-86e6-492c-8744-09aecb04c199}" SpecialFunc="None">
    <Declaration><![CDATA[(*
