(*!
<summary>Selects an independent assertion contract scenario for the regression fixture.</summary>
<description>Each value selects a complete single-cycle body, not a numeric execution phase.</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
TYPE ASSERTION_PROBE_SCENARIO :
(
	FLOAT_TOLERANCE,
	INTEGER_EXACT,
	TYPED_LITERALS,
	MESSAGE_CHAIN,
	NEGATIVE_TOLERANCE,
	NAN_TOLERANCE,
	INFINITE_TOLERANCE,
	MESSAGE_RESET,
	POINTERS_AND_STRINGS,
	FIRST_FAILURE,
	SPECIAL_FLOATS,
	OPPOSITE_LIMITS,
	GENERIC_MESSAGE_CHAIN,
	GENERIC_MESSAGE_RESET,
	CONTEXT_TRANSITIONS,
	TYPED_MESSAGE_AFTER_GENERIC,
	GENERIC_MESSAGE_AFTER_TYPED,
	TYPED_MESSAGE_RESET_AFTER_GENERIC,
	INTEGER_FAILURE,
	BITSTRING_FAILURE,
	POINTER_FAILURE,
	STRING_LONG_FAILURE,
	WIDE_STRING_LONG_FAILURE,
	STRING_CONTAINMENT_FAILURE,
	FLOAT_ORDERING_FAILURE,
	FLOAT_EQUALITY_FAILURE,
	TIME_ORDERING_FAILURE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
