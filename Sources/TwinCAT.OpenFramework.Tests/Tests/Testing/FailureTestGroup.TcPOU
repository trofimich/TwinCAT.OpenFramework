<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FailureTestGroup" Id="{8d081d88-f771-44d8-9557-1d7577a424b7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Owns the five independent failure scenarios used by the runner suite.</summary>
<description>
Owns persistent child storage and fixed parent associations. Use in one task without reentry.
Children is borrowed and must not be modified by application code. Constructor callbacks are not used.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FailureTestGroup EXTENDS TOF_Testing.TestGroup<5>
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR_OUTPUT
	//! <summary>Leaf configured to raise from preparation.</summary>
	SetupFailure : TestingProbe(name := "Setup failure", parent := THIS^);
	//! <summary>Leaf configured to raise from its body.</summary>
	BodyFailure : TestingProbe(name := "Body failure", parent := THIS^);
	//! <summary>Leaf configured to raise from teardown.</summary>
	TeardownFailure : TestingProbe(name := "Teardown failure", parent := THIS^);
	//! <summary>Leaf configured to record an incompatible-comparison failure.</summary>
	ComparisonFailure : TestingProbe(name := "Comparison failure", parent := THIS^);
	//! <summary>Leaf configured to retain a Unicode diagnostic.</summary>
	DiagnosticFailure : TestingProbe(name := "Diagnostic failure", parent := THIS^);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		SetupFailure,
		BodyFailure,
		TeardownFailure,
		ComparisonFailure,
		DiagnosticFailure
	];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{af355604-101a-4866-8da4-73af6e64c9d7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fd2079f5-c78b-4457-a7a1-dbe324963c78}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0e268a4a-86e1-4bc6-bf6b-7da7a8019e28}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{074c0f71-538c-4681-b359-a5d88fbc14f9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6ef02f57-83b6-4f55-b03d-feb539bdfab0}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3ae357e9-2901-4911-9e01-faf2aabdf035}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{066877e3-69b1-4e07-90f7-11bf133d19cd}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed array of this concrete group; do not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{40e687bd-b732-4afe-801a-56916a59a6a4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
