<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ThrowingTestReporter" Id="{78ec7b86-d90d-484d-a8fd-fdfea37fe2af}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Raises after observing a leaf callback to verify abort without callback retries.</summary>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ThrowingTestReporter EXTENDS TOF_Testing.JUnitXmlReporter
VAR_STAT
	_ThrowingClassName : STRING := __POUNAME();
END_VAR
VAR_OUTPUT
	ResultCalls : UDINT;
END_VAR
VAR
	_Exception : TOF_Core.StandardException;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ReportTestCaseResult" Id="{ebd445f5-6a70-4b22-9335-4711eacf11e5}">
      <Declaration><![CDATA[(*!
<summary>Counts a side effect and raises from the external reporter callback.</summary>
<param name="testName">Individual name bounded to 80 wide characters, matching the reporter interface.</param>
*)
METHOD ReportTestCaseResult
VAR_INPUT
	groupPath : WSTRING(255);
	testName : WSTRING;
	outcome : TOF_Testing.TEST_OUTCOME;
	duration : TIME;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResultCalls := ResultCalls + 1;
_Exception.Throw(
	sourceNamespaceName := NamespaceName,
	sourceClassName := ClassName,
	sourcePOUName := __POUNAME(),
	sourcePosition := __POSITION(),
	message := "Reporter failed"
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{af2d6159-bbde-404c-96cd-d62715e21aed}">
      <Declaration><![CDATA[//! <summary>Provides concrete reporter fixture metadata.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{241692f1-6da1-4b8f-a7ec-4e49c10e5a3f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ThrowingClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{34bff830-cc05-4784-93a4-a7caa48d94ce}">
      <Declaration><![CDATA[//! <summary>Reports this concrete fixture size.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3538f315-6e6f-4c83-b0cf-3a5c726ab624}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
