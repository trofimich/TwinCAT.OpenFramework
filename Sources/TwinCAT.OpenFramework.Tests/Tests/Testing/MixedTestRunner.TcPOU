<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MixedTestRunner" Id="{b2ece75b-b9dc-4ba1-ab82-4332a2347ba9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs mixed outcomes, nested groups, an empty group and a multi-cycle test.</summary>
<description>
Owns persistent root instances and fixed child storage. Use from one task without reentry.
Children borrows the same array for the instance lifetime. Root parents remain zero.
Instances must not be copied because their fixtures contain non-copyable state.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK MixedTestRunner EXTENDS TOF_Testing.TestRunner<4>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR_OUTPUT
	//! <summary>Owned root element used by this runner.</summary>
	FailureOuter : NestedFailureTestGroup(name := "Nested", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Empty : EmptyTestGroup(name := "Empty", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Pass : TestingProbe(name := "", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Multi : AssertionIsolationProbe(name := "Three cycles", parent := 0);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		FailureOuter,
		Pass,
		Multi,
		Empty
	];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{328f1418-7c0d-4c44-b727-5df5a7f9159a}">
      <Declaration><![CDATA[(*!
<summary>Borrows the unchanged persistent root array; application code must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{6f7c176c-ec47-4b2c-a5ef-78ea997b1e55}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{c5f76173-f295-4c8f-9a97-995e325ddb23}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{35d77be8-74e8-44c2-a16a-6e77cc61b907}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{766f94e2-e92c-4306-93d2-7c5a2d86e51f}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test project namespace; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7f9ea4e3-f775-4086-a814-466e03d786d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f832dd45-ca9f-4950-9fc3-9f4cfca74904}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e1a356dd-5c73-4389-9018-7a813184f6b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>