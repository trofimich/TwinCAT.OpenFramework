<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertionIsolationProbe" Id="{3b44f5d0-525a-4329-8d83-826a3b8a41f6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exercises bounded multi-cycle completion and case-owned failure routing.</summary>
<description>
A nonzero Peer is failed during this body. Zero CompleteAfterCycle leaves completion to the deadline.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AssertionIsolationProbe EXTENDS TOF_Testing.MultiCycleTest
VAR_INPUT
	Peer : POINTER TO AssertionIsolationProbe;
	UseDirectFailure : BOOL;
	CompleteAfterCycle : UDINT := 3;
END_VAR
VAR_OUTPUT
	BodyCalls : UDINT;
	TeardownCalls : UDINT;
END_VAR
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="BeforeTest" Id="{4157ac7f-f099-49f0-afa6-036dd9820fa7}">
      <Declaration><![CDATA[(*!
<summary>Resets per-run fixture observations.</summary>
*)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[BodyCalls := 0;
TeardownCalls := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{ffa6eaa1-4c6d-4ab5-9e41-ae1a55d86fe3}">
      <Declaration><![CDATA[(*!
<summary>Waits across scans or fails a peer and completes this case.</summary>
*)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[BodyCalls := BodyCalls + 1;

IF Peer <> 0 THEN
	Peer^.FailActiveCase(useDirectFailure := UseDirectFailure);
	Complete();
ELSIF CompleteAfterCycle > TOF_Core.UnsignedInt32.ZERO AND_THEN CycleCount >= CompleteAfterCycle THEN
	Assert.ThatUDInt(actual := BodyCalls).ToBe(expected := CompleteAfterCycle);
	Complete();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{28bb19bb-0778-4688-8437-9611054e5f49}">
      <Declaration><![CDATA[(*!
<summary>Counts one cleanup for success, peer failure or timeout.</summary>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[TeardownCalls := TeardownCalls + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FailActiveCase" Id="{a934b69f-fc76-4c33-8c45-a590b9139ed5}">
      <Declaration><![CDATA[(*!
<summary>Reports through the receiving case while a different case is executing.</summary>
*)
METHOD INTERNAL FailActiveCase
VAR_INPUT
	useDirectFailure : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF useDirectFailure THEN
	RecordFailure(message := "Failure belongs to this case");
ELSE
	Assert.ThatBool(actual := FALSE).IsTrue();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{3be78a19-ae86-438c-bf68-ef66060a20f0}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7fbdad64-e3ea-4e38-a958-a91ebe2bae00}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5c3c7efe-619d-4b7c-818d-d108be261ac5}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a72f69d0-618b-4fe8-90d7-02fa439d38a8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{557c3262-6b80-4782-b417-0607c92015f5}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6b5d8f4e-9835-4be2-9b93-9cbce05eb119}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
