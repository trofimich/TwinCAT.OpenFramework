<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MissingChildrenTestGroup" Id="{fb95ab59-a9a2-40ad-938a-0fa0457f6ced}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Intentionally omits child-array storage to exercise group validation.</summary>
<description>
Negative fixture: Children intentionally returns an invalid reference without callbacks or exceptions.
Owns no child array or test instances. Use only in the hosting regression task.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK MissingChildrenTestGroup EXTENDS TOF_Testing.TestGroup<1>
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{0bd6dd02-ac76-4254-bddc-873df5a9616f}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0f2977db-611b-4ba7-94a0-cbacb8ce5f8d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{bbd4bc15-2ecd-46f6-b772-55f72789d5dd}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cba722d9-8178-4328-9471-56ff9c24efb4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b034e448-4e2b-4038-aa06-792637ab354a}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{31ca6629-40b5-4821-8a8e-5eb7115fad19}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{28be966f-affe-4b7e-a07d-f7bb827477c8}">
      <Declaration><![CDATA[//! <summary>Returns an invalid reference intentionally to exercise missing-storage diagnostics.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{ff635876-ca89-465b-a3bd-4e69660ed6ca}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RETURN;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
