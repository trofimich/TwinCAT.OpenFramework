<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestingProbe" Id="{f10a5716-3f19-429b-b1e9-9771591eaafb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides one configurable single-cycle scenario for runner regression tests.</summary>
<description>
Persistent fixture state owns its exception template. BeforeTest resets per-run observations.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TestingProbe EXTENDS TOF_Testing.SingleCycleTest
VAR_INPUT
	ThrowBeforeTest : BOOL;
	ThrowBody : BOOL;
	ThrowAfterTest : BOOL;
	InvalidComparison : BOOL;
	DiagnosticFailure : BOOL;
END_VAR
VAR_OUTPUT
	SetupCalls : UDINT;
	BodyCalls : UDINT;
	TeardownCalls : UDINT;
END_VAR
VAR
	_Exception : TOF_Core.StandardException;
END_VAR
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="BeforeTest" Id="{7beb6ce7-2c0a-421e-8ff0-ff352205d806}">
      <Declaration><![CDATA[(*!
<summary>Resets observations and optionally raises during scenario preparation.</summary>
*)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetupCalls := 1;
BodyCalls := 0;
TeardownCalls := 0;

IF ThrowBeforeTest THEN
	_Exception.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Setup failed"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{cdbcfd75-5d30-4f5a-87b1-2e77bbd7c311}">
      <Declaration><![CDATA[(*!
<summary>Runs one successful body or one selected failure route.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	textValue : STRING(255);
	integerValue : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[BodyCalls := BodyCalls + 1;

IF ThrowBody THEN
	_Exception.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Body failed"
	);
END_IF

IF InvalidComparison THEN
	textValue := 'text';
	integerValue := 1;
	Assert.That(actual := textValue).IsLessThan(expected := integerValue);
ELSIF DiagnosticFailure THEN
	RecordFailure(message := "$042E&<");
ELSE
	Assert.ThatDInt(actual := 2 + 3).ToBe(expected := 5);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{4b98d878-7a87-4f22-a3dd-ada72e7ffa29}">
      <Declaration><![CDATA[(*!
<summary>Counts cleanup exactly once and optionally raises after its side effect.</summary>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[TeardownCalls := TeardownCalls + 1;

IF ThrowAfterTest THEN
	_Exception.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Teardown failed"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{24182784-a0e2-469c-a402-82b6297584fa}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{96071be5-47d8-4671-8644-61e3ae4a67fb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f5d50608-268e-418b-986f-8b725d055fc7}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{19af9158-6e99-4192-bced-50fce8e1f0be}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{047aa274-94ae-4295-9d7f-d58fcf6ada34}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8923ce87-3e53-44f9-a40d-e26537826a09}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
