<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertionTestRunner" Id="{44da7aac-6578-4048-965c-917795ea1dbb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs the twenty-seven independent assertion contract scenarios.</summary>
<description>
Owns persistent root instances and fixed child storage. Use from one task without reentry.
Children borrows the same array for the instance lifetime. Root parents remain zero.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AssertionTestRunner EXTENDS TOF_Testing.TestRunner<27>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR_OUTPUT
	//! <summary>Owned root element used by this runner.</summary>
	Assertion0 : AssertionContractProbe(name := "FLOAT_TOLERANCE", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion1 : AssertionContractProbe(name := "INTEGER_EXACT", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion2 : AssertionContractProbe(name := "TYPED_LITERALS", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion3 : AssertionContractProbe(name := "MESSAGE_CHAIN", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion4 : AssertionContractProbe(name := "NEGATIVE_TOLERANCE", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion5 : AssertionContractProbe(name := "NAN_TOLERANCE", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion6 : AssertionContractProbe(name := "INFINITE_TOLERANCE", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion7 : AssertionContractProbe(name := "MESSAGE_RESET", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion8 : AssertionContractProbe(name := "POINTERS_AND_STRINGS", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion9 : AssertionContractProbe(name := "FIRST_FAILURE", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion10 : AssertionContractProbe(name := "SPECIAL_FLOATS", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion11 : AssertionContractProbe(name := "OPPOSITE_LIMITS", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion12 : AssertionContractProbe(name := "GENERIC_MESSAGE_CHAIN", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	Assertion13 : AssertionContractProbe(name := "GENERIC_MESSAGE_RESET", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion14 : AssertionContractProbe(name := "CONTEXT_TRANSITIONS", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion15 : AssertionContractProbe(name := "TYPED_MESSAGE_AFTER_GENERIC", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion16 : AssertionContractProbe(name := "GENERIC_MESSAGE_AFTER_TYPED", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion17 : AssertionContractProbe(name := "TYPED_MESSAGE_RESET_AFTER_GENERIC", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion18 : AssertionContractProbe(name := "INTEGER_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion19 : AssertionContractProbe(name := "BITSTRING_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion20 : AssertionContractProbe(name := "POINTER_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion21 : AssertionContractProbe(name := "STRING_LONG_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion22 : AssertionContractProbe(name := "WIDE_STRING_LONG_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion23 : AssertionContractProbe(name := "STRING_CONTAINMENT_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion24 : AssertionContractProbe(name := "FLOAT_ORDERING_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion25 : AssertionContractProbe(name := "FLOAT_EQUALITY_FAILURE", parent := 0);
	//! <summary>Owned independent-context regression scenario.</summary>
	Assertion26 : AssertionContractProbe(name := "TIME_ORDERING_FAILURE", parent := 0);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		Assertion0,
		Assertion1,
		Assertion2,
		Assertion3,
		Assertion4,
		Assertion5,
		Assertion6,
		Assertion7,
		Assertion8,
		Assertion9,
		Assertion10,
		Assertion11,
		Assertion12,
		Assertion13,
		Assertion14,
		Assertion15,
		Assertion16,
		Assertion17,
		Assertion18,
		Assertion19,
		Assertion20,
		Assertion21,
		Assertion22,
		Assertion23,
		Assertion24,
		Assertion25,
		Assertion26
	];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{c041ded7-247e-45b2-9dc0-df9b39036654}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8f2f40a9-c2d6-4f37-8dd6-e1b570db562a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5b88e099-1df2-42f2-9cf6-a0385f2d2a6a}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete namespace name for the instance lifetime; callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b2c399dc-d156-436c-afaa-f9453bd851a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{029c5358-b7aa-4274-95c2-e9f50df87818}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e34f642e-03a3-42c0-a2c8-269554399847}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{bf394eea-8d33-4f6b-836a-1d63a0124fde}">
      <Declaration><![CDATA[(*!
<summary>Borrows the unchanged persistent root array; application code must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{41b0d0a6-80ef-4f7a-a070-9c923fd811ca}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
