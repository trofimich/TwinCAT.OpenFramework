<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CapturingAdsLogReporter" Id="{9df5b790-3496-4085-ba4d-72e4cf6f22f1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs ADS reporter formatting and accounting with a controllable in-memory destination.</summary>
<description>The owning test task selects acceptance before each submission. This fixture performs no ADS I/O.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK CapturingAdsLogReporter EXTENDS TOF_Testing.AdsLogReporter
VAR_STAT
	_CapturingClassName : STRING := __POUNAME();
END_VAR
VAR_INPUT
	//! <summary>Returns FALSE from the destination while this switch is set.</summary>
	RejectWrites : BOOL;
END_VAR
VAR_OUTPUT
	//! <summary>Copies the last accepted message for assertions.</summary>
	AcceptedMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="TryWriteMessage" Id="{c1021959-94fc-4575-9340-30d01f923aea}">
      <Declaration><![CDATA[(*!
<summary>Copies an accepted submission or reports a configured refusal without throwing.</summary>
*)
METHOD PROTECTED TryWriteMessage : BOOL
VAR_INPUT
	category : TOF_Core.LOG_CATEGORY;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF RejectWrites THEN
	RETURN;
END_IF

AcceptedMessage := message;
TryWriteMessage := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6dc09817-a7e9-49f7-afb5-225c6f1984d2}">
      <Declaration><![CDATA[//! <summary>Provides concrete reporter fixture metadata.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d8eade07-8462-4a1f-ac66-00c5d7f11d66}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _CapturingClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{74f56a5c-ac85-4c8f-98ea-54b3424063e6}">
      <Declaration><![CDATA[//! <summary>Reports this concrete fixture size.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{90ad7e53-0b99-4b03-99cc-89fc7a0e1e99}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
