<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RootTopologyTestRunner" Id="{5e7bd09b-6cdd-4d2b-9408-7510d669cddb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exercises root topology validation and cyclic execution without repeated scans.</summary>
<description>
Owns persistent root instances and fixed child storage. Use from one task without reentry.
Regression code may deliberately corrupt Children to probe validation; application code must not mutate it.
Children borrows the same array for the instance lifetime. Root parents remain zero.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK RootTopologyTestRunner EXTENDS TOF_Testing.TestRunner<2>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR_OUTPUT
	//! <summary>Unregistered owned fixture temporarily placed in a root slot to test active-root rejection.</summary>
	RunningRoot : AssertionIsolationProbe(name := "Running root", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	RootTopologyFirst : TestingProbe(name := "Root topology first", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	RootTopologyGroup : SingleChildTestGroup(name := "Root topology group", parent := 0);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		RootTopologyFirst,
		RootTopologyGroup
	];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{4b4bbcc4-afae-40c7-9e15-ba4db05e5e49}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3412f2f3-4d61-4ca4-96ce-01a45c7ce9b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{78311059-2a4e-4778-9b1b-abed2145b23b}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete namespace name for the instance lifetime; callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ca3f1fa3-6bd6-44ad-88f2-3c3ef34c9abb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{0c87b537-d6a6-44a6-8efd-03bff654d11c}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b401035e-aa76-43c7-9b6e-332e92d3ea1c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{e972a1fb-ff30-432a-a75f-c3a034d00e96}">
      <Declaration><![CDATA[(*!
<summary>Borrows the unchanged persistent root array; application code must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{ad69803c-75b0-4662-89de-89427a183669}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
