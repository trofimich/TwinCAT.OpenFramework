<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DiagnosticTestRunner" Id="{b9e63d24-86ed-4314-b785-f0da2d769d37}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs native, formatter and long-message diagnostic probes.</summary>
<description>
Owns persistent root instances and fixed child storage. Use from one task without reentry.
Children borrows the same array for the instance lifetime. Root parents remain zero.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DiagnosticTestRunner EXTENDS TOF_Testing.TestRunner<3>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR_OUTPUT
	//! <summary>Owned root element used by this runner.</summary>
	NativeDiagnostic : DiagnosticProbe(name := "Native diagnostic", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	FormatterDiagnostic : DiagnosticProbe(name := "Formatter diagnostic", parent := 0);
	//! <summary>Owned root element used by this runner.</summary>
	LongDiagnostic : DiagnosticProbe(name := "Long diagnostic", parent := 0);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		NativeDiagnostic,
		FormatterDiagnostic,
		LongDiagnostic
	];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{79fa9bb4-44f8-4612-91a8-ae14eaa0481a}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1fd8d408-2d0d-44b7-9550-73d3972f4781}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b77bb370-c5d6-45bf-9030-8ea9974b73b8}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete namespace name for the instance lifetime; callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ed6093cc-99d5-4eae-b502-e476c7da87cc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{8efe1ac9-bcad-4836-b4de-8ac1b94b707c}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b4130516-21f3-406f-aeba-9b1fa36d1c6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{370a0fe5-a6f9-4035-aa74-c124806b3307}">
      <Declaration><![CDATA[(*!
<summary>Borrows the unchanged persistent root array; application code must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{0a00df92-3db7-4221-a15e-6ad79b44f1c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
