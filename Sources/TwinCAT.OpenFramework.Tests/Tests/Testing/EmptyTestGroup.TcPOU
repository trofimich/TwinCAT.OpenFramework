<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="EmptyTestGroup" Id="{270c6f06-7d2c-40a5-aeba-a00495716112}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides a concrete group with an empty child array.</summary>
<description>
Owns persistent child storage and fixed parent associations. Use in one task without reentry.
Children is borrowed and must not be modified by application code. Constructor callbacks are not used.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK EmptyTestGroup EXTENDS TOF_Testing.TestGroup<0>
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{07036f30-ee8b-4264-9215-a134f43a72a1}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{68f758aa-868c-4db7-a2cc-e461fbafea93}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{04e10d4d-9055-496f-8a1d-31aa90e907e5}">
      <Declaration><![CDATA[//! <summary>Borrows the test project namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{be2fa559-e8ea-4c5a-a4be-eba16801c7a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{0000acdd-cd8f-4726-b2b0-141c9b534986}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7dc841b3-cee7-4ca4-9468-828ec289b580}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{c80f0579-ed09-494b-8e7a-f750903ba232}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed array of this concrete group; do not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{059f5f36-c055-4707-a8de-4c64cba85737}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
