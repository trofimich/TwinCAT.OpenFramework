<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MissingChildrenTestRunner" Id="{13e8b7f9-132c-425f-a2e0-337f647b9f74}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides missing root storage for startup and recovery rejection regressions.</summary>
<description>
Deliberately returns an invalid reference to exercise startup and abort-recovery validation.
It owns no roots and provides no backing array. Use only from the hosting regression task.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK MissingChildrenTestRunner EXTENDS TOF_Testing.TestRunner<1>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{9203ffa9-f6fc-45b9-995d-8df6d63c9615}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{104b347e-2caa-4fd1-9940-088881012985}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c95cd1bd-8091-4e80-b5ab-3e1ceaad9ecc}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete namespace name for the instance lifetime; callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0f0b5251-d3f0-44fe-bb79-2e37b3fe820e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5cfdb4b2-e852-4381-8a94-e899822f7b30}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0df17e63-220b-41e9-8ac5-b4d64edfc01a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Children" Id="{e9b898ce-b5a4-4cda-9270-c05694b22995}">
      <Declaration><![CDATA[(*!
<summary>Returns an invalid reference for fault injection.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{7e2350fc-4a2f-4f95-acbb-bba3a48ef936}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
