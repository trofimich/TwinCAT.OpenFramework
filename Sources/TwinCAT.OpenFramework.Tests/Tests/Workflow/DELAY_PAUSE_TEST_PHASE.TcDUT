(*!
<summary>Tracks the cyclic delay pause and reset regression without numerical state flags.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE DELAY_PAUSE_TEST_PHASE :
(
	//! <summary>Prepare and start the first active segment.</summary>
	BEFORE_START,
	//! <summary>Accumulate active time before the first pause.</summary>
	FIRST_RUNNING,
	//! <summary>Wait longer than the configured interval while suspended.</summary>
	FIRST_PAUSE,
	//! <summary>Accumulate a second active segment after resuming.</summary>
	SECOND_RUNNING,
	//! <summary>Wait through a second long suspension.</summary>
	SECOND_PAUSE,
	//! <summary>Observe completion against total active time after two pauses.</summary>
	REMAINING_RUNNING,
	//! <summary>Verify a reset starts the full configured interval again.</summary>
	FRESH_RUNNING,
	//! <summary>The scenario has reported its result and must not execute again.</summary>
	FINISHED
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
