(* Tracks the cyclic delay pause and reset regression without numerical state flags. *)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE DELAY_PAUSE_TEST_PHASE :
(
	// Prepare and start the first active segment.
	BEFORE_START,
	// Accumulate active time before the first pause.
	FIRST_RUNNING,
	// Wait longer than the configured interval while suspended.
	FIRST_PAUSE,
	// Accumulate a second active segment after resuming.
	SECOND_RUNNING,
	// Wait through a second long suspension.
	SECOND_PAUSE,
	// Observe completion against total active time after two pauses.
	REMAINING_RUNNING,
	// Verify a reset starts the full configured interval again.
	FRESH_RUNNING,
	// The scenario has reported its result and must not execute again.
	FINISHED
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
