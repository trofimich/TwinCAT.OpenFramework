<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="DELAY_PAUSE_TEST_PHASE" Id="{26aacc8e-e853-4d8a-8634-7c89f366ced9}">
    <Declaration><![CDATA[(*
