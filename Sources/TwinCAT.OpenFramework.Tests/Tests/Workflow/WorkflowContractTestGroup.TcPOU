<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowContractTestGroup" Id="{a9fd8154-d63b-4fcf-af02-d6981feca319}" SpecialFunc="None">
    <Declaration><![CDATA[(*
