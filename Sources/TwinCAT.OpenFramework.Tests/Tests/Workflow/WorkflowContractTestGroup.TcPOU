(*
Groups workflow ownership, topology, configuration, failure handling and timing scenarios.

Owns the fixed case tree and runs its leaves in order in the controller task.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WorkflowContractTestGroup EXTENDS TOF_Testing.TestGroup<33>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_RootAssociation : WorkflowContractTestCase(
		name := "TestRootAssociation",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.ROOT_ASSOCIATION
	);
	_SequenceTopology : WorkflowContractTestCase(
		name := "TestSequenceTopology",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.SEQUENCE_TOPOLOGY
	);
	_TransitionDiagnostics : WorkflowContractTestCase(
		name := "TestTransitionDiagnostics",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.TRANSITION_DIAGNOSTICS
	);
	_DependencyBindings : WorkflowContractTestCase(
		name := "TestDependencyBindings",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.DEPENDENCY_BINDINGS
	);
	_WriteConfiguration : WorkflowContractTestCase(
		name := "TestWriteConfiguration",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.WRITE_CONFIGURATION
	);
	_LoadConfiguration : WorkflowContractTestCase(
		name := "TestLoadConfiguration",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.LOAD_CONFIGURATION
	);
	_OperatorSerialization : WorkflowContractTestCase(
		name := "TestOperatorSerialization",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.OPERATOR_SERIALIZATION
	);
	_DeserializeNullContextRejection : WorkflowContractTestCase(
		name := "TestDeserializeNullContextRejection",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.DESERIALIZE_NULL_CONTEXT_REJECTION
	);
	_FactoryDeclarations : WorkflowContractTestCase(
		name := "TestFactoryDeclarations",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.FACTORY_DECLARATIONS
	);
	_ArrayValidation : WorkflowContractTestCase(
		name := "TestArrayValidation",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.ARRAY_VALIDATION
	);
	_WorkflowIsolation : WorkflowContractTestCase(
		name := "TestWorkflowIsolation",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.WORKFLOW_ISOLATION
	);
	_ConditionTopology : WorkflowContractTestCase(
		name := "TestConditionTopology",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.CONDITION_TOPOLOGY
	);
	_ParentSetters : WorkflowContractTestCase(
		name := "TestParentSetters",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.PARENT_SETTERS
	);
	_InitializationRetry : WorkflowContractTestCase(
		name := "TestInitializationRetry",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.INITIALIZATION_RETRY
	);
	_BoundaryDiagnostics : WorkflowContractTestCase(
		name := "TestBoundaryDiagnostics",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.BOUNDARY_DIAGNOSTICS
	);
	_InvokeConfiguration : WorkflowContractTestCase(
		name := "TestInvokeConfiguration",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.INVOKE_CONFIGURATION
	);
	_TaskFailureDuringSuspend : WorkflowContractTestCase(
		name := "TestTaskFailureDuringSuspend",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_FAILURE_DURING_SUSPEND
	);
	_TaskCompletionDuringSuspend : WorkflowContractTestCase(
		name := "TestTaskCompletionDuringSuspend",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_COMPLETION_DURING_SUSPEND
	);
	_TaskAbortDuringSuspend : WorkflowContractTestCase(
		name := "TestTaskAbortDuringSuspend",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_ABORT_DURING_SUSPEND
	);
	_TaskReleaseFailureDuringCancel : WorkflowContractTestCase(
		name := "TestTaskReleaseFailureDuringCancel",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_RELEASE_FAILURE_DURING_CANCEL
	);
	_CatchCleanupBoundary : WorkflowContractTestCase(
		name := "TestCatchCleanupBoundary",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.CATCH_CLEANUP_BOUNDARY
	);
	_ConcreteMetadata : WorkflowContractTestCase(
		name := "TestConcreteMetadata",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.CONCRETE_METADATA
	);
	_VariableLookup : WorkflowContractTestCase(
		name := "TestVariableLookup",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.VARIABLE_LOOKUP
	);
	_DeclaredVariableReset : WorkflowContractTestCase(
		name := "TestDeclaredVariableReset",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.DECLARED_VARIABLE_RESET
	);
	_DeclaredVariableValidation : WorkflowContractTestCase(
		name := "TestDeclaredVariableValidation",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.DECLARED_VARIABLE_VALIDATION
	);
	_ConditionScopePrecedence : WorkflowContractTestCase(
		name := "TestConditionScopePrecedence",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.CONDITION_SCOPE_PRECEDENCE
	);
	_DelayPauseRemaining : WorkflowDelayPauseRemainingTest(name := "TestDelayPauseRemaining", parent := THIS^);
	_DelayLifecycle : WorkflowContractTestCase(
		name := "TestDelayLifecycle",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.DELAY_LIFECYCLE
	);
	_StaticSelfConfigurationViaExecute : WorkflowContractTestCase(
		name := "TestStaticSelfConfigurationViaExecute",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.STATIC_SELF_CONFIGURATION_VIA_EXECUTE
	);
	_StaticSelfConfigurationViaRequestStart : WorkflowContractTestCase(
		name := "TestStaticSelfConfigurationViaRequestStart",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.STATIC_SELF_CONFIGURATION_VIA_REQUEST_START
	);
	_ExternalRootSkipsOnConfigure : WorkflowContractTestCase(
		name := "TestExternalRootSkipsOnConfigure",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.EXTERNAL_ROOT_SKIPS_ON_CONFIGURE
	);
	_OnConfigureFailureIsNonRecoverable : WorkflowContractTestCase(
		name := "TestOnConfigureFailureIsNonRecoverable",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.ON_CONFIGURE_FAILURE_IS_NON_RECOVERABLE
	);
	_OnConfigureReentrancyRejection : WorkflowContractTestCase(
		name := "TestOnConfigureReentrancyRejection",
		parent := THIS^,
		scenario := WORKFLOW_CONTRACT_TEST_SCENARIO.ON_CONFIGURE_REENTRANCY_REJECTION
	);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_RootAssociation,
		_SequenceTopology,
		_TransitionDiagnostics,
		_DependencyBindings,
		_WriteConfiguration,
		_LoadConfiguration,
		_OperatorSerialization,
		_DeserializeNullContextRejection,
		_FactoryDeclarations,
		_ArrayValidation,
		_WorkflowIsolation,
		_ConditionTopology,
		_ParentSetters,
		_InitializationRetry,
		_BoundaryDiagnostics,
		_InvokeConfiguration,
		_TaskFailureDuringSuspend,
		_TaskCompletionDuringSuspend,
		_TaskAbortDuringSuspend,
		_TaskReleaseFailureDuringCancel,
		_CatchCleanupBoundary,
		_ConcreteMetadata,
		_VariableLookup,
		_DeclaredVariableReset,
		_DeclaredVariableValidation,
		_ConditionScopePrecedence,
		_DelayPauseRemaining,
		_DelayLifecycle,
		_StaticSelfConfigurationViaExecute,
		_StaticSelfConfigurationViaRequestStart,
		_ExternalRootSkipsOnConfigure,
		_OnConfigureFailureIsNonRecoverable,
		_OnConfigureReentrancyRejection
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{bcceda25-6b85-41a2-9533-d767f4461eea}">
      <Declaration><![CDATA[(* Borrows the persistent case array. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{f9f53561-fb7b-4fd4-89c3-bd74ffe63987}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{22e4f8c0-473d-40f7-ba6c-1ce62e365cc4}">
      <Declaration><![CDATA[(* Borrows the concrete class name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e29809bc-3fb3-4545-9d52-c3894e252a62}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{15b5521e-489e-4f3b-810d-6ef38dab3423}">
      <Declaration><![CDATA[(* Borrows the project namespace name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5df929c9-b285-4cc5-9d2a-91646bdd085a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{65bbafa7-977f-437a-bf1b-d3f124fbd5b1}">
      <Declaration><![CDATA[(* Reports the complete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{01222d6b-14dc-4eae-8741-83d199d1d80f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
