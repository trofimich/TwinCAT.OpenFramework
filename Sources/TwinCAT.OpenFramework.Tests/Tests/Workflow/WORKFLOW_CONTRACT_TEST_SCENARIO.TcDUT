  <DUT Name="WORKFLOW_CONTRACT_TEST_SCENARIO" Id="{9abd3eb4-2322-433f-9b89-4714ab7b298a}">
    <Declaration><![CDATA[(* Selects one independently reported scenario in the WorkflowContractTest group. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE WORKFLOW_CONTRACT_TEST_SCENARIO :
(
	ROOT_ASSOCIATION,
	SEQUENCE_TOPOLOGY,
	TRANSITION_DIAGNOSTICS,
	DEPENDENCY_BINDINGS,
	WRITE_CONFIGURATION,
	LOAD_CONFIGURATION,
	OPERATOR_SERIALIZATION,
	DESERIALIZE_NULL_CONTEXT_REJECTION,
	FACTORY_DECLARATIONS,
	ARRAY_VALIDATION,
	WORKFLOW_ISOLATION,
	CONDITION_TOPOLOGY,
	PARENT_SETTERS,
	INITIALIZATION_RETRY,
	BOUNDARY_DIAGNOSTICS,
	INVOKE_CONFIGURATION,
	TASK_FAILURE_DURING_SUSPEND,
	TASK_COMPLETION_DURING_SUSPEND,
	TASK_ABORT_DURING_SUSPEND,
	TASK_RELEASE_FAILURE_DURING_CANCEL,
	CATCH_CLEANUP_BOUNDARY,
	CONCRETE_METADATA,
	VARIABLE_LOOKUP,
	DECLARED_VARIABLE_RESET,
	DECLARED_VARIABLE_VALIDATION,
	CONDITION_SCOPE_PRECEDENCE,
	DELAY_LIFECYCLE,
	STATIC_SELF_CONFIGURATION_VIA_EXECUTE,
	STATIC_SELF_CONFIGURATION_VIA_REQUEST_START,
	EXTERNAL_ROOT_SKIPS_ON_CONFIGURE,
	ON_CONFIGURE_FAILURE_IS_NON_RECOVERABLE,
	ON_CONFIGURE_REENTRANCY_REJECTION
);
END_TYPE]]></Declaration>
