    <Method Name="ExecuteScenario" Id="{6d02c419-d0c8-45cb-b367-0551d8d0f84d}">
      <Declaration><![CDATA[(*
Dispatches one scenario against the fresh fixture.

Call once per fixture. Each method uses the assertions of the receiving case.
scenario — Scenario assigned to the caller.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD ExecuteScenario
VAR_INPUT
	scenario : WORKFLOW_CONTRACT_TEST_SCENARIO;
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE scenario OF
	WORKFLOW_CONTRACT_TEST_SCENARIO.ROOT_ASSOCIATION:
		testRootAssociation(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.SEQUENCE_TOPOLOGY:
		testSequenceTopology(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.TRANSITION_DIAGNOSTICS:
		testTransitionDiagnostics(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.DEPENDENCY_BINDINGS:
		testDependencyBindings(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.WRITE_CONFIGURATION:
		testWriteConfiguration(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.LOAD_CONFIGURATION:
		testLoadConfiguration(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.OPERATOR_SERIALIZATION:
		testOperatorSerialization(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.DESERIALIZE_NULL_CONTEXT_REJECTION:
		testDeserializeNullContextRejection(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.FACTORY_DECLARATIONS:
		testFactoryDeclarations(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.ARRAY_VALIDATION:
		testArrayValidation(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.WORKFLOW_ISOLATION:
		testWorkflowIsolation(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.CONDITION_TOPOLOGY:
		testConditionTopology(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.PARENT_SETTERS:
		testParentSetters(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.INITIALIZATION_RETRY:
		testInitializationRetry(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.BOUNDARY_DIAGNOSTICS:
		testBoundaryDiagnostics(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.INVOKE_CONFIGURATION:
		testInvokeConfiguration(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_FAILURE_DURING_SUSPEND:
		testTaskFailureDuringSuspend(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_COMPLETION_DURING_SUSPEND:
		testTaskCompletionDuringSuspend(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_ABORT_DURING_SUSPEND:
		testTaskAbortDuringSuspend(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.TASK_RELEASE_FAILURE_DURING_CANCEL:
		testTaskReleaseFailureDuringCancel(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.CATCH_CLEANUP_BOUNDARY:
		testCatchCleanupBoundary(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.CONCRETE_METADATA:
		testConcreteMetadata(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.VARIABLE_LOOKUP:
		testVariableLookup(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.DECLARED_VARIABLE_RESET:
		testDeclaredVariableReset(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.DECLARED_VARIABLE_VALIDATION:
		testDeclaredVariableValidation(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.CONDITION_SCOPE_PRECEDENCE:
		testConditionScopePrecedence(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.DELAY_LIFECYCLE:
		testDelayLifecycle(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.STATIC_SELF_CONFIGURATION_VIA_EXECUTE:
		testStaticSelfConfigurationViaExecute(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.STATIC_SELF_CONFIGURATION_VIA_REQUEST_START:
		testStaticSelfConfigurationViaRequestStart(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.EXTERNAL_ROOT_SKIPS_ON_CONFIGURE:
		testExternalRootSkipsOnConfigure(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.ON_CONFIGURE_FAILURE_IS_NON_RECOVERABLE:
		testOnConfigureFailureIsNonRecoverable(assertions := assertions);

	WORKFLOW_CONTRACT_TEST_SCENARIO.ON_CONFIGURE_REENTRANCY_REJECTION:
		testOnConfigureReentrancyRejection(assertions := assertions);
ELSE
	assertions.ThatBool(actual := FALSE, message := "Unknown workflow contract scenario").IsTrue();
END_CASE]]></ST>
      </Implementation>
    </Method>
