    <Method Name="testBoundaryDiagnostics" Id="{adf9b6f6-08b7-404f-977b-06b3d4d5a22c}">
      <Declaration><![CDATA[(*
Contains a throwing formatter, runs the after-hook once and permits reset and reuse.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testBoundaryDiagnostics
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	escaped : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BoundaryWorkflow.SetRootActivity(rootActivity := _BoundaryActivity);
_BoundaryWorkflow.RequestStart();
_BoundaryActivity.throwMessageFailure := TRUE;

__TRY
	_BoundaryWorkflow.Execute();
__CATCH
	escaped := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := escaped,
	message := "Diagnostic conversion must not escape the workflow boundary"
).IsFalse();
assertions.ThatDInt(
	actual := _BoundaryWorkflow.afterCount,
	message := "The after-hook must run once"
).ToBe(expected := 1);
assertions.ThatBool(
	actual := _BoundaryWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
	message := "The original activity failure must remain visible"
).IsTrue();
assertions.ThatBool(
	actual := _BoundaryWorkflow.FailError.HasError,
	message := "Fallback must be a durable error"
).IsTrue();
assertions.ThatWideString(
	actual := _BoundaryWorkflow.FailError.TopMessage,
	message := "Workflow fallback must identify unavailable diagnostics"
).ToBe(expected := "Workflow exception diagnostics are unavailable");
assertions.ThatWideString(
	actual := _BoundaryActivity.FailError.TopMessage,
	message := "Activity fallback must not retain partial diagnostic output"
).ToBe(expected := "Activity exception diagnostics are unavailable");

assertions.ThatBool(
	actual := _BoundaryWorkflow.FailError.LocalTimestamp = TOF_Core.LongDateAndTimes.EPOCH,
	message := "Fallback must not claim an unavailable exception timestamp"
).IsTrue();
assertions.ThatBool(
	actual := _BoundaryActivity.FailError.LocalTimestamp = TOF_Core.LongDateAndTimes.EPOCH,
	message := "Activity fallback must clear partial timestamps"
).IsTrue();

_BoundaryWorkflow.RequestReset();
assertions.ThatBool(
	actual := _BoundaryWorkflow.FailError.HasError,
	message := "Successful reset must clear fallback diagnostics"
).IsFalse();
_BoundaryActivity.throwMessageFailure := FALSE;
_BoundaryActivity.completeRunning := TRUE;
_BoundaryWorkflow.RequestStart();
assertions.ThatBool(
	actual := _BoundaryWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "The reset workflow must support a subsequent successful run"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testCatchCleanupBoundary" Id="{15577c12-1b83-427f-a3c6-edb36a3b31ec}">
      <Declaration><![CDATA[(*
Keeps synchronous catch startup separate from pending try-branch cleanup.

Uses independent synthetic recovery while a sibling task still stops. Explicit reset must then drive that
remaining work to READY. No physical resource or terminal allocation failure is injected.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testCatchCleanupBoundary
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CleanupTask.requiredStopCalls := 3;
_CleanupInvoke.Configure(task := _CleanupTask);
_CleanupFault.throwOrdinaryFailure := TRUE;
_CleanupParallel.AddChildActivity(activity := _CleanupInvoke);
_CleanupParallel.AddChildActivity(activity := _CleanupFault);
_CleanupTryCatch.Configure(tryActivity := _CleanupParallel, catchActivity := _CleanupCatch);
_CleanupWorkflow.SetRootActivity(rootActivity := _CleanupTryCatch);
_CleanupWorkflow.RequestStart();

assertions.ThatBool(
	actual := _CleanupWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "Independent catch recovery may finish before asynchronous try cleanup"
).IsTrue();
assertions.ThatBool(actual := _CleanupCatch.Recovered, message := "The catch activity must actually run").IsTrue();
assertions.ThatBool(
	actual := _CleanupCatch.Error.HasError,
	message := "Catch diagnostics must be captured synchronously"
).IsTrue();
assertions.ThatBool(
	actual := _CleanupTask.State.Running,
	message := "Failed-branch task cleanup must still be pending"
).IsTrue();
assertions.ThatBool(
	actual := _CleanupWorkflow.Busy,
	message := "Root Busy is not a nested cleanup-completion signal"
).IsFalse();
assertions.ThatDInt(
	actual := _CleanupTask.stopCount,
	message := "Catch startup must not silently drain extra task steps"
).ToBe(expected := 1);

_CleanupWorkflow.RequestReset();

FOR i := 1 TO 8 DO
	_CleanupWorkflow.Execute();

	IF NOT _CleanupWorkflow.Busy THEN
		EXIT;
	END_IF
END_FOR

assertions.ThatBool(
	actual := _CleanupWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
	message := "Explicit reset must advance pending try-branch stopping and resetting"
).IsTrue();
assertions.ThatBool(
	actual := _CleanupTask.State.Ready,
	message := "The task must be ready after explicit cleanup"
).IsTrue();
assertions.ThatBool(
	actual := _CleanupCatch.Error.HasError,
	message := "Reset must clear the captured recovery snapshot"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testConcreteMetadata" Id="{19af6d1d-6adf-419a-abf8-378e1113f396}">
      <Declaration><![CDATA[(*
Checks concrete workflow metadata without copying ownership-bearing instances.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testConcreteMetadata
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	workflowInterface : TOF_Workflow.IWorkflow;
	namedWorkflow : TOF_Core.INamed;
	resetScopeOwner : TOF_Workflow.IVariableResetScopeProvider;
	borrowedResetScope : TOF_Workflow.IVariableResetScope;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[assertions.ThatBool(
	actual := _MetadataWorkflow.ClassName = _MetadataBase.ClassName,
	message := "A concrete derived workflow must not report the base workflow class"
).IsFalse();
assertions.ThatString(
	actual := _MetadataWorkflow.NamespaceName,
	message := "The concrete workflow must report the test namespace"
).ToBe(expected := CurrentNamespace.Name);
assertions.ThatULInt(
	actual := _MetadataWorkflow.SelfSize,
	message := "Concrete workflow size must include derived fields"
).ToBe(expected := XSIZEOF(_MetadataWorkflow));
assertions.ThatBool(
	actual := _MetadataWorkflow.SelfAddress = ADR(_MetadataWorkflow),
	message := "Concrete metadata must refer to the original instance"
).IsTrue();

workflowInterface := _MetadataBase;
assertions.ThatBool(
	actual := __QUERYINTERFACE(workflowInterface, namedWorkflow),
	message := "IWorkflow must expose INamed"
).IsTrue();
assertions.ThatBool(
	actual := namedWorkflow.Name <> "",
	message := "Workflow must initialize a default diagnostic name in FB_init"
).IsTrue();
namedWorkflow.Name := "Renamed workflow";
assertions.ThatWideString(
	actual := _MetadataBase.Name,
	message := "Mutating Name through INamed must update the workflow name"
).ToBe(expected := "Renamed workflow");

resetScopeOwner := _AssociatedRoot;
borrowedResetScope := resetScopeOwner.GetResetScope();
assertions.ThatBool(
	actual := borrowedResetScope <> 0,
	message := "Activity must expose its embedded reset scope through IVariableResetScopeProvider"
).IsTrue();

assertions.ThatBool(
	actual := TOF_Workflow.WorkflowExceptions.ClassName <> '',
	message := "The exception helper program must expose its diagnostic name"
).IsTrue();
assertions.ThatBool(
	actual := TOF_Workflow.WorkflowExceptions.ClassName = TOF_Workflow.Workflows.ClassName,
	message := "Different helper programs must retain distinct class metadata"
).IsFalse();
assertions.ThatString(
	actual := TOF_Workflow.WorkflowExceptions.NamespaceName,
	message := "Exception helper namespace must match the workflow library"
).ToBe(expected := _MetadataBase.NamespaceName);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testConditionScopePrecedence" Id="{d54cfd66-8e51-4e3b-8ef1-bcd56fa4e3ee}">
      <Declaration><![CDATA[(*
Checks lexical variable precedence in value and relational conditions.

Persistent bindings deliberately reuse names with different values. Includes unattached conditions,
condition parents, attached activities, alternate contexts, both comparison operands and workflow fallback.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testConditionScopePrecedence
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expectedValue : DINT;
	found : BOOL;
	resolved : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ScopeWorkflow.BindPlcVariable(name := 'Target', plcVariable := _ScopeWorkflowValue);
_ScopeWorkflow.BindPlcVariable(name := 'Right', plcVariable := _ScopeWorkflowRight);
_ScopeWorkflow.BindPlcVariable(name := 'Attached', plcVariable := _ScopeWorkflowValue);
_ScopeWorkflow.BindPlcVariable(name := 'Ancestor', plcVariable := _ScopeWorkflowValue);
_ScopeWorkflow.BindPlcVariable(name := 'WorkflowOnly', plcVariable := _ScopeWorkflowValue);
_ScopeOtherWorkflow.BindPlcVariable(name := 'WorkflowOnly', plcVariable := _ScopeOtherValue);
_ScopeOtherWorkflow.BindPlcVariable(name := 'OtherOnly', plcVariable := _ScopeOtherValue);
_ScopeContext.BindPlcVariable(name := 'Target', plcVariable := _ScopeContextValue);
_ScopeContext.BindPlcVariable(name := 'Right', plcVariable := _ScopeContextValue);
_ScopeContext.BindPlcVariable(name := 'Attached', plcVariable := _ScopeContextValue);
_ScopeContextParent.BindPlcVariable(name := 'Ancestor', plcVariable := _ScopeAncestorValue);
_ScopeContextParent.AddChildActivity(activity := _ScopeContext);

expectedValue := _ScopeContextValue;
_ScopeFree.Configure(monitoredVariableName := 'Target', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeFree.Evaluate(activity := _ScopeContext),
	message := "Unattached condition must use context local binding before its associated workflow"
).IsTrue();

_ScopeFree.BindPlcVariable(name := 'Target', plcVariable := _ScopeLocalValue);
expectedValue := _ScopeLocalValue;
_ScopeFree.Configure(monitoredVariableName := 'Target', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeFree.Evaluate(activity := _ScopeContext),
	message := "Condition local binding must shadow context and workflow bindings"
).IsTrue();
assertions.ThatBool(
	actual := _ScopeFree.Evaluate(activity := 0),
	message := "Local binding requires no activity context"
).IsTrue();

_ScopeGroup.BindPlcVariable(name := 'Target', plcVariable := _ScopeConditionParentValue);
_ScopeGroup.AddChildCondition(condition := _ScopeLeaf);
_ScopeGroup.ParentActivity := _ScopeAttached;
_ScopeAttached.BindPlcVariable(name := 'Attached', plcVariable := _ScopeAttachedValue);
expectedValue := _ScopeConditionParentValue;
_ScopeLeaf.Configure(monitoredVariableName := 'Target', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeLeaf.Evaluate(activity := _ScopeContext),
	message := "Parent condition local binding must precede the evaluating activity"
).IsTrue();

expectedValue := _ScopeAttachedValue;
_ScopeLeaf.Configure(monitoredVariableName := 'Attached', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeLeaf.Evaluate(activity := _ScopeContext),
	message := "Attached activity binding must precede an alternate evaluating activity"
).IsTrue();

expectedValue := _ScopeAncestorValue;
_ScopeLeaf.Configure(monitoredVariableName := 'Ancestor', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeLeaf.Evaluate(activity := _ScopeContext),
	message := "Context ancestor binding must precede workflow fallback"
).IsTrue();

expectedValue := _ScopeWorkflowValue;
_ScopeLeaf.Configure(monitoredVariableName := 'WorkflowOnly', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeLeaf.Evaluate(activity := _ScopeForeignContext),
	message := "Associated workflow fallback must precede a distinct context workflow"
).IsTrue();
assertions.ThatBool(
	actual := _ScopeLeaf.Evaluate(activity := 0),
	message := "Workflow fallback requires no context"
).IsTrue();

expectedValue := _ScopeOtherValue;
_ScopeLeaf.Configure(monitoredVariableName := 'OtherOnly', referenceValue := expectedValue);
assertions.ThatBool(
	actual := _ScopeLeaf.Evaluate(activity := _ScopeForeignContext),
	message := "A distinct context workflow is the last fallback"
).IsTrue();

expectedValue := _ScopeContextValue;
_ScopeComparison.Configure(
	firstVariableName := 'Target',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.EQUAL,
	referenceValue := expectedValue
);
assertions.ThatBool(
	actual := _ScopeComparison.Evaluate(activity := _ScopeContext),
	message := "Reference comparison must use context locals before workflow fallback"
).IsTrue();
_ScopeComparison.BindPlcVariable(name := 'Target', plcVariable := _ScopeLocalValue);
expectedValue := _ScopeLocalValue;
_ScopeComparison.Configure(
	firstVariableName := 'Target',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.EQUAL,
	referenceValue := expectedValue
);
assertions.ThatBool(
	actual := _ScopeComparison.Evaluate(activity := _ScopeContext),
	message := "Reference comparison must retain condition-local precedence"
).IsTrue();

_ScopePair.ConfigureVariable(
	firstVariableName := 'Target',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.EQUAL,
	secondVariableName := 'Right'
);
assertions.ThatBool(
	actual := _ScopePair.Evaluate(activity := _ScopeContext),
	message := "Both comparison operands must resolve in context before workflow fallback"
).IsTrue();

found := _ScopeContext.TryGetLocalVariable(name := 'WorkflowOnly', variable => resolved);
assertions.ThatBool(
	actual := found,
	message := "Local-only activity lookup must not include its workflow"
).IsFalse();
found := _ScopeLeaf.TryGetLocalVariable(name := 'Target', variable => resolved);
assertions.ThatBool(actual := found, message := "Local-only condition lookup must not include its parent").IsFalse();
found := _ScopeFree.TryGetLocalVariable(name := 'Target', variable => resolved);
assertions.ThatBool(actual := found, message := "Direct condition binding must be discoverable").IsTrue();
assertions.ThatBool(
	actual := resolved.Address = ADR(_ScopeLocalValue),
	message := "Local descriptor must remain borrowed"
).IsTrue();

_WaitScopeWorkflow.BindPlcVariable(name := 'Target', plcVariable := _ScopeWorkflowValue);
_WaitScopeActivity.BindPlcVariable(name := 'Target', plcVariable := _ScopeContextValue);
expectedValue := _ScopeContextValue;
_WaitScopeActivity.Configure(monitoredVariableName := 'Target', referenceValue := expectedValue);
_WaitScopeWorkflow.SetRootActivity(rootActivity := _WaitScopeActivity);
_WaitScopeWorkflow.RequestStart();
assertions.ThatBool(
	actual := _WaitScopeWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "WaitVariableValue internal condition must see the activity local binding before workflow"
).IsTrue();
_WaitScopeWorkflow.RequestReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testConditionTopology" Id="{b1cbcc93-94b7-4d1f-aa83-86cf97d1f3c5}">
      <Declaration><![CDATA[(*
Rejects duplicate and cyclic conditions and resolves activity context through the live chain.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testConditionTopology
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expectedActivity : TOF_Workflow.IActivity;
	expectedCondition : TOF_Workflow.ICondition;
	actualActivity : TOF_Workflow.IActivity;
	actualCondition : TOF_Workflow.ICondition;
	actualElement : TOF_Workflow.IWorkflowElement;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	attachmentException : TOF_Workflow.IWorkflowAttachmentException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ConditionGroup.AddChildCondition(condition := _ConditionLeaf);
caught := FALSE;

__TRY
	_ConditionGroup.AddChildCondition(condition := _ConditionLeaf);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Condition slots cannot share an instance").IsTrue();
_ConditionNot.Configure(condition := _ConditionGroup);
caught := FALSE;

__TRY
	_ConditionGroup.AddChildCondition(condition := _ConditionNot);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A condition ancestor cannot become a child").IsTrue();
expectedActivity := _ConditionHost;
_ConditionHost.Configure(condition := _ConditionNot);
_ConditionNot.Configure(condition := _ConditionGroup);
actualActivity := _ConditionLeaf.EnclosingActivity;
assertions.ThatBool(
	actual := actualActivity = expectedActivity,
	message := "Nested condition activity context must follow the parent chain"
).IsTrue();
actualActivity := _ConditionLeaf.ParentActivity;
assertions.ThatBool(
	actual := actualActivity = 0,
	message := "Nested condition immediate parent activity must be zero when attached to a condition"
).IsTrue();
expectedCondition := _ConditionGroup;
actualCondition := _ConditionLeaf.ParentCondition;
assertions.ThatBool(
	actual := actualCondition = expectedCondition,
	message := "Nested condition immediate parent condition must be its direct composite"
).IsTrue();
caught := FALSE;

__TRY
	_ConditionLeaf.ParentCondition := _ConditionLeaf;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A bound condition cannot replace its parent").IsTrue();
caught := FALSE;

__TRY
	_FreeCondition.ParentCondition := _FreeCondition;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A direct self-parent setter must be rejected").IsTrue();
actualElement := _FreeCondition.Parent;
assertions.ThatBool(
	actual := actualElement = 0,
	message := "Failed setter must preserve an unattached condition"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDelayLifecycle" Id="{8a705608-0fe1-495e-a6d9-5e201d173db0}">
      <Declaration><![CDATA[(*
Checks zero interval, same-cycle resume, cancellation and reset reuse.

Uses a persistent standalone activity. The positive interval prevents natural completion during synchronous
lifecycle calls; cyclic remaining-time accuracy is covered separately by TestDelayPauseRemaining.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testDelayLifecycle
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR_INST
	delay : TOF_Workflow.DelayActivity(workflow := 0);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[delay.Interval := TOF_Core.Times.MIN_VALUE;
delay.RequestStart();
assertions.ThatBool(
	actual := delay.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "Zero interval must complete on a fresh start"
).IsTrue();
delay.RequestReset();
delay.Interval := T#1H;
delay.RequestStart();
delay.RequestSuspend();
delay.RequestStart();
assertions.ThatBool(
	actual := delay.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING,
	message := "Same-cycle suspension and resume must retain a positive interval"
).IsTrue();
delay.RequestSuspend();
delay.RequestCancel(reason := "Lifecycle regression");
assertions.ThatBool(
	actual := delay.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED,
	message := "Cancellation from suspension must finish immediately"
).IsTrue();
assertions.ThatBool(
	actual := delay.Interval = T#1H,
	message := "Cancellation must retain nominal Interval"
).IsTrue();
delay.RequestReset();
delay.RequestStart();
assertions.ThatBool(
	actual := delay.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING,
	message := "Reset after cancellation must allow another positive run"
).IsTrue();
delay.RequestCancel(reason := "Lifecycle regression cleanup");
delay.RequestReset();
delay.Interval := TOF_Core.Times.MIN_VALUE;
delay.RequestStart();
assertions.ThatBool(
	actual := delay.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "Reconfiguring the interval after reset must apply to the next run"
).IsTrue();
delay.RequestReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInitializationRetry" Id="{63f3bffc-b980-4de2-827d-f9b07c8a03d3}">
      <Declaration><![CDATA[(*
Rolls back only hook-added bindings and retries without deleting caller-owned configuration.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testInitializationRetry
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expectedRoot : TOF_Workflow.IActivity;
	actualActivity : TOF_Workflow.IActivity;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	standardException : TOF_Core.IStandardException;
	found : BOOL;
	resolved : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[expectedRoot := _RetryRoot;
_RetryWorkflow.BindPlcVariable(name := 'External', plcVariable := _ExternalValue);
_RetryWorkflow.throwInitialization := TRUE;
caught := FALSE;

__TRY
	_RetryWorkflow.SetRootActivity(rootActivity := _RetryRoot);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, standardException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An ordinary initialization failure must propagate").IsTrue();
actualActivity := _RetryWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualActivity = 0,
	message := "Failed initialization must not install the root"
).IsTrue();
found := _RetryWorkflow.TryGetVariable(name := 'External', variable => resolved);
assertions.ThatBool(
	actual := found,
	message := "A preexisting binding must survive initialization rollback"
).IsTrue();
assertions.ThatBool(
	actual := resolved.Address = ADR(_ExternalValue),
	message := "Preexisting storage identity must survive"
).IsTrue();
found := _RetryWorkflow.TryGetVariable(name := 'Initialized', variable => resolved);
assertions.ThatBool(actual := found, message := "The failed hook binding must be removed").IsFalse();

_RetryWorkflow.SetRootActivity(rootActivity := _RetryRoot);
actualActivity := _RetryWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualActivity = expectedRoot,
	message := "Retry must install the prepared root"
).IsTrue();
assertions.ThatDInt(
	actual := _RetryWorkflow.initializationCount,
	message := "Initialization must retry once"
).ToBe(expected := 2);
found := _RetryWorkflow.TryGetVariable(name := 'Initialized', variable => resolved);
assertions.ThatBool(actual := found, message := "A successful retry must register the hook binding").IsTrue();
_RetryWorkflow.SetRootActivity(rootActivity := _RetryRoot);
assertions.ThatDInt(
	actual := _RetryWorkflow.initializationCount,
	message := "Success must not be initialized again"
).ToBe(expected := 2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInvokeConfiguration" Id="{c00f8cc8-9765-4529-9eb8-6aaa22393e11}">
      <Declaration><![CDATA[(*
Rejects task replacement while running, stopping and finished, then permits replacement after reset.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testInvokeConfiguration
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expectedTask : TOF_Tasks.ITask;
	actualTask : TOF_Tasks.ITask;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationException : TOF_Workflow.IWorkflowConfigurationException;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[expectedTask := _ConfigTask;
_ConfigTask.requiredStopCalls := 3;
_ConfigActivity.Configure(task := _ConfigTask);
_ConfigWorkflow.SetRootActivity(rootActivity := _ConfigActivity);
_ConfigWorkflow.RequestStart();
caught := FALSE;

__TRY
	_ConfigActivity.Configure(task := _ReplacementTask);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Running configuration must be rejected").IsTrue();
actualTask := _ConfigActivity.Task;
assertions.ThatBool(
	actual := actualTask = expectedTask,
	message := "Rejected replacement preserves the active dependency"
).IsTrue();
_ConfigWorkflow.RequestCancel(reason := "Configuration test");
caught := FALSE;

__TRY
	_ConfigActivity.Configure(task := _ReplacementTask);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Stopping configuration must be rejected").IsTrue();

FOR i := 1 TO 4 DO
	_ConfigWorkflow.Execute();
END_FOR

assertions.ThatBool(
	actual := _ConfigTask.State.Stopped,
	message := "The original task must be serviced through stopping"
).IsTrue();
caught := FALSE;

__TRY
	_ConfigActivity.Configure(task := _ReplacementTask);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A finished activity requires reset before configuration").IsTrue();
expectedTask := _ReplacementTask;
_ConfigWorkflow.RequestReset();
_ConfigActivity.Configure(task := _ReplacementTask);
actualTask := _ConfigActivity.Task;
assertions.ThatBool(
	actual := actualTask = expectedTask,
	message := "Ready configuration may replace the dependency"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testParentSetters" Id="{372e3208-2548-408e-85ab-4efe636a6d24}">
      <Declaration><![CDATA[(*
Preserves direct parent links when self, ancestor, detach or replacement assignments are rejected.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testParentSetters
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expectedParent : TOF_Workflow.IActivity;
	actualActivity : TOF_Workflow.IActivity;
	actualElement : TOF_Workflow.IWorkflowElement;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	attachmentException : TOF_Workflow.IWorkflowAttachmentException;
	configurationException : TOF_Workflow.IWorkflowConfigurationException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[expectedParent := _ParentSequence;
_ParentSequence.AddChildActivity(activity := _ParentChild);
_ParentChild.ParentActivity := _ParentSequence;
caught := FALSE;

__TRY
	_ParentChild.ParentActivity := _OtherParent;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An existing activity parent cannot be replaced").IsTrue();
caught := FALSE;

__TRY
	_ParentChild.ParentActivity := 0;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An existing activity parent cannot be detached").IsTrue();
caught := FALSE;

__TRY
	_ParentSequence.ParentActivity := _ParentChild;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A direct parent setter cannot create an ancestor cycle").IsTrue();
actualActivity := _ParentChild.ParentActivity;
assertions.ThatBool(
	actual := actualActivity = expectedParent,
	message := "The original parent must be preserved"
).IsTrue();
actualElement := _ParentSequence.Parent;
assertions.ThatBool(actual := actualElement = 0, message := "The ancestor must remain unattached").IsTrue();

_ParentCondition.ParentActivity := _ParentSequence;
caught := FALSE;

__TRY
	_ParentCondition.ParentActivity := _OtherParent;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An existing condition parent cannot be replaced").IsTrue();
caught := FALSE;

__TRY
	_ParentCondition.ParentActivity := 0;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An existing condition parent cannot be detached").IsTrue();
actualActivity := _ParentCondition.ParentActivity;
assertions.ThatBool(
	actual := actualActivity = expectedParent,
	message := "A condition keeps its original activity parent"
).IsTrue();

_BusyRoot.AddChildActivity(activity := _BusyRunning);
_BusyRoot.AddChildActivity(activity := _BusyDormant);
_BusyWorkflow.SetRootActivity(rootActivity := _BusyRoot);
_BusyWorkflow.RequestStart();
caught := FALSE;

__TRY
	_BusyDormant.AddChildActivity(activity := _BusyCandidate);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A ready branch in a running tree cannot accept a child").IsTrue();
caught := FALSE;

__TRY
	_BusyCandidate.ParentActivity := _BusyDormant;
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A direct setter cannot mutate a running ancestor tree").IsTrue();
actualElement := _BusyCandidate.Parent;
assertions.ThatBool(
	actual := actualElement = 0,
	message := "Rejected active-tree mutation must preserve the candidate"
).IsTrue();
_BusyWorkflow.RequestCancel(reason := "Topology test complete");
_BusyWorkflow.RequestReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRootAssociation" Id="{114a78e6-e29d-4e2f-9898-e5660c5c4f60}">
      <Declaration><![CDATA[(*
Checks explicit root ownership, rejection before mutation and root-child exclusion.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testRootAssociation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	actualActivity : TOF_Workflow.IActivity;
	actualElement : TOF_Workflow.IWorkflowElement;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	attachmentException : TOF_Workflow.IWorkflowAttachmentException;
	found : BOOL;
	resolved : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[caught := FALSE;

__TRY
	_RootWorkflow.SetRootActivity(rootActivity := _UnassociatedRoot);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An unassociated root must be rejected").IsTrue();
actualActivity := _RootWorkflow.RootActivity;
assertions.ThatBool(actual := actualActivity = 0, message := "Rejected root must not be installed").IsTrue();
assertions.ThatDInt(
	actual := _RootWorkflow.initializationCount,
	message := "Validation precedes hooks"
).ToBe(expected := 0);

caught := FALSE;

__TRY
	_RootWorkflow.SetRootActivity(rootActivity := _ForeignRoot);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A foreign root must be rejected").IsTrue();

_RootWorkflow.BindPlcVariable(name := 'RootValue', plcVariable := _RootValue);
_RootWorkflow.SetRootActivity(rootActivity := _AssociatedRoot);
_RootWorkflow.SetRootActivity(rootActivity := _AssociatedRoot);
assertions.ThatDInt(
	actual := _RootWorkflow.initializationCount,
	message := "Repeated assignment is a no-op"
).ToBe(expected := 1);
found := _AssociatedRoot.TryGetVariable(name := 'RootValue', variable => resolved);
assertions.ThatBool(actual := found, message := "Associated root must resolve its workflow binding").IsTrue();
assertions.ThatBool(
	actual := resolved.Address = ADR(_RootValue),
	message := "Lookup must retain the borrowed storage"
).IsTrue();

caught := FALSE;

__TRY
	_RootPeer.AddChildActivity(activity := _AssociatedRoot);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A registered root must not become a child").IsTrue();
actualElement := _AssociatedRoot.Parent;
assertions.ThatBool(
	actual := actualElement = 0,
	message := "Rejected root attachment must preserve parent"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSequenceTopology" Id="{dd172252-0707-47a8-b182-7f7e89931c3a}">
      <Declaration><![CDATA[(*
Rejects duplicate, null and cyclic slots and preserves branch-pair ordering after rejection.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testSequenceTopology
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	actualElement : TOF_Workflow.IWorkflowElement;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	argumentException : TOF_Core.IArgumentNotSpecifiedException;
	attachmentException : TOF_Workflow.IWorkflowAttachmentException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[caught := FALSE;

__TRY
	_Sequence.AddChildActivity(activity := 0);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, argumentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Null sequence child must retain its argument exception").IsTrue();
_Sequence.AddChildActivity(activity := _SequenceFirst);
caught := FALSE;

__TRY
	_Sequence.AddChildActivity(activity := _SequenceFirst);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An instance may occupy only one sequence slot").IsTrue();
_Sequence.AddChildActivity(activity := _SequenceSecond);

caught := FALSE;

__TRY
	_Ancestor.AddChildActivity(activity := _Ancestor);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Self attachment must be rejected").IsTrue();
_Ancestor.AddChildActivity(activity := _Descendant);
caught := FALSE;

__TRY
	_Descendant.AddChildActivity(activity := _Ancestor);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Ancestor attachment must be rejected").IsTrue();

_Pick.AddBranch(condition := _PickFirstCondition, activity := _PickFirstActivity);
caught := FALSE;

__TRY
	_Pick.AddBranch(condition := _PickFirstCondition, activity := _PickSecondActivity);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "A condition cannot occupy two branch slots").IsTrue();
caught := FALSE;

__TRY
	_Pick.AddBranch(condition := _PickSecondCondition, activity := _PickFirstActivity);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "An activity cannot occupy two branch slots").IsTrue();
actualElement := _PickSecondCondition.Parent;
assertions.ThatBool(
	actual := actualElement = 0,
	message := "Rejected pairs must not attach the unused condition"
).IsTrue();
actualElement := _PickSecondActivity.Parent;
assertions.ThatBool(
	actual := actualElement = 0,
	message := "Rejected pairs must not attach the unused activity"
).IsTrue();
_Pick.AddBranch(condition := _PickSecondCondition, activity := _PickSecondActivity);
_PickFirstActivity.completeRunning := TRUE;
_Pick.RequestStart();
assertions.ThatDInt(
	actual := _Pick.CurrentBranchIndex,
	message := "The original first pair must retain priority"
).ToBe(expected := 0);
assertions.ThatDInt(
	actual := _PickFirstActivity.startCount,
	message := "The first branch activity must start"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _PickSecondActivity.startCount,
	message := "The second branch must remain unstarted"
).ToBe(expected := 0);

_SequenceFirst.completeRunning := TRUE;
_SequenceSecond.completeRunning := TRUE;
_Sequence.RequestStart();
_Sequence.Execute();
assertions.ThatBool(
	actual := _Sequence.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "The original two valid slots must complete"
).IsTrue();
assertions.ThatDInt(
	actual := _SequenceFirst.startCount,
	message := "First child must start once"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _SequenceSecond.startCount,
	message := "Second child must start once"
).ToBe(expected := 1);

_Sequence.RequestReset();
_Pick.RequestReset();
assertions.ThatBool(
	actual := _Sequence.CurrentActivityIndex = TOF_Workflow.Workflows.NO_SELECTED_ACTIVITY_INDEX,
	message := "Reset sequence must expose the documented absent-selection sentinel"
).IsTrue();
assertions.ThatBool(
	actual := _Pick.CurrentBranchIndex = TOF_Workflow.Workflows.NO_SELECTED_ACTIVITY_INDEX,
	message := "Reset branch selection must expose the same absent-selection sentinel"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTaskAbortDuringSuspend" Id="{51cb9f83-b866-4ad0-b866-bd3c07c2169b}">
      <Declaration><![CDATA[(*
Preserves task internal-abort diagnostics while stopping.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testTaskAbortDuringSuspend
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SuspendAbortActivity.Configure(task := _SuspendAbortTask);
_SuspendAbortWorkflow.SetRootActivity(rootActivity := _SuspendAbortActivity);
_SuspendAbortWorkflow.RequestStart();
_SuspendAbortTask.processingResult := TOF_Tasks.TASK_PROCESSING_STATE.ABORTED;
_SuspendAbortWorkflow.RequestSuspend();
assertions.ThatBool(
	actual := _SuspendAbortActivity.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED,
	message := "An internal abort while suspending must remain HALTED"
).IsTrue();
assertions.ThatWideString(
	actual := _SuspendAbortActivity.HaltReason,
	message := "The task abort reason must survive adapter translation"
).ToBe(expected := "Controlled task internal abort");
_SuspendAbortWorkflow.RequestReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTaskCompletionDuringSuspend" Id="{61c087d0-ad3f-4074-9944-38a066a82671}">
      <Declaration><![CDATA[(*
Preserves successful task completion when work finishes during suspension.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testTaskCompletionDuringSuspend
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SuspendDoneActivity.Configure(task := _SuspendDoneTask);
_SuspendDoneWorkflow.SetRootActivity(rootActivity := _SuspendDoneActivity);
_SuspendDoneWorkflow.RequestStart();
_SuspendDoneTask.processingResult := TOF_Tasks.TASK_PROCESSING_STATE.DONE;
_SuspendDoneWorkflow.RequestSuspend();
assertions.ThatBool(
	actual := _SuspendDoneActivity.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
