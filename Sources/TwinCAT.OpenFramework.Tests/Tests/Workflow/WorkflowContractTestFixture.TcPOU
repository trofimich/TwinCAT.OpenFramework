).IsTrue();
_SuspendDoneWorkflow.RequestReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTaskFailureDuringSuspend" Id="{d4e3be94-3fa0-40cf-a203-fe128a3485be}">
      <Declaration><![CDATA[(*
Reports a task processing failure during suspension as an activity failure.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testTaskFailureDuringSuspend
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SuspendFailureActivity.Configure(task := _SuspendFailureTask);
_SuspendFailureWorkflow.SetRootActivity(rootActivity := _SuspendFailureActivity);
_SuspendFailureWorkflow.RequestStart();
_SuspendFailureTask.processingResult := TOF_Tasks.TASK_PROCESSING_STATE.ERROR;
_SuspendFailureWorkflow.RequestSuspend();

assertions.ThatBool(
	actual := _SuspendFailureTask.State.Stopped,
	message := "The failed task must reach STOPPED"
).IsTrue();
assertions.ThatBool(
	actual := _SuspendFailureActivity.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
	message := "Task failure while suspending must not be reported as SUSPENDED"
).IsTrue();
assertions.ThatBool(
	actual := _SuspendFailureWorkflow.FailError.HasError,
	message := "Failure diagnostics must be retained"
).IsTrue();
_SuspendFailureWorkflow.RequestReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTaskReleaseFailureDuringCancel" Id="{d8bd19e1-fb81-4153-aa67-873b0badd418}">
      <Declaration><![CDATA[(*
Keeps servicing cancellation through release and exposes a release failure with explicit resource recovery.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testTaskReleaseFailureDuringCancel
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationException : TOF_Workflow.IWorkflowConfigurationException;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ReleaseTask.resource := _ReleaseResource;
_ReleaseActivity.Configure(task := _ReleaseTask);
_ReleaseWorkflow.SetRootActivity(rootActivity := _ReleaseActivity);
_ReleaseWorkflow.RequestStart();

FOR i := 1 TO 8 DO
	_ReleaseWorkflow.Execute();

	IF _ReleaseResource.ResourceAcquired THEN
		EXIT;
	END_IF
END_FOR

assertions.ThatBool(
	actual := _ReleaseResource.ResourceAcquired,
	message := "Synthetic acquisition must finish before cancellation"
).IsTrue();
_ReleaseResource.ThrowOnStartRelease := TRUE;
_ReleaseWorkflow.RequestCancel(reason := "Release failure test");
caught := FALSE;

__TRY
	_ReleaseActivity.Configure(task := _ReleaseReplacement);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Resource release must still block task replacement").IsTrue();
_ReleaseWorkflow.Execute();
assertions.ThatBool(
	actual := _ReleaseActivity.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
	message := "Release failure must not become a successful cancellation"
).IsTrue();
assertions.ThatBool(
	actual := _ReleaseWorkflow.FailError.HasError,
	message := "Release failure diagnostics must remain visible"
).IsTrue();

// The synthetic manager intentionally retains ownership on failed release; recover it explicitly.
_ReleaseResource.ThrowOnStartRelease := FALSE;
_ReleaseResource.StartRelease();

FOR i := 1 TO 3 DO
	_ReleaseResource.Execute();
END_FOR

assertions.ThatBool(
	actual := _ReleaseResource.ResourceAcquired,
	message := "The test must release its synthetic resource"
).IsFalse();
_ReleaseWorkflow.RequestReset();
assertions.ThatBool(
	actual := _ReleaseActivity.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
	message := "Explicit resource recovery must permit adapter reset"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testVariableLookup" Id="{a0945ab8-8ea1-4142-a5cf-84119b851dfb}">
      <Declaration><![CDATA[(*
Resolves borrowed local and ancestor bindings and reports absence without changing storage.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testVariableLookup
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	found : BOOL;
	resolved : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LookupWorkflow.BindPlcVariable(name := 'Shared', plcVariable := _LookupWorkflowValue);
_LookupParent.BindPlcVariable(name := 'Shared', plcVariable := _LookupParentValue);
_LookupParent.AddChildActivity(activity := _LookupChild);
_LookupCondition.ParentActivity := _LookupChild;
_LookupCondition.BindPlcVariable(name := 'Local', plcVariable := _LookupConditionValue);

found := _LookupChild.TryGetVariable(name := 'Shared', variable => resolved);
assertions.ThatBool(actual := found, message := "A child must resolve its parent binding").IsTrue();
assertions.ThatBool(
	actual := resolved.Address = ADR(_LookupParentValue),
	message := "Parent binding precedes workflow fallback"
).IsTrue();
found := _LookupCondition.TryGetVariable(name := 'Shared', variable => resolved);
assertions.ThatBool(actual := found, message := "A condition must resolve its activity hierarchy").IsTrue();
assertions.ThatBool(
	actual := resolved.Address = ADR(_LookupParentValue),
	message := "Condition lookup must retain parent storage"
).IsTrue();
found := _LookupCondition.TryGetVariable(name := 'Local', variable => resolved);
assertions.ThatBool(actual := found, message := "A condition must resolve its own binding").IsTrue();
assertions.ThatBool(
	actual := resolved.Address = ADR(_LookupConditionValue),
	message := "Local lookup must retain condition storage"
).IsTrue();
found := _LookupCondition.TryGetVariable(name := 'Missing', variable => resolved);
assertions.ThatBool(actual := found, message := "Missing variables are a normal Try failure").IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testWorkflowIsolation" Id="{b23d391b-b15f-4c8c-97eb-27107f3a5ab5}">
      <Declaration><![CDATA[(*
Rejects foreign activities and conditions through every construction family.

Uses independently prepared persistent fixtures. Expected failures are checked by exception interface;
ordinary unexpected exceptions leave fixture ownership with the suite.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testWorkflowIsolation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	expectedWorkflow : TOF_Workflow.IWorkflow;
	actualElement : TOF_Workflow.IWorkflowElement;
	actualWorkflow : TOF_Workflow.IWorkflow;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	attachmentException : TOF_Workflow.IWorkflowAttachmentException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[caught := FALSE;

__TRY
	_IsolationSequence.AddChildActivity(activity := _ForeignChild);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Sequence must reject a foreign child").IsTrue();
caught := FALSE;

__TRY
	_IsolationParallel.AddChildActivity(activity := _ForeignChild);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Parallel must reject a foreign child").IsTrue();
caught := FALSE;

__TRY
	_IsolationWait.Configure(condition := _ForeignCondition);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "WaitCondition must reject a foreign condition").IsTrue();
caught := FALSE;

__TRY
	_IsolationWhile.Configure(condition := _ForeignCondition, body := 0);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "While must reject a foreign condition").IsTrue();
caught := FALSE;

__TRY
	_IsolationIf.Configure(condition := _ForeignCondition, trueActivity := 0, falseActivity := 0);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "IfElse must reject a foreign condition").IsTrue();
caught := FALSE;

__TRY
	_IsolationNot.Configure(condition := _ForeignCondition);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "Not must reject a foreign condition").IsTrue();
caught := FALSE;

__TRY
	_IsolationGroup.AddChildCondition(condition := _ForeignCondition);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(actual := caught, message := "CompositeCondition must reject a foreign condition").IsTrue();
caught := FALSE;

__TRY
	_UnassociatedSequence.AddChildActivity(activity := _ForeignChild);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, attachmentException);
__ENDTRY

assertions.ThatBool(
	actual := caught,
	message := "An unassociated subtree cannot hide an explicitly owned child"
).IsTrue();
actualElement := _ForeignChild.Parent;
assertions.ThatBool(actual := actualElement = 0, message := "Foreign activity must remain unattached").IsTrue();
actualElement := _ForeignCondition.Parent;
assertions.ThatBool(actual := actualElement = 0, message := "Foreign condition must remain unattached").IsTrue();

expectedWorkflow := _IsolationWorkflow;
_UnassociatedSequence.AddChildActivity(activity := _UnassociatedChild);
_IsolationSequence.AddChildActivity(activity := _UnassociatedSequence);
actualWorkflow := _UnassociatedChild.Workflow;
assertions.ThatBool(
	actual := actualWorkflow = expectedWorkflow,
	message := "An entirely unassociated subtree must inherit its attached parent owner"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDeclaredVariableReset" Id="{88fce0b7-1178-4ac8-8f15-1fcf2375221d}">
      <Declaration><![CDATA[(*
Checks owned values through two loop iterations, a nested condition and a workflow reset.

Advances the loop through body completion and the next iteration before checking restored values.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testDeclaredVariableReset
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	initial : UINT := 7;
	changed : UINT := 23;
	initialText : WSTRING(24) := "Start";
	workflowCount : TOF_Core.GENERIC_VALUE;
	loopCount : TOF_Core.GENERIC_VALUE;
	bodyCount : TOF_Core.GENERIC_VALUE;
	textValue : TOF_Core.GENERIC_VALUE;
	found : BOOL;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DeclarationLoop.Configure(condition := _DeclarationGuard, body := _DeclarationBody);
_DeclarationBody.completeRunning := TRUE;
_DeclarationGroup.Configure(condition := _DeclarationLeaf);
_DeclarationGroup.ParentActivity := _DeclarationBody;

_DeclarationWorkflow.DeclareVariable(name := 'Count', initialValue := initial);
_DeclarationLoop.DeclareVariable(name := 'Count', initialValue := initial);
_DeclarationBody.DeclareVariable(name := 'Count', initialValue := initial);
_DeclarationLeaf.DeclareVariable(name := 'Text', initialValue := initialText);
_DeclarationBody.BindPlcVariable(name := 'Input', plcVariable := _DeclarationInput);
_DeclarationWorkflow.SetRootActivity(rootActivity := _DeclarationLoop);
initial := 99;
initialText := "Changed";

found := _DeclarationWorkflow.TryGetVariable(name := 'Count', variable => workflowCount)
	AND_THEN _DeclarationLoop.TryGetLocalVariable(name := 'Count', variable => loopCount)
	AND_THEN _DeclarationGroup.TryGetVariable(name := 'Count', variable => bodyCount)
	AND_THEN _DeclarationLeaf.TryGetLocalVariable(name := 'Text', variable => textValue);
assertions.ThatBool(
	actual := found,
	message := "All declarations must resolve from their configured scopes"
).IsTrue();

IF found THEN
	assertions.ThatBool(
		actual := workflowCount.Address <> loopCount.Address AND_THEN loopCount.Address <> bodyCount.Address
			AND_THEN bodyCount.Address <> workflowCount.Address AND_THEN bodyCount.Address <> ADR(initial),
		message := "Equal names in separate scopes must keep independent storage"
	).IsTrue();
	assertions.ThatBool(
		actual := NOT workflowCount.IsMemoryOwner AND_THEN NOT loopCount.IsMemoryOwner
			AND_THEN NOT bodyCount.IsMemoryOwner AND_THEN NOT textValue.IsMemoryOwner,
		message := "Resolved declarations must be borrowed"
	).IsTrue();
	assertions.ThatBool(
		actual := textValue.Size = XSIZEOF(initialText) AND_THEN textValue.AsWStringReference() = "Start",
		message := "Owned strings must preserve initial contents and full declared capacity"
	).IsTrue();

	_DeclarationWorkflow.RequestStart();
	workflowCount.ChangeValueByAny(value := changed);
	loopCount.ChangeValueByAny(value := changed);
	bodyCount.ChangeValueByAny(value := changed);
	textValue.ChangeValueByAny(value := initialText);
	_DeclarationInput := changed;

	_DeclarationWorkflow.Execute();
	_DeclarationWorkflow.Execute();
	assertions.ThatBool(
		actual := _DeclarationBody.startCount = 2,
		message := "The loop must restart its body"
	).IsTrue();
	assertions.ThatBool(
		actual := bodyCount.AsUInt() = 7 AND_THEN textValue.AsWStringReference() = "Start",
		message := "Body and nested condition must restore in place between iterations"
	).IsTrue();
	assertions.ThatBool(
		actual := loopCount.AsUInt() = changed AND_THEN workflowCount.AsUInt() = changed,
		message := "Resetting the body must preserve the loop and workflow variables"
	).IsTrue();

	_DeclarationWorkflow.RequestCancel(reason := "End declaration test");

	FOR i := 1 TO 4 DO
		IF _DeclarationWorkflow.Busy THEN
			_DeclarationWorkflow.Execute();
		END_IF
	END_FOR

	_DeclarationBody.deferFirstResetStep := TRUE;
	bodyCount.ChangeValueByAny(value := changed);
	_DeclarationWorkflow.RequestReset();

	assertions.ThatBool(
		actual := _DeclarationWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING
			AND_THEN workflowCount.AsUInt() = changed AND_THEN bodyCount.AsUInt() = changed,
		message := "A pending reset must preserve current values until its owner completes"
	).IsTrue();

	FOR i := 1 TO 4 DO
		IF _DeclarationWorkflow.Busy THEN
			_DeclarationWorkflow.Execute();
		END_IF
	END_FOR

	assertions.ThatBool(
		actual := _DeclarationWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY
			AND_THEN workflowCount.AsUInt() = 7 AND_THEN loopCount.AsUInt() = 7 AND_THEN bodyCount.AsUInt() = 7,
		message := "Successful workflow reset must restore workflow and loop declarations"
	).IsTrue();
	assertions.ThatBool(
		actual := _DeclarationInput = changed,
		message := "Reset must preserve borrowed PLC storage"
	).IsTrue();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDeclaredVariableValidation" Id="{e7938411-1f9d-427d-b002-9a332b8ba8f1}">
      <Declaration><![CDATA[(*
Checks duplicate, empty and composite declarations without replacing existing local storage.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testDeclaredVariableValidation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	initial : UINT := 4;
	recordValue : TOF_Core.GENERIC_KEY_VALUE_PAIR;
	workflow : TOF_Workflow.IWorkflow;
	declarations : TOF_Workflow.IDeclaredVariableContainer;
	resolved : TOF_Core.GENERIC_VALUE;
	found : BOOL;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationError : TOF_Workflow.IWorkflowConfigurationException;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[workflow := _DeclarationValidation;
found := __QUERYINTERFACE(workflow, declarations);
assertions.ThatBool(actual := found, message := "Standard workflow must expose the declaration capability").IsTrue();

IF NOT found THEN
	RETURN;
END_IF

_DeclarationValidation.BindPlcVariable(name := 'Borrowed', plcVariable := _DeclarationInput);
declarations.DeclareVariable(name := 'Owned', initialValue := initial);

FOR i := 1 TO 5 DO
	caught := FALSE;

	__TRY
		CASE i OF
			1:
				_DeclarationValidation.DeclareVariable(name := 'Borrowed', initialValue := initial);
			2:
				_DeclarationValidation.BindPlcVariable(name := 'Owned', plcVariable := _DeclarationInput);
			3:
				_DeclarationValidation.DeclareVariable(name := 'Owned', initialValue := initial);
			4:
				_DeclarationValidation.DeclareVariable(name := '', initialValue := initial);
			5:
				_DeclarationValidation.DeclareVariable(name := 'Invalid', initialValue := recordValue);
		END_CASE
	__CATCH(exceptionCode)
		exception := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		caught := __QUERYINTERFACE(exception, configurationError);
	__ENDTRY

	assertions.ThatBool(
		actual := caught,
		message := "Each invalid declaration must raise a configuration error"
	).IsTrue();
END_FOR

found := _DeclarationValidation.TryGetVariable(name := 'Owned', variable => resolved);
assertions.ThatBool(
	actual := found AND_THEN resolved.AsUInt() = initial,
	message := "Rejected replacement preserves value"
).IsTrue();
found := _DeclarationValidation.TryGetVariable(name := 'Borrowed', variable => resolved);
assertions.ThatBool(
	actual := found AND_THEN resolved.Address = ADR(_DeclarationInput),
	message := "Borrowed binding survives"
).IsTrue();
found := _DeclarationValidation.TryGetVariable(name := 'Invalid', variable => resolved);
assertions.ThatBool(actual := found, message := "Rejected type must leave the scope unchanged").IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTransitionDiagnostics" Id="{fbcb0ede-daec-44f8-b076-0b6e0b28e502}">
      <Declaration><![CDATA[(*
Checks the diagnostic target order and the transition predicate for every lifecycle state pair.

Uses independent expected lists and passes each candidate as the compatibility argument.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testTransitionDiagnostics
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR CONSTANT
	states : ARRAY [0..9] OF TOF_Workflow.WORKFLOW_ELEMENT_STATE := [
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_HALTED,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_SUSPENDED,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_RUNNING,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_CANCELLING,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_SUSPENDING,
		TOF_Workflow.WORKFLOW_ELEMENT_STATE.ACTIVE_RESETTING
	];
	expectedNames : ARRAY [0..9] OF STRING(255) := [
		'ACTIVE_RUNNING',
		'ACTIVE_RESETTING',
		'ACTIVE_RESETTING',
		'ACTIVE_RESETTING',
		'ACTIVE_RESETTING',
		'ACTIVE_RUNNING,ACTIVE_CANCELLING',
		'PASSIVE_COMPLETED,ACTIVE_SUSPENDING,ACTIVE_CANCELLING,PASSIVE_HALTED,PASSIVE_FAILED',
		'PASSIVE_CANCELLED,PASSIVE_COMPLETED,PASSIVE_HALTED,PASSIVE_FAILED',
		'PASSIVE_SUSPENDED,PASSIVE_COMPLETED,PASSIVE_HALTED,PASSIVE_FAILED',
		'PASSIVE_READY,PASSIVE_FAILED'
	];
END_VAR
VAR
	i : DINT;
	j : DINT;
	actualNames : STRING(255);
	expectedList : STRING(255);
	targetToken : STRING;
	permitted : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(states, 1) TO UPPER_BOUND(states, 1) DO
	expectedList := TOF_Core.Strings.Concat255(',', expectedNames[i], ',');

	FOR j := LOWER_BOUND(states, 1) TO UPPER_BOUND(states, 1) DO
		actualNames := TOF_Workflow.Workflows.GetAllowedTransitionNames(currentState := states[i]);
		assertions.ThatBool(
			actual := actualNames = expectedNames[i],
			message := TO_WSTRING(TOF_Core.Strings.Concat255('Diagnostic order for ', TO_STRING(states[i])))
		).IsTrue();
		targetToken := TOF_Core.Strings.Concat255(',', TO_STRING(states[j]), ',');
		permitted := TOF_Workflow.Workflows.ValidateTransition(currentState := states[i], newState := states[j]);
		// SA0175: Exact ASCII token search within the comma-delimited diagnostic transition list.
		{analysis -175}
		assertions.ThatBool(
			actual := permitted = (Tc2_Standard.FIND(STR1 := expectedList, STR2 := targetToken) > 0),
			message := TO_WSTRING(TOF_Core.Strings.Concat255('Transition from ', TO_STRING(states[i]), ' to ', TO_STRING(states[j])))
		).IsTrue();
		{analysis +175}
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateElement" Id="{b350a52f-ef28-4138-84f4-fe6c914ab79a}">
      <Declaration><![CDATA[(*
Provides the application-specific test activity to the workflow factory.

Returns zero for unknown names. The suite owns the disposal counter until the registered child exits.
typeName — Requested type.
workflow — Prospective owner.
*)
METHOD CreateElement : TOF_Workflow.IWorkflowElement
VAR_INPUT
	typeName : STRING(255);
	workflow : TOF_Workflow.IWorkflow;
END_VAR
VAR
	created : POINTER TO WorkflowContractActivity;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF typeName <> TOF_Core.Strings.Concat255(CurrentNamespace.Name, '.WorkflowContractActivity') THEN
	RETURN;
END_IF

created := __NEW(WorkflowContractActivity(workflow := workflow));

IF created = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

created^.exitCount REF= _FactoryExits;
created^.completeRunning := TRUE;
CreateElement := created^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="testFactoryDeclarations" Id="{96c2d6be-c9ed-4710-b132-79636718eda7}">
      <Declaration><![CDATA[(*
Builds a mixed factory tree and observes array declaration, mutation, reset and disposal.

Uses persistent workflow ownership and synthetic values in one task.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testFactoryDeclarations
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	element : TOF_Workflow.IWorkflowElement;
	sequence : TOF_Workflow.ISequenceActivity;
	child : TOF_Workflow.IActivity;
	scope : TOF_Workflow.IDeclaredVariableContainer;
	binder : TOF_Workflow.IVariableBinder;
	initials : ARRAY [3..4] OF __SYSTEM.AnyType;
	firstValue : BYTE := BYTE#2;
	secondValue : BYTE := BYTE#5;
	initialCopy : BYTE;
	position : DINT;
	declarationCount : DINT;
	bindingName : STRING;
	declaration : TOF_Workflow.VARIABLE_DECLARATION;
	live : TOF_Core.GENERIC_VALUE;
	found : BOOL;
	ready : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	element := TOF_Workflow.Workflows.CreateElement(
		typeName := 'TOF_Workflow.SequenceActivity',
		workflow := _FactoryWorkflow
	);
	ready := __QUERYINTERFACE(element, sequence);
	element := TOF_Workflow.Workflows.CreateElement(
		typeName := TOF_Core.Strings.Concat255(CurrentNamespace.Name, '.WorkflowContractActivity'),
		workflow := _FactoryWorkflow,
		factory := THIS^
	);
	ready := ready
		AND_THEN __QUERYINTERFACE(element, child)
		AND_THEN __QUERYINTERFACE(element, scope)
		AND_THEN __QUERYINTERFACE(element, binder);
	assertions.ThatBool(
		actual := ready,
		message := "Built-in and custom factories must return the requested node capabilities"
	).IsTrue();

	IF ready THEN
		sequence.AddChildActivity(activity := child);
		_FactoryWorkflow.SetRootActivity(rootActivity := sequence);
		binder.BindPlcVariable(name := 'Input', plcVariable := _DeclarationInput);
		initials[3] := TOF_Workflow.Workflows.GetValueDescriptor(value := firstValue);
		initials[4] := TOF_Workflow.Workflows.GetValueDescriptor(value := secondValue);
		scope.DeclareArray(name := 'Limits', initialValues := ADR(initials[3]), elementCount := 2);
		scope.DeclareVariable(name := 'Flags', initialValue := firstValue);
		firstValue := BYTE#255;
		found := FALSE;

		WHILE scope.ReadNextDeclaration(position := position, name => bindingName, declaration => declaration) DO
			declarationCount := declarationCount + 1;
			assertions.ThatBool(
				actual := declaration.ElementType = __SYSTEM.TYPE_CLASS.TYPE_BYTE AND_THEN declaration.ElementSize = 1,
				message := "BYTE must preserve its exact IEC type"
			).IsTrue();

			IF bindingName = 'Limits' THEN
				found := declaration.IsArray AND_THEN declaration.ElementCount = 2;
			ELSE
				assertions.ThatBool(
					actual := bindingName = 'Flags' AND_THEN NOT declaration.IsArray AND_THEN declaration.ElementCount = 1,
					message := "Only local declarations must be enumerated"
				).IsTrue();
			END_IF
		END_WHILE

		assertions.ThatBool(
			actual := found AND_THEN declarationCount = 2,
			message := "Enumeration must include the array and scalar"
		).IsTrue();
		live := scope.GetDeclaredElement(name := 'Limits', index := 1);
		live.ChangeValueByAny(value := firstValue);
		scope.CopyInitialElement(
			name := 'Limits',
			index := 1,
			destination := TOF_Workflow.Workflows.GetValueDescriptor(value := initialCopy)
		);
		assertions.ThatBool(
			actual := initialCopy = BYTE#5 AND_THEN live.AsByte() = BYTE#255 AND_THEN NOT live.IsMemoryOwner,
			message := "Initial value and writable current element must be independent"
		).IsTrue();
		_FactoryWorkflow.RequestStart();
		_FactoryWorkflow.RequestReset();
		assertions.ThatBool(
			actual := live.AsByte() = BYTE#5,
			message := "Workflow reset must restore an owned array in place"
		).IsTrue();
		live := scope.GetDeclaredElement(name := 'Limits', index := 0);
		assertions.ThatBool(
			actual := live.AsByte() = BYTE#2,
			message := "Source bounds must map to zero-based declaration indices"
		).IsTrue();
	END_IF
__CATCH
	assertions.ThatBool(
		actual := FALSE,
		message := "Unexpected exception while building or exercising factory graph"
	).IsTrue();
__ENDTRY

_FactoryWorkflow.DisposeDynamicChildren();
TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
assertions.ThatBool(
	actual := _FactoryExits = 1,
	message := "Workflow disposal must invoke the custom child destructor once"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testArrayValidation" Id="{c0b67d55-8aff-4a4a-b740-76f409bc9946}">
      <Declaration><![CDATA[(*
Checks singleton shape and rejects invalid declarations, indices, destinations and unknown factory types.

Uses persistent workflow ownership and synthetic values in one task.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testArrayValidation
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	single : ARRAY [0..0] OF __SYSTEM.AnyType;
	mixed : ARRAY [0..1] OF __SYSTEM.AnyType;
	flag : BYTE := BYTE#1;
	number : USINT := USINT#42;
	element : TOF_Core.GENERIC_VALUE;
	node : TOF_Workflow.IWorkflowElement;
	position : DINT;
	bindingName : STRING;
	declaration : TOF_Workflow.VARIABLE_DECLARATION;
	more : BOOL;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationError : TOF_Workflow.IWorkflowConfigurationException;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[single[0] := TOF_Workflow.Workflows.GetValueDescriptor(value := flag);
_ArrayValidation.DeclareArray(name := 'One', initialValues := ADR(single[0]), elementCount := 1);
more := _ArrayValidation.ReadNextDeclaration(position := position, name => bindingName, declaration => declaration);
assertions.ThatBool(
	actual := more AND_THEN declaration.IsArray AND_THEN declaration.ElementCount = 1,
	message := "A one-element array must preserve its shape"
).IsTrue();
mixed[0] := single[0];
mixed[1] := TOF_Workflow.Workflows.GetValueDescriptor(value := number);

FOR i := 1 TO 7 DO
	caught := FALSE;

	__TRY
		CASE i OF
			1:
				_ArrayValidation.DeclareArray(name := 'Bad', initialValues := ADR(mixed[0]), elementCount := 2);
			2:
				_ArrayValidation.DeclareArray(name := 'Bad', initialValues := 0, elementCount := 0);
			3:
				element := _ArrayValidation.GetDeclaredElement(name := 'One', index := -1);
			4:
				element := _ArrayValidation.GetDeclaredElement(name := 'One', index := 1);
			5:
				_ArrayValidation.CopyInitialElement(
					name := 'One',
					index := 0,
					destination := TOF_Workflow.Workflows.GetValueDescriptor(value := number)
				);
			6:
				node := TOF_Workflow.Workflows.CreateElement(
					typeName := 'Missing.Type',
					workflow := _ArrayValidation,
					factory := THIS^
				);
			7:
				_ArrayValidation.DeclareVariable(name := 'One', initialValue := number);
		END_CASE
	__CATCH(exceptionCode)
		exception := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		caught := __QUERYINTERFACE(exception, configurationError);
	__ENDTRY

	assertions.ThatBool(
		actual := caught,
		message := "Invalid declaration, element access or factory name must raise"
	).IsTrue();
END_FOR

more := _ArrayValidation.ReadNextDeclaration(position := position, name => bindingName, declaration => declaration);
assertions.ThatBool(actual := more, message := "Invalid definitions must not add dictionary entries").IsFalse();
assertions.ThatBool(
	actual := number = USINT#42,
	message := "Incorrect destination type must leave its bytes unchanged"
).IsTrue();
_ArrayValidation.DisposeDynamicChildren();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testWriteConfiguration" Id="{c20c2bfa-8c1e-4a82-a125-8f08bdad54b0}">
      <Declaration><![CDATA[(*
Checks nested workflow serialization and the shape of a singleton array.

Parses the actual output and checks the original value after modifying the live declaration.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testWriteConfiguration
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	initial : UINT := 5;
	element : __SYSTEM.AnyType;
	live : TOF_Core.GENERIC_VALUE;
	number : POINTER TO UINT;
	document : Tc3_JsonXml.SJsonValue;
	field : Tc3_JsonXml.SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_WriteSequence.AddChildActivity(activity := _WriteDelay);
_WriteWorkflow.SetRootActivity(rootActivity := _WriteSequence);
element := TOF_Workflow.Workflows.GetValueDescriptor(value := initial);
_WriteDelay.DeclareArray(name := 'Limits', initialValues := ADR(element), elementCount := 1);
live := _WriteDelay.GetDeclaredElement(name := 'Limits', index := 0);
number := live.Address;
number^ := 9;
_ConfigWriter.Serialize(source := _WriteWorkflow, document := _ConfigDocument);
document := _ConfigParser.ParseDocument(sJson := _ConfigDocument);
field := _ConfigParser.FindMember(v := document, member := 'root');
field := _ConfigParser.FindMember(v := field, member := 'children');
assertions.ThatBool(
	actual := _ConfigParser.IsArray(v := field),
	message := "Sequence children must be an array"
).IsTrue();
field := _ConfigParser.GetArrayValueByIdx(v := field, idx := 0);
field := _ConfigParser.FindMember(v := field, member := 'variables');
field := _ConfigParser.GetArrayValueByIdx(v := field, idx := 0);
field := _ConfigParser.FindMember(v := field, member := 'initialValue');
assertions.ThatBool(
	actual := _ConfigParser.GetArraySize(v := field) = 1,
	message := "Preserve singleton array shape"
).IsTrue();
field := _ConfigParser.GetArrayValueByIdx(v := field, idx := 0);
assertions.ThatBool(
	actual := _ConfigParser.GetUint(v := field) = 5,
	message := "Serialize the reset image"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDependencyBindings" Id="{4f68a902-c396-448e-8518-ecdb48a31599}">
      <Declaration><![CDATA[(*
Checks exclusive embedded ownership and shared external serialization.

Uses a dual-interface object to verify that duplicate detection uses object identity.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testDependencyBindings
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	instance : POINTER TO WorkflowBindingTask;
	otherInstance : POINTER TO WorkflowBindingTask;
	expectedComparer : TOF_Core.IComparer;
	actualComparer : TOF_Core.IComparer;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationError : TOF_Workflow.IWorkflowConfigurationException;
	rejected : BOOL;
	document : Tc3_JsonXml.SJsonValue;
	binding : Tc3_JsonXml.SJsonValue;
	keyField : Tc3_JsonXml.SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BindingFirst.ConfigureExternalTask(task := _BindingExternal, key := 'axis');
_BindingSecond.ConfigureExternalTask(task := _BindingExternal, key := 'axis');
_BindingComparer.ConfigureExternalComparer(comparer := _BindingExternal, key := 'axis');
_ConfigWriter.Serialize(source := _BindingSecond, document := _ConfigDocument);
document := _ConfigParser.ParseDocument(sJson := _ConfigDocument);
binding := _ConfigParser.FindMember(v := document, member := 'task');
keyField := _ConfigParser.FindMember(v := binding, member := 'key');
assertions.ThatBool(
	actual := _ConfigParser.GetString(v := keyField) = 'axis',
	message := "Keep the external key"
).IsTrue();
assertions.ThatBool(
	actual := _ConfigParser.FindMember(v := binding, member := 'type') = 0,
	message := "External task is borrowed"
).IsTrue();

instance := __NEW(WorkflowBindingTask(name := "Embedded"));

IF instance = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

_BindingFirst.ConfigureEmbeddedTask(task := instance^);

__TRY
	_BindingComparer.ConfigureEmbeddedComparer(comparer := instance^);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	rejected := __QUERYINTERFACE(exception, configurationError);
__ENDTRY

expectedComparer := _BindingExternal;
assertions.ThatBool(actual := rejected, message := "Reject second slot even through another interface").IsTrue();
actualComparer := _BindingComparer.Comparer;
assertions.ThatBool(
	actual := actualComparer = expectedComparer,
	message := "Keep previous external comparer"
).IsTrue();

otherInstance := __NEW(WorkflowBindingTask(name := "Another instance"));

IF otherInstance = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

_BindingComparer.ConfigureEmbeddedComparer(comparer := otherInstance^);
expectedComparer := otherInstance^;
actualComparer := _BindingComparer.Comparer;
assertions.ThatBool(
	actual := actualComparer = expectedComparer,
	message := "Allow another instance of the same type"
).IsTrue();

_ConfigWriter.Serialize(source := _BindingFirst, document := _ConfigDocument);
document := _ConfigParser.ParseDocument(sJson := _ConfigDocument);
binding := _ConfigParser.FindMember(v := document, member := 'task');
assertions.ThatBool(
	actual := _ConfigParser.FindMember(v := binding, member := 'configuration') <> 0,
	message := "Embed configuration"
).IsTrue();
assertions.ThatBool(
	actual := _ConfigParser.FindMember(v := binding, member := 'key') = 0,
	message := "Embedded task has no key"
).IsTrue();
_BindingWorkflow.DisposeDynamicChildren();]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateDependency" Id="{e8bcc63f-b77a-44fc-a5cf-2712acf9b5ce}">
      <Declaration><![CDATA[(*
Creates a fresh unowned dynamic embedded dependency for configuration loading.

Returns zero for unknown type names.
typeName — Requested qualified type name.
*)
METHOD CreateDependency : TOF_Core.IObject
VAR_INPUT
	typeName : STRING(255);
END_VAR
VAR
	created : POINTER TO WorkflowBindingTask;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF typeName <> TOF_Core.Strings.Concat255(CurrentNamespace.Name, '.WorkflowBindingTask') THEN
	RETURN;
END_IF

created := __NEW(WorkflowBindingTask(name := ""));

IF created = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

CreateDependency := created^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResolveExternal" Id="{486c7ba3-eb9c-4d1e-90f9-49250a5b16d2}">
      <Declaration><![CDATA[(*
Resolves the shared external test dependency by its stable key.

Returns zero for unknown keys.
key — Requested external dependency key.
*)
METHOD ResolveExternal : TOF_Core.IObject
VAR_INPUT
	key : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF key = 'axis' THEN
	ResolveExternal := _BindingExternal;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindVariables" Id="{2256e760-cfa4-4f34-be80-fcd785ebbc1e}">
      <Declaration><![CDATA[(*
Registers the external PLC variable on the freshly loaded workflow when enabled.

Used to test both unresolved-variable rollback and successful binding.
workflow — Fresh workflow being loaded.
*)
METHOD BindVariables
VAR_INPUT
	workflow : TOF_Workflow.IWorkflow;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _BindLoadVariables THEN
	workflow.BindPlcVariable(name := 'External', plcVariable := _LoadExternal);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="testLoadConfiguration" Id="{846b9dc0-e206-4ab5-b87c-42169368526e}">
      <Declaration><![CDATA[(*
Checks workflow round-trip deserialization, rollback on missing PLC bindings, execution and reset.

Exercises embedded and external dependencies, activity and condition declarations, and dynamic disposal.
Reports a failed bound load before fixture cleanup and test completion.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testLoadConfiguration
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	initialStep : UINT := 3;
	firstLimit : UINT := 4;
	secondLimit : UINT := 8;
	mutated : UINT := 77;
	limits : ARRAY [0..1] OF __SYSTEM.AnyType;
	embeddedTask : POINTER TO WorkflowBindingTask;
	embeddedComparer : POINTER TO WorkflowBindingTask;
	ifElse : TOF_Workflow.IIfElseActivity;
	rootScope : TOF_Workflow.IDeclaredVariableContainer;
	conditionScope : TOF_Workflow.IDeclaredVariableContainer;
	localStep : TOF_Core.GENERIC_VALUE;
	limitElement : TOF_Core.GENERIC_VALUE;
	thresholdElement : TOF_Core.GENERIC_VALUE;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationError : TOF_Workflow.IWorkflowConfigurationException;
	caught : BOOL;
	ready : BOOL;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LoadSource.DeclareVariable(name := 'Step', initialValue := initialStep);
_LoadSource.BindPlcVariable(name := 'External', plcVariable := _LoadExternal);
limits[0] := TOF_Workflow.Workflows.GetValueDescriptor(value := firstLimit);
limits[1] := TOF_Workflow.Workflows.GetValueDescriptor(value := secondLimit);
_LoadIf.DeclareArray(name := 'Limits', initialValues := ADR(limits[0]), elementCount := 2);
_LoadIf.DeclareVariable(name := 'LocalStep', initialValue := initialStep);

_LoadCompare.DeclareVariable(name := 'Threshold', initialValue := initialStep);
_LoadCompare.ConfigureVariable(
	firstVariableName := 'LocalStep',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.EQUAL,
	secondVariableName := 'Threshold'
);
embeddedComparer := __NEW(WorkflowBindingTask(name := "Embedded comparer"));

IF embeddedComparer = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

_LoadCompare.ConfigureEmbeddedComparer(comparer := embeddedComparer^);
embeddedTask := __NEW(WorkflowBindingTask(name := "Embedded task"));

IF embeddedTask = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

_LoadEmbeddedInvoke.ConfigureEmbeddedTask(task := embeddedTask^);
_LoadExternalInvoke.ConfigureExternalTask(task := _BindingExternal, key := 'axis');
_LoadAssign.ConfigureFromVariable(targetVariableName := 'LocalStep', sourceVariableName := 'External');

_LoadSequence.AddChildActivity(activity := _LoadEmbeddedInvoke);
_LoadSequence.AddChildActivity(activity := _LoadExternalInvoke);
_LoadSequence.AddChildActivity(activity := _LoadAssign);
_LoadIf.Configure(condition := _LoadCompare, trueActivity := _LoadSequence, falseActivity := 0);
_LoadSource.SetRootActivity(rootActivity := _LoadIf);

_ConfigWriter.Serialize(source := _LoadSource, document := _ConfigDocument);
_BindLoadVariables := FALSE;

__TRY
	_Loaded := _LoadLoader.Load(
		reader := _LoadReader,
		root := _LoadReader.Parse(document := _ConfigDocument),
		factory := THIS^,
		dependencyFactory := THIS^,
		resolver := THIS^,
		binder := THIS^
	);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := exception <> 0 AND_THEN __QUERYINTERFACE(exception, configurationError);
__ENDTRY

IF NOT caught AND_THEN exception <> 0 THEN
	assertions.ThatBool(
		actual := FALSE,
		message := TO_WSTRING(TOF_Core.Strings.Concat255('Unbound workflow load: ', TO_STRING(exception.GetMessage())))
	).IsTrue();
ELSE
	assertions.ThatBool(
		actual := caught AND_THEN _Loaded = 0,
		message := "Unresolved required PLC variable must abort and roll back load"
	).IsTrue();
END_IF

IF _Loaded <> 0 THEN
	assertions.ThatBool(
		actual := TryReleaseLoadedWorkflow(),
		message := "Release any unexpected workflow after the unbound load"
	).IsTrue();
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

_BindLoadVariables := TRUE;
_LoadExternal := 11;
caught := FALSE;
__TRY
	_Loaded := _LoadLoader.Load(
		reader := _LoadReader,
		root := _LoadReader.Parse(document := _ConfigDocument),
		factory := THIS^,
		dependencyFactory := THIS^,
		resolver := THIS^,
		binder := THIS^
	);
__CATCH(exceptionCode)
	caught := TRUE;
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);

	IF exception <> 0 THEN
		assertions.ThatBool(
			actual := FALSE,
			message := TO_WSTRING(TOF_Core.Strings.Concat255('Bound workflow load: ', TO_STRING(exception.GetMessage())))
		).IsTrue();
	ELSE
		assertions.ThatBool(
			actual := FALSE,
			message := TO_WSTRING(TOF_Core.Strings.Concat255('Bound workflow load raised PLC exception ', TO_STRING(exceptionCode)))
		).IsTrue();
	END_IF
__ENDTRY

IF NOT caught THEN
	assertions.ThatBool(
		actual := _Loaded <> 0 AND_THEN _Loaded.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		message := "Loaded workflow must be ready without auto-starting"
	).IsTrue();
END_IF

IF _Loaded <> 0 THEN
	_Loaded.RequestStart();

	FOR i := 1 TO 6 DO
		IF _Loaded.Busy THEN
			_Loaded.Execute();
		END_IF
	END_FOR

	assertions.ThatBool(
		actual := _Loaded.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		message := "Loaded workflow must execute embedded and external tasks and branch assignment"
	).IsTrue();

	ready := __QUERYINTERFACE(_Loaded.RootActivity, ifElse)
		AND_THEN __QUERYINTERFACE(_Loaded.RootActivity, rootScope)
		AND_THEN __QUERYINTERFACE(ifElse.Condition, conditionScope);
	assertions.ThatBool(
		actual := ready,
		message := "Loaded root and condition must expose declaration containers"
	).IsTrue();

	IF ready THEN
		localStep := rootScope.GetDeclaredElement(name := 'LocalStep', index := 0);
		limitElement := rootScope.GetDeclaredElement(name := 'Limits', index := 1);
		thresholdElement := conditionScope.GetDeclaredElement(name := 'Threshold', index := 0);
		assertions.ThatBool(
			actual := localStep.AsUInt() = 11 AND_THEN limitElement.AsUInt() = 8 AND_THEN thresholdElement.AsUInt() = 3,
			message := "Loaded execution must update target declaration and preserve array and condition values"
		).IsTrue();

		limitElement.ChangeValueByAny(value := mutated);
		thresholdElement.ChangeValueByAny(value := mutated);
		_Loaded.RequestReset();

		assertions.ThatBool(
			actual := _Loaded.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY
				AND_THEN localStep.AsUInt() = 3
				AND_THEN limitElement.AsUInt() = 8
				AND_THEN thresholdElement.AsUInt() = 3,
			message := "Resetting a loaded workflow must restore activity and condition declarations in place"
		).IsTrue();
	END_IF

	assertions.ThatBool(
		actual := TryReleaseLoadedWorkflow(),
		message := "Release the dynamically loaded workflow"
	).IsTrue();
END_IF

_LoadSource.DisposeDynamicChildren();
TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDeserializeNullContextRejection" Id="{f28d6d68-5863-49f9-9dc3-cdffc37a855f}">
      <Declaration><![CDATA[(*
Verifies that workflow element deserialization rejects null context and context-free succeeds.

A workflow element requiring a loader raises WorkflowConfiguration when deserialized with context = 0.
A context-free element (DelayActivity) succeeds when deserialized with context = 0.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testDeserializeNullContextRejection
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	workflowNode : TOF_Core.CONFIGURATION_NODE;
	delayNode : TOF_Core.CONFIGURATION_NODE;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationError : TOF_Workflow.IWorkflowConfigurationException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ConfigWriter.Serialize(source := _NullContextSequence, document := _ConfigDocument);
workflowNode := _LoadReader.Parse(document := _ConfigDocument);

caught := FALSE;
__TRY
	_NullContextSequence.Deserialize(reader := _LoadReader, node := workflowNode, context := 0);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationError);
__ENDTRY

assertions.ThatBool(
	actual := caught,
	message := "Workflow element requiring loader must reject null deserialization context"
).IsTrue();

_NullContextDelay.Interval := T#5S;
_ConfigWriter.Serialize(source := _NullContextDelay, document := _ConfigDocument);
delayNode := _LoadReader.Parse(document := _ConfigDocument);

caught := FALSE;
__TRY
	_NullContextDelay.Deserialize(reader := _LoadReader, node := delayNode, context := 0);
__CATCH(exceptionCode)
	caught := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := caught,
	message := "Context-free workflow element must succeed with null deserialization context"
).IsFalse();
assertions.ThatTime(
	actual := _NullContextDelay.Interval,
	message := "Delay interval must be restored"
).ToBe(expected := T#5S);

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOperatorSerialization" Id="{76631bbb-6383-45e4-a2fc-c6d60459c699}">
      <Declaration><![CDATA[(*
Verifies formatting and parsing of logical and comparison operators.
assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testOperatorSerialization
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configurationError : TOF_Workflow.IWorkflowConfigurationException;
	parsedComp : TOF_Workflow.COMPARISON_OPERATOR;
	parsedLog : TOF_Workflow.LOGICAL_OPERATOR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Format comparison operators
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatComparisonOperator(comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.EQUAL),
	message := "Format EQUAL"
).ToBe(expected := '=');
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatComparisonOperator(comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.NOT_EQUAL),
	message := "Format NOT_EQUAL"
).ToBe(expected := '<>');
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatComparisonOperator(comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN),
	message := "Format LESS_THAN"
).ToBe(expected := '<');
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatComparisonOperator(comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN_OR_EQUAL),
	message := "Format LESS_THAN_OR_EQUAL"
).ToBe(expected := '<=');
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatComparisonOperator(comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN),
	message := "Format GREATER_THAN"
).ToBe(expected := '>');
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatComparisonOperator(comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL),
	message := "Format GREATER_THAN_OR_EQUAL"
).ToBe(expected := '>=');

// Parse comparison operators and synonyms
parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '=');
assertions.ThatBool(actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.EQUAL, message := "Parse =").IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '==');
assertions.ThatBool(actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.EQUAL, message := "Parse ==").IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '<>');
assertions.ThatBool(
	actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.NOT_EQUAL,
	message := "Parse <>"
).IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '!=');
assertions.ThatBool(
	actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.NOT_EQUAL,
	message := "Parse !="
).IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '<');
assertions.ThatBool(
	actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN,
	message := "Parse <"
).IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '<=');
assertions.ThatBool(
	actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN_OR_EQUAL,
	message := "Parse <="
).IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '>');
assertions.ThatBool(
	actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN,
	message := "Parse >"
).IsTrue();

parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := '>=');
assertions.ThatBool(
	actual := parsedComp = TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL,
	message := "Parse >="
).IsTrue();

// Invalid comparison operator
caught := FALSE;
__TRY
	parsedComp := TOF_Workflow.Workflows.ParseComparisonOperator(rawOperator := 'INVALID');
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationError);
__ENDTRY
assertions.ThatBool(actual := caught, message := "Unknown comparison operator must raise").IsTrue();

// Format logical operators
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatLogicalOperator(logicalOperator := TOF_Workflow.LOGICAL_OPERATOR.AND_),
	message := "Format AND_"
).ToBe(expected := 'AND');
assertions.ThatString(
	actual := TOF_Workflow.Workflows.FormatLogicalOperator(logicalOperator := TOF_Workflow.LOGICAL_OPERATOR.OR_),
	message := "Format OR_"
).ToBe(expected := 'OR');

// Parse logical operators
parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'AND');
assertions.ThatBool(actual := parsedLog = TOF_Workflow.LOGICAL_OPERATOR.AND_, message := "Parse AND").IsTrue();

parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'and');
assertions.ThatBool(
	actual := parsedLog = TOF_Workflow.LOGICAL_OPERATOR.AND_,
	message := "Parse and lowercase"
).IsTrue();

parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'AND_');
assertions.ThatBool(actual := parsedLog = TOF_Workflow.LOGICAL_OPERATOR.AND_, message := "Parse AND_").IsTrue();

parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'OR');
assertions.ThatBool(actual := parsedLog = TOF_Workflow.LOGICAL_OPERATOR.OR_, message := "Parse OR").IsTrue();

parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'or');
assertions.ThatBool(
	actual := parsedLog = TOF_Workflow.LOGICAL_OPERATOR.OR_,
	message := "Parse or lowercase"
).IsTrue();

parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'OR_');
assertions.ThatBool(actual := parsedLog = TOF_Workflow.LOGICAL_OPERATOR.OR_, message := "Parse OR_").IsTrue();

// Invalid logical operator
caught := FALSE;
__TRY
	parsedLog := TOF_Workflow.Workflows.ParseLogicalOperator(rawOperator := 'XOR');
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := __QUERYINTERFACE(exception, configurationError);
__ENDTRY
assertions.ThatBool(actual := caught, message := "Unknown logical operator must raise").IsTrue();

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryReleaseLoadedWorkflow" Id="{e3970f7b-166e-4eae-afff-a7fa7068e7d1}">
      <Declaration><![CDATA[(*
Attempts to release the owned result of a configuration load.

Clears the stored alias before release. Succeeds if no workflow is owned.
*)
METHOD TryReleaseLoadedWorkflow : BOOL
VAR
	instance : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Loaded = 0 THEN
	TryReleaseLoadedWorkflow := TRUE;

	RETURN;
END_IF

instance := _Loaded;
_Loaded := 0;
TryReleaseLoadedWorkflow := TOF_Core.Memory.TryReleaseDynamicObject(instance := instance);]]></ST>
      </Implementation>
    </Method>
    <Method Name="assertReentrantFailure" Id="{3577500b-373a-485b-9c34-a605bf9b80a9}">
      <Declaration><![CDATA[(*
Runs one reentrant OnConfigure scenario and verifies latching into PASSIVE_FAILED.

assertions — Valid assertion context borrowed from the active case.
workflow — Fresh self-configuring workflow fixture under test.
mode — Reentrant call mode injected inside OnConfigure.
triggerViaStart — TRUE to initiate configuration via RequestStart, FALSE via Execute.
label — Diagnostic label identifying the reentrant method under test.
*)
METHOD PRIVATE assertReentrantFailure
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
	workflow : REFERENCE TO StaticConfigurationTestWorkflow;
	mode : STATIC_WORKFLOW_TEST_MODE;
	triggerViaStart : BOOL;
	label : WSTRING;
END_VAR
VAR
	escaped : BOOL;
	started : BOOL;
	actualRoot : TOF_Workflow.IActivity;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[workflow.mode := mode;

IF triggerViaStart THEN
	__TRY
		started := workflow.RequestStart();
	__CATCH
		escaped := TRUE;
	__ENDTRY

	assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255(label, ": RequestStart must contain reentrancy failure")
	).IsFalse();
	assertions.ThatBool(
		actual := started,
		message := TOF_Core.WideStrings.Concat255(label, ": RequestStart must return FALSE on reentrancy failure")
	).IsFalse();
ELSE
	__TRY
		workflow.Execute();
	__CATCH
		escaped := TRUE;
	__ENDTRY

	assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255(label, ": Execute must contain reentrancy failure")
	).IsFalse();
END_IF

actualRoot := workflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot = 0,
	message := TOF_Core.WideStrings.Concat255(label, ": failed OnConfigure must clear RootActivity")
).IsTrue();
assertions.ThatBool(
	actual := workflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
	message := TOF_Core.WideStrings.Concat255(label, ": reentrant failure must latch PASSIVE_FAILED")
).IsTrue();
assertions.ThatBool(
	actual := workflow.FailError.HasError,
	message := TOF_Core.WideStrings.Concat255(label, ": FailError must capture reentrant failure")
).IsTrue();
assertions.ThatBool(
	actual := workflow.reentrantConfigExceptionCaught,
	message := TOF_Core.WideStrings.Concat255(label, ": reentrancy guard must throw WorkflowConfigurationException")
).IsTrue();
assertions.ThatBool(
	actual := workflow.StartingAllowed,
	message := TOF_Core.WideStrings.Concat255(label, ": StartingAllowed must be FALSE after failure")
).IsFalse();
assertions.ThatBool(
	actual := workflow.ResettingAllowed,
	message := TOF_Core.WideStrings.Concat255(label, ": ResettingAllowed must be FALSE after failure")
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStaticSelfConfigurationViaExecute" Id="{df74ad8d-4db5-46ce-8cc7-c966d535cc6f}">
      <Declaration><![CDATA[(*
Checks one-shot OnConfigure from Execute, variable initialization, completion, reset and repeat execution.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testStaticSelfConfigurationViaExecute
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	actualRoot : TOF_Workflow.IActivity;
	delayWorkflow : TOF_Workflow.IWorkflow;
	counterValue : TOF_Core.GENERIC_VALUE;
	plcSignalValue : TOF_Core.GENERIC_VALUE;
	found : BOOL;
	started : BOOL;
	resetAccepted : BOOL;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[actualRoot := _StaticExecuteWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot = 0,
	message := "Unconfigured workflow must have RootActivity = 0 before first Execute"
).IsTrue();
assertions.ThatBool(
	actual := _StaticExecuteWorkflow.StartingAllowed,
	message := "StartingAllowed must be FALSE before configuration"
).IsFalse();
assertions.ThatBool(
	actual := _StaticExecuteWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
	message := "Unconfigured workflow must report PASSIVE_READY"
).IsTrue();
assertions.ThatDInt(
	actual := _StaticExecuteWorkflow.configureCount,
	message := "OnConfigure must not run during FB_init"
).ToBe(expected := 0);

_StaticExecuteWorkflow.Execute();
assertions.ThatDInt(
	actual := _StaticExecuteWorkflow.configureCount,
	message := "First Execute must invoke OnConfigure once"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _StaticExecuteWorkflow.configureCountAtFirstBefore,
	message := "OnConfigure must run before OnBeforeRootActivityExecute"
).ToBe(expected := 1);
assertions.ThatBool(
	actual := _StaticExecuteWorkflow.rootAssignedAtFirstBefore,
	message := "RootActivity must already be set when OnBeforeRootActivityExecute runs"
).IsTrue();
assertions.ThatDInt(
	actual := _StaticExecuteWorkflow.initializationCount,
	message := "SetRootActivity inside OnConfigure must invoke InitializeVariables once"
).ToBe(expected := 1);

actualRoot := _StaticExecuteWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot <> 0,
	message := "First Execute must install RootActivity via OnConfigure"
).IsTrue();
assertions.ThatBool(
	actual := _StaticExecuteWorkflow.StartingAllowed,
	message := "StartingAllowed must become TRUE after OnConfigure sets the root"
).IsTrue();

delayWorkflow := _StaticExecuteWorkflow.DelayWorkflow;
assertions.ThatBool(
	actual := delayWorkflow <> 0 AND_THEN delayWorkflow.SelfAddress = _StaticExecuteWorkflow.SelfAddress,
	message := "Static child initialized with workflow := 0 must inherit workflow on attachment"
).IsTrue();

counterValue := _StaticExecuteWorkflow.GetDeclaredElement(name := 'StepCounter', index := 0);
assertions.ThatDInt(
	actual := counterValue.AsDInt(),
	message := "Declared variable must keep its initial value before execution"
).ToBe(expected := 10);

found := _StaticExecuteWorkflow.TryGetVariable(name := 'PlcSignal', variable => plcSignalValue);
assertions.ThatBool(actual := found, message := "InitializeVariables binding must be resolvable").IsTrue();
assertions.ThatDInt(
	actual := plcSignalValue.AsDInt(),
	message := "Bound PLC signal must match fixture initial value"
).ToBe(expected := 7);

started := _StaticExecuteWorkflow.RequestStart();
assertions.ThatBool(actual := started, message := "RequestStart must succeed after Execute configuration").IsTrue();

FOR i := 1 TO 4 DO
	IF _StaticExecuteWorkflow.Busy THEN
		_StaticExecuteWorkflow.Execute();
	END_IF
END_FOR

assertions.ThatBool(
	actual := _StaticExecuteWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "Self-configured workflow must complete execution"
).IsTrue();
assertions.ThatDInt(
	actual := counterValue.AsDInt(),
	message := "Assign step must update declared variable"
).ToBe(expected := 42);
assertions.ThatDInt(
	actual := _StaticExecuteWorkflow.configureCount,
	message := "Execution scans must not re-invoke OnConfigure"
).ToBe(expected := 1);

resetAccepted := _StaticExecuteWorkflow.RequestReset();
assertions.ThatBool(actual := resetAccepted, message := "RequestReset must succeed after completion").IsTrue();
assertions.ThatBool(
	actual := _StaticExecuteWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
	message := "Reset must return static workflow to PASSIVE_READY"
).IsTrue();
assertions.ThatDInt(
	actual := counterValue.AsDInt(),
	message := "Reset must restore declared variable to its initial value"
).ToBe(expected := 10);

started := _StaticExecuteWorkflow.RequestStart();
assertions.ThatBool(actual := started, message := "Second run must start after RequestReset").IsTrue();

FOR i := 1 TO 4 DO
	IF _StaticExecuteWorkflow.Busy THEN
		_StaticExecuteWorkflow.Execute();
	END_IF
END_FOR

assertions.ThatBool(
	actual := _StaticExecuteWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "Second run must complete without DisposeDynamicChildren"
).IsTrue();
assertions.ThatDInt(
	actual := counterValue.AsDInt(),
	message := "Second run must execute assignment step again"
).ToBe(expected := 42);
assertions.ThatDInt(
	actual := _StaticExecuteWorkflow.configureCount,
	message := "Repeat run via RequestReset must keep configureCount at 1"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStaticSelfConfigurationViaRequestStart" Id="{5e97b4c6-0c6d-468e-86e6-06a23998d0f9}">
      <Declaration><![CDATA[(*
Checks direct RequestStart configuration on a fresh subclass and preserved base Workflow rejection.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testStaticSelfConfigurationViaRequestStart
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	actualRoot : TOF_Workflow.IActivity;
	counterValue : TOF_Core.GENERIC_VALUE;
	started : BOOL;
	i : DINT;
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	notSpecifiedException : TOF_Core.IDataMemberNotSpecifiedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[actualRoot := _StaticStartWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot = 0,
	message := "Fresh workflow must have RootActivity = 0 before RequestStart"
).IsTrue();

started := _StaticStartWorkflow.RequestStart();
assertions.ThatBool(
	actual := started,
	message := "RequestStart must invoke OnConfigure and return TRUE"
).IsTrue();
assertions.ThatDInt(
	actual := _StaticStartWorkflow.configureCount,
	message := "Direct RequestStart must invoke OnConfigure once"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _StaticStartWorkflow.initializationCount,
	message := "Direct RequestStart must initialize variables once"
).ToBe(expected := 1);

actualRoot := _StaticStartWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot <> 0,
	message := "Direct RequestStart must install RootActivity"
).IsTrue();

FOR i := 1 TO 4 DO
	IF _StaticStartWorkflow.Busy THEN
		_StaticStartWorkflow.Execute();
	END_IF
END_FOR

assertions.ThatBool(
	actual := _StaticStartWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "Directly started static workflow must complete execution"
).IsTrue();
counterValue := _StaticStartWorkflow.GetDeclaredElement(name := 'StepCounter', index := 0);
assertions.ThatDInt(
	actual := counterValue.AsDInt(),
	message := "Directly started static workflow must update declared variable"
).ToBe(expected := 42);

caught := FALSE;

__TRY
	_StaticBaseWorkflow.RequestStart();
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught := exception <> 0 AND_THEN __QUERYINTERFACE(exception, notSpecifiedException);
__ENDTRY

assertions.ThatBool(
	actual := caught,
	message := "Base Workflow with empty OnConfigure must still throw DataMemberNotSpecifiedException on RequestStart"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testExternalRootSkipsOnConfigure" Id="{d200129e-0c8e-4d20-8c4f-351881160382}">
      <Declaration><![CDATA[(*
Verifies that assigning a nonzero RootActivity externally skips OnConfigure on Execute and RequestStart.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testExternalRootSkipsOnConfigure
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	started : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StaticExternalRoot.completeRunning := TRUE;
_StaticExternalWorkflow.SetRootActivity(rootActivity := _StaticExternalRoot);

_StaticExternalWorkflow.Execute();
assertions.ThatDInt(
	actual := _StaticExternalWorkflow.configureCount,
	message := "External SetRootActivity must skip OnConfigure on Execute"
).ToBe(expected := 0);
assertions.ThatDInt(
	actual := _StaticExternalWorkflow.beforeCount,
	message := "Before hook must still run when external root is configured"
).ToBe(expected := 1);

started := _StaticExternalWorkflow.RequestStart();
assertions.ThatBool(actual := started, message := "RequestStart must start external root").IsTrue();
assertions.ThatDInt(
	actual := _StaticExternalWorkflow.configureCount,
	message := "External SetRootActivity must skip OnConfigure on RequestStart"
).ToBe(expected := 0);
assertions.ThatBool(
	actual := _StaticExternalWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
	message := "External root must complete execution"
).IsTrue();
assertions.ThatDInt(
	actual := _StaticExternalRoot.startCount,
	message := "External root must execute once"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOnConfigureFailureIsNonRecoverable" Id="{35ad03a8-996c-4ca9-9e07-8ade64ad75bc}">
      <Declaration><![CDATA[(*
Checks non-recoverable latching when OnConfigure throws before or after SetRootActivity.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testOnConfigureFailureIsNonRecoverable
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR
VAR
	actualRoot : TOF_Workflow.IActivity;
	originalMessage : TOF_Core.ERROR_MESSAGE;
	actualMessage : TOF_Core.ERROR_MESSAGE;
	escaped : BOOL;
	started : BOOL;
	suspended : BOOL;
	cancelled : BOOL;
	resetAccepted : BOOL;
	caughtConfig : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	configException : TOF_Workflow.IWorkflowConfigurationException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StaticFailBeforeWorkflow.mode := STATIC_WORKFLOW_TEST_MODE.THROW_BEFORE_SET_ROOT;

__TRY
	_StaticFailBeforeWorkflow.Execute();
__CATCH
	escaped := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := escaped,
	message := "OnConfigure exception must be contained by Execute"
).IsFalse();
assertions.ThatDInt(
	actual := _StaticFailBeforeWorkflow.configureCount,
	message := "OnConfigure must be called once before failing"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _StaticFailBeforeWorkflow.afterCount,
	message := "OnAfterRootActivityExecute must still run after OnConfigure failure"
).ToBe(expected := 1);
actualRoot := _StaticFailBeforeWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot = 0,
	message := "Failed OnConfigure must leave RootActivity = 0"
).IsTrue();
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
	message := "Failed OnConfigure must report PASSIVE_FAILED"
).IsTrue();
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.FailError.HasError,
	message := "Failed OnConfigure must populate FailError"
).IsTrue();
originalMessage := _StaticFailBeforeWorkflow.FailError.TopMessage;
assertions.ThatWideString(
	actual := originalMessage,
	message := "FailError must retain original OnConfigure exception message"
).ToBe(expected := "Controlled OnConfigure failure before SetRootActivity");
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.StartingAllowed,
	message := "StartingAllowed must be FALSE after OnConfigure failure"
).IsFalse();
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.SuspendingAllowed,
	message := "SuspendingAllowed must be FALSE after OnConfigure failure"
).IsFalse();
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.CancellingAllowed,
	message := "CancellingAllowed must be FALSE after OnConfigure failure"
).IsFalse();
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.ResettingAllowed,
	message := "ResettingAllowed must be FALSE after OnConfigure failure"
).IsFalse();
assertions.ThatBool(
	actual := _StaticFailBeforeWorkflow.Busy,
	message := "Busy must be FALSE after OnConfigure failure"
).IsFalse();

_StaticFailBeforeWorkflow.Execute();
assertions.ThatDInt(
	actual := _StaticFailBeforeWorkflow.configureCount,
	message := "Subsequent Execute cycles must not re-invoke failed OnConfigure"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _StaticFailBeforeWorkflow.beforeCount,
	message := "Before hook must keep running on subsequent Execute scans"
).ToBe(expected := 1);
assertions.ThatDInt(
	actual := _StaticFailBeforeWorkflow.afterCount,
	message := "After hook must keep running on subsequent Execute scans"
).ToBe(expected := 2);
actualMessage := _StaticFailBeforeWorkflow.FailError.TopMessage;
assertions.ThatWideString(
	actual := actualMessage,
	message := "Subsequent Execute scans must preserve FailError"
).ToBe(expected := originalMessage);

__TRY
	started := _StaticFailBeforeWorkflow.RequestStart();
	suspended := _StaticFailBeforeWorkflow.RequestSuspend();
	cancelled := _StaticFailBeforeWorkflow.RequestCancel(reason := "Ignored after configure failure");
	resetAccepted := _StaticFailBeforeWorkflow.RequestReset();
__CATCH
	escaped := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := escaped,
	message := "Lifecycle requests after OnConfigure failure must not throw DataMemberNotSpecifiedException"
).IsFalse();
assertions.ThatBool(actual := started, message := "RequestStart must return FALSE when FAILED").IsFalse();
assertions.ThatBool(actual := suspended, message := "RequestSuspend must return FALSE when FAILED").IsFalse();
assertions.ThatBool(actual := cancelled, message := "RequestCancel must return FALSE when FAILED").IsFalse();
assertions.ThatBool(actual := resetAccepted, message := "RequestReset must return FALSE when FAILED").IsFalse();
actualMessage := _StaticFailBeforeWorkflow.FailError.TopMessage;
assertions.ThatWideString(
	actual := actualMessage,
	message := "Lifecycle requests in FAILED state must not overwrite FailError"
).ToBe(expected := originalMessage);

caughtConfig := FALSE;

__TRY
	_StaticFailBeforeWorkflow.SetRootActivity(rootActivity := _StaticFailedExternalRoot);
__CATCH(exceptionCode)
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caughtConfig := exception <> 0 AND_THEN __QUERYINTERFACE(exception, configException);
__ENDTRY

assertions.ThatBool(
	actual := caughtConfig,
	message := "External SetRootActivity must be rejected with WorkflowConfigurationException when FAILED"
).IsTrue();

_StaticFailAfterWorkflow.mode := STATIC_WORKFLOW_TEST_MODE.THROW_AFTER_SET_ROOT;
escaped := FALSE;

__TRY
	started := _StaticFailAfterWorkflow.RequestStart();
__CATCH
	escaped := TRUE;
__ENDTRY

assertions.ThatBool(
	actual := escaped,
	message := "RequestStart must contain OnConfigure exception"
).IsFalse();
assertions.ThatBool(
	actual := started,
	message := "RequestStart must return FALSE when OnConfigure fails"
).IsFalse();
assertions.ThatDInt(
	actual := _StaticFailAfterWorkflow.configureCount,
	message := "RequestStart must invoke OnConfigure once"
).ToBe(expected := 1);
actualRoot := _StaticFailAfterWorkflow.RootActivity;
assertions.ThatBool(
	actual := actualRoot = 0,
	message := "OnConfigure failure after SetRootActivity must clear RootActivity back to 0"
).IsTrue();
assertions.ThatBool(
	actual := _StaticFailAfterWorkflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_FAILED,
	message := "OnConfigure failure after SetRootActivity must latch PASSIVE_FAILED"
).IsTrue();
actualMessage := _StaticFailAfterWorkflow.FailError.TopMessage;
assertions.ThatWideString(
	actual := actualMessage,
	message := "FailError must retain exception message when failure occurred after SetRootActivity"
).ToBe(expected := "Controlled OnConfigure failure after SetRootActivity");
assertions.ThatBool(
	actual := _StaticFailAfterWorkflow.ResettingAllowed,
	message := "ResettingAllowed must remain FALSE after OnConfigure failure"
).IsFalse();

started := _StaticFailAfterWorkflow.RequestStart();
assertions.ThatBool(
	actual := started,
	message := "Repeated RequestStart in FAILED state must return FALSE"
).IsFalse();
actualMessage := _StaticFailAfterWorkflow.FailError.TopMessage;
assertions.ThatWideString(
	actual := actualMessage,
	message := "Repeated RequestStart in FAILED state must preserve FailError"
).ToBe(expected := "Controlled OnConfigure failure after SetRootActivity");]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOnConfigureReentrancyRejection" Id="{559fa8e5-9686-4aff-a00e-8c35753f1ab9}">
      <Declaration><![CDATA[(*
Checks that reentering lifecycle or disposal APIs during OnConfigure latches PASSIVE_FAILED.

assertions — Valid assertion context borrowed from the active case.
*)
METHOD PRIVATE testOnConfigureReentrancyRejection
VAR_INPUT
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[assertReentrantFailure(
	assertions := assertions,
	workflow := _StaticReenterStartWorkflow,
	mode := STATIC_WORKFLOW_TEST_MODE.REENTER_REQUEST_START,
	triggerViaStart := FALSE,
	label := "RequestStart inside OnConfigure"
);
assertReentrantFailure(
	assertions := assertions,
	workflow := _StaticReenterExecuteWorkflow,
	mode := STATIC_WORKFLOW_TEST_MODE.REENTER_EXECUTE,
	triggerViaStart := TRUE,
	label := "Execute inside OnConfigure"
);
assertReentrantFailure(
	assertions := assertions,
	workflow := _StaticReenterDisposeWorkflow,
	mode := STATIC_WORKFLOW_TEST_MODE.REENTER_DISPOSE_DYNAMIC_CHILDREN,
	triggerViaStart := FALSE,
	label := "DisposeDynamicChildren inside OnConfigure"
);
assertReentrantFailure(
	assertions := assertions,
	workflow := _StaticReenterSuspendWorkflow,
	mode := STATIC_WORKFLOW_TEST_MODE.REENTER_REQUEST_SUSPEND,
	triggerViaStart := FALSE,
	label := "RequestSuspend inside OnConfigure"
);
assertReentrantFailure(
	assertions := assertions,
	workflow := _StaticReenterCancelWorkflow,
	mode := STATIC_WORKFLOW_TEST_MODE.REENTER_REQUEST_CANCEL,
	triggerViaStart := FALSE,
	label := "RequestCancel inside OnConfigure"
);
assertReentrantFailure(
	assertions := assertions,
	workflow := _StaticReenterResetWorkflow,
	mode := STATIC_WORKFLOW_TEST_MODE.REENTER_REQUEST_RESET,
	triggerViaStart := FALSE,
	label := "RequestReset inside OnConfigure"
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{b63d2f44-d576-41b8-abef-9c96db90411b}">
      <Declaration><![CDATA[(*
Clears a still-owned loaded workflow if the fixture is unloaded before case teardown.
bInCopyCode — TwinCAT copy-code exit marker. Leave copied ownership with the new instance.
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	TryReleaseLoadedWorkflow();
END_IF

FB_exit := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
