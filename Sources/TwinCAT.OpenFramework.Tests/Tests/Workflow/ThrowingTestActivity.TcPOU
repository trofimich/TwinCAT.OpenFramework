<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ThrowingTestActivity" Id="{b182505d-5ec4-4ee1-929e-c18abda075d4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Test activity that throws a controllable exception during execution for testing TryCatchActivity.</summary>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK ThrowingTestActivity EXTENDS TOF_Workflow.Activity
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_ShouldThrow : BOOL := TRUE;
	_ThrowCount : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{fbe13a1f-7534-4abe-80da-782cf306cfa0}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b6d79d8e-2c7e-4c51-8505-a9bb704e5369}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{deeb909c-1434-49df-8b02-4480d108c4e3}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f7a560a2-be3a-4e28-a382-69811af1010a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnResetting" Id="{b6b2b3a5-f218-4791-9659-aff42bd0fa6c}">
      <Declaration><![CDATA[METHOD PROTECTED OnResetting : TOF_Workflow.ACTIVITY_RESETTING_STATE
VAR_INPUT
	startResetting : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ThrowCount := 0;
OnResetting := TOF_Workflow.ACTIVITY_RESETTING_STATE.WORK_RESET;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnRunning" Id="{3517dbe5-d557-447d-809f-cd083c43b694}">
      <Declaration><![CDATA[METHOD PROTECTED OnRunning : TOF_Workflow.ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ShouldThrow THEN
	_ThrowCount := _ThrowCount + 1;
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Controlled exception for TryCatch test"
	);
END_IF

OnRunning := TOF_Workflow.ACTIVITY_RUNNING_STATE.WORK_COMPLETED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{ed4a137c-f934-408c-9106-c7490e3d2451}">
      <Declaration><![CDATA[METHOD PROTECTED OnStopping : TOF_Workflow.ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnStopping := TOF_Workflow.ACTIVITY_STOPPING_STATE.WORK_STOPPED;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ShouldThrow" Id="{03f33bd3-3270-4cb0-adeb-b3205de2b412}">
      <Declaration><![CDATA[PROPERTY ShouldThrow : BOOL]]></Declaration>
      <Get Name="Get" Id="{2bd0a627-f9cf-4de9-9e81-7ad47935b5b6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ShouldThrow := _ShouldThrow;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{34a93c8a-8e24-42a7-996b-1546c4d57eed}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ShouldThrow := ShouldThrow;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ThrowCount" Id="{5516893b-d7a0-4645-bc47-53dec58aeb0a}">
      <Declaration><![CDATA[PROPERTY ThrowCount : INT]]></Declaration>
      <Get Name="Get" Id="{4a0c2c1c-6ebb-4533-a788-cdb0de4af92e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowCount := _ThrowCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{edb8839d-16dc-4c63-bdfd-d97b68c459ae}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f411fa60-ca48-4c9b-b332-ef30d2200f1f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
