(*!
<summary>Test workflow instance containing named variables for the comprehensive workflow scenario test.</summary>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK ComprehensiveTestWorkflow EXTENDS TOF_Workflow.Workflow<7>
VAR_INPUT
	SensorFeedPart : BOOL;
	SensorVacuumOk : BOOL;
	SensorInspectionOk : BOOL;
	BatchTarget : INT;
	ProducedCount : INT;
	RejectCount : INT;
	ErrorHandled : BOOL;
END_VAR
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden members" Id="{e4c1214b-c5de-4258-be55-74a6472c32e0}" />
    <Property Name="ClassName" Id="{78336a3a-5d47-4fcf-bca2-c7a66c74c3ca}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{15f8f142-9c7f-4bb9-8bb0-15bc09c73953}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CreateVariables" Id="{ca266811-7478-4488-af0f-64a400c7b49b}">
      <Declaration><![CDATA[METHOD PROTECTED CreateVariables : ARRAY [0..VariableCount - 1] OF TOF_Workflow.VARIABLE_DESCRIPTOR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CreateVariables[0].Initialize(variableName := 'BatchTarget', plcVariable := BatchTarget);
CreateVariables[1].Initialize(variableName := 'ProducedCount', plcVariable := ProducedCount);
CreateVariables[2].Initialize(variableName := 'RejectCount', plcVariable := RejectCount);
CreateVariables[3].Initialize(variableName := 'SensorFeedPart', plcVariable := SensorFeedPart);
CreateVariables[4].Initialize(variableName := 'SensorVacuumOk', plcVariable := SensorVacuumOk);
CreateVariables[5].Initialize(variableName := 'SensorInspectionOk', plcVariable := SensorInspectionOk);
CreateVariables[6].Initialize(variableName := 'ErrorHandled', plcVariable := ErrorHandled);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{0883b169-afc6-4537-86f5-2fd46e0faffe}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{142455da-6cd3-477b-ac63-8ab44d5d32bc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnRootActivityRequestReset" Id="{40bfb420-e972-4486-a912-6873773be130}" FolderPath="Overriden members\">
      <Declaration><![CDATA[METHOD PROTECTED OnRootActivityRequestReset
VAR_OUTPUT
	cancelRequest : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ProducedCount := 0;
RejectCount := 0;
ErrorHandled := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{0a9b2890-9932-44fe-a7d7-72edc5b13608}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a533cfa1-ac99-4f9f-a92d-a5810418a3c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
