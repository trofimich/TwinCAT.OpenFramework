<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ComprehensiveTestWorkflow" Id="{f68cdb29-f402-4a3c-a63d-1d66373aec54}" SpecialFunc="None">
    <Declaration><![CDATA[(*
