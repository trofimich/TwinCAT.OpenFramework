(*
Groups workflow scenario, comparisons, lifecycle and variable-scope tests.

Owns the fixed case tree and runs its leaves in order in the controller task.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WorkflowComprehensiveTestGroup EXTENDS TOF_Testing.TestGroup<14>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_EndToEndComprehensiveScenario : WorkflowComprehensiveTestCase(
		name := "TestEndToEndComprehensiveScenario",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.END_TO_END_COMPREHENSIVE_SCENARIO
	);
	_WorkflowReset : WorkflowComprehensiveTestCase(
		name := "TestWorkflowReset",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.WORKFLOW_RESET
	);
	_WorkflowCancel : WorkflowComprehensiveTestCase(
		name := "TestWorkflowCancel",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.WORKFLOW_CANCEL
	);
	_ParallelActivityWaitAll : WorkflowComprehensiveTestCase(
		name := "TestParallelActivityWaitAll",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.PARALLEL_ACTIVITY_WAIT_ALL
	);
	_ParallelActivityWaitAny : WorkflowComprehensiveTestCase(
		name := "TestParallelActivityWaitAny",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.PARALLEL_ACTIVITY_WAIT_ANY
	);
	_NotCondition : WorkflowComprehensiveTestCase(
		name := "TestNotCondition",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.NOT_CONDITION
	);
	_CompareVariableCondition : WorkflowComprehensiveTestCase(
		name := "TestCompareVariableCondition",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.COMPARE_VARIABLE_CONDITION
	);
	_MixedNumericComparison : WorkflowComprehensiveTestCase(
		name := "TestMixedNumericComparison",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.MIXED_NUMERIC_COMPARISON
	);
	_MixedTextComparison : WorkflowComprehensiveTestCase(
		name := "TestMixedTextComparison",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.MIXED_TEXT_COMPARISON
	);
	_StandardComparisonFallback : WorkflowComprehensiveTestCase(
		name := "TestStandardComparisonFallback",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.STANDARD_COMPARISON_FALLBACK
	);
	_IncompatibleComparisonPairs : WorkflowComprehensiveTestCase(
		name := "TestIncompatibleComparisonPairs",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.INCOMPATIBLE_COMPARISON_PAIRS
	);
	_DirectWorkflowDynamicCreation : WorkflowComprehensiveTestCase(
		name := "TestDirectWorkflowDynamicCreation",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.DIRECT_WORKFLOW_DYNAMIC_CREATION
	);
	_ActivityVariableScopingAndShadowing : WorkflowComprehensiveTestCase(
		name := "TestActivityVariableScopingAndShadowing",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.ACTIVITY_VARIABLE_SCOPING_AND_SHADOWING
	);
	_VariableRegistrationValidation : WorkflowComprehensiveTestCase(
		name := "TestVariableRegistrationValidation",
		parent := THIS^,
		scenario := WORKFLOW_COMPREHENSIVE_TEST_SCENARIO.VARIABLE_REGISTRATION_VALIDATION
	);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_EndToEndComprehensiveScenario,
		_WorkflowReset,
		_WorkflowCancel,
		_ParallelActivityWaitAll,
		_ParallelActivityWaitAny,
		_NotCondition,
		_CompareVariableCondition,
		_MixedNumericComparison,
		_MixedTextComparison,
		_StandardComparisonFallback,
		_IncompatibleComparisonPairs,
		_DirectWorkflowDynamicCreation,
		_ActivityVariableScopingAndShadowing,
		_VariableRegistrationValidation
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{dbcd7706-5e1a-4ef3-8eb6-b259fe7bafe8}">
      <Declaration><![CDATA[(* Borrows the persistent case array. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{f1a735a1-092f-4806-b45e-a2ff120ec2b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{8c111fa5-06c3-4332-9faa-90be779ec85a}">
      <Declaration><![CDATA[(* Borrows the concrete class name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e1a1b269-709c-4396-a167-19dc0cd8da59}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{abfa7553-2d4b-48b8-b845-c5e21c91e565}">
      <Declaration><![CDATA[(* Borrows the project namespace name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{660e8e86-c7de-461d-ab96-16e075804024}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b455e242-2691-41e0-8b26-56dadc582dc9}">
      <Declaration><![CDATA[(* Reports the complete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a9c81f87-ae53-4250-b999-626278454f0c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
