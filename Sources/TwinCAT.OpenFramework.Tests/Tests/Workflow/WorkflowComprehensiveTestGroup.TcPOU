<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowComprehensiveTestGroup" Id="{cc9946cf-e980-4b53-b31f-fb3bea3b51e5}" SpecialFunc="None">
    <Declaration><![CDATA[(*
