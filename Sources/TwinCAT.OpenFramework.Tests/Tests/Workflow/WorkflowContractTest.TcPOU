<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="WorkflowContractTest" Id="{385ee4a8-00b5-4d7d-be1b-b9a631abfbc6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
