(* Selects the OnConfigure behavior executed by StaticConfigurationTestWorkflow. *)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE STATIC_WORKFLOW_TEST_MODE :
(
	NORMAL := 0,
	THROW_BEFORE_SET_ROOT,
	THROW_AFTER_SET_ROOT,
	REENTER_REQUEST_START,
	REENTER_EXECUTE,
	REENTER_DISPOSE_DYNAMIC_CHILDREN,
	REENTER_REQUEST_SUSPEND,
	REENTER_REQUEST_CANCEL,
	REENTER_REQUEST_RESET
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>