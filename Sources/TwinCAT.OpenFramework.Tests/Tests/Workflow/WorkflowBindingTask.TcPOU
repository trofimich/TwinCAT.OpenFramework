<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowBindingTask" Id="{bec1fa0c-adbb-45d8-85db-fa43d8ab772f}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exercises task and comparer bindings on the same concrete instance.</summary>
<description>Both interfaces expose this object to the ownership registry.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK WorkflowBindingTask EXTENDS TOF_Tasks.Task
IMPLEMENTS TOF_Core.IComparer, TOF_Core.IConfigurationSerializable
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[]]></ST></Implementation>
    <Property Name="ClassName" Id="{a508925b-8140-46bd-b0f8-72ddca72c462}">
      <Declaration><![CDATA[(*!
<summary>Returns the initialized static name of this concrete fixture.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7524c079-a32f-457d-ac14-62cd297dbfbd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f9c11551-f9d6-4358-a0d4-a1d1dea59845}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test project namespace without changing it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{11851a47-bfab-4f0c-be9d-84d4492aca08}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5f39b200-3566-421c-b2c1-3c3fc6e4ab5b}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this concrete fixture in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{391fdcce-98df-44be-a5e8-21601ae060ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnRunning" Id="{8c67c7b8-d84e-4706-87a8-81bd834e33ef}">
      <Declaration><![CDATA[(*!
<summary>Completes immediately.</summary>
<description>This fixture does not use resources.</description>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Compare" Id="{31b25030-4f07-4d80-8e31-ef9525767082}">
      <Declaration><![CDATA[(*!
<summary>Compares test operands by their natural ordering.</summary>
<description>Borrows both operands for this call.</description>
*)
METHOD Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Compare := first.CompareTo(otherValue := second);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Serialize" Id="{ea9b7190-99f0-42f8-9c83-6512eca7229b}">
      <Declaration><![CDATA[(*!
<summary>Writes the configuration fields for this object.</summary>
<description>Borrows the writer for this call. A failure invalidates the current output document.</description>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR
VAR
	displayName : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[displayName := Name;
writer.WriteValue(
	name := 'name',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(displayName),
	size := SIZEOF(displayName)
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Deserialize" Id="{1bc69c53-12e1-4423-9e86-8a016d6ef3d3}">
      <Declaration><![CDATA[(*!
<summary>Restores this fresh instance from its configuration object.</summary>
<description>
The reader and document node are borrowed for this call. The deserialization context is ignored.
On failure discard the partial instance.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Configuration deserialization context; ignored by this task.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	displayName : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[reader.ReadValue(
	node := reader.GetField(node := node, name := 'name'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(displayName),
	size := SIZEOF(displayName)
);
Name := displayName;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
