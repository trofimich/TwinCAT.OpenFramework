<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="WorkflowComprehensiveTest" Id="{d7e08298-7ac4-41d4-b416-1c0c7d8a4ce5}" SpecialFunc="None">
    <Declaration><![CDATA[(*
