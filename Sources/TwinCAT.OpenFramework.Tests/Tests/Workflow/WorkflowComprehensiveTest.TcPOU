(*!
<summary>
Comprehensive end-to-end integration test exercising all workflow activities, conditions and lifecycle states.
</summary>
<description>
Constructs a complete packaging and inspection scenario combining SequenceActivity, WhileActivity,
IfElseActivity, WaitAndPickActivity, TryCatchActivity, DelayActivity, WaitConditionActivity,
AssignVariableActivity, InvokeTaskActivity and ParallelActivity, verifying execution, exception recovery,
cancellation, join modes, condition negation, relational comparisons and reset.
</description>
*)

FUNCTION_BLOCK WorkflowComprehensiveTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();

	_Workflow : ComprehensiveTestWorkflow;
	_ThrowingActivity : ThrowingTestActivity(workflow := _Workflow);
	_CounterTask : CounterTask("CounterTask");

	_Configured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestEndToEndComprehensiveScenario();
TestWorkflowReset();
TestWorkflowCancel();
TestParallelActivityWaitAll();
TestParallelActivityWaitAny();
TestNotCondition();
TestCompareVariableCondition();]]></ST>
    </Implementation>
    <Folder Name="Internal methods" Id="{15a9c232-e68f-46d4-ae7b-3bb4b6d7f5df}" />
    <Folder Name="Tests" Id="{870960a7-e3dd-407a-95d4-b6c88de23284}" />
    <Method Name="buildScenarioTree" Id="{12919d61-cd2f-459d-b2f9-334de9148c1a}" FolderPath="Internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE buildScenarioTree
VAR
	rootSequence : POINTER TO TOF_Workflow.SequenceActivity;
	initBatchTarget : POINTER TO TOF_Workflow.AssignVariableActivity;

	parallelStep : POINTER TO TOF_Workflow.ParallelActivity;
	parallelDelay : POINTER TO TOF_Workflow.DelayActivity;
	parallelAssign : POINTER TO TOF_Workflow.AssignVariableActivity;

	whileCondition : POINTER TO TOF_Workflow.VariableHasValueCondition;
	whileActivity : POINTER TO TOF_Workflow.WhileActivity;

	feedTaskActivity : POINTER TO TOF_Workflow.InvokeTaskActivity;

	condPart : POINTER TO TOF_Workflow.VariableHasValueCondition;
	condVacuum : POINTER TO TOF_Workflow.VariableHasValueCondition;
	compCond : POINTER TO TOF_Workflow.CompositeCondition;
	waitCondAct : POINTER TO TOF_Workflow.WaitConditionActivity;

	delayAct : POINTER TO TOF_Workflow.DelayActivity;

	pickAct : POINTER TO TOF_Workflow.WaitAndPickActivity;
	condOk : POINTER TO TOF_Workflow.VariableHasValueCondition;
	actOk : POINTER TO TOF_Workflow.AssignVariableActivity;
	condRej : POINTER TO TOF_Workflow.VariableHasValueCondition;
	actRej : POINTER TO TOF_Workflow.AssignVariableActivity;

	ifCond : POINTER TO TOF_Workflow.VariableHasValueCondition;
	trueAct : POINTER TO TOF_Workflow.DelayActivity;
	ifElseAct : POINTER TO TOF_Workflow.IfElseActivity;

	tryCatchAct : POINTER TO TOF_Workflow.TryCatchActivity;
	catchAct : POINTER TO RecoveryCatchTestActivity;

	refuseReason : TOF_Core.ERROR_MESSAGE;
	initTargetValue : INT := 2;
	producedIncrement : INT := 1;
	rejectIncrement : INT := 1;
	trueValue : BOOL := TRUE;
	falseValue : BOOL := FALSE;
	zeroCount : INT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Configured THEN
	RETURN;
END_IF

// 1. Root Sequence
rootSequence := __NEW(TOF_Workflow.SequenceActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := rootSequence^);

// 2. AssignVariableActivity: initialize BatchTarget
initBatchTarget := __NEW(TOF_Workflow.AssignVariableActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := initBatchTarget^);
initBatchTarget^.Configure(targetVariableName := 'BatchTarget', value := initTargetValue);
rootSequence^.AddChildActivity(activity := initBatchTarget^);

// 2.5. ParallelActivity: concurrently run a delay and an assignment with WAIT_ALL
parallelStep := __NEW(TOF_Workflow.ParallelActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := parallelStep^);
parallelStep^.Mode := TOF_Workflow.PARALLEL_JOIN_MODE.WAIT_ALL;

parallelDelay := __NEW(TOF_Workflow.DelayActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := parallelDelay^);
parallelDelay^.Interval := T#0S;
parallelStep^.AddChildActivity(activity := parallelDelay^);

parallelAssign := __NEW(TOF_Workflow.AssignVariableActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := parallelAssign^);
parallelAssign^.Configure(targetVariableName := 'SensorFeedPart', value := trueValue);
parallelStep^.AddChildActivity(activity := parallelAssign^);

rootSequence^.AddChildActivity(activity := parallelStep^);

// 3. WhileActivity: run while ProducedCount = 0
whileCondition := __NEW(TOF_Workflow.VariableHasValueCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := whileCondition^);
whileCondition^.Configure(monitoredVariableName := 'ProducedCount', referenceValue := zeroCount);

whileActivity := __NEW(TOF_Workflow.WhileActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := whileActivity^);
whileActivity^.Configure(condition := whileCondition^);
rootSequence^.AddChildActivity(activity := whileActivity^);

// 3.1. InvokeTaskActivity inside while body
feedTaskActivity := __NEW(TOF_Workflow.InvokeTaskActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := feedTaskActivity^);
_CounterTask.Reset(refuseReason => refuseReason);
_CounterTask.TargetValue := 1;
feedTaskActivity^.Configure(task := _CounterTask);
whileActivity^.AddChildActivity(activity := feedTaskActivity^);

// 3.2. WaitConditionActivity with CompositeCondition (AND)
condPart := __NEW(TOF_Workflow.VariableHasValueCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := condPart^);
condPart^.Configure(monitoredVariableName := 'SensorFeedPart', referenceValue := trueValue);

condVacuum := __NEW(TOF_Workflow.VariableHasValueCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := condVacuum^);
condVacuum^.Configure(monitoredVariableName := 'SensorVacuumOk', referenceValue := trueValue);

compCond := __NEW(TOF_Workflow.CompositeCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := compCond^);
compCond^.LogicalOperator := TOF_Workflow.LOGICAL_OPERATOR.AND_;
compCond^.AddChildCondition(condition := condPart^);
compCond^.AddChildCondition(condition := condVacuum^);

waitCondAct := __NEW(TOF_Workflow.WaitConditionActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := waitCondAct^);
waitCondAct^.Configure(condition := compCond^);
whileActivity^.AddChildActivity(activity := waitCondAct^);

// 3.3. DelayActivity
delayAct := __NEW(TOF_Workflow.DelayActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := delayAct^);
delayAct^.Interval := T#0S;
whileActivity^.AddChildActivity(activity := delayAct^);

// 3.4. WaitAndPickActivity (Inspection decision)
pickAct := __NEW(TOF_Workflow.WaitAndPickActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := pickAct^);

condOk := __NEW(TOF_Workflow.VariableHasValueCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := condOk^);
condOk^.Configure(monitoredVariableName := 'SensorInspectionOk', referenceValue := trueValue);

actOk := __NEW(TOF_Workflow.AssignVariableActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := actOk^);
actOk^.Configure(targetVariableName := 'ProducedCount', value := producedIncrement);
pickAct^.AddBarnch(condition := condOk^, activity := actOk^);

condRej := __NEW(TOF_Workflow.VariableHasValueCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := condRej^);
condRej^.Configure(monitoredVariableName := 'SensorInspectionOk', referenceValue := falseValue);

actRej := __NEW(TOF_Workflow.AssignVariableActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := actRej^);
actRej^.Configure(targetVariableName := 'RejectCount', value := rejectIncrement);
pickAct^.AddBarnch(condition := condRej^, activity := actRej^);

whileActivity^.AddChildActivity(activity := pickAct^);

// 3.5. IfElseActivity
ifCond := __NEW(TOF_Workflow.VariableHasValueCondition(workflow := _Workflow));
_Workflow.RegisterChild(child := ifCond^);
ifCond^.Configure(monitoredVariableName := 'SensorInspectionOk', referenceValue := trueValue);

trueAct := __NEW(TOF_Workflow.DelayActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := trueAct^);
trueAct^.Interval := T#0S;

ifElseAct := __NEW(TOF_Workflow.IfElseActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := ifElseAct^);
ifElseAct^.Configure(condition := ifCond^, trueActivity := trueAct^, falseActivity := 0);
whileActivity^.AddChildActivity(activity := ifElseAct^);

// 3.6. TryCatchActivity: verifies exception interception and recovery
tryCatchAct := __NEW(TOF_Workflow.TryCatchActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := tryCatchAct^);
_ThrowingActivity.ShouldThrow := TRUE;

catchAct := __NEW(RecoveryCatchTestActivity(workflow := _Workflow));
_Workflow.RegisterChild(child := catchAct^);

tryCatchAct^.Configure(tryActivity := _ThrowingActivity, catchActivity := catchAct^);
whileActivity^.AddChildActivity(activity := tryCatchAct^);

// Set root activity on workflow
_Workflow.SetRootActivity(rootActivity := rootSequence^);
_Configured := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{c3bcd94f-5489-4542-b19e-0662a75b1185}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a60b3aca-1e02-431a-829a-b4bd6d1f5c09}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{30522f3a-8ef1-4a77-9477-70dd60f3c6cc}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9951e144-ddf1-4657-b72d-e11cf13da2da}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TestCompareVariableCondition" Id="{49b2550f-1361-4e37-acf4-0e8a608b4733}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestCompareVariableCondition
VAR
	compareCondition : TOF_Workflow.CompareVariableCondition(workflow := _Workflow);
	threshold10 : INT := 10;
	threshold5 : INT := 5;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Workflow.ProducedCount := 5;

// Literal comparisons
compareCondition.Configure(
	variableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN,
	referenceValue := threshold10
);
AssertTrue(Condition := compareCondition.Evaluate(activity := 0), Message := '5 < 10 must be TRUE');

compareCondition.Configure(
	variableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN,
	referenceValue := threshold10
);
AssertFalse(Condition := compareCondition.Evaluate(activity := 0), Message := '5 > 10 must be FALSE');

compareCondition.Configure(
	variableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.EQUAL,
	referenceValue := threshold5
);
AssertTrue(Condition := compareCondition.Evaluate(activity := 0), Message := '5 == 5 must be TRUE');

compareCondition.Configure(
	variableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.NOT_EQUAL,
	referenceValue := threshold5
);
AssertFalse(Condition := compareCondition.Evaluate(activity := 0), Message := '5 != 5 must be FALSE');

compareCondition.Configure(
	variableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN_OR_EQUAL,
	referenceValue := threshold5
);
AssertTrue(Condition := compareCondition.Evaluate(activity := 0), Message := '5 >= 5 must be TRUE');

compareCondition.Configure(
	variableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN_OR_EQUAL,
	referenceValue := threshold10
);
AssertTrue(Condition := compareCondition.Evaluate(activity := 0), Message := '5 <= 10 must be TRUE');

// Variable-to-variable comparisons
_Workflow.BatchTarget := 10;
compareCondition.ConfigureVariable(
	firstVariableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.LESS_THAN,
	secondVariableName := 'BatchTarget'
);
AssertTrue(Condition := compareCondition.Evaluate(activity := 0), Message := 'ProducedCount (5) < BatchTarget (10) must be TRUE');

compareCondition.ConfigureVariable(
	firstVariableName := 'ProducedCount',
	comparisonOperator := TOF_Workflow.COMPARISON_OPERATOR.GREATER_THAN,
	secondVariableName := 'BatchTarget'
);
AssertFalse(Condition := compareCondition.Evaluate(activity := 0), Message := 'ProducedCount (5) > BatchTarget (10) must be FALSE');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestEndToEndComprehensiveScenario" Id="{54b4d03c-b4da-4bb0-a5c1-dc2876d896c5}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestEndToEndComprehensiveScenario
VAR
	cycleIndex : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

buildScenarioTree();

_Workflow.SensorFeedPart := FALSE; // will be set TRUE by parallelStep
_Workflow.SensorVacuumOk := TRUE;
_Workflow.SensorInspectionOk := TRUE;

AssertTrue(Condition := _Workflow.StartingAllowed, Message := 'Workflow must allow starting from PASSIVE_READY');
_Workflow.RequestStart();

FOR cycleIndex := 1 TO 200 DO
	_Workflow.Execute();
	IF NOT _Workflow.Busy THEN
		EXIT;
	END_IF
END_FOR

AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		Actual := _Workflow.State,
		Message := 'Workflow must complete with PASSIVE_COMPLETED'
	);
AssertEquals_INT(
		Expected := 1,
		Actual := _Workflow.ProducedCount,
		Message := 'ProducedCount must equal 1 after WhileActivity and AssignVariableActivity'
	);
AssertTrue(
		Condition := _Workflow.ErrorHandled,
		Message := 'ErrorHandled must be TRUE after CatchActivity recovered from Try exception'
	);
AssertTrue(Condition := _ThrowingActivity.ThrowCount > 0, Message := 'ThrowingActivity must have executed and thrown');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestNotCondition" Id="{8bb51156-29df-4aeb-929b-4fad120d5903}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestNotCondition
VAR
	notCond : TOF_Workflow.NotCondition(workflow := _Workflow);
	trueCond : TOF_Workflow.TrueCondition(workflow := _Workflow);
	varCond : TOF_Workflow.VariableHasValueCondition(workflow := _Workflow);
	testVal : INT := 10;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

AssertFalse(Condition := notCond.Configured, Message := 'NotCondition must not be configured initially');

notCond.Configure(condition := trueCond);
AssertTrue(Condition := notCond.Configured, Message := 'NotCondition must be configured after Configure');
AssertFalse(Condition := notCond.Evaluate(activity := 0), Message := 'NOT True must evaluate to FALSE');

_Workflow.ProducedCount := testVal;
varCond.Configure(monitoredVariableName := 'ProducedCount', referenceValue := testVal);
notCond.Configure(condition := varCond);
AssertFalse(
		Condition := notCond.Evaluate(activity := 0),
		Message := 'NOT (ProducedCount = 10) when ProducedCount = 10 must be FALSE'
	);

_Workflow.ProducedCount := 99;
AssertTrue(
		Condition := notCond.Evaluate(activity := 0),
		Message := 'NOT (ProducedCount = 10) when ProducedCount = 99 must be TRUE'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestParallelActivityWaitAll" Id="{404e9d64-2836-4d94-83b8-09fd22ed2069}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestParallelActivityWaitAll
VAR
	parallelAct : TOF_Workflow.ParallelActivity(workflow := _Workflow);
	counterTask1 : CounterTask("WaitAllCounter1");
	counterTask2 : CounterTask("WaitAllCounter2");
	taskAct1 : TOF_Workflow.InvokeTaskActivity(workflow := _Workflow);
	taskAct2 : TOF_Workflow.InvokeTaskActivity(workflow := _Workflow);
	cycleIndex : INT;
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

counterTask1.Reset(refuseReason => refuseReason);
counterTask1.TargetValue := 1;
taskAct1.Configure(task := counterTask1);

counterTask2.Reset(refuseReason => refuseReason);
counterTask2.TargetValue := 2;
taskAct2.Configure(task := counterTask2);

parallelAct.Mode := TOF_Workflow.PARALLEL_JOIN_MODE.WAIT_ALL;
parallelAct.AddChildActivity(activity := taskAct1);
parallelAct.AddChildActivity(activity := taskAct2);

AssertEquals_DINT(Expected := 2, Actual := parallelAct.ChildCount, Message := 'ChildCount must be 2');

parallelAct.RequestStart();
AssertTrue(Condition := parallelAct.Busy, Message := 'ParallelActivity must be busy after RequestStart');

FOR cycleIndex := 1 TO 50 DO
	parallelAct.Execute();
	IF NOT parallelAct.Busy THEN
		EXIT;
	END_IF
END_FOR

	AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		Actual := parallelAct.State,
		Message := 'ParallelActivity with WAIT_ALL must complete with PASSIVE_COMPLETED'
	);
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		Actual := taskAct1.State,
		Message := 'taskAct1 must be PASSIVE_COMPLETED'
	);
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		Actual := taskAct2.State,
		Message := 'taskAct2 must be PASSIVE_COMPLETED'
	);

parallelAct.RequestReset();
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		Actual := parallelAct.State,
		Message := 'ParallelActivity must reset to PASSIVE_READY'
	);
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		Actual := taskAct1.State,
		Message := 'taskAct1 must reset to PASSIVE_READY'
	);
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		Actual := taskAct2.State,
		Message := 'taskAct2 must reset to PASSIVE_READY'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestParallelActivityWaitAny" Id="{c0db5536-0b75-4739-b1a4-e5327ff95246}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestParallelActivityWaitAny
VAR
	parallelAct : TOF_Workflow.ParallelActivity(workflow := _Workflow);
	fastAssign : TOF_Workflow.AssignVariableActivity(workflow := _Workflow);
	longDelay : TOF_Workflow.DelayActivity(workflow := _Workflow);
	cycleIndex : INT;
	val : INT := 42;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

fastAssign.Configure(targetVariableName := 'ProducedCount', value := val);
longDelay.Interval := T#10S;

parallelAct.Mode := TOF_Workflow.PARALLEL_JOIN_MODE.WAIT_ANY;
parallelAct.AddChildActivity(activity := fastAssign);
parallelAct.AddChildActivity(activity := longDelay);

parallelAct.RequestStart();

FOR cycleIndex := 1 TO 20 DO
	parallelAct.Execute();
	IF NOT parallelAct.Busy THEN
		EXIT;
	END_IF
END_FOR

	AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		Actual := parallelAct.State,
		Message := 'ParallelActivity with WAIT_ANY must complete once fast branch finishes'
	);
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED,
		Actual := fastAssign.State,
		Message := 'fastAssign must be PASSIVE_COMPLETED'
	);
	AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED,
		Actual := longDelay.State,
		Message := 'longDelay must be cancelled when sibling branch completed under WAIT_ANY'
	);

parallelAct.RequestReset();
AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		Actual := parallelAct.State,
		Message := 'ParallelActivity must reset to PASSIVE_READY'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestWorkflowCancel" Id="{eee0f66c-89d5-43d2-ba1f-36296219b20a}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestWorkflowCancel
VAR
	cycleIndex : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

buildScenarioTree();

IF _Workflow.State <> TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY THEN
	_Workflow.RequestReset();
	FOR cycleIndex := 1 TO 20 DO
		_Workflow.Execute();
		IF NOT _Workflow.Busy THEN
			EXIT;
		END_IF
	END_FOR
END_IF

_Workflow.SensorVacuumOk := FALSE; // keep waiting at condition
_Workflow.RequestStart();

AssertTrue(Condition := _Workflow.CancellingAllowed, Message := 'Workflow must allow cancelling while busy');
_Workflow.RequestCancel(reason := "Cancelled by test");

FOR cycleIndex := 1 TO 20 DO
	_Workflow.Execute();
	IF NOT _Workflow.Busy THEN
		EXIT;
	END_IF
END_FOR

AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_CANCELLED,
		Actual := _Workflow.State,
		Message := 'Workflow must transition to PASSIVE_CANCELLED'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestWorkflowReset" Id="{300d150a-46e9-4de3-9a65-aa69e7e32834}" FolderPath="Tests\">
      <Declaration><![CDATA[METHOD TestWorkflowReset
VAR
	cycleIndex : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

buildScenarioTree();

IF _Workflow.State = TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_COMPLETED THEN
	AssertTrue(Condition := _Workflow.ResettingAllowed, Message := 'ResettingAllowed must be TRUE for COMPLETED workflow');
	_Workflow.RequestReset();

	FOR cycleIndex := 1 TO 20 DO
		_Workflow.Execute();
		IF NOT _Workflow.Busy THEN
			EXIT;
		END_IF
	END_FOR

	AssertEquals_INT(
		Expected := TOF_Workflow.WORKFLOW_ELEMENT_STATE.PASSIVE_READY,
		Actual := _Workflow.State,
		Message := 'Workflow must reset to PASSIVE_READY'
	);
	AssertEquals_INT(Expected := 0, Actual := _Workflow.ProducedCount, Message := 'ProducedCount must be reset to 0');
	AssertFalse(Condition := _Workflow.ErrorHandled, Message := 'ErrorHandled must be reset to FALSE');
END_IF

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>