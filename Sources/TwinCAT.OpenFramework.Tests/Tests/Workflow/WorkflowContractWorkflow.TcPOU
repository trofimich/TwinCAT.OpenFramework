<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowContractWorkflow" Id="{b6ce7c43-77ab-4ec3-b8f2-3fabd09b4738}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Observes workflow hooks and injects one recoverable initialization failure.

Variable storage belongs to this persistent fixture. The initialization failure is raised only after one
ordinary binding was added, allowing the caller to observe the configured retry policy.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'no_assign'}
FUNCTION_BLOCK WorkflowContractWorkflow EXTENDS TOF_Workflow.Workflow
VAR_INPUT
	// Raises once after registering the initialization binding.
	throwInitialization : BOOL;
END_VAR
VAR_OUTPUT
	// Total calls to InitializeVariables.
	initializationCount : DINT;
	// Total calls to OnAfterRootActivityExecute.
	afterCount : DINT;
END_VAR
VAR_STAT
	// Distinct static field to avoid redeclaring inherited Workflow metadata.
	_ProbeClassName : STRING := __POUNAME();
END_VAR
VAR
	_RegisteredValue : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{f1c20fed-4365-4054-bfed-dd49b242f3b5}">
      <Declaration><![CDATA[(* Returns the initialized static name of this concrete fixture. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{02181012-bc3e-447a-a7c4-b88cde090f5c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ProbeClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b36792f7-f1bd-4687-b0d7-a3a701165a55}">
      <Declaration><![CDATA[(* Borrows the test project namespace without changing it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{26d36206-9d76-4ab1-8d37-92b65a0a404c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[// SA0006: Read-only namespace string borrowed across test tasks.
{analysis -6}
NamespaceName REF= CurrentNamespace.Name;
{analysis +6}]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9d992b5a-e449-4301-904d-dbe8afb5952e}">
      <Declaration><![CDATA[(* Reports the size of this concrete fixture in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f4e8703b-6af3-4cf4-a847-7bf995e49da1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="InitializeVariables" Id="{ffd75302-3b07-47f3-ad22-b2413fe6b079}">
      <Declaration><![CDATA[(* Registers persistent fixture storage and optionally interrupts the first attempt. *)
METHOD PROTECTED InitializeVariables]]></Declaration>
      <Implementation>
        <ST><![CDATA[initializationCount := initializationCount + 1;
BindPlcVariable(name := 'Initialized', plcVariable := _RegisteredValue);

IF throwInitialization THEN
	throwInitialization := FALSE;

	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Controlled variable initialization failure"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterRootActivityExecute" Id="{445fe8bb-c2a7-4429-9199-4a91e3760d3f}">
      <Declaration><![CDATA[(* Counts completion of the workflow execution boundary. *)
METHOD PROTECTED OnAfterRootActivityExecute]]></Declaration>
      <Implementation>
        <ST><![CDATA[afterCount := afterCount + 1;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
