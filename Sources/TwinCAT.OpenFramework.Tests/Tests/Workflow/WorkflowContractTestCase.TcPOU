<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WorkflowContractTestCase" Id="{a9805011-9553-4648-8b05-2eaaf2ddbf8a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Runs one workflow contract scenario in an isolated fixture.

Owns a freshly allocated fixture for the active run. AfterTest releases it after success or a reported
exception. A concrete pointer preserves FB_exit for the fixture and its nested resource owners.
Use one task. Do not copy the test case while it owns a fixture.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WorkflowContractTestCase EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Scenario : WORKFLOW_CONTRACT_TEST_SCENARIO;
	_Fixture : POINTER TO WorkflowContractTestFixture;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{9146b617-a2a7-4f45-95c9-bfdd47adcecc}">
      <Declaration><![CDATA[(*
Selects the scenario without allocating its fixture.
name — Name reported for this case.
parent — Group that owns this case.
scenario — Scenario selected for the case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	scenario : WORKFLOW_CONTRACT_TEST_SCENARIO;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_Scenario := scenario;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{48ac0298-3897-4b94-b6fe-b13f6e655c44}">
      <Declaration><![CDATA[(*
Allocates a fresh fixture and runs the selected scenario.

Terminal allocation failure is raised at the task boundary after case handling.
*)
METHOD PROTECTED ExecuteTest
VAR
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Fixture := __NEW(WorkflowContractTestFixture);

IF _Fixture = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();

	RETURN;
END_IF

assertions REF= Assert;
_Fixture^.ExecuteScenario(scenario := _Scenario, assertions := assertions);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{6e572add-4424-42f2-b9f6-cec8e1d72e94}">
      <Declaration><![CDATA[(*
Releases the fixture before the case outcome is published.

The framework records an exception from teardown. Clear the stored alias before releasing.
*)
METHOD PROTECTED AfterTest
VAR
	fixture : POINTER TO WorkflowContractTestFixture;
	released : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fixture := _Fixture;
_Fixture := 0;

IF fixture <> 0 THEN
	released := fixture^.TryReleaseLoadedWorkflow();
	__DELETE(fixture);

	IF NOT released THEN
		IF Outcome = TOF_Testing.TEST_OUTCOME.FAILED THEN
			Tc2_System.ADSLOGSTR(
				msgCtrlMask := Tc2_System.Global_Variables.ADSLOG_MSGTYPE_ERROR,
				msgFmtStr := 'Unable to release loaded workflow in %s',
				strArg := TO_STRING(Name)
			);
		ELSE
			RecordFailure(message := "Unable to release loaded workflow");
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{d8a5654c-2d07-4f02-a7fe-b2b5875fef04}">
      <Declaration><![CDATA[(*
Releases an active fixture if the case is unloaded before its teardown.

The fixture and its nested FB_exit paths complete without exceptions.
bInCopyCode — TwinCAT copy-code exit marker. The previous instance leaves copied storage alive.
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode AND_THEN _Fixture <> 0 THEN
	__DELETE(_Fixture);
END_IF

FB_exit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{328da49d-8149-4720-8732-fd346bf92ba7}">
      <Declaration><![CDATA[(* Borrows the concrete class name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{78a65a5e-2ced-48f4-92f3-5956dbd96e1e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{db80ad18-9a5a-4f2e-9f8e-680dd3ad375e}">
      <Declaration><![CDATA[(* Borrows the project namespace name. Callers must not modify it. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9a23cc24-cf38-4879-a699-a661cc70b96f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{64943f36-9b40-4817-aaaa-cad6841554fc}">
      <Declaration><![CDATA[(* Reports the complete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a087ab06-2409-4eb0-8d70-248cb6d890ef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
