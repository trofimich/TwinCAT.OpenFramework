<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RecoveryCatchTestActivity" Id="{9ef9cde4-4a42-4ce8-bb7c-9a980b08bccc}" SpecialFunc="None">
    <Declaration><![CDATA[(*
