(*!
<summary>Concrete CatchActivity implementation for testing TryCatch exception capture and recovery.</summary>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK RecoveryCatchTestActivity EXTENDS TOF_Workflow.CatchActivity
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Recovered : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{1173b19f-9d96-45f0-afe2-773bd386ab7a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c9c9a1df-27a4-45f5-8aba-4d02cde36f5b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{134a2567-5247-42c8-9c2a-d9cd426bc35e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e8f6db09-7587-4387-8e55-6fe1f0b42130}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnRunning" Id="{e2bc463e-e145-4216-9f96-737e127dba3c}">
      <Declaration><![CDATA[METHOD PROTECTED OnRunning : TOF_Workflow.ACTIVITY_RUNNING_STATE
VAR_INPUT
	startRunning : BOOL;
	startResuming : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR
VAR
	variableFound : BOOL;
	errorHandledVar : TOF_Core.GENERIC_VALUE;
	trueValue : BOOL := TRUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Recovered := TRUE;

variableFound := TryGetVariable('ErrorHandled', variable => errorHandledVar);
IF variableFound THEN
	errorHandledVar.ChangeValueByAnyType(trueValue, FALSE);
END_IF

OnRunning := TOF_Workflow.ACTIVITY_RUNNING_STATE.WORK_COMPLETED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnStopping" Id="{bf8c39bc-02d6-4406-a786-f5a04b4d568f}">
      <Declaration><![CDATA[METHOD PROTECTED OnStopping : TOF_Workflow.ACTIVITY_STOPPING_STATE
VAR_INPUT
	startCancelling : BOOL;
	startSuspending : BOOL;
END_VAR
VAR_OUTPUT
	haltReason : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnStopping := TOF_Workflow.ACTIVITY_STOPPING_STATE.WORK_STOPPED;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Recovered" Id="{3d14b445-b3e3-4a47-a045-23af0b665631}">
      <Declaration><![CDATA[PROPERTY Recovered : BOOL]]></Declaration>
      <Get Name="Get" Id="{6e2b5aea-0c16-4791-b124-246c5ae5d044}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Recovered := _Recovered;]]></ST>
        </Implementation>
      </Get>
    </Property>
  <Property Name="SelfSize" Id="{1b6f75d9-93b2-4e0e-b411-2608e1e2498f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f1973ea9-caf7-4e48-855f-ffdb09f3e7a4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
