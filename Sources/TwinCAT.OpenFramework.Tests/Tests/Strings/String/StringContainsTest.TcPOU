<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringContainsTest" Id="{6ece9a1d-ec14-4943-a0cf-42684b0d7575}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks exact, case-sensitive substring matching and empty inputs.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{188b8584-6195-4973-8536-0a23407fe8ab}">
      <Declaration><![CDATA[(*!
<summary>Checks exact, case-sensitive substring matching and empty inputs.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	containsResult : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'Hello');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for prefix substring"
).IsTrue();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'world');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for middle substring"
).IsTrue();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := '!');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for suffix substring"
).IsTrue();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'Hello, world!');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for identical string"
).IsTrue();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := '');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for empty substring in non-empty string"
).IsTrue();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := '', stringToFind := '');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for empty substring in empty string"
).IsTrue();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := '', stringToFind := 'a');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return FALSE for non-empty substring in empty string"
).IsFalse();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'xyz');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return FALSE when substring is absent"
).IsFalse();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'hello');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must be case-sensitive"
).IsFalse();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'abc', stringToFind := 'abcdef');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return FALSE when substring is longer than source"
).IsFalse();

containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'aaab', stringToFind := 'aab');
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must restart after a partially matching prefix"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{0e84f48f-c567-485b-aba8-d76960476fea}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7bd2d606-745e-4fca-9f96-2263c05ae51d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{eb333e5d-143b-46c2-b1df-4d96d10fdd65}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ff1bb96f-aad1-48ef-9afa-64112f959a51}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{28c5b7ab-d1c1-4de7-89b5-8c6852e7b780}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{bdd2bf19-d407-4403-af3b-732b2a38c94c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
