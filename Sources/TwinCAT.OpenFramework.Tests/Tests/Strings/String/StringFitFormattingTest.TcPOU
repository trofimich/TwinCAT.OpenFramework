<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringFitFormattingTest" Id="{fe7d34c1-1a48-4650-ba0c-def5f3c24d20}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks scalar and short text formatting through the fitted ANY API.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringFitFormattingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{cf41c2c2-d28f-4e94-822d-fef97c26c19d}">
      <Declaration><![CDATA[(*
Checks scalar and short text formatting through the fitted ANY API.

Compares the complete results for a 255-byte ASCII input and a 256-byte ASCII input requiring truncation.
*)
METHOD PROTECTED ExecuteTest
VAR
	formatted : STRING(255);
	enabled : BOOL := TRUE;
	number : DINT := 12345;
	narrowText : STRING(50) := 'Sample string';
	wideText : WSTRING(50) := "Sample wide string";
	longText : STRING(256);
	textBytes : POINTER TO BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formatted := TOF_Core.Strings.ConvertAnyToStringFit255(value := enabled);
Assert.ThatBool(
	actual := formatted = 'TRUE',
	message := "ConvertAnyToStringFit255 must format BOOL"
).IsTrue();

formatted := TOF_Core.Strings.ConvertAnyToStringFit255(value := number);
Assert.ThatBool(
	actual := formatted = '12345',
	message := "ConvertAnyToStringFit255 must format DINT"
).IsTrue();

formatted := TOF_Core.Strings.ConvertAnyToStringFit255(value := narrowText);
Assert.ThatBool(
	actual := formatted = 'Sample string',
	message := "ConvertAnyToStringFit255 must pass short STRING as-is"
).IsTrue();

formatted := TOF_Core.Strings.ConvertAnyToStringFit255(value := wideText);
Assert.ThatBool(
	actual := formatted = 'Sample wide string',
	message := "ConvertAnyToStringFit255 must convert short WSTRING to STRING"
).IsTrue();

// SA0175: Use byte offsets for a bounded ASCII fixture of known size.
{analysis -175}
textBytes := ADR(longText);
{analysis +175}
Tc2_System.MEMSET(destAddr := textBytes, fillByte := BYTE#16#61, n := 255);
textBytes[255] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);
textBytes[256] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);

formatted := TOF_Core.Strings.ConvertAnyToStringFit255(value := longText);
Assert.ThatBool(
	actual := Tc2_Standard.LEN(STR := formatted) = 255 AND_THEN formatted = longText,
	message := "An exact-fit STRING must preserve all 255 bytes"
).IsTrue();

textBytes[255] := BYTE#16#61;
formatted := TOF_Core.Strings.ConvertAnyToStringFit255(value := longText);

// Form the expected output independently with 252 ASCII letters followed by three periods.
Tc2_System.MEMSET(destAddr := textBytes + 252, fillByte := BYTE#16#2E, n := 3);
textBytes[255] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);
Assert.ThatBool(
	actual := Tc2_Standard.LEN(STR := formatted) = 255 AND_THEN formatted = longText,
	message := "A 256-byte STRING must retain 252 bytes and append three dots"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{0373e9b4-3832-4d97-baa0-a8df5254a885}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d8744daa-b315-492c-8dae-48a13fa6d2fb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{31dace38-4fbe-4d6f-9a5f-ef91396123f8}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{14f746ae-60f9-4dff-ad1c-150bf47b033a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{219cde62-1e21-4fbe-be72-43e8db2a5b2a}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b0fe5774-4d2f-4cfe-b43e-ed02256aaf25}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
