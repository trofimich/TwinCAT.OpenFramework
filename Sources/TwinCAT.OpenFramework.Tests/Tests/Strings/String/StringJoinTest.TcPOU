<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringJoinTest" Id="{c8768789-bd41-4bd0-b0ca-488801c6d010}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks full and windowed joining, missing cursors and reuse after insufficient capacity.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringJoinTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Source : STRING := '123 , , 456, 789 ,0';
	_Splitter : TOF_Core.StringSplittingEnumerator;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{54c50b31-ade0-4d37-9420-f9ab6f4b0f3c}">
      <Declaration><![CDATA[(*
Checks full and windowed joining, missing cursors and reuse after insufficient capacity.

The missing cursor leaves a nonempty target intact. A live cursor can then use the same target. This test owns
a persistent cursor and its borrowed source. Reset releases the current fragment before reporting.
*)
METHOD PROTECTED ExecuteTest
VAR
	separator : STRING := ',';
	joined : STRING := 'old target';
	shortTarget : STRING(2);
	accepted : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[accepted := TOF_Core.Strings.TryJoin(
	targetString := joined,
	separator := separator,
	sourceEnumerator := 0
);
Assert.ThatBool(actual := accepted, message := "TryJoin must reject a missing cursor").IsFalse();
Assert.ThatBool(
	actual := joined = 'old target',
	message := "TryJoin must preserve the target when the cursor is missing"
).IsTrue();

_Splitter := TOF_Core.Strings.CreateSplitter(sourceString := _Source, separator := separator);
TOF_Core.Strings.Join(targetString := joined, separator := separator, sourceEnumerator := _Splitter);
Assert.ThatBool(
	actual := joined = _Source,
	message := "Unrestricted Join must reconstruct all fragments including their whitespace"
).IsTrue();

_Splitter.Reset();
_Splitter := TOF_Core.Strings.CreateSplitter(
	sourceString := _Source,
	separator := separator,
	maxCount := 3,
	trimEntries := TRUE,
	removeEmptyEntries := TRUE
);
TOF_Core.Strings.Join(
	targetString := joined,
	separator := separator,
	sourceEnumerator := _Splitter,
	startIndex := 1,
	count := 2
);
Assert.ThatBool(
	actual := joined = '456,789',
	message := "The requested window must contain fragments 1 and 2"
).IsTrue();

_Splitter.Reset();
accepted := TOF_Core.Strings.TryJoin(targetString := shortTarget, separator := separator, sourceEnumerator := _Splitter);
Assert.ThatBool(
	actual := accepted,
	message := "TryJoin must reject a target too small for the first fragment"
).IsFalse();

_Splitter.Reset();
accepted := TOF_Core.Strings.TryJoin(
	targetString := joined,
	separator := separator,
	sourceEnumerator := _Splitter,
	count := 1
);
Assert.ThatBool(
	actual := accepted AND_THEN joined = '123',
	message := "After Reset, TryJoin must restart and replace the old target text"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{43a92498-5d4d-41dd-8275-2820bc42fa64}">
      <Declaration><![CDATA[(*
Resets the splitter and releases any active fragment before reporting.

Safe after partial initialization and after explicit cleanup in the scenario.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Splitter.Reset();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{79e0b534-a61f-4f38-9fe8-0da2851208ba}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{215a8ae3-1ea4-4b91-bc49-8cc0d4dee3ec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{cac03636-e2ff-40d5-9305-c95241594bce}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d6ad1ed0-55ec-4946-8516-f34873e5f8ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{732342f9-774b-46a2-ac81-3f2605faa1b4}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4becf984-735f-4f34-aee9-d17a1a5c3596}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
