<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringBuilderAssignmentFailureTest" Id="{af43afb1-fb29-4628-80bd-e33350ddbf86}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks the concrete assignment failures and recovery with a matching buffer.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringBuilderAssignmentFailureTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Builder : TOF_Core.StringBuilder;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{9586f9ed-636c-42d3-ade8-c23ea2a757d3}">
      <Declaration><![CDATA[(*
Checks the concrete assignment failures and recovery with a matching buffer.

The builder is persistent so teardown can release its buffer after an unexpected hook exception.
*)
METHOD PROTECTED ExecuteTest
VAR
	wideTarget : WSTRING := "wide sentinel";
	shortTarget : STRING(10) := 'keep';
	exactTarget : STRING(16);

	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	typeException : TOF_Core.IArgumentTypeClassNotSupportedException;
	capacityException : TOF_Core.ITargetVariableMemoryOverflowException;
	copied : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Builder.AppendString255(value := 'String1234567890');

// Invoke a wrong-width target and check that the argument is rejected before modification.
__TRY
	_Builder.AssignToString(targetString := wideTarget);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, typeException),
	message := "AssignToString must report an incompatible WSTRING target"
).IsTrue();
Assert.ThatBool(
	actual := wideTarget = "wide sentinel",
	message := "Wrong-width assignment must preserve the target"
).IsTrue();

caught := 0;

// Invoke an undersized STRING target and capture the documented capacity exception.
__TRY
	_Builder.AssignToString(targetString := shortTarget);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, capacityException),
	message := "AssignToString must report insufficient capacity"
).IsTrue();
Assert.ThatBool(
	actual := shortTarget = 'keep',
	message := "Capacity rejection must preserve the target"
).IsTrue();

copied := _Builder.AssignToString(targetString := exactTarget);
Assert.ThatBool(
	actual := copied AND_THEN exactTarget = 'String1234567890',
	message := "The same builder must still copy successfully into the exact-fit target"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{419d7ab1-93fe-4a83-a3b0-5d6f3701210c}">
      <Declaration><![CDATA[(*
Releases the builder buffer before reporting the case result.

Safe after partial initialization and after explicit cleanup in the scenario.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Builder.Clear(releaseMemory := TRUE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{09da30b5-3f15-4e23-a65e-8e2abc3e1862}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{adf34ab2-3134-4b20-b629-f19a70459d39}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{450f895f-49ba-4a18-9226-05873ea58001}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ab4d2755-e6a3-4b1b-85a0-a4da2a1d67ce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d5a2d51e-a138-4338-a97c-811d76fed423}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8372e739-a2ea-4f77-8a20-a90793849d7d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
