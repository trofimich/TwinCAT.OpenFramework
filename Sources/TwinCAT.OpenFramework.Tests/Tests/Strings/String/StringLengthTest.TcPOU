<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringLengthTest" Id="{98ca89f8-e2d4-49e0-a53f-3ac4b9fb348e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks byte length and UTF-8 code point counting.</summary>
<description>Uses one task and a stable instance address while assertions are bound.</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringLengthTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{7c94d878-7e7d-41af-b1b0-88f2ef51e482}">
      <Declaration><![CDATA[//! <summary>Checks byte and code point counts on the same input.</summary>
METHOD PROTECTED ExecuteTest
VAR
	{attribute 'TcEncoding' := 'UTF-8'}
	value : STRING(10);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[value := UTF8#'AЯ€😀';
Assert.ThatBool(
	actual := TOF_Core.Strings.GetLength(value := value) = 10,
	message := "GetLength must count bytes and exclude the terminator"
).IsTrue();
Assert.ThatBool(
	actual := TOF_Core.Strings.GetUtf8CodePointCount(value := value) = 4,
	message := "GetUtf8CodePointCount must count each one- to four-byte sequence once"
).IsTrue();

value := '';
Assert.ThatBool(
	actual := TOF_Core.Strings.GetUtf8CodePointCount(value := value) = 0,
	message := "GetUtf8CodePointCount must return zero for an empty string"
).IsTrue();

// SA0175: Construct an isolated UTF-8 continuation byte (0x80) and its terminator.
{analysis -175}
value[0] := BYTE#16#80;
value[1] := BYTE#0;
{analysis +175}
Assert.ThatBool(
	actual := TOF_Core.Strings.GetUtf8CodePointCount(value := value) = 0,
	message := "GetUtf8CodePointCount must return zero for an isolated continuation byte"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{eccb81f0-d120-43bd-bae9-a2ec1adc9b7f}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c78d26c8-5f0b-44a9-b9c8-efb4cb640224}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1a3c2a62-a5be-4023-927e-b095d884c5f5}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6fe6d828-3edd-4b09-b7bd-42de6d4fc1c6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{24437e84-e976-48bb-913e-d34d4fedbab5}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f57b46ae-cdac-42e9-a1b8-073da4c276ab}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
