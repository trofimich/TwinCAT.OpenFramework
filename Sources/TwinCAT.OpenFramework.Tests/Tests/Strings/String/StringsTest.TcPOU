FUNCTION_BLOCK StringsTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Append();
AppendFit();
ConcatFit255();
AnyToStringFit255();
ReplaceInSource();
Split();
Join();
Trim();]]></ST>
    </Implementation>
    <Method Name="AnyToStringFit255" Id="{70bc4877-2397-45cc-b97f-b93d73c158a4}">
      <Declaration><![CDATA[METHOD AnyToStringFit255
VAR
	anyResult : STRING(255);
	boolVal : BOOL := TRUE;
	intVal : DINT := 12345;
	shortStr : STRING(50) := 'Sample string';
	shortWstr : WSTRING(50) := "Sample wide string";
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Format boolean
anyResult := TOF_Core.Strings.AnyToStringFit255(value := boolVal);
AssertEquals_STRING(Expected := 'TRUE', Actual := anyResult, Message := 'AnyToStringFit255 must format BOOL');

// 2. Format integer
anyResult := TOF_Core.Strings.AnyToStringFit255(value := intVal);
AssertEquals_STRING(Expected := '12345', Actual := anyResult, Message := 'AnyToStringFit255 must format DINT');

// 3. Format STRING that fits in 255
anyResult := TOF_Core.Strings.AnyToStringFit255(value := shortStr);
AssertEquals_STRING(
		Expected := 'Sample string',
		Actual := anyResult,
		Message := 'AnyToStringFit255 must pass short STRING as-is'
	);

// 4. Format WSTRING that fits in 255
anyResult := TOF_Core.Strings.AnyToStringFit255(value := shortWstr);
AssertEquals_STRING(
		Expected := 'Sample wide string',
		Actual := anyResult,
		Message := 'AnyToStringFit255 must convert short WSTRING to STRING'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Append" Id="{dfc63422-169c-4318-97d7-f4972908ec69}">
      <Declaration><![CDATA[METHOD Append
VAR
	testString : STRING;

	expectedString : STRING := 'Original string + first appended string + second appended string';
	
	stringToAppend_1 : STRING := 'first appended string';
	stringToAppend_2 : STRING := 'second appended string';
	plusString : STRING := ' + ';
	
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

testString := 'Original string';
TOF_Core.Strings.Append255(testString, ' + ', stringToAppend_1, ' + ', stringToAppend_2);
AssertEquals_STRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid String.Append255 method result'
	);

testString := 'Original string';
result := TOF_Core.Strings.TryAppend255(testString, ' + ', stringToAppend_1, ' + ', stringToAppend_2);
AssertEquals_STRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid String.TryAppend255 method result'
	);
AssertEquals_BOOL(Expected := result, Actual := TRUE, Message := 'Invalid String.TryAppend255 method returned result');

result := TOF_Core.Strings.TryAppend255(testString, ' + ', stringToAppend_1);
AssertEquals_BOOL(Expected := result, Actual := FALSE, Message := 'Invalid String.TryAppend255 method returned result');

testString := 'Original string';
TOF_Core.Strings.Append(targetString := testString, sourceString := plusString);
TOF_Core.Strings.Append(targetString := testString, sourceString := stringToAppend_1);
TOF_Core.Strings.Append(targetString := testString, sourceString := plusString);
TOF_Core.Strings.Append(targetString := testString, sourceString := stringToAppend_2);
AssertEquals_STRING(Expected := expectedString, Actual := testString, Message := 'Invalid String.Append method result');

testString := 'Original string';
result := TOF_Core.Strings.TryAppend(targetString := testString, sourceString := plusString)
	AND TOF_Core.Strings.TryAppend(targetString := testString, sourceString := stringToAppend_1)
	AND TOF_Core.Strings.TryAppend(targetString := testString, sourceString := plusString)
	AND TOF_Core.Strings.TryAppend(targetString := testString, sourceString := stringToAppend_2);
AssertEquals_STRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid String.TryAppend method result'
	);
AssertEquals_BOOL(Expected := result, Actual := TRUE, Message := 'Invalid String.TryAppend method returned result');

result := TOF_Core.Strings.TryAppend(targetString := testString, sourceString := plusString)
	AND TOF_Core.Strings.TryAppend(targetString := testString, sourceString := stringToAppend_1);
AssertEquals_BOOL(Expected := result, Actual := FALSE, Message := 'Invalid String.TryAppend method returned result');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendFit" Id="{dfc63422-169c-4318-97d7-f49729080001}">
      <Declaration><![CDATA[METHOD AppendFit
VAR
	testShort : STRING(10);
	sourceLong : STRING(30) := '01234567890123456789';
	res : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Fits within capacity
testShort := '12345';
TOF_Core.Strings.AppendFit(targetString := testShort, sourceString := '67');
AssertEquals_STRING(
		Expected := '1234567',
		Actual := testShort,
		Message := 'AppendFit must append normally when it fits'
	);

// 2. Exact fit: fills capacity without ellipsis
testShort := '12345';
TOF_Core.Strings.AppendFit(targetString := testShort, sourceString := '67890');
AssertEquals_STRING(
		Expected := '1234567890',
		Actual := testShort,
		Message := 'AppendFit must fit exactly without ellipsis'
	);

// 3. Overflow by 1 char: truncates and appends '...'
testShort := '12345';
TOF_Core.Strings.AppendFit(targetString := testShort, sourceString := '678901');
AssertEquals_STRING(
		Expected := '1234567...',
		Actual := testShort,
		Message := 'AppendFit must truncate and append ... on 1 char overflow'
	);

// 4. Overflow by many chars: truncates and appends '...'
testShort := '12345';
TOF_Core.Strings.AppendFit(targetString := testShort, sourceString := sourceLong);
AssertEquals_STRING(
		Expected := '1234501...',
		Actual := testShort,
		Message := 'AppendFit must truncate and append ... on large overflow'
	);

// 5. Empty source: target remains unchanged
testShort := '12345';
TOF_Core.Strings.AppendFit(targetString := testShort, sourceString := '');
AssertEquals_STRING(
		Expected := '12345',
		Actual := testShort,
		Message := 'AppendFit must leave target unchanged for empty source'
	);

// 6. Appending to empty target
testShort := '';
TOF_Core.Strings.AppendFit(targetString := testShort, sourceString := sourceLong);
AssertEquals_STRING(
		Expected := '0123456...',
		Actual := testShort,
		Message := 'AppendFit to empty target must truncate and append ...'
	);

// 7. TryAppendFit normal fit
testShort := '123';
res := TOF_Core.Strings.TryAppendFit(targetString := testShort, sourceString := '45');
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit must return TRUE on normal fit');
AssertEquals_STRING(Expected := '12345', Actual := testShort, Message := 'TryAppendFit must append text');

// 8. TryAppendFit overflow
testShort := '12345';
res := TOF_Core.Strings.TryAppendFit(targetString := testShort, sourceString := sourceLong);
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit must return TRUE on overflow');
AssertEquals_STRING(
		Expected := '1234501...',
		Actual := testShort,
		Message := 'TryAppendFit must truncate and append ...'
	);

// 9. AppendFit255 multiple arguments and literals
testShort := '12';
TOF_Core.Strings.AppendFit255(testShort, '3', '4', '5');
AssertEquals_STRING(Expected := '12345', Actual := testShort, Message := 'AppendFit255 must append multiple fragments');

// 10. AppendFit255 overflow truncation
testShort := '12';
TOF_Core.Strings.AppendFit255(testShort, '345', '678', '9012');
AssertEquals_STRING(
		Expected := '1234567...',
		Actual := testShort,
		Message := 'AppendFit255 must truncate and append ... on overflow'
	);

// 11. TryAppendFit255 normal fit
testShort := '12';
res := TOF_Core.Strings.TryAppendFit255(testShort, '3', '4', '5');
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit255 must return TRUE on normal fit');
AssertEquals_STRING(
		Expected := '12345',
		Actual := testShort,
		Message := 'TryAppendFit255 must append multiple fragments'
	);

// 12. TryAppendFit255 overflow
testShort := '12';
res := TOF_Core.Strings.TryAppendFit255(testShort, '345', '678', '9012');
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit255 must return TRUE on overflow');
AssertEquals_STRING(
		Expected := '1234567...',
		Actual := testShort,
		Message := 'TryAppendFit255 must truncate and append ... on overflow'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b8985102-dc15-41e1-ae23-7d62e6866a91}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{03ded19b-ca6c-4934-9ab2-2e75c95c0490}">
