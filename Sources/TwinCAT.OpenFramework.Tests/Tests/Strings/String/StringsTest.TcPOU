      </Get>
    </Property>
    <Method Name="ConcatFit255" Id="{1dde581b-fb53-48b6-9cfa-4f73702d857b}">
      <Declaration><![CDATA[METHOD ConcatFit255
VAR
	concatResult : STRING(255);
	part1 : STRING(100);
	part2 : STRING(100);
	part3 : STRING(100);
	foundEllipsis : BOOL;
	ellipsisPosition : UDINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Normal concatenation that fits in 255
concatResult := TOF_Core.Strings.ConcatFit255('Hello, ', 'World!');
AssertEquals_STRING(
		Expected := 'Hello, World!',
		Actual := concatResult,
		Message := 'ConcatFit255 must join strings normally'
	);

// 2. Skipping empty fragments
concatResult := TOF_Core.Strings.ConcatFit255('Part1', '', 'Part2', '', 'Part3');
AssertEquals_STRING(
		Expected := 'Part1Part2Part3',
		Actual := concatResult,
		Message := 'ConcatFit255 must skip empty fragments'
	);

// 3. Overflowing 255 characters: must truncate to 255 and end with '...'
part1 := '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789';
part2 := '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789';
part3 := '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789';

concatResult := TOF_Core.Strings.ConcatFit255(part1, part2, part3);
AssertEquals_INT(
		Expected := 255,
		Actual := Tc2_Standard.LEN(STR := concatResult),
		Message := 'ConcatFit255 must truncate to 255 characters on overflow'
	);
foundEllipsis := TOF_Core.Strings.Find(stringToSearchIn := concatResult, stringToFind := '...', position => ellipsisPosition);
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := foundEllipsis,
		Message := 'ConcatFit255 must contain ellipsis on overflow'
	);
AssertEquals_UDINT(
		Expected := 253,
		Actual := ellipsisPosition,
		Message := 'ConcatFit255 must end with ellipsis on overflow'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{a6da2b09-cedd-453c-aa96-fdc16371ec95}">
      <Declaration><![CDATA[METHOD Contains
VAR
	containsResult : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Substring at start
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'Hello');
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for prefix substring'
);

// 2. Substring in middle
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'world');
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for middle substring'
);

// 3. Substring at end
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := '!');
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for suffix substring'
);

// 4. Exact match of whole string
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'Hello, world!');
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for identical string'
);

// 5. Empty substring in non-empty string
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := '');
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for empty substring in non-empty string'
);

// 6. Empty substring in empty string
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := '', stringToFind := '');
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for empty substring in empty string'
);

// 7. Non-empty substring in empty string
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := '', stringToFind := 'a');
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must return FALSE for non-empty substring in empty string'
);

// 8. Substring not found
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'xyz');
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must return FALSE when substring is absent'
);

// 9. Case sensitivity
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'Hello, world!', stringToFind := 'hello');
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must be case-sensitive'
);

// 10. Substring longer than source
containsResult := TOF_Core.Strings.Contains(stringToSearchIn := 'abc', stringToFind := 'abcdef');
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must return FALSE when substring is longer than source'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Join" Id="{ad5df54c-ebe3-4f2b-b686-f2235cc5e4f3}">
      <Declaration><![CDATA[(*!
<summary>Exercises string traversal with a persistent splitter and borrowed source.</summary>
<description>
The splitter retains ownership across exception propagation; Reset releases current fragments before reuse
and normal completion. The persistent source remains alive for the entire cursor lifetime.
</description>
*)
METHOD Join
VAR
	separator : STRING := ',';

	joinedString1, joinedString2 : STRING;
END_VAR
VAR_INST
	stringToSplit : STRING := '123 , , 456, 789 ,0';
	splitter : TOF_Core.StringSplittingEnumerator;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// simple splitting
splitter.Reset();
splitter := TOF_Core.Strings.CreateSplitter(sourceString := stringToSplit, separator := separator);

// simple joining
TOF_Core.Strings.Join(targetString := joinedString1, separator := separator, sourceEnumerator := splitter);

AssertEquals_STRING(
		Expected := stringToSplit,
		Actual := joinedString1,
		Message := TOF_Core.Strings.Concat255('Invalid first Strings.Join result string ', joinedString1)
	);

// splitting with maxCount, trimming and empty string removing 
splitter.Reset();
splitter := TOF_Core.Strings.CreateSplitter(
	sourceString := stringToSplit,
	separator := separator,
	maxCount := 3,
	trimEntries := TRUE,
	removeEmptyEntries := TRUE
);

// joining with startIndex and count
TOF_Core.Strings.Join(targetString := joinedString2, separator := separator, sourceEnumerator := splitter, startIndex := 1, count := 2);

AssertEquals_STRING(
		Expected := '456,789',
		Actual := joinedString2,
		Message := TOF_Core.Strings.Concat255('Invalid second Strings.Join result string ', joinedString2)
	);

splitter.Reset();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{02163062-dd40-4429-a0a8-5c360f5da8fb}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{459ad87f-22cb-4069-bbe1-8915f5177a12}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReplaceInSource" Id="{acab7dc3-475e-41e3-9ac6-f109a2619017}">
      <Declaration><![CDATA[METHOD ReplaceInSource
VAR
	testString : STRING(18);
	
	replacementCount : UINT;
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

testString := 'abcd_abcd_abcd';
TOF_Core.Strings.ReplaceInSource(
	sourceString := testString,
	oldSubstring := 'bc',
	newSubstring := '0',
	replacementCount => replacementCount
);
AssertEquals_STRING(
		Expected := 'a0d_a0d_a0d',
		Actual := testString,
		Message := 'Invalid String.ReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 3,
		Actual := replacementCount,
		Message := 'Invalid String.ReplaceInSource replacingCount count'
	);

testString := 'abcd_abcd_abcd';
TOF_Core.Strings.ReplaceInSource(
	sourceString := testString,
	oldSubstring := 'bc',
	newSubstring := '123',
	replacementCount => replacementCount
);
AssertEquals_STRING(
		Expected := 'a123d_a123d_a123d',
		Actual := testString,
		Message := 'Invalid String.ReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 3,
		Actual := replacementCount,
		Message := 'Invalid String.ReplaceInSource replacingCount count'
	);

testString := 'abcd_abcd_abcd';
result := TOF_Core.Strings.TryReplaceInSource(
	sourceString := testString,
	oldSubstring := 'bc',
	newSubstring := '0',
	replacementCount => replacementCount
);
AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Invalid String.TryReplaceInSource result');
AssertEquals_STRING(
		Expected := 'a0d_a0d_a0d',
		Actual := testString,
		Message := 'Invalid String.TryReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 3,
		Actual := replacementCount,
		Message := 'Invalid String.TryReplaceInSource replacingCount count'
	);

testString := 'abcd_abcd_abcd';
result := TOF_Core.Strings.TryReplaceInSource(
	sourceString := testString,
	oldSubstring := 'bc',
	newSubstring := '123',
	maxReplacements := 1,
	skipReplacements := 1,
	replacementCount => replacementCount
);
AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Invalid String.TryReplaceInSource result');
AssertEquals_STRING(
		Expected := 'abcd_a123d_abcd',
		Actual := testString,
		Message := 'Invalid String.TryReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 1,
		Actual := replacementCount,
		Message := 'Invalid String.TryReplaceInSource replacingCount count'
	);

testString := 'abcd_abcd_abcd';
result := TOF_Core.Strings.TryReplaceInSource(
	sourceString := testString,
	oldSubstring := 'bc',
	newSubstring := '1234',
	replacementCount => replacementCount
);
AssertEquals_BOOL(Expected := FALSE, Actual := result, Message := 'Invalid String.TryReplaceInSource memory handling');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Split" Id="{afcb1a60-4677-4461-950d-5644dc25733b}">
      <Declaration><![CDATA[(*!
<summary>Exercises string traversal with a persistent splitter and borrowed source.</summary>
<description>
The splitter retains ownership across exception propagation; Reset releases current fragments before reuse
and normal completion. The persistent source remains alive for the entire cursor lifetime.
</description>
*)
METHOD Split
VAR
	separator : STRING := ',';
	
	currentEntry : STRING;
	i : BYTE;
END_VAR
VAR_INST
	stringToSplit : STRING := '123 , , 456, 789 ,0';
	splitter : TOF_Core.StringSplittingEnumerator;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// simple splitting
splitter.Reset();
splitter := TOF_Core.Strings.CreateSplitter(sourceString := stringToSplit, separator := separator);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_STRING(Expected := '123 ', Actual := currentEntry, Message := 'Invalid StringSplitter entry #0');			
		1:
			AssertEquals_STRING(Expected := ' ', Actual := currentEntry, Message := 'Invalid StringSplitter entry #3');
		2:
			AssertEquals_STRING(Expected := ' 456', Actual := currentEntry, Message := 'Invalid StringSplitter entry #1');
		3:
			AssertEquals_STRING(Expected := ' 789 ', Actual := currentEntry, Message := 'Invalid StringSplitter entry #2');
		4:
			AssertEquals_STRING(Expected := '0', Actual := currentEntry, Message := 'Invalid StringSplitter entry #4');
	END_CASE	
	
	i := i + 1;
END_WHILE

AssertEquals_BYTE(Expected := 5, Actual := i, Message := 'Unrestricted splitting must return all five fragments');

// splitting with maxCount, trimming and empty string removing 
splitter.Reset();
splitter := TOF_Core.Strings.CreateSplitter(
	sourceString := stringToSplit,
	separator := separator,
	maxCount := 3,
	trimEntries := TRUE,
	removeEmptyEntries := TRUE
);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_STRING(Expected := '123', Actual := currentEntry, Message := 'Invalid StringSplitter entry #0');			
		1:
			AssertEquals_STRING(Expected := '456', Actual := currentEntry, Message := 'Invalid StringSplitter entry #1');
		2:
			AssertEquals_STRING(Expected := '789', Actual := currentEntry, Message := 'Invalid StringSplitter entry #2');
		ELSE
			AssertEquals_BOOL(Expected := TRUE, Actual := FALSE, Message := 'Invalid StringSplitter MaxCount handling');
	END_CASE	
	
	i := i + 1;
END_WHILE

AssertEquals_BYTE(Expected := 3, Actual := i, Message := 'MaxCount splitting must return exactly three fragments');

splitter.Reset();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Trim" Id="{4efc06d8-47aa-41ec-86fa-bcfd7ab44822}">
      <Declaration><![CDATA[METHOD Trim
VAR
	trimString : STRING;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

trimString := '  123   ';
TOF_Core.Strings.TrimChar(stringToTrim := trimString, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT);
AssertEquals_STRING(
		Expected := '123',
		Actual := trimString,
		Message := 'Invalid string trimming result (TRIM_MODE = LEFT_AND_RIGHT)'
	);			

trimString := '  123   ';
TOF_Core.Strings.TrimChar(stringToTrim := trimString, trimMode := TOF_Core.TRIM_MODE.LEFT);
AssertEquals_STRING(
		Expected := '123   ',
		Actual := trimString,
		Message := 'Invalid string trimming result (TRIM_MODE = LEFT)'
	);			

trimString := '  123   ';
TOF_Core.Strings.TrimChar(stringToTrim := trimString, trimMode := TOF_Core.TRIM_MODE.RIGHT);
AssertEquals_STRING(
		Expected := '  123',
		Actual := trimString,
		Message := 'Invalid string trimming result (TRIM_MODE = RIGHT)'
	);			

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SplitterSeparatorBounds" Id="{be95fd25-e693-4a31-bb87-7c1a87f483b7}">
      <Declaration><![CDATA[(*!
<summary>Checks separator rejection before fixed-size splitter storage can truncate the argument.</summary>
<description>
Covers lengths 80, 81, 255 and 256 through throwing and Try APIs. Uses persistent source and splitter storage.
Separator setup writes bounded ASCII byte sequences. Reset releases every fragment before reuse.
The runner owns caught exception cleanup at the task boundary.
</description>
*)
METHOD SplitterSeparatorBounds
VAR
	separatorLength : UINT;
	missingSource : REFERENCE TO STRING;
	separatorBytes : POINTER TO BYTE;
	i : INT;
	caught : BOOL;
	result : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	rangeException : TOF_Core.IArgumentOutOfRangeException;
END_VAR
VAR_INST
	source : STRING := 'x';
	separator : STRING(256);
	splitter : TOF_Core.StringSplittingEnumerator;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
// SA0175: The pointer fills a bounded ASCII separator buffer; no UTF-8 character indexing is used.
{analysis -175}
separatorBytes := ADR(separator);
{analysis +175}

FOR i := 0 TO 3 DO
	CASE i OF
		0:
			separatorLength := 80;
		1:
			separatorLength := 81;
		2:
			separatorLength := 255;
		3:
			separatorLength := 256;
	END_CASE

	Tc2_System.MEMSET(destAddr := separatorBytes, fillByte := 0, n := SIZEOF(separator));
	Tc2_System.MEMSET(destAddr := separatorBytes, fillByte := BYTE#16#61, n := separatorLength);

	result := TOF_Core.Strings.TryCreateSplitter(sourceString := source, separator := separator, splitter => splitter);
	AssertEquals_BOOL(
		Expected := separatorLength = 80,
		Actual := result,
		Message := 'TryCreateSplitter must accept 80 and reject every longer separator'
	);
	splitter.Reset();
	caught := FALSE;

	__TRY
		splitter := TOF_Core.Strings.CreateSplitter(sourceString := source, separator := separator);
	__CATCH(exceptionCode)
		caught := TRUE;
		exception := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		AssertEquals_BOOL(
			Expected := TRUE,
			Actual := __QUERYINTERFACE(exception, rangeException),
			Message := 'An overlong separator must raise ArgumentOutOfRangeException'
		);
	__ENDTRY

	AssertEquals_BOOL(
		Expected := separatorLength > 80,
		Actual := caught,
		Message := 'CreateSplitter must reject overlong separators before initialization'
	);
	splitter.Reset();
END_FOR

caught := FALSE;

__TRY
	result := TOF_Core.Strings.TryCreateSplitter(
		sourceString := missingSource,
		separator := ',',
		splitter => splitter
	);
__CATCH
	caught := TRUE;
__ENDTRY

AssertEquals_BOOL(Expected := FALSE, Actual := caught, Message := 'TryCreateSplitter must contain source failures');
AssertEquals_BOOL(Expected := FALSE, Actual := result, Message := 'A missing source must not initialize a splitter');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>