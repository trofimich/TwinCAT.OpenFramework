FUNCTION_BLOCK StringsTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Append();
AppendFit();
ConcatFit255();
AnyToStringFit255();
ReplaceInSource();
Split();
Join();
Trim();]]></ST>
    </Implementation>
    <Method Name="AnyToStringFit255" Id="{70bc4877-2397-45cc-b97f-b93d73c158a4}">
      <Declaration><![CDATA[METHOD AnyToStringFit255
VAR
	anyResult : STRING(255);
	boolVal : BOOL := TRUE;
	intVal : DINT := 12345;
	shortStr : STRING(50) := 'Sample string';
	shortWstr : WSTRING(50) := "Sample wide string";
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// 1. Format boolean
anyResult := TOF_Core.Strings.AnyToStringFit255(boolVal);
AssertEquals_STRING('TRUE', anyResult, 'AnyToStringFit255 must format BOOL');

// 2. Format integer
anyResult := TOF_Core.Strings.AnyToStringFit255(intVal);
AssertEquals_STRING('12345', anyResult, 'AnyToStringFit255 must format DINT');

// 3. Format STRING that fits in 255
anyResult := TOF_Core.Strings.AnyToStringFit255(shortStr);
AssertEquals_STRING('Sample string', anyResult, 'AnyToStringFit255 must pass short STRING as-is');

// 4. Format WSTRING that fits in 255
anyResult := TOF_Core.Strings.AnyToStringFit255(shortWstr);
AssertEquals_STRING('Sample wide string', anyResult, 'AnyToStringFit255 must convert short WSTRING to STRING');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Append" Id="{dfc63422-169c-4318-97d7-f4972908ec69}">
      <Declaration><![CDATA[METHOD Append
VAR
	testString : STRING;

	expectedString : STRING := 'Original string + first appended string + second appended string';
	
	stringToAppend_1 : STRING := 'first appended string';
	stringToAppend_2 : STRING := 'second appended string';
	plusString : STRING := ' + ';
	
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

testString := 'Original string';
TOF_Core.Strings.Append255(testString, ' + ', stringToAppend_1, ' + ', stringToAppend_2);
AssertEquals_STRING(expectedString, testString, 'Invalid String.Append255 method result');

testString := 'Original string';
result := TOF_Core.Strings.TryAppend255(testString, ' + ', stringToAppend_1, ' + ', stringToAppend_2);
AssertEquals_STRING(expectedString, testString, 'Invalid String.TryAppend255 method result');
AssertEquals_BOOL(result, TRUE, 'Invalid String.TryAppend255 method returned result');

result := TOF_Core.Strings.TryAppend255(testString, ' + ', stringToAppend_1);
AssertEquals_BOOL(result, FALSE, 'Invalid String.TryAppend255 method returned result');

testString := 'Original string';
TOF_Core.Strings.Append(testString, plusString);
TOF_Core.Strings.Append(testString, stringToAppend_1);
TOF_Core.Strings.Append(testString, plusString);
TOF_Core.Strings.Append(testString, stringToAppend_2);
AssertEquals_STRING(expectedString, testString, 'Invalid String.Append method result');

testString := 'Original string';
result := TOF_Core.Strings.TryAppend(testString, plusString)
	AND TOF_Core.Strings.TryAppend(testString, stringToAppend_1)
	AND TOF_Core.Strings.TryAppend(testString, plusString)
	AND TOF_Core.Strings.TryAppend(testString, stringToAppend_2);
AssertEquals_STRING(expectedString, testString, 'Invalid String.TryAppend method result');
AssertEquals_BOOL(result, TRUE, 'Invalid String.TryAppend method returned result');

result := TOF_Core.Strings.TryAppend(testString, plusString)
	AND TOF_Core.Strings.TryAppend(testString, stringToAppend_1);
AssertEquals_BOOL(result, FALSE, 'Invalid String.TryAppend method returned result');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendFit" Id="{dfc63422-169c-4318-97d7-f49729080001}">
      <Declaration><![CDATA[METHOD AppendFit
VAR
	testShort : STRING(10);
	sourceLong : STRING(30) := '01234567890123456789';
	res : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// 1. Fits within capacity
testShort := '12345';
TOF_Core.Strings.AppendFit(testShort, '67');
AssertEquals_STRING('1234567', testShort, 'AppendFit must append normally when it fits');

// 2. Exact fit: fills capacity without ellipsis
testShort := '12345';
TOF_Core.Strings.AppendFit(testShort, '67890');
AssertEquals_STRING('1234567890', testShort, 'AppendFit must fit exactly without ellipsis');

// 3. Overflow by 1 char: truncates and appends '...'
testShort := '12345';
TOF_Core.Strings.AppendFit(testShort, '678901');
AssertEquals_STRING('1234567...', testShort, 'AppendFit must truncate and append ... on 1 char overflow');

// 4. Overflow by many chars: truncates and appends '...'
testShort := '12345';
TOF_Core.Strings.AppendFit(testShort, sourceLong);
AssertEquals_STRING('1234501...', testShort, 'AppendFit must truncate and append ... on large overflow');

// 5. Empty source: target remains unchanged
testShort := '12345';
TOF_Core.Strings.AppendFit(testShort, '');
AssertEquals_STRING('12345', testShort, 'AppendFit must leave target unchanged for empty source');

// 6. Appending to empty target
testShort := '';
TOF_Core.Strings.AppendFit(testShort, sourceLong);
AssertEquals_STRING('0123456...', testShort, 'AppendFit to empty target must truncate and append ...');

// 7. TryAppendFit normal fit
testShort := '123';
res := TOF_Core.Strings.TryAppendFit(testShort, '45');
AssertEquals_BOOL(TRUE, res, 'TryAppendFit must return TRUE on normal fit');
AssertEquals_STRING('12345', testShort, 'TryAppendFit must append text');

// 8. TryAppendFit overflow
testShort := '12345';
res := TOF_Core.Strings.TryAppendFit(testShort, sourceLong);
AssertEquals_BOOL(TRUE, res, 'TryAppendFit must return TRUE on overflow');
AssertEquals_STRING('1234501...', testShort, 'TryAppendFit must truncate and append ...');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b8985102-dc15-41e1-ae23-7d62e6866a91}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{03ded19b-ca6c-4934-9ab2-2e75c95c0490}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConcatFit255" Id="{1dde581b-fb53-48b6-9cfa-4f73702d857b}">
      <Declaration><![CDATA[METHOD ConcatFit255
VAR
	concatResult : STRING(255);
	part1 : STRING(100);
	part2 : STRING(100);
	part3 : STRING(100);
	foundEllipsis : BOOL;
	ellipsisPosition : UDINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// 1. Normal concatenation that fits in 255
concatResult := TOF_Core.Strings.ConcatFit255('Hello, ', 'World!');
AssertEquals_STRING('Hello, World!', concatResult, 'ConcatFit255 must join strings normally');

// 2. Skipping empty fragments
concatResult := TOF_Core.Strings.ConcatFit255('Part1', '', 'Part2', '', 'Part3');
AssertEquals_STRING('Part1Part2Part3', concatResult, 'ConcatFit255 must skip empty fragments');

// 3. Overflowing 255 characters: must truncate to 255 and end with '...'
part1 := '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789';
part2 := '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789';
part3 := '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789';

concatResult := TOF_Core.Strings.ConcatFit255(part1, part2, part3);
AssertEquals_INT(255, Tc2_Standard.LEN(concatResult), 'ConcatFit255 must truncate to 255 characters on overflow');
foundEllipsis := TOF_Core.Strings.Find(concatResult, '...', position => ellipsisPosition);
AssertEquals_BOOL(TRUE, foundEllipsis, 'ConcatFit255 must contain ellipsis on overflow');
AssertEquals_UDINT(253, ellipsisPosition, 'ConcatFit255 must end with ellipsis on overflow');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Join" Id="{ad5df54c-ebe3-4f2b-b686-f2235cc5e4f3}">
      <Declaration><![CDATA[METHOD Join
VAR
	stringToSplit : STRING := '123 , , 456, 789 ,0';
	separator : STRING := ',';
	
	splitter : TOF_Core.StringSplittingEnumerator;

	joinedString1, joinedString2 : STRING;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// simple splitting
splitter := TOF_Core.Strings.CreateSplitter(stringToSplit, separator);

// simple joining
TOF_Core.Strings.Join(joinedString1, separator, splitter);

AssertEquals_STRING(stringToSplit, joinedString1, TOF_Core.Strings.Concat255('Invalid first Strings.Join result string ', joinedString1));

// splitting with maxCount, trimming and empty string removing 
splitter := TOF_Core.Strings.CreateSplitter(stringToSplit, separator, 3, TRUE, TRUE);

// joining with startIndex and count
TOF_Core.Strings.Join(joinedString2, separator, splitter, 1, 2);

AssertEquals_STRING('456,789', joinedString2, TOF_Core.Strings.Concat255('Invalid second Strings.Join result string ', joinedString2));

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{02163062-dd40-4429-a0a8-5c360f5da8fb}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{459ad87f-22cb-4069-bbe1-8915f5177a12}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReplaceInSource" Id="{acab7dc3-475e-41e3-9ac6-f109a2619017}">
      <Declaration><![CDATA[METHOD ReplaceInSource
VAR
	testString : STRING(18);
	
	replacementCount : UINT;
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

testString := 'abcd_abcd_abcd';
TOF_Core.Strings.ReplaceInSource(testString, 'bc', '0', replacementCount => replacementCount);
AssertEquals_STRING('a0d_a0d_a0d', testString, 'Invalid String.ReplaceInSource result string');
AssertEquals_UINT(3, replacementCount, 'Invalid String.ReplaceInSource replacingCount count');

testString := 'abcd_abcd_abcd';
TOF_Core.Strings.ReplaceInSource(testString, 'bc', '123', replacementCount => replacementCount);
AssertEquals_STRING('a123d_a123d_a123d', testString, 'Invalid String.ReplaceInSource result string');
AssertEquals_UINT(3, replacementCount, 'Invalid String.ReplaceInSource replacingCount count');

testString := 'abcd_abcd_abcd';
result := TOF_Core.Strings.TryReplaceInSource(testString, 'bc', '0', replacementCount => replacementCount);
AssertEquals_BOOL(TRUE, result, 'Invalid String.TryReplaceInSource result');
AssertEquals_STRING('a0d_a0d_a0d', testString, 'Invalid String.TryReplaceInSource result string');
AssertEquals_UINT(3, replacementCount, 'Invalid String.TryReplaceInSource replacingCount count');

testString := 'abcd_abcd_abcd';
result := TOF_Core.Strings.TryReplaceInSource(testString, 'bc', '123', 1, 1, replacementCount => replacementCount);
AssertEquals_BOOL(TRUE, result, 'Invalid String.TryReplaceInSource result');
AssertEquals_STRING('abcd_a123d_abcd', testString, 'Invalid String.TryReplaceInSource result string');
AssertEquals_UINT(1, replacementCount, 'Invalid String.TryReplaceInSource replacingCount count');

testString := 'abcd_abcd_abcd';
result := TOF_Core.Strings.TryReplaceInSource(testString, 'bc', '1234', replacementCount => replacementCount);
AssertEquals_BOOL(FALSE, result, 'Invalid String.TryReplaceInSource memory handling');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Split" Id="{afcb1a60-4677-4461-950d-5644dc25733b}">
      <Declaration><![CDATA[METHOD Split
VAR
	stringToSplit : STRING := '123 , , 456, 789 ,0';
	separator : STRING := ',';
	
	splitter : TOF_Core.StringSplittingEnumerator;
	currentEntry : STRING;
	i : BYTE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// simple splitting
splitter := TOF_Core.Strings.CreateSplitter(stringToSplit, separator);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_STRING('123 ', currentEntry, 'Invalid StringSplitter entry #0');			
		1:
			AssertEquals_STRING(' ', currentEntry, 'Invalid StringSplitter entry #3');
		2:
			AssertEquals_STRING(' 456', currentEntry, 'Invalid StringSplitter entry #1');
		3:
			AssertEquals_STRING(' 789 ', currentEntry, 'Invalid StringSplitter entry #2');
		4:
			AssertEquals_STRING('0', currentEntry, 'Invalid StringSplitter entry #4');
	END_CASE	
	
	i := i + 1;
END_WHILE

// splitting with maxCount, trimming and empty string removing 
splitter := TOF_Core.Strings.CreateSplitter(stringToSplit, separator, 3, TRUE, TRUE);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_STRING('123', currentEntry, 'Invalid StringSplitter entry #0');			
		1:
			AssertEquals_STRING('456', currentEntry, 'Invalid StringSplitter entry #1');
		2:
			AssertEquals_STRING('789', currentEntry, 'Invalid StringSplitter entry #2');
		ELSE
			AssertFalse(i > 3, 'Invalid StringSplitter MaxCount handling');
	END_CASE	
	
	i := i + 1;
END_WHILE

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Trim" Id="{4efc06d8-47aa-41ec-86fa-bcfd7ab44822}">
      <Declaration><![CDATA[METHOD Trim
VAR
	trimString : STRING;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

trimString := '  123   ';
TOF_Core.Strings.TrimChar(trimString, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT);
AssertEquals_STRING('123', trimString, 'Invalid string trimming result (TRIM_MODE = LEFT_AND_RIGHT)');			

trimString := '  123   ';
TOF_Core.Strings.TrimChar(trimString, trimMode := TOF_Core.TRIM_MODE.LEFT);
AssertEquals_STRING('123   ', trimString, 'Invalid string trimming result (TRIM_MODE = LEFT)');			

trimString := '  123   ';
TOF_Core.Strings.TrimChar(trimString, trimMode := TOF_Core.TRIM_MODE.RIGHT);
AssertEquals_STRING('  123', trimString, 'Invalid string trimming result (TRIM_MODE = RIGHT)');			

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>