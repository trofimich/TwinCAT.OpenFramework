<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringConcatFitTest" Id="{18ffe0bc-42d6-476f-831c-25bf10f6dbc3}" SpecialFunc="None">
    <Declaration><![CDATA[(*
