(*!
<summary>Checks fitted concatenation at the 255-byte ASCII and UTF-8 boundaries.</summary>
<description>Uses one task and a stable instance address while assertions are bound.</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringConcatFitTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c67d781f-01d2-4798-8934-37193315e412}">
      <Declaration><![CDATA[(*!
<summary>Checks ASCII fragment order and preservation of whole UTF-8 code points when truncated.</summary>
<description>Compares each result with an independently assembled expected string.</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	text : STRING(255);
	first : STRING(100) := 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
	second : STRING(100) := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
	third : STRING(100) := 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc';
	expectedText : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[text := TOF_Core.Strings.ConcatFit255('Hello, ', 'World!');
Assert.ThatBool(
	actual := text = 'Hello, World!',
	message := "ConcatFit255 must preserve an ordinary fit"
).IsTrue();

text := TOF_Core.Strings.ConcatFit255('Part1', '', 'Part2', '', 'Part3');
Assert.ThatBool(
	actual := text = 'Part1Part2Part3',
	message := "ConcatFit255 must skip empty fragments without stopping"
).IsTrue();

text := TOF_Core.Strings.ConcatFit255(first, second, third);
Assert.ThatInt(
	actual := Tc2_Standard.LEN(STR := text),
	message := "ConcatFit255 must fill the 255-character result"
).ToBe(expected := 255);

// The first two 100-byte fragments leave room for 52 bytes from the third and the three-dot suffix.
expectedText := Tc2_Standard.CONCAT(STR1 := first, STR2 := second);
expectedText := Tc2_Standard.CONCAT(
	STR1 := expectedText,
	STR2 := 'cccccccccccccccccccccccccccccccccccccccccccccccccccc...'
);
Assert.ThatBool(
	actual := text = expectedText,
	message := "Truncation must preserve the 252-byte prefix and end in three dots"
).IsTrue();

// Two 100-byte fragments and 51 ASCII bytes put the cut after the first byte of ї.
text := TOF_Core.Strings.ConcatFit255(first, second, UTF8#'cccccccccccccccccccccccccccccccccccccccccccccccccccїWXYZ', 'Z');
expectedText := Tc2_Standard.CONCAT(STR1 := first, STR2 := second);
expectedText := Tc2_Standard.CONCAT(
	STR1 := expectedText,
	STR2 := 'ccccccccccccccccccccccccccccccccccccccccccccccccccc...'
);
Assert.ThatBool(
	actual := text = expectedText,
	message := "ConcatFit255 must drop the whole split code point and leave the marker at the end"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{97d366a8-bc7f-43ff-a96e-f3fb4fa9e35d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{01bbef21-c9a3-474e-8099-243de193d9c8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{6331f5e3-bc02-482c-bc47-e500610d0b2f}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{25a18d73-7905-44d6-b074-2d1b280b915e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b2fa4aee-a63a-4add-bdbd-b625bd94db55}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7cf46a53-4cb4-44e8-a353-1a4e6347b8ba}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
