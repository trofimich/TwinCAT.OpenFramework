(*
Checks strict and Try appends, including empty fragments and capacity failure.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringAppendTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{52a3ca7e-de6e-4771-a459-227b72a987e4}">
      <Declaration><![CDATA[(*
Checks strict and Try appends, including empty fragments and capacity failure.

Uses an eight-byte ASCII target. After a later fragment fails to fit, checks that the original text and the
first appended fragment remain at the start of the target.
*)
METHOD PROTECTED ExecuteTest
VAR
	target : STRING(8);
	accepted : BOOL;
	prefixFound : BOOL;
	prefixPosition : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[target := 'ab';
TOF_Core.Strings.Append255(target, 'cd', '', 'efgh');
Assert.ThatBool(
	actual := target = 'abcdefgh',
	message := "Append255 must skip an empty fragment and fill the target exactly"
).IsTrue();

target := 'ab';
accepted := TOF_Core.Strings.TryAppend255(
	targetString := target,
	sourceString1 := 'cd',
	sourceString2 := '',
	sourceString3 := 'efgh'
);
Assert.ThatBool(
	actual := accepted AND_THEN target = 'abcdefgh',
	message := "TryAppend255 must accept an exact fit"
).IsTrue();

target := 'ab';
accepted := TOF_Core.Strings.TryAppend255(
	targetString := target,
	sourceString1 := 'cd',
	sourceString2 := 'ABCDE',
	sourceString3 := '!'
);
Assert.ThatBool(
	actual := accepted,
	message := "TryAppend255 must report capacity failure"
).IsFalse();

prefixFound := TOF_Core.Strings.Find(
	stringToSearchIn := target,
	stringToFind := 'abcd',
	position => prefixPosition
);
Assert.ThatBool(
	actual := prefixFound AND_THEN prefixPosition = 1,
	message := "TryAppend255 must preserve the successfully appended prefix"
).IsTrue();

target := 'ab';
TOF_Core.Strings.Append(targetString := target, sourceString := 'cd');
TOF_Core.Strings.Append(targetString := target, sourceString := '');
TOF_Core.Strings.Append(targetString := target, sourceString := 'efgh');
Assert.ThatBool(
	actual := target = 'abcdefgh',
	message := "Append must preserve the target on empty input and accept the exact fit"
).IsTrue();

target := 'abcdef';
accepted := TOF_Core.Strings.TryAppend(targetString := target, sourceString := 'gh');
Assert.ThatBool(
	actual := accepted AND_THEN target = 'abcdefgh',
	message := "TryAppend must accept an exact fit"
).IsTrue();

accepted := TOF_Core.Strings.TryAppend(targetString := target, sourceString := 'i');
Assert.ThatBool(
	actual := accepted,
	message := "TryAppend must reject another character in a full target"
).IsFalse();
Assert.ThatBool(
	actual := target = 'abcdefgh',
	message := "TryAppend must preserve the full target when one more character does not fit"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{43018df9-5ace-4511-9939-fe3f63f12018}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{782e7624-d488-4e97-967f-056f381b36dc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{57f7ef22-c1cb-4e59-8ef0-73a9b32fe5f0}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{78920eb4-5554-4e37-a395-f228ecf5e622}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{fdee6cd9-0eab-4b38-9ff6-a7defd216334}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0a6dc22a-1bab-44b1-9bee-18f99a192902}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
