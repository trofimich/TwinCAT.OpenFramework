<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringTrimTest" Id="{87bf74ee-f5a5-4675-896e-b5ee7479797d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks trimming direction, custom characters and complete removal.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringTrimTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{cb39fbf7-2963-4172-9d3a-4e67ed250509}">
      <Declaration><![CDATA[(* Checks trimming direction, custom characters and complete removal. *)
METHOD PROTECTED ExecuteTest
VAR
	text : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[text := '  123   ';
TOF_Core.Strings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT);
Assert.ThatBool(
	actual := text = '123',
	message := "TrimChar must apply LEFT_AND_RIGHT exactly"
).IsTrue();

text := '  123   ';
TOF_Core.Strings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.LEFT);
Assert.ThatBool(
	actual := text = '123   ',
	message := "TrimChar must apply LEFT exactly"
).IsTrue();

text := '  123   ';
TOF_Core.Strings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.RIGHT);
Assert.ThatBool(
	actual := text = '  123',
	message := "TrimChar must apply RIGHT exactly"
).IsTrue();

text := '**a*b**';
TOF_Core.Strings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT, trimChar := '*');
Assert.ThatBool(
	actual := text = 'a*b',
	message := "Trimming a custom character must preserve an internal match"
).IsTrue();

text := '***';
TOF_Core.Strings.TrimChar(stringToTrim := text, trimChar := '*');
Assert.ThatBool(
	actual := text = '',
	message := "Trimming all matching characters must make the result empty"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ddcfa616-8518-4416-861a-835eac7ac173}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5413b56c-7e0c-43e9-9d0b-e6d09ccb35cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f6aafb92-d957-4bc6-a99e-56860fa12933}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cfeb6518-bb70-4915-a35d-969e6f7ca66c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{ea725ccf-0d6a-4315-9ff6-fb4961a2156e}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d3183065-bb3e-42e8-bdef-23f4b6e3f13d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
