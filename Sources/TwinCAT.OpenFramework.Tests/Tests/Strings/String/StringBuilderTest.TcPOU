SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

FUNCTION_BLOCK StringBuilderTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ErrorChecking();
BuildEmpty();
BuildNotEmpty();]]></ST>
    </Implementation>
    <Method Name="BuildEmpty" Id="{bf0fd1d7-030a-49ab-a3c1-40b8ef119002}">
      <Declaration><![CDATA[(*!
<summary>Exercises string-builder behavior with persistent buffer ownership.</summary>
<description>
The fixture retains the builder if a call propagates an exception. Normal completion explicitly releases its
buffer; stack unwinding is not required for cleanup.
</description>
*)
METHOD BuildEmpty
VAR
	targetString : STRING;
END_VAR
VAR_INST
	stringBuilder : TOF_Core.StringBuilder;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

stringBuilder.AssignToString(targetString := targetString);

AssertEquals_STRING(Expected := '', Actual := targetString, Message := 'Invalid short string handling');

stringBuilder.Clear(releaseMemory := TRUE);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="BuildNotEmpty" Id="{b4efd27f-0100-4c45-822a-9d4cbd29ac44}">
      <Declaration><![CDATA[(*!
<summary>Exercises string-builder behavior with persistent buffer ownership.</summary>
<description>
The fixture retains the builder if a call propagates an exception. Normal completion explicitly releases its
buffer; stack unwinding is not required for cleanup.
</description>
*)
METHOD BuildNotEmpty
VAR
	string1 : STRING := 'String1';
	string2 : STRING := 'String2';
	
	targetString : STRING(255);
END_VAR
VAR_INST
	stringBuilder : TOF_Core.StringBuilder;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

stringBuilder
	.Append(value := string1)
	.AppendIf(value := string1, condition := FALSE)
	.AppendString(value := string2)
	.AppendStringIf(value := string2, condition := FALSE)
	.AppendString255(value := 'String3')
	.AppendString255If(value := 'String3', condition := FALSE);
	
stringBuilder.AssignToString(targetString := targetString);

AssertEquals_STRING(Expected := 'String1String2String3', Actual := targetString, Message := 'Invalid string building');

stringBuilder.Clear(releaseMemory := TRUE);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{dcc9b983-c1d9-4104-bc20-652098a7f3ca}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{12a04d23-4da9-44ad-93aa-cfe93fc4c95e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ErrorChecking" Id="{2f9f885b-8c52-4b38-aeac-d1d0703fd50a}">
      <Declaration><![CDATA[(*!
<summary>Exercises string-builder behavior with persistent buffer ownership.</summary>
<description>
The fixture retains the builder if a call propagates an exception. Normal completion explicitly releases its
buffer; stack unwinding is not required for cleanup.
</description>
*)
METHOD ErrorChecking
VAR
	targetWideString : WSTRING;
	shortTargetString : STRING(10);
END_VAR
VAR_INST
	stringBuilder : TOF_Core.StringBuilder;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

stringBuilder.AppendString255(value := 'String1234567890');

__TRY
	stringBuilder.AssignToString(targetString := targetWideString);
	
	AssertEquals_BOOL(Expected := FALSE, Actual := TRUE, Message := 'Invalid string type checking in AssignToString');
__CATCH
__ENDTRY

__TRY
	stringBuilder.AssignToString(targetString := shortTargetString);
	
	AssertEquals_BOOL(Expected := FALSE, Actual := TRUE, Message := 'Invalid string length checking in AssignToString');	
__CATCH
__ENDTRY

stringBuilder.Clear(releaseMemory := TRUE);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{30703d6a-7724-405d-9cf9-d89b4d907891}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6692b469-84c7-4001-95a0-36b8b74a3846}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>