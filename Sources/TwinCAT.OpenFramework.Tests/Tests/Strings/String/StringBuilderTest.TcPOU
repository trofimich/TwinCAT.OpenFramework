<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="StringBuilderTest" Id="{aa1a3324-3c7c-432c-aca2-7ee2632a00c9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
