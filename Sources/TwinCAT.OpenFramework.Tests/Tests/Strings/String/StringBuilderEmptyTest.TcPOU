<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringBuilderEmptyTest" Id="{2ae01f76-1cbd-4d2a-bcae-7c62e3592879}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks assigning an empty builder to a populated target without allocating a builder buffer.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringBuilderEmptyTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Builder : TOF_Core.StringBuilder;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{e724b6ab-8cbe-431b-bc74-b7bcc026ce15}">
      <Declaration><![CDATA[(*
Checks assigning an empty builder to a populated target without allocating a builder buffer.

The builder is persistent so teardown can release its buffer after an unexpected hook exception.
*)
METHOD PROTECTED ExecuteTest
VAR
	target : STRING := 'previous contents';
	copied : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[copied := _Builder.AssignToString(targetString := target);
Assert.ThatBool(
	actual := copied AND_THEN target = '',
	message := "Assigning an empty builder must clear the target and succeed"
).IsTrue();
Assert.ThatBool(
	actual := _Builder.StringLength = 0 AND_THEN _Builder.Capacity = 0,
	message := "Assigning an empty builder must leave it unallocated"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{ead87c60-ce3d-4e9f-8a52-cebee0571e52}">
      <Declaration><![CDATA[(*
Releases the builder buffer before reporting the case result.

Safe after partial initialization and after explicit cleanup in the scenario.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Builder.Clear(releaseMemory := TRUE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{454184e0-8509-4b7d-8bed-10c5886eb604}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5e0fa7c8-838f-4052-91f0-cd2a21e64321}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{d911d731-19cc-4541-b28e-b4b7ea71aaed}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e7f2ad8c-de43-4a43-917c-72b08a183e6f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b8ecd9f0-9a63-46fd-9f0f-87712f03ddcb}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{40c0a186-2721-4cad-bed1-9e0f419255e6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
