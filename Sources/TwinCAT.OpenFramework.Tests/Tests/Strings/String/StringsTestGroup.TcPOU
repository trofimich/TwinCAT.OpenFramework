<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringsTestGroup" Id="{19b3bce0-2b8a-49f6-8577-68a0ce66d979}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups STRING formatting, editing, length, search and splitter contracts.</summary>
<description>Owns its child instances and fixed registration array. Use from one task at a stable address.</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StringsTestGroup EXTENDS TOF_Testing.TestGroup<11>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_AnyToStringFit255 : StringFitFormattingTest(name := "ConvertAnyToStringFit255", parent := THIS^);
	_Append : StringAppendTest(name := "Append", parent := THIS^);
	_AppendFit : StringAppendFitTest(name := "AppendFit", parent := THIS^);
	_ConcatFit255 : StringConcatFitTest(name := "ConcatFit255", parent := THIS^);
	_Contains : StringContainsTest(name := "Contains", parent := THIS^);
	_Join : StringJoinTest(name := "Join", parent := THIS^);
	_Length : StringLengthTest(name := "Length", parent := THIS^);
	_ReplaceInSource : StringReplacementTest(name := "ReplaceInSource", parent := THIS^);
	_Split : StringSplitTest(name := "Split", parent := THIS^);
	_Trim : StringTrimTest(name := "Trim", parent := THIS^);
	_SplitterSeparatorBounds : StringSeparatorBoundsTest(name := "SplitterSeparatorBounds", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_AnyToStringFit255,
		_Append,
		_AppendFit,
		_ConcatFit255,
		_Contains,
		_Join,
		_Length,
		_ReplaceInSource,
		_Split,
		_Trim,
		_SplitterSeparatorBounds
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{3920885b-cf79-429d-8649-95fcd197d5e1}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{e2f52323-7683-4397-b906-76656b6fb43d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{b0cbaaeb-9e33-4526-8daf-61d9aacc9001}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9456c479-a33d-4d23-9b0d-83d72fab0105}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ee72c81b-6f6b-4481-840e-ff60701d55f7}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{05fef4ed-457f-4fa7-837e-f2fd158d4075}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3ef79b4e-f1b5-4120-8334-27aa18f33d76}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{726bc39c-6334-4bf4-984d-044a7afaa249}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
