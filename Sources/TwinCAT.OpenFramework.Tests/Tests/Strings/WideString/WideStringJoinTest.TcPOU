<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringJoinTest" Id="{e49ea7c4-ece1-43cc-aa2b-0bb7ffdd8ff9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks full and windowed joining and cursor reuse after insufficient capacity.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringJoinTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Source : WSTRING := "123 , , 456, 789 ,0";
	_Splitter : TOF_Core.WideStringSplittingEnumerator;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{9a6cfb95-5e59-43db-beec-1530becc1239}">
      <Declaration><![CDATA[(*!
<summary>Checks full and windowed joining and cursor reuse after insufficient capacity.</summary>
<description>
Owns a persistent cursor and its borrowed source. Reset releases the current fragment before the result is reported.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	separator : WSTRING := ",";
	joined : WSTRING := "old target";
	shortTarget : WSTRING(2);
	accepted : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Splitter := TOF_Core.WideStrings.CreateSplitter(sourceString := _Source, separator := separator);
TOF_Core.WideStrings.Join(targetString := joined, separator := separator, sourceEnumerator := _Splitter);
Assert.ThatBool(
	actual := joined = _Source,
	message := "Unrestricted Join must reconstruct all fragments including their whitespace"
).IsTrue();

_Splitter.Reset();
_Splitter := TOF_Core.WideStrings.CreateSplitter(
	sourceString := _Source,
	separator := separator,
	maxCount := 3,
	trimEntries := TRUE,
	removeEmptyEntries := TRUE
);
TOF_Core.WideStrings.Join(
	targetString := joined,
	separator := separator,
	sourceEnumerator := _Splitter,
	startIndex := 1,
	count := 2
);
Assert.ThatBool(
	actual := joined = "456,789",
	message := "The requested window must contain fragments 1 and 2"
).IsTrue();

_Splitter.Reset();
accepted := TOF_Core.WideStrings.TryJoin(targetString := shortTarget, separator := separator, sourceEnumerator := _Splitter);
Assert.ThatBool(
	actual := accepted,
	message := "TryJoin must reject a target too small for the first fragment"
).IsFalse();

_Splitter.Reset();
accepted := TOF_Core.WideStrings.TryJoin(
	targetString := joined,
	separator := separator,
	sourceEnumerator := _Splitter,
	count := 1
);
Assert.ThatBool(
	actual := accepted AND_THEN joined = "123",
	message := "After Reset, TryJoin must restart and replace the old target text"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{238721c5-7646-4a36-bd0b-2e43a14561d5}">
      <Declaration><![CDATA[(*!
<summary>Resets the splitter and releases any active fragment before reporting.</summary>
<description>
Safe after partial initialization and after explicit cleanup in the scenario.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Splitter.Reset();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{5ff5b395-2005-4d17-931f-67bd7e973ced}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ef8fa447-2242-4f69-8e3f-306efb0b4bd5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5af7da0c-100b-4595-ae5e-02b979d1593b}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5b4e6766-7083-4441-8cde-c521326c7005}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{73ebb43d-700a-4210-94d4-218e2bf86114}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{423e0c0c-3131-470c-8a61-55bb24ef7660}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
