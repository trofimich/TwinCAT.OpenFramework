<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringBuilderEmptyTest" Id="{82aecb06-8ab5-44af-b642-55f9dc49cbf2}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks assigning an empty builder to a populated target without allocating a builder buffer.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringBuilderEmptyTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Builder : TOF_Core.WideStringBuilder;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{49c26210-0a95-4753-905e-e7279cfab967}">
      <Declaration><![CDATA[(*
Checks assigning an empty builder to a populated target without allocating a builder buffer.

The builder is persistent so teardown can release its buffer after an unexpected hook exception.
*)
METHOD PROTECTED ExecuteTest
VAR
	target : WSTRING := "previous contents";
	copied : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[copied := _Builder.AssignToString(targetString := target);
Assert.ThatBool(
	actual := copied AND_THEN target = "",
	message := "Assigning an empty builder must clear the target and succeed"
).IsTrue();
Assert.ThatBool(
	actual := _Builder.StringLength = 0 AND_THEN _Builder.Capacity = 0,
	message := "Assigning an empty builder must leave it unallocated"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{7a3a04a2-fc4c-407c-a8fd-49570c8ccfdd}">
      <Declaration><![CDATA[(*
Releases the builder buffer before reporting the case result.

Safe after partial initialization and after explicit cleanup in the scenario.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Builder.Clear(releaseMemory := TRUE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{778f1200-8c33-4975-a5d7-c2da8f5ecbd8}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b77dbbc3-17f2-4d48-a926-3cb4f16b645b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{69773380-1189-4125-9cfe-86165603e5f0}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d7e8ea10-b298-4dea-8010-b332be474c5a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b2cefdd4-7c20-4777-a7f7-87f62dd988be}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3c3470bd-e790-40e3-ab0c-06026ab06d10}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
