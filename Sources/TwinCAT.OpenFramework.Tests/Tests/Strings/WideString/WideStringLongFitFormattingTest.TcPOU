(*!
<summary>Checks exact 255-unit and truncated 256-unit ANY text formatting.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringLongFitFormattingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{9f2f7f1a-56ea-4a64-9a7d-7620baccbe0e}">
      <Declaration><![CDATA[(*!
<summary>Checks exact 255-unit and truncated 256-unit ANY text formatting.</summary>
<description>
Checks the retained code units, the U+2026 marker and the terminator directly in the returned buffer.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	narrow : STRING(256);
	wide : WSTRING(256);
	wideData : POINTER TO WORD;
	result : WSTRING(255);
	resultData : POINTER TO WORD;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[wideData := ADR(wide);
resultData := ADR(result);

// SA0175: Fill STRING(256) with 256 ASCII bytes and terminate explicitly.
{analysis -175}
FOR i := 0 TO 255 DO
	narrow[i] := BYTE#16#61;
	wideData[i] := WORD#16#61;
END_FOR

narrow[256] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);
{analysis +175}
wideData[256] := TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE);

result := TOF_Core.WideStrings.AnyToStringFit255(value := narrow);
Assert.ThatBool(
	actual := TOF_Core.WideStrings.GetLength(value := result) = 255
		AND_THEN resultData[253] = WORD#16#61
		AND_THEN resultData[254] = WORD#16#2026
		AND_THEN resultData[255] = TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE),
	message := "A long STRING must retain 254 characters and append exactly U+2026"
).IsTrue();

result := TOF_Core.WideStrings.AnyToStringFit255(value := wide);
Assert.ThatBool(
	actual := TOF_Core.WideStrings.GetLength(value := result) = 255
		AND_THEN resultData[253] = WORD#16#61
		AND_THEN resultData[254] = WORD#16#2026
		AND_THEN resultData[255] = TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE),
	message := "A long WSTRING must retain 254 characters and append exactly U+2026"
).IsTrue();

// SA0175: Shorten the ASCII payload to exactly 255 bytes by moving its terminator.
{analysis -175}
narrow[255] := TO_BYTE(TOF_Core.UnsignedInt8.MIN_VALUE);
{analysis +175}
wideData[255] := TO_WORD(TOF_Core.UnsignedInt16.MIN_VALUE);
result := TOF_Core.WideStrings.AnyToStringFit255(value := narrow);
Assert.ThatBool(
	actual := TOF_Core.WideStrings.GetLength(value := result) = 255 AND_THEN resultData[254] = WORD#16#61,
	message := "An exact-fit STRING must keep its final character"
).IsTrue();
result := TOF_Core.WideStrings.AnyToStringFit255(value := wide);
Assert.ThatBool(
	actual := TOF_Core.WideStrings.GetLength(value := result) = 255 AND_THEN resultData[254] = WORD#16#61,
	message := "An exact-fit WSTRING must keep its final character"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ad8bb01b-79f2-41e0-9b16-488c6e3da590}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0b9ab670-c7e4-47f6-983c-26ed6da8e0a2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{60039231-a61b-4cd2-85a5-d205081f383a}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e0fab7de-61ad-41aa-b541-3e4d711e3f28}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{96b1369e-63e9-43e4-86b6-c032f1bc2bb8}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{05970a0d-d352-46b6-a8f1-4aef55e296ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
