<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringReplacementTest" Id="{3b4ce75a-815c-4abf-8d72-35d921ad48af}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks in-place replacements, counts, limits and partial capacity failure.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringReplacementTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{b3865f5b-eb25-4a01-827d-51a434fba70b}">
      <Declaration><![CDATA[(*!
<summary>Checks in-place replacements, counts, limits and partial capacity failure.</summary>
<description>
Uses caller-owned buffers with known capacities. A failed next replacement must leave earlier matches applied.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	text : WSTRING(18);
	
	replacementCount : UINT;
	result : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[text := "abcd_abcd_abcd";
TOF_Core.WideStrings.ReplaceInSource(
	sourceString := text,
	oldSubstring := "bc",
	newSubstring := "0",
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := text = "a0d_a0d_a0d",
	message := "Shrink must produce the expected text"
).IsTrue();
Assert.ThatUInt(
	actual := replacementCount,
	message := "Shrink must produce the expected count"
).ToBe(expected := 3);

text := "abcd_abcd_abcd";
TOF_Core.WideStrings.ReplaceInSource(
	sourceString := text,
	oldSubstring := "bc",
	newSubstring := "123",
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := text = "a123d_a123d_a123d",
	message := "Grow must produce the expected text"
).IsTrue();
Assert.ThatUInt(
	actual := replacementCount,
	message := "Grow must produce the expected count"
).ToBe(expected := 3);

text := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := text,
	oldSubstring := "bc",
	newSubstring := "0",
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := result,
	message := "Try shrink must produce the expected status"
).IsTrue();
Assert.ThatBool(
	actual := text = "a0d_a0d_a0d",
	message := "Try shrink must produce the expected text"
).IsTrue();
Assert.ThatUInt(
	actual := replacementCount,
	message := "Try shrink must produce the expected count"
).ToBe(expected := 3);

text := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := text,
	oldSubstring := "bc",
	newSubstring := "123",
	maxReplacements := 1,
	skipReplacements := 1,
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := result,
	message := "Try skip and limit must produce the expected status"
).IsTrue();
Assert.ThatBool(
	actual := text = "abcd_a123d_abcd",
	message := "Try skip and limit must produce the expected text"
).IsTrue();
Assert.ThatUInt(
	actual := replacementCount,
	message := "Try skip and limit must produce the expected count"
).ToBe(expected := 1);

text := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := text,
	oldSubstring := "bc",
	newSubstring := "1234",
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := result,
	message := "Growth must report failure when the next replacement exceeds capacity"
).IsFalse();
Assert.ThatBool(
	actual := text = "a1234d_a1234d_abcd",
	message := "Capacity failure must preserve both completed replacements"
).IsTrue();
Assert.ThatUInt(
	actual := replacementCount,
	message := "Capacity failure must report both completed replacements"
).ToBe(expected := UINT#2);

text := "abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := text,
	oldSubstring := "",
	newSubstring := "ignore",
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := result AND_THEN text = "abcd_abcd" AND_THEN replacementCount = 0,
	message := "An empty search must succeed without modifying text or reporting replacements"
).IsTrue();

result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := text,
	oldSubstring := "bc",
	newSubstring := "",
	replacementCount => replacementCount
);
Assert.ThatBool(
	actual := result AND_THEN text = "ad_ad" AND_THEN replacementCount = 2,
	message := "An empty replacement must delete both matching substrings"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{08938329-82ea-4100-a263-238b19e3a286}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{84734b39-d58b-469d-9270-c4d9d91e7ec3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a9001074-9ef0-47cb-8ed0-14de276a83d6}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9cd7cd58-92b3-48ae-b1c0-1a2cc056d3d9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6d90e993-b459-4a66-8356-aabf1cedb433}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b0d21632-fe3d-4056-b997-db88283a5858}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
