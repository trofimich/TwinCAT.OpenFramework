(*!
<summary>Checks strict and Try appends, including empty fragments and capacity failure.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringAppendTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{efdb1f49-7040-4b60-a9c2-4512cbd3be57}">
      <Declaration><![CDATA[(*!
<summary>Checks strict and Try appends, including empty fragments and capacity failure.</summary>
<description>
Both widths use small buffers to exercise the exact capacity and a failing subsequent append.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	target : WSTRING(8);
	accepted : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[target := "ab";
TOF_Core.WideStrings.Append255(target, "cd", "", "efgh");
Assert.ThatBool(
	actual := target = "abcdefgh",
	message := "Append255 must skip an empty fragment and fill the target exactly"
).IsTrue();

target := "ab";
accepted := TOF_Core.WideStrings.TryAppend255(
	targetString := target,
	sourceString1 := "cd",
	sourceString2 := "",
	sourceString3 := "efgh"
);
Assert.ThatBool(
	actual := accepted AND_THEN target = "abcdefgh",
	message := "TryAppend255 must accept an exact fit"
).IsTrue();

target := "ab";
accepted := TOF_Core.WideStrings.TryAppend255(
	targetString := target,
	sourceString1 := "cd",
	sourceString2 := "ABCDE",
	sourceString3 := "!"
);
Assert.ThatBool(
	actual := accepted,
	message := "TryAppend255 must report capacity failure"
).IsFalse();
Assert.ThatBool(
	actual := Tc2_Standard.WLEFT(STR := target, SIZE := 4) = "abcd",
	message := "TryAppend255 must preserve the successfully appended prefix"
).IsTrue();

target := "ab";
TOF_Core.WideStrings.Append(targetString := target, sourceString := "cd");
TOF_Core.WideStrings.Append(targetString := target, sourceString := "");
TOF_Core.WideStrings.Append(targetString := target, sourceString := "efgh");
Assert.ThatBool(
	actual := target = "abcdefgh",
	message := "Append must preserve the target on empty input and accept the exact fit"
).IsTrue();

target := "abcdef";
accepted := TOF_Core.WideStrings.TryAppend(targetString := target, sourceString := "gh");
Assert.ThatBool(
	actual := accepted AND_THEN target = "abcdefgh",
	message := "TryAppend must accept an exact fit"
).IsTrue();

accepted := TOF_Core.WideStrings.TryAppend(targetString := target, sourceString := "i");
Assert.ThatBool(
	actual := accepted,
	message := "TryAppend must reject another character in a full target"
).IsFalse();
Assert.ThatBool(
	actual := target = "abcdefgh",
	message := "TryAppend must preserve the full target when one more character does not fit"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{24a658e1-a6e6-41d7-9d34-432fbedec880}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{90cd9a3f-675f-441a-94d1-9e1cc3c510a6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a7b2f721-aaea-4537-abd4-30624b2f5344}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3494c00d-7200-4c24-b931-086f522fae59}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b4d4aaa2-5610-4e2a-8f62-61b9c9b47602}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c65a7c33-ba06-4a9a-a76b-31a6fc39fb2b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
