<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringAppendTest" Id="{7caa1a9e-54bc-48d3-ba09-8a7949ae9ab8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
