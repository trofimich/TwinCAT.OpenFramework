    <Method Name="ConcatFit255" Id="{03f18aa3-1438-4161-8f24-8e381a63da34}">
      <Declaration><![CDATA[METHOD ConcatFit255
VAR
	concatResult : WSTRING(255);
	part1 : WSTRING(100);
	part2 : WSTRING(100);
	part3 : WSTRING(100);
	lastChar : WSTRING(1);
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Normal concatenation that fits in 255
concatResult := TOF_Core.WideStrings.ConcatFit255("Hello, ", "World!");
AssertEquals_WSTRING(
		Expected := "Hello, World!",
		Actual := concatResult,
		Message := 'ConcatFit255 must join strings normally'
	);

// 2. Skipping empty fragments
concatResult := TOF_Core.WideStrings.ConcatFit255("Part1", "", "Part2", "", "Part3");
AssertEquals_WSTRING(
		Expected := "Part1Part2Part3",
		Actual := concatResult,
		Message := 'ConcatFit255 must skip empty fragments'
	);

// 3. Overflowing 255 characters: must truncate to 255 and end with U+2026 ('…')
part1 := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
part2 := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
part3 := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";

concatResult := TOF_Core.WideStrings.ConcatFit255(part1, part2, part3);
AssertEquals_INT(
		Expected := 255,
		Actual := Tc2_Standard.WLEN(STR := concatResult),
		Message := 'ConcatFit255 must truncate to 255 characters on overflow'
	);
lastChar := Tc2_Standard.WRIGHT(STR := concatResult, SIZE := 1);
AssertEquals_WSTRING(Expected := "…", Actual := lastChar, Message := 'ConcatFit255 must end with ellipsis on overflow');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{c082999c-0b1a-40bb-8f3c-60a1837eaadf}">
      <Declaration><![CDATA[METHOD Contains
VAR
	containsResult : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Substring at start
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "Hello");
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for prefix substring'
);

// 2. Substring in middle
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "world");
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for middle substring'
);

// 3. Substring at end
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "!");
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for suffix substring'
);

// 4. Exact match of whole string
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "Hello, world!");
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for identical string'
);

// 5. Empty substring in non-empty string
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "");
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for empty substring in non-empty string'
);

// 6. Empty substring in empty string
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "", stringToFind := "");
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := containsResult,
	Message := 'Contains must return TRUE for empty substring in empty string'
);

// 7. Non-empty substring in empty string
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "", stringToFind := "a");
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must return FALSE for non-empty substring in empty string'
);

// 8. Substring not found
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "xyz");
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must return FALSE when substring is absent'
);

// 9. Case sensitivity
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "hello");
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must be case-sensitive'
);

// 10. Substring longer than source
containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "abc", stringToFind := "abcdef");
AssertEquals_BOOL(
	Expected := FALSE,
	Actual := containsResult,
	Message := 'Contains must return FALSE when substring is longer than source'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Join" Id="{283221aa-e7f9-4632-bda6-1a9f0368009d}">
      <Declaration><![CDATA[(*!
<summary>Exercises string traversal with a persistent splitter and borrowed source.</summary>
<description>
The splitter retains ownership across exception propagation; Reset releases current fragments before reuse
and normal completion. The persistent source remains alive for the entire cursor lifetime.
</description>
*)
METHOD Join
VAR
	separator : WSTRING := ",";

	joinedString : WSTRING;
END_VAR
VAR_INST
	stringToSplit : WSTRING := "123 , , 456, 789 ,0";
	splitter : TOF_Core.WideStringSplittingEnumerator;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// simple splitting
splitter.Reset();
splitter := TOF_Core.WideStrings.CreateSplitter(sourceString := stringToSplit, separator := separator);

// simple joining
TOF_Core.WideStrings.Join(targetString := joinedString, separator := separator, sourceEnumerator := splitter);

	AssertEquals_WSTRING(
		Expected := stringToSplit,
		Actual := joinedString,
		Message := TOF_Core.Strings.Concat255('Invalid first WideStrings.Join result string ', TO_STRING(joinedString))
	);

// splitting with maxCount, trimming and empty string removing 
splitter.Reset();
splitter := TOF_Core.WideStrings.CreateSplitter(
	sourceString := stringToSplit,
	separator := separator,
	maxCount := 3,
	trimEntries := TRUE,
	removeEmptyEntries := TRUE
);

// joining with startIndex and count
TOF_Core.WideStrings.Join(targetString := joinedString, separator := separator, sourceEnumerator := splitter, startIndex := 1, count := 2);

	AssertEquals_WSTRING(
		Expected := "456,789",
		Actual := joinedString,
		Message := TOF_Core.Strings.Concat255(
			'Invalid second WideStrings.Join result string ',
			TO_STRING(joinedString)
		)
	);

splitter.Reset();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{f4f5aa7a-86c5-40a5-836c-18725c9fbee1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0227b39f-abc8-45ee-8a3f-72373f229f87}">
