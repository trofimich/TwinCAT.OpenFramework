FUNCTION_BLOCK WideStringsTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Append();
AppendFit();
ConcatFit255();
AnyToStringFit255();
AnyToStringFitLongInputs();
Contains();
ReplaceInSource();
Split();
SplitterSeparatorBounds();
Join();
Trim();]]></ST>
    </Implementation>
    <Method Name="AnyToStringFit255" Id="{3572cbf8-5263-4efa-b5a0-4190dfe7f072}">
      <Declaration><![CDATA[METHOD AnyToStringFit255
VAR
	anyResult : WSTRING(255);
	boolVal : BOOL := TRUE;
	intVal : DINT := 12345;
	shortStr : STRING(50) := 'Sample string';
	shortWstr : WSTRING(50) := "Sample wide string";
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Format boolean
anyResult := TOF_Core.WideStrings.AnyToStringFit255(value := boolVal);
AssertEquals_WSTRING(Expected := "TRUE", Actual := anyResult, Message := 'AnyToStringFit255 must format BOOL');

// 2. Format integer
anyResult := TOF_Core.WideStrings.AnyToStringFit255(value := intVal);
AssertEquals_WSTRING(Expected := "12345", Actual := anyResult, Message := 'AnyToStringFit255 must format DINT');

// 3. Format STRING that fits in 255
anyResult := TOF_Core.WideStrings.AnyToStringFit255(value := shortStr);
AssertEquals_WSTRING(
		Expected := "Sample string",
		Actual := anyResult,
		Message := 'AnyToStringFit255 must convert short STRING to WSTRING'
	);

// 4. Format WSTRING that fits in 255
anyResult := TOF_Core.WideStrings.AnyToStringFit255(value := shortWstr);
AssertEquals_WSTRING(
		Expected := "Sample wide string",
		Actual := anyResult,
		Message := 'AnyToStringFit255 must pass short WSTRING as-is'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Append" Id="{88a48147-6775-40ec-9463-87ab1f92288c}">
      <Declaration><![CDATA[METHOD Append
VAR
	testString : WSTRING;

	expectedString : WSTRING := "Original string + first appended string + second appended string";
	
	stringToAppend_1 : WSTRING := "first appended string";
	stringToAppend_2 : WSTRING := "second appended string";
	plusString : WSTRING := " + ";
	
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

testString := "Original string";
TOF_Core.WideStrings.Append255(testString, " + ", stringToAppend_1, " + ", stringToAppend_2);
AssertEquals_WSTRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid WideStrings.Append255 method result'
	);

testString := "Original string";
result := TOF_Core.WideStrings.TryAppend255(testString, " + ", stringToAppend_1, " + ", stringToAppend_2);
AssertEquals_WSTRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid WideStrings.TryAppend255 method result'
	);
AssertEquals_BOOL(
		Expected := result,
		Actual := TRUE,
		Message := 'Invalid WideStrings.TryAppend255 method returned result'
	);

result := TOF_Core.WideStrings.TryAppend255(testString, " + ", stringToAppend_1);
AssertEquals_BOOL(
		Expected := result,
		Actual := FALSE,
		Message := 'Invalid WideStrings.TryAppend255 method returned result'
	);

testString := "Original string";
TOF_Core.WideStrings.Append(targetString := testString, sourceString := plusString);
TOF_Core.WideStrings.Append(targetString := testString, sourceString := stringToAppend_1);
TOF_Core.WideStrings.Append(targetString := testString, sourceString := plusString);
TOF_Core.WideStrings.Append(targetString := testString, sourceString := stringToAppend_2);
AssertEquals_WSTRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid WideStrings.Append method result'
	);

testString := "Original string";
result := TOF_Core.WideStrings.TryAppend(targetString := testString, sourceString := plusString)
	AND TOF_Core.WideStrings.TryAppend(targetString := testString, sourceString := stringToAppend_1)
	AND TOF_Core.WideStrings.TryAppend(targetString := testString, sourceString := plusString)
	AND TOF_Core.WideStrings.TryAppend(targetString := testString, sourceString := stringToAppend_2);
AssertEquals_WSTRING(
		Expected := expectedString,
		Actual := testString,
		Message := 'Invalid WideStrings.TryAppend method result'
	);
AssertEquals_BOOL(
		Expected := result,
		Actual := TRUE,
		Message := 'Invalid WideStrings.TryAppend METHOD returned result'
	);

result := TOF_Core.WideStrings.TryAppend(targetString := testString, sourceString := plusString)
	AND TOF_Core.WideStrings.TryAppend(targetString := testString, sourceString := stringToAppend_1);
AssertEquals_BOOL(
		Expected := result,
		Actual := FALSE,
		Message := 'Invalid WideStrings.TryAppend method returned result'
	);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendFit" Id="{e08217c0-d613-42f5-a56c-21332ab50001}">
      <Declaration><![CDATA[METHOD AppendFit
VAR
	testShort : WSTRING(10);
	sourceLong : WSTRING(30) := "01234567890123456789";
	res : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// 1. Fits within capacity
testShort := "12345";
TOF_Core.WideStrings.AppendFit(targetString := testShort, sourceString := "67");
AssertEquals_WSTRING(
		Expected := "1234567",
		Actual := testShort,
		Message := 'AppendFit must append normally when it fits'
	);

// 2. Exact fit: fills capacity without ellipsis
testShort := "12345";
TOF_Core.WideStrings.AppendFit(targetString := testShort, sourceString := "67890");
AssertEquals_WSTRING(
		Expected := "1234567890",
		Actual := testShort,
		Message := 'AppendFit must fit exactly without ellipsis'
	);

// 3. Overflow by 1 char: truncates and appends ellipsis '…'
testShort := "12345";
TOF_Core.WideStrings.AppendFit(targetString := testShort, sourceString := "678901");
AssertEquals_WSTRING(
		Expected := "123456789…",
		Actual := testShort,
		Message := 'AppendFit must truncate and append ellipsis on 1 char overflow'
	);

// 4. Overflow by many chars: truncates and appends ellipsis '…'
testShort := "12345";
TOF_Core.WideStrings.AppendFit(targetString := testShort, sourceString := sourceLong);
AssertEquals_WSTRING(
		Expected := "123450123…",
		Actual := testShort,
		Message := 'AppendFit must truncate and append ellipsis on large overflow'
	);

// 5. Empty source: target remains unchanged
testShort := "12345";
TOF_Core.WideStrings.AppendFit(targetString := testShort, sourceString := "");
AssertEquals_WSTRING(
		Expected := "12345",
		Actual := testShort,
		Message := 'AppendFit must leave target unchanged for empty source'
	);

// 6. Appending to empty target
testShort := "";
TOF_Core.WideStrings.AppendFit(targetString := testShort, sourceString := sourceLong);
AssertEquals_WSTRING(
		Expected := "012345678…",
		Actual := testShort,
		Message := 'AppendFit to empty target must truncate and append ellipsis'
	);

// 7. TryAppendFit normal fit
testShort := "123";
res := TOF_Core.WideStrings.TryAppendFit(targetString := testShort, sourceString := "45");
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit must return TRUE on normal fit');
AssertEquals_WSTRING(Expected := "12345", Actual := testShort, Message := 'TryAppendFit must append text');

// 8. TryAppendFit overflow
testShort := "12345";
res := TOF_Core.WideStrings.TryAppendFit(targetString := testShort, sourceString := sourceLong);
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit must return TRUE on overflow');
AssertEquals_WSTRING(
		Expected := "123450123…",
		Actual := testShort,
		Message := 'TryAppendFit must truncate and append ellipsis'
	);

// 9. AppendFit255 multiple arguments and literals
testShort := "12";
TOF_Core.WideStrings.AppendFit255(testShort, "3", "4", "5");
AssertEquals_WSTRING(
		Expected := "12345",
		Actual := testShort,
		Message := 'AppendFit255 must append multiple fragments'
	);

// 10. AppendFit255 overflow truncation
testShort := "12";
TOF_Core.WideStrings.AppendFit255(testShort, "345", "678", "9012");
AssertEquals_WSTRING(
		Expected := "123456789…",
		Actual := testShort,
		Message := 'AppendFit255 must truncate and append ellipsis on overflow'
	);

// 11. TryAppendFit255 normal fit
testShort := "12";
res := TOF_Core.WideStrings.TryAppendFit255(testShort, "3", "4", "5");
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit255 must return TRUE on normal fit');
AssertEquals_WSTRING(
		Expected := "12345",
		Actual := testShort,
		Message := 'TryAppendFit255 must append multiple fragments'
	);

// 12. TryAppendFit255 overflow
testShort := "12";
res := TOF_Core.WideStrings.TryAppendFit255(testShort, "345", "678", "9012");
AssertEquals_BOOL(Expected := TRUE, Actual := res, Message := 'TryAppendFit255 must return TRUE on overflow');
AssertEquals_WSTRING(
		Expected := "123456789…",
		Actual := testShort,
		Message := 'TryAppendFit255 must truncate and append ellipsis on overflow'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{d08c00e3-4480-409e-af2c-b29fec1ed9d7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2a897220-4c8c-44b8-92e9-6f44af874c07}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
