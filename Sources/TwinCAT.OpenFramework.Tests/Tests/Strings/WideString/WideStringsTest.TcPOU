FUNCTION_BLOCK WideStringsTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Append();
AppendFit();
ConcatFit255();
AnyToStringFit255();
ReplaceInSource();
Split();
Join();
Trim();]]></ST>
    </Implementation>
    <Method Name="AnyToStringFit255" Id="{3572cbf8-5263-4efa-b5a0-4190dfe7f072}">
      <Declaration><![CDATA[METHOD AnyToStringFit255
VAR
	anyResult : WSTRING(255);
	boolVal : BOOL := TRUE;
	intVal : DINT := 12345;
	shortStr : STRING(50) := 'Sample string';
	shortWstr : WSTRING(50) := "Sample wide string";
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// 1. Format boolean
anyResult := TOF_Core.WideStrings.AnyToStringFit255(boolVal);
AssertEquals_WSTRING("TRUE", anyResult, 'AnyToStringFit255 must format BOOL');

// 2. Format integer
anyResult := TOF_Core.WideStrings.AnyToStringFit255(intVal);
AssertEquals_WSTRING("12345", anyResult, 'AnyToStringFit255 must format DINT');

// 3. Format STRING that fits in 255
anyResult := TOF_Core.WideStrings.AnyToStringFit255(shortStr);
AssertEquals_WSTRING("Sample string", anyResult, 'AnyToStringFit255 must convert short STRING to WSTRING');

// 4. Format WSTRING that fits in 255
anyResult := TOF_Core.WideStrings.AnyToStringFit255(shortWstr);
AssertEquals_WSTRING("Sample wide string", anyResult, 'AnyToStringFit255 must pass short WSTRING as-is');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Append" Id="{88a48147-6775-40ec-9463-87ab1f92288c}">
      <Declaration><![CDATA[METHOD Append
VAR
	testString : WSTRING;

	expectedString : WSTRING := "Original string + first appended string + second appended string";
	
	stringToAppend_1 : WSTRING := "first appended string";
	stringToAppend_2 : WSTRING := "second appended string";
	plusString : WSTRING := " + ";
	
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

testString := "Original string";
TOF_Core.WideStrings.Append255(testString, " + ", stringToAppend_1, " + ", stringToAppend_2);
AssertEquals_WSTRING(expectedString, testString, 'Invalid WideStrings.Append255 method result');

testString := "Original string";
result := TOF_Core.WideStrings.TryAppend255(testString, " + ", stringToAppend_1, " + ", stringToAppend_2);
AssertEquals_WSTRING(expectedString, testString, 'Invalid WideStrings.TryAppend255 method result');
AssertEquals_BOOL(result, TRUE, 'Invalid WideStrings.TryAppend255 method returned result');

result := TOF_Core.WideStrings.TryAppend255(testString, " + ", stringToAppend_1);
AssertEquals_BOOL(result, FALSE, 'Invalid WideStrings.TryAppend255 method returned result');

testString := "Original string";
TOF_Core.WideStrings.Append(testString, plusString);
TOF_Core.WideStrings.Append(testString, stringToAppend_1);
TOF_Core.WideStrings.Append(testString, plusString);
TOF_Core.WideStrings.Append(testString, stringToAppend_2);
AssertEquals_WSTRING(expectedString, testString, 'Invalid WideStrings.Append method result');

testString := "Original string";
result := TOF_Core.WideStrings.TryAppend(testString, plusString)
	AND TOF_Core.WideStrings.TryAppend(testString, stringToAppend_1)
	AND TOF_Core.WideStrings.TryAppend(testString, plusString)
	AND TOF_Core.WideStrings.TryAppend(testString, stringToAppend_2);
AssertEquals_WSTRING(expectedString, testString, 'Invalid WideStrings.TryAppend method result');
AssertEquals_BOOL(result, TRUE, 'Invalid WideStrings.TryAppend METHOD returned result');

result := TOF_Core.WideStrings.TryAppend(testString, plusString)
	AND TOF_Core.WideStrings.TryAppend(testString, stringToAppend_1);
AssertEquals_BOOL(result, FALSE, 'Invalid WideStrings.TryAppend method returned result');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendFit" Id="{e08217c0-d613-42f5-a56c-21332ab50001}">
      <Declaration><![CDATA[METHOD AppendFit
VAR
	testShort : WSTRING(10);
	sourceLong : WSTRING(30) := "01234567890123456789";
	res : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// 1. Fits within capacity
testShort := "12345";
TOF_Core.WideStrings.AppendFit(testShort, "67");
AssertEquals_WSTRING("1234567", testShort, 'AppendFit must append normally when it fits');

// 2. Exact fit: fills capacity without ellipsis
testShort := "12345";
TOF_Core.WideStrings.AppendFit(testShort, "67890");
AssertEquals_WSTRING("1234567890", testShort, 'AppendFit must fit exactly without ellipsis');

// 3. Overflow by 1 char: truncates and appends ellipsis '…'
testShort := "12345";
TOF_Core.WideStrings.AppendFit(testShort, "678901");
AssertEquals_WSTRING("123456789…", testShort, 'AppendFit must truncate and append ellipsis on 1 char overflow');

// 4. Overflow by many chars: truncates and appends ellipsis '…'
testShort := "12345";
TOF_Core.WideStrings.AppendFit(testShort, sourceLong);
AssertEquals_WSTRING("123450123…", testShort, 'AppendFit must truncate and append ellipsis on large overflow');

// 5. Empty source: target remains unchanged
testShort := "12345";
TOF_Core.WideStrings.AppendFit(testShort, "");
AssertEquals_WSTRING("12345", testShort, 'AppendFit must leave target unchanged for empty source');

// 6. Appending to empty target
testShort := "";
TOF_Core.WideStrings.AppendFit(testShort, sourceLong);
AssertEquals_WSTRING("012345678…", testShort, 'AppendFit to empty target must truncate and append ellipsis');

// 7. TryAppendFit normal fit
testShort := "123";
res := TOF_Core.WideStrings.TryAppendFit(testShort, "45");
AssertEquals_BOOL(TRUE, res, 'TryAppendFit must return TRUE on normal fit');
AssertEquals_WSTRING("12345", testShort, 'TryAppendFit must append text');

// 8. TryAppendFit overflow
testShort := "12345";
res := TOF_Core.WideStrings.TryAppendFit(testShort, sourceLong);
AssertEquals_BOOL(TRUE, res, 'TryAppendFit must return TRUE on overflow');
AssertEquals_WSTRING("123450123…", testShort, 'TryAppendFit must truncate and append ellipsis');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{d08c00e3-4480-409e-af2c-b29fec1ed9d7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2a897220-4c8c-44b8-92e9-6f44af874c07}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConcatFit255" Id="{03f18aa3-1438-4161-8f24-8e381a63da34}">
      <Declaration><![CDATA[METHOD ConcatFit255
VAR
	concatResult : WSTRING(255);
	part1 : WSTRING(100);
	part2 : WSTRING(100);
	part3 : WSTRING(100);
	lastChar : WSTRING(1);
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// 1. Normal concatenation that fits in 255
concatResult := TOF_Core.WideStrings.ConcatFit255("Hello, ", "World!");
AssertEquals_WSTRING("Hello, World!", concatResult, 'ConcatFit255 must join strings normally');

// 2. Skipping empty fragments
concatResult := TOF_Core.WideStrings.ConcatFit255("Part1", "", "Part2", "", "Part3");
AssertEquals_WSTRING("Part1Part2Part3", concatResult, 'ConcatFit255 must skip empty fragments');

// 3. Overflowing 255 characters: must truncate to 255 and end with U+2026 ('…')
part1 := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
part2 := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
part3 := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";

concatResult := TOF_Core.WideStrings.ConcatFit255(part1, part2, part3);
AssertEquals_INT(255, Tc2_Standard.WLEN(concatResult), 'ConcatFit255 must truncate to 255 characters on overflow');
lastChar := Tc2_Standard.WRIGHT(concatResult, 1);
AssertEquals_WSTRING("…", lastChar, 'ConcatFit255 must end with ellipsis on overflow');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Join" Id="{283221aa-e7f9-4632-bda6-1a9f0368009d}">
      <Declaration><![CDATA[METHOD Join
VAR
	stringToSplit : WSTRING := "123 , , 456, 789 ,0";
	separator : WSTRING := ",";
	
	splitter : TOF_Core.WideStringSplittingEnumerator;

	joinedString : WSTRING;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// simple splitting
splitter := TOF_Core.WideStrings.CreateSplitter(stringToSplit, separator);

// simple joining
TOF_Core.WideStrings.Join(joinedString, separator, splitter);

AssertEquals_WSTRING(stringToSplit, joinedString, TOF_Core.Strings.Concat255('Invalid first WideStrings.Join result string ', TO_STRING(joinedString)));

// splitting with maxCount, trimming and empty string removing 
splitter := TOF_Core.WideStrings.CreateSplitter(stringToSplit, separator, 3, TRUE, TRUE);

// joining with startIndex and count
TOF_Core.WideStrings.Join(joinedString, separator, splitter, 1, 2);

AssertEquals_WSTRING("456,789", joinedString, TOF_Core.Strings.Concat255('Invalid second WideStrings.Join result string ', TO_STRING(joinedString)));

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{f4f5aa7a-86c5-40a5-836c-18725c9fbee1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0227b39f-abc8-45ee-8a3f-72373f229f87}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReplaceInSource" Id="{c1fd0c57-57d3-4910-a593-eb3ffa46d556}">
      <Declaration><![CDATA[METHOD ReplaceInSource
VAR
	testString : WSTRING(18);
	
	replacementCount : UINT;
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

testString := "abcd_abcd_abcd";
TOF_Core.WideStrings.ReplaceInSource(testString, "bc", "0", replacementCount => replacementCount);
AssertEquals_WSTRING("a0d_a0d_a0d", testString, 'Invalid WideStrings.ReplaceInSource result string');
AssertEquals_UINT(3, replacementCount, 'Invalid WideStrings.ReplaceInSource replacingCount count');

testString := "abcd_abcd_abcd";
TOF_Core.WideStrings.ReplaceInSource(testString, "bc", "123", replacementCount => replacementCount);
AssertEquals_WSTRING("a123d_a123d_a123d", testString, 'Invalid WideStrings.ReplaceInSource result string');
AssertEquals_UINT(3, replacementCount, 'Invalid WideStrings.ReplaceInSource replacingCount count');

testString := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(testString, "bc", "0", replacementCount => replacementCount);
AssertEquals_BOOL(TRUE, result, 'Invalid WideStrings.TryReplaceInSource result');
AssertEquals_WSTRING("a0d_a0d_a0d", testString, 'Invalid WideStrings.TryReplaceInSource result string');
AssertEquals_UINT(3, replacementCount, 'Invalid WideStrings.TryReplaceInSource replacingCount count');

testString := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(testString, "bc", "123", 1, 1, replacementCount => replacementCount);
AssertEquals_BOOL(TRUE, result, 'Invalid WideStrings.TryReplaceInSource result');
AssertEquals_WSTRING("abcd_a123d_abcd", testString, 'Invalid WideStrings.TryReplaceInSource result string');
AssertEquals_UINT(1, replacementCount, 'Invalid WideStrings.TryReplaceInSource replacingCount count');

testString := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(testString, "bc", "1234", replacementCount => replacementCount);
AssertEquals_BOOL(FALSE, result, 'Invalid WideStrings.TryReplaceInSource memory handling');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Split" Id="{71d1bd73-69e5-47d2-9c99-6ebd1c10e55b}">
      <Declaration><![CDATA[METHOD Split
VAR
	stringToSplit : WSTRING := "123 , 456, 789 ,,0";
	separator : WSTRING := ",";
	
	splitter : TOF_Core.WideStringSplittingEnumerator;
	currentEntry : WSTRING;
	i : BYTE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

// simple splitting
splitter := TOF_Core.WideStrings.CreateSplitter(stringToSplit, separator);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_WSTRING("123 ", currentEntry, 'Invalid WideStringSplitter entry #0');			
		1:
			AssertEquals_WSTRING(" 456", currentEntry, 'Invalid WideStringSplitter entry #1');
		2:
			AssertEquals_WSTRING(" 789 ", currentEntry, 'Invalid WideStringSplitter entry #2');
		3:
			AssertEquals_WSTRING("", currentEntry, 'Invalid WideStringSplitter entry #3');
		4:
			AssertEquals_WSTRING("0", currentEntry, 'Invalid WideStringSplitter entry #4');
	END_CASE	
	
	i := i + 1;
END_WHILE

// splitting with MaxCount, trimming and empty string removing 
splitter := TOF_Core.WideStrings.CreateSplitter(stringToSplit, separator, 3, TRUE, TRUE);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_WSTRING("123", currentEntry, 'Invalid WideStringSplitter entry #0');			
		1:
			AssertEquals_WSTRING("456", currentEntry, 'Invalid WideStringSplitter entry #1');
		2:
			AssertEquals_WSTRING("789", currentEntry, 'Invalid WideStringSplitter entry #2');
		ELSE
			AssertFalse(i > 3, 'Invalid WideStringSplitter MaxCount handling');
	END_CASE	
	
	i := i + 1;
END_WHILE

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Trim" Id="{a9bd8a2b-d5f3-4fc9-867e-a9c2e4a29101}">
      <Declaration><![CDATA[METHOD Trim
VAR
	trimString : WSTRING;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

trimString := "  123   ";
TOF_Core.WideStrings.TrimChar(trimString, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT);
AssertEquals_WSTRING("123", trimString, 'Invalid wide string trimming result (TRIM_MODE = LEFT_AND_RIGHT)');			

trimString := "  123   ";
TOF_Core.WideStrings.TrimChar(trimString, trimMode := TOF_Core.TRIM_MODE.LEFT);
AssertEquals_WSTRING("123   ", trimString, 'Invalid wide string trimming result (TRIM_MODE = LEFT)');			

trimString := "  123   ";
TOF_Core.WideStrings.TrimChar(trimString, trimMode := TOF_Core.TRIM_MODE.RIGHT);
AssertEquals_WSTRING("  123", trimString, 'Invalid wide string trimming result (TRIM_MODE = RIGHT)');			

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>