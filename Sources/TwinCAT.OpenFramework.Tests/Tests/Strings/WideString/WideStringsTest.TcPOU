    </Property>
    <Method Name="ReplaceInSource" Id="{c1fd0c57-57d3-4910-a593-eb3ffa46d556}">
      <Declaration><![CDATA[METHOD ReplaceInSource
VAR
	testString : WSTRING(18);
	
	replacementCount : UINT;
	result : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

testString := "abcd_abcd_abcd";
TOF_Core.WideStrings.ReplaceInSource(
	sourceString := testString,
	oldSubstring := "bc",
	newSubstring := "0",
	replacementCount => replacementCount
);
AssertEquals_WSTRING(
		Expected := "a0d_a0d_a0d",
		Actual := testString,
		Message := 'Invalid WideStrings.ReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 3,
		Actual := replacementCount,
		Message := 'Invalid WideStrings.ReplaceInSource replacingCount count'
	);

testString := "abcd_abcd_abcd";
TOF_Core.WideStrings.ReplaceInSource(
	sourceString := testString,
	oldSubstring := "bc",
	newSubstring := "123",
	replacementCount => replacementCount
);
AssertEquals_WSTRING(
		Expected := "a123d_a123d_a123d",
		Actual := testString,
		Message := 'Invalid WideStrings.ReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 3,
		Actual := replacementCount,
		Message := 'Invalid WideStrings.ReplaceInSource replacingCount count'
	);

testString := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := testString,
	oldSubstring := "bc",
	newSubstring := "0",
	replacementCount => replacementCount
);
AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Invalid WideStrings.TryReplaceInSource result');
AssertEquals_WSTRING(
		Expected := "a0d_a0d_a0d",
		Actual := testString,
		Message := 'Invalid WideStrings.TryReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 3,
		Actual := replacementCount,
		Message := 'Invalid WideStrings.TryReplaceInSource replacingCount count'
	);

testString := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := testString,
	oldSubstring := "bc",
	newSubstring := "123",
	maxReplacements := 1,
	skipReplacements := 1,
	replacementCount => replacementCount
);
AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Invalid WideStrings.TryReplaceInSource result');
AssertEquals_WSTRING(
		Expected := "abcd_a123d_abcd",
		Actual := testString,
		Message := 'Invalid WideStrings.TryReplaceInSource result string'
	);
AssertEquals_UINT(
		Expected := 1,
		Actual := replacementCount,
		Message := 'Invalid WideStrings.TryReplaceInSource replacingCount count'
	);

testString := "abcd_abcd_abcd";
result := TOF_Core.WideStrings.TryReplaceInSource(
	sourceString := testString,
	oldSubstring := "bc",
	newSubstring := "1234",
	replacementCount => replacementCount
);
AssertEquals_BOOL(
		Expected := FALSE,
		Actual := result,
		Message := 'Invalid WideStrings.TryReplaceInSource memory handling'
	);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Split" Id="{71d1bd73-69e5-47d2-9c99-6ebd1c10e55b}">
      <Declaration><![CDATA[(*!
<summary>Exercises string traversal with a persistent splitter and borrowed source.</summary>
<description>
The splitter retains ownership across exception propagation; Reset releases current fragments before reuse
and normal completion. The persistent source remains alive for the entire cursor lifetime.
</description>
*)
METHOD Split
VAR
	separator : WSTRING := ",";
	
	currentEntry : WSTRING;
	i : BYTE;
END_VAR
VAR_INST
	stringToSplit : WSTRING := "123 , 456, 789 ,,0";
	splitter : TOF_Core.WideStringSplittingEnumerator;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

// simple splitting
splitter.Reset();
splitter := TOF_Core.WideStrings.CreateSplitter(sourceString := stringToSplit, separator := separator);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_WSTRING(Expected := "123 ", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #0');			
		1:
			AssertEquals_WSTRING(Expected := " 456", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #1');
		2:
			AssertEquals_WSTRING(Expected := " 789 ", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #2');
		3:
			AssertEquals_WSTRING(Expected := "", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #3');
		4:
			AssertEquals_WSTRING(Expected := "0", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #4');
	END_CASE	
	
	i := i + 1;
END_WHILE

AssertEquals_BYTE(Expected := 5, Actual := i, Message := 'Unrestricted splitting must return all five fragments');

// splitting with MaxCount, trimming and empty string removing 
splitter.Reset();
splitter := TOF_Core.WideStrings.CreateSplitter(
	sourceString := stringToSplit,
	separator := separator,
	maxCount := 3,
	trimEntries := TRUE,
	removeEmptyEntries := TRUE
);

i := 0;

WHILE splitter.MoveNext() DO
	currentEntry := splitter.CurrentEntry;
	
	CASE i OF
		0:
			AssertEquals_WSTRING(Expected := "123", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #0');			
		1:
			AssertEquals_WSTRING(Expected := "456", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #1');
		2:
			AssertEquals_WSTRING(Expected := "789", Actual := currentEntry, Message := 'Invalid WideStringSplitter entry #2');
		ELSE
			AssertEquals_BOOL(Expected := TRUE, Actual := FALSE, Message := 'Invalid WideStringSplitter MaxCount handling');
	END_CASE	
	
	i := i + 1;
END_WHILE

AssertEquals_BYTE(Expected := 3, Actual := i, Message := 'MaxCount splitting must return exactly three fragments');

splitter.Reset();

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Trim" Id="{a9bd8a2b-d5f3-4fc9-867e-a9c2e4a29101}">
      <Declaration><![CDATA[METHOD Trim
VAR
	trimString : WSTRING;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

trimString := "  123   ";
TOF_Core.WideStrings.TrimChar(stringToTrim := trimString, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT);
AssertEquals_WSTRING(
		Expected := "123",
		Actual := trimString,
		Message := 'Invalid wide string trimming result (TRIM_MODE = LEFT_AND_RIGHT)'
	);			

trimString := "  123   ";
TOF_Core.WideStrings.TrimChar(stringToTrim := trimString, trimMode := TOF_Core.TRIM_MODE.LEFT);
AssertEquals_WSTRING(
		Expected := "123   ",
		Actual := trimString,
		Message := 'Invalid wide string trimming result (TRIM_MODE = LEFT)'
	);			

trimString := "  123   ";
TOF_Core.WideStrings.TrimChar(stringToTrim := trimString, trimMode := TOF_Core.TRIM_MODE.RIGHT);
AssertEquals_WSTRING(
		Expected := "  123",
		Actual := trimString,
		Message := 'Invalid wide string trimming result (TRIM_MODE = RIGHT)'
	);			

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SplitterSeparatorBounds" Id="{754b07fa-8baf-4da5-8b3d-24c901e81fb7}">
      <Declaration><![CDATA[(*!
<summary>Checks separator rejection before fixed-size splitter storage can truncate the argument.</summary>
<description>
Covers lengths 80, 81, 255 and 256 through throwing and Try APIs. Uses persistent source and splitter storage;
Reset releases every fragment before reuse. The runner owns caught exception cleanup at the task boundary.
</description>
*)
METHOD SplitterSeparatorBounds
VAR
	separatorLength : UINT;
	missingSource : REFERENCE TO WSTRING;
	separatorBytes : POINTER TO BYTE;
	separatorWords : POINTER TO WORD;
	j : INT;
	i : INT;
	caught : BOOL;
	result : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	exception : TOF_Core.IException;
	rangeException : TOF_Core.IArgumentOutOfRangeException;
END_VAR
VAR_INST
	source : WSTRING := "x";
	separator : WSTRING(256);
	splitter : TOF_Core.WideStringSplittingEnumerator;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
separatorBytes := ADR(separator);
separatorWords := ADR(separator);

FOR i := 0 TO 3 DO
	CASE i OF
		0:
			separatorLength := 80;
		1:
			separatorLength := 81;
		2:
			separatorLength := 255;
		3:
			separatorLength := 256;
	END_CASE

	Tc2_System.MEMSET(destAddr := separatorBytes, fillByte := 0, n := SIZEOF(separator));
	FOR j := 0 TO TO_INT(separatorLength) - 1 DO
		separatorWords[j] := WORD#16#61;
	END_FOR

	result := TOF_Core.WideStrings.TryCreateSplitter(sourceString := source, separator := separator, splitter => splitter);
	AssertEquals_BOOL(
		Expected := separatorLength = 80,
		Actual := result,
		Message := 'TryCreateSplitter must accept 80 and reject every longer separator'
	);
	splitter.Reset();
	caught := FALSE;

	__TRY
		splitter := TOF_Core.WideStrings.CreateSplitter(sourceString := source, separator := separator);
	__CATCH(exceptionCode)
		caught := TRUE;
		exception := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		AssertEquals_BOOL(
			Expected := TRUE,
			Actual := __QUERYINTERFACE(exception, rangeException),
			Message := 'An overlong separator must raise ArgumentOutOfRangeException'
		);
	__ENDTRY

	AssertEquals_BOOL(
		Expected := separatorLength > 80,
		Actual := caught,
		Message := 'CreateSplitter must reject overlong separators before initialization'
	);
	splitter.Reset();
END_FOR

caught := FALSE;

__TRY
	result := TOF_Core.WideStrings.TryCreateSplitter(
		sourceString := missingSource,
		separator := ",",
		splitter => splitter
	);
__CATCH
	caught := TRUE;
__ENDTRY

AssertEquals_BOOL(Expected := FALSE, Actual := caught, Message := 'TryCreateSplitter must contain source failures');
AssertEquals_BOOL(Expected := FALSE, Actual := result, Message := 'A missing source must not initialize a splitter');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnyToStringFitLongInputs" Id="{f87e62ab-83cc-44a5-af78-6471d4901b48}">
      <Declaration><![CDATA[(*!
<summary>Checks that long STRING and WSTRING diagnostics end with one U+2026 code unit.</summary>
<description>
Tests 256-character truncation and the exact 255-character boundary through the public ANY formatter.
The narrow fixture uses ASCII byte offsets; its initialized final byte remains zero until explicitly shortened.
</description>
*)
METHOD AnyToStringFitLongInputs
VAR
	narrow : STRING(256);
	wide : WSTRING(256);
	wideData : POINTER TO WORD;
	result : WSTRING(255);
	resultData : POINTER TO WORD;
	i : INT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
wideData := ADR(wide);
resultData := ADR(result);

// SA0175: Fill 256 ASCII bytes in STRING(256); its initialized final byte remains the terminator.
{analysis -175}
FOR i := 0 TO 255 DO
	narrow[i] := BYTE#16#61;
	wideData[i] := WORD#16#61;
END_FOR
{analysis +175}

result := TOF_Core.WideStrings.AnyToStringFit255(value := narrow);
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := TOF_Core.WideStrings.GetLength(value := result) = 255
		AND_THEN resultData[253] = WORD#16#61
		AND_THEN resultData[254] = WORD#16#2026
		AND_THEN resultData[255] = WORD#0,
	Message := 'A long STRING must retain 254 characters and append exactly U+2026'
);

result := TOF_Core.WideStrings.AnyToStringFit255(value := wide);
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := TOF_Core.WideStrings.GetLength(value := result) = 255
		AND_THEN resultData[253] = WORD#16#61
		AND_THEN resultData[254] = WORD#16#2026
		AND_THEN resultData[255] = WORD#0,
	Message := 'A long WSTRING must retain 254 characters and append exactly U+2026'
);

// SA0175: Shorten the ASCII payload to exactly 255 bytes by moving its terminator.
{analysis -175}
narrow[255] := BYTE#0;
{analysis +175}
wideData[255] := WORD#0;
result := TOF_Core.WideStrings.AnyToStringFit255(value := narrow);
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := TOF_Core.WideStrings.GetLength(value := result) = 255 AND_THEN resultData[254] = WORD#16#61,
	Message := 'An exact-fit STRING must keep its final character'
);
result := TOF_Core.WideStrings.AnyToStringFit255(value := wide);
AssertEquals_BOOL(
	Expected := TRUE,
	Actual := TOF_Core.WideStrings.GetLength(value := result) = 255 AND_THEN resultData[254] = WORD#16#61,
	Message := 'An exact-fit WSTRING must keep its final character'
);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>