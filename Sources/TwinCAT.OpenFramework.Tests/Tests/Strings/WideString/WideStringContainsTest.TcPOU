<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringContainsTest" Id="{b65cf2eb-0a85-457c-879e-bf3fece333fe}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks exact, case-sensitive substring matching and empty inputs.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{cff6f72f-8f34-4f22-8aff-dad1db092f8c}">
      <Declaration><![CDATA[(*!
<summary>Checks exact, case-sensitive substring matching and empty inputs.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	containsResult : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "Hello");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for prefix substring"
).IsTrue();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "world");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for middle substring"
).IsTrue();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "!");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for suffix substring"
).IsTrue();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "Hello, world!");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for identical string"
).IsTrue();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for empty substring in non-empty string"
).IsTrue();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "", stringToFind := "");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return TRUE for empty substring in empty string"
).IsTrue();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "", stringToFind := "a");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return FALSE for non-empty substring in empty string"
).IsFalse();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "xyz");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return FALSE when substring is absent"
).IsFalse();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "Hello, world!", stringToFind := "hello");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must be case-sensitive"
).IsFalse();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "abc", stringToFind := "abcdef");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must return FALSE when substring is longer than source"
).IsFalse();

containsResult := TOF_Core.WideStrings.Contains(stringToSearchIn := "aaab", stringToFind := "aab");
Assert.ThatBool(
	actual := containsResult,
	message := "Contains must restart after a partially matching prefix"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{30b01753-aa15-43e1-8645-ca043a97677a}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0c37f691-aca9-4726-89bd-aebbd0077b97}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{9aef7edb-22aa-472a-bfd0-1152fe370292}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d34aa28b-c6d2-4738-9dd5-d497e26ca111}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{812f6d73-9a5a-480f-ae8e-904aecf27ca8}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b5b3501a-997a-41d0-9500-c70c03c8d231}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
