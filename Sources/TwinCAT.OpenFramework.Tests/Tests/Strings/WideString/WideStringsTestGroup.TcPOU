<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringsTestGroup" Id="{edc3fc4a-c574-4eed-93db-6d5af7501ae4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups wide-string formatting, editing, search and splitter contracts.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringsTestGroup EXTENDS TOF_Testing.TestGroup<11>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_AnyToStringFit255 : WideStringFitFormattingTest(name := "AnyToStringFit255", parent := THIS^);
	_Append : WideStringAppendTest(name := "Append", parent := THIS^);
	_AppendFit : WideStringAppendFitTest(name := "AppendFit", parent := THIS^);
	_ConcatFit255 : WideStringConcatFitTest(name := "ConcatFit255", parent := THIS^);
	_Contains : WideStringContainsTest(name := "Contains", parent := THIS^);
	_Join : WideStringJoinTest(name := "Join", parent := THIS^);
	_ReplaceInSource : WideStringReplacementTest(name := "ReplaceInSource", parent := THIS^);
	_Split : WideStringSplitTest(name := "Split", parent := THIS^);
	_Trim : WideStringTrimTest(name := "Trim", parent := THIS^);
	_SplitterSeparatorBounds : WideStringSeparatorBoundsTest(name := "SplitterSeparatorBounds", parent := THIS^);
	_AnyToStringFitLongInputs : WideStringLongFitFormattingTest(name := "AnyToStringFitLongInputs", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_AnyToStringFit255,
		_Append,
		_AppendFit,
		_ConcatFit255,
		_Contains,
		_Join,
		_ReplaceInSource,
		_Split,
		_Trim,
		_SplitterSeparatorBounds,
		_AnyToStringFitLongInputs
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{88f66cc8-dc2a-4b1c-bfc3-b7a0d84f963a}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{d532122e-6655-437a-aa30-f526366bcb11}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{5e728a1a-73b0-4356-ad10-6319e34c2081}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{10d294dd-2858-45cb-a0bb-0aa95b7920b4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{50e83767-8d50-4bd5-bb2d-9b88013405a3}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9a000aaf-e4b2-434d-8f51-c2c50288ad2c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{71de2408-7c69-4beb-a2a8-2653711be038}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{622d0643-3993-4ba4-9f87-b3a2cb118713}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
