<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringTrimTest" Id="{ca6380c1-a5e4-4534-8097-3bb51c95d3d1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks trimming direction, custom characters and complete removal.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringTrimTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{06eba7ae-c660-41e6-943c-08fde3f52334}">
      <Declaration><![CDATA[(*!
<summary>Checks trimming direction, custom characters and complete removal.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	text : WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[text := "  123   ";
TOF_Core.WideStrings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT);
Assert.ThatBool(
	actual := text = "123",
	message := "TrimChar must apply LEFT_AND_RIGHT exactly"
).IsTrue();

text := "  123   ";
TOF_Core.WideStrings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.LEFT);
Assert.ThatBool(
	actual := text = "123   ",
	message := "TrimChar must apply LEFT exactly"
).IsTrue();

text := "  123   ";
TOF_Core.WideStrings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.RIGHT);
Assert.ThatBool(
	actual := text = "  123",
	message := "TrimChar must apply RIGHT exactly"
).IsTrue();

text := "**a*b**";
TOF_Core.WideStrings.TrimChar(stringToTrim := text, trimMode := TOF_Core.TRIM_MODE.LEFT_AND_RIGHT, trimChar := "*");
Assert.ThatBool(
	actual := text = "a*b",
	message := "Trimming a custom character must preserve an internal match"
).IsTrue();

text := "***";
TOF_Core.WideStrings.TrimChar(stringToTrim := text, trimChar := "*");
Assert.ThatBool(
	actual := text = "",
	message := "Trimming all matching characters must make the result empty"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{cd845a27-04e7-4bbe-b02d-56a1db0fd7c8}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5fdf6e34-2442-4030-b7a6-37ff90c08e9a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ba9d5ca0-f1f8-4230-8837-f12ed2213186}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{00b3ea44-47f2-4891-803c-8b1397ce0a36}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{ef50b0c1-3108-49cc-ae13-cfc62a9d6fbf}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{364264df-07ea-4a5b-8bcd-1b0ab0100120}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
