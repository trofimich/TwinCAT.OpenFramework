<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringFitFormattingTest" Id="{fdce5f12-caf7-4f51-be4c-ccee78e39955}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks scalar and short text formatting through the fitted ANY API.

Uses one task and stays at a stable address while assertions are bound to this instance.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringFitFormattingTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{067c878a-361e-49db-a293-718cac03aacb}">
      <Declaration><![CDATA[(* Checks scalar and short text formatting through the fitted ANY API. *)
METHOD PROTECTED ExecuteTest
VAR
	formatted : WSTRING(255);
	enabled : BOOL := TRUE;
	number : DINT := 12345;
	narrowText : STRING(50) := 'Sample string';
	wideText : WSTRING(50) := "Sample wide string";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[formatted := TOF_Core.WideStrings.ConvertAnyToStringFit255(value := enabled);
Assert.ThatBool(
	actual := formatted = "TRUE",
	message := "ConvertAnyToStringFit255 must format BOOL"
).IsTrue();

formatted := TOF_Core.WideStrings.ConvertAnyToStringFit255(value := number);
Assert.ThatBool(
	actual := formatted = "12345",
	message := "ConvertAnyToStringFit255 must format DINT"
).IsTrue();

formatted := TOF_Core.WideStrings.ConvertAnyToStringFit255(value := narrowText);
Assert.ThatBool(
	actual := formatted = "Sample string",
	message := "ConvertAnyToStringFit255 must convert short STRING to WSTRING"
).IsTrue();

formatted := TOF_Core.WideStrings.ConvertAnyToStringFit255(value := wideText);
Assert.ThatBool(
	actual := formatted = "Sample wide string",
	message := "ConvertAnyToStringFit255 must pass short WSTRING as-is"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6849256d-822d-42f3-bbc8-eeb26e258427}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{57d0a892-8f65-4901-b684-387da06c2ada}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ff95535c-6125-4f5c-afe1-e3ab627bfe62}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{44d3fd9f-f5d6-4ba7-8c20-6ac0ac4df9ea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{efd93286-4244-4528-a34a-83f5d657a132}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6fb3af60-c3d2-474a-9a3c-5d78d04078f9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
