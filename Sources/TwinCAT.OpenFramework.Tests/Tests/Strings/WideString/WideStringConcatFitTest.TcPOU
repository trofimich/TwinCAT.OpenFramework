(*!
<summary>Checks fitted concatenation, including the 255-character boundary.</summary>
<description>
Uses one task and stays at a stable address while assertions are bound to this instance.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK WideStringConcatFitTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{edbc6ca6-d6c7-4934-bac9-b983e76d1936}">
      <Declaration><![CDATA[(*!
<summary>Checks fitted concatenation, including the 255-character boundary.</summary>
<description>
Distinct fragments reveal the first discarded character and any changes in fragment order.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	text : WSTRING(255);
	first : WSTRING(100) := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
	second : WSTRING(100) := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
	third : WSTRING(100) := "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
	expectedPrefix : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[text := TOF_Core.WideStrings.ConcatFit255("Hello, ", "World!");
Assert.ThatBool(
	actual := text = "Hello, World!",
	message := "ConcatFit255 must preserve an ordinary fit"
).IsTrue();

text := TOF_Core.WideStrings.ConcatFit255("Part1", "", "Part2", "", "Part3");
Assert.ThatBool(
	actual := text = "Part1Part2Part3",
	message := "ConcatFit255 must skip empty fragments without stopping"
).IsTrue();

text := TOF_Core.WideStrings.ConcatFit255(first, second, third);
Assert.ThatInt(
	actual := Tc2_Standard.WLEN(STR := text),
	message := "ConcatFit255 must fill the 255-character result"
).ToBe(expected := 255);
expectedPrefix := Tc2_Standard.WCONCAT(STR1 := first, STR2 := second);
expectedPrefix := Tc2_Standard.WCONCAT(
	STR1 := expectedPrefix,
	STR2 := Tc2_Standard.WLEFT(STR := third, SIZE := 54)
);
Assert.ThatBool(
	actual := Tc2_Standard.WLEFT(STR := text, SIZE := 254) = expectedPrefix,
	message := "Truncation must preserve the prefix across all three fragments"
).IsTrue();
Assert.ThatBool(
	actual := Tc2_Standard.WRIGHT(STR := text, SIZE := 1) = "$2026",
	message := "Truncation must use the exact encoding-specific ellipsis"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b5c318ac-bb47-41dd-9be4-0c65d76b59f7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ea127555-f1a1-4ca6-84f2-bb8a1dafc2b6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a2cab745-8293-4900-aa09-94db7070f613}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{938d05c1-b74c-489e-8480-00e027755027}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{764bb6ff-43bf-4622-972f-f080cde39e6c}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{db4cc217-adb7-46da-81be-3ac6e6df3dc6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
