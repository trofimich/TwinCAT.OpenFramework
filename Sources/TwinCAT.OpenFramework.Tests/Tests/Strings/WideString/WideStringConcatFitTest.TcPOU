<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="WideStringConcatFitTest" Id="{8132ab94-a17b-4a07-8955-af616f8588c9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
