FUNCTION_BLOCK WideStringBuilderTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ErrorChecking();
BuildEmpty();
BuildNotEmpty();]]></ST>
    </Implementation>
    <Method Name="BuildEmpty" Id="{bccd24a5-44b5-4c87-b1cc-7ef4b3becedd}">
      <Declaration><![CDATA[(*!
<summary>Exercises string-builder behavior with persistent buffer ownership.</summary>
<description>
The fixture retains the builder if a call propagates an exception. Normal completion explicitly releases its
buffer; stack unwinding is not required for cleanup.
</description>
*)
METHOD BuildEmpty
VAR
	targetString : WSTRING;
END_VAR
VAR_INST
	stringBuilder : TOF_Core.WideStringBuilder;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

stringBuilder.AssignToString(targetString := targetString);

AssertEquals_WSTRING(Expected := "", Actual := targetString, Message := 'Invalid short string handling');

stringBuilder.Clear(releaseMemory := TRUE);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="BuildNotEmpty" Id="{730dcfca-b3d9-4ac4-9517-b2272d3f7cb9}">
      <Declaration><![CDATA[(*!
<summary>Exercises string-builder behavior with persistent buffer ownership.</summary>
<description>
The fixture retains the builder if a call propagates an exception. Normal completion explicitly releases its
buffer; stack unwinding is not required for cleanup.
</description>
*)
METHOD BuildNotEmpty
VAR
	string1 : WSTRING := "String1";
	string2 : WSTRING := "String2";
	
	targetString : WSTRING(255);
END_VAR
VAR_INST
	stringBuilder : TOF_Core.WideStringBuilder;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

stringBuilder
	.Append(value := string1)
	.AppendIf(value := string1, condition := FALSE)
	.AppendString(value := string2)
	.AppendStringIf(value := string2, condition := FALSE)
	.AppendString255(value := "String3")
	.AppendString255If(value := "String3", condition := FALSE);
	
stringBuilder.AssignToString(targetString := targetString);

AssertEquals_WSTRING(Expected := "String1String2String3", Actual := targetString, Message := 'Invalid string building');

stringBuilder.Clear(releaseMemory := TRUE);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{bbe7986a-4c57-431b-9a1e-7612db46a09c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{70cdcc5c-5ec2-4147-8fb5-a99ab81d3cd0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ErrorChecking" Id="{b3d97556-aee0-4531-8779-2a007d9a7603}">
      <Declaration><![CDATA[(*!
<summary>Exercises string-builder behavior with persistent buffer ownership.</summary>
<description>
The fixture retains the builder if a call propagates an exception. Normal completion explicitly releases its
buffer; stack unwinding is not required for cleanup.
</description>
*)
METHOD ErrorChecking
VAR
	targetString : STRING;
	shortTargetString : WSTRING(10);
END_VAR
VAR_INST
	stringBuilder : TOF_Core.WideStringBuilder;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

stringBuilder.AppendString255(value := "String1234567890");

__TRY
	stringBuilder.AssignToString(targetString := targetString);
	
	AssertEquals_BOOL(Expected := FALSE, Actual := TRUE, Message := 'Invalid string type checking in AssignToString');
__CATCH
__ENDTRY

__TRY
	stringBuilder.AssignToString(targetString := shortTargetString);
	
	AssertEquals_BOOL(Expected := FALSE, Actual := TRUE, Message := 'Invalid string length checking in AssignToString');	
__CATCH
__ENDTRY

stringBuilder.Clear(releaseMemory := TRUE);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{8f1996ae-4f8c-4745-9a97-f9ca3e61cc76}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3f0d5545-aecb-4dd8-8065-5625de75e9a5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>