<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="WideStringBuilderTest" Id="{1cc55726-2722-43a9-bbc1-c6da3eb8ae7c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
