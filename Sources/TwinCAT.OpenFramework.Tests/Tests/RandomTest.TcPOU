(*!
<summary>Checks the output bounds of the random value helpers.</summary>
<description>Each scenario samples a short series once. The first out-of-range value records a failure and ends that scenario in the same call. These checks do not establish the statistical distribution of generated values.</description>
*)
FUNCTION_BLOCK RandomTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();	
	
	_Random : TOF_Core.Random;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[GetInRange();
GetWithDispersion();
GetWithDispersionPercent();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{c63098eb-f1d1-4659-8651-4218958d4856}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f3462718-1a95-4c40-b661-2789caf059a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetInRange" Id="{9bc3a55f-15d0-4425-9ace-c713fc938781}">
      <Declaration><![CDATA[(*!
<summary>Checks that a short random series stays within the requested interval.</summary>
<description>Completes after the series or the first failed assertion; subsequent calls do nothing.</description>
*)
METHOD GetInRange
VAR
	i : INT;
	
	value : LREAL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

FOR i := 0 TO 20 DO
	value := _Random.GetInRange(100, 200);
	
	IF value < 100 OR_ELSE value > 200 THEN
		AssertEquals_BOOL(TRUE, FALSE, 'Invalid GetInRange() implementation');
		EXIT;
	END_IF
END_FOR

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetWithDispersion" Id="{4394b0e8-9382-436f-8ceb-d1938e9dcfdf}">
      <Declaration><![CDATA[(*!
<summary>Checks output bounds for an absolute dispersion.</summary>
<description>Completes after the series or the first failed assertion; subsequent calls do nothing.</description>
*)
METHOD GetWithDispersion
VAR
	i : INT;
	
	value : LREAL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

FOR i := 0 TO 20 DO
	value := _Random.GetWithDispersion(100, 10);
	
	IF value < 90 OR_ELSE value > 110 THEN
		AssertEquals_BOOL(TRUE, FALSE, 'Invalid GetWithDispersion() implementation');
		EXIT;
	END_IF
END_FOR

testFinished := TRUE; 

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetWithDispersionPercent" Id="{5c23b097-6f9c-4d39-83e0-30e50ffd0a75}">
      <Declaration><![CDATA[(*!
<summary>Checks output bounds for a percentage dispersion.</summary>
<description>Completes after the series or the first failed assertion; subsequent calls do nothing.</description>
*)
METHOD GetWithDispersionPercent
VAR
	i : INT;
	
	value : LREAL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());


FOR i := 0 TO 20 DO
	value := _Random.GetWithDispersionPercent(100, 10);
	
	IF value < 90 OR_ELSE value > 110 THEN
		AssertEquals_BOOL(TRUE, FALSE, 'Invalid GetWithDispersionPercent() implementation');
		EXIT;
	END_IF
END_FOR

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{ed1a6086-9f9b-4d07-80f4-26fbd096eecc}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2ce69c62-77bc-4051-99dc-71c5c5eadfd4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
