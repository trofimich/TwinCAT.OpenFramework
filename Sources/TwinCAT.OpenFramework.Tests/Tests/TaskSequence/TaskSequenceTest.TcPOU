<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="TaskSequenceTest" Id="{e9464de9-72eb-4b57-ac87-3d28d718d649}" SpecialFunc="None">
    <Declaration><![CDATA[(*

