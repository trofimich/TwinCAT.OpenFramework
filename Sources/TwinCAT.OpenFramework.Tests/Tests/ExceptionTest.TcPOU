(*!
<summary>Exercises exception diagnostics, propagation and clone lifetime contracts.</summary>
<description>
Tests use task-scoped exception cleanup. Borrowed inner views do not own the exceptions they inspect.
</description>
*)

FUNCTION_BLOCK ExceptionTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SimpleException();
StandardExceptions();
AggregateException();
RethrowSavedFrameworkException();
RethrowSystemExceptionAfterFramework();
TimestampFormatting();
SystemExceptionClone();
AggregateCloneLifetime();
ArgumentTypeCloneIdentity();]]></ST>
    </Implementation>
    <Method Name="AggregateCloneLifetime" Id="{b99d5e1b-9b7e-4c6c-ae5b-f36a74aebdd2}">
      <Declaration><![CDATA[(*!
<summary>Checks that an aggregate clone owns its array while sharing dynamic causes.</summary>
<description>
Reads entries through IReadOnlyException and compares identities through the same interface type. Clearing the
source aggregate must leave the clone entries available until task cleanup.
</description>
*)
METHOD AggregateCloneLifetime
VAR
	source : TOF_Core.StandardException;
	aggregate : TOF_Core.AggregateException;
	dynamicInner : TOF_Core.IReadOnlyException;
	clonedObject : TOF_Core.IObject;
	clonedAggregate : TOF_Core.IAggregateException;
	firstInner : TOF_Core.IReadOnlyException;
	storedDynamicInner : TOF_Core.IReadOnlyException;
	clonedFirstInner : TOF_Core.IReadOnlyException;
	clonedSecondInner : TOF_Core.IReadOnlyException;
	caughtCode : __SYSTEM.ExceptionCode;
	caught : BOOL;
	queried : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF

TEST(TestName := __POUNAME());

__TRY
	source.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Original inner"
	);
__CATCH(caughtCode)
	caught := TRUE;
	dynamicInner := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := caughtCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected a dynamic exception from static Throw');

IF caught THEN
	aggregate.AddInnerException(innerException := source);
	aggregate.AddInnerException(innerException := dynamicInner);
	source.Clear();
	firstInner := aggregate.GetInnerException(index := 0);
	AssertEquals_BOOL(Expected := TRUE, Actual := firstInner <> 0, Message := 'Static inner must be cloned');
	
	IF firstInner <> 0 THEN
		AssertEquals_WSTRING(
			Expected := "Original inner",
			Actual := firstInner.GetMessage(),
			Message := 'Clearing static source must not clear the stored clone'
		);
	END_IF
	
	storedDynamicInner := aggregate.GetInnerException(index := 1);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := storedDynamicInner = dynamicInner,
		Message := 'Dynamic inner must retain identity'
	);

	clonedObject := aggregate.Clone();
	queried := __QUERYINTERFACE(clonedObject, clonedAggregate);
	AssertEquals_BOOL(Expected := TRUE, Actual := queried, Message := 'Aggregate clone must implement IAggregateException');

	aggregate.Clear();
	aggregate.Clear();

	AssertEquals_UINT(
		Expected := 0,
		Actual := aggregate.InnerExceptionCount,
		Message := 'Repeated Clear must leave an empty aggregate'
	);
	IF queried THEN
		AssertEquals_UINT(
			Expected := 2,
			Actual := clonedAggregate.InnerExceptionCount,
			Message := 'Clearing source must preserve the clone array'
		);

		clonedFirstInner := clonedAggregate.GetInnerException(index := 0);
		clonedSecondInner := clonedAggregate.GetInnerException(index := 1);

		AssertEquals_BOOL(
			Expected := TRUE,
			Actual := clonedFirstInner = firstInner AND_THEN clonedSecondInner = dynamicInner,
			Message := 'Aggregate clone must borrow the same dynamic inners'
		);
	END_IF
END_IF

// All dynamic exception instances are released by the manager at the cycle boundary.
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AggregateException" Id="{a0a36685-039a-455b-9e90-8d283dc9d749}">
      <Declaration><![CDATA[METHOD AggregateException
VAR
	caught : BOOL;
	exception1Message : WSTRING := "Simple exception 1 thrown";
	exception2Message : WSTRING := "Simple exception 2 thrown";
	exception3Message : WSTRING := "Simple exception 3 thrown";
	
	errorMessage : TOF_Core.ERROR_MESSAGE;
	
	standardException1 : TOF_Core.StandardException;
	standardException2 : TOF_Core.StandardException;
	standardException3 : TOF_Core.StandardException;

	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	
	aggregateException : TOF_Core.AggregateException;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

caught := FALSE;
__TRY
	standardException1.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := exception1Message,
		errorCode := 0,
		innerException := 0
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	aggregateException.AddInnerException(innerException := caughtException);
__ENDTRY
AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

caught := FALSE;
__TRY
	standardException2.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := exception2Message,
		errorCode := 0,
		innerException := 0
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	aggregateException.AddInnerException(innerException := caughtException);
__ENDTRY
AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

caught := FALSE;
__TRY
	standardException3.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := exception3Message,
		errorCode := 0,
		innerException := 0
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	aggregateException.AddInnerException(innerException := caughtException);
__ENDTRY
AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

// for breakpoint
errorMessage := errorMessage;

caught := FALSE;
__TRY
	aggregateException.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION()
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	
	errorMessage := caughtException.GetMessage();
	
	AssertEquals_INT(
		Expected := 1,
		Actual := Tc2_Standard.WFIND(STR1 := errorMessage, STR2 := "3"),
		Message := 'Wrong aggregate exception message caught'
	);	
__ENDTRY
AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ArgumentTypeCloneIdentity" Id="{35cd05cb-95a0-46b6-a37e-a04b522270db}">
      <Declaration><![CDATA[METHOD ArgumentTypeCloneIdentity
VAR
	source : TOF_Core.ArgumentTypeNotSupportedException;
	clonedObject : TOF_Core.IObject;
	typedClone : TOF_Core.IArgumentTypeNotSupportedException;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF

TEST(TestName := __POUNAME());

clonedObject := source.Clone();
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := __QUERYINTERFACE(clonedObject, typedClone),
		Message := 'Clone must preserve IArgumentTypeNotSupportedException'
	);

// The dynamic clone is owned by DynamicMemoryManager.
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{111a4a8b-8aa4-412d-9e90-ebb90980416c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{96410920-4b2e-41a3-b06d-e24debc1540a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b777c1c9-58c7-49aa-9113-7972a528cd45}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a01d58c4-3aa8-4890-9401-b209dd4a14a3}">
