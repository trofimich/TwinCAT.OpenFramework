    <Method Name="RethrowSavedFrameworkException" Id="{1392d859-48c4-418d-bce1-a5d8e9d1aa50}">
      <Declaration><![CDATA[(*!
<summary>Checks propagation of a saved framework exception after a nested handler.</summary>
<description>
Propagates the saved exception through ExceptionManager.Throw; nested handlers do not select a replacement
payload. Static system wrappers must be cloned before callbacks that can overwrite them.
</description>
*)
METHOD RethrowSavedFrameworkException
VAR
	original : TOF_Core.StandardException;
	nested : TOF_Core.StandardException;
	saved : TOF_Core.IException;
	received : TOF_Core.IException;
	caughtCode : __SYSTEM.ExceptionCode;
	outerCode : __SYSTEM.ExceptionCode;
	caught : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF

TEST(TestName := __POUNAME());

__TRY
	__TRY
		original.Throw(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Original"
		);
	__CATCH(caughtCode)
		saved := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := caughtCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);

		__TRY
			nested.Throw(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME(),
				sourcePosition := __POSITION(),
				message := "Nested"
			);
		__CATCH
		__ENDTRY

		TOF_Core.ExceptionManager.Throw(exception := saved);
	__ENDTRY
__CATCH(outerCode)
	caught := TRUE;
	received := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := outerCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected rethrown framework exception');
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := saved <> 0 AND_THEN received = saved,
		Message := 'Nested catch must not replace the saved payload'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="RethrowSystemExceptionAfterFramework" Id="{ed6d4170-4d0a-448f-95f1-92495e20ca2e}">
      <Declaration><![CDATA[(*!
<summary>Checks SystemException propagation after a previous framework error, including nested handlers.</summary>
<description>
Propagates the saved exception through ExceptionManager.Throw; nested handlers do not select a replacement
payload. Static system wrappers must be cloned before callbacks that can overwrite them. Supplies a known
native code to the adapter without using F_RaiseException to generate the initial error. This tests wrapper
propagation; it does not verify delivery of the initial native code by TwinCAT.
</description>
*)
METHOD RethrowSystemExceptionAfterFramework
VAR
	previous : TOF_Core.StandardException;
	outerCode : __SYSTEM.ExceptionCode;
	original : TOF_Core.IException;
	received : TOF_Core.IException;
	repeated : TOF_Core.IException;
	otherSystem : TOF_Core.IException;
	expectedMessage : TOF_Core.ERROR_MESSAGE;
	savedLocalTime : LDATE_AND_TIME;
	savedUtcTime : LDATE_AND_TIME;
	caught : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF

TEST(TestName := __POUNAME());

__TRY
	previous.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Previous"
	);
__CATCH
__ENDTRY

// Model an already received native code; the runtime's initial raise bug is a separate limitation.
	original := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ARRAYBOUNDS,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := 'OriginalCatch',
		catchPointPosition := 'OriginalPosition'
	);
expectedMessage := original.GetMessage();
savedLocalTime := original.LocalTimestamp;
savedUtcTime := original.UtcTimestamp;

caught := FALSE;
__TRY
	TOF_Core.ExceptionManager.Throw(exception := original);
__CATCH(outerCode)
	caught := TRUE;
	received := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := outerCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := 'OuterCatch',
		catchPointPosition := 'OuterPosition'
	);
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected propagated system wrapper');
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := received <> 0,
		Message := 'System wrapper must be available in the next catch'
	);

IF received <> 0 THEN
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := received.IsDynamicInstance,
		Message := 'Static system wrapper must be cloned for propagation'
	);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := received <> original,
		Message := 'Propagated wrapper must be independent of shared storage'
	);
	AssertEquals_WSTRING(
		Expected := expectedMessage,
		Actual := received.GetMessage(),
		Message := 'Wrapper must retain native error and original catch point'
	);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := received.LocalTimestamp = savedLocalTime AND_THEN received.UtcTimestamp = savedUtcTime,
		Message := 'Wrapper must retain original timestamps'
	);

	otherSystem := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ACCESS_VIOLATION,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := 'OtherCatch',
		catchPointPosition := 'OtherPosition'
	);
	AssertEquals_WSTRING(
		Expected := expectedMessage,
		Actual := received.GetMessage(),
		Message := 'Another system catch must not overwrite the propagated wrapper'
	);

	// Replace the manager payload before propagating the saved dynamic wrapper again.
	__TRY
		previous.Throw(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Nested"
		);
	__CATCH
	__ENDTRY
	
	caught := FALSE;
	
	__TRY
		TOF_Core.ExceptionManager.Throw(exception := received);
	__CATCH(outerCode)
		caught := TRUE;
		repeated := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := outerCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := 'NextCatch',
			catchPointPosition := 'NextPosition'
		);
	__ENDTRY
	
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := caught,
		Message := 'Expected saved system wrapper to be propagated again'
	);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := repeated = received,
		Message := 'Repeated propagation must retain the saved dynamic wrapper identity'
	);
END_IF

// Callers without a saved payload supply the catch code and location directly.
caught := FALSE;
repeated := 0;

__TRY
	TOF_Core.ExceptionManager.ReThrowLastException(
		exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_ARRAYBOUNDS,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := 'OriginalCatch',
		catchPointPosition := 'OriginalPosition'
	);
__CATCH(outerCode)
	caught := TRUE;
	repeated := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := outerCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := 'OuterCatch',
		catchPointPosition := 'OuterPosition'
	);
__ENDTRY

AssertEquals_BOOL(
		Expected := TRUE,
		Actual := caught,
		Message := 'Expected native code to be wrapped without a supplied payload'
	);
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := repeated <> 0,
		Message := 'Expected a wrapper for the supplied native code'
	);

IF repeated <> 0 THEN
	AssertEquals_WSTRING(
		Expected := expectedMessage,
		Actual := repeated.GetMessage(),
		Message := 'Code-only propagation must preserve native error and catch point'
	);
END_IF

// Dynamic wrappers belong to DynamicMemoryManager until cycle cleanup.
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SimpleException" Id="{68b793dc-aa3d-48fc-b926-e787c555c9b4}">
      <Declaration><![CDATA[//!<param name="exceptionCode">filled by __CATCH statement</param>

//!<param name="exception">exception object returned by ExceptionManager</param>

//!<param name="notImplementedException">to filter specific exception type</param>

//!<param name="exceptionMessage">exception message</param>

METHOD SimpleException
VAR
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode; 
	
	exception : TOF_Core.IException; 
	
	notImplementedException : TOF_Core.INotImplementedException; 
	
	exceptionMessage : WSTRING(255); 
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

caught := FALSE;

__TRY	
	throwNotImplementedException(); // your logic
__CATCH(exceptionCode)
	caught := TRUE;
	exception := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	); // get exception object

	IF __QUERYINTERFACE(exception, notImplementedException) THEN // check if exception is of NotImplemented class
		exceptionMessage := notImplementedException.GetMessage(); // Get exception message	

		AssertEquals_WSTRING(
			Expected := "Program organization unit 'TOF_Tests.ExceptionTest.throwNotImplementedException()' is not implemented",
			Actual := exceptionMessage,
			Message := 'Wrong NotImplementedException message'
		);
	ELSE
		AssertEquals_BOOL(Expected := TRUE, Actual := FALSE, Message := 'Wrong exception class'); // handle all other exceptions
	END_IF
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="StandardExceptions" Id="{c3d65c3a-6585-4f11-ab6e-5902e1fc565c}">
      <Declaration><![CDATA[METHOD StandardExceptions
VAR
	caught : BOOL;
	exception1Message : WSTRING := "Simple exception 1";
	exception2Message : WSTRING := "Simple exception 2";
	exception3Message : WSTRING := "Simple exception 3";
	
	expectedErrorMessage : WSTRING(255);
	recievedErrorMessage : WSTRING(255);
	
	standardException1 : TOF_Core.StandardException;
	standardException2 : TOF_Core.StandardException;
	standardException3 : TOF_Core.StandardException;
	
	caughtException : TOF_Core.IException;
	
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

caught := FALSE;

__TRY
	standardException1.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := exception1Message,
		errorCode := 0,
		innerException := 0
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	
	expectedErrorMessage := exception2Message;
	recievedErrorMessage := caughtException.GetMessage();
	
	AssertEquals_WSTRING(
		Expected := exception1Message,
		Actual := recievedErrorMessage,
		Message := 'Wrong exception1 message caught'
	);	
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

caught := FALSE;
__TRY
	standardException2.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := exception2Message,
		errorCode := 0,
		innerException := caughtException
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	
	expectedErrorMessage := TOF_Core.WideStrings.Concat255(exception2Message, " -> ", exception1Message);
	recievedErrorMessage := caughtException.GetMessage();
	
	AssertEquals_WSTRING(
		Expected := expectedErrorMessage,
		Actual := recievedErrorMessage,
		Message := 'Wrong exception2 message caught'
	);	
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

caught := FALSE;
__TRY
	standardException3.Throw(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := exception3Message,
		errorCode := 0,
		innerException := caughtException
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	
	expectedErrorMessage := TOF_Core.WideStrings.Concat255(exception3Message, " -> ", exception2Message, " -> ", exception1Message);
	recievedErrorMessage := caughtException.GetMessage();
	
	AssertEquals_WSTRING(
		Expected := expectedErrorMessage,
		Actual := recievedErrorMessage,
		Message := 'Wrong exception3 message caught'
	);	
__ENDTRY

AssertEquals_BOOL(Expected := TRUE, Actual := caught, Message := 'Expected exception was not raised');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SystemExceptionClone" Id="{3200f00a-26ae-4015-a0c7-0b96c15b71ce}">
      <Declaration><![CDATA[METHOD SystemExceptionClone
VAR
	original : TOF_Core.IException;
	clonedObject : TOF_Core.IObject;
	clonedException : TOF_Core.IException;
	queried : BOOL;
	message : TOF_Core.ERROR_MESSAGE;
	savedLocalTime : LDATE_AND_TIME;
	savedUtcTime : LDATE_AND_TIME;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF

TEST(TestName := __POUNAME());

original := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_OUT_OF_MEMORY,
		catchPointNamespaceName := 'CloneTest',
		catchPointPOUName := 'OriginalCatch',
		catchPointPosition := 'P1'
	);
message := original.GetMessage();
savedLocalTime := original.LocalTimestamp;
savedUtcTime := original.UtcTimestamp;

clonedObject := original.Clone();

queried := __QUERYINTERFACE(clonedObject, clonedException);
AssertEquals_BOOL(Expected := TRUE, Actual := queried, Message := 'System clone must implement IException');

IF queried THEN
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := clonedException.IsDynamicInstance,
		Message := 'System clone must be dynamic'
	);
	// Reconfigure the shared system instance; the clone must retain the original catch point.
	original := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := __SYSTEM.ExceptionCode.RTSEXCPT_NOEXCEPTION,
		catchPointNamespaceName := 'Changed',
		catchPointPOUName := 'Changed',
		catchPointPosition := 'P2'
	);
	AssertEquals_WSTRING(
		Expected := message,
		Actual := clonedException.GetMessage(),
		Message := 'System clone must preserve code and catch point'
	);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := clonedException.LocalTimestamp = savedLocalTime AND_THEN clonedException.UtcTimestamp = savedUtcTime,
		Message := 'System clone must preserve occurrence timestamps'
	);
END_IF

// The clone belongs to DynamicMemoryManager. Do not release it manually.
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="throwNotImplementedException" Id="{812cab99-b998-4b88-8bd1-6a55f32844fc}">
      <Declaration><![CDATA[METHOD PRIVATE throwNotImplementedException
VAR
	notImplementedException : TOF_Core.NotImplementedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[notImplementedException.Throw(
	sourceNamespaceName := NamespaceName,
	sourceClassName := ClassName,
	sourcePOUName := __POUNAME(),
	sourcePosition := __POSITION()
); ]]></ST>
      </Implementation>
    </Method>
    <Method Name="TimestampFormatting" Id="{c65b5cb7-89c0-49a5-bd2f-0f0ddba4cfdd}">
      <Declaration><![CDATA[METHOD TimestampFormatting
VAR
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INST
	probe : ExceptionTimestampProbe;
	testFinished : BOOL;
END_VAR
VAR CONSTANT
	localTime : LDATE_AND_TIME := LDT#2026-10-06-15:04:05;
	utcTime : LDATE_AND_TIME := LDT#2026-10-06-12:04:05;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF

TEST(TestName := __POUNAME());

message := probe.FormatTimestamp(mode := TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN, localTime := localTime, utcTime := utcTime);
AssertEquals_WSTRING(Expected := "", Actual := message, Message := 'Hidden timestamp must produce no text');

message := probe.FormatTimestamp(mode := TOF_Core.TIMESTAMP_DISPLAY_MODE.LOCAL, localTime := localTime, utcTime := utcTime);
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "15:04:05") > 0,
		Message := 'Local mode must use local time'
	);
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "UTC") = 0,
		Message := 'Local mode must not have a UTC suffix'
	);

message := probe.FormatTimestamp(mode := TOF_Core.TIMESTAMP_DISPLAY_MODE.UTC, localTime := localTime, utcTime := utcTime);
AssertEquals_BOOL(
		Expected := TRUE,
		Actual := Tc2_Standard.WFIND(STR1 := message, STR2 := "12:04:05") > 0,
		Message := 'UTC mode must use UTC time'
	);
AssertEquals_WSTRING(
		Expected := "UTC",
		Actual := Tc2_Standard.WRIGHT(STR := message, SIZE := 3),
		Message := 'UTC suffix must survive timestamp truncation'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>