<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="BoundTaskRunningSubstateTest" Id="{3b081b9a-b999-41b4-b97f-6455eb230f69}" SpecialFunc="None">
    <Declaration><![CDATA[(*
