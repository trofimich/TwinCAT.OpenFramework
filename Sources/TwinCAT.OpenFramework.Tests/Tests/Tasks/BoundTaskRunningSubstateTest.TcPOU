(*!
<summary>Checks that a bound TaskRunningSubstate view observes changes to its backing data.</summary>
<description>
Exercises all defined values through the same view in one call. The backing data and view are local to the call.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK BoundTaskRunningSubstateTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{81005b07-da3b-4325-883a-aab36dbefd1d}">
      <Declaration><![CDATA[//! <summary>Sets each backing value and checks the corresponding value and flags.</summary>
METHOD PROTECTED ExecuteTest
VAR
	backingValue : TOF_Tasks.TASK_RUNNING_SUBSTATE;
	view : TOF_Tasks.TaskRunningSubstate(taskRunningSubstate := backingValue);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[backingValue := TOF_Tasks.TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING;
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING,
	message := "Value must track RESOURCE_ACQUIRING"
).IsTrue();
Assert.ThatBool(
	actual := view.ResourceAcquiring,
	message := "ResourceAcquiring must be true for RESOURCE_ACQUIRING"
).IsTrue();
Assert.ThatBool(actual := view.Processing, message := "Processing must be false for RESOURCE_ACQUIRING").IsFalse();
Assert.ThatBool(actual := view.Stopping, message := "Stopping must be false for RESOURCE_ACQUIRING").IsFalse();
Assert.ThatBool(
	actual := view.ResourceReleasing,
	message := "ResourceReleasing must be false for RESOURCE_ACQUIRING"
).IsFalse();

backingValue := TOF_Tasks.TASK_RUNNING_SUBSTATE.PROCESSING;
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_RUNNING_SUBSTATE.PROCESSING,
	message := "Value must track PROCESSING"
).IsTrue();
Assert.ThatBool(actual := view.Processing, message := "Processing must be true for PROCESSING").IsTrue();
Assert.ThatBool(
	actual := view.ResourceAcquiring,
	message := "ResourceAcquiring must be false for PROCESSING"
).IsFalse();
Assert.ThatBool(actual := view.Stopping, message := "Stopping must be false for PROCESSING").IsFalse();
Assert.ThatBool(
	actual := view.ResourceReleasing,
	message := "ResourceReleasing must be false for PROCESSING"
).IsFalse();

backingValue := TOF_Tasks.TASK_RUNNING_SUBSTATE.STOPPING;
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_RUNNING_SUBSTATE.STOPPING,
	message := "Value must track STOPPING"
).IsTrue();
Assert.ThatBool(actual := view.Stopping, message := "Stopping must be true for STOPPING").IsTrue();
Assert.ThatBool(actual := view.ResourceAcquiring, message := "ResourceAcquiring must be false for STOPPING").IsFalse();
Assert.ThatBool(actual := view.Processing, message := "Processing must be false for STOPPING").IsFalse();
Assert.ThatBool(actual := view.ResourceReleasing, message := "ResourceReleasing must be false for STOPPING").IsFalse();

backingValue := TOF_Tasks.TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING;
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_RUNNING_SUBSTATE.RESOURCE_RELEASING,
	message := "Value must track RESOURCE_RELEASING"
).IsTrue();
Assert.ThatBool(
	actual := view.ResourceReleasing,
	message := "ResourceReleasing must be true for RESOURCE_RELEASING"
).IsTrue();
Assert.ThatBool(
	actual := view.ResourceAcquiring,
	message := "ResourceAcquiring must be false for RESOURCE_RELEASING"
).IsFalse();
Assert.ThatBool(actual := view.Processing, message := "Processing must be false for RESOURCE_RELEASING").IsFalse();
Assert.ThatBool(actual := view.Stopping, message := "Stopping must be false for RESOURCE_RELEASING").IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{68dd60cf-9530-4ebe-9fd6-0006cfbbac96}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify the returned storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1ad23026-41c9-4847-889b-69382f0ce763}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2898056a-88f1-46bd-ae8c-8ec754dd4216}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{eae19a4f-d215-45bf-90fb-d9f4dcae1fb5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{19322ea2-a224-4969-9b65-7ff5fb39e3f2}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6d0d487d-5ddd-403f-9699-c53855dbf28f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
