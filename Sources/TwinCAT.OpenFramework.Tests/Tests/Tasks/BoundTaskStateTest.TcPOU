<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="BoundTaskStateTest" Id="{3ce47c65-ea74-40d2-9c1f-722cdcb02cee}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks that a bound TaskState view observes changes to its backing data.

Exercises all defined values through the same view in one call. The backing data and view are local to the call.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK BoundTaskStateTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{1b05751d-7620-4fd1-894a-f4b0aa56db33}">
      <Declaration><![CDATA[// Sets each backing value and checks the corresponding value and flags.
METHOD PROTECTED ExecuteTest
VAR
	backingValue : TOF_Tasks.TASK_STATE;
	stateChanged : BOOL;
	view : TOF_Tasks.TaskState(taskState := backingValue, taskStateChanged := stateChanged);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[backingValue := TOF_Tasks.TASK_STATE.READY;
stateChanged := FALSE;
Assert.ThatBool(actual := view.Value = TOF_Tasks.TASK_STATE.READY, message := "Value must track READY").IsTrue();
Assert.ThatBool(actual := view.Ready, message := "Ready must be true for READY").IsTrue();
Assert.ThatBool(actual := view.Running, message := "Running must be false for READY").IsFalse();
Assert.ThatBool(actual := view.Stopped, message := "Stopped must be false for READY").IsFalse();
Assert.ThatBool(actual := view.StateChanged, message := "StateChanged must track its backing flag in READY").IsFalse();

backingValue := TOF_Tasks.TASK_STATE.RUNNING;
stateChanged := TRUE;
Assert.ThatBool(actual := view.Value = TOF_Tasks.TASK_STATE.RUNNING, message := "Value must track RUNNING").IsTrue();
Assert.ThatBool(actual := view.Running, message := "Running must be true for RUNNING").IsTrue();
Assert.ThatBool(actual := view.Ready, message := "Ready must be false for RUNNING").IsFalse();
Assert.ThatBool(actual := view.Stopped, message := "Stopped must be false for RUNNING").IsFalse();
Assert.ThatBool(actual := view.StateChanged, message := "StateChanged must track its backing flag in RUNNING").IsTrue();

stateChanged := FALSE;
Assert.ThatBool(
	actual := view.StateChanged,
	message := "StateChanged must clear while the lifecycle state stays RUNNING"
).IsFalse();

backingValue := TOF_Tasks.TASK_STATE.STOPPED;
stateChanged := FALSE;
Assert.ThatBool(actual := view.Value = TOF_Tasks.TASK_STATE.STOPPED, message := "Value must track STOPPED").IsTrue();
Assert.ThatBool(actual := view.Stopped, message := "Stopped must be true for STOPPED").IsTrue();
Assert.ThatBool(actual := view.Ready, message := "Ready must be false for STOPPED").IsFalse();
Assert.ThatBool(actual := view.Running, message := "Running must be false for STOPPED").IsFalse();
Assert.ThatBool(
	actual := view.StateChanged,
	message := "StateChanged must track its backing flag in STOPPED"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{93cfbe1c-9f61-4bc7-9be5-133ff4a0a9f1}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{62ead355-0876-4a88-a643-50fa03d416c9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{40914872-d1ce-409d-8641-2de88bb3293f}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8fcc0667-e6ee-4317-932f-e3f005a6b384}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{61e5f287-e220-4297-8f20-5d26a99afd2e}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d56dedc0-3182-467e-8f15-a055f7642ec9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
