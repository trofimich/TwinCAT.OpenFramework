(*
Checks that a bound TaskStopReason view observes changes to its backing data.

Exercises all defined values through the same view in one call. The backing data and view are local to the call.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK BoundTaskStopReasonTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{897548ec-ee71-4a70-9d13-c78c1267fc80}">
      <Declaration><![CDATA[// Sets each backing value and checks the corresponding value and flags.
METHOD PROTECTED ExecuteTest
VAR
	backingValue : TOF_Tasks.TASK_STOP_REASON;
	stopMessage : TOF_Core.ERROR_MESSAGE;
	view : TOF_Tasks.TaskStopReason(stopReason := backingValue, stopReasonMessage := stopMessage);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[backingValue := TOF_Tasks.TASK_STOP_REASON.WORK_DONE;
stopMessage := "initial message";
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_STOP_REASON.WORK_DONE,
	message := "Value must track WORK_DONE"
).IsTrue();
Assert.ThatBool(actual := view.WorkDone, message := "WorkDone must be true for WORK_DONE").IsTrue();
Assert.ThatBool(actual := view.Failure, message := "Failure must be false for WORK_DONE").IsFalse();
Assert.ThatBool(actual := view.ExternalCancel, message := "ExternalCancel must be false for WORK_DONE").IsFalse();
Assert.ThatBool(actual := view.InternalAbort, message := "InternalAbort must be false for WORK_DONE").IsFalse();
Assert.ThatBool(actual := __ISVALIDREF(view.Message), message := "Message must be bound for WORK_DONE").IsTrue();

IF __ISVALIDREF(view.Message) THEN
	Assert.ThatBool(
		actual := view.Message = "initial message",
		message := "Message must match the backing text for WORK_DONE"
	).IsTrue();
END_IF

backingValue := TOF_Tasks.TASK_STOP_REASON.FAILURE;
stopMessage := "diagnostic failure";
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_STOP_REASON.FAILURE,
	message := "Value must track FAILURE"
).IsTrue();
Assert.ThatBool(actual := view.Failure, message := "Failure must be true for FAILURE").IsTrue();
Assert.ThatBool(actual := view.WorkDone, message := "WorkDone must be false for FAILURE").IsFalse();
Assert.ThatBool(actual := view.ExternalCancel, message := "ExternalCancel must be false for FAILURE").IsFalse();
Assert.ThatBool(actual := view.InternalAbort, message := "InternalAbort must be false for FAILURE").IsFalse();
Assert.ThatBool(actual := __ISVALIDREF(view.Message), message := "Message must be bound for FAILURE").IsTrue();

IF __ISVALIDREF(view.Message) THEN
	Assert.ThatBool(
		actual := view.Message = "diagnostic failure",
		message := "Message must match the backing text for FAILURE"
	).IsTrue();
END_IF

backingValue := TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL;
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL,
	message := "Value must track EXTERNAL_CANCEL"
).IsTrue();
Assert.ThatBool(actual := view.ExternalCancel, message := "ExternalCancel must be true for EXTERNAL_CANCEL").IsTrue();
Assert.ThatBool(actual := view.WorkDone, message := "WorkDone must be false for EXTERNAL_CANCEL").IsFalse();
Assert.ThatBool(actual := view.Failure, message := "Failure must be false for EXTERNAL_CANCEL").IsFalse();
Assert.ThatBool(actual := view.InternalAbort, message := "InternalAbort must be false for EXTERNAL_CANCEL").IsFalse();

backingValue := TOF_Tasks.TASK_STOP_REASON.INTERNAL_ABORT;
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_STOP_REASON.INTERNAL_ABORT,
	message := "Value must track INTERNAL_ABORT"
).IsTrue();
Assert.ThatBool(actual := view.InternalAbort, message := "InternalAbort must be true for INTERNAL_ABORT").IsTrue();
Assert.ThatBool(actual := view.WorkDone, message := "WorkDone must be false for INTERNAL_ABORT").IsFalse();
Assert.ThatBool(actual := view.Failure, message := "Failure must be false for INTERNAL_ABORT").IsFalse();
Assert.ThatBool(actual := view.ExternalCancel, message := "ExternalCancel must be false for INTERNAL_ABORT").IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{8be397be-f8fe-4a75-bc7b-d47761f49846}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f8a9d59c-90ee-4fe7-9d6b-be4446a69845}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{546fe4b3-b7bf-453d-8171-10a2ae552453}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e2c745ee-ebdc-4fec-aa60-2fa910c2fbda}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5fb8c2c9-d014-4f3e-a806-fb10cd9a62a0}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8373f6e7-73c7-452b-9eb6-d756b90d7385}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
