(*!
<summary>Checks safe defaults for an unbound TaskStopReason view.</summary>
<description>
Uses unbound local references and checks every observable property without dereferencing a missing target.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK UnboundTaskStopReasonTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{6fb1005b-918a-4ada-b946-8e01fe8f38f5}">
      <Declaration><![CDATA[//! <summary>Reads all flags and verifies the default value for an unbound view.</summary>
METHOD PROTECTED ExecuteTest
VAR
	backingValue : REFERENCE TO TOF_Tasks.TASK_STOP_REASON;
	stopMessage : REFERENCE TO TOF_Core.ERROR_MESSAGE;
	view : TOF_Tasks.TaskStopReason(stopReason := backingValue, stopReasonMessage := stopMessage);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(actual := view.WorkDone, message := "Unbound TaskStopReason.WorkDone must be false").IsFalse();
Assert.ThatBool(actual := view.Failure, message := "Unbound TaskStopReason.Failure must be false").IsFalse();
Assert.ThatBool(
	actual := view.ExternalCancel,
	message := "Unbound TaskStopReason.ExternalCancel must be false"
).IsFalse();
Assert.ThatBool(
	actual := view.InternalAbort,
	message := "Unbound TaskStopReason.InternalAbort must be false"
).IsFalse();
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_STOP_REASON.WORK_DONE,
	message := "Unbound Value must default to WORK_DONE"
).IsTrue();
Assert.ThatBool(
	actual := __ISVALIDREF(view.Message),
	message := "Unbound stop message reference must be invalid"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{2b7fa0bb-4259-42af-b208-479cbf5967f4}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify the returned storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cc7f95a7-3c0d-4042-8c17-b4a139dd0bda}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{dc65ce8d-fe00-4836-a4dc-ca53802a7630}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8680b6f9-87fc-492c-8b6e-604f9ac1e41d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{193fbca8-98f1-4812-907c-2f00b7deb3dc}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b3efdbce-055b-4a0f-a6a3-6b0b77cf4601}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
