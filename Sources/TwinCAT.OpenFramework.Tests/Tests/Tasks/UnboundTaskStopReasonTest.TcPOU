<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="UnboundTaskStopReasonTest" Id="{6ace9ff4-2237-49ef-9230-c6f65ef83ce9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
