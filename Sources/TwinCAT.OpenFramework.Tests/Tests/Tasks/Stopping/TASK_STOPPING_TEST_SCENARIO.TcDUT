(*!
<summary>Selects the injection and expected behavior of a task stopping case.</summary>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
TYPE TASK_STOPPING_TEST_SCENARIO :
(
	//! <summary>Completes work and waits for both stopping and release.</summary>
	WORK_DONE,
	//! <summary>Retains the ERROR result and diagnostic after cleanup.</summary>
	WORK_ERROR,
	//! <summary>Retains the ABORTED result and diagnostic after cleanup.</summary>
	WORK_ABORT,
	//! <summary>Defers stopping after a processing exception.</summary>
	WORK_EXCEPTION,
	//! <summary>Uses a named fallback when the processing exception formatter throws.</summary>
	WORK_FORMATTER_EXCEPTION,
	//! <summary>Retries the interrupted stopping hook and preserves the preceding work exception.</summary>
	FIRST_STOPPING_EXCEPTION,
	//! <summary>Interrupts three stopping calls before allowing progress.</summary>
	REPEATED_STOPPING_EXCEPTIONS,
	//! <summary>Produces a named fallback for empty exception text without a bound resource.</summary>
	EMPTY_WORK_EXCEPTION_MESSAGE,
	//! <summary>Cancels a pending acquisition and releases the late acquired resource.</summary>
	CANCEL_DURING_ACQUIRE,
	//! <summary>Cancels before the first Execute and never acquires.</summary>
	CANCEL_BEFORE_ACQUIRE,
	//! <summary>Releases a resource acquired immediately before an exception.</summary>
	ACQUIRE_EXCEPTION_AFTER_OWNERSHIP,
	//! <summary>Stops without release after acquisition is refused.</summary>
	ACQUIRE_EXCEPTION_BEFORE_OWNERSHIP,
	//! <summary>Preserves successful work as the original result when release fails.</summary>
	RELEASE_EXCEPTION,
	//! <summary>Resets from OnAfterStop without reentering work.</summary>
	RESET_IN_NOTIFICATION,
	//! <summary>Refuses Reset with fallback diagnostics and allows a retry.</summary>
	RESET_FORMATTER_EXCEPTION,
	//! <summary>Refuses Start with fallback diagnostics and allows a retry.</summary>
	START_FORMATTER_EXCEPTION
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
