(* Selects the injection and expected behavior of a task stopping case. *)

{attribute 'qualified_only'}
{attribute 'strict'}
TYPE TASK_STOPPING_TEST_SCENARIO :
(
	// Completes work and waits for both stopping and release.
	WORK_DONE,
	// Retains the ERROR result and diagnostic after cleanup.
	WORK_ERROR,
	// Retains the ABORTED result and diagnostic after cleanup.
	WORK_ABORT,
	// Defers stopping after a processing exception.
	WORK_EXCEPTION,
	// Uses a named fallback when the processing exception formatter throws.
	WORK_FORMATTER_EXCEPTION,
	// Retries the interrupted stopping hook and preserves the preceding work exception.
	FIRST_STOPPING_EXCEPTION,
	// Interrupts three stopping calls before allowing progress.
	REPEATED_STOPPING_EXCEPTIONS,
	// Produces a named fallback for empty exception text without a bound resource.
	EMPTY_WORK_EXCEPTION_MESSAGE,
	// Cancels a pending acquisition and releases the late acquired resource.
	CANCEL_DURING_ACQUIRE,
	// Cancels before the first Execute and never acquires.
	CANCEL_BEFORE_ACQUIRE,
	// Releases a resource acquired immediately before an exception.
	ACQUIRE_EXCEPTION_AFTER_OWNERSHIP,
	// Stops without release after acquisition is refused.
	ACQUIRE_EXCEPTION_BEFORE_OWNERSHIP,
	// Preserves successful work as the original result when release fails.
	RELEASE_EXCEPTION,
	// Resets from OnAfterStop without reentering work.
	RESET_IN_NOTIFICATION,
	// Refuses Reset with fallback diagnostics and allows a retry.
	RESET_FORMATTER_EXCEPTION,
	// Refuses Start with fallback diagnostics and allows a retry.
	START_FORMATTER_EXCEPTION
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
