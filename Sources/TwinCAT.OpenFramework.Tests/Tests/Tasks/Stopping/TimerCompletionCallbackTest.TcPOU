<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerCompletionCallbackTest" Id="{9c80ffbb-735b-4a83-96b7-985e778a39e4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks the documented completion observation when OnAfterStop resets the timer.

The case executes in one PLC callback with a persistent restart probe and no external resources.
OnAfterTest prepares the fixture for reuse by the runner.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerCompletionCallbackTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Timer : TimerRestartProbe(name := "Callback reset");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{6aeec917-ee8e-4389-9643-6409fa239964}">
      <Declaration><![CDATA[(* Checks the documented completion observation when OnAfterStop resets the timer. *)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.ResetOnAfterStop := TRUE;
_Timer.Interval := TOF_Core.Times.MIN_VALUE;

IF NOT _Timer.Start() THEN
	RecordFailure(message := "Callback probe must accept Start");
	RETURN;
END_IF

Assert.ThatBool(
	actual := _Timer.State.Running,
	message := "Probe must be RUNNING before the completion callback"
).IsTrue();
_Timer.Execute();
Assert.ThatBool(actual := _Timer.State.Ready, message := "Supported callback Reset must restore READY").IsTrue();
Assert.ThatBool(
	actual := _Timer.Triggered,
	message := "Callback Reset may clear the pulse before Execute returns"
).IsFalse();
Assert.ThatBool(actual := _Timer.Elapsed, message := "Callback Reset must clear retained Q").IsFalse();
Assert.ThatBool(
	actual := _Timer.ElapsedTime = TOF_Core.Times.MIN_VALUE,
	message := "Callback Reset must clear ET"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{6b427096-29c4-4f16-bce6-84f0a6e642c7}">
      <Declaration><![CDATA[(*
Returns the owned timer to READY before reporting the result.

Reopens the stopping gate and disables callback injections before cooperative cleanup.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.AllowStopping := TRUE;
_Timer.ThrowOnBeforeStart := FALSE;
_Timer.ThrowOnReset := FALSE;
_Timer.ResetOnAfterStop := FALSE;

Assert.ThatBool(
	actual := PrepareTimerTestForReuse(timer := _Timer),
	message := "The timer must return to READY after cleanup"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{982ecb15-2358-495a-8ba2-3d4524b8d938}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{54df6790-bdd6-4349-ab5f-887f345ce92b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{37040404-5e77-4cf3-89ad-75717c971896}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{db372d89-dae0-4cce-a1c0-3a17abca6a57}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{046c86af-bd45-41b0-9906-6807885678f9}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c41434d4-6ee2-409c-b3ca-b95b79ca204e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
