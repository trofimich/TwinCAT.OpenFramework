<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerCompletionPulseTest" Id="{537d67bf-55ba-428b-8cc7-4806375f8ab1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks repeated timer completion, immediate restart and pulse clearing.</summary>
<description>
The zero preset must finish on its first Execute. For a positive preset, compares completion against the
independent task timestamp, the actual observation gap and a millisecond of preset precision. Time must
advance normally. One task owns the persistent timer and AfterTest prepares it for another run.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerCompletionPulseTest EXTENDS TOF_Testing.MultiCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	//! <summary>Task clock counts 100 ns per tick.</summary>
	_TaskTimeTicksPerMillisecond : ULINT := 10000;
	//! <summary>Accounts for the millisecond precision of the TIME preset.</summary>
	_TimingToleranceTicks : ULINT := 10000;
	//! <summary>Multiple runs expose stale TON observations and restart state.</summary>
	_RunCount : UINT := 3;
END_VAR
VAR
	_Timer : TOF_Timers.Timer(name := "Completion pulse timer");
	_Interval : TIME;
	_CompletedRuns : UINT;
	_StartedAt : ULINT;
	_LastObservedAt : ULINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{41695c3c-67f6-48c2-abf8-8967a4a0b419}">
      <Declaration><![CDATA[(*!
<summary>Selects the case configuration and its ten-second nominal deadline.</summary>
<param name="name">Display name of this case.</param>
<param name="parent">Group that owns this test.</param>
<param name="interval">Zero or positive preset under test.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	interval : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Interval := interval;
_Timeout := T#10S;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeforeTest" Id="{e7817ea8-a8bf-4bdc-8e20-467d9c5920fb}">
      <Declaration><![CDATA[(*!
<summary>Configures the timer and records the independent start timestamp.</summary>
*)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CompletedRuns := 0;
_Timer.Interval := _Interval;
_StartedAt := Tc2_System.F_GetTaskTime();
_LastObservedAt := _StartedAt;

IF NOT _Timer.Start() THEN
	RecordFailure(message := "Prepared timer must accept Start");
	RETURN;
END_IF

Assert.ThatBool(
	actual := _Timer.Triggered,
	message := "Start must leave the completion pulse clear"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{263392e7-fc15-4fba-862f-b4695232a114}">
      <Declaration><![CDATA[(*!
<summary>Advances one timer call per cycle and restarts in the cycle that observes completion.</summary>
*)
METHOD PROTECTED ExecuteTest : TOF_Testing.TEST_CYCLE_RESULT
VAR
	elapsed : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ExecuteTest := TOF_Testing.TEST_CYCLE_RESULT.DONE;
_Timer.Execute();

IF _CompletedRuns = _RunCount THEN
	Assert.ThatBool(
		actual := _Timer.Triggered,
		message := "The next Execute must clear the completion pulse"
	).IsFalse();
	Assert.ThatBool(
		actual := _Timer.Elapsed,
		message := "Idle Execute must preserve elapsed until Reset"
	).IsTrue();
	Assert.ThatBool(actual := _Timer.State.Stopped, message := "Idle Execute must preserve STOPPED").IsTrue();

	RETURN;
END_IF

elapsed := _Timer.Elapsed;

IF _Interval = TOF_Core.Times.MIN_VALUE THEN
	Assert.ThatBool(actual := elapsed, message := "Zero interval must set TON.Q on its first Execute").IsTrue();
ELSE
	checkPositiveTiming(triggered := _Timer.Triggered);
END_IF

Assert.ThatBool(
	actual := _Timer.Triggered,
	message := "Triggered must match the newly observed TON.Q in the same Execute"
).ToBe(expected := elapsed);

IF Outcome = TOF_Testing.TEST_OUTCOME.FAILED THEN
	RETURN;
END_IF

IF _Timer.Triggered THEN
	Assert.ThatBool(
		actual := _Timer.Triggered,
		message := "Repeated getter reads must preserve the completion pulse"
	).IsTrue();
	Assert.ThatBool(
		actual := _Timer.State.Stopped,
		message := "Timer must already be STOPPED on completion"
	).IsTrue();
	Assert.ThatBool(
		actual := _Timer.FinalStopReason.WorkDone,
		message := "Natural timer completion must report WORK_DONE"
	).IsTrue();
	Assert.ThatBool(
		actual := _Timer.ElapsedTime = _Interval,
		message := "Completed elapsed time must equal the preset"
	).IsTrue();

	_CompletedRuns := _CompletedRuns + 1;

	IF _CompletedRuns < _RunCount THEN
		_StartedAt := Tc2_System.F_GetTaskTime();
		_LastObservedAt := _StartedAt;

		IF NOT _Timer.Restart() THEN
			RecordFailure(message := "Restart must succeed in the completion cycle");
			RETURN;
		END_IF

		Assert.ThatBool(
			actual := _Timer.State.Running,
			message := "Restart must begin a new run immediately"
		).IsTrue();
		Assert.ThatBool(actual := _Timer.Elapsed, message := "Restart must reset the old TON.Q").IsFalse();
		Assert.ThatBool(actual := _Timer.Triggered, message := "Restart must clear the consumed pulse").IsFalse();
	END_IF
ELSE
	Assert.ThatBool(actual := _Timer.State.Running, message := "An incomplete timer must remain RUNNING").IsTrue();
END_IF

ExecuteTest := TOF_Testing.TEST_CYCLE_RESULT.BUSY;]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkPositiveTiming" Id="{c5143184-8259-411b-bb5f-7f9c87e6a67d}">
      <Declaration><![CDATA[(*!
<summary>Compares a positive completion with independent task time.</summary>
<description>
Accepts the elapsed time at the first eligible observation within the time quantization allowance.
</description>
<param name="triggered">Completion pulse observed after the current Execute.</param>
*)
METHOD PRIVATE checkPositiveTiming
VAR_INPUT
	triggered : BOOL;
END_VAR
VAR
	currentTaskTime : ULINT;
	elapsedTicks : ULINT;
	observationGap : ULINT;
	presetTicks : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[currentTaskTime := Tc2_System.F_GetTaskTime();

IF currentTaskTime < _LastObservedAt THEN
	RecordFailure(message := "Independent task time moved backwards");
	RETURN;
END_IF

elapsedTicks := currentTaskTime - _StartedAt;
observationGap := currentTaskTime - _LastObservedAt;
_LastObservedAt := currentTaskTime;
presetTicks := TO_ULINT(_Interval) * _TaskTimeTicksPerMillisecond;

IF triggered THEN
	Assert.ThatBool(
		actual := elapsedTicks + _TimingToleranceTicks >= presetTicks,
		message := "Positive timer must not complete ahead of the preset"
	).IsTrue();
	Assert.ThatBool(
		actual := elapsedTicks <= presetTicks + observationGap + _TimingToleranceTicks,
		message := "Completion must occur at the first eligible observation"
	).IsTrue();
ELSE
	Assert.ThatBool(
		actual := elapsedTicks <= presetTicks + _TimingToleranceTicks,
		message := "The timer must trigger at the first observation past its preset"
	).IsTrue();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{b18a9049-2948-4f2e-aff9-3cde2afb4182}">
      <Declaration><![CDATA[(*!
<summary>Returns the owned timer to READY before reporting the result.</summary>
<description>
Cooperatively cancels active work and clears any retained TON observations through Reset.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(
	actual := PrepareTimerTestForReuse(timer := _Timer),
	message := "The timer must return to READY after cleanup"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{af830416-bce4-4ef9-927f-1158dd25e8d7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{45a601d7-f368-4098-9398-250ef34f6636}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{9f16b282-a50f-4412-b6d3-add511103048}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{73a0150a-bcbe-4d6c-abb8-93f8816f5614}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{2905fa97-1447-4382-a76b-18122e9945dd}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b000ec2e-c9e3-4f90-b49f-348d70f8166e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
