<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerRestartStartFailureTest" Id="{071ea9cf-9816-4eb6-bcb2-055b98bd213f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks the configured new interval after late start-preparation refusal.

The case executes in one PLC callback with a persistent restart probe and no external resources.
OnAfterTest prepares the fixture for reuse by the runner.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerRestartStartFailureTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	// Positive interval selected for the replacement run.
	_PositiveInterval : TIME := T#30MS;
END_VAR
VAR
	_Timer : TimerRestartProbe(name := "Start refusal");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{275c69cd-cdc0-4dd3-b766-3a22e55f88f3}">
      <Declaration><![CDATA[(* Checks the configured new interval after late start-preparation refusal. *)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.Interval := TOF_Core.Times.MIN_VALUE;
_Timer.ThrowOnBeforeStart := TRUE;
Assert.ThatBool(
	actual := _Timer.SetIntervalAndRestart(interval := _PositiveInterval),
	message := "Start preparation exception must be converted to restart refusal"
).IsFalse();
Assert.ThatBool(
	actual := _Timer.State.Ready,
	message := "Refused Start must leave the prepared timer READY"
).IsTrue();
Assert.ThatBool(
	actual := _Timer.Interval = _PositiveInterval,
	message := "Late Start refusal must retain the new PT"
).IsTrue();
Assert.ThatBool(
	actual := _Timer.Elapsed,
	message := "Injected refusal before base Start must leave Q clear"
).IsFalse();
_Timer.Execute();
Assert.ThatBool(
	actual := _Timer.State.Ready,
	message := "Refused restart must not schedule automatic execution"
).IsTrue();
_Timer.ThrowOnBeforeStart := FALSE;

IF NOT _Timer.Start() THEN
	RecordFailure(message := "Explicit Start must recover after removing injection");
	RETURN;
END_IF

IF NOT _Timer.Cancel() THEN
	RecordFailure(message := "Scenario must cancel the recovered run");
	RETURN;
END_IF

_Timer.Execute();
Assert.ThatBool(
	actual := _Timer.State.Stopped AND_THEN _Timer.FinalStopReason.ExternalCancel,
	message := "The replacement run must finish cancellation"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{51c7d455-2c88-47a0-a8c7-b24bb0aa3b16}">
      <Declaration><![CDATA[(*
Returns the owned timer to READY before reporting the result.

Reopens the stopping gate and disables callback injections before cooperative cleanup.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.AllowStopping := TRUE;
_Timer.ThrowOnBeforeStart := FALSE;
_Timer.ThrowOnReset := FALSE;
_Timer.ResetOnAfterStop := FALSE;

Assert.ThatBool(
	actual := PrepareTimerTestForReuse(timer := _Timer),
	message := "The timer must return to READY after cleanup"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{234cc419-1cac-43c4-aa6b-399e2540c426}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{48568fa1-9c3a-4fe6-9ff4-a31453b23343}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{8bd275dc-2c57-40d9-ad23-4db742bcd62d}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{545a43c2-b6cc-4a2e-98d4-782cdfe516f4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{11587047-1490-464b-9858-664106eeabd7}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{5b9dca2f-a4d5-4a0c-ae3e-5cfb5c1c0c27}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
