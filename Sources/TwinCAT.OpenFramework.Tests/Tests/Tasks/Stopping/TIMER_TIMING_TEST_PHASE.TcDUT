(*!
<summary>Identifies phases of timer scenarios that intentionally skip Execute calls.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE TIMER_TIMING_TEST_PHASE :
(
	//! <summary>Configure and start the owned timer once.</summary>
	BEFORE_START,
	//! <summary>Observe independent task time while withholding timer execution.</summary>
	WAITING_FOR_FIRST_EXECUTE,
	//! <summary>Scenario has reported its result and must not execute again.</summary>
	FINISHED
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
