<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerResetAfterCompletionTest" Id="{2bc108dd-6bc2-4d3f-a731-d0348b4dc967}" SpecialFunc="None">
    <Declaration><![CDATA[(*
