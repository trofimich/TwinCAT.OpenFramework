(*!
<summary>Checks repeated Execute and explicit Reset after natural completion.</summary>
<description>
The case executes in one PLC callback with a persistent timer and no external resources.
AfterTest prepares the fixture for reuse by the runner.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerResetAfterCompletionTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Timer : TOF_Timers.Timer(name := "Completed timer");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{8b6c463c-4ce4-43e2-bd29-df1dc7ea21fa}">
      <Declaration><![CDATA[(*!
<summary>Checks repeated Execute and explicit Reset after natural completion.</summary>
*)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.Interval := TOF_Core.Times.MIN_VALUE;

IF NOT _Timer.Start() THEN
	RecordFailure(message := "Zero timer must accept Start");
	RETURN;
END_IF

_Timer.Execute();
Assert.ThatBool(actual := _Timer.Triggered, message := "First Execute must expose completion").IsTrue();
Assert.ThatBool(actual := _Timer.Start(), message := "Start must refuse STOPPED without Reset").IsFalse();
Assert.ThatBool(actual := _Timer.Cancel(), message := "Cancel must refuse an already completed timer").IsFalse();
_Timer.Execute();
Assert.ThatBool(
	actual := _Timer.Triggered,
	message := "A second Execute in the same cycle must clear the pulse"
).IsFalse();
Assert.ThatBool(actual := _Timer.Elapsed, message := "Idle Execute must preserve retained elapsed").IsTrue();
Assert.ThatBool(
	actual := _Timer.FinalStopReason.WorkDone,
	message := "Idle Execute must preserve the result"
).IsTrue();

IF NOT _Timer.Reset() THEN
	RecordFailure(message := "Completed timer must accept Reset");
	RETURN;
END_IF

Assert.ThatBool(actual := _Timer.State.Ready, message := "Successful Reset must restore READY").IsTrue();
Assert.ThatBool(actual := _Timer.Elapsed, message := "Reset must clear retained elapsed").IsFalse();
Assert.ThatBool(actual := _Timer.Triggered, message := "Reset must clear the completion pulse").IsFalse();
Assert.ThatBool(
	actual := _Timer.ElapsedTime = TOF_Core.Times.MIN_VALUE,
	message := "Reset must clear ET"
).IsTrue();

IF NOT _Timer.Restart() THEN
	RecordFailure(message := "Restart must also work from READY");
	RETURN;
END_IF

_Timer.Execute();
Assert.ThatBool(
	actual := _Timer.Triggered,
	message := "Restart after explicit Reset must yield a fresh completion"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{f5956134-a3f1-4d26-b121-16277fa64e37}">
      <Declaration><![CDATA[(*!
<summary>Returns the owned timer to READY before reporting the result.</summary>
<description>
Cooperatively cancels active work and clears any retained TON observations through Reset.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(
	actual := PrepareTimerTestForReuse(timer := _Timer),
	message := "The timer must return to READY after cleanup"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{32019907-8be0-4b5d-a064-68e3f10a88cf}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2efa179b-2b09-41a5-b275-e2a9eb606eb7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{559e6908-71be-4c97-9fcd-780dcd04b20c}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c882ae14-c1c5-4b3f-95b4-dd6771eb8f6d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9b5dc881-37d5-419d-a2d8-4b85911e2cee}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e3b4bcc1-ba5a-4f7a-80f3-4f11f1e113f7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
