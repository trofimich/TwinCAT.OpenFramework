<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerTimingTestGroup" Id="{2d83cb3b-db5c-454f-b332-d9149d0e7435}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups timer timing, lifecycle and restart scenarios.

Owns the test cases and their fixed child array. Use from a single PLC task and keep the group at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerTimingTestGroup EXTENDS TOF_Testing.TestGroup<13>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_PositiveIntervalSameCallRestart : TimerCompletionPulseTest(
		name := "PositiveIntervalSameCallRestart",
		parent := THIS^,
		interval := T#30MS
	);
	_ZeroIntervalSameCallRestart : TimerCompletionPulseTest(
		name := "ZeroIntervalSameCallRestart",
		parent := THIS^,
		interval := TOF_Core.Times.MIN_VALUE
	);
	_DefaultNameAndMetadata : TimerMetadataTest(
		name := "DefaultNameAndMetadata",
		parent := THIS^
	);
	_CancelBeforeFirstExecuteAndReuse : TimerCancelBeforeExecuteTest(
		name := "CancelBeforeFirstExecuteAndReuse",
		parent := THIS^
	);
	_ResetAfterCompletion : TimerResetAfterCompletionTest(
		name := "ResetAfterCompletion",
		parent := THIS^
	);
	_IntervalAssignmentPreservesObservation : TimerIntervalObservationTest(
		name := "IntervalAssignmentPreservesObservation",
		parent := THIS^
	);
	_RestartWaitsForStopping : TimerPendingRestartTest(
		name := "RestartWaitsForStopping",
		parent := THIS^
	);
	_RestartPreservesIntervalOnResetFailure : TimerRestartResetFailureTest(
		name := "RestartPreservesIntervalOnResetFailure",
		parent := THIS^
	);
	_RestartRetainsIntervalOnStartFailure : TimerRestartStartFailureTest(
		name := "RestartRetainsIntervalOnStartFailure",
		parent := THIS^
	);
	_CompletionCallbackCanReset : TimerCompletionCallbackTest(
		name := "CompletionCallbackCanReset",
		parent := THIS^
	);
	_DelayedFirstExecuteUsesStartAnchor : DelayedTimerObservationTest(
		name := "DelayedFirstExecuteUsesStartAnchor",
		parent := THIS^,
		scenario := DELAYED_TIMER_TEST_SCENARIO.AFTER_START
	);
	_CancelAfterUnobservedExpiry : DelayedTimerObservationTest(
		name := "CancelAfterUnobservedExpiry",
		parent := THIS^,
		scenario := DELAYED_TIMER_TEST_SCENARIO.CANCEL_BEFORE_EXECUTE
	);
	_PositiveRestartUsesStartAnchor : DelayedTimerObservationTest(
		name := "PositiveRestartUsesStartAnchor",
		parent := THIS^,
		scenario := DELAYED_TIMER_TEST_SCENARIO.AFTER_ACTIVE_RESTART
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_PositiveIntervalSameCallRestart,
		_ZeroIntervalSameCallRestart,
		_DefaultNameAndMetadata,
		_CancelBeforeFirstExecuteAndReuse,
		_ResetAfterCompletion,
		_IntervalAssignmentPreservesObservation,
		_RestartWaitsForStopping,
		_RestartPreservesIntervalOnResetFailure,
		_RestartRetainsIntervalOnStartFailure,
		_CompletionCallbackCanReset,
		_DelayedFirstExecuteUsesStartAnchor,
		_CancelAfterUnobservedExpiry,
		_PositiveRestartUsesStartAnchor
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{6f4de77e-ca97-4535-8cfe-6e77de1377be}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{fe4bb99c-9245-4019-b253-80ec5ef187ae}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{ea83f2fe-8ee4-42ef-b386-9bbe7ba5f0b2}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5e7c2296-c41d-49ed-9f9d-301d1fc0e57e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1245437d-7444-4c03-af0c-8c68d493dc0d}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{461005d0-ec78-4783-ac77-83b7de983acd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7e712336-255f-40fc-803c-44d0976e682f}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0d50a699-6150-4633-b203-d62d0c40109b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
