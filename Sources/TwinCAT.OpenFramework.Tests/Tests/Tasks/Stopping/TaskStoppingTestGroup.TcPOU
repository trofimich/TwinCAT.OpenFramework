(*!
<summary>Groups the cooperative stopping, failure and task naming tests.</summary>
<description>
Owns independent fixtures and the fixed child array. Use from one PLC task and keep the group at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TaskStoppingTestGroup EXTENDS TOF_Testing.TestGroup<17>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_NameBeforeStartAndAfterReset : TaskStoppingNameTest(
		name := "NameBeforeStartAndAfterReset",
		parent := THIS^
	);
	_SuccessWaitsForCleanup : TaskStoppingScenarioTest(
		name := "SuccessWaitsForCleanup",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.WORK_DONE
	);
	_ErrorWaitsForCleanup : TaskStoppingScenarioTest(
		name := "ErrorWaitsForCleanup",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.WORK_ERROR
	);
	_AbortWaitsForCleanup : TaskStoppingScenarioTest(
		name := "AbortWaitsForCleanup",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.WORK_ABORT
	);
	_ExceptionWaitsForCleanup : TaskStoppingScenarioTest(
		name := "ExceptionWaitsForCleanup",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.WORK_EXCEPTION
	);
	_FormattingFailureWaitsForCleanup : TaskStoppingScenarioTest(
		name := "FormattingFailureWaitsForCleanup",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.WORK_FORMATTER_EXCEPTION
	);
	_StoppingExceptionResumes : TaskStoppingScenarioTest(
		name := "StoppingExceptionResumes",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.FIRST_STOPPING_EXCEPTION
	);
	_RepeatedStoppingExceptions : TaskStoppingScenarioTest(
		name := "RepeatedStoppingExceptions",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.REPEATED_STOPPING_EXCEPTIONS
	);
	_EmptyExceptionMessageUsesFallback : TaskStoppingScenarioTest(
		name := "EmptyExceptionMessageUsesFallback",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.EMPTY_WORK_EXCEPTION_MESSAGE
	);
	_CancelDuringAcquire : TaskStoppingScenarioTest(
		name := "CancelDuringAcquire",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.CANCEL_DURING_ACQUIRE
	);
	_CancelBeforeAcquire : TaskStoppingScenarioTest(
		name := "CancelBeforeAcquire",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.CANCEL_BEFORE_ACQUIRE
	);
	_AcquireFailureWithResource : TaskStoppingScenarioTest(
		name := "AcquireFailureWithResource",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.ACQUIRE_EXCEPTION_AFTER_OWNERSHIP
	);
	_AcquireFailureWithoutResource : TaskStoppingScenarioTest(
		name := "AcquireFailureWithoutResource",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.ACQUIRE_EXCEPTION_BEFORE_OWNERSHIP
	);
	_ReleaseFailurePreservesOriginal : TaskStoppingScenarioTest(
		name := "ReleaseFailurePreservesOriginal",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.RELEASE_EXCEPTION
	);
	_ResetFromAfterStop : TaskStoppingScenarioTest(
		name := "ResetFromAfterStop",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.RESET_IN_NOTIFICATION
	);
	_ResetFormattingFailure : TaskStoppingScenarioTest(
		name := "ResetFormattingFailure",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.RESET_FORMATTER_EXCEPTION
	);
	_StartFormattingFailure : TaskStoppingScenarioTest(
		name := "StartFormattingFailure",
		parent := THIS^,
		scenario := TASK_STOPPING_TEST_SCENARIO.START_FORMATTER_EXCEPTION
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_NameBeforeStartAndAfterReset,
		_SuccessWaitsForCleanup,
		_ErrorWaitsForCleanup,
		_AbortWaitsForCleanup,
		_ExceptionWaitsForCleanup,
		_FormattingFailureWaitsForCleanup,
		_StoppingExceptionResumes,
		_RepeatedStoppingExceptions,
		_EmptyExceptionMessageUsesFallback,
		_CancelDuringAcquire,
		_CancelBeforeAcquire,
		_AcquireFailureWithResource,
		_AcquireFailureWithoutResource,
		_ReleaseFailurePreservesOriginal,
		_ResetFromAfterStop,
		_ResetFormattingFailure,
		_StartFormattingFailure
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{b4f06aed-f2da-4bb7-8520-09508e518b61}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{244b0b3b-146c-480c-a1f8-7c0f94df505a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{bac71472-f16a-4ae4-8fc3-5cf3d44fdd79}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9614f6be-05e6-44d1-b6ab-15921923f924}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{04471c29-7a05-47f8-b605-59e346797a2c}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{af1770e6-dc39-416a-86f7-571d7db9210c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7f2031c9-ff1d-47d9-b6d0-513efb26bf82}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{692dca4e-9c5d-4104-b2c9-e227f332bac9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
