<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskStoppingTestGroup" Id="{620c8ebe-439a-471b-87fd-dbdf136487bc}" SpecialFunc="None">
    <Declaration><![CDATA[(*
