<TcPlcObject Version="1.1.0.1">
  <DUT Name="DELAYED_TIMER_TEST_SCENARIO" Id="{f49a42df-8ee6-4ff9-a882-54c8b752cc82}">
    <Declaration><![CDATA[(*
