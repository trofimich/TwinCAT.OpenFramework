(* Selects the setup and outcome for a delayed timer observation. *)

{attribute 'qualified_only'}
{attribute 'strict'}
TYPE DELAYED_TIMER_TEST_SCENARIO :
(
	// Observe natural completion after delaying the first Execute.
	AFTER_START,
	// Request cancellation after the preset but before any Execute.
	CANCEL_BEFORE_EXECUTE,
	// Observe natural completion after restarting an active timer and delaying Execute.
	AFTER_ACTIVE_RESTART
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
