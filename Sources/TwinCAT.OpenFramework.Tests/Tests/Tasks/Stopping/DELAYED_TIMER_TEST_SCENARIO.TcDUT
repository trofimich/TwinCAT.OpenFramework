(*!
<summary>Selects the setup and outcome for a delayed timer observation.</summary>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
TYPE DELAYED_TIMER_TEST_SCENARIO :
(
	//! <summary>Observe natural completion after delaying the first Execute.</summary>
	AFTER_START,
	//! <summary>Request cancellation after the preset but before any Execute.</summary>
	CANCEL_BEFORE_EXECUTE,
	//! <summary>Observe natural completion after restarting an active timer and delaying Execute.</summary>
	AFTER_ACTIVE_RESTART
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
