<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PrepareTimerTestForReuse" Id="{70420110-f14b-4963-a524-ee30c0310994}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Returns a resource-free timer fixture to READY.

Call after disabling any injected callback failure or stopping hold. Advances pending cancellation once.
Returns FALSE if the fixture still needs work or refuses Reset. Owns no resource or exception state.

timer — Live timer fixture owned by the calling test.
*)
FUNCTION PrepareTimerTestForReuse : BOOL
VAR_INPUT
	timer : TOF_Tasks.ITask;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF timer.State.Running THEN
	IF NOT timer.OriginalStopReason.ExternalCancel THEN
		timer.Cancel();
	END_IF

	timer.Execute();
END_IF

IF timer.State.Stopped THEN
	IF NOT timer.Reset() THEN
		RETURN;
	END_IF
END_IF

PrepareTimerTestForReuse := timer.State.Ready;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
