<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerCancelBeforeExecuteTest" Id="{1927c169-1cec-4522-bc25-2c7f1a4483a4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks cancellation before the first Execute and reuse after reset.

The case executes in one PLC callback with a persistent timer and no external resources.
OnAfterTest prepares the fixture for reuse by the runner.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerCancelBeforeExecuteTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	// Keeps the old timer active until the scenario cancels or restarts it.
	_ActiveInterval : TIME := T#1H;
END_VAR
VAR
	_Timer : TOF_Timers.Timer(name := "Cancel timer");
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{1e3203cb-eb49-4b8e-b165-ad51d145acc8}">
      <Declaration><![CDATA[(* Checks cancellation before the first Execute and reuse after reset. *)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer.Interval := _ActiveInterval;

IF NOT _Timer.Start() THEN
	RecordFailure(message := "Long timer must accept Start");
	RETURN;
END_IF

Assert.ThatBool(actual := _Timer.Reset(), message := "Reset must refuse a running timer").IsFalse();

IF NOT _Timer.Cancel() THEN
	RecordFailure(message := "Cancellation must be accepted before the first Execute");
	RETURN;
END_IF

Assert.ThatBool(actual := _Timer.Cancel(), message := "Repeated cancellation must be refused").IsFalse();
_Timer.Execute();
Assert.ThatBool(
	actual := _Timer.State.Stopped,
	message := "Ordinary cancellation must finish in one Execute"
).IsTrue();
Assert.ThatBool(
	actual := _Timer.FinalStopReason.ExternalCancel,
	message := "Cancellation must remain the final reason"
).IsTrue();
Assert.ThatBool(
	actual := _Timer.Triggered,
	message := "Cancellation must not become successful completion"
).IsFalse();
Assert.ThatBool(actual := _Timer.Elapsed, message := "Cancelled long timer must not report elapsed").IsFalse();

IF NOT _Timer.Reset() THEN
	RecordFailure(message := "Cancelled timer must accept Reset");
	RETURN;
END_IF

Assert.ThatBool(
	actual := _Timer.ElapsedTime = TOF_Core.Times.MIN_VALUE,
	message := "Reset must clear elapsed time"
).IsTrue();
Assert.ThatBool(
	actual := _Timer.Interval = _ActiveInterval,
	message := "Reset must preserve the configured interval"
).IsTrue();

IF NOT _Timer.SetIntervalAndRestart(interval := TOF_Core.Times.MIN_VALUE) THEN
	RecordFailure(message := "Cancelled timer must support immediate reuse");
	RETURN;
END_IF

_Timer.Execute();
Assert.ThatBool(actual := _Timer.Triggered, message := "Reused timer must complete normally").IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{d0c98017-a1c4-4b81-b7c8-1fb3c416b282}">
      <Declaration><![CDATA[(*
Returns the owned timer to READY before reporting the result.

Cooperatively cancels active work and clears any retained TON observations through Reset.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(
	actual := PrepareTimerTestForReuse(timer := _Timer),
	message := "The timer must return to READY after cleanup"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{5615b637-2139-4662-9fca-bd6662fdebf5}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d157367c-a15c-49fb-82b1-d42412092328}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a0e496cb-23bb-4214-9cb9-1d1bd1d166f0}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{32da711a-342e-4b07-b6b1-d25961ba2262}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a566bad5-e785-4bbb-8ad2-e2d703c3fec5}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{be9670ff-7985-46a8-adc3-164854c5f2d7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
