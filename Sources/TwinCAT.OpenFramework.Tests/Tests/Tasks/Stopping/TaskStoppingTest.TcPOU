	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	resource.ThrowOnStartAcquire := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("Acquire failure", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(0, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
