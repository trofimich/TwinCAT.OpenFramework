(*!
<summary>Exercises unified Task stopping, resource ordering and diagnostic failures.</summary>
<description>
Each method owns an independent task and resource and advances a running task at most once per suite call.
No physical I/O, manual exception cleanup or terminal OOM injection is performed. A budget reports stalls;
it is a test limit, not permission for production code to abandon cleanup.
</description>
*)
FUNCTION_BLOCK TaskStoppingTest EXTENDS TcUnit.FB_TestSuite
VAR CONSTANT
	//! <summary>Maximum calls per scenario, including delayed acquisition, cleanup and release.</summary>
	_MaxScenarioCalls : UINT := 32;
	//! <summary>Cancel immediately after observing the first of three acquisition steps.</summary>
	_FirstAcquireStep : UINT := 1;
	//! <summary>Observe the first notification even when it resets the task to READY.</summary>
	_FirstFinalization : UINT := 1;
	//! <summary>Consecutive stopping exceptions before the repeated-failure scenario allows cleanup.</summary>
	_RepeatedStoppingFailures : UINT := 3;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[NameBeforeStartAndAfterReset();
SuccessWaitsForCleanup();
ErrorWaitsForCleanup();
AbortWaitsForCleanup();
ExceptionWaitsForCleanup();
FormattingFailureWaitsForCleanup();
StoppingExceptionResumes();
RepeatedStoppingExceptions();
EmptyExceptionMessageUsesFallback();
CancelDuringAcquire();
CancelBeforeAcquire();
AcquireFailureWithResource();
AcquireFailureWithoutResource();
ReleaseFailurePreservesOriginal();
ResetFromAfterStop();
ResetFormattingFailure();
StartFormattingFailure();]]></ST>
    </Implementation>
    <Method Name="SuccessWaitsForCleanup" Id="{85efb432-4182-4b04-8fe5-395b56ea098c}">
      <Declaration><![CDATA[(*!
<summary>Normal completion waits for stopping and asynchronous release.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD SuccessWaitsForCleanup
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);

	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ErrorWaitsForCleanup" Id="{040376f1-cf2b-4e77-a5e0-44073af62fa9}">
      <Declaration><![CDATA[(*!
<summary>An explicit ERROR result follows the same stopping path.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD ErrorWaitsForCleanup
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	task.ProcessingResult := TOF_Tasks.TASK_PROCESSING_STATE.ERROR;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("Work result", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AbortWaitsForCleanup" Id="{551c3310-6ba1-496b-8960-0baa5d9292b9}">
      <Declaration><![CDATA[(*!
