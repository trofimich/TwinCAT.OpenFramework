END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseFailurePreservesOriginal" Id="{4a107eff-15c4-47ff-a449-bdead5cca534}">
      <Declaration><![CDATA[(*!
<summary>A terminal release exception changes only the final result and is not retried.</summary>
<description>
Checks the complete phase-specific fallback including the public task Name; cleanup assertions remain independent.
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD ReleaseFailurePreservesOriginal
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	resource.ThrowOnStartRelease := TRUE;
	resource.ThrowOnGetMessage := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertEquals_WSTRING(TOF_Core.WideStrings.Concat255("Task '", task.Name, "' release failed"), task.FinalStopReason.Message, 'Release formatter failure must use fallback');
	AssertTrue(resource.ResourceAcquired, 'Terminal release failure does not prove deallocation');
	task.Execute();
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetFromAfterStop" Id="{ac5ff622-1713-48d5-861f-fd3b39a25af1}">
      <Declaration><![CDATA[(*!
<summary>Reset from final notification cannot cause more work in the same Execute.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD ResetFromAfterStop
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	task.ResetOnAfterStop := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.AfterStopCalls = _FirstFinalization THEN
	AssertTrue(task.State.Ready, 'OnAfterStop Reset must leave READY');
	AssertEquals_UINT(1, task.RunningCalls, 'Execute must not reenter work after notification Reset');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetFormattingFailure" Id="{c9cad4d6-40af-4cf5-9fe0-a7a92e42d3a9}">
      <Declaration><![CDATA[(*!
<summary>A throwing reset formatter returns refusal and leaves the stopped task available.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD ResetFormattingFailure
VAR
	exceptionEscaped : BOOL;
	refuseReason : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);

	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	task.ThrowOnReset := TRUE;
	task.ThrowOnGetMessage := TRUE;
	__TRY
		AssertFalse(task.Reset(refuseReason => refuseReason), 'Reset hook failure must refuse reset');
	__CATCH
		exceptionEscaped := TRUE;
	__ENDTRY
	AssertFalse(exceptionEscaped, 'Reset formatter failure must not escape');
	AssertTrue(task.State.Stopped, 'Refused reset must preserve STOPPED');
	AssertEquals_WSTRING("Task reset failed", refuseReason, 'Reset must use fixed fallback text');
	task.ThrowOnReset := FALSE;
	AssertTrue(task.Reset(), 'Reset must succeed after removing the injected refusal');
	AssertTrue(task.State.Ready, 'Successful reset must prepare reuse');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartFormattingFailure" Id="{8a15c26a-6ab4-4a49-9586-5175c7882d75}">
      <Declaration><![CDATA[(*!
<summary>Contains a formatter failure while refusing Start.</summary>
<description>
Runs once without I/O. Refusal leaves READY and performs no resource acquisition.
</description>
*)
METHOD StartFormattingFailure
VAR
	refuseReason : TOF_Core.ERROR_MESSAGE;
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());
task.SetResource(resource);
task.ThrowOnBeforeStart := TRUE;
task.ThrowOnGetMessage := TRUE;

__TRY
	AssertFalse(task.Start(refuseReason => refuseReason), 'Start hook failure must refuse start');
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

AssertFalse(exceptionEscaped, 'Start formatter failure must not escape');
AssertTrue(task.State.Ready, 'Refused start must leave READY');
AssertEquals_UINT(0, resource.AcquireCalls, 'Refused start must not acquire');
AssertEquals_WSTRING("Task start preparation failed", refuseReason, 'Start must use fixed fallback text');
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="NameBeforeStartAndAfterReset" Id="{f7ca49df-e82e-4d4c-833a-8975c6459a6f}">
      <Declaration><![CDATA[(*!
<summary>Checks deferred default names, explicit names and borrowed name storage across the lifecycle.</summary>
<description>
First reads an unnamed TaskStoppingProbe after construction and requires its concrete class prefix.
A second instance retains an explicitly supplied name. One Execute per suite call completes the unnamed
resource-free task; Reset must preserve its name and previously borrowed reference. No hardware is used.
</description>
*)
METHOD NameBeforeStartAndAfterReset
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("");
	namedTask : TaskStoppingProbe("Named stopping probe");
	initialName : WSTRING;
	borrowedName : REFERENCE TO WSTRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task name scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	borrowedName REF= task.Name;
	initialName := borrowedName;
	AssertEquals_WSTRING("TaskStoppingProbe", Tc2_Standard.WLEFT(initialName, Tc2_Standard.WLEN("TaskStoppingProbe")), 'Default name must include the initialized concrete class');
	AssertEquals_WSTRING("Named stopping probe", namedTask.Name, 'Explicit name must not be replaced by the default');
	AssertEquals_WSTRING(initialName, task.Name, 'Repeated reads must preserve the name');
	AssertTrue(task.State.Ready, 'Reading Name must not start the task');

	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Normal task execution must not throw');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

AssertEquals_WSTRING(initialName, task.Name, 'Lifecycle progress must preserve the name');
IF task.State.Stopped THEN
	AssertTrue(task.Reset(), 'Completed task must accept Reset');
	AssertEquals_WSTRING(initialName, task.Name, 'Name must remain complete after Reset');
	AssertEquals_WSTRING(initialName, borrowedName, 'Previously borrowed name must remain valid after Reset');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
