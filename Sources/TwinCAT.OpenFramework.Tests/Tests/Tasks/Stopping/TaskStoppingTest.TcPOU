END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExceptionWaitsForCleanup" Id="{fb9f1c0e-42a1-48d3-894a-7ba3f519a707}">
      <Declaration><![CDATA[(*!
<summary>A thrown work exception is retained through delayed stopping.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD ExceptionWaitsForCleanup
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	task.ThrowOnRunning := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("Work failure", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FormattingFailureWaitsForCleanup" Id="{c66d5161-6bd6-4c01-839d-b11a0d66f396}">
      <Declaration><![CDATA[(*!
<summary>A throwing formatter cannot skip stopping or release.</summary>
<description>
Checks the complete phase-specific fallback including the public task Name; cleanup assertions remain independent.
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD FormattingFailureWaitsForCleanup
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	task.ThrowOnRunning := TRUE;
	task.ThrowOnGetMessage := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING(TOF_Core.WideStrings.Concat255("Task '", task.Name, "' processing failed"), task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StoppingExceptionResumes" Id="{6b92843f-956b-4dcc-85a6-03cee86e99a8}">
      <Declaration><![CDATA[(*!
<summary>An interrupted stopping hook resumes and preserves the work result.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD StoppingExceptionResumes
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	task.ThrowOnRunning := TRUE;
	task.ThrowOnFirstStopping := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("Work failure", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	AssertEquals_UINT(3, task.StoppingCalls, 'Interrupted stopping must retry before two completed steps');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RepeatedStoppingExceptions" Id="{90b965b2-f36d-4970-bedc-91c6cc1a1ccc}">
      <Declaration><![CDATA[(*!
<summary>Repeated stopping exceptions keep cleanup pending without replacing a successful work result.</summary>
<description>
The fixture throws on three stopping calls, then resumes two cleanup steps and releases its resource.
One Execute is issued per suite call. Log attempts are not asserted because LogManager counters are shared
with other PLC tasks; the owner can observe them during runtime verification. An exception escaping Task
fails the scenario.
</description>
*)
METHOD RepeatedStoppingExceptions
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("Repeated stopping task");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Repeated stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	task.ThrowOnEveryStopping := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Repeated stopping exceptions must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.ThrowOnEveryStopping AND_THEN task.StoppingCalls >= _RepeatedStoppingFailures THEN
	task.ThrowOnEveryStopping := FALSE;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin before stopping succeeds');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.OriginalStopReason.Value), 'Stopping exceptions must not replace the work result');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.OriginalStopReason.Value), 'Original work result must be retained');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.WORK_DONE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect successful release');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must run only once');
	AssertEquals_UINT(5, task.StoppingCalls, 'Three interrupted calls and two cleanup steps must run');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must finish');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must start only once after cleanup');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="EmptyExceptionMessageUsesFallback" Id="{4bd7a709-c3aa-4f2f-94df-42ff1221aef0}">
      <Declaration><![CDATA[(*!
<summary>Keeps named processing diagnostics when GetMessage returns empty text.</summary>
<description>
The resource-free fixture throws a StandardException with empty payload. Cleanup still completes after
the caught processing exception. One Execute is issued per suite call with a bounded call budget;
an exception escaping Task fails the scenario.
</description>
*)
METHOD EmptyExceptionMessageUsesFallback
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("Empty message task");
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Empty-message scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.ThrowOnRunning := TRUE;
	task.ThrowWithEmptyMessage := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Empty exception message must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Processing exception must set original FAILURE');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Resource-free failure must remain final FAILURE');
	AssertEquals_WSTRING("Task 'Empty message task' processing failed", task.OriginalStopReason.Message, 'Empty GetMessage must retain the named fallback');
	AssertEquals_WSTRING("Task 'Empty message task' processing failed", task.FinalStopReason.Message, 'Final result must retain the named fallback');
	AssertEquals_UINT(1, task.RunningCalls, 'Ordinary work must not restart during cleanup');
	AssertEquals_UINT(2, task.StoppingCalls, 'Cleanup must finish after two steps');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CancelDuringAcquire" Id="{47d68c5a-b1f2-44b6-9e6f-77587fa86256}">
      <Declaration><![CDATA[(*!
<summary>Cancellation drains a late acquisition before releasing its resource.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD CancelDuringAcquire
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
	cancelRequested : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);

	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT cancelRequested AND_THEN resource.AcquireProgress = _FirstAcquireStep THEN
	cancelRequested := TRUE;
	AssertTrue(task.Cancel(), 'Cancel during pending acquisition must be accepted');
	AssertFalse(resource.ResourceAcquired, 'Cancellation must precede the late acquire response');
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("Cancelled by external logic", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(0, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	AssertEquals_UINT(1, task.CancelNotifications, 'Accepted cancellation must notify once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CancelBeforeAcquire" Id="{52029613-295b-4ee4-9859-4816e4fdd629}">
      <Declaration><![CDATA[(*!
<summary>Cancellation before Execute does not request or release an absent resource.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD CancelBeforeAcquire
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);

	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
	AssertTrue(task.Cancel(), 'Cancellation before acquisition must be accepted');
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.EXTERNAL_CANCEL), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING("Cancelled by external logic", task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(0, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	AssertEquals_UINT(1, task.CancelNotifications, 'Accepted cancellation must notify once');
	AssertEquals_UINT(0, resource.AcquireCalls, 'No acquire may be started after cancellation');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AcquireFailureWithResource" Id="{485a7313-d3b1-4629-b9b1-c09af58a5198}">
      <Declaration><![CDATA[(*!
<summary>Failure after acquisition still waits for cleanup and releases the resource.</summary>
<description>
Checks the complete phase-specific fallback including the public task Name; cleanup assertions remain independent.
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
</description>
*)
METHOD AcquireFailureWithResource
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	initialized : BOOL;
	calls : UINT;
	task : TaskStoppingProbe("TaskStoppingProbe");
	resource : TaskStoppingResource;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

calls := calls + 1;
IF calls > _MaxScenarioCalls THEN
	AssertTrue(FALSE, 'Task stopping scenario exceeded its call budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT initialized THEN
	initialized := TRUE;
	task.SetResource(resource);
	resource.ThrowAfterAcquire := TRUE;
	resource.ThrowOnGetMessage := TRUE;
	IF NOT task.Start() THEN
		AssertTrue(FALSE, 'Prepared task must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
END_IF

__TRY
	task.Execute();
__CATCH
	exceptionEscaped := TRUE;
__ENDTRY

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Injected operation or formatting exception must not escape');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF task.State.Running AND_THEN task.RunningSubstate.Stopping THEN
	AssertEquals_UINT(0, resource.ReleaseCalls, 'Release cannot begin while stopping is pending');
END_IF

IF task.State.Stopped THEN
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.OriginalStopReason.Value), 'Original result must survive cleanup');
	AssertEquals_INT(TO_INT(TOF_Tasks.TASK_STOP_REASON.FAILURE), TO_INT(task.FinalStopReason.Value), 'Final result must reflect release outcome');
	AssertEquals_WSTRING(TOF_Core.WideStrings.Concat255("Task '", task.Name, "' resource acquisition failed"), task.OriginalStopReason.Message, 'Original message must be retained');
	AssertFalse(resource.ResourceAcquired, 'Successful cleanup must leave the resource released');
	AssertEquals_UINT(2, task.CompletedCleanupSteps, 'Both cleanup steps must complete before termination');
	AssertEquals_UINT(0, task.RunningCalls, 'Ordinary work must not resume during stopping');
	AssertEquals_UINT(1, resource.ReleaseCalls, 'Release must be requested only when needed and only once');
	AssertEquals_UINT(1, task.AfterStopCalls, 'Final notification must occur exactly once');
	testFinished := TRUE;
	TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AcquireFailureWithoutResource" Id="{4cc09c90-4458-4c8e-800c-8bdf7692714e}">
      <Declaration><![CDATA[(*!
<summary>An early acquire failure follows stopping without requesting release.</summary>
<description>
Runs once across PLC cycles with independent static fixtures and a bounded call budget.
Unexpected exceptions fail the scenario. AutomationRunner supplies exception cleanup and the fatal OOM boundary.
