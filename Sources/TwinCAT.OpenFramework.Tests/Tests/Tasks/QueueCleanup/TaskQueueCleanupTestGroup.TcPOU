<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskQueueCleanupTestGroup" Id="{6c703de6-c8b2-4802-a488-37740853b79f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
