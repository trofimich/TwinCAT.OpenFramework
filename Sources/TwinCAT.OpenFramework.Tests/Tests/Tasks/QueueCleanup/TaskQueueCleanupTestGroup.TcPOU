(*
Groups the seven independent queue cleanup cases.

Owns the cases and their fixed child array for single-task use. Copying invalidates the child bindings.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TaskQueueCleanupTestGroup EXTENDS TOF_Testing.TestGroup<7>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_DelayedCleanupAndReuse : TaskQueueCleanupScenarioTest(
		name := "DelayedCleanupAndReuse",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.DELAYED_CLEANUP_AND_REUSE
	);
	_RepeatedExecuteFailure : TaskQueueCleanupScenarioTest(
		name := "RepeatedExecuteFailure",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.REPEATED_EXECUTE_FAILURE
	);
	_CancelRequestFailure : TaskQueueCleanupScenarioTest(
		name := "CancelRequestFailure",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.CANCEL_REQUEST_FAILURE
	);
	_MessageFormattingFailure : TaskQueueCleanupScenarioTest(
		name := "MessageFormattingFailure",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.MESSAGE_FORMATTING_FAILURE
	);
	_ExternalCancelDuringCleanup : TaskQueueCleanupScenarioTest(
		name := "ExternalCancelDuringCleanup",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.EXTERNAL_CANCEL_DURING_CLEANUP
	);
	_HeldCleanup : TaskQueueCleanupScenarioTest(
		name := "HeldCleanup",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.HELD_CLEANUP
	);
	_ExternalCancelWithReleaseFailure : TaskQueueCleanupScenarioTest(
		name := "ExternalCancelWithReleaseFailure",
		parent := THIS^,
		scenario := QUEUE_CLEANUP_TEST_SCENARIO.EXTERNAL_CANCEL_WITH_RELEASE_FAILURE
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_DelayedCleanupAndReuse,
		_RepeatedExecuteFailure,
		_CancelRequestFailure,
		_MessageFormattingFailure,
		_ExternalCancelDuringCleanup,
		_HeldCleanup,
		_ExternalCancelWithReleaseFailure
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{585f2d0c-1105-49d5-bc3e-79adc2b63f9c}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{d50f7e2d-0e3f-48fe-92ab-1daa27fc95a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{35e88aa5-dff8-43c4-81dc-2ffd699c9fca}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{dd2f954a-2daf-4066-8d3d-07add2d734ee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ac9dc1d4-9bd1-476d-9c94-c1924468ded4}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{614c477c-afa3-4a90-ad33-f6b4ecf8086b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{cdfedb02-6947-412c-9aa1-a8ee5671d2c2}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{608b0fe3-6a8c-49d4-a073-76c0feecdca2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
