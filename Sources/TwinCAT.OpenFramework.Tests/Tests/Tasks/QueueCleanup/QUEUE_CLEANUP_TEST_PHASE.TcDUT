(*!
<summary>Identifies the current queue cleanup test phase.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE QUEUE_CLEANUP_TEST_PHASE :
(
	//! <summary>Drive the original failure and child cleanup.</summary>
	FAILURE_RUN,
	//! <summary>Drive the same queue after Reset without a child failure.</summary>
	REUSE_RUN,
	//! <summary>Advance the stopped queue once to check that release is not retried.</summary>
	OBSERVE_FAILED_RELEASE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
