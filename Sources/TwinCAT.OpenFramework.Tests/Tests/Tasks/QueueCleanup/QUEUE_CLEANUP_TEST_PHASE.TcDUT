(* Identifies the current queue cleanup test phase. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE QUEUE_CLEANUP_TEST_PHASE :
(
	// Drive the original failure and child cleanup.
	FAILURE_RUN,
	// Drive the same queue after Reset without a child failure.
	REUSE_RUN,
	// Advance the stopped queue once to check that release is not retried.
	OBSERVE_FAILED_RELEASE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>