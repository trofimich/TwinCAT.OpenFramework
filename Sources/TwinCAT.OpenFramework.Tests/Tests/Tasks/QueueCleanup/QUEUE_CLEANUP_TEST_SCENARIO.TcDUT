(* Selects the faults and observations for a queue cleanup case. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE QUEUE_CLEANUP_TEST_SCENARIO :
(
	// Completes cleanup, then reuses the same queue and child without injection.
	DELAYED_CLEANUP_AND_REUSE,
	// Raises two further exceptions on cleanup Execute calls.
	REPEATED_EXECUTE_FAILURE,
	// Refuses cancellation by exception twice before accepting it.
	CANCEL_REQUEST_FAILURE,
	// Raises a secondary exception while formatting the original failure.
	MESSAGE_FORMATTING_FAILURE,
	// Requests owner cancellation after the first processing failure.
	EXTERNAL_CANCEL_DURING_CLEANUP,
	// Holds cooperative child cleanup across eight subsequent queue calls.
	HELD_CLEANUP,
	// Requests owner cancellation and injects a terminal parent release failure.
	EXTERNAL_CANCEL_WITH_RELEASE_FAILURE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>