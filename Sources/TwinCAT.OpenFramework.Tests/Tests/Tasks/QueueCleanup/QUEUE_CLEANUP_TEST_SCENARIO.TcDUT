(*!
<summary>Selects the faults and observations for a queue cleanup case.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE QUEUE_CLEANUP_TEST_SCENARIO :
(
	//! <summary>Completes cleanup, then reuses the same queue and child without injection.</summary>
	DELAYED_CLEANUP_AND_REUSE,
	//! <summary>Raises two further exceptions on cleanup Execute calls.</summary>
	REPEATED_EXECUTE_FAILURE,
	//! <summary>Refuses cancellation by exception twice before accepting it.</summary>
	CANCEL_REQUEST_FAILURE,
	//! <summary>Raises a secondary exception while formatting the original failure.</summary>
	MESSAGE_FORMATTING_FAILURE,
	//! <summary>Requests owner cancellation after the first processing failure.</summary>
	EXTERNAL_CANCEL_DURING_CLEANUP,
	//! <summary>Holds cooperative child cleanup across eight subsequent queue calls.</summary>
	HELD_CLEANUP,
	//! <summary>Requests owner cancellation and injects a terminal parent release failure.</summary>
	EXTERNAL_CANCEL_WITH_RELEASE_FAILURE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
