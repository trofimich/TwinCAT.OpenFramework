<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <DUT Name="QUEUE_CLEANUP_TEST_SCENARIO" Id="{67cf8ed3-3088-4383-8b39-df5ffcfc4a37}">
    <Declaration><![CDATA[(*
