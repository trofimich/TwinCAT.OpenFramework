<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ThrowingGetMessageException" Id="{b209960a-a1ef-448b-a416-34bdbbe0f5b1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides a test exception whose GetMessage deliberately throws another exception.</summary>
<description>
Static Throw clones this concrete type. The clone is task-managed; GetMessage deliberately throws a
separate StandardException. This fixture never performs I/O or throws from lifecycle initialization.
</description>
*)

{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK ThrowingGetMessageException EXTENDS TOF_Core.StandardException
VAR
	_FixtureClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{335aa07b-233f-4826-9c68-97ff972abb42}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{07fa6a19-5bcb-464d-a105-d1aa193d86bb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _FixtureClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clone" Id="{ded3acc1-405f-42bb-8bea-1304bbdc3356}">
      <Declaration><![CDATA[(*!
<summary>Creates a task-managed clone retaining the failing formatter.</summary>
<description>
Registers the new object before copying inherited diagnostics. The caller borrows the result until task
cleanup. Allocation failure follows the framework terminal policy.
</description>
*)
METHOD Clone : TOF_Core.IObject
VAR
	copy : POINTER TO ThrowingGetMessageException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[copy := __NEW(ThrowingGetMessageException);
IF copy = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

TOF_Core.DynamicMemoryManager.RegisterAutoDisposedObject(copy^);
copy^.CopyGeneralFields(THIS^);
Clone := copy^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMessage" Id="{5bf4a784-1969-4915-94b1-50b5d93ff030}">
      <Declaration><![CDATA[(*!
<summary>Deliberately fails while formatting the original child exception.</summary>
<description>
Used only to exercise task and queue diagnostic fallback. Neither formatting option is used.
</description>
<param name="showSource">Unused formatting option retained for the inherited signature.</param>
<param name="timestampDisplayMode">Unused formatting option retained for the inherited signature.</param>
*)
METHOD GetMessage : TOF_Core.ERROR_MESSAGE
VAR_INPUT
	showSource : BOOL := FALSE;
	timestampDisplayMode : TOF_Core.TIMESTAMP_DISPLAY_MODE := TOF_Core.TIMESTAMP_DISPLAY_MODE.HIDDEN;
END_VAR
VAR
	failure : TOF_Core.StandardException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[failure.Throw(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Injected message formatting failure");]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{534173d0-7c8b-442e-92ad-0a298013a260}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test library namespace.</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{53c744f6-bf11-4262-89c6-e2b4f467b8b5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e460b78a-3e7a-45e0-a978-d398889a0791}">
      <Declaration><![CDATA[(*!
<summary>Reports the concrete fixture size.</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{af579f54-2ae9-48d2-8882-fa728cfb3c77}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>