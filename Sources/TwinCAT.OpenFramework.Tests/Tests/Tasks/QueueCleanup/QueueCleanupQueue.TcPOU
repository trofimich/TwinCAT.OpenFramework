<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="QueueCleanupQueue" Id="{42317eb9-a8d7-4763-bdc1-b2df0ebf3613}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Supplies TaskQueue with an observable synthetic parent resource.</summary>
<description>
All queue execution and cancellation logic is inherited from the production TaskQueue. Bind a resource
manager through SetResourceManager before Start and keep the binding unchanged throughout the run.
The scenario owns the resource manager and children; the queue borrows them. Reset preserves the binding.
</description>
*)

FUNCTION_BLOCK QueueCleanupQueue EXTENDS TOF_Tasks.TaskQueue
VAR
	_ClassName : STRING := __POUNAME();

	//! <summary>Borrowed scenario resource manager; remains bound across queue resets.</summary>
	_ResourceManager : TOF_Core.IResourceManager;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{bc81fe1a-620e-4a13-aa00-e5dc528d648d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2adf411d-d13f-4c79-9def-6d787c46af82}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Enqueue" Id="{01513550-d189-4ed0-b86b-6180848d583b}">
      <Declaration><![CDATA[(*!
<summary>Adds a live READY child through the production queue API.</summary>
<description>
Borrows the child without resetting or deleting it; it must be unique in this queue.
</description>
<param name="task">Live READY child whose lifecycle is delegated to the queue.</param>
*)
METHOD Enqueue
VAR_INPUT
	task : TOF_Tasks.ITask;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[EnqueueTask(task);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{467d1cdb-fd70-46a4-b3b9-e4ef9fa14cab}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test library namespace.</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5837f30d-19dc-4cfd-8ae0-0584b78ada31}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ResourceManager" Id="{f0d39164-1c6b-49e0-9af0-ffb60dfbc926}">
      <Declaration><![CDATA[(*!
<summary>Returns the resource manager supplied by the scenario.</summary>
<description>
Side-effect-free access. The scenario keeps the manager alive and the binding unchanged throughout the run.
</description>
*)

{attribute 'monitoring' := 'call'}
PROPERTY ResourceManager : TOF_Core.IResourceManager]]></Declaration>
      <Get Name="Get" Id="{934cefe7-894b-4e45-9605-8959fdf0575f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ResourceManager := _ResourceManager;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetResourceManager" Id="{6c276dfc-84f9-49ab-8707-8da2b30b4ba0}">
      <Declaration><![CDATA[(*!
<summary>Binds the scenario's resource manager to the queue.</summary>
<description>
Call before Start and keep the binding unchanged throughout the run. The manager is borrowed;
its owner must keep it alive while bound. This method only assigns the binding and does not reset
the queue or manager. Queue Reset preserves the binding and the manager's observations.
</description>
<param name="resourceManager">Resource manager owned by the scenario.</param>
*)
METHOD INTERNAL SetResourceManager
VAR_INPUT
	resourceManager : TOF_Core.IResourceManager;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ResourceManager := resourceManager;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{d1ac9c6a-baae-46f7-9726-8f830f0511a2}">
      <Declaration><![CDATA[(*!
<summary>Reports the concrete fixture size.</summary>
*)

{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{efe5a957-086d-4866-8e7a-9c2a37ae4a8e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>