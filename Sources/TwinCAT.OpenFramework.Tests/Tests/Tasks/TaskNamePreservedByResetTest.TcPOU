SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks that a configured task name survives the STOPPED to READY reset.

Completes a resource-free one-step task before invoking Reset. A new local fixture is used on every run.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TaskNamePreservedByResetTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{52b042a6-628e-4f71-a29b-019c5134155c}">
      <Declaration><![CDATA[// Verifies the constructor name and exercises Reset from STOPPED before checking that name again.
METHOD PROTECTED ExecuteTest
VAR
	task : CounterTask(name := "Configured counter");
	started : BOOL;
	resetSucceeded : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatWideString(actual := task.Name, message := "Task must adopt the explicit constructor name")
	.ToBe(expected := "Configured counter");

task.TargetValue := 1;
started := task.Start();
Assert.ThatBool(actual := started, message := "Fixture must accept Start").IsTrue();

IF NOT started THEN
	RETURN;
END_IF

task.Execute();
Assert.ThatBool(actual := task.State.Stopped, message := "Reset test requires a completed task").IsTrue();

IF NOT task.State.Stopped THEN
	RETURN;
END_IF

resetSucceeded := task.Reset();
Assert.ThatBool(actual := resetSucceeded, message := "Fixture must accept Reset from STOPPED").IsTrue();
Assert.ThatBool(actual := task.State.Ready, message := "Reset must return the fixture to READY").IsTrue();
Assert.ThatWideString(actual := task.Name, message := "Reset from STOPPED must preserve the configured name")
	.ToBe(expected := "Configured counter");]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6afd0256-1dbb-4b5c-9861-094d7b76e291}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{31f25c84-b4c1-485a-991b-4dc88ea39adc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{493fd736-8145-4151-9bfb-b9a7e8e72058}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f789b37c-dce0-468b-88e4-433e87238705}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{210b992b-bd78-42eb-9784-5896302ad9fc}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f2cad7d1-93cd-4ac0-9aad-b7d7730204a7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
