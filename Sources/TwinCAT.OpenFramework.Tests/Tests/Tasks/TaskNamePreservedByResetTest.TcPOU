<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskNamePreservedByResetTest" Id="{5b39e737-dff4-413a-a0dd-cd25526cac07}" SpecialFunc="None">
    <Declaration><![CDATA[(*
