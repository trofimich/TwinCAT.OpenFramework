<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskSequenceTestGroup" Id="{78cd8712-3e5b-4fe9-90e7-a511b032ffa9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups the cyclic FIFO and both empty-queue modes.

Owns three cases and their fixed registration array. Use the group from one task and keep it at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TaskSequenceTestGroup EXTENDS TOF_Testing.TestGroup<3>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Sequence : TaskSequenceFifoTest(name := "TestSequence", parent := THIS^);
	_AutomaticStop : TaskQueueEmptyModeTest(
		name := "StopWhenNoPendingTasksEnabled",
		parent := THIS^,
		stopWhenEmpty := TRUE
	);
	_WaitForWork : TaskQueueEmptyModeTest(
		name := "StopWhenNoPendingTasksDisabled",
		parent := THIS^,
		stopWhenEmpty := FALSE
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_Sequence,
		_AutomaticStop,
		_WaitForWork
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{1a9210c5-dc18-4599-8147-7f6e10aa57d5}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{a0443cd7-2f82-467a-ac97-3b6989af48d8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{eac91465-3771-4777-8f2c-cb5d0cb83ca2}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{61487caa-43b0-4cef-b7a7-ff351892a55d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{47cd934b-7a12-4784-b0d8-b2db053ef3b7}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{54deac37-ccd0-4716-a1d2-baa698a727ce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5538b630-2628-45f8-95ce-189a920b2474}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{be3dfc89-ba96-4dd3-9757-70ca9d5502cc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
