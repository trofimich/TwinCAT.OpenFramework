<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="TaskSequenceTest" Id="{e9464de9-72eb-4b57-ac87-3d28d718d649}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exercises normal FIFO execution and both empty-queue modes.</summary>
<description>
Uses static counter tasks without I/O. The cyclic sequence has a bounded call budget and reports early
termination or an exceptionEscaped exception as a test failure. Each test runs once per suite instance.
</description>
*)
FUNCTION_BLOCK TaskSequenceTest EXTENDS TcUnit.FB_TestSuite
VAR CONSTANT
	//! <summary>Maximum cyclic calls for 60 counter steps, queue transitions and final cancellation.</summary>
	_MaxSequenceCycles : UINT := 200;
END_VAR
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
	
	_FilePath : STRING(255) := 'C:\TestFile.txt';
	
	_TaskSequence : TOF_Tasks.StandardTaskQueue;
	
	_CounterTask1 : CounterTask;
	_CounterTask2 : CounterTask;
	_CounterTask3 : CounterTask;
	
	_Initialized : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestSequence();

StopWhenNoPendingTasksEnabled();
StopWhenNoPendingTasksDisabled();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{885dd23b-3c87-4e2e-8fac-71627e598a01}">
      <Declaration><![CDATA[(*!
<summary>Borrows the suite's diagnostic type name.</summary>
<description>Read-only storage valid while the suite instance lives.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5a807d67-8562-41a2-8c1f-f2794cf2693a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b4a19e39-9efa-406d-bbe6-72e23561596f}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test library namespace for diagnostics.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0b596ffb-9e5d-48e4-82b7-ff308fd420ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StopWhenNoPendingTasksDisabled" Id="{fe8f4f31-c749-4730-afab-e007055307a4}">
      <Declaration><![CDATA[(*!
<summary>Checks that an empty running queue accepts later work and stops only after Cancel.</summary>
<description>Uses a bounded series of calls to counters with no asynchronous I/O.</description>
*)
METHOD StopWhenNoPendingTasksDisabled
VAR
	executionIndex : INT;
END_VAR
VAR_INST
	testFinished : BOOL;

	taskQueue : TOF_Tasks.StandardTaskQueue;
	counterTask : CounterTask;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

taskQueue.StopWhenNoPendingTasks := FALSE;

AssertTrue(taskQueue.Start(), 'Start must return TRUE for an empty READY queue');

taskQueue.Execute();

AssertTrue(taskQueue.State.Running, 'Empty queue must remain Running when StopWhenNoPendingTasks is FALSE');

// The running empty queue must accept and execute a subsequently added task.
counterTask.TargetValue := 3;

taskQueue.Enqueue(counterTask);

FOR executionIndex := 1 TO 10 DO
	taskQueue.Execute();
END_FOR

AssertEquals_INT(3, counterTask.Counter, 'Task added to a running empty queue must reach TargetValue (3)');
AssertTrue(counterTask.FinalStopReason.WorkDone, 'CounterTask must stop with WorkDone');
AssertEquals_DINT(0, taskQueue.PendingTaskCount, 'PendingTaskCount must be 0 after CounterTask completes');
AssertTrue(taskQueue.State.Running, 'Queue must remain Running after the last task when StopWhenNoPendingTasks is FALSE');

AssertTrue(taskQueue.Cancel(), 'Cancel must return TRUE for a running empty queue');

taskQueue.Execute();

AssertTrue(taskQueue.State.Stopped, 'Execute after accepted Cancel must stop the empty queue');
AssertTrue(taskQueue.FinalStopReason.ExternalCancel, 'Queue must stop with ExternalCancel after accepted Cancel');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopWhenNoPendingTasksEnabled" Id="{fb97ff82-650c-4225-a0fd-5cbd7722b1ad}">
      <Declaration><![CDATA[(*!
<summary>Checks completion of empty and populated queues with automatic empty completion enabled.</summary>
<description>Uses a bounded series of calls to counters with no asynchronous I/O.</description>
*)
METHOD StopWhenNoPendingTasksEnabled
VAR
	executionIndex : INT;
END_VAR
VAR_INST
	testFinished : BOOL;

	taskQueue : TOF_Tasks.StandardTaskQueue;
	counterTask : CounterTask;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(__POUNAME());

taskQueue.StopWhenNoPendingTasks := TRUE;

AssertTrue(taskQueue.Start(), 'Start must return TRUE for an empty READY queue');

taskQueue.Execute();

AssertTrue(taskQueue.State.Stopped, 'Empty queue must stop when StopWhenNoPendingTasks is TRUE');
AssertTrue(taskQueue.FinalStopReason.WorkDone, 'Empty queue must stop with WorkDone when StopWhenNoPendingTasks is TRUE');

AssertTrue(taskQueue.Reset(), 'Reset must return TRUE for a STOPPED queue');

counterTask.TargetValue := 3;
taskQueue.StopWhenNoPendingTasks := TRUE;

taskQueue.Enqueue(counterTask);

AssertTrue(taskQueue.Start(), 'Start must return TRUE for a READY queue containing a task');

// CounterTask has no asynchronous operations; a bounded number of calls is sufficient.
FOR executionIndex := 1 TO 10 DO
	taskQueue.Execute();
END_FOR

AssertEquals_INT(3, counterTask.Counter, 'CounterTask.Counter must reach TargetValue (3)');
AssertTrue(counterTask.FinalStopReason.WorkDone, 'CounterTask must stop with WorkDone');
AssertEquals_DINT(0, taskQueue.PendingTaskCount, 'PendingTaskCount must be 0 after CounterTask completes');
AssertTrue(taskQueue.State.Stopped, 'Queue must stop after the last task when StopWhenNoPendingTasks is TRUE');
AssertTrue(taskQueue.FinalStopReason.WorkDone, 'Queue must stop with WorkDone after its last task completes');

taskQueue.Cancel();
taskQueue.Execute();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestSequence" Id="{39202c76-2ee6-4285-9f97-a0f6c019a813}">
      <Declaration><![CDATA[(*!
<summary>Runs three counters cyclically, then cancels the empty queue.</summary>
<description>
Start refusal, exceptionEscaped Execute exceptions, early STOPPED and exhaustion of the call budget finish the test
with failure. A successful run executes all counters and finishes with EXTERNAL_CANCEL.
</description>
*)
METHOD TestSequence
VAR
	exceptionEscaped : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
	cycles : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

cycles := cycles + 1;
IF cycles > _MaxSequenceCycles THEN
	AssertTrue(FALSE, 'Task sequence exceeded its cycle budget');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF NOT _Initialized THEN
	_Initialized := TRUE;	

	_CounterTask1.TargetValue := 10;	
	_CounterTask2.TargetValue := 20;	
	_CounterTask3.TargetValue := 30;	
	
	_TaskSequence.Enqueue(_CounterTask1);
	_TaskSequence.Enqueue(_CounterTask2);
	_TaskSequence.Enqueue(_CounterTask3);

	IF NOT _TaskSequence.Start() THEN
		AssertTrue(FALSE, 'Prepared task sequence must accept Start');
		testFinished := TRUE;
		TEST_FINISHED();
		RETURN;
	END_IF
ELSE
	__TRY
		_TaskSequence.Execute();
	__CATCH
		exceptionEscaped := TRUE;
	__ENDTRY
END_IF

IF exceptionEscaped THEN
	AssertTrue(FALSE, 'Task sequence Execute unexpectedly raised an exception');
	testFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF

IF _TaskSequence.State.Stopped THEN
	AssertEquals_DINT(0, _TaskSequence.PendingTaskCount, 'Task sequence stopped before all entries completed');
	AssertTrue(_TaskSequence.FinalStopReason.ExternalCancel, 'Completed sequence must stop through external cancellation');
	AssertEquals_INT(60, _CounterTask1.Counter + _CounterTask2.Counter + _CounterTask3.Counter, 'Invalid task sequence execution');
	testFinished := TRUE;
	TEST_FINISHED();
ELSIF _TaskSequence.PendingTaskCount = 0 THEN
	AssertTrue(_TaskSequence.Cancel(), 'Empty running sequence must accept Cancel');
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>