<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskLifecycleViewsTestGroup" Id="{fbe482d9-f59e-40a2-af75-c330e2e43b2b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups the task lifecycle view and naming cases.

Owns the child cases and their fixed registration array. Use from one task. The group must not be copied.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TaskLifecycleViewsTestGroup EXTENDS TOF_Testing.TestGroup<8>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_UnboundTaskState : UnboundTaskStateTest(
		name := "UnboundTaskStateDoesNotFault",
		parent := THIS^
	);
	_TaskStateView : BoundTaskStateTest(
		name := "TaskStateTracksLiveVariables",
		parent := THIS^
	);
	_UnboundTaskRunningSubstate : UnboundTaskRunningSubstateTest(
		name := "UnboundTaskRunningSubstateDoesNotFault",
		parent := THIS^
	);
	_TaskRunningSubstateView : BoundTaskRunningSubstateTest(
		name := "TaskRunningSubstateTracksLiveVariables",
		parent := THIS^
	);
	_UnboundTaskStopReason : UnboundTaskStopReasonTest(
		name := "UnboundTaskStopReasonDoesNotFault",
		parent := THIS^
	);
	_TaskStopReasonView : BoundTaskStopReasonTest(
		name := "TaskStopReasonTracksLiveVariables",
		parent := THIS^
	);
	_Reinitialization : TaskReinitViewsTest(
		name := "TaskFBReinitPreservesLiveViews",
		parent := THIS^
	);
	_NamePreservedByReset : TaskNamePreservedByResetTest(
		name := "TaskNamePreservedByReset",
		parent := THIS^
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_UnboundTaskState,
		_TaskStateView,
		_UnboundTaskRunningSubstate,
		_TaskRunningSubstateView,
		_UnboundTaskStopReason,
		_TaskStopReasonView,
		_Reinitialization,
		_NamePreservedByReset
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{2ff6885f-1e9e-40f9-8022-b26e534a0849}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{a3aac847-035e-4919-b6e4-6520d004b039}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{eb816338-47d9-4e9c-9dbc-efd690766148}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{68ca13ca-b573-4e34-ab53-78fd80f0ede9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{fa9d11df-01f1-4046-be6d-e0f2549a58e3}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ca16a01e-f9e2-4762-9565-bb17f95cce3e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3092c679-8c71-4476-820c-db9ef547a07b}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ba6dcfa5-3139-46de-9a13-54b05c430fae}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
