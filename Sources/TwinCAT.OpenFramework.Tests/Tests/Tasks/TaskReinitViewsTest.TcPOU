<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TaskReinitViewsTest" Id="{a06860ea-b7b5-4736-8b49-c333b31a593e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
