<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="UnboundTaskRunningSubstateTest" Id="{8975ddfb-9f1d-44ac-8ece-d30fa7e3dc92}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks safe defaults for an unbound TaskRunningSubstate view.

Uses unbound local references and checks every observable property without dereferencing a missing target.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK UnboundTaskRunningSubstateTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{3b3b6c78-a4f0-43be-9f92-630463c99c9e}">
      <Declaration><![CDATA[// Reads all flags and verifies the default value for an unbound view.
METHOD PROTECTED ExecuteTest
VAR
	backingValue : REFERENCE TO TOF_Tasks.TASK_RUNNING_SUBSTATE;
	view : TOF_Tasks.TaskRunningSubstate(taskRunningSubstate := backingValue);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(
	actual := view.ResourceAcquiring,
	message := "Unbound TaskRunningSubstate.ResourceAcquiring must be false"
).IsFalse();
Assert.ThatBool(actual := view.Processing, message := "Unbound TaskRunningSubstate.Processing must be false").IsFalse();
Assert.ThatBool(actual := view.Stopping, message := "Unbound TaskRunningSubstate.Stopping must be false").IsFalse();
Assert.ThatBool(
	actual := view.ResourceReleasing,
	message := "Unbound TaskRunningSubstate.ResourceReleasing must be false"
).IsFalse();
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_RUNNING_SUBSTATE.RESOURCE_ACQUIRING,
	message := "Unbound Value must default to RESOURCE_ACQUIRING"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{07e8a124-19c8-4d61-bca0-2f5c0feeee2c}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6ec79182-7732-4500-9f29-e2b8b9a7af6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{209ac211-4a3b-4ab3-8858-86c5ca64dec1}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{88fad9b4-be2e-4b25-a6c2-8c1dd0404c50}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{0f87c90c-f50c-4419-9dbe-28e981369516}">
      <Declaration><![CDATA[// Reports the complete concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{08dd9d92-0eae-4a2d-9b7b-a3863aa1a362}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
