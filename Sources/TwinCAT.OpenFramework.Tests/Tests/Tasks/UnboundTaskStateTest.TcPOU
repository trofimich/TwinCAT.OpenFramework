<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="UnboundTaskStateTest" Id="{5c667417-1b52-4dd6-a1b8-23ce4dc6d4bc}" SpecialFunc="None">
    <Declaration><![CDATA[(*
