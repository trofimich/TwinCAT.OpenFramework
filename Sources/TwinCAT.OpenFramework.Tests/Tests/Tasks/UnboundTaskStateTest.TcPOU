(*!
<summary>Checks safe defaults for an unbound TaskState view.</summary>
<description>
Uses unbound local references and checks every observable property without dereferencing a missing target.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK UnboundTaskStateTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a14d76e2-7fcd-4359-b9eb-0b80e7b5180e}">
      <Declaration><![CDATA[//! <summary>Reads all flags and verifies the default value for an unbound view.</summary>
METHOD PROTECTED ExecuteTest
VAR
	backingValue : REFERENCE TO TOF_Tasks.TASK_STATE;
	stateChanged : REFERENCE TO BOOL;
	view : TOF_Tasks.TaskState(taskState := backingValue, taskStateChanged := stateChanged);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(actual := view.Ready, message := "Unbound TaskState.Ready must be false").IsFalse();
Assert.ThatBool(actual := view.Running, message := "Unbound TaskState.Running must be false").IsFalse();
Assert.ThatBool(actual := view.Stopped, message := "Unbound TaskState.Stopped must be false").IsFalse();
Assert.ThatBool(actual := view.StateChanged, message := "Unbound TaskState.StateChanged must be false").IsFalse();
Assert.ThatBool(
	actual := view.Value = TOF_Tasks.TASK_STATE.READY,
	message := "Unbound Value must default to READY"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{29b14cf5-0836-447c-8c9e-c229ab6dee50}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify the returned storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{de7c0e28-26fe-47f5-b82e-b84da826e169}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{07370dcc-7f9b-4df2-ac23-6112ffe3bc23}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify the returned storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{aad4619a-78fb-46f6-ac18-17ef847dda45}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7d81fc7d-4ee3-445f-9688-ff05699259b7}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{1e0116ac-5fc6-435d-bab4-72e8defee532}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
