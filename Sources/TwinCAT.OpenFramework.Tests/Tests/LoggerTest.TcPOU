(*!
<summary>Exercises text-file and EventLogger diagnostic output.</summary>
<description>
The file scenario uses an exclusively owned directory, advances Stop through STOPPED, reads generated bytes
and removes registered artifacts. Failed scenarios also complete cleanup attempts before TEST_FINISHED.
Cleanup diagnostics fail the case. This does not establish physical close success or persistent storage durability.
</description>
*)

FUNCTION_BLOCK LoggerTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_SimpleTextFileLogger : TOF_Loggers.SimpleTextFileLogger(
		directoryPath := 'C:\OpenFrameworkTests\Logger_Smoke',
		logFilePrefix := 'Log',
		maxRecordsPerFile := 10,
		directoryPathType := Tc2_System.E_OpenPath.PATH_GENERIC,
		timeout := Tc2_System.Global_Variables.DEFAULT_ADS_TIMEOUT,
		amsNetId := ''
	);			
	
	_EventLogger : TOF_Loggers.EventLogger(
		debugEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.DebugEvent,
		informationEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.InformationEvent,
		warningEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.WarningEvent,
		errorEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.ErrorEvent,
		criticalErrorEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.CriticalErrorEvent
	);

	_QueuedLogger : TOF_Loggers.QueuedLogger;
	_LogDirectory : LoggerTestDirectory(
		directoryPath := 'C:\OpenFrameworkTests\Logger_Smoke',
		logFilePrefix := 'Log'
	);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CreateTextFileLogs();
CreateEventLoggerLogs();
TestQueuedLogger();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{587aefa6-4f40-4285-972e-2f0b6234ea1a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a9adcda0-4445-4e29-9645-fa477df0780e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CreateEventLoggerLogs" Id="{4e09ae9c-9f76-4bf6-b42b-7424509738d0}">
      <Declaration><![CDATA[METHOD CreateEventLoggerLogs
VAR_INST
	testFinished : BOOL;

	logMessageNumber : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

logMessageNumber := logMessageNumber + 1;
	AssertTrue(
		Condition := _EventLogger.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.DEBUG,
			message := "Test debug message",
			messageNumber := logMessageNumber
		),
		Message := 'Debug message not logged to EventLogger'
	);

logMessageNumber := logMessageNumber + 1;
	AssertTrue(
		Condition := _EventLogger.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.INFORMATION,
			message := "Test information message",
			messageNumber := logMessageNumber
		),
		Message := 'Information message not logged to EventLogger'
	);

logMessageNumber := logMessageNumber + 1;
	AssertTrue(
		Condition := _EventLogger.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.WARNING,
			message := "Test warning message",
			messageNumber := logMessageNumber
		),
		Message := 'Warning message not logged to EventLogger'
	);

logMessageNumber := logMessageNumber + 1;
	AssertTrue(
		Condition := _EventLogger.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.ERROR,
			message := "Test error message",
			messageNumber := logMessageNumber
		),
		Message := 'Error message not logged to EventLogger'
	);

logMessageNumber := logMessageNumber + 1;
	AssertTrue(
		Condition := _EventLogger.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.CRITICAL_ERROR,
			message := "Test critiacal error message",
			messageNumber := logMessageNumber
		),
		Message := 'Critical error message not logged to EventLogger'
	);

testFinished := TRUE;
TEST_FINISHED();				]]></ST>
      </Implementation>
    </Method>
    <Method Name="CreateTextFileLogs" Id="{4ba118cc-c436-438e-ab87-19b721b67152}">
      <Declaration><![CDATA[(*!
<summary>Writes forty-nine messages in an owned directory and verifies the generated files before deletion.</summary>
<description>
Waits for FileTestRoot, refuses a pre-existing scenario directory, then stops the logger and reads its
files through the owned fixture. Expects five rotated files and forty-nine wide-CR records. A 30-second
deadline reports failure while the active case retains logger stopping and nonrecursive cleanup. Completion
waits for these attempts and reports cleanup errors before TEST_FINISHED; cleanup has no forced deadline.
Readback does not establish durable storage or physical close success.
</description>
*)
METHOD CreateTextFileLogs
VAR
	logMessage : TOF_Core.ERROR_MESSAGE;
	expectedRecord : WSTRING(255);
END_VAR
VAR_INST
	lifecycle : FILE_TEST_LIFECYCLE;
	cleanupExceptionObserved : BOOL;
	deadline : Tc2_Standard.TON;
	phase : LOGGER_FILE_TEST_PHASE;
	logMessageNumber : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF lifecycle = FILE_TEST_LIFECYCLE.FINISHED THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

IF lifecycle = FILE_TEST_LIFECYCLE.CLEANING_UP THEN
	__TRY

		IF _SimpleTextFileLogger.State = TOF_Loggers.SIMPLE_TEXT_FILE_LOGGER_STATE.FAILED THEN

			IF _SimpleTextFileLogger.Busy THEN
				_SimpleTextFileLogger.Execute();
			END_IF

		ELSIF _SimpleTextFileLogger.State <> TOF_Loggers.SIMPLE_TEXT_FILE_LOGGER_STATE.STOPPED THEN
			_SimpleTextFileLogger.Stop();
			_SimpleTextFileLogger.Execute();
		END_IF

		IF NOT _SimpleTextFileLogger.Busy THEN
			_LogDirectory.Cleanup();

			IF _LogDirectory.CleanupComplete THEN
				AssertTrue(
					Condition := _LogDirectory.CleanupSucceeded,
					Message := TOF_Core.Strings.Concat255(_LogDirectory.DirectoryPath, ': ', _LogDirectory.CleanupMessage)
				);
				AssertFalse(
					Condition := cleanupExceptionObserved,
					Message := 'An exception interrupted cleanup before the final removal attempt'
				);
				lifecycle := FILE_TEST_LIFECYCLE.FINISHED;
				TEST_FINISHED();
			END_IF
		END_IF

	__CATCH
		cleanupExceptionObserved := TRUE;
	__ENDTRY

	RETURN;
END_IF

deadline(IN := TRUE, PT := T#30S);

__TRY

	IF FileTestRoot.FailureMessage <> TOF_Core.Strings.Empty THEN
		AssertTrue(Condition := FALSE, Message := FileTestRoot.FailureMessage);
		lifecycle := FILE_TEST_LIFECYCLE.CLEANING_UP;
		RETURN;
	END_IF

	IF NOT FileTestRoot.Prepared THEN
		RETURN;
	END_IF

	CASE phase OF
		LOGGER_FILE_TEST_PHASE.PREPARE_DIRECTORY:
			_LogDirectory.Prepare();

			IF _LogDirectory.PreparationFailed THEN
				AssertTrue(Condition := FALSE, Message := _LogDirectory.PreparationMessage);
				lifecycle := FILE_TEST_LIFECYCLE.CLEANING_UP;
			ELSIF _LogDirectory.Prepared THEN
				phase := LOGGER_FILE_TEST_PHASE.SEND_MESSAGES;
			END_IF

		LOGGER_FILE_TEST_PHASE.SEND_MESSAGES:
			logMessageNumber := logMessageNumber + 1;
			logMessage := TOF_Core.WideStrings.Concat255("This is log message #", TO_WSTRING(logMessageNumber));
			expectedRecord := TOF_Core.WideStrings.Concat255(
				"#",
				TO_WSTRING(logMessageNumber),
				": [INFORMATION] This is log message #",
				TO_WSTRING(logMessageNumber)
			);
			AssertTrue(
				Condition := _LogDirectory.ExpectRecord(text := expectedRecord),
				Message := 'Expected smoke record must be registered'
			);
			AssertTrue(
				Condition := _SimpleTextFileLogger.TryLogMessage(
					category := TOF_Core.LOG_CATEGORY.INFORMATION,
					message := logMessage,
					messageNumber := logMessageNumber
				),
				Message := 'File logger rejected a message before Stop'
			);
			_SimpleTextFileLogger.Execute();

			IF logMessageNumber = 49 THEN
				AssertTrue(Condition := _SimpleTextFileLogger.Stop(), Message := 'File logger refused normal stopping');
				phase := LOGGER_FILE_TEST_PHASE.WAIT_FOR_STOP;
			END_IF

		LOGGER_FILE_TEST_PHASE.WAIT_FOR_STOP:
			_SimpleTextFileLogger.Execute();

			IF _SimpleTextFileLogger.State = TOF_Loggers.SIMPLE_TEXT_FILE_LOGGER_STATE.STOPPED THEN
				AssertFalse(Condition := _SimpleTextFileLogger.Busy, Message := 'Stopped file logger remains busy');
				AssertFalse(
					Condition := _SimpleTextFileLogger.TryLogMessage(
						category := TOF_Core.LOG_CATEGORY.INFORMATION,
						message := logMessage
					),
					Message := 'Stopped file logger accepted a message'
				);
				phase := LOGGER_FILE_TEST_PHASE.READBACK;
			END_IF

		LOGGER_FILE_TEST_PHASE.READBACK:
			_LogDirectory.Cleanup();

			IF _LogDirectory.CleanupComplete THEN
				AssertTrue(Condition := _LogDirectory.CleanupSucceeded, Message := _LogDirectory.CleanupMessage);
				AssertTrue(Condition := _LogDirectory.FileCount = 5, Message := 'Forty-nine records must rotate into five files');
				AssertTrue(Condition := _LogDirectory.RecordCount = 49, Message := 'Readback must contain forty-nine records');
				lifecycle := FILE_TEST_LIFECYCLE.CLEANING_UP;
				phase := LOGGER_FILE_TEST_PHASE.COMPLETE;
			END_IF

	END_CASE

	IF lifecycle = FILE_TEST_LIFECYCLE.RUNNING_SCENARIO
		AND_THEN _SimpleTextFileLogger.State = TOF_Loggers.SIMPLE_TEXT_FILE_LOGGER_STATE.FAILED
	THEN
		AssertTrue(Condition := FALSE, Message := TO_STRING(_SimpleTextFileLogger.ErrorMessage));
		lifecycle := FILE_TEST_LIFECYCLE.CLEANING_UP;
	END_IF

__CATCH
	AssertTrue(Condition := FALSE, Message := 'Exception interrupted the owned file logger scenario');
	lifecycle := FILE_TEST_LIFECYCLE.CLEANING_UP;
__ENDTRY

IF lifecycle = FILE_TEST_LIFECYCLE.RUNNING_SCENARIO AND_THEN deadline.Q THEN
	_SimpleTextFileLogger.Stop();
	AssertTrue(Condition := FALSE, Message := 'File logger scenario exceeded its 30-second deadline');
	lifecycle := FILE_TEST_LIFECYCLE.CLEANING_UP;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{b198c661-dda6-4399-b364-95b22569e8e9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3f4d26a9-cad0-4620-907b-b749e48c0db2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TestQueuedLogger" Id="{f5d90100-3026-4444-a123-9efb14490001}">
      <Declaration><![CDATA[(*!
<summary>Exercises QueuedLogger configuration, bounded queuing, overflow rejection and delivery.</summary>
*)
METHOD TestQueuedLogger
VAR_INST
	testFinished : BOOL;
	logMessageNumber : ULINT := 1;
	error : TOF_Core.ERROR;
END_VAR
VAR
	i : UINT;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := 'QueuedLogger_Lifecycle_And_Forwarding');

// 1. Check initial state before configuration
AssertEquals_DINT(
		Expected := 0,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'PendingMessageCount must start at 0'
	);
AssertEquals_ULINT(
		Expected := 0,
		Actual := _QueuedLogger.FailedDeliveryCount,
		Message := 'FailedDeliveryCount must start at 0'
	);

// 2. Configure validation
AssertFalse(Condition := _QueuedLogger.Configure(backend := 0), Message := 'Configure must reject null backend');
AssertFalse(
	Condition := _QueuedLogger.Configure(backend := _QueuedLogger),
	Message := 'Configure must reject self backend'
);
AssertTrue(
	Condition := _QueuedLogger.Configure(backend := _EventLogger),
	Message := 'Configure must succeed with valid backend'
);
AssertFalse(
		Condition := _QueuedLogger.Configure(backend := _EventLogger),
		Message := 'Configure must reject repeated configuration'
	);

// 3. PendingMessageCount after configuration
AssertEquals_DINT(
		Expected := 0,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'PendingMessageCount must be 0 after configuration'
	);

// 4. Enqueueing messages
AssertTrue(
		Condition := _QueuedLogger.TryLogMessage(category := TOF_Core.LOG_CATEGORY.DEBUG, message := "Queued debug message 1"),
		Message := 'Must enqueue message without number'
	);
AssertEquals_DINT(
		Expected := 1,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'PendingMessageCount must be 1 after first message'
	);

	AssertTrue(
		Condition := _QueuedLogger.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.INFORMATION,
			message := "Queued info message 2",
			messageNumber := logMessageNumber
		),
		Message := 'Must enqueue message with number'
	);
AssertEquals_DINT(
		Expected := 2,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'PendingMessageCount must be 2 after second message'
	);

// 5. Enqueueing error via TryLogError
__TRY
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Test queued error"
	);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);

	IF caughtException <> 0 THEN
		caughtException.ToError(targetError := error, severity := TOF_Core.ERROR_SEVERITY.ERROR);
	END_IF
__ENDTRY

AssertTrue(
		Condition := _QueuedLogger.TryLogError(error := error, messageNumber := logMessageNumber),
		Message := 'Must enqueue error via TryLogError'
	);
AssertEquals_DINT(
		Expected := 3,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'PendingMessageCount must be 3 after error'
	);

// 6. Execute from owner task delivers messages to backend
_QueuedLogger.Execute();
AssertEquals_DINT(
		Expected := 0,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'PendingMessageCount must be 0 after Execute drains queue'
	);
AssertEquals_ULINT(
		Expected := 0,
		Actual := _QueuedLogger.FailedDeliveryCount,
		Message := 'FailedDeliveryCount must be 0 after successful delivery'
	);

// 7. Verify capacity overflow rejection
FOR i := 1 TO TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY DO
	AssertTrue(
		Condition := _QueuedLogger.TryLogMessage(category := TOF_Core.LOG_CATEGORY.DEBUG, message := "Filling queue"),
		Message := 'Must accept messages up to capacity'
	);
END_FOR

AssertEquals_DINT(
		Expected := TO_DINT(TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY),
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'Queue must be at capacity'
	);

// The next message must be rejected without discarding existing messages
	AssertFalse(
		Condition := _QueuedLogger.TryLogMessage(category := TOF_Core.LOG_CATEGORY.CRITICAL_ERROR, message := "Overflow message"),
		Message := 'Must reject message when queue is full'
	);
	AssertEquals_DINT(
		Expected := TO_DINT(TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY),
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'Queue count must remain at capacity'
	);

// Drain the full queue
_QueuedLogger.Execute();
AssertEquals_DINT(
		Expected := 0,
		Actual := _QueuedLogger.PendingMessageCount,
		Message := 'Queue must be drained after Execute'
	);

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>