<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonThrowingArgumentCategoriesTest" Id="{f5b4a350-4225-48c1-a6df-8dc0805a07ad}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks null source and target addresses and unsupported-type exception categories.

Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonThrowingArgumentCategoriesTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_Source : JSON_TEST_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{12dcaf8d-bebf-4f60-aa12-961498505850}">
      <Declaration><![CDATA[(* Checks null source and target addresses and unsupported-type exception categories. *)
METHOD PROTECTED ExecuteTest
VAR
	caught : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	scalar : DINT;
	sourceInfo : __SYSTEM.VAR_INFO;
	jsonSize : UDINT;
	missing : TOF_Core.IArgumentNotSpecifiedException;
	unsupported : TOF_Core.IArgumentTypeClassNotSupportedException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Source.Number := 42;
_Source.Ready := TRUE;

_Json := '';

sourceInfo := __VARINFO(_Source);
sourceInfo.ByteAddress := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Serializer.SerializeByVarInfo(
		sourceStructureVarInfo := sourceInfo,
		sourceStructureAddress := TOF_Core.Memory.NULL_ADDRESS,
		extender := 0,
		targetJson := _Json,
		jsonSize => jsonSize
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := CurrentNamespace.Name,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	Assert.ThatBool(
		actual := __QUERYINTERFACE(caughtException, missing),
		message := "Null source must retain the required-argument category"
	).IsTrue();
__ENDTRY

Assert.ThatBool(
	actual := caught,
	message := "Throwing API must reject a null source"
).IsTrue();
caught := FALSE;

// Verify the address guard without entering native conversion.
__TRY
	_Serializer.DeserializeByVarInfo(
		json := _Json,
		targetStructureVarInfo := sourceInfo,
		targetStructureAddress := TOF_Core.Memory.NULL_ADDRESS
	);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := CurrentNamespace.Name,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	Assert.ThatBool(
		actual := __QUERYINTERFACE(caughtException, missing),
		message := "Null target must retain the required-argument category"
	).IsTrue();
__ENDTRY

Assert.ThatBool(
	actual := caught,
	message := "Throwing API must reject a null target"
).IsTrue();
caught := FALSE;

__TRY
	_Serializer.Deserialize(json := _Json, targetStructure := scalar);
__CATCH(exceptionCode)
	caught := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := CurrentNamespace.Name,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	Assert.ThatBool(
		actual := __QUERYINTERFACE(caughtException, unsupported),
		message := "Scalar target must retain the unsupported-type category"
	).IsTrue();
__ENDTRY

Assert.ThatBool(
	actual := caught,
	message := "Throwing API must reject a scalar target"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{22cd04b9-5295-4a29-a022-f61daff9db2d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{022435eb-ccde-4aec-94e4-d86d0f840bfe}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1e8ddc99-22b5-4a57-b9aa-3ff7920411bf}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{480f361e-d032-440a-9dcd-02d0bbd3b1ea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{339fa6bb-f84d-4197-befe-ff713fa99ab2}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3ccb44a4-b744-443d-a021-f35810c705d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
