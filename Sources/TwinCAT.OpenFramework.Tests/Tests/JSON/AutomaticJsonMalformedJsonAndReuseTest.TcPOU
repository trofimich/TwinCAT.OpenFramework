<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonMalformedJsonAndReuseTest" Id="{68bf3604-ba65-4794-a3dc-83be9517b81a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks malformed-input refusal and successful reuse of both fill paths.

Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonMalformedJsonAndReuseTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_Target : JSON_TEST_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{4b23a050-5631-41b1-b9ea-114d28e5855e}">
      <Declaration><![CDATA[(* Checks malformed-input refusal and successful reuse of both fill paths. *)
METHOD PROTECTED ExecuteTest
VAR
	targetInfo : __SYSTEM.VAR_INFO;
	success : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Target.Number := 0;
_Target.Ready := FALSE;

_Json := '{';
targetInfo := __VARINFO(_Target);
success := _Serializer.TryDeserialize(json := _Json, targetStructure := _Target);
Assert.ThatBool(
	actual := success,
	message := "Malformed JSON must fail ANY TryFill"
).IsFalse();
success := _Serializer.TryDeserializeByVarInfo(
	json := _Json,
	targetStructureVarInfo := targetInfo,
	targetStructureAddress := ADR(_Target)
);
Assert.ThatBool(
	actual := success,
	message := "Malformed JSON must fail explicit TryFill"
).IsFalse();
_Json := '{"Number":42,"Ready":true}';
success := _Serializer.TryDeserialize(json := _Json, targetStructure := _Target);
Assert.ThatBool(
	actual := success,
	message := "ANY fill must recover on the next valid call"
).IsTrue();
Assert.ThatDInt(
	actual := _Target.Number,
	message := "Integer payload must round-trip"
).ToBe(expected := 42);
Assert.ThatBool(
	actual := _Target.Ready,
	message := "Boolean payload must round-trip"
).IsTrue();
_Target.Number := 0;
_Target.Ready := FALSE;
success := _Serializer.TryDeserializeByVarInfo(
	json := _Json,
	targetStructureVarInfo := targetInfo,
	targetStructureAddress := ADR(_Target)
);
Assert.ThatBool(
	actual := success,
	message := "Explicit fill must recover on the next valid call"
).IsTrue();
Assert.ThatDInt(
	actual := _Target.Number,
	message := "Integer payload must round-trip"
).ToBe(expected := 42);
Assert.ThatBool(
	actual := _Target.Ready,
	message := "Boolean payload must round-trip"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{568172a7-5a1e-44f9-9b66-22d22617c2cd}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0a0359b5-0269-4ff6-bf87-8789beb5f24a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2a660712-a865-49b3-9e9a-f4743171f286}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4932fb34-a34f-4bc1-a591-88d3de0af3ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{4790f30a-6544-4210-8048-0f394b4beb50}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d20c45df-e6d1-4856-8817-20129ac27b6d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
