<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonSerializerTestGroup" Id="{90e83219-54f5-44e8-aa11-741fa12e10ce}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups native JSON conversion, capacity, encoding and callback cases.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonSerializerTestGroup EXTENDS TOF_Testing.TestGroup<12>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_RoundTripsAnyStructure : AutomaticJsonRoundTripsAnyStructureTest(name := "RoundTripsAnyStructure", parent := THIS^);
	_ThrowingAnyRoundTrip : AutomaticJsonThrowingAnyRoundTripTest(name := "ThrowingAnyRoundTrip", parent := THIS^);
	_SingleFieldVarInfoRoundTrip : AutomaticJsonSingleFieldVarInfoRoundTripTest(name := "SingleFieldVarInfoRoundTrip", parent := THIS^);
	_RejectsInvalidArguments : AutomaticJsonRejectsInvalidArgumentsTest(name := "RejectsInvalidArguments", parent := THIS^);
	_ThrowingArgumentCategories : AutomaticJsonThrowingArgumentCategoriesTest(name := "ThrowingArgumentCategories", parent := THIS^);
	_MalformedJsonAndReuse : AutomaticJsonMalformedJsonAndReuseTest(name := "MalformedJsonAndReuse", parent := THIS^);
	_WrappedCallbacks : AutomaticJsonWrappedCallbacksTest(name := "WrappedCallbacks", parent := THIS^);
	_CallbackContainmentAndReuse : AutomaticJsonCallbackContainmentAndReuseTest(name := "CallbackContainmentAndReuse", parent := THIS^);
	_ThrowingCallbackPropagation : AutomaticJsonThrowingCallbackPropagationTest(name := "ThrowingCallbackPropagation", parent := THIS^);
	_CapacityOverflowAndReuse : AutomaticJsonCapacityOverflowAndReuseTest(name := "CapacityOverflowAndReuse", parent := THIS^);
	_LongUtf8RoundTrip : AutomaticJsonLongUtf8RoundTripTest(name := "LongUtf8RoundTrip", parent := THIS^);
	_DecimalPlacesReadback : AutomaticJsonDecimalPlacesReadbackTest(name := "DecimalPlacesReadback", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_RoundTripsAnyStructure,
		_ThrowingAnyRoundTrip,
		_SingleFieldVarInfoRoundTrip,
		_RejectsInvalidArguments,
		_ThrowingArgumentCategories,
		_MalformedJsonAndReuse,
		_WrappedCallbacks,
		_CallbackContainmentAndReuse,
		_ThrowingCallbackPropagation,
		_CapacityOverflowAndReuse,
		_LongUtf8RoundTrip,
		_DecimalPlacesReadback
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{64df74bd-21a3-4d55-83ea-b64ec1652793}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{b099ba31-bff9-4ebd-9378-4da6e61a7b9f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{829521cb-cd95-40ce-9ee5-0caa56616ce7}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5b36476b-0823-49cf-9837-2c5bf9872f10}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2069962d-c383-4b0e-8b75-69754c6d939c}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{982c7d74-948c-4a0d-bfcb-b9da71f14926}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a67da56f-28a1-49f6-b4e5-a092a9fecb08}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{fd40f301-eb0c-46ad-98a2-f04148eba1e6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
