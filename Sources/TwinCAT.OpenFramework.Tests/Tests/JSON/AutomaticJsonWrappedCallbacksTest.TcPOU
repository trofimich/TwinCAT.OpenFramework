<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonWrappedCallbacksTest" Id="{c677a228-f281-43da-a5f4-5b5c488b19d8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks prefix/value/suffix order and callback counts.

Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonWrappedCallbacksTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_Extender : JsonExtenderProbe;
	_Source : JSON_TEST_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{4406ba9c-761e-4566-aa70-94f24142f07c}">
      <Declaration><![CDATA[(* Checks prefix/value/suffix order and callback counts. *)
METHOD PROTECTED ExecuteTest
VAR
	success : BOOL;
	jsonSize : UDINT;
	expectedJson : STRING(40) := '[{"Number":42,"Ready":true}]';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Source.Number := 42;
_Source.Ready := TRUE;

_Json := '';

_Extender.Reset();

success := _Serializer.TrySerialize(
	sourceStructure := _Source,
	extender := _Extender,
	targetJson := _Json,
	jsonSize => jsonSize
);
Assert.ThatBool(
	actual := success,
	message := "Balanced callbacks must produce a document"
).IsTrue();
Assert.That(
	actual := _Json,
	message := "Callbacks must surround exactly one structure value"
).ToBe(expected := expectedJson);
Assert.ThatUDInt(
	actual := _Extender.StartCount,
	message := "Start must run once"
).ToBe(expected := 1);
Assert.ThatUDInt(
	actual := _Extender.FinishCount,
	message := "Finish must run once"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{50c15499-3d63-4910-81be-1add4158f330}">
      <Declaration><![CDATA[(*
Restores the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Extender.Reset();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{64a2328c-dfb6-465a-aa42-948b208c2cf8}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{12f0d956-a1f3-49b2-815f-5b048ec3aafd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{cd5dacb1-ada8-435f-8c8c-3d9057ee00d0}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0f0b4bd5-fd2b-461c-8224-f435f6518952}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{75580b33-03ec-449c-bc8e-b91745a8cb8e}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ed6c6f29-8221-4d17-bc52-9c19e7e2006b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
