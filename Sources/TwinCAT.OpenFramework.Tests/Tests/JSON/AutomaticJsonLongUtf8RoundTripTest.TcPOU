<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonLongUtf8RoundTripTest" Id="{9ccc1d3c-0f6d-4a20-b93b-218d203efb7c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks long UTF-8 text and escaped characters by independent byte comparison.

Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonLongUtf8RoundTripTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_LargeSource : JSON_TEST_LARGE_VALUE;
	_LargeTarget : JSON_TEST_LARGE_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c68af71b-fe89-4ca4-9981-667156a5c860}">
      <Declaration><![CDATA[(* Checks long UTF-8 text and escaped characters by independent byte comparison. *)
METHOD PROTECTED ExecuteTest
VAR
	i : DINT;
	success : BOOL;
	jsonSize : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Json := '';

_LargeSource.Text := '';
_LargeSource.Marker := 7;
_LargeTarget.Text := '';
_LargeTarget.Marker := 0;

// SA0175: Seed the destination terminator and fill the source with exact UTF-8 and escape bytes.
{analysis -175}
_LargeTarget.Text[305] := BYTE#16#58;

FOR i := 0 TO 299 DO
	_LargeSource.Text[i] := BYTE#16#61;
END_FOR

// UTF-8 U+00E9 followed by quote, backslash, newline and the terminator.
_LargeSource.Text[300] := BYTE#16#C3;
_LargeSource.Text[301] := BYTE#16#A9;
_LargeSource.Text[302] := BYTE#16#22;
_LargeSource.Text[303] := BYTE#16#5C;
_LargeSource.Text[304] := BYTE#16#0A;
_LargeSource.Text[305] := BYTE#0;
{analysis +175}

success := _Serializer.TrySerialize(
	sourceStructure := _LargeSource,
	extender := 0,
	targetJson := _Json,
	jsonSize => jsonSize
);
Assert.ThatBool(
	actual := success,
	message := "Long UTF-8 text must serialize"
).IsTrue();

success := _Serializer.TryDeserialize(json := _Json, targetStructure := _LargeTarget);
Assert.ThatBool(
	actual := success,
	message := "Long UTF-8 text must deserialize"
).IsTrue();

// SA0175: The oracle compares all payload bytes and the terminator, not Unicode character positions.
{analysis -175}
FOR i := 0 TO 305 DO
	Assert.ThatByte(
		actual := _LargeTarget.Text[i],
		message := TOF_Core.WideStrings.Concat255("UTF-8 byte at offset ", TO_WSTRING(i))
	).ToBe(expected := _LargeSource.Text[i]);
END_FOR
{analysis +175}

Assert.ThatDInt(
	actual := _LargeTarget.Marker,
	message := "Long text must preserve the adjacent field"
).ToBe(expected := 7);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{7a55faea-bf6a-41c7-abdc-1ced49bda4fb}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9377e973-dc46-494f-987b-94fc9008c97d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{d5f4cabc-92d9-4028-b14a-439e4a0b2e9d}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{74aadd43-3015-4627-8df9-5940a1686d06}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f4e2a300-008f-4241-bae6-36bb7fc64b73}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c30b0c7c-3493-4ac4-8945-f8981b915a92}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
