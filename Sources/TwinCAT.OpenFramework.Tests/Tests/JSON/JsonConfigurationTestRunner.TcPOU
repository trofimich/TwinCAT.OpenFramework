(*!
<summary>Runs the OpenFramework test groups registered by the shared test controller.</summary>
<description>
Owns persistent root instances and fixed child storage. The IO model group borrows the controller-owned fixture.
Includes the Core hysteresis boundary scenario. Use from one task without reentry.
Children borrows the same array for the instance lifetime. Root parents remain zero.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK JsonConfigurationTestRunner EXTENDS TOF_Testing.TestRunner<48>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
	//! <summary>Stable interface storage borrowed by the IO model group.</summary>
	_IOModelsFixture : IIOModelsTestFixture;

	//! <summary>Owned root test suite for writer operations.</summary>
	_WriterTest : JsonConfigurationWriterTest(name := "JsonConfigurationWriterTest", parent := 0);
	//! <summary>Owned root test suite for reader operations.</summary>
	_ReaderTest : JsonConfigurationReaderTest(name := "JsonConfigurationReaderTest", parent := 0);
	//! <summary>Owned root test suite for round-trip serialization.</summary>
	_RoundTripTest : JsonConfigurationRoundTripTest(name := "JsonConfigurationRoundTripTest", parent := 0);
	//! <summary>Owned root group for analog range conversions.</summary>
	_RangeConverterTest : RangeAnalogValueConverterTest(name := "RangeAnalogValueConverterTest", parent := 0);
	//! <summary>Checks the two-cycle restart of an active timer.</summary>
	_TimerRestartTest : TimerRestartWhileRunningTest(name := "RestartWhileRunning", parent := 0);
	//! <summary>Exercises failure to open a missing file for reading in an owned directory.</summary>
	_MissingFileTest : OpenMissingFileForReadingTest(name := "OpenMissingFileForReading", parent := 0);
	//! <summary>Checks lexical file and directory path rules without filesystem I/O.</summary>
	_PathValidationTest : LexicalPathValidationTest(name := "LexicalPathValidation", parent := 0);
	//! <summary>Groups the six filesystem contract tests that exercise no native I/O.</summary>
	_FileSystemTests : FileSystemContractTest(name := "FileSystemContractTest", parent := 0);
	//! <summary>Groups the three native directory lifecycle scenarios.</summary>
	_DirectoryTests : DirectoryTest(name := "DirectoryTest", parent := 0);
	//! <summary>Groups the four cyclic file-content manager scenarios.</summary>
	_FileContentTests : FileContentManagerOperationsTest(name := "FileContentManagerTest", parent := 0);
	//! <summary>Groups the three native filesystem integration scenarios.</summary>
	_FileSystemIntegrationTests : FileSystemIntegrationTestGroup(name := "FileSystemIntegrationTest", parent := 0);
	//! <summary>Groups the deterministic logger contracts and task-routing tests.</summary>
	_LoggerContractTests : LoggerContractTestGroup(name := "LoggerContractTest", parent := 0);
	//! <summary>Runs the native file and EventLogger integration cases.</summary>
	_LoggerIntegrationTests : LoggerIntegrationTestGroup(name := "LoggerTest", parent := 0);
	//! <summary>Groups the task lifecycle view and naming cases.</summary>
	_TaskLifecycleTests : TaskLifecycleViewsTestGroup(name := "TaskLifecycleViewsTest", parent := 0);
	//! <summary>Groups FIFO and empty-queue behavior.</summary>
	_TaskSequenceTests : TaskSequenceTestGroup(name := "TaskSequenceTest", parent := 0);
	//! <summary>Groups cooperative queue cleanup and failure cases.</summary>
	_TaskQueueCleanupTests : TaskQueueCleanupTestGroup(name := "TaskQueueCleanupTest", parent := 0);
	//! <summary>Groups timer timing, lifecycle and restart cases.</summary>
	_TimerTimingTests : TimerTimingTestGroup(name := "TimerTimingTest", parent := 0);
	//! <summary>Groups task stopping, failure and naming cases.</summary>
	_TaskStoppingTests : TaskStoppingTestGroup(name := "TaskStoppingTest", parent := 0);
	//! <summary>Groups concrete object disposal and address conversion cases.</summary>
	_ObjectLifetimeTests : ObjectLifetimeTestGroup(name := "ObjectLifetimeTest", parent := 0);
	//! <summary>Checks rising and falling hysteresis thresholds.</summary>
	_HysteresisTest : DeadbandHysteresisTest(name := "DeadbandHysteresisTest", parent := 0);
	//! <summary>Groups generic storage, ordering, conversion and runtime type diagnostics.</summary>
	_GenericValueTests : GenericValueTestGroup(name := "GenericValueTest", parent := 0);
	//! <summary>Checks the borrowed source and owned snapshot contracts of the Comparison predicates.</summary>
	_ComparisonPredicateContracts : ComparisonPredicateContractsTest(name := "ComparisonPredicateContracts", parent := 0);
	//! <summary>Checks catalogue text comparers at their documented storage boundary.</summary>
	_StandardTextComparison : StandardTextComparisonTest(name := "StandardTextComparison", parent := 0);
	//! <summary>Groups random range and dispersion contracts.</summary>
	_RandomTests : RandomTestGroup(name := "RandomTest", parent := 0);
	//! <summary>Groups exception transport, cloning, diagnostics and failure boundaries.</summary>
	_ExceptionTests : ExceptionTestGroup(name := "ExceptionTest", parent := 0);
	//! <summary>Groups byte-string formatting, editing, search and splitter contracts.</summary>
	_StringTests : StringsTestGroup(name := "StringsTest", parent := 0);
	//! <summary>Groups wide-string formatting, editing, search and splitter contracts.</summary>
	_WideStringTests : WideStringsTestGroup(name := "WideStringsTest", parent := 0);
	//! <summary>Groups byte-string builder assignment, reuse and failure contracts.</summary>
	_StringBuilderTests : StringBuilderTestGroup(name := "StringBuilderTest", parent := 0);
	//! <summary>Groups wide-string builder assignment, reuse and failure cases.</summary>
	_WideStringBuilderTests : WideStringBuilderTestGroup(name := "WideStringBuilderTest", parent := 0);
	//! <summary>Groups byte-list operations with dynamically allocated storage.</summary>
	_DynamicByteListTests : DynamicByteListTestGroup(name := "DynamicByteListTest", parent := 0);
	//! <summary>Groups fixed-capacity byte-list operations and overflow handling.</summary>
	_StaticByteListTests : StaticByteListTestGroup(name := "StaticByteListTest", parent := 0);
	//! <summary>Groups native JSON conversion, capacity, encoding and callback cases.</summary>
	_AutomaticJsonSerializerTests : AutomaticJsonSerializerTestGroup(name := "AutomaticJsonSerializerTest", parent := 0);
	//! <summary>Groups fixed-capacity queue lookup, FIFO, clear and overflow cases.</summary>
	_StaticQueueTests : StaticQueueTestGroup(name := "StaticQueueTest", parent := 0);
	//! <summary>Groups dynamic queue lookup, FIFO, growth and clear cases.</summary>
	_DynamicQueueTests : DynamicQueueTestGroup(name := "DynamicQueueTest", parent := 0);
	//! <summary>Groups dynamic dictionary lookup, update, removal and clear cases.</summary>
	_DynamicDictionaryTests : DynamicDictionaryTestGroup(name := "DynamicDictionaryTest", parent := 0);
	//! <summary>Groups fixed-capacity dictionary lookup, update, removal, clear and overflow cases.</summary>
	_StaticDictionaryTests : StaticDictionaryTestGroup(name := "StaticDictionaryTest", parent := 0);
	//! <summary>Groups dynamic set lookup, duplicate updates, removal and clear cases.</summary>
	_DynamicUniqueDataSetTests : DynamicUniqueDataSetTestGroup(name := "DynamicUniqueDataSetTest", parent := 0);
	//! <summary>Groups fixed-capacity set lookup, duplicate updates, removal, clear and overflow cases.</summary>
	_StaticUniqueDataSetTests : StaticUniqueDataSetTestGroup(name := "StaticUniqueDataSetTest", parent := 0);
	//! <summary>Groups dynamic list copying, borrowing, editing, search, sorting and clear cases.</summary>
	_DynamicListTests : DynamicListTestGroup(name := "DynamicListTest", parent := 0);
	//! <summary>Groups fixed-capacity list copying, borrowing, editing, search, sorting and overflow cases.</summary>
	_StaticListTests : StaticListTestGroup(name := "StaticListTest", parent := 0);
	//! <summary>Groups dynamic stack storage, LIFO order, cursors and ownership cases.</summary>
	_DynamicStackTests : DynamicStackTestGroup(name := "DynamicStackTest", parent := 0);
	//! <summary>Groups fixed-capacity stack storage, LIFO order, cursors, ownership and overflow cases.</summary>
	_StaticStackTests : StaticStackTestGroup(name := "StaticStackTest", parent := 0);
	//! <summary>Groups digital and analog device, simulated channel and conversion cases.</summary>
	_DevicesIOTests : DevicesIOTestGroup(name := "DevicesIOTest", parent := 0);
	//! <summary>Groups collection ownership, callback, growth and enumeration scenarios.</summary>
	_CollectionsContractTests : CollectionsContractTestGroup(name := "CollectionsContractTest", parent := 0);
	//! <summary>Groups PDO representation and simulated input binding scenarios.</summary>
	_IOModelsTests : IOModelsTestGroup(name := "IOModelsTest", parent := 0, fixtureSlot := ADR(_IOModelsFixture));
	//! <summary>Groups workflow integration, comparison and variable-scope scenarios.</summary>
	_WorkflowComprehensiveTests : WorkflowComprehensiveTestGroup(name := "WorkflowComprehensiveTest", parent := 0);
	//! <summary>Groups workflow contracts and the cyclic delay timing regression.</summary>
	_WorkflowContractTests : WorkflowContractTestGroup(name := "WorkflowContractTest", parent := 0);
	//! <summary>Groups automation component contracts and observations from the dedicated runner task.</summary>
	_AutomationComponentTests : AutomationComponentTestGroup(name := "AutomationComponentTest", parent := 0);

	{attribute 'hide'}
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_WriterTest,
		_ReaderTest,
		_RoundTripTest,
		_RangeConverterTest,
		_TimerRestartTest,
		_MissingFileTest,
		_PathValidationTest,
		_FileSystemTests,
		_DirectoryTests,
		_FileContentTests,
		_FileSystemIntegrationTests,
		_LoggerContractTests,
		_LoggerIntegrationTests,
		_TaskLifecycleTests,
		_TaskSequenceTests,
		_TaskQueueCleanupTests,
		_TimerTimingTests,
		_TaskStoppingTests,
		_ObjectLifetimeTests,
		_HysteresisTest,
		_GenericValueTests,
		_ComparisonPredicateContracts,
		_StandardTextComparison,
		_RandomTests,
		_ExceptionTests,
		_StringTests,
		_WideStringTests,
		_StringBuilderTests,
		_WideStringBuilderTests,
		_DynamicByteListTests,
		_StaticByteListTests,
		_AutomaticJsonSerializerTests,
		_StaticQueueTests,
		_DynamicQueueTests,
		_DynamicDictionaryTests,
		_StaticDictionaryTests,
		_DynamicUniqueDataSetTests,
		_StaticUniqueDataSetTests,
		_DynamicListTests,
		_StaticListTests,
		_DynamicStackTests,
		_StaticStackTests,
		_DevicesIOTests,
		_CollectionsContractTests,
		_IOModelsTests,
		_WorkflowComprehensiveTests,
		_WorkflowContractTests,
		_AutomationComponentTests
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{a83b8d0d-6f01-4243-a28c-ccae384cb4c1}">
      <Declaration><![CDATA[(*!
<summary>Stores the controller-owned model fixture for the IO model group.</summary>
<description>Stores a borrow without invoking the fixture. The controller keeps it alive for all test runs.</description>
<param name="ioModelsFixture">Controller-owned model fixture declared before the runner.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	ioModelsFixture : IIOModelsTestFixture;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_IOModelsFixture := ioModelsFixture;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Children" Id="{31c7bfc8-0e68-4e3e-a176-58572bbcdaa1}">
      <Declaration><![CDATA[(*!
<summary>Borrows the unchanged persistent root array; application code must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{512b21ae-1365-4e94-a4cc-90a7092ed49b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{80c87378-a184-4f48-8fa4-8458bfb9bc53}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{37612fee-83d8-4ac2-aae0-486db11c1c15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{944543d8-d3b3-4c53-b852-c12c99129d33}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete namespace name for the instance lifetime; callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7340f8de-5251-4a6e-af92-3c555dabd6dc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{986cda70-ca4c-4ad3-bf14-98d5e09ecaf8}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c07881e0-fcd6-46ff-826a-c9dd1bdfd319}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>

