<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="JsonConfigurationTestRunner" Id="{6cc84da6-ca7e-4045-bc76-1f4d20ac227c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs the JSON configuration writer, reader and round-trip unit test suites.</summary>
<description>
Owns persistent root instances and fixed child storage. Use from one task without reentry.
Children borrows the same array for the instance lifetime. Root parents remain zero.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK JsonConfigurationTestRunner EXTENDS TOF_Testing.TestRunner<3>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete runner.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR_OUTPUT
	//! <summary>Owned root test suite for writer operations.</summary>
	WriterTest : JsonConfigurationWriterTest(name := "JsonConfigurationWriterTest", parent := 0);
	//! <summary>Owned root test suite for reader operations.</summary>
	ReaderTest : JsonConfigurationReaderTest(name := "JsonConfigurationReaderTest", parent := 0);
	//! <summary>Owned root test suite for round-trip serialization.</summary>
	RoundTripTest : JsonConfigurationRoundTripTest(name := "JsonConfigurationRoundTripTest", parent := 0);
END_VAR
VAR
	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		WriterTest,
		ReaderTest,
		RoundTripTest
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{31c7bfc8-0e68-4e3e-a176-58572bbcdaa1}">
      <Declaration><![CDATA[(*!
<summary>Borrows the unchanged persistent root array; application code must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{512b21ae-1365-4e94-a4cc-90a7092ed49b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{80c87378-a184-4f48-8fa4-8458bfb9bc53}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name; callers must not modify the returned storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{37612fee-83d8-4ac2-aae0-486db11c1c15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{944543d8-d3b3-4c53-b852-c12c99129d33}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete namespace name for the instance lifetime; callers must not modify it.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7340f8de-5251-4a6e-af92-3c555dabd6dc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= _NamespaceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{986cda70-ca4c-4ad3-bf14-98d5e09ecaf8}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c07881e0-fcd6-46ff-826a-c9dd1bdfd319}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>

