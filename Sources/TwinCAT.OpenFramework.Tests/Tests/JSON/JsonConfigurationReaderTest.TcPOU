<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="JsonConfigurationReaderTest" Id="{d3b4aca7-e376-4a5d-a77c-d659d7eed02c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Exercises JsonConfigurationReader document opening, member navigation and value reading error cases.

Verifies object root requirement, mandatory and optional field retrieval, list inspection, item bounds,
type and size mismatch detection, null rejection, buffer capacity checks, and repeated Open behavior.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK JsonConfigurationReaderTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR CONSTANT
	// HRESULT for invalid arguments used by JsonConfigurationReader diagnostics.
	_InvalidArgumentCode : UDINT := 16#80070057;
END_VAR
VAR
	_Reader : TOF_JSON.JsonConfigurationReader;
	_Mock : MockConfigurationWritable;
	_Doc : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{92afd0f2-fb47-4809-b6ef-dfc13ec32c72}">
      <Declaration><![CDATA[(* Borrows the concrete class name for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{25d2401d-2585-4234-9eec-1c8e9bcb47a8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{67721956-fd99-4d4c-b9f2-7e76d01ca4fc}">
      <Declaration><![CDATA[(* Executes reader scenarios including Unicode decoding and destination capacity in a single PLC cycle. *)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[testOpenObjectRoot();
testOpenNonObjectRoot();
testOpenInvalidJson();
testFieldExistingAndMissing();
testFieldOnNonObject();
testFindOptionalField();
testListOperations();
testReadValueValidationAndErrors();
testReadWideString();
testReparseReadsNewDocument();
testDeserializeContextFreeObject();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{87f06da3-491f-4214-bc4b-4b823ffc6357}">
      <Declaration><![CDATA[(* Borrows the compiler-initialized namespace for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c91bfb88-6101-4769-9bdf-f67152487581}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b997dedc-4da5-47c3-af8c-1810dd3cf17e}">
      <Declaration><![CDATA[(* Reports the complete concrete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e9bd6813-a087-4586-a6cf-bf22e450d774}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="testFieldExistingAndMissing" Id="{1882cb16-59af-4952-8201-e842009bc329}">
      <Declaration><![CDATA[(* Verifies mandatory field lookup and missing field exception. *)
METHOD PRIVATE testFieldExistingAndMissing
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	fieldNode : TOF_Core.CONFIGURATION_NODE;
	caughtMessage : WSTRING(255);
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"existing": 42}';
root := _Reader.Parse(document := _Doc);

fieldNode := _Reader.GetField(node := root, name := 'existing');
Assert.ThatBool(actual := _Reader.IsPresent(node := fieldNode)).IsTrue();

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	fieldNode := _Reader.GetField(node := root, name := 'missing');
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "GetField on a missing member"
).ToBe(expected := "Invalid JSON configuration: missing field (field: missing)");]]></ST>
      </Implementation>
    </Method>
    <Method Name="testFieldOnNonObject" Id="{21c6c8e5-1f31-4f9e-b65d-43a7321a2b3e}">
      <Declaration><![CDATA[(* Verifies that Field on a non-object parent raises not an object. *)
METHOD PRIVATE testFieldOnNonObject
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	scalarNode : TOF_Core.CONFIGURATION_NODE;
	childNode : TOF_Core.CONFIGURATION_NODE;
	caughtMessage : WSTRING(255);
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"scalar": 42}';
root := _Reader.Parse(document := _Doc);
scalarNode := _Reader.GetField(node := root, name := 'scalar');

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	childNode := _Reader.GetField(node := scalarNode, name := 'child');
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "GetField on a scalar"
).ToBe(expected := "Invalid JSON configuration: not an object (field: child)");]]></ST>
      </Implementation>
    </Method>
    <Method Name="testListOperations" Id="{dc3ff508-9226-494a-a702-a5d11a4a2c9a}">
      <Declaration><![CDATA[(* Verifies IsList, Count, Item bounds and non-list error detection. *)
METHOD PRIVATE testListOperations
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	listNode : TOF_Core.CONFIGURATION_NODE;
	objNode : TOF_Core.CONFIGURATION_NODE;
	item0 : TOF_Core.CONFIGURATION_NODE;
	item2 : TOF_Core.CONFIGURATION_NODE;
	itemBad : TOF_Core.CONFIGURATION_NODE;
	countVal : UDINT;
	caughtMessage : WSTRING(255);
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"list": [10, 20, 30], "obj": {"x": 1}}';
root := _Reader.Parse(document := _Doc);

listNode := _Reader.GetField(node := root, name := 'list');
Assert.ThatBool(actual := _Reader.IsArray(node := listNode)).IsTrue();
Assert.ThatUDInt(actual := _Reader.GetArraySize(node := listNode)).ToBe(expected := 3);

item0 := _Reader.GetItem(node := listNode, index := 0);
Assert.ThatBool(actual := _Reader.IsPresent(node := item0)).IsTrue();

item2 := _Reader.GetItem(node := listNode, index := 2);
Assert.ThatBool(actual := _Reader.IsPresent(node := item2)).IsTrue();

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	itemBad := _Reader.GetItem(node := listNode, index := 3);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "GetItem at the array length"
).ToBe(expected := "Invalid JSON configuration: index out of range");

objNode := _Reader.GetField(node := root, name := 'obj');
Assert.ThatBool(actual := _Reader.IsArray(node := objNode)).IsFalse();

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	countVal := _Reader.GetArraySize(node := objNode);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "GetArraySize on an object"
).ToBe(expected := "Invalid JSON configuration: not an array");

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	itemBad := _Reader.GetItem(node := objNode, index := 0);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "GetItem on an object"
).ToBe(expected := "Invalid JSON configuration: not an array");]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOpenInvalidJson" Id="{2b4e1c79-8499-4416-8bb3-c230d976c1c6}">
      <Declaration><![CDATA[(* Verifies that Open raises parse failure on malformed JSON text. *)
METHOD PRIVATE testOpenInvalidJson
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	caughtMessage : WSTRING(255);
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{unclosed object';

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	root := _Reader.Parse(document := _Doc);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "Parse malformed JSON"
).ToBe(expected := "Invalid JSON configuration: parse failure");]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOpenNonObjectRoot" Id="{66a12c3f-811a-4227-9990-83fc8e6c85fe}">
      <Declaration><![CDATA[(* Verifies that Open rejects array or primitive roots. *)
METHOD PRIVATE testOpenNonObjectRoot
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	caughtMessage : WSTRING(255);
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '[1, 2, 3]';

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	root := _Reader.Parse(document := _Doc);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "Parse an array root"
).ToBe(expected := "Invalid JSON configuration: not an object");

_Doc := '12345';

caughtMessage := TOF_Core.WideStrings.Empty;

__TRY
	root := _Reader.Parse(document := _Doc);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(
	actual := caughtMessage,
	message := "Parse a scalar root"
).ToBe(expected := "Invalid JSON configuration: not an object");]]></ST>
      </Implementation>
    </Method>
    <Method Name="testOpenObjectRoot" Id="{e8380616-e75f-4125-b106-f8b807100827}">
      <Declaration><![CDATA[(* Verifies successful document open with an object root. *)
METHOD PRIVATE testOpenObjectRoot
VAR
	root : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"key": 123}';
root := _Reader.Parse(document := _Doc);

Assert.ThatBool(actual := _Reader.IsPresent(node := root)).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testReadValueValidationAndErrors" Id="{2a5b9cc7-0138-44b4-8b7c-88b4aeb8a5a3}">
      <Declaration><![CDATA[(* Verifies destination validation, shape checking, type mismatch and capacity errors in ReadValue. *)
METHOD PRIVATE testReadValueValidationAndErrors
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	numNode : TOF_Core.CONFIGURATION_NODE;
	strNode : TOF_Core.CONFIGURATION_NODE;
	nullNode : TOF_Core.CONFIGURATION_NODE;
	arrNode : TOF_Core.CONFIGURATION_NODE;
	objNode : TOF_Core.CONFIGURATION_NODE;
	emptyNode : TOF_Core.CONFIGURATION_NODE;
	dstDint : DINT;
	dstStr : STRING(80);
	tinyStr : STRING(2);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"num": 42, "str": "hello world", "nullVal": null, "arr": [1], "obj": {}}';
root := _Reader.Parse(document := _Doc);
numNode := _Reader.GetField(node := root, name := 'num');
strNode := _Reader.GetField(node := root, name := 'str');
nullNode := _Reader.GetField(node := root, name := 'nullVal');
arrNode := _Reader.GetField(node := root, name := 'arr');
objNode := _Reader.GetField(node := root, name := 'obj');

expectReadValueFailure(
	node := numNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := 0,
	size := 4,
	message := "ReadValue with a null destination",
	expected := "Invalid JSON configuration: type/size mismatch"
);

expectReadValueFailure(
	node := numNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dstDint),
	size := 0,
	message := "ReadValue with zero destination size",
	expected := "Invalid JSON configuration: type/size mismatch"
);

expectReadValueFailure(
	node := emptyNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dstDint),
	size := 4,
	message := "ReadValue with an absent node",
	expected := "Invalid JSON configuration: missing field"
);

expectReadValueFailure(
	node := nullNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dstDint),
	size := 4,
	message := "ReadValue on a null value",
	expected := "Invalid JSON configuration: type/size mismatch"
);

expectReadValueFailure(
	node := arrNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dstDint),
	size := 4,
	message := "ReadValue on an array",
	expected := "Invalid JSON configuration: type/size mismatch"
);

expectReadValueFailure(
	node := objNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dstDint),
	size := 4,
	message := "ReadValue on an object",
	expected := "Invalid JSON configuration: type/size mismatch"
);

expectReadValueFailure(
	node := numNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dstDint),
	size := 3,
	message := "ReadValue with the wrong DINT size",
	expected := "Invalid JSON configuration: type/size mismatch"
);

// SA0175: ReadValue targets a raw string buffer; no character indexing is performed.
{analysis -175}
expectReadValueFailure(
	node := numNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(dstStr),
	size := SIZEOF(dstStr),
	message := "ReadValue into STRING from a number",
	expected := "Invalid JSON configuration: type/size mismatch"
);

expectReadValueFailure(
	node := strNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(tinyStr),
	size := SIZEOF(tinyStr),
	message := "ReadValue into an undersized string buffer",
	expected := "Invalid JSON configuration: CopyString failed for STRING(2) (3 destination bytes)"
);
{analysis +175}]]></ST>
      </Implementation>
    </Method>
    <Method Name="testReadWideString" Id="{dfe3844a-c91c-4b0d-bcc1-e5f7e1dbc7d0}">
      <Declaration><![CDATA[(*
Checks empty and ASCII WSTRING values, exact-fit Unicode decoding, and distinguishes a null escape from literal backslash text.
*)
METHOD PRIVATE testReadWideString
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	unicodeNode : TOF_Core.CONFIGURATION_NODE;
	wideText : WSTRING(2);
	shortText : WSTRING(1) := "X";
	literalText : WSTRING(6);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"name":"AB","emptyName":"","unicode":"\u00e9\u0416","withNull":"A\u0000B","literal":"\\u0000"}';
root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'name'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wideText),
	size := SIZEOF(wideText)
);
Assert.ThatWideString(actual := wideText, message := "Read an ASCII name").ToBe(expected := "AB");

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'emptyName'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wideText),
	size := SIZEOF(wideText)
);
Assert.ThatWideString(actual := wideText, message := "An empty name clears the previous value").ToBe(expected := "");

unicodeNode := _Reader.GetField(node := root, name := 'unicode');

_Reader.ReadValue(
	node := unicodeNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wideText),
	size := SIZEOF(wideText)
);
Assert.ThatWideString(actual := wideText, message := "Decode two Unicode characters into two wide slots").ToBe(
	expected := "$00E9$0416"
);

expectReadValueFailure(
	node := unicodeNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(shortText),
	size := SIZEOF(shortText),
	message := "Reject a WSTRING destination with room for only one character",
	expected := "Invalid JSON configuration: WSTRING needs 2 characters, capacity 1"
);
Assert.ThatWideString(actual := shortText, message := "Capacity failure must precede conversion").ToBe(expected := "X");

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'literal'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(literalText),
	size := SIZEOF(literalText)
);
Assert.ThatWideString(actual := literalText, message := "Preserve a literal backslash").ToBe(expected := "\u0000");

expectReadValueFailure(
	node := _Reader.GetField(node := root, name := 'withNull'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wideText),
	size := SIZEOF(wideText),
	message := "Reject embedded null in JSON string",
	expected := "Invalid JSON configuration: parse failure"
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testReparseReadsNewDocument" Id="{c38aada2-fc95-494a-baf4-fd4fb3bd8af5}">
      <Declaration><![CDATA[(* Verifies that a new document can be parsed and read using newly obtained cursors. *)
METHOD PRIVATE testReparseReadsNewDocument
VAR
	root1 : TOF_Core.CONFIGURATION_NODE;
	root2 : TOF_Core.CONFIGURATION_NODE;
	nodeVal : TOF_Core.CONFIGURATION_NODE;
	val : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"id": 1}';
root1 := _Reader.Parse(document := _Doc);
nodeVal := _Reader.GetField(node := root1, name := 'id');
_Reader.ReadValue(
	node := nodeVal,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(val),
	size := SIZEOF(val)
);
Assert.ThatDInt(actual := val).ToBe(expected := 1);

_Doc := '{"id": 2}';
root2 := _Reader.Parse(document := _Doc);
nodeVal := _Reader.GetField(node := root2, name := 'id');
_Reader.ReadValue(
	node := nodeVal,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(val),
	size := SIZEOF(val)
);
Assert.ThatDInt(actual := val).ToBe(expected := 2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testFindOptionalField" Id="{a3b81e6d-75c9-418a-882a-2c19667c2318}">
      <Declaration><![CDATA[(* Verifies that FindField returns an empty node for absent members and non-object parents. *)
METHOD PRIVATE testFindOptionalField
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	fieldNode : TOF_Core.CONFIGURATION_NODE;
	missingNode : TOF_Core.CONFIGURATION_NODE;
	emptyParent : TOF_Core.CONFIGURATION_NODE;
	fieldOnEmpty : TOF_Core.CONFIGURATION_NODE;
	fieldOnScalar : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Doc := '{"present": 10}';
root := _Reader.Parse(document := _Doc);

fieldNode := _Reader.FindField(node := root, name := 'present');
Assert.ThatBool(actual := _Reader.IsPresent(node := fieldNode)).IsTrue();

missingNode := _Reader.FindField(node := root, name := 'absent');
Assert.ThatBool(actual := _Reader.IsPresent(node := missingNode)).IsFalse();

fieldOnEmpty := _Reader.FindField(node := emptyParent, name := 'any');
Assert.ThatBool(actual := _Reader.IsPresent(node := fieldOnEmpty)).IsFalse();

fieldOnScalar := _Reader.FindField(node := fieldNode, name := 'any');
Assert.ThatBool(
	actual := _Reader.IsPresent(node := fieldOnScalar),
	message := "FindField on a scalar must return an empty node"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="expectReadValueFailure" Id="{ede799eb-6e83-4de6-82c3-18ad173aeb72}">
      <Declaration><![CDATA[(*
Invokes ReadValue with one invalid input and compares the resulting reader diagnostic.

A valid return or a different exception fails the named scenario.
*)
METHOD PRIVATE expectReadValueFailure
VAR_INPUT
	node : TOF_Core.CONFIGURATION_NODE;
	valueType : TOF_Core.CONFIGURATION_VALUE_TYPE;
	data : PVOID;
	size : UDINT;
	message : WSTRING(255);
	expected : WSTRING(255);
END_VAR
VAR
	caughtMessage : WSTRING(255);
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	_Reader.ReadValue(node := node, valueType := valueType, data := data, size := size);
__CATCH(exceptionCode)
	caughtMessage := getInvalidDocumentMessage(
		exceptionCode := exceptionCode,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatWideString(actual := caughtMessage, message := message).ToBe(expected := expected);]]></ST>
      </Implementation>
    </Method>
    <Method Name="getInvalidDocumentMessage" Id="{a65af4da-1538-429f-a3e1-55aa391daf6b}">
      <Declaration><![CDATA[(*
Copies the structured invalid-argument diagnostic from the active catch.

Unexpected payloads yield a diagnostic that cannot match a valid reader error.
*)
METHOD PRIVATE getInvalidDocumentMessage : WSTRING(255)
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	catchPointPOUName : STRING;
	catchPointPosition : STRING;
END_VAR
VAR
	exception : TOF_Core.IException;
	generalException : TOF_Core.IGeneralException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := exceptionCode,
	catchPointNamespaceName := NamespaceName,
	catchPointPOUName := catchPointPOUName,
	catchPointPosition := catchPointPosition
);

IF exception <> 0 AND_THEN __QUERYINTERFACE(exception, generalException) THEN
	IF generalException.ErrorCode = _InvalidArgumentCode THEN
		getInvalidDocumentMessage := generalException.SourceMessage;
		RETURN;
	END_IF
END_IF

IF exception = 0 THEN
	getInvalidDocumentMessage := "No exception payload";
ELSE
	getInvalidDocumentMessage := TOF_Core.WideStrings.ConcatFit255("Unexpected exception: ", exception.GetMessage());
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDeserializeContextFreeObject" Id="{16157275-0ae9-47a7-8250-4fd46dbd539e}">
      <Declaration><![CDATA[(* Verifies that a context-free object deserializes successfully with null deserialization context. *)
METHOD PRIVATE testDeserializeContextFreeObject
VAR
	root : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Mock.Reset();
_Doc := '{"intField":123,"stringField":"test context-free"}';
root := _Reader.Parse(document := _Doc);
_Mock.Deserialize(reader := _Reader, node := root, context := 0);

Assert.ThatUDInt(actual := _Mock.DeserializeCount).ToBe(expected := 1);
Assert.ThatDInt(actual := _Mock.IntField).ToBe(expected := 123);
Assert.ThatString(actual := _Mock.StringField).ToBe(expected := 'test context-free');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

