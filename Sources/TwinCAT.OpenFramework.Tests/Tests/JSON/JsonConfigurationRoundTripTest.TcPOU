<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="JsonConfigurationRoundTripTest" Id="{9a71ef2c-3084-4f2b-bf09-748e32c90d64}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Exercises full configuration round-trip for all 25 CONFIGURATION_VALUE_TYPE values.

Verifies serialization and deserialization symmetry across boundary values of all integer, bitstring,
floating-point, string, wide string and date/time types, as well as nested objects, lists, and empty strings.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK JsonConfigurationRoundTripTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR
	_Writer : TOF_JSON.JsonConfigurationWriter;
	_Reader : TOF_JSON.JsonConfigurationReader;
	_Dom : Tc3_JsonXml.FB_JsonDomParser;
	_ReferenceConverter : Tc3_JsonXml.FB_JsonReadWriteDataType;
	_Doc : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{cb6c9a4c-21cf-4edc-9718-28031683afc4}">
      <Declaration><![CDATA[(* Borrows the concrete class name for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{218d3d68-0dda-4b3c-85a9-78cb71ee6bc4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{0a32637e-d145-4674-8324-a88fe370c6a2}">
      <Declaration><![CDATA[(* Exercises JSON round trips for elementary values and nested objects and arrays. *)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[testIntegerTypesRoundTrip();
testBitStringTypesRoundTrip();
testFloatTypesRoundTrip();
testStringsRoundTrip();
testWideStringsRoundTrip();
testDateTimeTypesRoundTrip();
testStructuralRoundTrip();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{a081367f-8275-4a98-9be0-84e0cb5e2bdd}">
      <Declaration><![CDATA[(* Borrows the compiler-initialized namespace for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{43e50e28-cfcd-408c-8e09-1447038eb6cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{70a23710-9bd3-4134-8b9a-99c615d6e26e}">
      <Declaration><![CDATA[(* Reports the complete concrete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a0ae4f80-0083-4a92-a65c-d1292cf9e2d9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="testBitStringTypesRoundTrip" Id="{564f10df-d93d-4ca3-a10f-1ddf04437a9f}">
      <Declaration><![CDATA[(* Verifies round-trip serialization of BOOL, BYTE, WORD, DWORD and LWORD bitstring types. *)
METHOD PRIVATE testBitStringTypesRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	boolTrue : BOOL := TRUE;
	boolFalse : BOOL := FALSE;
	byteVal : BYTE := 16#AB;
	wordVal : WORD := 16#ABCD;
	dwordVal : DWORD := 16#12345678;
	lwordVal : LWORD := 16#0123456789ABCDEF;
	boolDst : BOOL;
	byteDst : BYTE;
	wordDst : WORD;
	dwordDst : DWORD;
	lwordDst : LWORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();
_Writer.WriteValue(
	name := 'bTrue',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(boolTrue),
	size := SIZEOF(boolTrue)
);
_Writer.WriteValue(
	name := 'bFalse',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(boolFalse),
	size := SIZEOF(boolFalse)
);
_Writer.WriteValue(
	name := 'byteV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BYTE,
	data := ADR(byteVal),
	size := SIZEOF(byteVal)
);
_Writer.WriteValue(
	name := 'wordV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WORD,
	data := ADR(wordVal),
	size := SIZEOF(wordVal)
);
_Writer.WriteValue(
	name := 'dwordV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DWORD,
	data := ADR(dwordVal),
	size := SIZEOF(dwordVal)
);
_Writer.WriteValue(
	name := 'lwordV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LWORD,
	data := ADR(lwordVal),
	size := SIZEOF(lwordVal)
);
_Writer.EndDocument(document := _Doc);

root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'bTrue'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(boolDst),
	size := SIZEOF(boolDst)
);
Assert.ThatBool(actual := boolDst).IsTrue();

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'bFalse'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(boolDst),
	size := SIZEOF(boolDst)
);
Assert.ThatBool(actual := boolDst).IsFalse();

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'byteV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BYTE,
	data := ADR(byteDst),
	size := SIZEOF(byteDst)
);
Assert.ThatByte(actual := byteDst).ToBe(expected := 16#AB);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'wordV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WORD,
	data := ADR(wordDst),
	size := SIZEOF(wordDst)
);
Assert.ThatWord(actual := wordDst).ToBe(expected := 16#ABCD);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'dwordV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DWORD,
	data := ADR(dwordDst),
	size := SIZEOF(dwordDst)
);
Assert.ThatDWord(actual := dwordDst).ToBe(expected := 16#12345678);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'lwordV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LWORD,
	data := ADR(lwordDst),
	size := SIZEOF(lwordDst)
);
Assert.ThatLWord(actual := lwordDst).ToBe(expected := 16#0123456789ABCDEF);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDateTimeTypesRoundTrip" Id="{f47258fd-2ce2-4fc0-a0d2-15310dea42d1}">
      <Declaration><![CDATA[(* Verifies round-trip serialization of eight time types and compares LTIME with direct native serialization. *)
METHOD PRIVATE testDateTimeTypesRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	domRoot : Tc3_JsonXml.SJsonValue;
	serializedTime : Tc3_JsonXml.SJsonValue;
	referenceJson : STRING(255);
	referenceSize : UDINT;
	actualJson : STRING(255);
	timeVal : TIME := T#49D17H2M47S295MS;
	ltimeVal : LTIME := LTIME#100D12H30M15S;
	dateVal : DATE := D#2026-11-09;
	ldateVal : LDATE := LDATE#2026-11-09;
	todVal : TOD := TOD#14:30:15.500;
	ltodVal : LTOD := LTOD#14:30:15.123456789;
	dtVal : DT := DT#2026-11-09-14:30:15;
	ldtVal : LDT := LDT#2026-11-09-14:30:15.123456789;
	timeDst : TIME;
	ltimeDst : LTIME;
	dateDst : DATE;
	ldateDst : LDATE;
	todDst : TOD;
	ltodDst : LTOD;
	dtDst : DT;
	ldtDst : LDT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();
_Writer.WriteValue(
	name := 'timeV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TIME,
	data := ADR(timeVal),
	size := SIZEOF(timeVal)
);
_Writer.WriteValue(
	name := 'ltimeV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTIME,
	data := ADR(ltimeVal),
	size := SIZEOF(ltimeVal)
);
_Writer.WriteValue(
	name := 'dateV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DATE,
	data := ADR(dateVal),
	size := SIZEOF(dateVal)
);
_Writer.WriteValue(
	name := 'ldateV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDATE,
	data := ADR(ldateVal),
	size := SIZEOF(ldateVal)
);
_Writer.WriteValue(
	name := 'todV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TOD,
	data := ADR(todVal),
	size := SIZEOF(todVal)
);
_Writer.WriteValue(
	name := 'ltodV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTOD,
	data := ADR(ltodVal),
	size := SIZEOF(ltodVal)
);
_Writer.WriteValue(
	name := 'dtV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DT,
	data := ADR(dtVal),
	size := SIZEOF(dtVal)
);
_Writer.WriteValue(
	name := 'ldtV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDT,
	data := ADR(ldtVal),
	size := SIZEOF(ldtVal)
);
_Writer.EndDocument(document := _Doc);

referenceSize := SIZEOF(referenceJson);

// SA0175: GetJsonFromSymbol writes to the string buffer using its size in bytes.
{analysis -175}
IF NOT _ReferenceConverter.GetJsonFromSymbol(
	sDatatype := 'LTIME',
	nData := SIZEOF(ltimeVal),
	pData := ADR(ltimeVal),
	nJson := referenceSize,
	pJson := ADR(referenceJson)
) THEN
	RecordFailure(message := "Native LTIME reference serialization failed");
	RETURN;
END_IF
{analysis +175}

domRoot := _Dom.ParseDocument(sJson := _Doc);

IF domRoot = 0 OR_ELSE NOT _Dom.IsObject(v := domRoot) THEN
	RecordFailure(message := "Serialized temporal values must form a JSON object");
	RETURN;
END_IF

serializedTime := _Dom.FindMember(v := domRoot, member := 'ltimeV');

IF serializedTime = 0 THEN
	RecordFailure(message := "The serialized document must contain ltimeV");
	RETURN;
END_IF

IF _Dom.CopyJson(v := serializedTime, pDoc := actualJson, nDoc := SIZEOF(actualJson)) = 0 THEN
	RecordFailure(message := "Could not read the serialized ltimeV JSON value");
	RETURN;
END_IF

Assert.ThatString(actual := actualJson, message := "LTIME JSON must match its native representation").ToBe(
	expected := referenceJson
);

root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'timeV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TIME,
	data := ADR(timeDst),
	size := SIZEOF(timeDst)
);
Assert.ThatTime(actual := timeDst).ToBe(expected := timeVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'ltimeV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTIME,
	data := ADR(ltimeDst),
	size := SIZEOF(ltimeDst)
);
Assert.ThatLongTime(actual := ltimeDst).ToBe(expected := ltimeVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'dateV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DATE,
	data := ADR(dateDst),
	size := SIZEOF(dateDst)
);
Assert.ThatDate(actual := dateDst).ToBe(expected := dateVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'ldateV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDATE,
	data := ADR(ldateDst),
	size := SIZEOF(ldateDst)
);
Assert.ThatLongDate(actual := ldateDst).ToBe(expected := ldateVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'todV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TOD,
	data := ADR(todDst),
	size := SIZEOF(todDst)
);
Assert.ThatTimeOfDay(actual := todDst).ToBe(expected := todVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'ltodV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTOD,
	data := ADR(ltodDst),
	size := SIZEOF(ltodDst)
);
Assert.ThatLongTimeOfDay(actual := ltodDst).ToBe(expected := ltodVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'dtV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DT,
	data := ADR(dtDst),
	size := SIZEOF(dtDst)
);
Assert.ThatDateTime(actual := dtDst).ToBe(expected := dtVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'ldtV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDT,
	data := ADR(ldtDst),
	size := SIZEOF(ldtDst)
);
Assert.ThatLongDateTime(actual := ldtDst).ToBe(expected := ldtVal);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testFloatTypesRoundTrip" Id="{df0f079b-d511-45d3-bd01-5ba53464c71c}">
      <Declaration><![CDATA[(* Verifies round-trip serialization of REAL and LREAL floating point types within tolerance. *)
METHOD PRIVATE testFloatTypesRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	realPos : REAL := 123.456;
	realNeg : REAL := -123.456;
	lrealPos : LREAL := 987654.3210123;
	lrealNeg : LREAL := -987654.3210123;
	realDst : REAL;
	lrealDst : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();
_Writer.WriteValue(
	name := 'rPos',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	data := ADR(realPos),
	size := SIZEOF(realPos)
);
_Writer.WriteValue(
	name := 'rNeg',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	data := ADR(realNeg),
	size := SIZEOF(realNeg)
);
_Writer.WriteValue(
	name := 'lrPos',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LREAL,
	data := ADR(lrealPos),
	size := SIZEOF(lrealPos)
);
_Writer.WriteValue(
	name := 'lrNeg',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LREAL,
	data := ADR(lrealNeg),
	size := SIZEOF(lrealNeg)
);
_Writer.EndDocument(document := _Doc);

root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'rPos'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	data := ADR(realDst),
	size := SIZEOF(realDst)
);
Assert.ThatReal(actual := realDst).ToBe(expected := 123.456, tolerance := 0.01);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'rNeg'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	data := ADR(realDst),
	size := SIZEOF(realDst)
);
Assert.ThatReal(actual := realDst).ToBe(expected := -123.456, tolerance := 0.01);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'lrPos'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LREAL,
	data := ADR(lrealDst),
	size := SIZEOF(lrealDst)
);
Assert.ThatLongReal(actual := lrealDst).ToBe(expected := 987654.3210123, tolerance := 0.0001);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'lrNeg'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LREAL,
	data := ADR(lrealDst),
	size := SIZEOF(lrealDst)
);
Assert.ThatLongReal(actual := lrealDst).ToBe(expected := -987654.3210123, tolerance := 0.0001);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testIntegerTypesRoundTrip" Id="{dfee5b7b-a695-4f81-a109-2b869c651bc0}">
      <Declaration><![CDATA[(* Verifies round-trip and exact JSON numeric values at representative signed and unsigned integer boundaries. *)
METHOD PRIVATE testIntegerTypesRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	domRoot : Tc3_JsonXml.SJsonValue;
	number : Tc3_JsonXml.SJsonValue;
	sintMin : SINT := -128;
	sintMax : SINT := 127;
	usintMax : USINT := 255;
	intMin : INT := -32768;
	intMax : INT := 32767;
	uintMax : UINT := 65535;
	dintMin : DINT := -2147483648;
	dintMax : DINT := 2147483647;
	udintMax : UDINT := 4294967295;
	lintVal : LINT := -9223372036854775807;
	ulintVal : ULINT := 18446744073709551615;
	sintDst : SINT;
	usintDst : USINT;
	intDst : INT;
	uintDst : UINT;
	dintDst : DINT;
	udintDst : UDINT;
	lintDst : LINT;
	ulintDst : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();
_Writer.WriteValue(
	name := 'sintMin',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_SINT,
	data := ADR(sintMin),
	size := SIZEOF(sintMin)
);
_Writer.WriteValue(
	name := 'sintMax',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_SINT,
	data := ADR(sintMax),
	size := SIZEOF(sintMax)
);
_Writer.WriteValue(
	name := 'usintMax',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_USINT,
	data := ADR(usintMax),
	size := SIZEOF(usintMax)
);
_Writer.WriteValue(
	name := 'intMin',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_INT,
	data := ADR(intMin),
	size := SIZEOF(intMin)
);
_Writer.WriteValue(
	name := 'intMax',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_INT,
	data := ADR(intMax),
	size := SIZEOF(intMax)
);
_Writer.WriteValue(
	name := 'uintMax',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UINT,
	data := ADR(uintMax),
	size := SIZEOF(uintMax)
);
_Writer.WriteValue(
	name := 'dintMin',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dintMin),
	size := SIZEOF(dintMin)
);
_Writer.WriteValue(
	name := 'dintMax',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dintMax),
	size := SIZEOF(dintMax)
);
_Writer.WriteValue(
	name := 'udintMax',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UDINT,
	data := ADR(udintMax),
	size := SIZEOF(udintMax)
);
_Writer.WriteValue(
	name := 'lintV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LINT,
	data := ADR(lintVal),
	size := SIZEOF(lintVal)
);
_Writer.WriteValue(
	name := 'ulintV',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_ULINT,
	data := ADR(ulintVal),
	size := SIZEOF(ulintVal)
);
_Writer.EndDocument(document := _Doc);

domRoot := _Dom.ParseDocument(sJson := _Doc);

IF domRoot = 0 OR_ELSE NOT _Dom.IsObject(v := domRoot) THEN
	RecordFailure(message := "Serialized integer values must form a JSON object");
	RETURN;
END_IF

number := _Dom.FindMember(v := domRoot, member := 'lintV');

IF number = 0 OR_ELSE NOT _Dom.IsInt64(v := number) THEN
	RecordFailure(message := "lintV must remain a signed 64-bit JSON integer");
	RETURN;
END_IF

Assert.ThatLInt(actual := _Dom.GetInt64(v := number), message := "Signed 64-bit JSON value").ToBe(
	expected := lintVal
);

number := _Dom.FindMember(v := domRoot, member := 'ulintV');

IF number = 0 OR_ELSE NOT _Dom.IsUint64(v := number) THEN
	RecordFailure(message := "ulintV must remain an unsigned 64-bit JSON integer");
	RETURN;
END_IF

Assert.ThatULInt(actual := _Dom.GetUint64(v := number), message := "Unsigned 64-bit JSON value").ToBe(
	expected := ulintVal
);

root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'sintMin'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_SINT,
	data := ADR(sintDst),
	size := SIZEOF(sintDst)
);
Assert.ThatSInt(actual := sintDst).ToBe(expected := -128);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'sintMax'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_SINT,
	data := ADR(sintDst),
	size := SIZEOF(sintDst)
);
Assert.ThatSInt(actual := sintDst).ToBe(expected := 127);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'usintMax'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_USINT,
	data := ADR(usintDst),
	size := SIZEOF(usintDst)
);
Assert.ThatUSInt(actual := usintDst).ToBe(expected := 255);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'intMin'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_INT,
	data := ADR(intDst),
	size := SIZEOF(intDst)
);
Assert.ThatInt(actual := intDst).ToBe(expected := -32768);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'intMax'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_INT,
	data := ADR(intDst),
	size := SIZEOF(intDst)
);
Assert.ThatInt(actual := intDst).ToBe(expected := 32767);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'uintMax'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UINT,
	data := ADR(uintDst),
	size := SIZEOF(uintDst)
);
Assert.ThatUInt(actual := uintDst).ToBe(expected := 65535);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'dintMin'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dintDst),
	size := SIZEOF(dintDst)
);
Assert.ThatDInt(actual := dintDst).ToBe(expected := -2147483648);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'dintMax'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(dintDst),
	size := SIZEOF(dintDst)
);
Assert.ThatDInt(actual := dintDst).ToBe(expected := 2147483647);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'udintMax'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UDINT,
	data := ADR(udintDst),
	size := SIZEOF(udintDst)
);
Assert.ThatUDInt(actual := udintDst).ToBe(expected := 4294967295);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'lintV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LINT,
	data := ADR(lintDst),
	size := SIZEOF(lintDst)
);
Assert.ThatLInt(actual := lintDst).ToBe(expected := lintVal);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'ulintV'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_ULINT,
	data := ADR(ulintDst),
	size := SIZEOF(ulintDst)
);
Assert.ThatULInt(actual := ulintDst).ToBe(expected := ulintVal);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStringsRoundTrip" Id="{0dcf39fc-2978-4e69-899d-2e1673bfce2e}">
      <Declaration><![CDATA[(* Verifies empty and escaped strings using a literal JSON fixture and native DOM decoding. *)
METHOD PRIVATE testStringsRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	domRoot : Tc3_JsonXml.SJsonValue;
	escapedValue : Tc3_JsonXml.SJsonValue;
	emptySrc : STRING(80) := '';
	regSrc : STRING(80) := 'Hello Structured World';
	escapeSrc : STRING(80) := 'Line1$NLine2$T"Quoted"\';
	strDst : STRING(80) := 'initial';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// SA0175: Raw string buffer binding for JSON round-trip tests; no character indexing.
{analysis -175}
_Writer.BeginDocument();
_Writer.WriteValue(
	name := 'emptyStr',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(emptySrc),
	size := SIZEOF(emptySrc)
);
_Writer.WriteValue(
	name := 'regStr',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(regSrc),
	size := SIZEOF(regSrc)
);
_Writer.WriteValue(
	name := 'escapeStr',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(escapeSrc),
	size := SIZEOF(escapeSrc)
);
_Writer.EndDocument(document := _Doc);

domRoot := _Dom.ParseDocument(sJson := _Doc);

IF domRoot = 0 OR_ELSE NOT _Dom.IsObject(v := domRoot) THEN
	RecordFailure(message := "Serialized STRING values must form a JSON object");
	RETURN;
END_IF

escapedValue := _Dom.FindMember(v := domRoot, member := 'escapeStr');

IF escapedValue = 0 OR_ELSE NOT _Dom.IsString(v := escapedValue) THEN
	RecordFailure(message := "escapeStr must be a JSON string");
	RETURN;
END_IF

Assert.ThatString(actual := _Dom.GetString(v := escapedValue), message := "DOM-decoded escaped value").ToBe(
	expected := 'Line1$NLine2$T"Quoted"\'
);

root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'emptyStr'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(strDst),
	size := SIZEOF(strDst)
);
Assert.ThatString(actual := strDst).ToBe(expected := '');

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'regStr'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(strDst),
	size := SIZEOF(strDst)
);
Assert.ThatString(actual := strDst).ToBe(expected := 'Hello Structured World');

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'escapeStr'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(strDst),
	size := SIZEOF(strDst)
);
Assert.ThatString(actual := strDst).ToBe(expected := 'Line1$NLine2$T"Quoted"\');

// Pure reader test on manual JSON with empty string
_Doc := '{"standaloneEmpty": ""}';
root := _Reader.Parse(document := _Doc);
strDst := 'initial';
_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'standaloneEmpty'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(strDst),
	size := SIZEOF(strDst)
);
{analysis +175}
Assert.ThatString(actual := strDst).ToBe(expected := '');]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStructuralRoundTrip" Id="{749c018f-5ed2-4f10-89cf-1be85fe6fd20}">
      <Declaration><![CDATA[(* Verifies round-trip for nested configuration objects and ordered lists. *)
METHOD PRIVATE testStructuralRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	paramsNode : TOF_Core.CONFIGURATION_NODE;
	flagsNode : TOF_Core.CONFIGURATION_NODE;
	header : STRING(80) := 'test-structure';
	gain : REAL := 2.5;
	offset : DINT := 10;
	flag0 : BOOL := TRUE;
	flag1 : BOOL := FALSE;
	flag2 : BOOL := TRUE;
	headerDst : STRING(80);
	gainDst : REAL;
	offsetDst : DINT;
	flagDst : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();

// SA0175: Raw string buffer binding for header property; no character indexing.
{analysis -175}
_Writer.WriteValue(
	name := 'header',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(header),
	size := SIZEOF(header)
);
{analysis +175}

_Writer.BeginObject(name := 'params');
_Writer.WriteValue(
	name := 'gain',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	data := ADR(gain),
	size := SIZEOF(gain)
);
_Writer.WriteValue(
	name := 'offset',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(offset),
	size := SIZEOF(offset)
);
_Writer.EndObject();

_Writer.BeginArray(name := 'flags');
_Writer.WriteValue(
	name := '',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(flag0),
	size := SIZEOF(flag0)
);
_Writer.WriteValue(
	name := '',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(flag1),
	size := SIZEOF(flag1)
);
_Writer.WriteValue(
	name := '',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(flag2),
	size := SIZEOF(flag2)
);
_Writer.EndArray();

_Writer.EndDocument(document := _Doc);

root := _Reader.Parse(document := _Doc);

// SA0175: Raw string buffer binding for header property; no character indexing.
{analysis -175}
_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'header'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(headerDst),
	size := SIZEOF(headerDst)
);
{analysis +175}
Assert.ThatString(actual := headerDst).ToBe(expected := 'test-structure');

paramsNode := _Reader.GetField(node := root, name := 'params');
_Reader.ReadValue(
	node := _Reader.GetField(node := paramsNode, name := 'gain'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL,
	data := ADR(gainDst),
	size := SIZEOF(gainDst)
);
Assert.ThatReal(actual := gainDst).ToBe(expected := 2.5, tolerance := 0.001);

_Reader.ReadValue(
	node := _Reader.GetField(node := paramsNode, name := 'offset'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(offsetDst),
	size := SIZEOF(offsetDst)
);
Assert.ThatDInt(actual := offsetDst).ToBe(expected := 10);

flagsNode := _Reader.GetField(node := root, name := 'flags');
Assert.ThatUDInt(actual := _Reader.GetArraySize(node := flagsNode)).ToBe(expected := 3);

_Reader.ReadValue(
	node := _Reader.GetItem(node := flagsNode, index := 0),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(flagDst),
	size := SIZEOF(flagDst)
);
Assert.ThatBool(actual := flagDst).IsTrue();

_Reader.ReadValue(
	node := _Reader.GetItem(node := flagsNode, index := 1),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(flagDst),
	size := SIZEOF(flagDst)
);
Assert.ThatBool(actual := flagDst).IsFalse();

_Reader.ReadValue(
	node := _Reader.GetItem(node := flagsNode, index := 2),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL,
	data := ADR(flagDst),
	size := SIZEOF(flagDst)
);
Assert.ThatBool(actual := flagDst).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testWideStringsRoundTrip" Id="{857159a7-e6e6-4912-807d-7ce077f47a45}">
      <Declaration><![CDATA[(*
Verifies empty, Unicode and escaped wide strings, including an independently encoded JSON escape.

Checks that data following the wide null terminator is excluded from the serialized JSON string.
*)
METHOD PRIVATE testWideStringsRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	domRoot : Tc3_JsonXml.SJsonValue;
	emptyValue : Tc3_JsonXml.SJsonValue;
	emptyWide : WSTRING(80) := "";
	regWide : WSTRING(80) := "Café";
	escapeWide : WSTRING(80) := "Wide $N newline and \ backslash";
	wstrDst : WSTRING(80) := "initial";
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[emptyWide[1] := 16#0058; // Leave an X after the terminator to detect serialization of unused storage.

_Writer.BeginDocument();
_Writer.WriteValue(
	name := 'emptyWide',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(emptyWide),
	size := SIZEOF(emptyWide)
);
_Writer.WriteValue(
	name := 'regWide',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(regWide),
	size := SIZEOF(regWide)
);
_Writer.WriteValue(
	name := 'escapeWide',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(escapeWide),
	size := SIZEOF(escapeWide)
);
_Writer.EndDocument(document := _Doc);

domRoot := _Dom.ParseDocument(sJson := _Doc);
emptyValue := _Dom.FindMember(v := domRoot, member := 'emptyWide');

IF emptyValue = 0 OR_ELSE NOT _Dom.IsString(v := emptyValue) THEN
	RecordFailure(message := "Writer did not emit emptyWide as a JSON string");
	RETURN;
END_IF

Assert.ThatUDInt(
	actual := _Dom.GetStringLength(v := emptyValue),
	message := "Serialized emptyWide contains only the terminator"
).ToBe(expected := TOF_Core.Strings.CharSize);

root := _Reader.Parse(document := _Doc);

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'emptyWide'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wstrDst),
	size := SIZEOF(wstrDst)
);
Assert.ThatWideString(actual := wstrDst).ToBe(expected := "");

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'regWide'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wstrDst),
	size := SIZEOF(wstrDst)
);
Assert.ThatWideString(actual := wstrDst).ToBe(expected := "Café");

_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'escapeWide'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wstrDst),
	size := SIZEOF(wstrDst)
);
Assert.ThatWideString(actual := wstrDst).ToBe(expected := "Wide $N newline and \ backslash");

_Doc := '{"unicode":"Caf\u00e9"}';
root := _Reader.Parse(document := _Doc);
wstrDst := "initial";
_Reader.ReadValue(
	node := _Reader.GetField(node := root, name := 'unicode'),
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING,
	data := ADR(wstrDst),
	size := SIZEOF(wstrDst)
);
Assert.ThatWideString(actual := wstrDst, message := "Decode a JSON Unicode escape").ToBe(
	expected := "Café"
);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

