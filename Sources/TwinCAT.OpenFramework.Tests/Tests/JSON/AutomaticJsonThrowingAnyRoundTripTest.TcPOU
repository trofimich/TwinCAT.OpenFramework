<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonThrowingAnyRoundTripTest" Id="{2bd4d3bc-7d95-442f-9899-60333086d339}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks successful throwing ANY serialization and restoration.

Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonThrowingAnyRoundTripTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_Source : JSON_TEST_VALUE;
	_Target : JSON_TEST_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{4ed2d943-2f2c-43a5-8e61-f6fd80a1fcd3}">
      <Declaration><![CDATA[(* Checks successful throwing ANY serialization and restoration. *)
METHOD PROTECTED ExecuteTest
VAR
	jsonSize : UDINT;
	expectedJson : STRING(40) := '{"Number":42,"Ready":true}';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Source.Number := 42;
_Source.Ready := TRUE;

_Target.Number := 0;
_Target.Ready := FALSE;

_Json := '';

_Serializer.Serialize(
	sourceStructure := _Source,
	extender := 0,
	targetJson := _Json,
	jsonSize => jsonSize
);

Assert.That(
	actual := _Json,
	message := "Serialization must emit the expected structure members"
).ToBe(expected := expectedJson);

_Serializer.Deserialize(json := _Json, targetStructure := _Target);
Assert.ThatDInt(
	actual := _Target.Number,
	message := "Integer payload must round-trip"
).ToBe(expected := 42);
Assert.ThatBool(
	actual := _Target.Ready,
	message := "Boolean payload must round-trip"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{d3f6e7ac-bfac-46f0-b5ca-faec75a13891}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d9a5bdc5-1bed-489d-9c6c-19f4ba78fba3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{df8b223c-91b2-4df1-aff4-3b78e4f1b6a3}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3adbab36-edb5-44fc-bedf-db0e7a3fa27b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{bcbda2bb-1aac-4161-84ec-162ad7d8d462}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c3f8ee8e-88b3-42c1-8917-1003fa32ef78}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
