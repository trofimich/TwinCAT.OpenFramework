(*!
<summary>Holds long text and a distinct marker for native capacity and encoding tests.</summary>
*)
TYPE JSON_TEST_LARGE_VALUE :
STRUCT
	//! <summary>Uses the framework JSON text capacity in bytes, excluding the terminator.</summary>
	Text : STRING(TOF_Core.Parameters.JSON_DOCUMENT_CHAR_SIZE);
	//! <summary>Independent field that distinguishes the structure from its first member.</summary>
	Marker : DINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
