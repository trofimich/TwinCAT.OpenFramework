<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonRejectsInvalidArgumentsTest" Id="{133d6435-f52c-46be-8554-c778e2400ad9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks ordinary Try refusals without leaking exceptions or invoking hooks.

Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonRejectsInvalidArgumentsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_Extender : JsonExtenderProbe;
	_Source : JSON_TEST_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{39f6a531-3e54-4172-b668-951d1d43d22d}">
      <Declaration><![CDATA[(* Checks ordinary Try refusals without leaking exceptions or invoking hooks. *)
METHOD PROTECTED ExecuteTest
VAR
	scalar : DINT;
	structureAddress : PVOID;
	sourceInfo : __SYSTEM.VAR_INFO;
	success : BOOL;
	jsonSize : UDINT;
	leaked : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Source.Number := 42;
_Source.Ready := TRUE;

_Json := '';

_Extender.Reset();

scalar := 3;
_Json := '{"Number":42,"Ready":true}';

__TRY
	success := _Serializer.TrySerialize(
		sourceStructure := scalar,
		extender := _Extender,
		targetJson := _Json,
		jsonSize => jsonSize
	);
	Assert.ThatBool(
		actual := success,
		message := "Scalar ANY must be rejected"
	).IsFalse();
	success := _Serializer.TryDeserialize(json := _Json, targetStructure := scalar);
	Assert.ThatBool(
		actual := success,
		message := "Scalar ANY destination must be rejected"
	).IsFalse();
	sourceInfo := __VARINFO(scalar);
	structureAddress := ADR(scalar);
	success := _Serializer.TrySerializeByVarInfo(
		sourceStructureVarInfo := sourceInfo,
		sourceStructureAddress := structureAddress,
		extender := _Extender,
		targetJson := _Json,
		jsonSize => jsonSize
	);
	Assert.ThatBool(
		actual := success,
		message := "Scalar descriptor must be rejected"
	).IsFalse();
	success := _Serializer.TryDeserializeByVarInfo(
		json := _Json,
		targetStructureVarInfo := sourceInfo,
		targetStructureAddress := structureAddress
	);
	Assert.ThatBool(
		actual := success,
		message := "Scalar descriptor destination must be rejected"
	).IsFalse();
	sourceInfo := __VARINFO(_Source);
	structureAddress := TOF_Core.Memory.NULL_ADDRESS;
	success := _Serializer.TrySerializeByVarInfo(
		sourceStructureVarInfo := sourceInfo,
		sourceStructureAddress := structureAddress,
		extender := _Extender,
		targetJson := _Json,
		jsonSize => jsonSize
	);
	Assert.ThatBool(
		actual := success,
		message := "Null source address must be rejected"
	).IsFalse();
	success := _Serializer.TryDeserializeByVarInfo(
		json := _Json,
		targetStructureVarInfo := sourceInfo,
		targetStructureAddress := structureAddress
	);
	Assert.ThatBool(
		actual := success,
		message := "Null destination address must be rejected"
	).IsFalse();
__CATCH
	leaked := TRUE;
__ENDTRY

Assert.ThatBool(
	actual := leaked,
	message := "Try argument failures must not escape"
).IsFalse();
Assert.ThatUDInt(
	actual := _Extender.StartCount,
	message := "Rejected arguments must skip start"
).ToBe(expected := 0);
Assert.ThatUDInt(
	actual := _Extender.FinishCount,
	message := "Rejected arguments must skip finish"
).ToBe(expected := 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{341431c9-0fe0-482a-876b-b0a966beb06c}">
      <Declaration><![CDATA[(*
Restores the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Extender.Reset();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{84eceeb7-caee-4b90-a611-6242732fd41d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{58323474-0783-4dd4-95d0-db2e2949aaf9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{30259a04-d6e1-4cba-93b2-8ee4f0916374}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d2328c6b-a9b7-4dd8-9506-1a912bd1d13d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{76e77563-2bc2-46bc-a4fa-e364fb0c8d35}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{1e554e7c-792e-4029-b658-ea53fa0cba1b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
