<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonRoundTripsAnyStructureTest" Id="{33b93936-c29c-4d85-9f37-ed816fe3efff}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks successful ANY Try conversion and copied byte count.</summary>
<description>
Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonRoundTripsAnyStructureTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_Source : JSON_TEST_VALUE;
	_Target : JSON_TEST_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{1fbb4be0-d069-4300-b684-e922f3420e0e}">
      <Declaration><![CDATA[(*!
<summary>Checks successful ANY Try conversion and copied byte count.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	success : BOOL;
	jsonSize : UDINT;
	expectedJson : STRING(40) := '{"Number":42,"Ready":true}';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Source.Number := 42;
_Source.Ready := TRUE;

_Target.Number := 0;
_Target.Ready := FALSE;

_Json := '';

success := _Serializer.TrySerialize(
	sourceStructure := _Source,
	extender := 0,
	targetJson := _Json,
	jsonSize => jsonSize
);
Assert.ThatBool(
	actual := success,
	message := "ANY TryCreate must succeed"
).IsTrue();
Assert.ThatUDInt(
	actual := jsonSize,
	message := "Copy count must include the terminator"
).ToBe(expected := TOF_Core.Strings.GetLength(value := _Json) + 1);

Assert.That(
	actual := _Json,
	message := "Serialization must emit the expected structure members"
).ToBe(expected := expectedJson);

success := _Serializer.TryDeserialize(json := _Json, targetStructure := _Target);
Assert.ThatBool(
	actual := success,
	message := "ANY TryFill must succeed"
).IsTrue();
Assert.ThatDInt(
	actual := _Target.Number,
	message := "Integer payload must round-trip"
).ToBe(expected := 42);
Assert.ThatBool(
	actual := _Target.Ready,
	message := "Boolean payload must round-trip"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{c63805f0-8434-4032-86ae-b2d9b8febb3d}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e41d8e7b-63cc-4d46-873d-08d46647db2a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{33f7664f-1de6-4084-9e52-a96a0c8310ef}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{40426357-6712-4651-9138-05c1682a4572}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{c8db1012-7c77-4e0d-bf16-305fab0ff6e3}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{1deda5a0-f26c-455e-8faa-1be64c3696c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
