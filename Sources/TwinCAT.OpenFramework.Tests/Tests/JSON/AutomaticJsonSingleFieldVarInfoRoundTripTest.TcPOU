<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonSingleFieldVarInfoRoundTripTest" Id="{64cbcb19-4a7f-413c-8717-6b9da29a024c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks both throwing and Try VAR_INFO paths for a single-field structure.</summary>
<description>
Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonSingleFieldVarInfoRoundTripTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
	_SingleSource : JSON_TEST_SINGLE_VALUE;
	_SingleTarget : JSON_TEST_SINGLE_VALUE;
	_Json : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{7c41a6f2-8cac-491f-a9f6-5b94ad0b40db}">
      <Declaration><![CDATA[(*!
<summary>Checks both throwing and Try VAR_INFO paths for a single-field structure.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	sourceInfo : __SYSTEM.VAR_INFO;
	targetInfo : __SYSTEM.VAR_INFO;
	success : BOOL;
	jsonSize : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Json := '';

_SingleSource.Number := -17;
_SingleTarget.Number := 0;
sourceInfo := __VARINFO(_SingleSource);
targetInfo := __VARINFO(_SingleTarget);
// Regression: explicit pointers must drive all four paths when descriptor addresses are absent.
sourceInfo.ByteAddress := TOF_Core.UnsignedInt32.ZERO;
targetInfo.ByteAddress := TOF_Core.UnsignedInt32.ZERO;
success := _Serializer.TrySerializeByVarInfo(
	sourceStructureVarInfo := sourceInfo,
	sourceStructureAddress := ADR(_SingleSource),
	extender := 0,
	targetJson := _Json,
	jsonSize => jsonSize
);
Assert.ThatBool(
	actual := success,
	message := "Explicit single-field TryCreate must succeed"
).IsTrue();
_Serializer.DeserializeByVarInfo(
	json := _Json,
	targetStructureVarInfo := targetInfo,
	targetStructureAddress := ADR(_SingleTarget)
);
Assert.ThatDInt(
	actual := _SingleTarget.Number,
	message := "Explicit type must restore the structure"
).ToBe(expected := -17);
_SingleSource.Number := 91;
_Serializer.SerializeByVarInfo(
	sourceStructureVarInfo := sourceInfo,
	sourceStructureAddress := ADR(_SingleSource),
	extender := 0,
	targetJson := _Json,
	jsonSize => jsonSize
);
success := _Serializer.TryDeserializeByVarInfo(
	json := _Json,
	targetStructureVarInfo := targetInfo,
	targetStructureAddress := ADR(_SingleTarget)
);
Assert.ThatBool(
	actual := success,
	message := "Explicit single-field TryFill must succeed"
).IsTrue();
Assert.ThatDInt(
	actual := _SingleTarget.Number,
	message := "Try must use the supplied type"
).ToBe(expected := 91);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a32609fb-e4f2-4216-aa6c-f7808c62e0e7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{69e7125b-7b59-46dd-bdda-ef73ffd3bd33}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5a89b71d-2b12-4d6d-94fd-bf427699d726}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{62a24278-f62f-4b3a-b756-60e17f9c4c5b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{968c239a-84bc-4a95-866d-3b037dfd91c8}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ca3a5e91-dbd1-46cf-b8bd-5b153f377075}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
