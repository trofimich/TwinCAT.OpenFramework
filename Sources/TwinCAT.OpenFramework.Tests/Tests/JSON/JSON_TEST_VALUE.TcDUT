(*!
<summary>Holds a multi-field live value for native JSON round-trip tests.</summary>
*)
TYPE JSON_TEST_VALUE :
STRUCT
	//! <summary>Integer payload with an independent expected value.</summary>
	Number : DINT;
	//! <summary>Boolean payload used to detect incomplete restoration.</summary>
	Ready : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
