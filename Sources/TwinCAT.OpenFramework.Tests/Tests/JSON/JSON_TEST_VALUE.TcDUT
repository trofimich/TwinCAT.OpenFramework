(* Holds a multi-field live value for native JSON round-trip tests. *)
TYPE JSON_TEST_VALUE :
STRUCT
	// Integer payload with an independent expected value.
	Number : DINT;
	// Boolean payload used to detect incomplete restoration.
	Ready : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
