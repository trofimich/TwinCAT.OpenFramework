<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AutomaticJsonDecimalPlacesReadbackTest" Id="{2a72888b-41dd-4566-b2bd-5c7393605d8d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks native decimal-place configuration and readback without inventing a clamp policy.</summary>
<description>
Owns persistent native serializer state and any payload buffers used by this case.
Run from one task at a stable address. The caller provides task-boundary exception cleanup.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK AutomaticJsonDecimalPlacesReadbackTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Serializer : TOF_JSON.AutomaticJsonSerializer;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{8ea576e7-004a-4774-a2a2-9d046b9db1fe}">
      <Declaration><![CDATA[(*!
<summary>Checks native decimal-place configuration and readback without inventing a clamp policy.</summary>
*)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Serializer.DecimalPlaces := 3;
Assert.ThatDInt(
	actual := _Serializer.DecimalPlaces,
	message := "Native decimal setting must be readable"
).ToBe(expected := 3);

_Serializer.DecimalPlaces := 6;

Assert.ThatDInt(
	actual := _Serializer.DecimalPlaces,
	message := "A later native decimal setting must replace the first"
).ToBe(expected := DINT#6);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{530c3e38-c4b4-4463-abe8-3702c35b7647}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0d612d00-a998-4063-ac36-7a285515e2d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f920e251-8051-4f00-b6dc-a9ea8020e863}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fc428744-f33a-4956-95f8-498e8c6341cf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7573c785-b47d-497d-85d0-e4861eb73778}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f4883982-ff06-46bd-b154-91008696b934}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
