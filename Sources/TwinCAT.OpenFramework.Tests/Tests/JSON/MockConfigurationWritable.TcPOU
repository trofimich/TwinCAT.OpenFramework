<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MockConfigurationWritable" Id="{a30cc03d-c465-4e43-8f9d-76dd8576f98c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Mock configuration serializable object for writer and round-trip tests.</summary>
<description>
Provides controlled serialization and deserialization with optional failure injection.
Used exclusively by JSON configuration unit tests.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK MockConfigurationWritable EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IConfigurationSerializable
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR_INPUT
	ThrowOnSerialize : BOOL;
	IntField : DINT := 42;
	StringField : STRING(80) := 'hello';
	WriteNestedObject : BOOL;
	WriteArray : BOOL;
END_VAR
VAR_OUTPUT
	SerializeCount : UDINT;
	DeserializeCount : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{916c45df-491f-471e-877c-54dbf3472899}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete class name for the lifetime of this instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f0cea842-3cf8-414a-8aeb-88254877a558}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Deserialize" Id="{bdcfc4ed-ca4d-44e8-ae47-31b224604124}">
      <Declaration><![CDATA[(*!
<summary>Restores fields from the configuration reader.</summary>
<description>
The reader and document node are borrowed for this call. The deserialization context is ignored.
</description>
<param name="reader">Active configuration reader.</param>
<param name="node">Object node to read fields from.</param>
<param name="context">Configuration deserialization context; ignored by this mock.</param>
*)
METHOD Deserialize
VAR_INPUT
	reader : TOF_Core.IConfigurationReader;
	node : TOF_Core.CONFIGURATION_NODE;
	context : TOF_Core.IConfigurationDeserializationContext;
END_VAR
VAR
	fieldNode : TOF_Core.CONFIGURATION_NODE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[DeserializeCount := DeserializeCount + 1;
fieldNode := reader.GetField(node := node, name := 'intField');
reader.ReadValue(
	node := fieldNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(IntField),
	size := SIZEOF(IntField)
);

fieldNode := reader.GetField(node := node, name := 'stringField');
// SA0175: Raw string buffer passed to ReadValue; no character indexing.
{analysis -175}
reader.ReadValue(
	node := fieldNode,
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(StringField),
	size := SIZEOF(StringField)
);
{analysis +175}]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{9a0381b6-1e77-47d8-884e-82b009223267}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized namespace for the lifetime of this instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{71959e5b-0981-438a-ae7f-9943d3dc701b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{4eb99566-ea7b-4cab-949c-1db7501c0c3e}">
      <Declaration><![CDATA[(*!
<summary>Resets the mock state to defaults.</summary>
*)
METHOD Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[ThrowOnSerialize := FALSE;
IntField := 42;
StringField := 'hello';
WriteNestedObject := FALSE;
WriteArray := FALSE;
SerializeCount := 0;
DeserializeCount := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{8095bf17-17e1-4bf4-8620-70c28e700df6}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete concrete instance size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b3bea11e-c420-46a9-bc1e-a0ff8a16979a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Serialize" Id="{512a2960-b907-44c3-a21d-dcfb45f11ccf}">
      <Declaration><![CDATA[(*!
<summary>Writes mock state using the provided configuration writer.</summary>
<param name="writer">Target configuration writer.</param>
*)
METHOD Serialize
VAR_INPUT
	writer : TOF_Core.IConfigurationWriter;
END_VAR
VAR
	nestedValue : DINT := 999;
	arrayItem : DINT := 100;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThrowOnSerialize THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Mock serialize failure"
	);
END_IF

SerializeCount := SerializeCount + 1;

writer.WriteValue(
	name := 'intField',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(IntField),
	size := SIZEOF(IntField)
);

// SA0175: Raw string buffer passed to WriteValue; no character indexing.
{analysis -175}
writer.WriteValue(
	name := 'stringField',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
	data := ADR(StringField),
	size := SIZEOF(StringField)
);
{analysis +175}

IF WriteNestedObject THEN
	writer.BeginObject(name := 'nested');
	writer.WriteValue(
		name := 'nestedValue',
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
		data := ADR(nestedValue),
		size := SIZEOF(nestedValue)
	);
	writer.EndObject();
END_IF

IF WriteArray THEN
	writer.BeginArray(name := 'arr');
	writer.WriteValue(
		name := '',
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
		data := ADR(arrayItem),
		size := SIZEOF(arrayItem)
	);
	writer.EndArray();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

