<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="JsonConfigurationWriterTest" Id="{0c817d2b-f993-472f-97f1-486c1de2ee2d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Exercises JsonConfigurationWriter serialization contracts, structural calls and failure handling.

Tests serialize invocation, exception recovery and reuse, null source rejection, argument validation,
manual document streaming, and destination buffer overflow detection.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK JsonConfigurationWriterTest EXTENDS TOF_Testing.SingleCycleTest
VAR CONSTANT
	// E_INVALIDARG identifies a rejected writer operand.
	_InvalidArgument : UDINT := 16#80070057;
END_VAR
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
VAR
	_Writer : TOF_JSON.JsonConfigurationWriter;
	_Dom : Tc3_JsonXml.FB_JsonDomParser;
	_Mock : MockConfigurationWritable;
	_Doc : TOF_Core.JSON_DOCUMENT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="checkCaughtException" Id="{c750804b-82f3-4fea-9b98-f7f412898bbb}">
      <Declaration><![CDATA[(*
Checks the source message of a caught framework exception and its HRESULT when specified.

Reads the payload in the current task before cleanup. A missing or unrelated payload fails the test.
*)
METHOD PRIVATE checkCaughtException
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	expectedMessage : WSTRING(255);
	scenario : WSTRING(255);
	expectedCode : UDINT := 0;
END_VAR
VAR
	exception : TOF_Core.IException;
	generalException : TOF_Core.IGeneralException;
	diagnostic : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[exception := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := exceptionCode,
	catchPointNamespaceName := NamespaceName,
	catchPointPOUName := __POUNAME(),
	catchPointPosition := __POSITION()
);

IF exception = 0 OR_ELSE NOT __QUERYINTERFACE(exception, generalException) THEN
	diagnostic := TOF_Core.WideStrings.Concat255(scenario, ": expected a framework exception");
	RecordFailure(message := diagnostic);

	RETURN;
END_IF

Assert.ThatWideString(actual := generalException.SourceMessage, message := scenario).ToBe(expected := expectedMessage);

IF expectedCode <> TOF_Core.UnsignedInt32.ZERO THEN
	Assert.ThatUDInt(actual := generalException.ErrorCode, message := scenario).ToBe(expected := expectedCode);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{37b6c46b-4a64-46ae-9509-a0a164265f89}">
      <Declaration><![CDATA[(* Borrows the concrete class name for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bebdf22a-f089-447d-bad6-75bbe5c2e989}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{e8e9f135-9b72-4b59-879b-3317b0a3a9fe}">
      <Declaration><![CDATA[(* Exercises serialization, operand rejection and writer recovery in a single PLC cycle. *)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[testSerializeWritable();
testSerializeFailureClearsDocumentAndAllowsReuse();
testSerializeNullSource();
testInvalidValueOperands();
testDocumentBufferOverflow();
testManualDocumentConstruction();]]></ST>
      </Implementation>
    </Method>
    <Method Name="expectInvalidValueOperand" Id="{822bc991-b7f6-40fc-8de6-bd1dae44dace}">
      <Declaration><![CDATA[(* Requires the invalid-argument HRESULT when writing a DINT with the supplied source and size. *)
METHOD PRIVATE expectInvalidValueOperand
VAR_INPUT
	name : STRING;
	data : PVOID;
	size : UDINT;
END_VAR
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	diagnostic : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	_Writer.WriteValue(
		name := name,
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
		data := data,
		size := size
	);

	diagnostic := TOF_Core.WideStrings.Concat255("Writer accepted invalid operand: ", TO_WSTRING(name));
	RecordFailure(message := diagnostic);
__CATCH(exceptionCode)
	checkCaughtException(
		exceptionCode := exceptionCode,
		expectedMessage := "Cannot write configuration document",
		expectedCode := _InvalidArgument,
		scenario := TO_WSTRING(name)
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{764057de-66e1-40ba-96ca-32f03d8080c4}">
      <Declaration><![CDATA[(* Borrows the compiler-initialized namespace for the lifetime of this instance. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9ac25ca3-7359-4bbd-942f-80f00ee9d497}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3be2d6f1-99c7-4cb9-9197-a5d52cf22994}">
      <Declaration><![CDATA[(* Reports the complete concrete instance size in bytes. *)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f75c3bee-2b91-4c12-989d-151fa4e109b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="testDocumentBufferOverflow" Id="{ecf77c8f-5c04-4620-af64-c106070133d6}">
      <Declaration><![CDATA[(*
Checks the writer diagnostic when the serialized document exceeds the destination capacity.

The array's string contents alone exceed the byte size of the destination buffer.
*)
METHOD PRIVATE testDocumentBufferOverflow
VAR
	i : UDINT;
	itemCount : UDINT;
	value : STRING(50) := '01234567890123456789012345678901234567890123456789';
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();
_Writer.BeginArray(name := 'overflowList');

itemCount := SIZEOF(_Doc) / TOF_Core.Strings.GetLength(value := value) + 1;

// SA0175: Raw string buffer passed to test document overflow; no character indexing.
{analysis -175}
FOR i := 1 TO itemCount DO
	_Writer.WriteValue(
		name := '',
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING,
		data := ADR(value),
		size := SIZEOF(value)
	);
END_FOR
{analysis +175}

_Writer.EndArray();

__TRY
	_Writer.EndDocument(document := _Doc);
	RecordFailure(message := "Expected failure: Oversized document");
__CATCH(exceptionCode)
	checkCaughtException(
		exceptionCode := exceptionCode,
		expectedMessage := "Cannot write configuration document",
		scenario := "Oversized document"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInvalidValueOperands" Id="{2da88161-f470-4a8b-9689-3d707e49a46a}">
      <Declaration><![CDATA[(* Checks that rejected inputs leave a valid object ready for its next field. *)
METHOD PRIVATE testInvalidValueOperands
VAR
	value : DINT := 123;
	root : Tc3_JsonXml.SJsonValue;
	member : Tc3_JsonXml.SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();
expectInvalidValueOperand(name := 'nullData', data := 0, size := SIZEOF(value));
expectInvalidValueOperand(name := 'zeroSize', data := ADR(value), size := 0);
expectInvalidValueOperand(name := 'invalidSize', data := ADR(value), size := 3);
_Writer.WriteValue(
	name := 'valid',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(value),
	size := SIZEOF(value)
);
_Writer.EndDocument(document := _Doc);

root := _Dom.ParseDocument(sJson := _Doc);

IF root = 0 OR_ELSE NOT _Dom.IsObject(v := root) THEN
	RecordFailure(message := "Rejected fields must leave the writer able to finish a valid object");
	RETURN;
END_IF

IF _Dom.FindMember(v := root, member := 'nullData') <> 0
	OR_ELSE _Dom.FindMember(v := root, member := 'zeroSize') <> 0
	OR_ELSE _Dom.FindMember(v := root, member := 'invalidSize') <> 0
THEN
	RecordFailure(message := "A rejected argument emitted a property key");
	RETURN;
END_IF

member := _Dom.FindMember(v := root, member := 'valid');

IF member = 0 OR_ELSE NOT _Dom.IsInt(v := member) THEN
	RecordFailure(message := "Expected the next valid field to contain an integer");
	RETURN;
END_IF

Assert.ThatDInt(actual := _Dom.GetInt(v := member), message := "Value after rejected operands").ToBe(expected := value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testManualDocumentConstruction" Id="{c9770a11-4b87-436c-a1a5-43e92e3fedaf}">
      <Declaration><![CDATA[(* Verifies the shape and values produced by manual object and array streaming. *)
METHOD PRIVATE testManualDocumentConstruction
VAR
	val : DINT := 10;
	item : DINT := 1;
	root : Tc3_JsonXml.SJsonValue;
	cfg : Tc3_JsonXml.SJsonValue;
	items : Tc3_JsonXml.SJsonValue;
	value : Tc3_JsonXml.SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Writer.BeginDocument();

_Writer.BeginObject(name := 'cfg');
_Writer.WriteValue(
	name := 'num',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(val),
	size := SIZEOF(val)
);
_Writer.EndObject();

_Writer.BeginArray(name := 'items');
_Writer.WriteValue(
	name := '',
	valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
	data := ADR(item),
	size := SIZEOF(item)
);
_Writer.EndArray();

_Writer.EndDocument(document := _Doc);

root := _Dom.ParseDocument(sJson := _Doc);
IF root = 0 OR_ELSE NOT _Dom.IsObject(v := root) THEN
	RecordFailure(message := "Manual serialization must produce a JSON object");
	RETURN;
END_IF

cfg := _Dom.FindMember(v := root, member := 'cfg');

IF cfg = 0 OR_ELSE NOT _Dom.IsObject(v := cfg) THEN
	RecordFailure(message := "cfg must be a nested JSON object");
	RETURN;
END_IF

value := _Dom.FindMember(v := cfg, member := 'num');

IF value = 0 OR_ELSE NOT _Dom.IsInt(v := value) THEN
	RecordFailure(message := "cfg.num must be a JSON integer");
	RETURN;
END_IF

Assert.ThatDInt(actual := _Dom.GetInt(v := value), message := "cfg.num value").ToBe(expected := 10);

items := _Dom.FindMember(v := root, member := 'items');
IF items = 0 OR_ELSE NOT _Dom.IsArray(v := items) THEN
	RecordFailure(message := "items must be a JSON array");
	RETURN;
END_IF

IF _Dom.GetArraySize(v := items) <> 1 THEN
	RecordFailure(message := "items must contain exactly one element");
	RETURN;
END_IF

value := _Dom.GetArrayValueByIdx(v := items, idx := 0);
IF value = 0 OR_ELSE NOT _Dom.IsInt(v := value) THEN
	RecordFailure(message := "items[0] must be a JSON integer");
	RETURN;
END_IF

Assert.ThatDInt(actual := _Dom.GetInt(v := value), message := "items[0] value").ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSerializeFailureClearsDocumentAndAllowsReuse" Id="{da9d4c54-a69d-4943-bb20-3eb35f2a4dbe}">
      <Declaration><![CDATA[(* Checks propagation of the callback failure, document clearing, and reuse without manual reset. *)
METHOD PRIVATE testSerializeFailureClearsDocumentAndAllowsReuse
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	hasContent : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Mock.Reset();
_Mock.ThrowOnSerialize := TRUE;
_Doc := 'pre-existing content that must be cleared';

__TRY
	_Writer.Serialize(source := _Mock, document := _Doc);
	RecordFailure(message := "Expected failure: Throwing serialization callback");
__CATCH(exceptionCode)
	checkCaughtException(
		exceptionCode := exceptionCode,
		expectedMessage := "Mock serialize failure",
		scenario := "Throwing serialization callback"
	);
__ENDTRY

Assert.ThatString(actual := _Doc).ToBe(expected := '');

_Mock.ThrowOnSerialize := FALSE;
_Writer.Serialize(source := _Mock, document := _Doc);

hasContent := Tc2_Standard.LEN(STR := _Doc) > 0;
Assert.ThatBool(actual := hasContent).IsTrue();
Assert.ThatUDInt(actual := _Mock.SerializeCount).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSerializeNullSource" Id="{860a5c75-a29d-4d6e-93b8-da14ae1e11e8}">
      <Declaration><![CDATA[(* Requires the invalid-argument diagnostic for a null serialization source. *)
METHOD PRIVATE testSerializeNullSource
VAR
	nullSource : TOF_Core.IConfigurationSerializable := 0;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[__TRY
	_Writer.Serialize(source := nullSource, document := _Doc);
	RecordFailure(message := "Expected failure: Null serialization source");
__CATCH(exceptionCode)
	checkCaughtException(
		exceptionCode := exceptionCode,
		expectedMessage := "Cannot write configuration document",
		expectedCode := _InvalidArgument,
		scenario := "Null serialization source"
	);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSerializeWritable" Id="{be17a119-22a3-40af-909b-f880885c7d0c}">
      <Declaration><![CDATA[(* Verifies the serialized object values and JSON types with the native DOM parser. *)
METHOD PRIVATE testSerializeWritable
VAR
	root : Tc3_JsonXml.SJsonValue;
	value : Tc3_JsonXml.SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Mock.Reset();
_Writer.Serialize(source := _Mock, document := _Doc);
Assert.ThatUDInt(actual := _Mock.SerializeCount).ToBe(expected := 1);

root := _Dom.ParseDocument(sJson := _Doc);
IF root = 0 OR_ELSE NOT _Dom.IsObject(v := root) THEN
	RecordFailure(message := "Object serialization must produce a JSON object");
	RETURN;
END_IF

value := _Dom.FindMember(v := root, member := 'intField');
IF value = 0 OR_ELSE NOT _Dom.IsInt(v := value) THEN
	RecordFailure(message := "intField must be a JSON integer");
	RETURN;
END_IF

Assert.ThatDInt(actual := _Dom.GetInt(v := value), message := "intField value").ToBe(expected := 42);

value := _Dom.FindMember(v := root, member := 'stringField');
IF value = 0 OR_ELSE NOT _Dom.IsString(v := value) THEN
	RecordFailure(message := "stringField must be a JSON string");
	RETURN;
END_IF

Assert.ThatString(actual := _Dom.GetString(v := value), message := "stringField value").ToBe(expected := 'hello');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>