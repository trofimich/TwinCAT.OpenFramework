(*!
<summary>Groups the deterministic logger contracts and task-routing cases.</summary>
<description>
Owns nine children in a fixed array for single-task use. Children borrows that array. The group must not be
copied.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LoggerContractTestGroup EXTENDS TOF_Testing.TestGroup<9>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_QueuedSnapshotsAndFifo : QueuedLoggerSnapshotTest(name := "QueuedSnapshotsAndFifo", parent := THIS^);
	_QueuedCapacityAndWraparound : QueuedLoggerCapacityTest(name := "QueuedCapacityAndWraparound", parent := THIS^);
	_QueuedDeliveryFailures : QueuedLoggerDeliveryFailureTest(name := "QueuedDeliveryFailures", parent := THIS^);
	_FormatterFailureContainment : LoggerFormatterFailureTest(name := "FormatterFailureContainment", parent := THIS^);
	_MetadataAndZeroRecordLimit : LoggerMetadataAndRecordLimitTest(name := "MetadataAndZeroRecordLimit", parent := THIS^);
	_IndependentTaskDiagnostics : LoggerTaskDiagnosticsTest(name := "IndependentTaskDiagnostics", parent := THIS^);
	_AggregateSnapshotsAndPartialAdmission : QueuedLoggerAggregateTest(
		name := "AggregateSnapshotsAndPartialAdmission",
		parent := THIS^
	);
	_CurrentTaskLoggerRouting : CurrentTaskLoggerRoutingTest(name := "CurrentTaskLoggerRouting", parent := THIS^);
	_RejectNonCyclicInitialization : LoggerNonCyclicInitializationTest(
		name := "RejectNonCyclicInitialization",
		parent := THIS^
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_QueuedSnapshotsAndFifo,
		_QueuedCapacityAndWraparound,
		_QueuedDeliveryFailures,
		_FormatterFailureContainment,
		_MetadataAndZeroRecordLimit,
		_IndependentTaskDiagnostics,
		_AggregateSnapshotsAndPartialAdmission,
		_CurrentTaskLoggerRouting,
		_RejectNonCyclicInitialization
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{c9702c51-1c1f-45da-8596-019c5ff18ef5}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{24dd9460-0e2a-420f-b8f8-717b6b639c40}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{7caf8392-9cc2-4fa0-b3d4-f721c358eb7f}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the instance lifetime. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b4873692-7899-42ee-af59-db18c3185f1b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{60948e8b-66b0-4c1d-8032-9f818067cd7c}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{206bf046-1a8c-43ae-93c7-6a88f552878f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{dbe1cc7a-9ba9-4a8b-8daf-c02f6fd32bcf}">
      <Declaration><![CDATA[//! <summary>Reports the complete instance size in bytes, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a7d1f972-353c-4e08-983b-9d289de3a6a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
