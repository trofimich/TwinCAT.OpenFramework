<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LoggerContractTestGroup" Id="{f8d96b7d-fe32-4547-a7dd-cd59987e25a8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
