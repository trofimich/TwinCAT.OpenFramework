<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="LoggerCaptureBackend" Id="{6da976f1-fc98-421e-9bc4-00bd51e9712b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)
(*!
<summary>Captures backend calls and injects explicitly selected delivery faults.</summary>
<description>
One test task owns this fixture and its copied records. THROW_EXCEPTION deliberately violates the ILogger
Try contract to verify that a wrapper contains a hostile backend. Manager regressions temporarily install the
fixture as the current task logger and restore the previous destination before returning. Execute faults are
also intentional; no terminal OOM or lifecycle exception is injected.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
{attribute 'no_assign'}
FUNCTION_BLOCK LoggerCaptureBackend EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.ILogger
VAR_STAT
	//! <summary>Initialized concrete fixture metadata.</summary>
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	//! <summary>Captured record slots, sufficient for one default-capacity batch and its regression probes.</summary>
	_CaptureCapacity : UINT := 256;
END_VAR
VAR
	_Records : ARRAY [0.._CaptureCapacity - 1] OF LOGGER_CAPTURED_MESSAGE;
	_CapturedCount : UINT;
	_AttemptCount : UINT;
	_ExecuteCount : UINT;
	_DeliveryBehavior : LOGGER_DELIVERY_BEHAVIOR;
	_ThrowOnExecute : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="AttemptCount" Id="{9ef393eb-f65f-428a-9dbd-9127b010d528}">
      <Declaration><![CDATA[(*!
<summary>Provides the capture fixture AttemptCount observation or setting.</summary>
<description>
Read or configure only from the test owner task between fixture calls.
</description>
*)
PROPERTY AttemptCount : UINT]]></Declaration>
      <Get Name="Get" Id="{209f5ab0-b117-4ba5-b43d-95caac90d66f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AttemptCount := _AttemptCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CapturedCount" Id="{c32e1331-280b-4d08-907c-05a22f4f94ac}">
      <Declaration><![CDATA[(*!
<summary>Provides the capture fixture CapturedCount observation or setting.</summary>
<description>
Read or configure only from the test owner task between fixture calls.
</description>
*)
PROPERTY CapturedCount : UINT]]></Declaration>
      <Get Name="Get" Id="{f61ee7b1-ecca-40f0-bff6-1847ede3b959}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CapturedCount := _CapturedCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{cf207a88-1c4c-4d4d-a29a-82ab169f7d63}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete fixture type name.</summary>
<description>
Returns initialized static metadata; do not modify the referenced string.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9cf63095-f8e3-4784-8890-73e44229e38b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="DeliveryBehavior" Id="{e7c2b872-6068-4504-9a47-e6fda5fd2d10}">
      <Declaration><![CDATA[(*!
<summary>Provides the capture fixture DeliveryBehavior observation or setting.</summary>
<description>
Read or configure only from the test owner task between fixture calls.
</description>
*)
PROPERTY DeliveryBehavior : LOGGER_DELIVERY_BEHAVIOR]]></Declaration>
      <Get Name="Get" Id="{24434e06-eb8a-4a97-bb68-9dc2b4eea06d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[DeliveryBehavior := _DeliveryBehavior;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{ae0e584a-11a5-4e51-b687-bd5fe8603bf7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_DeliveryBehavior := DeliveryBehavior;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Execute" Id="{9fc44ac0-9ca8-4946-af29-98dacd8ca1de}">
      <Declaration><![CDATA[(*!
<summary>Counts service calls and raises only the explicitly requested execution fault.</summary>
*)
METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExecuteCount := _ExecuteCount + 1;

IF _ThrowOnExecute THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Injected backend Execute failure"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecuteCount" Id="{6cd6b028-5b85-4248-96ae-405f2b3900f9}">
      <Declaration><![CDATA[(*!
<summary>Provides the capture fixture ExecuteCount observation or setting.</summary>
<description>
Read or configure only from the test owner task between fixture calls.
</description>
*)
PROPERTY ExecuteCount : UINT]]></Declaration>
      <Get Name="Get" Id="{e7a426a3-92cc-400c-8d48-7aec60351ac5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecuteCount := _ExecuteCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2aebb447-487f-47d0-8de2-66581787dfa7}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test namespace.</summary>
<description>
Returns compiler-initialized library storage without ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6ce78ec1-8ec3-40b2-b93a-351819954a4d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RecordAt" Id="{112102cd-62dc-4585-8458-581ded453dd9}">
      <Declaration><![CDATA[(*!
<summary>Returns a copied capture record at a valid zero-based index.</summary>
<description>
An out-of-range index returns the initialized empty record; no borrowed fixture storage is exposed.
</description>
*)
METHOD RecordAt : LOGGER_CAPTURED_MESSAGE
VAR_INPUT
	index : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF index < _CapturedCount THEN
	RecordAt := _Records[index];
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{37de4831-42d2-49c3-a30b-47be380afd87}">
      <Declaration><![CDATA[(*!
<summary>Reports the concrete fixture size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b3be57fb-d25f-4adf-8fa8-27fa02914ce2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ThrowOnExecute" Id="{4629e341-3aa7-4c19-99d6-640c796ba974}">
      <Declaration><![CDATA[(*!
<summary>Provides the capture fixture ThrowOnExecute observation or setting.</summary>
<description>
Read or configure only from the test owner task between fixture calls.
</description>
*)
PROPERTY ThrowOnExecute : BOOL]]></Declaration>
      <Get Name="Get" Id="{c0d659e6-0cd6-459b-84e0-868b17399d51}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ThrowOnExecute := _ThrowOnExecute;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{49bf22c1-38c4-4627-93f1-142a0fffc445}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ThrowOnExecute := ThrowOnExecute;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="TryLogError" Id="{7ef8b1e1-a8f4-4438-8e3c-612b47f076ec}">
      <Declaration><![CDATA[(*!
<summary>Rejects a diagnostic entry that the text-only wrapper must format before delivery.</summary>
<description>
The regression expects QueuedLogger to call TryLogMessage exclusively.
</description>
*)
METHOD TryLogError : BOOL
VAR_INPUT
	error : REFERENCE TO TOF_Core.ERROR;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryLogError := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogException" Id="{d285289b-2b8e-4ab3-8d79-7f125407b8fc}">
      <Declaration><![CDATA[(*!
<summary>Rejects a diagnostic entry that the text-only wrapper must format before delivery.</summary>
<description>
The regression expects QueuedLogger to call TryLogMessage exclusively.
</description>
*)
METHOD TryLogException : BOOL
VAR_INPUT
	exception : TOF_Core.IReadOnlyException;
	severity : TOF_Core.ERROR_SEVERITY;
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TryLogException := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryLogMessage" Id="{2e5ba809-93a5-4222-ab61-32b3eca42c89}">
      <Declaration><![CDATA[(*!
<summary>Captures a delivery attempt, returns the configured outcome or injects a hostile backend exception.</summary>
<description>
The THROW_EXCEPTION branch is intentionally outside a CATCH to exercise the consumer no-throw boundary.
A successful capture owns text and number snapshots; admission failure does not write a capture record.
</description>
*)
METHOD TryLogMessage : BOOL
VAR_INPUT
	category : TOF_Core.LOG_CATEGORY;
END_VAR
VAR_IN_OUT CONSTANT
	message : TOF_Core.ERROR_MESSAGE;
END_VAR
VAR_INPUT
	messageNumber : REFERENCE TO ULINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AttemptCount := _AttemptCount + 1;

CASE _DeliveryBehavior OF
	LOGGER_DELIVERY_BEHAVIOR.REFUSE:
		RETURN;

	LOGGER_DELIVERY_BEHAVIOR.THROW_EXCEPTION:
		TOF_Core.Exceptions.ThrowStandard(
			sourceNamespaceName := NamespaceName,
			sourceClassName := ClassName,
			sourcePOUName := __POUNAME(),
			sourcePosition := __POSITION(),
			message := "Injected backend delivery failure"
		);
END_CASE

IF _CapturedCount >= _CaptureCapacity THEN
	RETURN;
END_IF

_Records[_CapturedCount].Category := category;
_Records[_CapturedCount].Message := message;
_Records[_CapturedCount].HasMessageNumber := __ISVALIDREF(messageNumber);

IF _Records[_CapturedCount].HasMessageNumber THEN
	_Records[_CapturedCount].MessageNumber := messageNumber;
END_IF

_CapturedCount := _CapturedCount + 1;
TryLogMessage := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>