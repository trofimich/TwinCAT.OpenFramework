<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="QueuedLoggerDeliveryFailureTest" Id="{56a56307-c86b-4316-9ae0-53b3071ceb52}" SpecialFunc="None">
    <Declaration><![CDATA[(*
