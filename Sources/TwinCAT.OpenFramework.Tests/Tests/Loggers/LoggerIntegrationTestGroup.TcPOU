<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LoggerIntegrationTestGroup" Id="{9c6895e2-4d27-4bfc-b964-9ac9a336a5f5}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups file rotation, unfiltered file routing and native event delivery.

Owns five children in a fixed array for single-task use. Children borrows that array. The group must not be
copied.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LoggerIntegrationTestGroup EXTENDS TOF_Testing.TestGroup<5>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_FileRotation : TextFileLoggerRotationTest(name := "TextFileRotation", parent := THIS^);
	_EventCategories : EventLoggerCategoryTest(name := "EventCategories", parent := THIS^);
	_QueuedEvents : QueuedEventLoggerTest(name := "QueuedEvents", parent := THIS^);

	_DirectDirectory : LoggerTestDirectory(
		directoryPath := 'C:\OpenFrameworkTests\Logger_Direct',
		logFilePrefix := 'Probe'
	);
	_DirectFileLogger : TOF_Loggers.SimpleTextFileLogger(
		directoryPath := 'C:\OpenFrameworkTests\Logger_Direct',
		logFilePrefix := 'Probe',
		maxRecordsPerFile := 1,
		directoryPathType := Tc2_System.E_OpenPath.PATH_GENERIC,
		timeout := T#2S,
		amsNetId := ''
	);
	_DirectRouting : LoggerRoutingTest(
		name := "DirectFileFeedbackAndReadback",
		parent := THIS^,
		fileLogger := _DirectFileLogger,
		directory := _DirectDirectory,
		queue := 0
	);

	_QueuedDirectory : LoggerTestDirectory(
		directoryPath := 'C:\OpenFrameworkTests\Logger_Queued',
		logFilePrefix := 'Probe'
	);
	_QueuedFileLogger : TOF_Loggers.SimpleTextFileLogger(
		directoryPath := 'C:\OpenFrameworkTests\Logger_Queued',
		logFilePrefix := 'Probe',
		maxRecordsPerFile := 1,
		directoryPathType := Tc2_System.E_OpenPath.PATH_GENERIC,
		timeout := T#2S,
		amsNetId := ''
	);
	_Queue : TOF_Loggers.QueuedLogger;
	_QueuedRouting : LoggerRoutingTest(
		name := "QueuedFileFeedbackAndReadback",
		parent := THIS^,
		fileLogger := _QueuedFileLogger,
		directory := _QueuedDirectory,
		queue := _Queue
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
		[_FileRotation, _EventCategories, _QueuedEvents, _DirectRouting, _QueuedRouting];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{e21bc90a-ed2c-4666-b18d-aded6df2cb31}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{01e128a0-c7dd-4c39-a9cb-c6c969c45f53}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{fdf14146-0a72-4528-a881-0fd341cd092a}">
      <Declaration><![CDATA[// Borrows the concrete class name for the instance lifetime. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f5c03a4c-531a-4da5-a272-8f1d9025cd31}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0cab4c39-3dda-4f70-9d34-da6ef99352e4}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a1c1159f-8204-4082-b5f4-5040230389a8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9c5a3c79-e5f5-440b-af2d-9c0cb1f20f4e}">
      <Declaration><![CDATA[// Reports the complete instance size in bytes, excluding separately allocated storage.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{5038b739-1b5b-4fb6-bf39-3d54d208ff36}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
