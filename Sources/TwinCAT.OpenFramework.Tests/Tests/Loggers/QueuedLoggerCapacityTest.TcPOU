<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="QueuedLoggerCapacityTest" Id="{1cb01e64-4863-4233-b7c3-60ba95cba187}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks queue capacity, overflow preservation and reuse of the ring buffer.</summary>
<description>
The runner task owns the fixtures. Each run clears its observations and uses the same instances.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK QueuedLoggerCapacityTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Loggers.QueuedLogger;
	_Backend : LoggerCaptureBackend;
	_QueueConfigured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{647ba1c8-dc3d-404b-b0d9-6781e791c2ea}">
      <Declaration><![CDATA[(*!
<summary>Checks queue capacity, overflow preservation and reuse of the ring buffer.</summary>
<description>
The runner task owns the fixtures. Each run clears its observations and uses the same instances.
</description>
*)
METHOD PROTECTED ExecuteTest
VAR
	message : TOF_Core.ERROR_MESSAGE;
	entryLabel : WSTRING(255);
	number : ULINT;
	record : LOGGER_CAPTURED_MESSAGE;
	i : DINT;
	failuresBefore : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _QueueConfigured THEN
	_QueueConfigured := _Queue.Configure(backend := _Backend);
END_IF

Assert.ThatBool(actual := _QueueConfigured, message := "Queue must bind to its capture backend").IsTrue();

IF NOT _QueueConfigured THEN
	RETURN;
END_IF

Assert.ThatBool(
	actual := _Queue.PendingMessageCount = 0,
	message := "Scenario must start with an empty queue"
).IsTrue();

failuresBefore := _Queue.FailedDeliveryCount;

FOR i := 1 TO TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY DO
	number := TO_ULINT(i);
	message := TOF_Core.WideStrings.Concat255("entry ", TO_WSTRING(i));
	Assert.ThatBool(
		actual := _Queue.TryLogMessage(
			category := TOF_Core.LOG_CATEGORY.INFORMATION,
			message := message,
			messageNumber := number
		),
		message := TOF_Core.WideStrings.Concat255("Queue must accept record ", TO_WSTRING(i))
	).IsTrue();
END_FOR

Assert.ThatBool(
	actual := _Queue.TryLogMessage(category := TOF_Core.LOG_CATEGORY.ERROR, message := message),
	message := "Full queue must refuse the next record"
).IsFalse();
_Queue.Execute();
Assert.ThatBool(
	actual := _Backend.AttemptCount = TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY,
	message := "Delivery attempts must equal accepted capacity without retrying the overflow"
).IsTrue();

FOR i := 0 TO TO_DINT(TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY) - 1 DO
	record := _Backend.RecordAt(index := TO_UINT(i));
	message := TOF_Core.WideStrings.Concat255("entry ", TO_WSTRING(i + 1));
	entryLabel := TOF_Core.WideStrings.Concat255("Full ring record ", TO_WSTRING(i + 1), " must preserve FIFO text");
	Assert.ThatBool(actual := record.Message = message, message := entryLabel).IsTrue();

	entryLabel := TOF_Core.WideStrings.Concat255("Full ring record ", TO_WSTRING(i + 1), " must have its number");
	Assert.ThatBool(
		actual := record.HasMessageNumber AND_THEN record.MessageNumber = TO_ULINT(i + 1),
		message := entryLabel
	).IsTrue();
END_FOR

IF TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY > 0 THEN
	message := "after wraparound";
	Assert.ThatBool(
		actual := _Queue.TryLogMessage(category := TOF_Core.LOG_CATEGORY.WARNING, message := message),
		message := "A drained ring must accept a reused slot"
	).IsTrue();
	_Queue.Execute();
	record := _Backend.RecordAt(index := TOF_Loggers.Parameters.QUEUED_LOGGER_CAPACITY);
	Assert.ThatBool(actual := record.Message = message, message := "Reused slot must deliver its new text").IsTrue();
	Assert.ThatBool(actual := record.HasMessageNumber, message := "Reused slot must clear number presence").IsFalse();
END_IF

Assert.ThatBool(actual := _Queue.PendingMessageCount = 0, message := "Refilled queue must drain").IsTrue();
Assert.ThatULInt(actual := _Queue.FailedDeliveryCount, message := "Overflow is an admission refusal").ToBe(
	expected := failuresBefore
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeforeTest" Id="{d6fffa60-9840-4b4e-b89f-ee5a597868cf}">
      <Declaration><![CDATA[(*!
<summary>Clears capture observations and injected faults before each run.</summary>
*)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Backend.ResetCapture();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a983d378-b57f-4c8e-9a21-fc29476a1fb7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the instance lifetime. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{298155f9-f313-469b-9920-ca4641621318}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7b79143f-a9f0-4c2d-9dc2-71046f0da168}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{28fc4915-24f4-474a-9d32-3d996da47b18}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9a25c1e5-5b79-4f1b-b4f7-a7a16ac55934}">
      <Declaration><![CDATA[//! <summary>Reports the complete instance size in bytes, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3fb1d730-c909-442d-90f8-d449c041d245}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
