<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LoggerTaskDiagnosticsTest" Id="{395a1f2d-eb0f-4ec6-8228-421579beace6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks that explicit task diagnostics bypass the reject-all filter without servicing the destination.

The runner task owns the fixtures. Each run clears its observations and uses the same instances. An explicit
per-test reject-all filter is installed only within one synchronous call.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LoggerTaskDiagnosticsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Task : LoggerTaskProbe(name := "diagnostic route probe");
	_Backend : LoggerCaptureBackend;
	_Filter : LogFilter;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{14ca2bca-aa73-4fae-81bd-1b9285529eae}">
      <Declaration><![CDATA[(*
Checks that explicit task diagnostics bypass the reject-all filter without servicing the destination.

The runner task owns the fixtures. Each run clears its observations and uses the same instances. An explicit
per-test reject-all filter is installed only within one synchronous call.
*)
METHOD PROTECTED ExecuteTest
VAR
	savedFilter : TOF_Core.ILogFilter;
	escaped : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[savedFilter := TOF_Core.LogManager.Filter;
TOF_Core.LogManager.Filter := _Filter;

__TRY
	_Task.DiagnosticLogger := _Backend;
	Assert.ThatBool(actual := _Task.Start(), message := "Prepared probe must start").IsTrue();
	Assert.ThatUInt(actual := _Backend.CapturedCount, message := "Start must emit one RUNNING diagnostic").ToBe(
		expected := 1
	);

	_Task.Execute();
	Assert.ThatBool(actual := _Task.State.Stopped, message := "Probe must complete without native I/O").IsTrue();
	Assert.ThatUInt(actual := _Backend.CapturedCount, message := "Execute must add one STOPPED diagnostic").ToBe(
		expected := 2
	);

	Assert.ThatBool(actual := _Task.Reset(), message := "Stopped probe must reset").IsTrue();
	Assert.ThatBool(
		actual := _Backend.CapturedCount = 3,
		message := "Reset must add one READY diagnostic"
	).IsTrue();
	Assert.ThatBool(
		actual := _Backend.ExecuteCount = 0,
		message := "Task must not take ownership of diagnostic execution"
	).IsTrue();
__CATCH
	escaped := TRUE;
__ENDTRY

TOF_Core.LogManager.Filter := savedFilter;
Assert.ThatBool(actual := escaped, message := "The diagnostic scenario must return normally").IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeforeTest" Id="{1b52fa0a-d825-4431-aedc-cfad5b929260}">
      <Declaration><![CDATA[(* Clears diagnostic observations before running the probe again. *)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Backend.ResetCapture();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{7466c1cb-194b-4b6a-b943-12e016d4c0a4}">
      <Declaration><![CDATA[// Borrows the concrete class name for the instance lifetime. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{88104d30-7646-49df-b862-6272f26ac253}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{350a9a6a-c12a-4cc0-b6f7-79b1d86df23c}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6bc4b14f-1f88-4b03-b211-c724aa2d6446}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{14e56561-69f0-44c5-af23-8cd9b08fbadf}">
      <Declaration><![CDATA[// Reports the complete instance size in bytes, excluding separately allocated storage.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{80fc15a2-b8fd-469b-87ad-0caa63c4ad07}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
