(*!
<summary>Identifies owned log discovery, byte readback, deletion and final directory cleanup.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE LOGGER_DIRECTORY_CLEANUP_PHASE :
(
	ENUMERATE_FIRST,
	ENUMERATE_WAIT,
	ENUMERATE_NEXT,
	LOAD_FILE,
	WAIT_FOR_LOAD,
	DELETE_FILE,
	WAIT_FOR_DELETE,
	REMOVE_DIRECTORY,
	COMPLETE
);
END_TYPE]]></Declaration>
  </DUT>
