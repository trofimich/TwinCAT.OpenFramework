<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LoggerRoutingTest" Id="{33978978-28ce-43ba-b9e5-2b538393d5cf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
