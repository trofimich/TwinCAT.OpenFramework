(*!
<summary>Identifies owned directory preparation, logging, idle observation, stopping and readback phases.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE LOGGER_FILE_TEST_PHASE :
(
	PREPARE_DIRECTORY,
	SEND_MESSAGES,
	OBSERVE_IDLE,
	WAIT_FOR_STOP,
	READBACK,
	COMPLETE
);
END_TYPE]]></Declaration>
  </DUT>
