<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LoggerFormatterFailureTest" Id="{a3d8f603-ec0f-4d15-abb1-16e174fc5993}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks that all three logger types contain an exception raised by the message formatter.

The runner task owns the fixtures. Each run clears its observations and uses the same instances. The file
logger remains idle in INITIAL without cyclic service.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LoggerFormatterFailureTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Loggers.QueuedLogger;
	_Backend : LoggerCaptureBackend;
	_EventLogger : TOF_Loggers.EventLogger(
		debugEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.DebugEvent,
		informationEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.InformationEvent,
		warningEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.WarningEvent,
		errorEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.ErrorEvent,
		criticalErrorEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.CriticalErrorEvent
	);
	_FileLogger : TOF_Loggers.SimpleTextFileLogger(
		directoryPath := '',
		logFilePrefix := 'Log',
		maxRecordsPerFile := 1,
		directoryPathType := Tc2_System.E_OpenPath.PATH_GENERIC,
		timeout := T#2S,
		amsNetId := ''
	);
	_Formatter : ThrowingGetMessageException;
	_QueueConfigured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{78cdd936-e619-4f2a-a661-5b499fcce655}">
      <Declaration><![CDATA[(*
Checks that all three logger types contain an exception raised by the message formatter.

The runner task owns the fixtures. Each run clears its observations and uses the same instances. The file
logger remains idle in INITIAL without cyclic service.
*)
METHOD PROTECTED ExecuteTest
VAR
	formatCallsBefore : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _QueueConfigured THEN
	_QueueConfigured := _Queue.Configure(backend := _Backend);
END_IF

Assert.ThatBool(actual := _QueueConfigured, message := "Queue must bind to its capture backend").IsTrue();

IF NOT _QueueConfigured THEN
	RETURN;
END_IF

Assert.ThatBool(
	actual := _Queue.PendingMessageCount = 0,
	message := "Scenario must start with an empty queue"
).IsTrue();
formatCallsBefore := _Formatter.MessageReadCount;
Assert.ThatBool(
	actual := _Queue.TryLogException(exception := _Formatter, severity := TOF_Core.ERROR_SEVERITY.ERROR),
	message := "Queued logger must contain a throwing formatter"
).IsFalse();
Assert.ThatUDInt(
	actual := _Formatter.MessageReadCount,
	message := "Queued logger must reach the throwing formatter"
).ToBe(expected := formatCallsBefore + 1);

formatCallsBefore := _Formatter.MessageReadCount;
Assert.ThatBool(
	actual := _FileLogger.TryLogException(exception := _Formatter, severity := TOF_Core.ERROR_SEVERITY.ERROR),
	message := "File logger must contain a throwing formatter before admission"
).IsFalse();
Assert.ThatUDInt(
	actual := _Formatter.MessageReadCount,
	message := "File logger must reach the throwing formatter"
).ToBe(expected := formatCallsBefore + 1);

formatCallsBefore := _Formatter.MessageReadCount;
Assert.ThatBool(
	actual := _EventLogger.TryLogException(exception := _Formatter, severity := TOF_Core.ERROR_SEVERITY.ERROR),
	message := "Event logger must contain a throwing formatter before native send"
).IsFalse();
Assert.ThatUDInt(
	actual := _Formatter.MessageReadCount,
	message := "Event logger must reach the throwing formatter"
).ToBe(expected := formatCallsBefore + 1);

Assert.ThatBool(
	actual := _Queue.PendingMessageCount = 0,
	message := "Failed formatting must not enqueue a record"
).IsTrue();
Assert.ThatBool(actual := _FileLogger.Busy, message := "INITIAL must still report pending initialization").IsTrue();
Assert.ThatBool(
	actual := _FileLogger.State = TOF_Loggers.SIMPLE_TEXT_FILE_LOGGER_STATE.INITIAL,
	message := "A formatting refusal must leave the file logger in INITIAL"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnBeforeTest" Id="{24106d99-2b4e-4ce0-a750-3174e2f234d3}">
      <Declaration><![CDATA[(* Clears capture observations and injected faults before each run. *)
METHOD PROTECTED OnBeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Backend.ResetCapture();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{8139d3c7-a498-4cc8-8a4d-1508d998b0d4}">
      <Declaration><![CDATA[// Borrows the concrete class name for the instance lifetime. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{593da199-4dfa-455a-bf1d-3add02f853c0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0a088407-315d-4e9e-827c-9a2900ef2aab}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6e98f80e-e9c9-49ab-8846-7552786dcdf7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{116881b8-20c2-409d-9b4f-e36b2eb833a2}">
      <Declaration><![CDATA[// Reports the complete instance size in bytes, excluding separately allocated storage.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{8d173ba0-c490-4098-b155-1c760d8705c7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
