(*!
<summary>Owns one captured logger call independently of caller buffers.</summary>
*)
TYPE LOGGER_CAPTURED_MESSAGE :
STRUCT
	Category : TOF_Core.LOG_CATEGORY;
	Message : TOF_Core.ERROR_MESSAGE;
	HasMessageNumber : BOOL;
	MessageNumber : ULINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
