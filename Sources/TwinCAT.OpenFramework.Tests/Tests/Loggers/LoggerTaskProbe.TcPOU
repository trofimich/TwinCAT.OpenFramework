<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="LoggerTaskProbe" Id="{47e6af0c-8e8a-47f0-8d09-349f3b194c42}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)
(*!
<summary>Completes one task cycle to expose internal lifecycle diagnostics.</summary>
<description>
The inherited DiagnosticLogger is configured by the owning regression before Start; no native I/O occurs.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK LoggerTaskProbe EXTENDS TOF_Tasks.Task
VAR_STAT
	//! <summary>Concrete type metadata available during base initialization.</summary>
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{00efd05e-1816-4930-9836-dbdf81fb8bac}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete fixture type name.</summary>
<description>
Returns initialized static metadata; do not modify the referenced string.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{38d8ea42-ed1a-4bd5-a536-fbeb89df8f91}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{3645b852-677e-4bc2-a871-82b890fd9f56}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test namespace.</summary>
<description>
Returns compiler-initialized library storage without ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9598a0f6-ab22-4c28-85ad-acfc0a3a79fb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnRunning" Id="{8fa9ffbd-f564-4e3f-9933-724390eb920e}">
      <Declaration><![CDATA[(*!
<summary>Completes immediately without external resources.</summary>
*)
METHOD PROTECTED OnRunning
VAR_OUTPUT
	processingState : TOF_Tasks.TASK_PROCESSING_STATE;
END_VAR
VAR_IN_OUT
	stopReasonMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[processingState := TOF_Tasks.TASK_PROCESSING_STATE.DONE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{d81f5951-276f-4612-9934-caeca2b7b7ef}">
      <Declaration><![CDATA[(*!
<summary>Reports the concrete fixture size in bytes.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e5fd4a46-a9cd-4bef-b703-b0095e5931dc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>