<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="EventLoggerCategoryTest" Id="{a11e9240-740e-49fe-a8bc-709cb7f36a7c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Exercises all five native event categories.

Each run submits five numbered messages from the runner task and checks each admission result.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK EventLoggerCategoryTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_EventLogger : TOF_Loggers.EventLogger(
		debugEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.DebugEvent,
		informationEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.InformationEvent,
		warningEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.WarningEvent,
		errorEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.ErrorEvent,
		criticalErrorEventType := TC_EVENTS.OpenFrameworkLoggerEventClass.CriticalErrorEvent
	);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{049cb0f6-6383-4bca-a941-6faedabca72c}">
      <Declaration><![CDATA[(* Sends a numbered message for each configured event type and checks the native result. *)
METHOD PROTECTED ExecuteTest
VAR
	number : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[number := 1;
Assert.ThatBool(
	actual := _EventLogger.TryLogMessage(
		category := TOF_Core.LOG_CATEGORY.DEBUG,
		message := "LoggerTest DEBUG",
		messageNumber := number
	),
	message := "EventLogger refused DEBUG"
).IsTrue();

number := 2;
Assert.ThatBool(
	actual := _EventLogger.TryLogMessage(
		category := TOF_Core.LOG_CATEGORY.INFORMATION,
		message := "LoggerTest INFORMATION",
		messageNumber := number
	),
	message := "EventLogger refused INFORMATION"
).IsTrue();

number := 3;
Assert.ThatBool(
	actual := _EventLogger.TryLogMessage(
		category := TOF_Core.LOG_CATEGORY.WARNING,
		message := "LoggerTest WARNING",
		messageNumber := number
	),
	message := "EventLogger refused WARNING"
).IsTrue();

number := 4;
Assert.ThatBool(
	actual := _EventLogger.TryLogMessage(
		category := TOF_Core.LOG_CATEGORY.ERROR,
		message := "LoggerTest ERROR",
		messageNumber := number
	),
	message := "EventLogger refused ERROR"
).IsTrue();

number := 5;
Assert.ThatBool(
	actual := _EventLogger.TryLogMessage(
		category := TOF_Core.LOG_CATEGORY.CRITICAL_ERROR,
		message := "LoggerTest CRITICAL_ERROR",
		messageNumber := number
	),
	message := "EventLogger refused CRITICAL_ERROR"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{4d1a30ad-5cd6-4d2c-b459-12188e7a8e3f}">
      <Declaration><![CDATA[// Borrows the concrete class name for the instance lifetime. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{98f6f448-a343-427d-8030-747d66cb901e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{67b035d9-d1df-4178-953d-ecf32d34e0a2}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7dd4cd35-4021-4f1d-9041-634f20b5a721}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3b7ec68f-30fb-411b-b0dd-70ef7cec62f0}">
      <Declaration><![CDATA[// Reports the complete instance size in bytes, excluding separately allocated storage.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{327d1e76-eb0b-4422-b918-bbacdb001da8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
