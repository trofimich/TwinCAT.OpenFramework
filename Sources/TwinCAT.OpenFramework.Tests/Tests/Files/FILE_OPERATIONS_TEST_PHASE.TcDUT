(* Names the phases of a filesystem integration regression. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE FILE_OPERATIONS_TEST_PHASE :
(
	// prepare directory.
	PREPARE_DIRECTORY,
	// start write.
	START_WRITE,
	// wait for write.
	WAIT_FOR_WRITE,
	// check collisions.
	CHECK_COLLISIONS,
	// wait for collisions.
	WAIT_FOR_COLLISIONS,
	// start load.
	START_LOAD,
	// wait for load.
	WAIT_FOR_LOAD,
	// start rename.
	START_RENAME,
	// wait for rename.
	WAIT_FOR_RENAME,
	// load renamed file.
	LOAD_RENAMED_FILE,
	// wait for renamed load.
	WAIT_FOR_RENAMED_LOAD,
	// start delete.
	START_DELETE,
	// wait for delete.
	WAIT_FOR_DELETE,
	// load deleted file.
	LOAD_DELETED_FILE,
	// wait for missing load.
	WAIT_FOR_MISSING_LOAD,
	// cleanup.
	CLEANUP
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>