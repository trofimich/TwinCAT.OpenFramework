<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="FILE_OPERATIONS_TEST_PHASE" Id="{592b20d6-ecda-4460-9b9b-56b6ab83eda5}">
    <Declaration><![CDATA[(*
