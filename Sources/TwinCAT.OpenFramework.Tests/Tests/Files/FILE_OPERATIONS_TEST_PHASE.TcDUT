(*!
<summary>Names the phases of a filesystem integration regression.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE FILE_OPERATIONS_TEST_PHASE :
(
	//! <summary>prepare directory.</summary>
	PREPARE_DIRECTORY,
	//! <summary>start write.</summary>
	START_WRITE,
	//! <summary>wait for write.</summary>
	WAIT_FOR_WRITE,
	//! <summary>check collisions.</summary>
	CHECK_COLLISIONS,
	//! <summary>wait for collisions.</summary>
	WAIT_FOR_COLLISIONS,
	//! <summary>start load.</summary>
	START_LOAD,
	//! <summary>wait for load.</summary>
	WAIT_FOR_LOAD,
	//! <summary>start rename.</summary>
	START_RENAME,
	//! <summary>wait for rename.</summary>
	WAIT_FOR_RENAME,
	//! <summary>load renamed file.</summary>
	LOAD_RENAMED_FILE,
	//! <summary>wait for renamed load.</summary>
	WAIT_FOR_RENAMED_LOAD,
	//! <summary>start delete.</summary>
	START_DELETE,
	//! <summary>wait for delete.</summary>
	WAIT_FOR_DELETE,
	//! <summary>load deleted file.</summary>
	LOAD_DELETED_FILE,
	//! <summary>wait for missing load.</summary>
	WAIT_FOR_MISSING_LOAD,
	//! <summary>cleanup.</summary>
	CLEANUP
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
