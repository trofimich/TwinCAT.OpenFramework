(*!
<summary>Groups the native byte, buffer validation and caller-exception filesystem integration cases.</summary>
<description>
Owns an independent directory fixture per leaf. Each child borrows and exclusively drives its assigned fixture.
The group and its fixed child array have the same lifetime. Use from one task and do not copy the group.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FileSystemIntegrationTestGroup EXTENDS TOF_Testing.TestGroup<3>
VAR_STAT
	//! <summary>Class name shared by instances of this concrete function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_OperationsDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileSystem_Operations');
	_BuffersDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileSystem_Buffers');
	_CallerDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileSystem_CallerException');

	_ByteOperations : FileByteOperationsTest(
		name := "ByteFileOperationsAndGuards",
		parent := THIS^,
		directory := _OperationsDirectory,
		scenarioTimeout := T#30S
	);
	_BufferMatrix : FileBinaryBufferMatrixTest(
		name := "BinaryBufferMatrix",
		parent := THIS^,
		directory := _BuffersDirectory,
		scenarioTimeout := T#30S
	);
	_CallerCleanup : FileCallerExceptionCleanupTest(
		name := "CaughtCallerExceptionCleanup",
		parent := THIS^,
		directory := _CallerDirectory,
		scenarioTimeout := T#15S
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
		[_ByteOperations, _BufferMatrix, _CallerCleanup];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{12a6552a-20f2-405c-99da-d16b6bd1f45e}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed leaf array for this group; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{cd69db43-b29b-4f7c-b025-85f47974203d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{182d003f-9336-4233-b669-4ac106a0235c}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete type name; callers must not modify the referenced storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6b78c2e7-41ce-4a60-8947-7ed872173185}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{d24a2c49-b910-460b-b648-71ab6b867dd9}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{568cc7a2-e445-499e-900b-5e8be2d6d497}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{641fde76-73dc-472b-a29a-0f856082b1f8}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b872295e-1151-4254-afdc-d8a6d9485699}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
