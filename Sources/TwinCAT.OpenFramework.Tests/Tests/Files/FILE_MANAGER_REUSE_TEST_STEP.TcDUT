(*!
<summary>Names the two runs and intervening cancellation in the file-manager reuse test.</summary>
<description>Steps belong to one test scenario; values are not a serialized protocol.
The first member is the initial preparation step. Test completion and failure cleanup are tracked separately.</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE FILE_MANAGER_REUSE_TEST_STEP :
(
	START_FIRST_WRITE,
	CANCEL_AFTER_WRITE,
	RESET_AND_START_SECOND_FILE,
	CHECK_SECOND_FILE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>