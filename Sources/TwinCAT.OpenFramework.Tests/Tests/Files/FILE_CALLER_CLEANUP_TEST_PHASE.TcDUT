<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <DUT Name="FILE_CALLER_CLEANUP_TEST_PHASE" Id="{58664210-4428-48ff-9805-0c664eb0e55a}">
    <Declaration><![CDATA[(*
