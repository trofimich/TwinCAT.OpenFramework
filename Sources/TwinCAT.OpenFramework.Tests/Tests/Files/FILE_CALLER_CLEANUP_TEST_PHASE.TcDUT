(* Names the phases of a caught caller-exception cleanup regression. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE FILE_CALLER_CLEANUP_TEST_PHASE :
(
	// Prepare an exclusively owned scenario directory.
	PREPARE_DIRECTORY,
	// Open a file and leave the manager waiting for future children.
	OPEN_FILE,
	// Observe acquisition and raise a caller-side exception.
	INJECT_CALLER_EXCEPTION,
	// Continue cancellation and stopping after the exception was caught.
	DRAIN_MANAGER,
	// Remove owned artifacts only after release completed.
	CLEANUP
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>