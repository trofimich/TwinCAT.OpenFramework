(*!
<summary>Names the phases of a caught caller-exception cleanup regression.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE FILE_CALLER_CLEANUP_TEST_PHASE :
(
	//! <summary>Prepare an exclusively owned scenario directory.</summary>
	PREPARE_DIRECTORY,
	//! <summary>Open a file and leave the manager waiting for future children.</summary>
	OPEN_FILE,
	//! <summary>Observe acquisition and raise a caller-side exception.</summary>
	INJECT_CALLER_EXCEPTION,
	//! <summary>Continue cancellation and stopping after the exception was caught.</summary>
	DRAIN_MANAGER,
	//! <summary>Remove owned artifacts only after release completed.</summary>
	CLEANUP
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
