(*!
<summary>Names the operations and successful completion of DirectoryTest scenarios.</summary>
<description>Each scenario follows its explicit subset of steps. Advancing requires WORK_DONE and the
step's existence checks to pass. COMPLETED ends the successful scenario; failure cleanup is tracked
separately and continues on later suite cycles. Values are internal test state, not a serialized protocol.</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE DIRECTORY_TEST_STEP :
(
	//! <summary>Create the test directory; success establishes ownership, an existing path causes failure.</summary>
	CREATE_DIRECTORY := 0,
	//! <summary>Verify the newly created test directory exists.</summary>
	CHECK_DIRECTORY_PRESENT,
	//! <summary>Create a child directory inside the owned test directory.</summary>
	CREATE_CHILD_DIRECTORY,
	//! <summary>Verify the first conditional creation produced a child directory.</summary>
	CHECK_CHILD_DIRECTORY_PRESENT,
	//! <summary>Repeat conditional creation while the child directory exists.</summary>
	CREATE_CHILD_DIRECTORY_AGAIN,
	//! <summary>Verify the child directory still exists after repeated creation.</summary>
	CHECK_CHILD_DIRECTORY_PRESENT_AGAIN,
	//! <summary>Remove the owned child directory using conditional removal.</summary>
	REMOVE_CHILD_DIRECTORY,
	//! <summary>Verify that the child directory is absent.</summary>
	CHECK_CHILD_DIRECTORY_ABSENT,
	//! <summary>Repeat conditional removal while the child directory is absent.</summary>
	REMOVE_CHILD_DIRECTORY_AGAIN,
	//! <summary>Verify the child directory is still absent after repeated removal.</summary>
	CHECK_CHILD_DIRECTORY_ABSENT_AGAIN,
	//! <summary>Remove the empty test directory created by this scenario.</summary>
	REMOVE_DIRECTORY,
	//! <summary>Verify the test directory is absent after removal.</summary>
	CHECK_DIRECTORY_ABSENT,
	//! <summary>All scenario operations and postconditions completed successfully.</summary>
	COMPLETED
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>