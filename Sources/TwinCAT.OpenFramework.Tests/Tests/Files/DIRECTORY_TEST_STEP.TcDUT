(*
Names the operations and successful completion of DirectoryTest scenarios.

Each scenario follows its explicit subset of steps. Advancing requires the expected stop reason and any
existence checks for that step. COMPLETED ends scenario work. Cleanup advances on later test cycles.
The enum is internal to the tests.
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE DIRECTORY_TEST_STEP :
(
	// Create the test directory; success establishes ownership, an existing path causes failure.
	CREATE_DIRECTORY := 0,
	// Verify the newly created test directory exists.
	CHECK_DIRECTORY_PRESENT,
	// Create a child directory inside the owned test directory.
	CREATE_CHILD_DIRECTORY,
	// Verify the first conditional creation produced a child directory.
	CHECK_CHILD_DIRECTORY_PRESENT,
	// Repeat conditional creation while the child directory exists.
	CREATE_CHILD_DIRECTORY_AGAIN,
	// Verify the child directory still exists after repeated creation.
	CHECK_CHILD_DIRECTORY_PRESENT_AGAIN,
	// Require native removal of the nonempty parent directory to fail.
	REJECT_NONEMPTY_DIRECTORY_REMOVAL,
	// Confirm the child still exists after the failed parent removal.
	CHECK_CHILD_DIRECTORY_RETAINED,
	// Remove the owned child directory using conditional removal.
	REMOVE_CHILD_DIRECTORY,
	// Verify that the child directory is absent.
	CHECK_CHILD_DIRECTORY_ABSENT,
	// Repeat conditional removal while the child directory is absent.
	REMOVE_CHILD_DIRECTORY_AGAIN,
	// Verify the child directory is still absent after repeated removal.
	CHECK_CHILD_DIRECTORY_ABSENT_AGAIN,
	// Remove the empty test directory created by this scenario.
	REMOVE_DIRECTORY,
	// Verify the test directory is absent after removal.
	CHECK_DIRECTORY_ABSENT,
	// All scenario operations and postconditions completed successfully.
	COMPLETED
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>