<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="DIRECTORY_TEST_STEP" Id="{bf4fd83d-636c-4583-83cd-68d10caca698}">
    <Declaration><![CDATA[(*
