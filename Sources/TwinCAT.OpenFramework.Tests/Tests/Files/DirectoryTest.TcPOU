(*!
<summary>Groups the three native directory scenarios.</summary>
<description>
Owns one independent fixture per child and borrows the shared FileTestRoot. Use from one task without reentry.
The child array and parent associations stay fixed. Do not copy the group or modify its borrowed array.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DirectoryTest EXTENDS TOF_Testing.TestGroup<3>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_CreateAndRemove : DirectoryOperationTest(
		name := "CheckThenCreateThenRemoveDirectory",
		parent := THIS^,
		directoryPath := 'C:\OpenFrameworkTests\DirectoryTest_CreateRemove',
		firstStep := DIRECTORY_TEST_STEP.CHECK_DIRECTORY_PRESENT
	);
	_MissingChild : DirectoryOperationTest(
		name := "CheckInvalidDirectory",
		parent := THIS^,
		directoryPath := 'C:\OpenFrameworkTests\DirectoryTest_Missing',
		firstStep := DIRECTORY_TEST_STEP.CHECK_CHILD_DIRECTORY_ABSENT
	);
	_ConditionalOperations : DirectoryOperationTest(
		name := "CreateDirectoryIfNotExistsThenRemoveItIfExists",
		parent := THIS^,
		directoryPath := 'C:\OpenFrameworkTests\DirectoryTest_IfExists',
		firstStep := DIRECTORY_TEST_STEP.CREATE_CHILD_DIRECTORY
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_CreateAndRemove,
		_MissingChild,
		_ConditionalOperations
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{84f8b9e9-605e-48e5-830d-961659dec60f}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed array of this concrete group; do not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{29970ce1-edad-43af-9b66-95f59b7c1816}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{b781c019-1c1b-484b-acec-96a5874d1a6b}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d936d22f-afe8-4c1e-9761-f36cc99eb530}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{84d1f26a-3563-43b2-b392-59a3c3ab34fd}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{88651a57-c797-417c-8993-132cac33a90a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d39cabf1-a157-4448-854d-53e1fec0f987}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{9c6bd572-f723-4816-951b-a53604d5025a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
