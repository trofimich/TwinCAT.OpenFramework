(* Names the phases of a filesystem integration regression. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE FILE_BUFFER_TEST_PHASE :
(
	// prepare directory.
	PREPARE_DIRECTORY,
	// create file.
	CREATE_FILE,
	// wait for file.
	WAIT_FOR_FILE,
	// start invalid operation.
	START_INVALID_OPERATION,
	// wait for invalid operation.
	WAIT_FOR_INVALID_OPERATION,
	// cleanup.
	CLEANUP
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>