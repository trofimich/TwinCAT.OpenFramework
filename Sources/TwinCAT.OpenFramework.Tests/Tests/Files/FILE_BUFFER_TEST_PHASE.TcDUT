(*!
<summary>Names the phases of a filesystem integration regression.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE FILE_BUFFER_TEST_PHASE :
(
	//! <summary>prepare directory.</summary>
	PREPARE_DIRECTORY,
	//! <summary>create file.</summary>
	CREATE_FILE,
	//! <summary>wait for file.</summary>
	WAIT_FOR_FILE,
	//! <summary>start invalid operation.</summary>
	START_INVALID_OPERATION,
	//! <summary>wait for invalid operation.</summary>
	WAIT_FOR_INVALID_OPERATION,
	//! <summary>cleanup.</summary>
	CLEANUP
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
