(*!
<summary>Names preparation and write-failure checks for a file opened for reading.</summary>
<description>Steps belong to one test scenario; values are not a serialized protocol.
The first member is the initial preparation step. Test completion and failure cleanup are tracked separately.</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE READ_ONLY_FILE_TEST_STEP :
(
	CREATE_FILE,
	OPEN_FILE_FOR_READING,
	CHECK_WRITE_FAILURE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>