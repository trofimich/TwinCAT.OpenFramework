<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileWriteCancellationTest" Id="{e5eb2d31-94a4-4ac2-a42a-cd40f927b0a8}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks cancellation of a pending native write before its queued successor can execute.

Requires an observed busy native write and an accepted Cancel request. The manager must retain the handle
until the active child finishes stopping, then release it and leave the queued read unstarted.
A write that finishes before its busy state is observed fails this scenario.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FileWriteCancellationTest EXTENDS FileContentScenarioTest
VAR_STAT
	// Class name shared by instances of this concrete function block.
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_WriteText : TOF_FileSystem.WriteString255ToFile(name := "Cancel active text write");
	_WaitingRead : TOF_FileSystem.ReadString255FromFile(name := "Read after cancelled write");
	_CancelRequested : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ResetScenario" Id="{da5f4233-5aa6-4551-bf20-33e5d3912277}">
      <Declaration><![CDATA[// Clears the cancellation observation and rearms both queue children.
METHOD PROTECTED ResetScenario : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CancelRequested := FALSE;
ResetScenario := _WriteText.Reset() AND_THEN _WaitingRead.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AdvanceScenario" Id="{0ff16356-1fb6-48de-91aa-e6f3e88036c5}">
      <Declaration><![CDATA[(*
Starts the queue and requests cancellation only after observing native write activity.

Returns TRUE on verified cancellation. The base reports cleanup and retained failures.
*)
METHOD PROTECTED AdvanceScenario : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Manager.State.Ready THEN
	_Directory.ExpectFirstFile();
	ConfigureFile(filePath := _Directory.FirstFilePath, modeFlags := _UpdateTextMode);

	_WriteText.StringToWrite := 'Cancel while the native file write is pending';
	_WriteText.Timeout := _NativeTimeout;
	_WaitingRead.Timeout := _NativeTimeout;
	_Manager.Enqueue(fileHandleTask := _WriteText);
	_Manager.Enqueue(fileHandleTask := _WaitingRead);

	IF NOT _Manager.Start() THEN
		_ScenarioFailure := "File manager refused Start before the cancellation check";
		RETURN;
	END_IF
END_IF

_Manager.Execute();

IF _WriteText.FileOperationInProgress THEN
	IF NOT _Manager.ResourceManager.ResourceAcquired THEN
		_ScenarioFailure := "The file resource must remain acquired while its write is busy";
		RETURN;
	END_IF

	IF NOT _CancelRequested THEN
		_CancelRequested := _Manager.Cancel();

		IF NOT _CancelRequested THEN
			_ScenarioFailure := "File manager must accept Cancel during a pending native write";
			RETURN;
		END_IF
	END_IF
END_IF

IF _Manager.RunningSubstate.ResourceReleasing AND_THEN NOT _WriteText.State.Stopped THEN
	_ScenarioFailure := "File resource release began before the active write child stopped";
	RETURN;
END_IF

IF NOT _CancelRequested AND_THEN (_WriteText.State.Stopped OR_ELSE _Manager.State.Stopped) THEN
	_ScenarioFailure := "Write or manager stopped before the test observed a busy native write and requested Cancel";
	RETURN;
END_IF

IF NOT _Manager.State.Stopped THEN
	RETURN;
END_IF

IF NOT _Manager.FinalStopReason.ExternalCancel THEN
	_ScenarioFailure := "File manager must stop with ExternalCancel";
ELSIF NOT _WriteText.State.Stopped OR_ELSE NOT _WriteText.FinalStopReason.ExternalCancel THEN
	_ScenarioFailure := "The active write must stop with ExternalCancel";
ELSIF _WriteText.FileOperationInProgress THEN
	_ScenarioFailure := "The native write must no longer be busy after the manager stops";
ELSIF NOT _WaitingRead.State.Ready THEN
	_ScenarioFailure := "The read queued after the cancelled write must remain READY";
ELSE
	AdvanceScenario := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{210df69c-c394-46c6-9af0-e4f769a12e6d}">
      <Declaration><![CDATA[// Borrows this concrete type name; callers must not modify the referenced storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{667cb244-98e7-40bc-bb27-5029f3a6ba31}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{12a39466-afee-4df4-9b8d-86930a53995c}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace; callers must not modify the returned reference.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e5890a7c-b343-4d4a-9d4c-e4db2292da7c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b7def8d2-d228-4ce5-8553-d5a40f24e21a}">
      <Declaration><![CDATA[// Reports this concrete instance size, excluding separately allocated storage.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7e751472-3f8b-4827-99f1-b3f3379511a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
