<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileManagerStartRefusalProbe" Id="{2bf42914-152b-41df-9974-f86511bec283}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Injects a configurable file-manager start preparation exception.

Set RefuseStart while READY. With refusal disabled, the probe runs the real file-manager preparation hook.
The test cancels accepted starts before driving native acquisition.
*)

FUNCTION_BLOCK FileManagerStartRefusalProbe EXTENDS TOF_FileSystem.FileContentManager
VAR_STAT
	_ProbeClassName : STRING := __POUNAME();
END_VAR
VAR_INPUT
	// Requests a synthetic preparation exception on the next Start.
	RefuseStart : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="OnBeforeStart" Id="{f08737f4-ec9a-43a7-8f80-62886edeac76}">
      <Declaration><![CDATA[(* Raises the requested test exception or delegates to normal file-manager preparation. *)
METHOD PROTECTED OnBeforeStart]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF RefuseStart THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Synthetic file-manager Start refusal"
	);
END_IF

SUPER^.OnBeforeStart();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{e8e38f7c-791d-42e0-b6af-bbc729c8944f}">
      <Declaration><![CDATA[(* Borrows initialized read-only type metadata without exceptions or resource initialization. *)
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c6235568-2f9e-48a7-9e5f-a2870fcef483}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ProbeClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{1f83b9b2-7697-4e62-9cf2-4a5972664c10}">
      <Declaration><![CDATA[(* Borrows compiler-initialized read-only metadata identifying the test namespace. *)
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{15ac08c7-b1e6-4d2c-ae63-7500b3f6e6ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{3d18460c-d2c2-46bc-8ea6-6ac1eb262c04}">
      <Declaration><![CDATA[(* Reports the size of this concrete probe in bytes. *)
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{bdb9990a-9032-46c0-af4f-60c7d7b5b2d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
