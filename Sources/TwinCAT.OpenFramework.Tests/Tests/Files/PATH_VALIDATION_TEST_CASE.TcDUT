(* Pairs a path with its expected lexical outcomes for directory and file validation. *)
TYPE PATH_VALIDATION_TEST_CASE :
STRUCT
	// Null-terminated path passed to each lexical validator.
	Path : Tc2_System.T_MaxString;
	// Expected result from IsValidDirectoryPath.
	DirectoryAccepted : BOOL;
	// Expected result from IsValidFilePath.
	FileAccepted : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
