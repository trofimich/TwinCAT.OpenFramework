(*!
<summary>Pairs a path with its expected lexical outcomes for directory and file validation.</summary>
*)
TYPE PATH_VALIDATION_TEST_CASE :
STRUCT
	//! <summary>Null-terminated path passed to each lexical validator.</summary>
	Path : Tc2_System.T_MaxString;
	//! <summary>Expected result from IsValidDirectoryPath.</summary>
	DirectoryAccepted : BOOL;
	//! <summary>Expected result from IsValidFilePath.</summary>
	FileAccepted : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
