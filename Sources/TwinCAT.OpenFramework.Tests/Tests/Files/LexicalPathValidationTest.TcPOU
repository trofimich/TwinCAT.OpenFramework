<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LexicalPathValidationTest" Id="{98e3a94e-1606-42b6-ab48-c17697f03e90}" SpecialFunc="None">
    <Declaration><![CDATA[(*
