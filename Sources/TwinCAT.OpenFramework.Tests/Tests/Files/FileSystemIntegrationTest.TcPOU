<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileSystemIntegrationTest" Id="{fc7f1476-e895-4756-a4e8-96d5a4aa7160}" SpecialFunc="None">
    <Declaration><![CDATA[(*
