(*!
<summary>Names preparation and cleanup phases of one exclusively owned file-test directory.</summary>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE FILE_TEST_DIRECTORY_PHASE :
(
	//! <summary>Create a new directory; an existing entry is a preparation failure.</summary>
	CREATE_DIRECTORY,
	//! <summary>Wait for ordinary creation before establishing ownership.</summary>
	WAIT_FOR_DIRECTORY,
	//! <summary>The scenario exclusively owns its prepared directory.</summary>
	READY,
	//! <summary>Cancel and drain interrupted preparation without guessing ownership.</summary>
	DRAIN_CREATION,
	//! <summary>Attempt deletion of the first registered scenario artifact.</summary>
	DELETE_FIRST_FILE,
	//! <summary>Attempt deletion of the second registered scenario artifact.</summary>
	DELETE_SECOND_FILE,
	//! <summary>Remove the owned directory nonrecursively after file cleanup attempts.</summary>
	REMOVE_DIRECTORY,
	//! <summary>Preparation failed or cleanup attempts finished; inspect result properties.</summary>
	COMPLETE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
