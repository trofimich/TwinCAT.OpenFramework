<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="FILE_TEST_DIRECTORY_PHASE" Id="{adcd4ea1-48f4-4e8b-8d58-1c60bacf86e5}">
    <Declaration><![CDATA[(*
