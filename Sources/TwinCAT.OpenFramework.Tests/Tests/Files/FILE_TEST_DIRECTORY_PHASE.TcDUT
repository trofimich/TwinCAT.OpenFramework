License: https://opensource.org/license/mit
*)

(* Names preparation and cleanup phases of one exclusively owned file-test directory. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE FILE_TEST_DIRECTORY_PHASE :
(
	// Create a new directory; an existing entry is a preparation failure.
	CREATE_DIRECTORY,
	// Wait for ordinary creation before establishing ownership.
	WAIT_FOR_DIRECTORY,
	// The scenario exclusively owns its prepared directory.
	READY,
	// Cancel and drain interrupted preparation without guessing ownership.
	DRAIN_CREATION,
	// Attempt deletion of the first registered scenario artifact.
	DELETE_FIRST_FILE,
	// Attempt deletion of the second registered scenario artifact.
	DELETE_SECOND_FILE,
	// Remove the owned directory nonrecursively after file cleanup attempts.
	REMOVE_DIRECTORY,
	// Preparation failed or cleanup attempts finished; inspect result properties.
	COMPLETE
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>