(*
Groups the four cyclic file-content manager scenarios.

Owns one independent directory fixture per leaf. Each child borrows and exclusively drives its assigned fixture.
The group keeps the fixtures, Children array and parent associations fixed for the lifetime of the tests.
Use from one task without reentry. Do not copy the group or modify its borrowed Children array.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FileContentManagerOperationsTest EXTENDS TOF_Testing.TestGroup<4>
VAR_STAT
	// Class name shared by instances of this concrete function block.
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_TextDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileContent_CreateText');
	_ReadOnlyDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileContent_ReadOnly');
	_CancelDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileContent_Cancel');
	_ReuseDirectory : FileTestDirectory(directoryPath := 'C:\OpenFrameworkTests\FileContent_Reuse');

	_TextTest : FileTextReadWriteTest(
		name := "CreateTextFile",
		parent := THIS^,
		directory := _TextDirectory,
		scenarioTimeout := T#10S
	);
	_ReadOnlyTest : FileReadOnlyWriteTest(
		name := "WriteToFileOpenedForReading",
		parent := THIS^,
		directory := _ReadOnlyDirectory,
		scenarioTimeout := T#15S
	);
	_CancelTest : FileWriteCancellationTest(
		name := "CancelDuringFileWrite",
		parent := THIS^,
		directory := _CancelDirectory,
		scenarioTimeout := T#10S
	);
	_ReuseTest : FileManagerReuseTest(
		name := "ReuseAfterReset",
		parent := THIS^,
		directory := _ReuseDirectory,
		scenarioTimeout := T#20S
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_TextTest,
		_ReadOnlyTest,
		_CancelTest,
		_ReuseTest
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{53679131-82c1-4520-958b-a4126e5547c4}">
      <Declaration><![CDATA[// Borrows the fixed leaf array for this group's lifetime; callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{bdbebcf2-368c-4b32-86ce-1b80b2096fe6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{0e328233-4437-4ba7-9929-6ddc7a423ba1}">
      <Declaration><![CDATA[// Borrows this concrete type name; callers must not modify the referenced storage.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{05c6e581-0b64-4875-ae64-7f0ffa202a1c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f8c4819c-e034-43af-aa3a-0de302692ebd}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace; callers must not modify the returned reference.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3e4f788d-f206-4f9b-a08b-d381f553f2c8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d9ee4ad6-4b0f-4f4b-9349-9bb9eecb1987}">
      <Declaration><![CDATA[// Reports this concrete instance size, excluding separately allocated storage.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d0caaa54-f989-4627-96df-3505e5714b74}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
