(*!
<summary>Groups the deterministic filesystem contract scenarios.</summary>
<description>
Owns six persistent child tests and their fixed parent associations. Use in one task without reentry.
Do not copy the group or modify its borrowed Children array. The cases require no shared test directory.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FileSystemContractTest EXTENDS TOF_Testing.TestGroup<6>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_DefaultNamesAndReuse : FileSystemDefaultNamesTest(name := "DefaultNamesAndReuse", parent := THIS^);
	_UnboundContentFailures : FileSystemUnboundContentTest(name := "UnboundContentFailures", parent := THIS^);
	_LoadBufferPreconditions : FileSystemLoadBufferTest(name := "LoadBufferPreconditions", parent := THIS^);
	_QueueBindingRules : FileSystemQueueBindingTest(name := "QueueBindingRules", parent := THIS^);
	_ExceptionClonePayloads : FileSystemExceptionCloneTest(name := "ExceptionClonePayloads", parent := THIS^);
	_ManagerStartRefusal : FileSystemManagerStartRefusalTest(name := "ManagerStartRefusal", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_DefaultNamesAndReuse,
		_UnboundContentFailures,
		_LoadBufferPreconditions,
		_QueueBindingRules,
		_ExceptionClonePayloads,
		_ManagerStartRefusal
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{a89d9c7b-7176-436a-810b-093c1f80da30}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed array of this concrete group; do not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{3c54e7ca-3280-4167-8a74-90495be1b4d0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{ea3b2a5f-0225-4425-8718-176c100ade83}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{005bd870-5ea4-4266-999a-2d79cfd00c09}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{d4d6caa3-5d8c-43fc-8a44-7d330ca05b88}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0a4b6a65-4436-4895-bd4f-3fbe676261f4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6bbd4991-c0f2-45f9-8472-3b6c61faad66}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{cd4d374f-8322-4109-afa8-4ddf035533ff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
