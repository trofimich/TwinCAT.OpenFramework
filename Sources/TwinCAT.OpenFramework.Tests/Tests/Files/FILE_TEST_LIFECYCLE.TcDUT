(*
Separates filesystem scenario execution from cleanup and result reporting.

A case remains active while cleanup is pending. Completed drain and cleanup attempts permit FINISHED
and result reporting. Errors remain test failures and do not authorize deleting unowned paths.
Cleanup has no forced deadline. These phases do not guarantee physical close after a native release failure.
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE FILE_TEST_LIFECYCLE :
(
	// Advance the scenario and its deadline until its normal or failed outcome is known.
	RUNNING_SCENARIO,
	// Keep the case active while retained resources stop and owned cleanup attempts finish.
	CLEANING_UP,
	// Cleanup observations were reported for this run.
	FINISHED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>