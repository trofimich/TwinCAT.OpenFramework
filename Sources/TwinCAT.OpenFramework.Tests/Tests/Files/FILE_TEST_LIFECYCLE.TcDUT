(*!
<summary>Separates filesystem scenario execution from cleanup and TcUnit completion.</summary>
<description>
A case keeps registering its own test while cleanup is pending. Only completed drain and cleanup attempts
permit FINISHED and TEST_FINISHED; errors remain test failures and do not authorize deleting unowned paths.
Cleanup has no forced deadline. These phases do not guarantee physical close after a native release failure.
</description>
*)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE FILE_TEST_LIFECYCLE :
(
	//! <summary>Advance the scenario and its deadline until its normal or failed outcome is known.</summary>
	RUNNING_SCENARIO,
	//! <summary>Keep the case active while retained resources stop and owned cleanup attempts finish.</summary>
	CLEANING_UP,
	//! <summary>Cleanup observations were reported and TEST_FINISHED was called; perform no further work.</summary>
	FINISHED
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
