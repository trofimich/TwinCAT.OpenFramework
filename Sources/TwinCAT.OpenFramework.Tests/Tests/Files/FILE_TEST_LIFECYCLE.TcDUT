<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <DUT Name="FILE_TEST_LIFECYCLE" Id="{fe324de8-d781-4a3e-a68b-2b1fad78b77a}">
    <Declaration><![CDATA[(*
