<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FileCallerExceptionCleanupTest" Id="{40f55019-ccae-487b-aa05-bce79c796b88}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Verifies cooperative release after an exception in the file manager's caller.</summary>
<description>
Raises a known StandardException only while the file resource is acquired. The caller catches and checks its
identity, then requests cancellation on a later cycle and drives the manager to STOPPED. The base removes the
owned artifacts before publishing a result. Native resource state does not certify physical close.
Use from one task and do not copy this test.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK FileCallerExceptionCleanupTest EXTENDS FileContentScenarioTest
VAR_STAT
	//! <summary>Class name shared by instances of this concrete function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR CONSTANT
	//! <summary>Payload used to distinguish the deliberate caller fault from unrelated exceptions.</summary>
	_CallerMessage : WSTRING(255) := "Synthetic exception in the file-scenario caller";
	//! <summary>Creates an empty owned file for observing acquisition and cancellation.</summary>
	_CreateBinaryMode : DWORD := Tc2_System.Global_Variables.FOPEN_MODEWRITE
		OR Tc2_System.Global_Variables.FOPEN_MODEBINARY;
END_VAR
VAR
	_Phase : FILE_CALLER_CLEANUP_TEST_PHASE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ResetScenario" Id="{25e842d8-77e7-41a0-8495-45591818bed5}">
      <Declaration><![CDATA[(*!
<summary>Restores the opening phase after the base rearms the manager.</summary>
*)
METHOD PROTECTED ResetScenario : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Phase := FILE_CALLER_CLEANUP_TEST_PHASE.OPEN_FILE;
ResetScenario := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AdvanceScenario" Id="{21ee17cc-a468-4f19-9510-dddbcc56337c}">
      <Declaration><![CDATA[(*!
<summary>Opens a file, catches the caller fault and continues cancellation until release.</summary>
<description>Returns TRUE after observing STOPPED and checking the final reason and resource state.</description>
*)
METHOD PROTECTED AdvanceScenario : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE _Phase OF
	FILE_CALLER_CLEANUP_TEST_PHASE.OPEN_FILE:
		_Directory.ExpectFirstFile();
		ConfigureFile(filePath := _Directory.FirstFilePath, modeFlags := _CreateBinaryMode);
		_Manager.StopWhenNoPendingTasks := FALSE;
		CheckScenario(condition := _Manager.Start(), message := "Caller-exception manager refused Start");
		_Phase := FILE_CALLER_CLEANUP_TEST_PHASE.INJECT_CALLER_EXCEPTION;

	FILE_CALLER_CLEANUP_TEST_PHASE.INJECT_CALLER_EXCEPTION:
		_Manager.Execute();

		IF _Manager.State.Running
			AND_THEN _Manager.ResourceManager.ResourceAcquired
			AND_THEN _Manager.RunningSubstate.Processing
		THEN
			CheckScenario(
				condition := catchCallerException(),
				message := "Expected caller exception was not caught intact"
			);
			_Phase := FILE_CALLER_CLEANUP_TEST_PHASE.DRAIN_MANAGER;
		ELSIF _Manager.State.Stopped THEN
			_ScenarioFailure := "Caller fault requires an acquired file resource: ";
			TOF_Core.WideStrings.AppendFit(
				targetString := _ScenarioFailure,
				sourceString := _Manager.FinalStopReason.Message
			);
		END_IF

	FILE_CALLER_CLEANUP_TEST_PHASE.DRAIN_MANAGER:
		IF _Manager.RunningSubstate.Processing AND_THEN NOT _Manager.Cancel() THEN
			_ScenarioFailure := "The acquired manager refused caller cancellation";
			RETURN;
		END_IF

		_Manager.Execute();

		IF _Manager.State.Stopped THEN
			IF NOT _Manager.FinalStopReason.ExternalCancel THEN
				_ScenarioFailure := "Caller recovery did not stop with ExternalCancel: ";
				TOF_Core.WideStrings.AppendFit(
					targetString := _ScenarioFailure,
					sourceString := _Manager.FinalStopReason.Message
				);
				RETURN;
			END_IF

			CheckScenario(
				condition := NOT _Manager.ResourceManager.ResourceAcquired,
				message := "Caller recovery left the file resource acquired"
			);
			AdvanceScenario := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="catchCallerException" Id="{6d782a82-887c-43b9-a504-dcf52b8eb0f3}">
      <Declaration><![CDATA[(*!
<summary>Injects and recognises the deliberate exception outside the manager's Execute call.</summary>
<description>Returns TRUE only for the expected standard payload. No exception reference survives this call.</description>
*)
METHOD PRIVATE catchCallerException : BOOL
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	standardException : TOF_Core.IStandardException;
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[message := _CallerMessage;

__TRY
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := message
	);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	catchCallerException := __QUERYINTERFACE(caughtException, standardException)
		AND_THEN standardException.SourceMessage = _CallerMessage;
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{0c16020e-dbd3-4baf-9ca7-9daf1b9647a0}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete type name; callers must not modify the referenced storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e170a7d6-07c0-405b-af2c-525417b01121}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{fc0d71d6-7242-405a-b0ee-d9e4b219e1b7}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d1f63781-6250-401e-b5f2-58502317aa6a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{95ea8a94-2a2c-4a96-baf8-3258d76a3e63}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{57fa2163-06c7-45d6-a4dd-ef05d6bb0ea2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
