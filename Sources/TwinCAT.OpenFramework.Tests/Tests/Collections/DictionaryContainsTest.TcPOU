<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="DictionaryContainsTest" Id="{2d7a40c9-cbba-45f4-ba83-476cbde093c0}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks matching and missing keys with raw and borrowed generic queries.

Borrows one group-owned dictionary reserved for this case. Use from one task at a stable address.
Teardown clears entries owned by the dictionary before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DictionaryContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Dictionary : TOF_Collections.IDictionary;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="OnAfterTest" Id="{cf996799-1669-4115-b0d5-304f335c59ba}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Dictionary.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{cc3a92c8-6716-4aa2-b93f-62e4ba12463f}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ce07f8d2-dbf3-401c-9390-2a45f7b05a3f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{953a4708-e6c0-4c93-8d3b-3f7d058a91ff}">
      <Declaration><![CDATA[(* Checks matching and missing keys with raw and borrowed generic queries. *)
METHOD PROTECTED ExecuteTest
VAR
	keys : ARRAY [0..6] OF INT := [0, 1, 2, 3, 4, 5, 6];
	values : ARRAY [0..6] OF STRING :=
		['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	i : DINT;
	missingKey : INT := 9;
	query : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 6 TO 0 BY -1 DO
	_Dictionary.SetCopy(key := keys[i], value := values[i]);
END_FOR

_Dictionary.SetCopy(key := keys[3], value := values[3]);

Assert.ThatBool(
	actual := _Dictionary.ContainsKey(key := keys[3]),
	message := "ContainsKey must find the stored key"
).IsTrue();

Assert.ThatBool(
	actual := _Dictionary.ContainsKey(key := missingKey),
	message := "ContainsKey must reject an absent key"
).IsFalse();

query := TOF_Core.GenericValueFactory.FromIntReference(value := keys[3]);
Assert.ThatBool(
	actual := _Dictionary.ContainsGenericKey(key := query, releaseKey := FALSE),
	message := "ContainsGenericKey must find the stored key"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := missingKey);
Assert.ThatBool(
	actual := _Dictionary.ContainsGenericKey(key := query, releaseKey := FALSE),
	message := "ContainsGenericKey must reject an absent key"
).IsFalse();

Assert.ThatDInt(
	actual := _Dictionary.Length,
	message := "Lookup must preserve all seven entries"
).ToBe(expected := DINT#7);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{f8304e8b-650e-4a5d-b552-76f39363504b}">
      <Declaration><![CDATA[(*
Binds the dictionary fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
dictionary — Required live dictionary reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	dictionary : TOF_Collections.IDictionary;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Dictionary := dictionary;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{715962f3-c34b-4f8f-a738-5da52b32941e}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fa995312-0b65-4c06-91e0-97d44e7f9b81}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e3e510d7-9e34-4923-a36b-b8f6974ad375}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ebc8ef7f-452b-473c-b764-6c70c4737628}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>