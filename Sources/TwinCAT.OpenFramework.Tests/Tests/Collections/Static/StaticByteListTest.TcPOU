<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="StaticByteListTest" Id="{e82c77d6-5acd-4f3b-a63d-8c6bbb29227c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

FUNCTION_BLOCK StaticByteListTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_StaticArray : ARRAY [0..5] OF BYTE := [0, 1, 2, 3, 4, 5];
	
	_List : TOF_Collections.ByteList<12>;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[LoadFromAny();
GetAndSet();
Find();
Remove();
RemoveAt();
Clear();
Overflow();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{7f6b1b9e-a67e-489b-baf6-504947289f73}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{505b30b6-f9e1-439d-a79e-de104003bf26}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{4cb353b8-38ec-49f8-a5d1-16d7efeb39de}">
      <Declaration><![CDATA[(*!
<summary>Checks Clear from an explicitly prepared byte-list state.</summary>
*)
METHOD Clear
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List.Clear();
_List.AppendAny(data := _StaticArray);

_List.Clear(releaseDynamicMemory := TRUE);

AssertEquals_DINT(Expected := 0, Actual := _List.Length, Message := 'Invalid length after Clear');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Find" Id="{2c7fb61e-0d1b-45f9-88cb-75389290ba3d}">
      <Declaration><![CDATA[(*!
<summary>Checks Find from an explicitly prepared byte-list state.</summary>
*)
METHOD Find
VAR
	result : BOOL;
	index : DINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List.Clear();
_List.AppendAny(data := _StaticArray);
_List.Set(index := 5, value := 50);

result := _List.Find(value := 50, index => index);

AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Value not found');
AssertEquals_DINT(Expected := 5, Actual := index, Message := 'Wrong index of found element');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetAndSet" Id="{c369311b-8bc3-429e-af21-a562634e0f3e}">
      <Declaration><![CDATA[(*!
<summary>Checks byte replacement and explicit rejection of invalid existing indices.</summary>
<description>Requires the expected exception category and preserves logical contents on both failures.</description>
*)
METHOD GetAndSet
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	errorMessage : TOF_Core.ERROR_MESSAGE;
	caughtException : TOF_Core.IException;
	standardException : TOF_Core.IStandardException;
	rejected : BOOL;
END_VAR
VAR
	index : DINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List
	.Clear()
	.AppendByte(value := _StaticArray[0])
	.AppendByte(value := _StaticArray[1])
	.AppendByte(value := _StaticArray[2])
	.AppendByte(value := _StaticArray[3])
	.AppendByte(value := _StaticArray[4])
	.AppendByte(value := _StaticArray[5])
	.AppendAny(data := _StaticArray); 

AssertEquals_BYTE(Expected := 5, Actual := _List.Get(index := 5), Message := 'Invalid value received by Get');

_List.Set(index := 5, value := 50);
AssertEquals_BYTE(Expected := 50, Actual := _List.Get(index := 5), Message := 'Invalid value received by Get after Set');

__TRY
	index := -1;
	_List.Set(index := index, value := 10);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, standardException),
		Message := 'Invalid byte index must raise StandardException'
	);
	errorMessage := caughtException.GetMessage();
	AssertEquals_STRING(
		Expected := 'Index is less then zero',
		Actual := WSTRING_TO_STRING(errorMessage),
		Message := 'Wrong exception message'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Invalid byte index must raise');
AssertEquals_DINT(Expected := 12, Actual := _List.Length, Message := 'Rejected Set must preserve Length');
AssertEquals_BYTE(
	Expected := 50,
	Actual := _List.Get(index := 5),
	Message := 'Rejected Set must preserve data'
);
rejected := FALSE;

__TRY
	index := 12;
	_List.Set(index := index, value := 10);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, standardException),
		Message := 'Invalid byte index must raise StandardException'
	);
	errorMessage := caughtException.GetMessage();
	AssertEquals_STRING(
		Expected := 'Index is too large',
		Actual := WSTRING_TO_STRING(errorMessage),
		Message := 'Wrong exception message'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Invalid byte index must raise');
AssertEquals_DINT(Expected := 12, Actual := _List.Length, Message := 'Rejected Set must preserve Length');
AssertEquals_BYTE(
	Expected := 50,
	Actual := _List.Get(index := 5),
	Message := 'Rejected Set must preserve data'
);
rejected := FALSE;
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoadFromAny" Id="{9eed6805-ba5c-4dc1-accf-6421005e5ba4}">
      <Declaration><![CDATA[(*!
<summary>Checks LoadFromAny from an explicitly prepared byte-list state.</summary>
*)
METHOD LoadFromAny
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List.Clear();

_List.LoadFromAny(data := _StaticArray, startIndex := 0);	
AssertEquals_DINT(Expected := TO_DINT(SIZEOF(_StaticArray)), Actual := _List.Length, Message := 'Wrong loading from any');

_List.LoadFromAny(data := _StaticArray, startIndex := _List.Length);	
AssertEquals_DINT(Expected := TO_DINT(SIZEOF(_StaticArray) * 2), Actual := _List.Length, Message := 'Wrong loading from any');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{64b4d4ce-e796-4f21-a8f0-01272794380f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2a6fae5c-dc9b-4843-b0e1-7188271b3567}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Overflow" Id="{06616c22-8d0e-43e5-811f-670728c1632c}">
      <Declaration><![CDATA[(*!
<summary>Requires StaticCollectionFullException without accepting an extra entry.</summary>
<description>Checks the exception category and a positive caught flag outside the protected call.</description>
*)
METHOD Overflow
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	expectedException : TOF_Core.IStaticCollectionFullException;
	rejected : BOOL;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List
	.Clear()
	.AppendByte(value := _StaticArray[0])
	.AppendByte(value := _StaticArray[1])
	.AppendByte(value := _StaticArray[2])
	.AppendByte(value := _StaticArray[3])
	.AppendByte(value := _StaticArray[4])
	.AppendByte(value := _StaticArray[5])
	.AppendByte(value := _StaticArray[0])
	.AppendByte(value := _StaticArray[1])
	.AppendByte(value := _StaticArray[2])
	.AppendByte(value := _StaticArray[3])
	.AppendByte(value := _StaticArray[4])
	.AppendByte(value := _StaticArray[5]);

__TRY
	_List.AppendByte(value := _StaticArray[5]);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedException),
		Message := 'Static overflow must raise StaticCollectionFullException'
	);
	rejected := TRUE;
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Full static collection must reject insertion');

AssertEquals_DINT(Expected := 12, Actual := _List.Length, Message := 'Wrong static list length');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Remove" Id="{2d1a2919-b91b-4c18-8da0-66abfc041033}">
      <Declaration><![CDATA[METHOD Remove
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List.Clear();
_List.AppendAny(data := _StaticArray);

_List.Remove(value := 2);

AssertEquals_DINT(Expected := 5, Actual := _List.Length, Message := 'Wrong length after Remove');
AssertEquals_BYTE(Expected := 3, Actual := _List.Get(index := 2), Message := 'Wrong element removed by Remove');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveAt" Id="{cd7b70b9-b61a-4c7f-8522-58d9d469ff0a}">
      <Declaration><![CDATA[METHOD RemoveAt
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_List.Clear();
_List.AppendAny(data := _StaticArray);

_List.RemoveAt(index := 2, count := 2);

AssertEquals_DINT(Expected := 4, Actual := _List.Length, Message := 'Wrong length after RemoveAt');
AssertEquals_BYTE(Expected := 4, Actual := _List.Get(index := 2), Message := 'Wrong element removed by RemoveAt');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>