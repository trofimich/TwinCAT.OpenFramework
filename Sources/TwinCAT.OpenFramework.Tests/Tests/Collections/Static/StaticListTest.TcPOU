(*!
<summary>Exercises list operations with copied and borrowed string values.</summary>
<description>
Allocates owned string fixtures on the first suite execution, outside lifecycle initialization. Allocation
failure is terminal. FB_exit releases fixtures, including a partially prepared set; list entries borrow those
fixtures. The predicate snapshot belongs to a persistent field and survives aborted calls.
</description>
*)

FUNCTION_BLOCK StaticListTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_StaticStringArray : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	_DynamicStringArray : ARRAY [0..5] OF POINTER TO STRING;
	_StringsPrepared : BOOL;

	//! <summary>Owns predicate snapshots across calls and exception propagation.</summary>
	_BytewiseEqualityPredicate : TOF_Comparison.BytewiseEqualityPredicate;
	
	_ListToTest : TOF_Collections.List<8>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[prepareStrings();

Append();
Insert();
GetAndSet();
Find();
Contains();
ContainsGeneric();
RemoveFirst();
RemoveMatched();
RemoveAt();
Swap();
Sort();
AppendGeneric();
InsertGeneric();
GetAndSetGeneric();
Clear();
Overflow();]]></ST>
    </Implementation>
    <Method Name="Append" Id="{34564ddf-a085-49fe-8fd4-0635726989ee}">
      <Declaration><![CDATA[(*!
<summary>Checks Append with an independent prepared list state.</summary>
<description>
Uses persistent source strings; no previous testcase result is needed.
</description>
*)
METHOD Append
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_ListToTest.Clear();

_ListToTest.AppendCopy(value := _StaticStringArray[0]);
_ListToTest.AppendCopy(value := _StaticStringArray[1]);
_ListToTest.AppendCopy(value := _StaticStringArray[2]);

AssertEquals_DINT(Expected := 3, Actual := _ListToTest.Length, Message := 'Wrong length after Append');
AssertEquals_STRING(Expected := 'String2', Actual := _ListToTest.Get(index := 2).AsString255(), Message := 'Wrong element value after Append');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendGeneric" Id="{c514a110-a750-494f-9c18-b106d99e68e7}">
      <Declaration><![CDATA[METHOD AppendGeneric
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_ListToTest.Clear();

_ListToTest.AppendGeneric(value := TOF_Core.GenericValueFactory.FromStringReference(value := _DynamicStringArray[0]^));
_ListToTest.AppendGeneric(value := TOF_Core.GenericValueFactory.FromStringReference(value := _DynamicStringArray[1]^));
_ListToTest.AppendGeneric(value := TOF_Core.GenericValueFactory.FromStringReference(value := _DynamicStringArray[2]^));

AssertEquals_DINT(Expected := 3, Actual := _ListToTest.Length, Message := 'Wrong length after AppendGeneric');
	AssertEquals_STRING(
		Expected := 'String2',
		Actual := _ListToTest.Get(index := 2).AsString255(),
		Message := 'Wrong element value after AppendGeneric'
	);
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ce437a75-90fe-40c3-bdba-e7b4dfdb28a7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{aa0c9a3f-8b53-4246-a4fe-d0b485714870}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
