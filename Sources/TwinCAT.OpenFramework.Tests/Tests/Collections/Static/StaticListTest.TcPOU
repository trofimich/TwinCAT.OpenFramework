END_IF 

TEST(TestName := __POUNAME());

_ListToTest.Clear();

AssertEquals_DINT(Expected := 0, Actual := _ListToTest.Length, Message := 'Invalid length after Clear');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{ea949c77-cc31-44ee-8981-5230b4d04d4d}">
      <Declaration><![CDATA[METHOD Contains
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_ListToTest
	.Clear()
	.AppendCopy(value := _StaticStringArray[0])
	.AppendCopy(value := _StaticStringArray[1])
	.AppendCopy(value := _StaticStringArray[2])
	.AppendCopy(value := _StaticStringArray[3])
	.AppendCopy(value := _StaticStringArray[2])
	.AppendCopy(value := _StaticStringArray[3]);

AssertEquals_BOOL(Expected := TRUE, Actual := _ListToTest.Contains(value := _StaticStringArray[1]), Message := 'Value not found');
AssertEquals_BOOL(Expected := TRUE, Actual := _ListToTest.Contains(value := _StaticStringArray[3]), Message := 'Value not found');
AssertEquals_BOOL(Expected := FALSE, Actual := _ListToTest.Contains(value := _StaticStringArray[5]), Message := 'Value found');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ContainsGeneric" Id="{20a8ed19-6a2d-419b-b03a-2dc6eedee078}">
      <Declaration><![CDATA[METHOD ContainsGeneric
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_ListToTest
	.Clear()
	.AppendCopy(value := _StaticStringArray[0])
	.AppendCopy(value := _StaticStringArray[1])
	.AppendCopy(value := _StaticStringArray[2])
