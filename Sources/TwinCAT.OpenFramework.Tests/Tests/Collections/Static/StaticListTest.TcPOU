	.AppendCopy(value := _StaticStringArray[3]);

	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := _ListToTest.ContainsGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := _StaticStringArray[1])),
		Message := 'Value not found'
	);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := _ListToTest.ContainsGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := _StaticStringArray[3])),
		Message := 'Value not found'
	);
	AssertEquals_BOOL(
		Expected := FALSE,
		Actual := _ListToTest.ContainsGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := _StaticStringArray[5])),
		Message := 'Value found'
	);
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{83d9e740-7602-4193-b153-945c72f6d9a3}">
      <Declaration><![CDATA[(*!
<summary>Releases the suite-owned string fixtures during destruction.</summary>
<description>
Handles a partially prepared fixture set. Does not allocate or create exceptions. Borrowed references into
these strings become invalid.
</description>
*)

//!<param name="bInCopyCode">
//! TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online
//! change).
//! </param>

METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  
END_VAR
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO 5 DO
	IF _DynamicStringArray[i] <> 0 THEN
		__DELETE(_DynamicStringArray[i]);
	END_IF	
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="prepareStrings" Id="{80c245e6-5fef-4100-a9e1-f0c4018a5ce7}">
      <Declaration><![CDATA[(*!
<summary>Prepares owned string fixtures once during ordinary suite execution.</summary>
<description>
Checks each allocation before use. Completed allocations remain owned by the suite for FB_exit cleanup if a
later allocation fails. Does not run from FB_init.
</description>
*)
METHOD PRIVATE prepareStrings
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _StringsPrepared THEN
	RETURN;
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();

FOR i := 0 TO 5 DO
	_DynamicStringArray[i] := __NEW(STRING);

	IF _DynamicStringArray[i] = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	_DynamicStringArray[i]^ := _StaticStringArray[i];
END_FOR

_StringsPrepared := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Find" Id="{742f568b-6d3c-4f49-b66f-081f8d6d9394}">
      <Declaration><![CDATA[METHOD Find
VAR
	result : BOOL;
	index : DINT;

END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_ListToTest
	.Clear()
	.AppendCopy(value := _StaticStringArray[0])
	.AppendCopy(value := _StaticStringArray[1])
	.AppendCopy(value := _StaticStringArray[2])
	.AppendCopy(value := _StaticStringArray[3])
	.AppendCopy(value := _StaticStringArray[4])
	.AppendCopy(value := _StaticStringArray[5])
	.AppendCopy(value := _StaticStringArray[2])
	.AppendCopy(value := _StaticStringArray[3]);

_BytewiseEqualityPredicate.SetReferenceValueByAny(referenceValue := _StaticStringArray[2]);
result := _ListToTest.FindSingle(predicate := _BytewiseEqualityPredicate, skip := 0, index => index);

AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Value not found');
AssertEquals_DINT(Expected := 2, Actual := index, Message := 'Wrong index of found element');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
