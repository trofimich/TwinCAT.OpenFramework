_ListToTest.AppendCopy(value := _StaticStringArray[0]);
_ListToTest.AppendCopy(value := _StaticStringArray[1]);
_ListToTest.AppendCopy(value := _StaticStringArray[2]);
_ListToTest.AppendCopy(value := _StaticStringArray[3]);
_ListToTest.AppendCopy(value := _StaticStringArray[4]);
_ListToTest.AppendCopy(value := _StaticStringArray[5]);

_ListToTest.Swap(index1 := 0, index2 := 5);

AssertEquals_STRING(Expected := 'String5', Actual := _ListToTest.Get(index := 0).AsString255(), Message := 'Wrong swap result');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>