_ListToTest.AppendCopy(value := _StaticStringArray[5]);
_ListToTest.AppendCopy(value := _StaticStringArray[2]);
_ListToTest.AppendCopy(value := _StaticStringArray[3]);

_BytewiseEqualityPredicate.SetReferenceValueByAny(referenceValue := _StaticStringArray[2]);
_ListToTest.RemoveMatched(predicate := _BytewiseEqualityPredicate);

