    <Method Name="Sort" Id="{b2d054d1-6512-4737-9212-d17d1e28f6f4}">
      <Declaration><![CDATA[METHOD Sort
VAR
	result : BOOL;
	index : DINT;
	value : TOF_Core.GENERIC_VALUE;

END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_ListToTest.Clear();
_ListToTest.AppendCopy(value := _StaticStringArray[5]);
_ListToTest.AppendCopy(value := _StaticStringArray[4]);
_ListToTest.AppendCopy(value := _StaticStringArray[3]);
_ListToTest.AppendCopy(value := _StaticStringArray[2]);
_ListToTest.AppendCopy(value := _StaticStringArray[2]);
_ListToTest.AppendCopy(value := _StaticStringArray[2]);
_ListToTest.AppendCopy(value := _StaticStringArray[1]);
_ListToTest.AppendCopy(value := _StaticStringArray[0]);

_ListToTest.Sort(comparer := TOF_Comparison.StandardComparers.StringComparer);

_BytewiseEqualityPredicate.SetReferenceValueByAny(referenceValue := _StaticStringArray[3]);
result := _ListToTest.FindSingle(
	predicate := _BytewiseEqualityPredicate,
	skip := 0,
	searchDirection := TOF_Core.SEARCH_DIRECTION.FROM_END,
	value => value,
	index => index
);

AssertEquals_BOOL(Expected := TRUE, Actual := result, Message := 'Value not found after sorting');
AssertEquals_DINT(Expected := 5, Actual := index, Message := 'Wrong index of found element after sorting');
AssertEquals_STRING(Expected := 'String3', Actual := value.AsString255(), Message := 'Wrong value of found element after sorting');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Swap" Id="{fb67092c-fa08-4103-b82d-381dafa83884}">
