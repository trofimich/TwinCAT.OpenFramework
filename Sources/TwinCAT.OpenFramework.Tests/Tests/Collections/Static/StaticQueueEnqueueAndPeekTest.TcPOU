<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticQueueEnqueueAndPeekTest" Id="{86c1a93f-8c1f-420e-bfb7-b3fc6b60d9fd}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks FIFO head, length and copy independence during enqueue.</summary>
<description>
Owns an inline queue and its copied entry payloads. Run from one task at a stable address.
Teardown clears surviving entries before publication, including after an aborted case.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticQueueEnqueueAndPeekTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<3>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{1bad0ab6-93fa-4a4e-93c0-a20f960f9ab9}">
      <Declaration><![CDATA[(*!
<summary>Checks FIFO head, length and copy independence during enqueue.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.EnqueueCopy(value := values[1]);
values[1] := 111;

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Changing the source must preserve the copied head"
).ToBe(expected := INT#11);

_Queue.EnqueueCopy(value := values[2]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Enqueueing the second entry must preserve the head"
).ToBe(expected := INT#11);

_Queue.EnqueueCopy(value := values[3]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Enqueueing the third entry must preserve the head"
).ToBe(expected := INT#11);

Assert.ThatBool(
	actual := _Queue.Full AND_THEN _Queue.Length = 3,
	message := "Only enqueue must advance length while peeking leaves the queue full"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{f36bd1f6-4940-474e-ad15-d7ce7234e465}">
      <Declaration><![CDATA[(*!
<summary>Restores the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{49f86029-a3b5-46d7-b95b-2f223f8b23ff}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a03cdd5f-5058-47f6-982f-749d50a20dbd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ddeebe28-8e85-470f-bc42-bcf9e3a99e02}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9b39b332-9d9c-4b2a-87f1-28c383e2337b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6ffba2b5-5ca5-4018-a64f-9c095bd209f6}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{33e510af-349b-4364-b4b8-11f13bc5abb7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
