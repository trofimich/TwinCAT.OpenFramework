<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticDictionaryClearTest" Id="{9cdbef45-40b5-4d1e-ba37-3957e5d91cb0}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks clearing a full inline index and refilling its slots.

Owns a fixed-capacity dictionary and copied pairs at a stable address. Run from one task.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticDictionaryClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Dictionary : TOF_Collections.Dictionary<7>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{fda3e0bd-64d5-4084-be36-c5811482a59b}">
      <Declaration><![CDATA[(* Checks clearing a full inline index and refilling its slots. *)
METHOD PROTECTED ExecuteTest
VAR
	keys : ARRAY [0..6] OF INT := [0, 1, 2, 3, 4, 5, 6];
	values : ARRAY [0..6] OF STRING :=
		['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	i : DINT;
	value : TOF_Core.GENERIC_VALUE;
	found : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 6 TO 0 BY -1 DO
	_Dictionary.SetCopy(key := keys[i], value := values[i]);
END_FOR

Assert.ThatBool(
	actual := _Dictionary.Full AND_THEN _Dictionary.Length = 7,
	message := "The clear fixture must start full"
).IsTrue();

_Dictionary.Clear();

Assert.ThatBool(
	actual := _Dictionary.Empty AND_THEN _Dictionary.Length = 0 AND_THEN NOT _Dictionary.Full,
	message := "Clearing a full dictionary must make every slot available"
).IsTrue();

Assert.ThatDInt(
	actual := _Dictionary.Capacity,
	message := "Clearing must preserve inline capacity"
).ToBe(expected := DINT#7);

FOR i := 0 TO 6 DO
	Assert.ThatBool(
		actual := _Dictionary.ContainsKey(key := keys[i]),
		message := TOF_Core.WideStrings.Concat255("Clear must hide old key ", TO_WSTRING(i))
	).IsFalse();
END_FOR

FOR i := 0 TO 6 DO
	_Dictionary.SetCopy(key := keys[i], value := values[6 - i]);
END_FOR

Assert.ThatBool(
	actual := _Dictionary.Full AND_THEN _Dictionary.Length = 7,
	message := "Refilling must reuse all seven slots"
).IsTrue();

FOR i := 0 TO 6 DO
	found := _Dictionary.TryGetValueByKey(key := keys[i], value => value);

	Assert.ThatBool(
		actual := found AND_THEN value.AsString255() = values[6 - i],
		message := TOF_Core.WideStrings.Concat255("Refill must return the new value at key ", TO_WSTRING(i))
	).IsTrue();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{e142757e-36e1-4efc-9e71-ea00db26bc9f}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Dictionary.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{9d1f8c3f-245e-4c22-9bf6-293e48e4ed90}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4e4fd5bf-a7b0-44fa-a55d-c6eaa596853f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{b82f7652-401e-4685-b1b1-5cf56b6af667}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d7b3fe56-cb90-4749-b1d1-90050807c550}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{74d25297-0ca7-4a66-a705-34bdb2cc7ba7}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f45c89d4-9822-4680-9aac-02b13aa8282b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
