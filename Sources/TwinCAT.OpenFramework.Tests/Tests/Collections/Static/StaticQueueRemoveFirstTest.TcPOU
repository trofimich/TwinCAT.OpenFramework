<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticQueueRemoveFirstTest" Id="{3d5070b5-8e68-47b2-a6e7-020eebf70030}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks FIFO removal through empty and reuse after a rejected removal.</summary>
<description>
Owns an inline queue and its copied entry payloads. Run from one task at a stable address.
Teardown clears surviving entries before publication, including after an aborted case.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticQueueRemoveFirstTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<3>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{5564be13-ebba-49d5-8620-1eab9da5961e}">
      <Declaration><![CDATA[(*!
<summary>Checks FIFO removal through empty and reuse after a rejected removal.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];

	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	emptyException : TOF_Core.ICollectionEmptyException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

_Queue.RemoveFirst();

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "The second entry must become the head after the first removal"
).ToBe(expected := values[2]);

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Removing the first entry must leave two entries"
).ToBe(expected := DINT#2);

_Queue.RemoveFirst();

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "The third entry must become the head after the second removal"
).ToBe(expected := values[3]);

_Queue.RemoveFirst();

Assert.ThatBool(
	actual := _Queue.Empty,
	message := "Removing the final entry must leave an empty queue"
).IsTrue();

__TRY
	_Queue.RemoveFirst();
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, emptyException),
	message := "Removing from an empty queue must raise CollectionEmptyException"
).IsTrue();

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Rejected removal must preserve empty length"
).ToBe(expected := DINT#0);

_Queue.EnqueueCopy(value := values[4]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Reuse after rejected removal must expose the new head"
).ToBe(expected := values[4]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{82c6ed31-d81a-4580-9cf9-5e296c6edcf4}">
      <Declaration><![CDATA[(*!
<summary>Restores the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{4653b40c-03f7-4427-9809-653d259d9816}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c1c90421-8f37-4a2d-869c-2a3a179c5f94}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{4dc59fa7-f0fe-4a60-9986-a4bf3ee49f72}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f484a2f9-7788-47d3-80a5-5b4e4bcd4756}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e7e02404-685d-4b39-a070-00ebd3602f19}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{77025def-ffb0-4d7a-a38c-f5bd4099f9cf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
