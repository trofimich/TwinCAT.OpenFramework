<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticQueueContainsTest" Id="{10eb6bdf-ff45-45cb-814e-bc35f9f88036}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks ANY lookup of present and absent values without changing the queue.

Owns an inline queue and its copied entry payloads. Run from one task at a stable address.
Teardown clears surviving entries before publication, including after an aborted case.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticQueueContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<3>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{6ca08d75-b40f-41ee-a222-a410ec11da41}">
      <Declaration><![CDATA[(* Checks ANY lookup of present and absent values without changing the queue. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(
	actual := _Queue.Contains(value := values[1]),
	message := "An empty queue must report absence"
).IsFalse();

_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

Assert.ThatBool(
	actual := _Queue.Contains(value := values[1]),
	message := "Contains must find the head"
).IsTrue();

Assert.ThatBool(
	actual := _Queue.Contains(value := values[3]),
	message := "Contains must find the tail"
).IsTrue();

Assert.ThatBool(
	actual := _Queue.Contains(value := values[4]),
	message := "Contains must report a missing value"
).IsFalse();

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Lookup must preserve all three entries"
).ToBe(expected := DINT#3);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Lookup must preserve the head"
).ToBe(expected := values[1]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{882b8915-1cd2-4693-9f98-ac13e60f97cf}">
      <Declaration><![CDATA[(*
Restores the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{94ca1d4e-ce19-437e-b189-2cfedc11d638}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{536cc435-ae5e-414e-9896-a528d704588e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{577a2ee3-20ad-4e67-8c4e-52618332b258}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4344842d-3c34-470a-95bf-73c6eacad22d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{da181fa0-28d0-4761-9633-70760fa6c31f}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{346f628c-7619-40e7-9e71-13d09df74cbe}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
