<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticQueueClearTest" Id="{b32e35c2-c9e2-4518-aeff-6025896aac24}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks populated clear, retained capacity and reuse.

Owns an inline queue and its copied entry payloads. Run from one task at a stable address.
Teardown clears surviving entries before publication, including after an aborted case.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticQueueClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<3>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{dd568d4e-3091-4c96-8f3e-c9f1bec43ed7}">
      <Declaration><![CDATA[(* Checks populated clear, retained capacity and reuse. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

Assert.ThatBool(
	actual := _Queue.Full AND_THEN _Queue.Length = 3,
	message := "The clear fixture must start full"
).IsTrue();

_Queue.Clear();

Assert.ThatBool(
	actual := _Queue.Empty AND_THEN _Queue.Length = 0 AND_THEN NOT _Queue.Full,
	message := "Clearing a populated queue must remove all entries"
).IsTrue();

Assert.ThatDInt(
	actual := _Queue.Capacity,
	message := "Clearing must preserve inline capacity"
).ToBe(expected := DINT#3);

Assert.ThatBool(
	actual := _Queue.Contains(value := values[3]),
	message := "Clearing must hide the previous tail"
).IsFalse();

_Queue.Clear();
_Queue.EnqueueCopy(value := values[4]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "The cleared queue must accept a fresh head"
).ToBe(expected := values[4]);

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Reuse must leave only the fresh entry"
).ToBe(expected := DINT#1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{1bef964f-6cda-45d8-8ccf-546e247ab8ed}">
      <Declaration><![CDATA[(*
Restores the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{95471341-d589-44ad-8e63-eeb3bd0bc8b6}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d3978b12-a053-406a-b822-75665d093c5f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{e0efab8a-6e8a-4916-937e-fff19009aa38}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0bde08d0-7421-4366-9207-fa15a6986173}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1317312d-7999-4b51-9688-6c23926d9d24}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{371cc403-32fc-44e7-8b85-c942270471a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
