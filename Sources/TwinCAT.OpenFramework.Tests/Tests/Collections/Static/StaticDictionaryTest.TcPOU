(*!
<summary>Exercises the StaticDictionaryTest collection scenarios.</summary>
<description>
Owns the suite's test collection and runs the existing TcUnit cases.
The collection is initialized explicitly with default key equality and hashing.
Temporary owned query descriptors request explicit release; changing query defaults does not
transfer those allocations to the test suite.
Lookup assertions use equality and current returned positions without assuming sorted order.
</description>
*)
FUNCTION_BLOCK StaticDictionaryTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	_KeyArray : ARRAY [0..6] OF INT := [0, 1, 2, 3, 4, 5, 6];
	_ValueArray : ARRAY [0..6] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	
	_Dictionary : TOF_Collections.Dictionary<7>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SetAndGet();
Remove();
Contains();
Clear();
Overflow();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{05b8b30a-5eaf-4836-92fb-e209450f1b4c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8c38b467-b3db-478b-8e84-88b05ae9889e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{b1b6e9b1-93d3-478e-8876-36be769b9fb7}">
      <Declaration><![CDATA[METHOD Clear 
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_Dictionary.Clear();

AssertEquals_DINT(Expected := 0, Actual := _Dictionary.Length, Message := 'Invalid element count after Clear');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{cc202b4b-70bb-4acb-ba1e-9a069ce8cad3}">
      <Declaration><![CDATA[(*!
<summary>Exercises lookup for present and absent values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
</description>
*)
METHOD Contains
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_Dictionary
	.SetCopy(_KeyArray[6], _ValueArray[6])
	.SetCopy(_KeyArray[5], _ValueArray[5])
	.SetCopy(_KeyArray[4], _ValueArray[4])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetCopy(_KeyArray[2], _ValueArray[2])
	.SetCopy(_KeyArray[1], _ValueArray[1])
	.SetCopy(_KeyArray[0], _ValueArray[0])
	.SetCopy(_KeyArray[3], _ValueArray[3]);

AssertEquals_BOOL(Expected := TRUE, Actual := _Dictionary.ContainsKey(_KeyArray[3]), Message := 'ContainsKey did not find the value');
AssertEquals_BOOL(Expected := TRUE, Actual := _Dictionary.ContainsGenericKey(TOF_Core.GenericValueFactory.FromIntValue(3), releaseKey := TRUE), Message := 'ContainsGenericKey did not find the value');
AssertEquals_BOOL(Expected := FALSE, Actual := _Dictionary.ContainsGenericKey(TOF_Core.GenericValueFactory.FromIntValue(9), releaseKey := TRUE), Message := 'ContainsGenericKey found not existing value');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{b6449487-ed2d-4918-99eb-16e565802f83}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d5e699af-6be7-430d-81a2-401abb7fb0ed}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Overflow" Id="{d82cfec5-01d6-438f-af98-9454c15bc6d4}">
      <Declaration><![CDATA[METHOD Overflow
VAR
	key : INT := 7;
	value : STRING := 'String7';
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_Dictionary
	.Clear()
	.SetCopy(_KeyArray[0], _ValueArray[0])
	.SetCopy(_KeyArray[1], _ValueArray[1])
	.SetCopy(_KeyArray[2], _ValueArray[2])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetCopy(_KeyArray[4], _ValueArray[4])
	.SetCopy(_KeyArray[5], _ValueArray[5])
	.SetCopy(_KeyArray[6], _ValueArray[6]);

__TRY
	_Dictionary.SetCopy(key, value);
	
	AssertFalse(TRUE, 'Static dictionary capacity overflow'); 
__CATCH
__ENDTRY

AssertEquals_DINT(Expected := 7, Actual := _Dictionary.Length, Message := 'Wrong static dictionary length');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Remove" Id="{3ddf5224-3e27-4885-9338-7d3deae35f88}">
      <Declaration><![CDATA[(*!
<summary>Exercises removal and the resulting collection state.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
Removes the intended element using its current position and checks removed/retained membership
rather than sorted ranks.
</description>
*)
METHOD Remove
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_Dictionary.SetCopy(_KeyArray[6], _ValueArray[6]);
_Dictionary.SetCopy(_KeyArray[5], _ValueArray[5]);
_Dictionary.SetCopy(_KeyArray[4], _ValueArray[4]);
_Dictionary.SetCopy(_KeyArray[3], _ValueArray[3]);
_Dictionary.SetCopy(_KeyArray[2], _ValueArray[2]);
_Dictionary.SetCopy(_KeyArray[1], _ValueArray[1]);
_Dictionary.SetCopy(_KeyArray[0], _ValueArray[0]);
_Dictionary.SetCopy(_KeyArray[3], _ValueArray[3]);

_Dictionary.RemoveAt(_Dictionary.GetKeyPosition(_KeyArray[3]));

AssertEquals_DINT(Expected := 6, Actual := _Dictionary.Length, Message := 'Invalid length after RemoveAt');
AssertEquals_BOOL(Expected := FALSE, Actual := _Dictionary.ContainsKey(_KeyArray[3]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _Dictionary.ContainsKey(_KeyArray[4]), Message := 'Removal lost a retained element');

_Dictionary.TryRemoveByKey(_KeyArray[2]);

AssertEquals_DINT(Expected := 5, Actual := _Dictionary.Length, Message := 'Invalid length after TryRemoveByKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _Dictionary.ContainsKey(_KeyArray[2]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _Dictionary.ContainsKey(_KeyArray[4]), Message := 'Removal lost a retained element');

_Dictionary.TryRemoveByGenericKey(TOF_Core.GenericValueFactory.FromIntValue(1), releaseKey := TRUE);

AssertEquals_DINT(Expected := 4, Actual := _Dictionary.Length, Message := 'Invalid length after TryRemoveByGenericKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _Dictionary.ContainsKey(_KeyArray[1]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _Dictionary.ContainsKey(_KeyArray[4]), Message := 'Removal lost a retained element');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAndGet" Id="{9b323c56-ab3f-43ed-bbea-4817a80ac202}">
      <Declaration><![CDATA[(*!
<summary>Exercises storing entries and retrieving their positions or values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
Raw and generic queries must return the same current position; indexed reads use a queried position
without assuming sorted order.
</description>
*)
METHOD SetAndGet
VAR
	genericValue : TOF_Core.GENERIC_VALUE;
	keyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_Dictionary
	.SetCopy(_KeyArray[6], _ValueArray[6])
	.SetCopy(_KeyArray[5], _ValueArray[5])
	.SetCopy(_KeyArray[4], _ValueArray[4])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetCopy(_KeyArray[2], _ValueArray[2])
	.SetCopy(_KeyArray[1], _ValueArray[1])
	.SetCopy(_KeyArray[0], _ValueArray[0])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetGeneric(TOF_Core.GenericValueFactory.FromIntValue(5), TOF_Core.GenericValueFactory.FromStringValue('String5'));

AssertEquals_DINT(Expected := 7, Actual := _Dictionary.Length, Message := 'Invalid length after Set');

AssertEquals_BOOL(Expected := TRUE, Actual := _Dictionary.GetKeyPosition(_KeyArray[2]) >= TOF_Core.SignedInt32.ZERO, Message := 'Lookup did not return a valid position');

AssertEquals_DINT(Expected := _Dictionary.GetKeyPosition(_KeyArray[2]), Actual := _Dictionary.GetGenericKeyPosition(TOF_Core.GenericValueFactory.FromIntValue(2), releaseKey := TRUE), Message := 'Raw and generic queries returned different positions');

_Dictionary.TryGetValueByKey(_KeyArray[2], value => genericValue);
AssertEquals_STRING(Expected := 'String2', Actual := genericValue.AsString255(), Message := 'Invalid element found by TryGetValueByKey');

_Dictionary.TryGetValueByGenericKey(TOF_Core.GenericValueFactory.FromIntValue(2), releaseKey := TRUE, value => genericValue);
AssertEquals_STRING(Expected := 'String2', Actual := genericValue.AsString255(), Message := 'Invalid element found by TryGetValueByGenericKey');

keyValuePair := _Dictionary.GetKeyValuePairByIndex(_Dictionary.GetKeyPosition(_KeyArray[3]));
AssertEquals_STRING(Expected := 'String3', Actual := keyValuePair.Value.AsString255(), Message := 'Invalid element position found by GetKeyValuePairByIndex');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>