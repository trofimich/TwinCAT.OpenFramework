<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="StaticDictionaryTest" Id="{414a2a1a-beaa-463d-a797-752b4af16ae1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
