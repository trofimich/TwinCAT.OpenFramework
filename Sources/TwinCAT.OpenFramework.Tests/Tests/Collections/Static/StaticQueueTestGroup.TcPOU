<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticQueueTestGroup" Id="{90d08ca2-ecad-4819-84ab-0582043b3ed0}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups fixed-capacity queue lookup, FIFO, clear and overflow cases.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticQueueTestGroup EXTENDS TOF_Testing.TestGroup<6>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Contains : StaticQueueContainsTest(name := "Contains", parent := THIS^);
	_ContainsGeneric : StaticQueueContainsGenericTest(name := "ContainsGeneric", parent := THIS^);
	_EnqueueAndPeek : StaticQueueEnqueueAndPeekTest(name := "EnqueueAndPeek", parent := THIS^);
	_Clear : StaticQueueClearTest(name := "Clear", parent := THIS^);
	_RemoveFirst : StaticQueueRemoveFirstTest(name := "RemoveFirst", parent := THIS^);
	_Overflow : StaticQueueOverflowTest(name := "Overflow", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_Contains,
		_ContainsGeneric,
		_EnqueueAndPeek,
		_Clear,
		_RemoveFirst,
		_Overflow
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{5b09ae71-9bba-433a-85d8-437010a6a85e}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{285f64ae-7a90-42dd-b9fe-109349f791a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{968580ad-0414-4740-a31c-accdfbe5c78d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{47778292-4dcf-49ee-a6fa-810b02de103d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ef516124-c0e0-4901-9a49-37dc2bd124cf}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{11c8ed2c-0607-483f-a959-7884e9981670}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{31b320c8-fcb0-4fa0-8a88-a770a9c6cdcf}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{dc083148-c170-4fe6-a0e3-bb0424b95081}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
