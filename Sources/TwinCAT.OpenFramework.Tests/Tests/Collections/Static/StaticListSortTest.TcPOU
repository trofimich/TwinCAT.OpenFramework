<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticListSortTest" Id="{51d42083-1ba6-41c3-9c5e-e61724ad606b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks ascending sorting of a full list with duplicate strings and reverse lookup.

Owns a list and its copied entries. Use from one task at a stable address.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticListSortTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.List<8>(valueValidator := 0);
	_Predicate : ListStringPredicate;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{1b29d960-ae20-4bae-8d3d-5409e3ba5a8c}">
      <Declaration><![CDATA[(* Checks ascending sorting of a full list with duplicate strings and reverse lookup. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	expected : ARRAY [0..7] OF STRING :=
		['String0', 'String1', 'String2', 'String2', 'String2', 'String3', 'String4', 'String5'];
	i : DINT;
	index : TOF_Core.DINT_INDEX;
	found : BOOL;
	entry : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[5]);
_List.AppendCopy(value := values[4]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[0]);

_List.Sort(comparer := TOF_Comparison.StandardComparers.StringComparer);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Ascending sort length"
).ToBe(expected := DINT#8);

FOR i := 0 TO 7 DO
	Assert.ThatString(
		actual := _List.Get(index := i).AsString255(),
		message := TOF_Core.WideStrings.Concat255("Ascending sort at index ", TO_WSTRING(i))
	).ToBe(expected := expected[i]);
END_FOR

_Predicate.Expected := 'String3';

found := _List.FindSingle(
	predicate := _Predicate,
	searchDirection := TOF_Core.SEARCH_DIRECTION.FROM_END,
	value => entry,
	index => index
);

Assert.ThatBool(
	actual := found AND_THEN index = 5 AND_THEN entry.AsString255() = 'String3',
	message := "Reverse lookup must return String3 at its current position after sorting"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{1eb7a9d1-f4b3-4c3d-b61b-106ec1b25383}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{82572386-b38c-4430-9477-4e0e8169ea1a}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3a5553e1-98c7-4021-91a0-5556ff11f2eb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{db22e762-906e-4993-8c49-dae5a6eb888f}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b07a5ebc-e5fc-4e4c-82e2-1684d158bd29}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6dbaf7ed-cdd7-461d-bafc-d258fe5c95d5}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ae0952d9-ca12-4be2-8e06-73e8c4370a88}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
