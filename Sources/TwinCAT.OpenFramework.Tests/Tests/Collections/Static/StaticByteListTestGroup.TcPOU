<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticByteListTestGroup" Id="{94c80802-b3f8-43a9-bdaa-a0d4f809151d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups fixed-capacity byte-list operations and overflow handling.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticByteListTestGroup EXTENDS TOF_Testing.TestGroup<7>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_LoadFromAny : ByteListLoadFromAnyTest(name := "LoadFromAny", parent := THIS^, useDynamicStorage := FALSE);
	_GetAndSet : ByteListIndexedAccessTest(name := "GetAndSet", parent := THIS^, useDynamicStorage := FALSE);
	_Find : ByteListFindTest(name := "Find", parent := THIS^, useDynamicStorage := FALSE);
	_Remove : ByteListRemoveValueTest(name := "Remove", parent := THIS^, useDynamicStorage := FALSE);
	_RemoveAt : ByteListRemoveRangeTest(name := "RemoveAt", parent := THIS^, useDynamicStorage := FALSE);
	_Clear : ByteListClearTest(name := "Clear", parent := THIS^, useDynamicStorage := FALSE);
	_Overflow : StaticByteListOverflowTest(name := "Overflow", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_LoadFromAny,
		_GetAndSet,
		_Find,
		_Remove,
		_RemoveAt,
		_Clear,
		_Overflow
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{3ae67d00-b05f-4c9c-8b9b-16dc6e1ed6cd}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{803e49c3-be78-416d-b30b-278a8e6fc51d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{ada866b6-9be8-4f0d-b3aa-bf513ade245a}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{10318d7d-1a67-472f-aa2c-de1b9db97933}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c70437a2-0697-4f34-818f-3330d47a7c3d}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{574a8d25-eae0-4889-a3bc-ed4489225b33}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{c32ca8af-be97-4ba4-80c6-717a23c29332}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{01f9f3f0-90bf-4df3-b53d-179cb6563414}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
