<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticQueueContainsGenericTest" Id="{c9b4bfa2-5d00-407e-baa7-45e6643577cf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks generic lookup with independent borrowed query values.</summary>
<description>
Owns an inline queue and its copied entry payloads. Run from one task at a stable address.
Teardown clears surviving entries before publication, including after an aborted case.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticQueueContainsGenericTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<3>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{0eaf32ad-d092-4556-9b9e-18aa92117da7}">
      <Declaration><![CDATA[(*!
<summary>Checks generic lookup with independent borrowed query values.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
	query : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[1]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must find the head"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[3]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must find the tail"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[4]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must report a missing value"
).IsFalse();

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Generic lookup must preserve queue length"
).ToBe(expected := DINT#3);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{54fdcb61-d812-4364-9601-40d54ab8e99d}">
      <Declaration><![CDATA[(*!
<summary>Restores the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a59aa705-657f-48d8-9e2b-01c763657ccc}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1566c06a-5ded-4574-becc-cfe81b0b62f9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a142418c-1db4-475f-8064-fdb2631afdee}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ea01f45a-56af-444f-b9eb-cdfb5966cf3b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{c54e5186-b72f-4dac-90f2-14f5cad553a5}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{f0562dbd-aa3a-4fd1-a380-bb85332e59ec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
