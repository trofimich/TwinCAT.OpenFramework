<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticStackClearTest" Id="{e10e6e5c-ca0e-4491-b6f3-5d2c0142301e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks populated clear, storage policy and reuse.</summary>
<description>
Owns a stack and its copied values at a stable address. Use from one task.
Teardown clears surviving entries before publication.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticStackClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.Stack<3>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{9006ca75-5835-45cf-b6d0-cdd835fe59d9}">
      <Declaration><![CDATA[(*!
<summary>Checks populated clear, storage policy and reuse.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.PushCopy(value := values[1]);
_Stack.PushCopy(value := values[2]);
_Stack.PushCopy(value := values[3]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Clear fixture must start with three entries"
).ToBe(expected := DINT#3);

_Stack.Clear();

Assert.ThatBool(
	actual := _Stack.Empty AND_THEN _Stack.Length = 0,
	message := "Clear must empty the stack"
).IsTrue();

Assert.ThatDInt(
	actual := _Stack.Capacity,
	message := "Clear must restore the expected storage capacity"
).ToBe(expected := DINT#3);

_Stack.Clear();
_Stack.PushCopy(value := values[4]);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "The cleared stack must expose the fresh top"
).ToBe(expected := values[4]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Reuse must leave only one entry"
).ToBe(expected := DINT#1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{922c4aa6-e268-48a3-88f3-14a4f59b8e8c}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{cfd23de4-15e4-4b8b-9eda-b5eae42b482e}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{acf09e1b-ed1c-4c5a-9610-ef97e496f69f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f0376c17-7f41-413c-9df5-faa21bd1eeb1}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4396035c-acc7-4834-a255-a12245d02692}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9f8df17a-0110-4934-b5ee-5e5b52d6b48e}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{10935a25-ed1a-4356-a7de-827cb0eaf44d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
