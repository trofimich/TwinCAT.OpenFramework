<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticListClearTest" Id="{c6d16eb9-05a4-4281-8698-b3716110839b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks clearing a full inline list and reusing all eight slots.

Owns a list and its copied entries. Use from one task at a stable address.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticListClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.List<8>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{79b93095-0092-4d76-b801-966996912c59}">
      <Declaration><![CDATA[(* Checks clearing a full inline list and reusing all eight slots. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[4]);
_List.AppendCopy(value := values[5]);
_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);

Assert.ThatBool(
	actual := _List.Full,
	message := "Clear fixture must start full"
).IsTrue();

_List.Clear();

Assert.ThatBool(
	actual := _List.Empty AND_THEN _List.Length = 0 AND_THEN _List.Capacity = 8 AND_THEN NOT _List.Full,
	message := "Clear must empty the list while retaining its inline capacity"
).IsTrue();

_List.AppendCopy(value := values[5]);
_List.AppendCopy(value := values[4]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[4]);

Assert.ThatBool(
	actual := _List.Full AND_THEN _List.Get(index := 0).AsString255() = 'String5'
		AND_THEN _List.Get(index := 7).AsString255() = 'String4',
	message := "Refill must occupy all slots with the new head and tail"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{7555bf15-e444-49b4-addc-73966e3154db}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{60016905-9b67-4996-8fc9-34baff405245}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{55a3fc10-015f-4e10-b9ee-be8a87f01704}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{15036c03-0604-4f5a-bbc5-fe7a09b249fd}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{07561c7f-fa14-4af1-b20c-91e7520cf389}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b2840a7b-c7ee-4a08-9b9e-491afa19fb44}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7d4dcd2b-cb2f-4cc0-b4ba-7ac148ce3356}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
