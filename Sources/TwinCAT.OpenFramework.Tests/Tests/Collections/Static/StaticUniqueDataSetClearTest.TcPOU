<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticUniqueDataSetClearTest" Id="{e6ef3022-5dc9-4c79-b0a6-b5287548122e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks clearing a full inline index and refilling with distinct values.

Owns a fixed-capacity set and copied values at a stable address. Run from one task.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticUniqueDataSetClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Set : TOF_Collections.UniqueDataSet<7>(valueValidator := 0, valueEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{c056d05c-4835-49fe-9711-23f84aebd11d}">
      <Declaration><![CDATA[(* Checks clearing a full inline index and refilling with distinct values. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..6] OF STRING :=
		['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	i : DINT;
	replacementValues : ARRAY [0..6] OF INT := [11, 12, 13, 14, 15, 16, 17];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 6 TO 0 BY -1 DO
	_Set.SetCopy(value := values[i]);
END_FOR

Assert.ThatBool(
	actual := _Set.Full AND_THEN _Set.Length = 7,
	message := "The clear fixture must start full"
).IsTrue();

_Set.Clear();

Assert.ThatBool(
	actual := _Set.Empty AND_THEN _Set.Length = 0 AND_THEN NOT _Set.Full,
	message := "Clearing a full set must make every slot available"
).IsTrue();

Assert.ThatDInt(
	actual := _Set.Capacity,
	message := "Clearing must preserve inline capacity"
).ToBe(expected := DINT#7);

FOR i := 0 TO 6 DO
	Assert.ThatBool(
		actual := _Set.Contains(value := values[i]),
		message := TOF_Core.WideStrings.Concat255("Clear must hide the old value at offset ", TO_WSTRING(i))
	).IsFalse();
END_FOR

FOR i := 0 TO 6 DO
	_Set.SetCopy(value := replacementValues[i]);
END_FOR

Assert.ThatBool(
	actual := _Set.Full AND_THEN _Set.Length = 7,
	message := "Refilling must reuse all seven slots"
).IsTrue();

FOR i := 0 TO 6 DO
	Assert.ThatBool(
		actual := _Set.Contains(value := replacementValues[i]),
		message := TOF_Core.WideStrings.Concat255("Refill must index value ", TO_WSTRING(replacementValues[i]))
	).IsTrue();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{c41766a4-84f4-4fb3-8832-5e854726f698}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Set.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{4a35889c-7fc0-4218-b286-95d4f08fbd76}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e83ad39f-e278-40ad-9ccf-4b2464d8267c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{9626d720-766e-4928-8d46-d88ace1390da}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4691424a-0ffa-40a2-9968-8538c51bf56a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1d0aba78-2e53-4512-b72c-f8572251da94}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e2e0b742-a622-4b9b-8211-7bc0c8d10609}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
