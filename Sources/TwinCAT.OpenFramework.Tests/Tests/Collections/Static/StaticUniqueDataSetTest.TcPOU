(*!
<summary>Exercises the StaticUniqueDataSetTest collection scenarios.</summary>
<description>
Owns the suite's test collection and runs the existing TcUnit cases. The collection is initialized explicitly
with default value equality and hashing. Temporary owned query descriptors request explicit release; changing
query defaults does not transfer those allocations to the test suite. Lookup assertions use equality and
current returned positions without assuming sorted order.
</description>
*)

FUNCTION_BLOCK StaticUniqueDataSetTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Values : ARRAY [0..6] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	
	_UniqueSet : TOF_Collections.UniqueDataSet<7>(valueValidator := 0, valueEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SetAndGet();
Remove();
Contains();
Clear();
Overflow();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{15e55c77-9154-4c4d-87c7-eda1a05acf26}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e78f4acf-7579-4979-b8b8-f4a825be587c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{d7d5d0b4-ac4c-4983-a6bd-a05c8756399c}">
      <Declaration><![CDATA[METHOD Clear 
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_UniqueSet.Clear();

AssertEquals_DINT(Expected := 0, Actual := _UniqueSet.Length, Message := 'Invalid length after Clear');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{3311b84f-6903-4d34-ba44-9ce5b337e23e}">
      <Declaration><![CDATA[(*!
<summary>Exercises lookup for present and absent values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch. Owned factory-created query descriptors
request explicit release so the test retains its cleanup behavior with borrowed query defaults.
</description>
*)
METHOD Contains
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_UniqueSet.Clear();

_UniqueSet
	.SetCopy(value := _Values[6])
	.SetCopy(value := _Values[5])
	.SetCopy(value := _Values[4])
	.SetCopy(value := _Values[3])
	.SetCopy(value := _Values[2])
	.SetCopy(value := _Values[1])
	.SetCopy(value := _Values[0])
	.SetCopy(value := _Values[3])
	.SetGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String3'))
	.SetGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String5'));

AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSet.Contains(value := _Values[3]), Message := 'Contains did not find the value');
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := _UniqueSet.ContainsGeneric(
			value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String3'),
			releaseValue := TRUE
		),
		Message := 'ContainsGeneric did not find the value'
	);
	AssertEquals_BOOL(
		Expected := FALSE,
		Actual := _UniqueSet.ContainsGeneric(
			value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String9'),
			releaseValue := TRUE
		),
		Message := 'Contains found not existing value'
	);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{2ba64839-de43-42d6-aaeb-1644211084db}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{780552f1-7328-4579-b3a0-8b9a2f9ba758}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Overflow" Id="{8b6c8d6a-be81-44be-8cfc-18a4d6d76fab}">
      <Declaration><![CDATA[(*!
<summary>Requires StaticCollectionFullException without accepting an extra entry.</summary>
<description>Checks the exception category and a positive caught flag outside the protected call.</description>
*)
METHOD Overflow
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	expectedException : TOF_Core.IStaticCollectionFullException;
	rejected : BOOL;
END_VAR
VAR
	values : ARRAY [1..8] OF INT := [1, 2, 3, 4, 5, 6, 7, 8];
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_UniqueSet
	.Clear()
	.SetCopy(value := values[1])
	.SetCopy(value := values[2])
	.SetCopy(value := values[3])
	.SetCopy(value := values[4])
	.SetCopy(value := values[5])
	.SetCopy(value := values[6])
	.SetCopy(value := values[7]);

__TRY
	_UniqueSet.SetCopy(value := values[8]);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedException),
		Message := 'Static overflow must raise StaticCollectionFullException'
	);
	rejected := TRUE;
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Full static collection must reject insertion');

AssertEquals_DINT(Expected := 7, Actual := _UniqueSet.Length, Message := 'Wrong static unique set length');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Remove" Id="{5dbd7cb1-b4b4-409b-b6cc-ce5e0ef07de0}">
      <Declaration><![CDATA[(*!
<summary>Exercises removal and the resulting collection state.</summary>
<description>
Runs once per suite instance through the existing testFinished latch. Owned factory-created query descriptors
request explicit release so the test retains its cleanup behavior with borrowed query defaults. Removes the
intended element using its current position and checks removed/retained membership rather than sorted ranks.
</description>
*)
METHOD Remove
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_UniqueSet.Clear();

_UniqueSet.SetCopy(value := _Values[6]);
_UniqueSet.SetCopy(value := _Values[5]);
_UniqueSet.SetCopy(value := _Values[4]);
_UniqueSet.SetCopy(value := _Values[3]);
_UniqueSet.SetCopy(value := _Values[2]);
_UniqueSet.SetCopy(value := _Values[1]);
_UniqueSet.SetCopy(value := _Values[0]);
_UniqueSet.SetCopy(value := _Values[3]);
_UniqueSet.SetGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String3'));
_UniqueSet.SetGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String5'));

_UniqueSet.RemoveAt(index := _UniqueSet.GetValuePosition(value := _Values[3]));

AssertEquals_DINT(Expected := 6, Actual := _UniqueSet.Length, Message := 'Invalid length after RemoveAt');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSet.Contains(value := _Values[3]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSet.Contains(value := _Values[4]), Message := 'Removal lost a retained element');

_UniqueSet.TryRemove(value := _Values[2]);

AssertEquals_DINT(Expected := 5, Actual := _UniqueSet.Length, Message := 'Invalid length after TryRemoveByKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSet.Contains(value := _Values[2]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSet.Contains(value := _Values[4]), Message := 'Removal lost a retained element');

_UniqueSet.TryRemoveGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String1'), releaseValue := TRUE);

AssertEquals_DINT(Expected := 4, Actual := _UniqueSet.Length, Message := 'Invalid length after TryRemoveByGenericKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSet.Contains(value := _Values[1]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSet.Contains(value := _Values[4]), Message := 'Removal lost a retained element');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAndGet" Id="{c195ea45-5a56-4579-8b1b-13372b0e3345}">
      <Declaration><![CDATA[(*!
<summary>Exercises storing entries and retrieving their positions or values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch. Owned factory-created query descriptors
request explicit release so the test retains its cleanup behavior with borrowed query defaults. Raw and
generic queries must return the same current position; indexed reads use a queried position without assuming
sorted order.
</description>
*)
METHOD SetAndGet
VAR
	genericValue : TOF_Core.GENERIC_VALUE;
	keyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_UniqueSet.Clear();

_UniqueSet.SetCopy(value := _Values[6]);
_UniqueSet.SetCopy(value := _Values[5]);
_UniqueSet.SetCopy(value := _Values[4]);
_UniqueSet.SetCopy(value := _Values[3]);
_UniqueSet.SetCopy(value := _Values[2]);
_UniqueSet.SetCopy(value := _Values[1]);
_UniqueSet.SetCopy(value := _Values[0]);
_UniqueSet.SetCopy(value := _Values[3]);
_UniqueSet.SetGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String3'));
_UniqueSet.SetGeneric(value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String5'));

AssertEquals_DINT(Expected := 7, Actual := _UniqueSet.Length, Message := 'Invalid length after Set');

	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := _UniqueSet.GetValuePosition(value := _Values[2]) >= TOF_Core.SignedInt32.ZERO,
		Message := 'Lookup did not return a valid position'
	);

	AssertEquals_DINT(
		Expected := _UniqueSet.GetValuePosition(value := _Values[2]),
		Actual := _UniqueSet.GetGenericValuePosition(
			value := TOF_Core.GenericValueFactory.FromStringValue(value := 'String2'),
			releaseValue := TRUE
		),
		Message := 'Raw and generic queries returned different positions'
	);

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>