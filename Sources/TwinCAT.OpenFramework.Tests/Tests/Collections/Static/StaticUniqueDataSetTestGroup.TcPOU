<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticUniqueDataSetTestGroup" Id="{e776c5d9-fae3-438b-932c-b9724441f05f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups fixed-capacity set lookup, duplicate updates, removal, clear and overflow cases.

Owns the child cases, their fixed registration array and the sets borrowed by the common cases.
Each borrowed fixture is reserved for its case throughout the group lifetime. Use from one task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticUniqueDataSetTestGroup EXTENDS TOF_Testing.TestGroup<5>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_SetAndGetSet : TOF_Collections.UniqueDataSet<7>(valueValidator := 0, valueEqualityComparer := 0);
	_RemoveSet : TOF_Collections.UniqueDataSet<7>(valueValidator := 0, valueEqualityComparer := 0);
	_ContainsSet : TOF_Collections.UniqueDataSet<7>(valueValidator := 0, valueEqualityComparer := 0);

	_SetAndGet : UniqueDataSetSetAndGetTest(name := "SetAndGet", parent := THIS^, dataSet := _SetAndGetSet);
	_Remove : UniqueDataSetRemoveTest(name := "Remove", parent := THIS^, dataSet := _RemoveSet);
	_Contains : UniqueDataSetContainsTest(name := "Contains", parent := THIS^, dataSet := _ContainsSet);
	_Clear : StaticUniqueDataSetClearTest(name := "Clear", parent := THIS^);
	_Overflow : StaticUniqueDataSetOverflowTest(name := "Overflow", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_SetAndGet,
		_Remove,
		_Contains,
		_Clear,
		_Overflow
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{ae4e119c-508a-4844-a523-0deaf9abda25}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{dd6424ff-0a66-4bbc-abf3-1cdf99bc8c1e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{4a01cfa7-1834-4260-b272-fe4d4d103710}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4270b458-76d6-400e-bdd0-c717f5adab15}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{3b3491e1-2442-42ea-b394-4ebc351e7883}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ebca6d5b-bf71-4297-b2bb-addc82729258}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{07aa712f-d4b9-4b02-92ba-bc742fb31144}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{de8eaf45-1ba3-4e9b-928e-7d4eecef4845}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
