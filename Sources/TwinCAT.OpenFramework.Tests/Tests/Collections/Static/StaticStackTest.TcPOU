<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="StaticStackTest" Id="{43db728b-4b44-46a0-8341-a1591c75c7d3}" SpecialFunc="None">
    <Declaration><![CDATA[(*
