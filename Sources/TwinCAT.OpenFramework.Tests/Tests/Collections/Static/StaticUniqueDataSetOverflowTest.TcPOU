<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticUniqueDataSetOverflowTest" Id="{e27aff04-523f-4ba5-a230-19cbb5f9a215}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks rejection of a new value at capacity and reuse after removal.

Owns a fixed-capacity set and copied values at a stable address. Run from one task.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticUniqueDataSetOverflowTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Set : TOF_Collections.UniqueDataSet<7>(valueValidator := 0, valueEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{0d1554ab-5280-488e-9e33-95123576f2ad}">
      <Declaration><![CDATA[(* Checks rejection of a new value at capacity and reuse after removal. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..8] OF INT := [1, 2, 3, 4, 5, 6, 7, 8];
	i : DINT;
	removed : BOOL;

	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	fullException : TOF_Core.IStaticCollectionFullException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 7 DO
	_Set.SetCopy(value := values[i]);
END_FOR

Assert.ThatBool(
	actual := _Set.Full AND_THEN _Set.Length = 7,
	message := "The overflow fixture must start full"
).IsTrue();

__TRY
	_Set.SetCopy(value := values[8]);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, fullException),
	message := "Adding a new value at capacity must raise StaticCollectionFullException"
).IsTrue();

Assert.ThatBool(
	actual := _Set.Full AND_THEN _Set.Length = 7 AND_THEN _Set.Capacity = 7,
	message := "Rejected insertion must preserve full length and capacity"
).IsTrue();

Assert.ThatBool(
	actual := _Set.Contains(value := values[8]),
	message := "The rejected value must remain absent"
).IsFalse();

FOR i := 1 TO 7 DO
	Assert.ThatBool(
		actual := _Set.Contains(value := values[i]),
		message := TOF_Core.WideStrings.Concat255("Overflow must preserve member ", TO_WSTRING(i))
	).IsTrue();
END_FOR

_Set.TryRemove(value := values[3], removed => removed);

Assert.ThatBool(
	actual := removed,
	message := "Removing a stored member must free a slot"
).IsTrue();

_Set.SetCopy(value := values[8]);

Assert.ThatBool(
	actual := _Set.Full AND_THEN _Set.Length = 7 AND_THEN _Set.Contains(value := values[8]),
	message := "Reusing a slot must make the new member visible"
).IsTrue();

Assert.ThatBool(
	actual := _Set.Contains(value := values[3]),
	message := "Reusing the slot must keep the removed member absent"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{b9611557-efef-4ce7-bed6-1976e94643b7}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Set.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{5b0bbb62-c42a-436f-9adf-5a65e2d1a276}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{98e9afea-c380-4833-a1c8-2c950b881657}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{3c516487-8b36-45fe-b7f6-fcee402c9336}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3c852d3d-f58e-4249-acb6-07d72353feee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{4af705f7-1a3e-4e17-803f-d5e4201ba4f6}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4bb8e385-1810-42fc-b9b5-d9367adb0a56}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
