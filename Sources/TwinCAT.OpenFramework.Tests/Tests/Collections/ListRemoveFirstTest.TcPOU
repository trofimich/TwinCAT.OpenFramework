<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ListRemoveFirstTest" Id="{55c37f73-046d-4f54-898f-4c3c10828c4f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks that removing by value removes only the first matching occurrence.</summary>
<description>
Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListRemoveFirstTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{b90ed6e3-28e0-4861-94d9-71aa3bf4ae3a}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{429df3ea-2d28-4076-8c18-9adbed1769f5}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{74a27145-60e3-4a6a-ad19-0d444555a634}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{b939c912-3dbd-4b3d-9644-127c8565437e}">
      <Declaration><![CDATA[(*!
<summary>Checks that removing by value removes only the first matching occurrence.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	expected : ARRAY [0..4] OF STRING := ['String0', 'String1', 'String3', 'String4', 'String2'];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[4]);
_List.AppendCopy(value := values[2]);

_List.RemoveFirst(value := values[2]);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Unexpected sequence after RemoveFirst length"
).ToBe(expected := DINT#5);

FOR i := 0 TO 4 DO
	Assert.ThatString(
		actual := _List.Get(index := i).AsString255(),
		message := TOF_Core.WideStrings.Concat255("Unexpected sequence after RemoveFirst at index ", TO_WSTRING(i))
	).ToBe(expected := expected[i]);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{fc92f6b8-5da8-4e51-a425-8a9ff97169b8}">
      <Declaration><![CDATA[(*!
<summary>Binds the list fixture for this case.</summary>
<description>
Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.
</description>
<param name="name">Display name of this case.</param>
<param name="parent">Group that owns this case.</param>
<param name="list">Required live list reserved for this case.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{ef378430-f6c2-4f6f-8ec3-a47cba794eca}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{87c7c6f7-d858-4869-a5be-3052e01de41f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{537dc765-7bcc-4dad-96d3-3b311dea2011}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{47fae348-63ec-4198-b85a-dafe86e8a655}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>