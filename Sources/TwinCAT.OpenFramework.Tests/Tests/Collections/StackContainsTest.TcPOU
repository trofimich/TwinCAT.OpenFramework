<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="StackContainsTest" Id="{80e60297-9d78-4565-8d32-876b091a8528}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks raw membership without changing LIFO order.

Borrows a group-owned stack reserved for this case. Use from one task at a stable address.
Teardown clears the stack and test-owned resources before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StackContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{641a6d8e-f8ad-453f-a92f-8bf85785b590}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{3701ee6a-5b6f-4245-a2c3-02b143b51988}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0cc70852-ef34-47a4-ad43-3a207a287e87}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{5302e7c1-15e5-4c2b-98c8-c5cbdd9a547d}">
      <Declaration><![CDATA[(* Checks raw membership without changing LIFO order. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Assert.ThatBool(
	actual := _Stack.Contains(value := values[1]),
	message := "An empty stack must report absence"
).IsFalse();

_Stack.PushCopy(value := values[1]);
_Stack.PushCopy(value := values[2]);
_Stack.PushCopy(value := values[3]);

Assert.ThatBool(
	actual := _Stack.Contains(value := values[1]),
	message := "Contains must find the bottom value"
).IsTrue();

Assert.ThatBool(
	actual := _Stack.Contains(value := values[3]),
	message := "Contains must find the top value"
).IsTrue();

Assert.ThatBool(
	actual := _Stack.Contains(value := values[4]),
	message := "Contains must reject an absent value"
).IsFalse();

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Lookup must preserve all three entries"
).ToBe(expected := DINT#3);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{3b596234-5fbf-4a79-bab8-49688380f6c0}">
      <Declaration><![CDATA[(*
Binds the stack fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
stack — Required live stack reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack := stack;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{7661b4a4-b296-42fd-9426-1f70450980e7}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c87ff028-cd82-4ab9-adc3-019b85856239}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1224eca4-50ac-4146-a465-8d4b0d2023d9}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{dc9ed70d-1e23-4438-89c8-f1a7728e2ca2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>