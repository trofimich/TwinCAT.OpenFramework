(*!
<summary>Checks middle-range compaction and exact suffix deletion.</summary>
<description>
Runs against the selected fixture. The base case clears it before publishing the result.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ByteListRemoveRangeTest EXTENDS ByteListTestCase
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{32e81140-df42-430d-9655-cb9d6d0bda8b}">
      <Declaration><![CDATA[(*!
<summary>Checks middle-range compaction and exact suffix deletion.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF BYTE := [0, 1, 2, 3, 4, 5];
	expected : ARRAY [0..3] OF BYTE := [0, 1, 4, 5];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendAny(data := values);
_List.RemoveAt(index := 2, count := 2);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Removing two middle bytes must leave four bytes"
).ToBe(expected := DINT#4);

FOR i := 0 TO 3 DO
	Assert.ThatBool(
		actual := _List.Get(index := i) = expected[i],
		message := "The remaining bytes must stay in order"
	).IsTrue();
END_FOR

_List.RemoveAt(index := 2, count := 2);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Removing through the end must preserve the prefix length"
).ToBe(expected := DINT#2);

Assert.ThatBool(
	actual := _List.Get(index := 0) = BYTE#0 AND_THEN _List.Get(index := 1) = BYTE#1,
	message := "Removing the suffix must preserve the prefix bytes"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{97b2df53-c75c-42a2-99cc-884bd773d67d}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ed4a01fe-b393-4bb8-9061-9121c6f5bb3c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a6aff22b-afdc-4499-a93b-c9f96c2e5823}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4d9d0d58-60fc-43d0-ba39-f0fbba69597d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{79ab6a3f-06e1-4c92-ae40-32197ac4bb74}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{518c44d8-c12c-45df-823f-f46a798a885b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
