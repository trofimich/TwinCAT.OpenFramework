<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListRemoveRangeTest" Id="{85677b9c-7284-45b6-910e-b5fc62d95225}" SpecialFunc="None">
    <Declaration><![CDATA[(*
