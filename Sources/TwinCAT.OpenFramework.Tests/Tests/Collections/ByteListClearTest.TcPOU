<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListClearTest" Id="{90610b4f-1d51-4332-bca8-f4e647c7c685}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks retained storage reuse and explicit release behavior.

Runs against the selected fixture. The base case clears it before publishing the result.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ByteListClearTest EXTENDS ByteListTestCase
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{fd24efb5-f13a-4719-b536-65c4c09cfcf5}">
      <Declaration><![CDATA[(* Checks retained storage reuse and explicit release behavior. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF BYTE := [0, 1, 2, 3, 4, 5];
	capacity : TOF_Core.DINT_LENGTH;
	buffer : POINTER TO BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendAny(data := values);
capacity := _List.Capacity;
buffer := GetBufferAddress();

Assert.ThatBool(
	actual := capacity >= 6 AND_THEN buffer <> TOF_Core.Memory.NULL_ADDRESS,
	message := "Appending six bytes must provide backing storage"
).IsTrue();

_List.Clear(releaseDynamicMemory := FALSE);

Assert.ThatBool(
	actual := _List.Empty AND_THEN _List.Capacity = capacity AND_THEN GetBufferAddress() = buffer,
	message := "Clear without release must empty the list while retaining storage"
).IsTrue();

_List.AppendByte(value := BYTE#255);

Assert.ThatBool(
	actual := _List.Length = 1
		AND_THEN _List.Get(index := 0) = BYTE#255
		AND_THEN GetBufferAddress() = buffer,
	message := "Appending after a clear must reuse the retained buffer"
).IsTrue();

_List.Clear(releaseDynamicMemory := TRUE);

Assert.ThatBool(
	actual := _List.Empty,
	message := "Clear with release must empty the list"
).IsTrue();

IF _UseDynamicStorage THEN
	Assert.ThatBool(
		actual := _List.Capacity = 0 AND_THEN GetBufferAddress() = TOF_Core.Memory.NULL_ADDRESS,
		message := "Clear with release must drop the dynamic allocation"
	).IsTrue();
ELSE
	Assert.ThatBool(
		actual := _List.Capacity = 12 AND_THEN GetBufferAddress() = buffer,
		message := "Clear with release must preserve the inline allocation"
	).IsTrue();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b27e2811-9e96-4592-b791-c57ffac47a3c}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c1ab7128-844d-47ab-b893-00a913cb89c3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a680da2f-7a04-477c-9353-6b33f310286f}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{41032232-53be-426b-be07-fb7d2872b92e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{28c65537-b25c-42c6-b24c-7290c8efb4c1}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{fe994a10-a8f2-4574-8557-de5baa820104}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
