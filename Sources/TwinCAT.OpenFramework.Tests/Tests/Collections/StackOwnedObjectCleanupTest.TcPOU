<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StackOwnedObjectCleanupTest" Id="{d32087ff-b069-4d40-9358-bde4028b6eda}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks ownership transfer and exactly-once disposal on removal and clear.

Borrows a group-owned stack reserved for this case. Use from one task at a stable address.
Teardown clears the stack and test-owned resources before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StackOwnedObjectCleanupTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.IStack;
	_Probe : POINTER TO ObjectExitProbe;
	_ExitCount : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{22a81d9a-20b6-400d-afb8-3085c12e769c}">
      <Declaration><![CDATA[(*
Binds the stack fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
stack — Required live stack reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack := stack;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{55b35553-6285-40d7-9272-f0c34e0b80b8}">
      <Declaration><![CDATA[(* Checks ownership transfer and exactly-once disposal on removal and clear. *)
METHOD PROTECTED ExecuteTest
VAR
	i : DINT;
	entry : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ExitCount := TOF_Core.UnsignedInt32.ZERO;

FOR i := 1 TO 2 DO
	_Probe := __NEW(ObjectExitProbe);

	IF _Probe = TOF_Core.Memory.NULL_ADDRESS THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();

		RETURN;
	END_IF

	_Probe^.ObserveExit(counter := _ExitCount);
	entry := TOF_Core.GenericValueFactory.FromAnyType(
		value := _Probe^,
		isObject := TRUE,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
	);

	_Stack.PushGeneric(value := entry);
	_Probe := 0;
	entry.Reset();
END_FOR

Assert.ThatUDInt(
	actual := _ExitCount,
	message := "Insertion must keep the adopted objects alive"
).ToBe(expected := UDINT#0);

_Stack.RemoveLast();

Assert.ThatUDInt(
	actual := _ExitCount,
	message := "RemoveLast must destroy only the top object"
).ToBe(expected := UDINT#1);

_Stack.Clear();

Assert.ThatUDInt(
	actual := _ExitCount,
	message := "Clear must destroy the remaining object"
).ToBe(expected := UDINT#2);

_Stack.Clear();

Assert.ThatUDInt(
	actual := _ExitCount,
	message := "A second Clear must not destroy an object twice"
).ToBe(expected := UDINT#2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{bd9e97c9-3d85-4025-a72e-06c41cfb593d}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();

IF _Probe <> TOF_Core.Memory.NULL_ADDRESS THEN
	__DELETE(_Probe);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{96adb159-3eea-4bdc-9238-e979a7dfd986}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3dee09ec-eb74-4ed2-ae1a-16a696444bfa}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{7999e219-c38e-4d92-9520-209129523a94}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ac10a7bc-914f-458b-9722-925b4ffe3131}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{527d97dc-d8c2-4124-b915-afe5c9d21caf}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{acc6ff12-a389-4f1d-941b-0a79c084f030}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
