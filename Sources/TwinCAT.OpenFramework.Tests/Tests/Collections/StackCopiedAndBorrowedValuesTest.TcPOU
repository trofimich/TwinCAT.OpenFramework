<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="StackCopiedAndBorrowedValuesTest" Id="{7a6a2524-575f-4e68-8748-0298ca0c0fc2}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks copy isolation and the lifetime of a borrowed entry.

Borrows a group-owned stack reserved for this case. Use from one task at a stable address.
Teardown clears the stack and test-owned resources before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StackCopiedAndBorrowedValuesTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.IStack;
	_SourceValue : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{039205af-7a1b-4030-87cb-f2628bbedcf3}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{e77cca29-49af-47ff-9072-95e58eea69c4}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bcb4e491-9869-4c5b-a228-c129637c378d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{ca86fe69-ac16-4dc2-a691-db5ee98a42fc}">
      <Declaration><![CDATA[(* Checks copy isolation and the lifetime of a borrowed entry. *)
METHOD PROTECTED ExecuteTest
VAR
	query : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SourceValue := 7;
_Stack.PushCopy(value := _SourceValue);
_SourceValue := 9;

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "PushCopy must isolate the value from later source writes"
).ToBe(expected := INT#7);

query := TOF_Core.GenericValueFactory.FromIntReference(value := _SourceValue);
_Stack.PushGeneric(value := query);
_SourceValue := 11;

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "PushGeneric must observe the current value in borrowed storage"
).ToBe(expected := INT#11);

Assert.ThatBool(
	actual := NOT _Stack.Peek().IsMemoryOwner AND_THEN _Stack.Peek().Address = query.Address,
	message := "The stored descriptor must retain the borrowed address and ownership mode"
).IsTrue();

Assert.ThatBool(
	actual := _Stack.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Borrowed lookup must find the top"
).IsTrue();

_Stack.RemoveLast();

Assert.ThatInt(
	actual := _SourceValue,
	message := "Removing a borrowed entry must preserve its source"
).ToBe(expected := INT#11);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "Removing the borrowed entry must reveal the copy"
).ToBe(expected := INT#7);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{e155ef1c-a70b-4f64-8013-3c63e03703ee}">
      <Declaration><![CDATA[(*
Binds the stack fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
stack — Required live stack reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack := stack;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{97da9e1f-fbb5-4291-b493-9847cfc279f4}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{235c04e5-c08f-4551-904f-a8c02deda7de}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{05173312-1609-4c3f-8d5e-35c75bd144c8}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{071bdc44-b875-433a-9a02-f52914d81efd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>