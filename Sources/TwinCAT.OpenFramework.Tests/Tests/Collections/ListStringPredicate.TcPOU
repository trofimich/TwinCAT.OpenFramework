<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ListStringPredicate" Id="{66a0f818-a984-4b29-9d7f-3e5bce24afe1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Matches a borrowed STRING against an expected value.

Keeps only the expected text. Check reads each candidate synchronously and makes no allocations.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListStringPredicate EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IPredicate
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR_INPUT
	// Value matched by the next Check call.
	Expected : STRING;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Check" Id="{3119dc32-d310-4642-957f-8ebecbaa4fd7}">
      <Declaration><![CDATA[(*
Compares a live STRING candidate with the expected text.

The input is borrowed for this call and its address is discarded on return.
*)
METHOD Check : BOOL
VAR_INPUT
	valueToCompare : __SYSTEM.AnyType;
END_VAR
VAR
	candidate : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[candidate := TOF_Core.GenericValueFactory.FromAnyType(
	value := valueToCompare,
	isObject := FALSE,
	memoryManagementBehavior :=
		TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);

Check := candidate.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.STRING_8
	AND_THEN candidate.AsString255() = Expected;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ef0a841d-4565-4273-992b-59410306d4e4}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{68b12394-5f3b-407d-993a-d0fe7d167eea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{80a534f2-30b6-47b5-9275-21b734667e8a}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{30062c6c-d8d6-4bbb-8a2c-37b9b579c799}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{59736243-7bfd-4195-8aa1-8215d866e6c3}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4e39c0c4-b96e-4195-b931-239b5647d7bf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
