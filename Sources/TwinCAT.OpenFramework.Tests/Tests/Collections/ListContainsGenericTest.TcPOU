<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ListContainsGenericTest" Id="{90ec3da0-9004-401a-899b-25be58e1ffaf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks generic membership using borrowed queries.

Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListContainsGenericTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{26c09c19-5164-4889-9c36-ce2fd1de1b2e}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{075af895-6f91-45ef-96dc-5daddd70639d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{133b9253-3d25-4f74-a093-616fa0eaae03}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{14a67d02-6f48-44c8-8d93-c151a6f84f3e}">
      <Declaration><![CDATA[(* Checks generic membership using borrowed queries. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	entry : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);

entry := TOF_Core.GenericValueFactory.FromStringReference(value := values[1]);
Assert.ThatBool(
	actual := _List.ContainsGeneric(value := entry, releaseValue := FALSE),
	message := "ContainsGeneric must find String1"
).IsTrue();

entry := TOF_Core.GenericValueFactory.FromStringReference(value := values[3]);
Assert.ThatBool(
	actual := _List.ContainsGeneric(value := entry, releaseValue := FALSE),
	message := "ContainsGeneric must find the duplicated String3"
).IsTrue();

entry := TOF_Core.GenericValueFactory.FromStringReference(value := values[5]);
Assert.ThatBool(
	actual := _List.ContainsGeneric(value := entry, releaseValue := FALSE),
	message := "ContainsGeneric must reject absent String5"
).IsFalse();

Assert.ThatDInt(
	actual := _List.Length,
	message := "ContainsGeneric must preserve all entries"
).ToBe(expected := DINT#6);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{d9a625d8-e513-463f-bf9f-9347e5520990}">
      <Declaration><![CDATA[(*
Binds the list fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
list — Required live list reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{6be15006-49e9-496f-ae9b-2e93c16c02f6}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0b0b9484-86de-43f5-b403-104904657ab7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{562703c4-6d3e-41f6-9726-14bdfd3c76a0}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e595d5b5-0e2c-48a8-8ff3-23ec3dbba152}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>