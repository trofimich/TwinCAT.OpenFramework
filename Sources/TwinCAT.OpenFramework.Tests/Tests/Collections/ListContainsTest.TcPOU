<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ListContainsTest" Id="{4e572c2b-d3f2-4069-8645-cb9b98b97e19}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks raw membership for a present value, a duplicate and an absent value.</summary>
<description>
Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{22a9a27f-5d98-411a-bf5c-7799bc06cb48}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{bcc02f0c-9259-440a-ac30-ef24d4aaebcf}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6fa25821-cd78-4169-abca-20e26186231c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{0d229432-fe9d-4562-a4bd-df8ea223f500}">
      <Declaration><![CDATA[(*!
<summary>Checks raw membership for a present value, a duplicate and an absent value.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);

Assert.ThatBool(
	actual := _List.Contains(value := values[1]),
	message := "Contains must find String1"
).IsTrue();

Assert.ThatBool(
	actual := _List.Contains(value := values[3]),
	message := "Contains must find the duplicated String3"
).IsTrue();

Assert.ThatBool(
	actual := _List.Contains(value := values[5]),
	message := "Contains must reject absent String5"
).IsFalse();

Assert.ThatDInt(
	actual := _List.Length,
	message := "Contains must preserve all entries"
).ToBe(expected := DINT#6);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{8cee251b-f924-41e4-8ccd-c87186da2a88}">
      <Declaration><![CDATA[(*!
<summary>Binds the list fixture for this case.</summary>
<description>
Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.
</description>
<param name="name">Display name of this case.</param>
<param name="parent">Group that owns this case.</param>
<param name="list">Required live list reserved for this case.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{e4e4ee70-7fb3-43c3-bbe7-05962ae7d1b8}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{94163645-03c3-4151-8911-813a5f6a2fef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{9c1674a6-87c2-45c8-b3b9-37aa9322c16d}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6e286d69-c010-4365-a521-657efb6f199b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>