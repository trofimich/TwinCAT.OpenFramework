<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ListInsertGenericTest" Id="{a891092b-b113-4fe5-b8df-2b790337f86c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks borrowed insertion and suffix order.

Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListInsertGenericTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
	_Values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{d871ea64-d23b-4c82-aaeb-3d7dc9498a33}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b9a445c9-0c26-41ea-83ef-4363970ae4f6}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{21f43e13-6a92-4502-8b5d-b0c4426fd9e8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{d98307c1-5348-4e4d-9f0f-b4026c96405b}">
      <Declaration><![CDATA[(* Checks borrowed insertion and suffix order. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	entry : TOF_Core.GENERIC_VALUE;
	expected : ARRAY [0..3] OF STRING := ['String0', 'String5', 'String1', 'String2'];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);

entry := TOF_Core.GenericValueFactory.FromStringReference(value := _Values[5]);
_List.InsertGeneric(index := 1, value := entry);

Assert.ThatBool(
	actual := _List.Get(index := 1).Address = entry.Address AND_THEN NOT _List.Get(index := 1).IsMemoryOwner,
	message := "InsertGeneric must retain the borrowed address and ownership mode"
).IsTrue();

Assert.ThatDInt(
	actual := _List.Length,
	message := "Unexpected sequence after InsertGeneric length"
).ToBe(expected := DINT#4);

FOR i := 0 TO 3 DO
	Assert.ThatString(
		actual := _List.Get(index := i).AsString255(),
		message := TOF_Core.WideStrings.Concat255("Unexpected sequence after InsertGeneric at index ", TO_WSTRING(i))
	).ToBe(expected := expected[i]);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{57377cf7-f0ed-43b5-963c-952546b74892}">
      <Declaration><![CDATA[(*
Binds the list fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
list — Required live list reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{ed790d17-072b-474b-9588-e7092f3bce22}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{93757623-7925-46bb-8a23-115ba1095b2d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{903528cb-512a-4514-bdea-aa43d59524ea}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{fe8e677f-5cc0-4a55-aace-251d18743d4d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>