<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ListAppendGenericTest" Id="{d76a51f8-1bde-4649-894c-1b3f4ac84c18}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks appending borrowed strings without cloning or adopting them.</summary>
<description>
Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListAppendGenericTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
	_Values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{a6384dd6-71b2-4fdd-b321-fd789b0700b4}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{e41e2042-4bcf-4a03-9541-16943de94002}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{db35fee2-f56b-4eb8-9859-c9b1d57bfaff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{8d11b09c-5579-40e3-a1dc-cde2bb4b2f98}">
      <Declaration><![CDATA[(*!
<summary>Checks appending borrowed strings without cloning or adopting them.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	entry : TOF_Core.GENERIC_VALUE;
	expected : ARRAY [0..2] OF STRING := ['String0', 'String1', 'String2'];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[entry := TOF_Core.GenericValueFactory.FromStringReference(value := _Values[0]);
_List.AppendGeneric(value := entry);

entry := TOF_Core.GenericValueFactory.FromStringReference(value := _Values[1]);
_List.AppendGeneric(value := entry);

entry := TOF_Core.GenericValueFactory.FromStringReference(value := _Values[2]);
_List.AppendGeneric(value := entry);

Assert.ThatBool(
	actual := _List.Get(index := 2).Address = entry.Address AND_THEN NOT _List.Get(index := 2).IsMemoryOwner,
	message := "AppendGeneric must retain the borrowed address and ownership mode"
).IsTrue();

Assert.ThatDInt(
	actual := _List.Length,
	message := "Unexpected sequence after AppendGeneric length"
).ToBe(expected := DINT#3);

FOR i := 0 TO 2 DO
	Assert.ThatString(
		actual := _List.Get(index := i).AsString255(),
		message := TOF_Core.WideStrings.Concat255("Unexpected sequence after AppendGeneric at index ", TO_WSTRING(i))
	).ToBe(expected := expected[i]);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{108c9be3-3fbe-47ea-bee2-fad8943b5c65}">
      <Declaration><![CDATA[(*!
<summary>Binds the list fixture for this case.</summary>
<description>
Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.
</description>
<param name="name">Display name of this case.</param>
<param name="parent">Group that owns this case.</param>
<param name="list">Required live list reserved for this case.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{88580870-6c4a-449b-9a3e-5da9b255f6fc}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b881720d-c996-45e4-9ef1-6a42423ad283}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{31182a3f-d15d-4c7d-80d1-5762348e113a}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a1d4628f-af11-4d67-89ff-9e9344e27ddc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>