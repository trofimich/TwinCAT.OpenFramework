<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="UniqueDataSetContainsTest" Id="{59f51ea0-e39e-4d6e-a4c3-0feebb775300}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks stable membership for raw and generic matching and missing values.

Borrows one group-owned set reserved for this case. Use from one task at a stable address.
Teardown clears the set and releases its owned entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK UniqueDataSetContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Set : TOF_Collections.IUniqueDataSet;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="OnAfterTest" Id="{344a2be2-d5e4-4524-9db4-5d6eda55859e}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Set.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{7f5cc86b-b79e-4235-9d08-75fb588a113b}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{05d5c265-deeb-4f27-b063-ae39e1534258}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{c48bfafb-ba19-4b24-b910-5a36794ce3b0}">
      <Declaration><![CDATA[(* Checks stable membership for raw and generic matching and missing values. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..6] OF STRING :=
		['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	i : DINT;
	missingValue : STRING := 'String9';
	query : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 6 TO 0 BY -1 DO
	_Set.SetCopy(value := values[i]);
END_FOR

Assert.ThatBool(
	actual := _Set.Contains(value := values[3]),
	message := "Contains must find a stored value"
).IsTrue();

Assert.ThatBool(
	actual := _Set.Contains(value := missingValue),
	message := "Contains must reject an absent value"
).IsFalse();

query := TOF_Core.GenericValueFactory.FromStringReference(value := values[3]);
Assert.ThatBool(
	actual := _Set.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "ContainsGeneric must find a stored value"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromStringReference(value := missingValue);
Assert.ThatBool(
	actual := _Set.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "ContainsGeneric must reject an absent value"
).IsFalse();

Assert.ThatDInt(
	actual := _Set.Length,
	message := "Lookup must preserve all seven entries"
).ToBe(expected := DINT#7);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{9d2a28a5-ee67-4b43-8a1b-4edebcf5cfd9}">
      <Declaration><![CDATA[(*
Binds the unique set fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
dataSet — Required live unique set reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	dataSet : TOF_Collections.IUniqueDataSet;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Set := dataSet;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{d9338d1c-d3c3-452c-bcd4-aa8097a7d542}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b769c79e-010e-4868-8639-4ee0d3d823f5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{12fda590-7b2d-4906-913c-5dee5079ef23}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{2f25ccf6-fd69-44b0-8905-a0a87539815e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>