<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListFindTest" Id="{a40ffdde-d31f-4297-a770-9e72b2e8deb1}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks the first match and absence without changing the byte list.</summary>
<description>
Runs against the selected fixture. The base case clears it before publishing the result.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ByteListFindTest EXTENDS ByteListTestCase
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a66ae5ff-6e28-406f-bcfd-51fc5a68fccb}">
      <Declaration><![CDATA[(*!
<summary>Checks the first match and absence without changing the byte list.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF BYTE := [0, 1, 2, 3, 4, 5];
	found : BOOL;
	index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendAny(data := values);
_List.Set(index := 5, value := BYTE#50);

found := _List.Find(value := BYTE#50, index => index);

Assert.ThatBool(
	actual := found AND_THEN index = 5,
	message := "Find must return the replaced byte at index 5"
).IsTrue();

_List.AppendByte(value := BYTE#50);

found := _List.Find(value := BYTE#50, index => index);

Assert.ThatBool(
	actual := found AND_THEN index = 5,
	message := "Find must select the first duplicate"
).IsTrue();

found := _List.Find(value := BYTE#255, index => index);

Assert.ThatBool(
	actual := NOT found,
	message := "Find must report absence for an unmatched byte"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{21192bf8-7979-4244-9414-571c88f0b86a}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c4af350d-de61-4909-9450-d6d64b2e96a5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{db510fdf-fa31-4ac8-849c-f82fb9bef4e6}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1f3becad-57f3-4bac-b9a4-a0227029cb6d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{18a03cef-e50b-4534-9b9a-d8cc2d0b65dc}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{66712102-2d89-49f8-9356-b2b9d9c81aac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
