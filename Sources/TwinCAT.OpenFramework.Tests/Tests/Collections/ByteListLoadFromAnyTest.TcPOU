<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListLoadFromAnyTest" Id="{a36b7318-3535-4e8b-881c-e69df344d4dc}" SpecialFunc="None">
    <Declaration><![CDATA[(*
