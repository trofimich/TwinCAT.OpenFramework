(*!
<summary>Checks byte ordering and end-position loading through ANY.</summary>
<description>
Runs against the selected fixture. The base case clears it before publishing the result.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ByteListLoadFromAnyTest EXTENDS ByteListTestCase
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{739a703e-4dac-45c2-b23e-6364747f262f}">
      <Declaration><![CDATA[(*!
<summary>Checks byte ordering and end-position loading through ANY.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF BYTE := [0, 1, 2, 3, 4, 5];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.LoadFromAny(data := values, startIndex := 0);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Initial load must copy six bytes"
).ToBe(expected := DINT#6);

_List.LoadFromAny(data := values, startIndex := _List.Length);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Loading at the end must extend the list"
).ToBe(expected := DINT#12);

FOR i := 0 TO 11 DO
	Assert.ThatBool(
		actual := _List.Get(index := i) = values[i MOD 6],
		message := "The concatenated buffers must preserve byte order"
	).IsTrue();
END_FOR

_List.LoadFromAny(data := values, startIndex := 2);

Assert.ThatDInt(
	actual := _List.Length,
	message := "A load inside the list must truncate bytes beyond its new end"
).ToBe(expected := DINT#8);

Assert.ThatBool(
	actual := _List.Get(index := 1) = BYTE#1
		AND_THEN _List.Get(index := 2) = BYTE#0
		AND_THEN _List.Get(index := 7) = BYTE#5,
	message := "The partial load must preserve the prefix and write through its final byte"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{51107527-12e9-40cf-8532-6cd5fdd04631}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{09bba503-a186-4105-aec6-0e138179dff8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0b3f47cd-876e-4345-a1a7-5b899bc71b6d}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{49fb54d0-a77f-403c-ab41-f987f062e165}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d7173472-91be-47fb-8c6a-7bc91601b2d5}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{293d324c-a147-4e5d-8ca3-d3cf829102f1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
