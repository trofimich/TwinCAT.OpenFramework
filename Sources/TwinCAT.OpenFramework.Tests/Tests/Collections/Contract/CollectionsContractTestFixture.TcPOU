(*!
<summary>Owns the collections and resources used by the collection contract cases.</summary>
<description>
A test group owns this fixture at a stable address. Run one case at a time in the owner task.
FinishScenario clears resources before a result is published, including when ExecuteScenario raises.
The fixture also clears owned resources on destruction. Terminal allocation failures use the task boundary.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK CollectionsContractTestFixture EXTENDS TOF_Core.Object
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	//! <summary>Borrows the running case assertion context until FinishScenario.</summary>
	_Assertions : REFERENCE TO TOF_Testing.Assertions;
	//! <summary>Latches observable disposal failures for the current case.</summary>
	_ReleaseFailed : BOOL;

	_Scalar : DINT := 1;
	_OtherScalar : DINT := 2;
	_MiddleScalar : DINT := 13;
	_SignedKey : LINT := 1;
	_UnsignedKey : UINT := 1;
	_ByteValues : ARRAY [0..2] OF BYTE := [0, 1, 255];
	_RealBits : TOF_Core.REAL_UNION;
	_LongRealBits : TOF_Core.LREAL_UNION;

	_SortSigned : LINT;
	_SortUnsigned : UINT;
	_SortReal : LREAL;
	_SortText : STRING(16) := 'b';
	_SortWideText : WSTRING(16) := "a";
	_FirstComparable : CollectionComparableProbe;
	_SecondComparable : CollectionComparableProbe;

	_NullByteCursor : TOF_Collections.ByteListEnumerator(list := 0);
	_NullListCursor : TOF_Collections.ListEnumerator(list := 0);
	_NullQueueCursor : TOF_Collections.QueueEnumerator(queue := 0);
	_NullStackCursor : TOF_Collections.StackEnumerator(stack := 0);
	_NullDictionaryCursor : TOF_Collections.DictionaryEnumerator(dictionary := 0);
	_NullSetCursor : TOF_Collections.UniqueDataSetEnumerator(uniqueSet := 0);
	_NullCursors : ARRAY [0..5] OF TOF_Core.IEnumerator;

	_CloneExitCount : UDINT;
	_CloneSource : CollectionCloneProbe;
	_FailingCloneSource : CollectionCloneProbe;
	_Validator : CollectionValidatorProbe;
	_Equality : CollectionEqualityProbe;
	_Predicate : CollectionPredicateProbe;
	_Comparer : CollectionComparerProbe;

	_Bytes : TOF_Collections.ByteList<0>;
	_StaticBytes : TOF_Collections.ByteList<8>;
	_List : TOF_Collections.List<0>(valueValidator := 0);
	_Queue : TOF_Collections.Queue<0>(valueValidator := _Validator);
	_Stack : TOF_Collections.Stack<0>(valueValidator := 0);
	_Dictionary : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
	_Set : TOF_Collections.UniqueDataSet<0>(valueValidator := 0, valueEqualityComparer := 0);
	_CollisionDictionary : TOF_Collections.Dictionary<0>(
		keyValidator := 0,
		valueValidator := 0,
		keyEqualityComparer := _Equality
	);
	_CollisionSet : TOF_Collections.UniqueDataSet<0>(valueValidator := 0, valueEqualityComparer := _Equality);

	_RejectedList : TOF_Collections.List<1>(valueValidator := _Validator);
	_RejectedQueue : TOF_Collections.Queue<1>(valueValidator := _Validator);
	_RejectedStack : TOF_Collections.Stack<1>(valueValidator := _Validator);
	_RejectedDictionary : TOF_Collections.Dictionary<1>(
		keyValidator := 0,
		valueValidator := _Validator,
		keyEqualityComparer := 0
	);
	_RejectedSet : TOF_Collections.UniqueDataSet<1>(valueValidator := _Validator, valueEqualityComparer := 0);

	_FullList : TOF_Collections.List<1>(valueValidator := 0);
	_FullQueue : TOF_Collections.Queue<1>(valueValidator := 0);
	_FullStack : TOF_Collections.Stack<1>(valueValidator := 0);
	_FullDictionary : TOF_Collections.Dictionary<1>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
	_FullSet : TOF_Collections.UniqueDataSet<1>(valueValidator := 0, valueEqualityComparer := 0);

	//! <summary>Retains unaccepted allocations and cursors across an aborted helper call.</summary>
	_OwnedObject : TOF_Core.IObject;
	_OwnedValue : TOF_Core.GENERIC_VALUE;
	_Query : TOF_Core.GENERIC_VALUE;
	_BorrowedSource : TOF_Core.GENERIC_VALUE;
	_Enumerator : TOF_Core.IEnumerator;
	_SecondEnumerator : TOF_Core.IEnumerator;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteScenario" Id="{9da73efa-0615-45a6-ab35-fb9bd247e314}">
      <Declaration><![CDATA[(*!
<summary>Runs one collection contract scenario using the active test assertions.</summary>
<description>
Starts with empty collections, reset probe injections and no retained resources. A scenario can raise an
unexpected exception. FinishScenario is required before publishing its result or starting another case.
</description>
<param name="scenario">Selected contract scenario.</param>
<param name="assertions">Context bound to the running test case.</param>
*)
METHOD INTERNAL ExecuteScenario
VAR_INPUT
	scenario : COLLECTIONS_CONTRACT_SCENARIO;
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Assertions REF= assertions;
_ReleaseFailed := FALSE;
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

CASE scenario OF
	COLLECTIONS_CONTRACT_SCENARIO.COPY_FAILURE_PRESERVES_EXCEPTION:
		copyFailurePreservesException();

	COLLECTIONS_CONTRACT_SCENARIO.SECOND_COPY_FAILURE_CLEANUP:
		secondCopyFailureCleanup();

	COLLECTIONS_CONTRACT_SCENARIO.STATIC_FULL_COPY_CLEANUP:
		staticFullCopyCleanup();

	COLLECTIONS_CONTRACT_SCENARIO.BYTE_OVERLAP_AND_BOUNDS:
		byteOverlapAndBounds();

	COLLECTIONS_CONTRACT_SCENARIO.BYTE_SIZE_REJECTIONS:
		byteSizeRejections();

	COLLECTIONS_CONTRACT_SCENARIO.LIST_OWNERSHIP_REPLACEMENT:
		listOwnershipReplacement();

	COLLECTIONS_CONTRACT_SCENARIO.LIST_REMOVAL_LIMITS:
		listRemovalLimits();

	COLLECTIONS_CONTRACT_SCENARIO.SORT_FAILURE_PRESERVES_ENTRIES:
		sortFailurePreservesEntries();

	COLLECTIONS_CONTRACT_SCENARIO.QUEUE_VALIDATION_AND_GROWTH:
		queueValidationAndGrowth();

	COLLECTIONS_CONTRACT_SCENARIO.HASH_COLLISION_GROWTH:
		hashCollisionGrowth();

	COLLECTIONS_CONTRACT_SCENARIO.HASH_EQUALITY_REPRESENTATIONS:
		hashEqualityRepresentations();

	COLLECTIONS_CONTRACT_SCENARIO.HASH_OWNERSHIP_ALIASES:
		hashOwnershipAliases();

	COLLECTIONS_CONTRACT_SCENARIO.FULL_STATIC_DUPLICATE_UPDATES:
		fullStaticDuplicateUpdates();

	COLLECTIONS_CONTRACT_SCENARIO.QUERY_FAILURE_CLEANUP:
		queryFailureCleanup();

	COLLECTIONS_CONTRACT_SCENARIO.CONTAINS_COLLECTION_CALLBACK_FAILURES:
		containsCollectionCallbackFailures();

	COLLECTIONS_CONTRACT_SCENARIO.GENERIC_QUERY_RELEASE_MATRIX:
		genericQueryReleaseMatrix();

	COLLECTIONS_CONTRACT_SCENARIO.ALL_CURSOR_CONTRACTS:
		allCursorContracts();

	COLLECTIONS_CONTRACT_SCENARIO.FIXTURE_CLEANUP_AFTER_EXCEPTION:
		fixtureCleanupAfterException();

	COLLECTIONS_CONTRACT_SCENARIO.DEFAULT_SORT_NUMERIC_BRANCHES:
		defaultSortNumericBranches();

	COLLECTIONS_CONTRACT_SCENARIO.DEFAULT_SORT_TEXT_AND_OBJECTS:
		defaultSortTextAndObjects();

	COLLECTIONS_CONTRACT_SCENARIO.DEFAULT_SORT_EXPLICIT_AND_REJECTION:
		defaultSortExplicitAndRejection();

	COLLECTIONS_CONTRACT_SCENARIO.MISSING_CURSOR_SOURCES:
		missingCursorSources();
ELSE
	_Assertions.ThatBool(
		actual := FALSE,
		message := "Invalid collection contract scenario"
	).IsTrue();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FinishScenario" Id="{5739a7ee-5c63-4c79-89a1-f803b553aa5e}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture and returns whether checked releases succeeded.</summary>
<description>
Detaches the assertion context before cleanup. Returns FALSE for a failed cursor or interface release
observed during the case or teardown. Generic-value Release remains best effort.
</description>
*)
METHOD INTERNAL FinishScenario : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Assertions REF= 0;
cleanupFixtures();
FinishScenario := NOT _ReleaseFailed;]]></ST>
      </Implementation>
    </Method>
    <Method Name="allCursorContracts" Id="{c78adc37-c14c-43fe-814f-252d492f0812}">
      <Declaration><![CDATA[(*!
<summary>Checks independent cursors, their values, Reset and repeated exhaustion for six containers.</summary>
<description>
Expected counts and values come from fixture inputs and explicit Clear operations, independent of indexed access.
The harness clears persistent resources before publication, including after an aborted call. Terminal OOM
injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE allCursorContracts
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Bytes.AppendData(data := ADR(_ByteValues), dataSize := 3);
_List.AppendCopy(value := _Scalar);
_List.AppendCopy(value := _OtherScalar);
_Queue.EnqueueCopy(value := _Scalar);
_Queue.EnqueueCopy(value := _OtherScalar);
_Stack.PushCopy(value := _Scalar);
_Stack.PushCopy(value := _OtherScalar);
_Dictionary.SetCopy(key := _Scalar, value := _OtherScalar);
_Dictionary.SetCopy(key := _OtherScalar, value := _Scalar);
_Set.SetCopy(value := _Scalar);
_Set.SetCopy(value := _OtherScalar);
checkCursor(source := _Bytes, expectedLength := 3, sourceName := "Bytes");
checkCursor(source := _List, expectedLength := 2, sourceName := "List");
checkCursor(source := _Queue, expectedLength := 2, sourceName := "Queue");
checkCursor(source := _Stack, expectedLength := 2, sourceName := "Stack");
checkCursor(source := _Dictionary, expectedLength := 2, sourceName := "Dictionary");
checkCursor(source := _Set, expectedLength := 2, sourceName := "Set");

checkScalarCursorValues(source := _List, sourceName := "List");
checkScalarCursorValues(source := _Queue, sourceName := "Queue");
checkScalarCursorValues(source := _Set, sourceName := "Set", ordered := FALSE);
checkDictionaryCursorValues();

_Enumerator := _Bytes.CreateEnumerator();
_Assertions.ThatBool(
	actual := _Enumerator <> 0,
	message := "Byte list must create a cursor"
).IsTrue();

IF _Enumerator = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO 2 DO
	_Assertions.ThatBool(
		actual := _Enumerator.MoveNext(),
		message := "Byte cursor must visit every byte"
	).IsTrue();
	_Assertions.ThatByte(
		actual := _Enumerator.Current.AsByte(),
		message := "Generic Current must address cached byte storage, including zero"
	).ToBe(expected := _ByteValues[i]);
END_FOR

releaseCursors();
_Bytes.Clear();
_List.Clear();
_Queue.Clear();
_Stack.Clear();
_Dictionary.Clear();
_Set.Clear();
checkCursor(source := _Bytes, expectedLength := 0, sourceName := "Bytes");
checkCursor(source := _List, expectedLength := 0, sourceName := "List");
checkCursor(source := _Queue, expectedLength := 0, sourceName := "Queue");
checkCursor(source := _Stack, expectedLength := 0, sourceName := "Stack");
checkCursor(source := _Dictionary, expectedLength := 0, sourceName := "Dictionary");
checkCursor(source := _Set, expectedLength := 0, sourceName := "Set");]]></ST>
      </Implementation>
    </Method>
    <Method Name="assertOriginalFailure" Id="{91a4b1f4-e7e6-4b43-8603-f63e4537e2c4}">
      <Declaration><![CDATA[(*!
<summary>Checks a caught framework failure after resource cleanup.</summary>
<description>
Captures and consumes the exception within the current call; no exception interface survives task cleanup.
</description>
*)
METHOD PRIVATE assertOriginalFailure
VAR_INPUT
	exceptionCode : __SYSTEM.ExceptionCode;
	expectedMessage : WSTRING;
END_VAR
VAR
	caughtException : TOF_Core.IException;
	standardException : TOF_Core.IStandardException;
	actualMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[caughtException := TOF_Core.ExceptionManager.GetLastException(
	exceptionCode := exceptionCode,
	catchPointNamespaceName := NamespaceName,
	catchPointPOUName := __POUNAME(),
	catchPointPosition := __POSITION()
);
_Assertions.ThatBool(
	actual := __QUERYINTERFACE(caughtException, standardException),
	message := "Original StandardException category must be preserved"
).IsTrue();
IF standardException = 0 THEN
	RETURN;
END_IF

actualMessage := caughtException.GetMessage();
_Assertions.That(
	actual := actualMessage,
	message := "Original message must survive"
).ToBe(expected := expectedMessage);]]></ST>
      </Implementation>
    </Method>
    <Method Name="byteOverlapAndBounds" Id="{6d40e508-1634-456f-bca1-7a3b8ce9bf94}">
      <Declaration><![CDATA[(*!
<summary>Supports byte self-growth, overlapping loads, empty removal and checked ranges.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE byteOverlapAndBounds
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Bytes.Remove(value := 7);
_StaticBytes.Remove(value := 7);
_Bytes.AppendData(data := ADR(_ByteValues), dataSize := 3);
_Bytes.AppendData(data := _Bytes.DataAddress, dataSize := _Bytes.Length);
_Assertions.ThatDInt(
	actual := _Bytes.Length,
	message := "Self-append must grow to six bytes"
).ToBe(expected := 6);

FOR i := 0 TO 5 DO
	_Assertions.ThatByte(
		actual := _Bytes.Get(index := i),
		message := "Self-growth must retain the source bytes"
	).ToBe(expected := _ByteValues[i MOD 3]);
END_FOR

_Bytes.LoadFromData(data := _Bytes.DataAddress + 1, dataSize := 4, startIndex := 0);
_Assertions.ThatDInt(
	actual := _Bytes.Length,
	message := "Overlapping load must truncate the tail"
).ToBe(expected := 4);
_Assertions.ThatByte(
	actual := _Bytes.Get(index := 0),
	message := "Overlap must copy the old second byte"
).ToBe(expected := 1);
_Assertions.ThatByte(
	actual := _Bytes.Get(index := 1),
	message := "Overlap must preserve byte 255"
).ToBe(expected := 255);
_Bytes.LoadFromData(data := 0, dataSize := 0, startIndex := 2);
_Assertions.ThatDInt(
	actual := _Bytes.Length,
	message := "Null zero load must preserve Length"
).ToBe(expected := 4);
_Bytes.Clear(releaseDynamicMemory := TRUE);
_Assertions.ThatDInt(
	actual := _Bytes.Capacity,
	message := "Explicit release must drop byte capacity"
).ToBe(expected := 0);

_StaticBytes.AppendData(data := ADR(_ByteValues), dataSize := 3);
_StaticBytes.AppendData(data := _StaticBytes.DataAddress, dataSize := 3);
_StaticBytes.LoadFromData(data := _StaticBytes.DataAddress + 1, dataSize := 4, startIndex := 0);
_Assertions.ThatByte(
	actual := _StaticBytes.Get(index := 0),
	message := "Static overlap must be supported"
).ToBe(expected := 1);
_StaticBytes.RemoveAt(index := 1, count := 0);
_Assertions.ThatDInt(
	actual := _StaticBytes.Length,
	message := "Validated zero removal must be a no-op"
).ToBe(expected := 4);]]></ST>
      </Implementation>
    </Method>
    <Method Name="byteSizeRejections" Id="{7286ac65-0de1-4b3e-85d3-ff2a64dc8711}">
      <Declaration><![CDATA[(*!
<summary>Rejects oversized generic byte ranges and overflowing end positions before reading input.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE byteSizeRejections
VAR
	i : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	rangeException : TOF_Core.IArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Bytes.AppendData(data := ADR(_ByteValues), dataSize := 3);
_Query := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.UINT_8,
	address := ADR(_ByteValues),
	size := TO_ULINT(TOF_Core.SignedInt32.MAX_VALUE) + 1,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);

FOR i := 0 TO 3 DO
	rejected := FALSE;

	__TRY
		CASE i OF
			0:
				_Bytes.AppendGeneric(data := _Query);
			1:
				_Bytes.LoadFromGeneric(data := _Query);
			2:
				_Bytes.AppendData(data := ADR(_ByteValues), dataSize := TOF_Core.SignedInt32.MAX_VALUE);
			3:
				_Bytes.RemoveAt(index := 1, count := TOF_Core.SignedInt32.MAX_VALUE);
		END_CASE
	__CATCH(exceptionCode)
		rejected := TRUE;
		caughtException := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		_Assertions.ThatBool(
			actual := __QUERYINTERFACE(caughtException, rangeException),
			message := "Oversized byte range must report ArgumentOutOfRangeException"
		).IsTrue();
	__ENDTRY

	_Assertions.ThatBool(
		actual := rejected,
		message := "Oversized byte request must be rejected"
	).IsTrue();
	_Assertions.ThatDInt(
		actual := _Bytes.Length,
		message := "Rejected range must preserve Length"
	).ToBe(expected := 3);
	_Assertions.ThatByte(
		actual := _Bytes.Get(index := 2),
		message := "Rejected range must preserve bytes"
	).ToBe(expected := 255);
END_FOR

_Query.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkCursor" Id="{f49504b8-ecde-42bf-8df7-16eee52cf4cf}">
      <Declaration><![CDATA[(*!
<summary>Checks traversal and invalid-current states without changing the borrowed source.</summary>
<description>
The fixture supplies an independent expected entry count. The source stays alive and structurally unchanged. 
Cursor ownership remains in fixture fields if a call raises.
</description>
*)
METHOD PRIVATE checkCursor
VAR_INPUT
	source : TOF_Collections.ICollection;
	expectedLength : DINT;
	sourceName : WSTRING;
END_VAR
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Assertions.ThatDInt(
	actual := source.Length,
	message := TOF_Core.WideStrings.Concat255(sourceName, ": unexpected source length")
).ToBe(expected := expectedLength);
_Enumerator := source.CreateEnumerator();
_SecondEnumerator := source.CreateEnumerator();

_Assertions.ThatBool(
	actual := _Enumerator <> 0 AND_THEN _SecondEnumerator <> 0,
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Each traversal must create a cursor")
).IsTrue();

IF _Enumerator = 0 OR_ELSE _SecondEnumerator = 0 THEN
	releaseCursors();

	RETURN;
END_IF

_Assertions.ThatBool(
	actual := _Enumerator <> _SecondEnumerator,
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Owned cursors must be independent")
).IsTrue();

IF _Enumerator = _SecondEnumerator THEN
	releaseCursors();

	RETURN;
END_IF

_Assertions.ThatBool(
	actual := _Enumerator.Current.IsNull,
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Current before MoveNext must be empty")
).IsTrue();

FOR i := 0 TO expectedLength - 1 DO
	_Assertions.ThatBool(
		actual := _Enumerator.MoveNext(),
		message := TOF_Core.WideStrings.Concat255(sourceName, ": Cursor must visit every source entry")
	).IsTrue();
	_Assertions.ThatBool(
		actual := _Enumerator.Current.IsNull,
		message := TOF_Core.WideStrings.Concat255(sourceName, ": Current must expose the visited entry")
	).IsFalse();
END_FOR

_Assertions.ThatBool(
	actual := _Enumerator.MoveNext(),
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Cursor must stop at source end")
).IsFalse();
_Assertions.ThatBool(
	actual := _Enumerator.MoveNext(),
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Exhausted cursor must stay exhausted")
).IsFalse();
_Assertions.ThatBool(
	actual := _Enumerator.Current.IsNull,
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Current after exhaustion must be empty")
).IsTrue();
_Assertions.ThatBool(
	actual := _SecondEnumerator.MoveNext(),
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Second cursor must retain an independent position")
).ToBe(expected := expectedLength > TOF_Core.SignedInt32.ZERO);
_Enumerator.Reset();
_Assertions.ThatBool(
	actual := _Enumerator.Current.IsNull,
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Current after Reset must be empty")
).IsTrue();
_Assertions.ThatBool(
	actual := _Enumerator.MoveNext(),
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Reset must restore the initial cursor position")
).ToBe(expected := expectedLength > TOF_Core.SignedInt32.ZERO);
releaseCursors();]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkScalarCursorValues" Id="{00edc401-a2a5-43e8-90a0-75b562b2b68b}">
      <Declaration><![CDATA[(*!
<summary>Checks both distinct scalar values produced by a cursor.</summary>
<description>
The live source contains the two fixture scalars. Ordered sources yield them in insertion order. An unordered
source yields each once. Retains cursor ownership in the fixture until release, including on an exception.
</description>
*)
METHOD PRIVATE checkScalarCursorValues
VAR_INPUT
	source : TOF_Collections.ICollection;
	sourceName : WSTRING;
	ordered : BOOL := TRUE;
END_VAR
VAR
	values : ARRAY [0..1] OF DINT;
	currentValue : REFERENCE TO TOF_Core.GENERIC_VALUE;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Enumerator := source.CreateEnumerator();

FOR i := 0 TO UPPER_BOUND(values, 1) DO
	IF _Enumerator = 0 OR_ELSE NOT _Enumerator.MoveNext() THEN
		EXIT;
	END_IF

	currentValue REF= _Enumerator.Current;

	IF NOT __ISVALIDREF(currentValue) OR_ELSE currentValue.IsNull THEN
		EXIT;
	END_IF

	values[i] := currentValue.AsDInt();
END_FOR

_Assertions.ThatBool(
	actual := i > UPPER_BOUND(values, 1)
		AND_THEN ((values[0] = _Scalar AND_THEN values[1] = _OtherScalar)
			OR_ELSE (NOT ordered AND_THEN values[0] = _OtherScalar AND_THEN values[1] = _Scalar)),
	message := TOF_Core.WideStrings.Concat255(sourceName, ": Current must return both inserted values")
).IsTrue();

releaseCursors();]]></ST>
      </Implementation>
    </Method>
    <Method Name="checkDictionaryCursorValues" Id="{07bbf2f6-f599-473a-aa42-385ac758fff0}">
      <Declaration><![CDATA[(*!
<summary>Checks that the dictionary cursor exposes both inserted key-value pairs.</summary>
<description>
Reads each borrowed pair before the next cursor operation. Both pairs must appear once in either order. The
fixture retains ownership of the cursor if enumeration aborts.
</description>
*)
METHOD PRIVATE checkDictionaryCursorValues
VAR
	currentValue : REFERENCE TO TOF_Core.GENERIC_VALUE;
	pair : POINTER TO TOF_Core.GENERIC_KEY_VALUE_PAIR;
	keyValue : DINT;
	storedValue : DINT;
	observedFirstPair : BOOL;
	observedSecondPair : BOOL;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Enumerator := _Dictionary.CreateEnumerator();

FOR i := 0 TO 1 DO
	IF _Enumerator = 0 OR_ELSE NOT _Enumerator.MoveNext() THEN
		EXIT;
	END_IF

	currentValue REF= _Enumerator.Current;

	IF NOT __ISVALIDREF(currentValue)
		OR_ELSE currentValue.IsNull
		OR_ELSE currentValue.TypeClass <> TOF_Core.GENERIC_TYPE_CLASS.USER_DEFINED
		OR_ELSE currentValue.Size <> XSIZEOF(TOF_Core.GENERIC_KEY_VALUE_PAIR)
	THEN
		EXIT;
	END_IF

	pair := currentValue.Address;
	keyValue := pair^.Key.AsDInt();
	storedValue := pair^.Value.AsDInt();
	observedFirstPair := observedFirstPair OR_ELSE (keyValue = _Scalar AND_THEN storedValue = _OtherScalar);
	observedSecondPair := observedSecondPair OR_ELSE (keyValue = _OtherScalar AND_THEN storedValue = _Scalar);
END_FOR

_Assertions.ThatBool(
	actual := observedFirstPair AND_THEN observedSecondPair,
	message := "Dictionary Current must expose both expected key-value pairs in either order"
).IsTrue();

releaseCursors();]]></ST>
      </Implementation>
    </Method>
    <Method Name="cleanupFixtures" Id="{2f41f842-f6b8-4ef4-8b5a-3c30d2008cad}">
      <Declaration><![CDATA[(*!
<summary>Clears all fixture-owned resources and resets the injected failures.</summary>
<description>
Uses non-allocating, non-throwing release paths. All probe counters and borrowed source values are persistent.
</description>
*)
METHOD PRIVATE cleanupFixtures]]></Declaration>
      <Implementation>
        <ST><![CDATA[releaseCursors();
_CloneSource.ThrowOnEquality := FALSE;
_FailingCloneSource.ThrowOnClone := FALSE;
_Validator.Reject := FALSE;
_Equality.ThrowOnHash := FALSE;
_Equality.ThrowOnEquality := FALSE;
_Predicate.ThrowOnCall := 0;
_Comparer.ThrowOnCall := 0;

_Bytes.Clear(releaseDynamicMemory := TRUE);
_StaticBytes.Clear(releaseDynamicMemory := TRUE);
_List.Clear();
_Queue.Clear();
_Stack.Clear();
_Dictionary.Clear();
_Set.Clear();
_CollisionDictionary.Clear();
_CollisionSet.Clear();
_Equality.MatchEveryValue := FALSE;
_RejectedList.Clear();
_RejectedQueue.Clear();
_RejectedStack.Clear();
_RejectedDictionary.Clear();
_RejectedSet.Clear();
_FullList.Clear();
_FullQueue.Clear();
_FullStack.Clear();
_FullDictionary.Clear();
_FullSet.Clear();

_OwnedValue.Release();
_Query.Release();
_BorrowedSource.Reset();

IF _OwnedObject <> 0 THEN
	IF NOT TOF_Core.Memory.TryReleaseDynamicObject(instance := _OwnedObject) THEN
		_ReleaseFailed := TRUE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="copyFailurePreservesException" Id="{1d111f71-e1ab-4721-8a81-50af68356f67}">
      <Declaration><![CDATA[(*!
<summary>Preserves the original validator failure across cleanup in all seven Copy methods.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE copyFailurePreservesException
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RejectedList.AppendCopy(value := _Scalar);
_Validator.Reject := TRUE;

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedList.AppendCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedList.InsertCopy(index := 0, value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedList.SetCopy(index := 0, value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedQueue.EnqueueCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedStack.PushCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedDictionary.SetCopy(key := _Scalar, value := _CloneSource, valueIsObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_RejectedSet.SetCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

_Assertions.ThatDInt(
	actual := _RejectedList.Length,
	message := "Rejected replacement must retain entry"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _RejectedList.Get(index := 0).AsDInt(),
	message := "Entry must survive"
).ToBe(expected := _Scalar);
_Assertions.ThatBool(
	actual := _RejectedQueue.Empty,
	message := "Rejected queue must remain empty"
).IsTrue();
_Assertions.ThatBool(
	actual := _RejectedStack.Empty,
	message := "Rejected stack must remain empty"
).IsTrue();
_Assertions.ThatBool(
	actual := _RejectedDictionary.Empty,
	message := "Rejected dictionary must remain empty"
).IsTrue();
_Assertions.ThatBool(
	actual := _RejectedSet.Empty,
	message := "Rejected set must remain empty"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="defaultSortExplicitAndRejection" Id="{c55739c7-5805-4776-a81f-86e65932acbd}">
      <Declaration><![CDATA[(*!
<summary>Preserves explicit comparer priority and reports unsupported default pairs without losing entries.</summary>
<description>
Uses persistent collection and source fixtures. Each case prepares an independent initial state;
comparison failures retain descriptors without promising rollback of completed swaps.
</description>
*)
METHOD PRIVATE defaultSortExplicitAndRejection
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	conversionException : TOF_Core.IGenericConversionNotSupportedException;
	objectValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Comparer.ResetCount();
_Comparer.ThrowOnCall := 1;
_List.Sort();
_List.Sort(comparer := _Comparer);
_List.AppendCopy(value := _Scalar);
_List.Sort();
_List.Sort(comparer := _Comparer);
_Assertions.ThatUDInt(
	actual := _Comparer.CallCount,
	message := "Empty and singleton sort must not compare"
).ToBe(expected := 0);
_List.AppendCopy(value := _SortText);

__TRY
	_List.Sort(comparer := _Comparer);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection comparer rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Explicit comparer must run before default compatibility checks"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _Comparer.CallCount,
	message := "Explicit comparer must receive the pair"
).ToBe(expected := 1);
rejected := FALSE;

__TRY
	_List.Sort();
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, conversionException),
		message := "Unsupported default order must report GenericConversionNotSupportedException"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Incompatible numeric and text values must reject default sorting"
).IsTrue();
_Assertions.ThatDInt(
	actual := _List.Length,
	message := "Default rejection must retain all entries"
).ToBe(expected := 2);
_Assertions.ThatBool(
	actual := _List.Get(index := 0).IsMemoryOwner,
	message := "Default rejection must retain first owner"
).IsTrue();
_Assertions.ThatBool(
	actual := _List.Get(index := 1).IsMemoryOwner,
	message := "Default rejection must retain second owner"
).IsTrue();
_List.Clear();
objectValue := TOF_Core.GenericValueFactory.FromAnyType(
	value := _CloneSource,
	isObject := TRUE,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_List.AppendGeneric(value := objectValue);
_List.Sort();
_List.AppendGeneric(value := objectValue);
rejected := FALSE;

__TRY
	_List.Sort();
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, conversionException),
		message := "Unsupported default order must report GenericConversionNotSupportedException"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "OBJECT default order requires IComparable"
).IsTrue();
_Assertions.ThatDInt(
	actual := _List.Length,
	message := "Unsupported OBJECT sorting must retain descriptors"
).ToBe(expected := 2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="defaultSortNumericBranches" Id="{bc7989a3-a3da-43d7-b6e6-dbb4585f742b}">
      <Declaration><![CDATA[(*!
<summary>Sorts mixed numeric representations with omitted or null comparer in both algorithm branches.</summary>
<description>
Uses persistent collection and source fixtures. Each case prepares an independent initial state;
comparison failures retain descriptors without promising rollback of completed swaps.
</description>
*)
METHOD PRIVATE defaultSortNumericBranches
VAR
	i : DINT;
	count : DINT;
	expectedValue : DINT;
	expectedDescriptor : TOF_Core.GENERIC_VALUE;
	sortView : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[sortView := _List;

FOR count := 16 TO 17 DO
	_List.Clear();

	FOR i := count TO 1 BY -1 DO
		CASE i MOD 3 OF
			0:
				_SortReal := TO_LREAL(i);
				_List.AppendCopy(value := _SortReal);
			1:
				_SortSigned := TO_LINT(i);
				_List.AppendCopy(value := _SortSigned);
			2:
				_SortUnsigned := TO_UINT(i);
				_List.AppendCopy(value := _SortUnsigned);
		END_CASE
	END_FOR

	sortView.Sort();

	FOR i := 0 TO count - 1 DO
		expectedValue := i + 1;
		expectedDescriptor := TOF_Core.GenericValueFactory.FromDIntReference(value := expectedValue);
		_Assertions.ThatBool(
			actual := _List.Get(index := i).CompareTo(otherValue := expectedDescriptor)
				= TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
			message := "Default ascending order must compare mixed numeric values by value"
		).IsTrue();
	END_FOR

	_List.Sort(comparer := 0, direction := TOF_Core.SORT_DIRECTION.DESCENDING);

	FOR i := 0 TO count - 1 DO
		expectedValue := count - i;
		expectedDescriptor := TOF_Core.GenericValueFactory.FromDIntReference(value := expectedValue);
		_Assertions.ThatBool(
			actual := _List.Get(index := i).CompareTo(otherValue := expectedDescriptor)
				= TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND,
			message := "Null comparer must select the same default order in descending sorting"
		).IsTrue();
		_Assertions.ThatBool(
			actual := _List.Get(index := i).IsMemoryOwner,
			message := "Default sorting must retain owners"
		).IsTrue();
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="defaultSortTextAndObjects" Id="{18bb14db-dcae-48ec-a7fa-bebf550e35b8}">
      <Declaration><![CDATA[(*!
<summary>Uses natural mixed-text and IComparable OBJECT ordering without catalogue selection.</summary>
<description>
Uses persistent collection and source fixtures. Each case prepares an independent initial state;
comparison failures retain descriptors without promising rollback of completed swaps.
</description>
*)
METHOD PRIVATE defaultSortTextAndObjects
VAR
	objectValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := _SortText);
_List.AppendCopy(value := _SortWideText);
_List.Sort();
_Assertions.ThatWideString(
	actual := _List.Get(index := 0).AsWString255(),
	message := "Default sort must compare mixed STRING and WSTRING text"
).ToBe(expected := "a");
_Assertions.ThatWideString(
	actual := _List.Get(index := 1).AsWString255(),
	message := "Default mixed-text order must retain the second value"
).ToBe(expected := "b");
_List.Clear();
_FirstComparable.SortValue := 2;
_SecondComparable.SortValue := 1;
objectValue := TOF_Core.GenericValueFactory.FromAnyType(
	value := _FirstComparable,
	isObject := TRUE,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_List.AppendGeneric(value := objectValue);
objectValue := TOF_Core.GenericValueFactory.FromAnyType(
	value := _SecondComparable,
	isObject := TRUE,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_List.AppendGeneric(value := objectValue);
_List.Sort();
_Assertions.ThatBool(
	actual := TO_LWORD(_List.Get(index := 0).Address) = TO_LWORD(_SecondComparable.SelfAddress),
	message := "Default OBJECT ordering must invoke IComparable"
).IsTrue();
_Assertions.ThatBool(
	actual := _List.Get(index := 0).IsMemoryOwner,
	message := "Borrowed OBJECT must remain borrowed"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{80aeede4-ffb9-4fd1-a835-55a5e24da987}">
      <Declaration><![CDATA[(*!
<summary>Releases persistent resources during fixture destruction without allocating or raising.</summary>
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[cleanupFixtures();]]></ST>
      </Implementation>
    </Method>
    <Method Name="fixtureCleanupAfterException" Id="{ea0e6aaa-1252-4830-9a2f-325eb0d1920c}">
      <Declaration><![CDATA[(*!
<summary>Retains resources through an intermediate throwing call and cleans them explicitly afterwards.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE fixtureCleanupAfterException
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := _Scalar);

__TRY
	prepareResourcesThenReject();
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection fixture rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Fixture injection must reach the local handler"
).IsTrue();
_Assertions.ThatBool(
	actual := _Enumerator <> 0,
	message := "Cursor ownership must survive the aborted helper"
).IsTrue();
_Assertions.ThatBool(
	actual := _OwnedValue.IsMemoryOwner,
	message := "Payload ownership must survive the aborted helper"
).IsTrue();
releaseCursors();
_Assertions.ThatBool(
	actual := _Enumerator = 0,
	message := "Cursor alias must be reset after cleanup"
).IsTrue();
_OwnedValue.Release();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Retained probe must be destroyed once"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _List.Length,
	message := "Cursor disposal must not dispose its source"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="fullStaticDuplicateUpdates" Id="{49120907-0e61-4ba9-a240-b5c15c859db8}">
      <Declaration><![CDATA[(*!
<summary>Updates equal entries in full static hash containers without adding a slot.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE fullStaticDuplicateUpdates
VAR
	keyAddress : PVOID;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FullDictionary.SetCopy(key := _Scalar, value := _Scalar);
_FullSet.SetCopy(value := _Scalar);
keyAddress := _FullDictionary.GetKeyValuePairByIndex(index := 0).Key.Address;
_FullDictionary.SetCopy(key := _Scalar, value := _OtherScalar);
_FullSet.SetCopy(value := _Scalar);
_Assertions.ThatDInt(
	actual := _FullDictionary.Length,
	message := "Duplicate update must not need a slot"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _FullSet.Length,
	message := "Duplicate set replacement must not need a slot"
).ToBe(expected := 1);
_Assertions.ThatBool(
	actual := keyAddress = _FullDictionary.GetKeyValuePairByIndex(index := 0).Key.Address,
	message := "Dictionary must retain its existing equal key allocation"
).IsTrue();
_Assertions.ThatDInt(
	actual := _FullDictionary.GetKeyValuePairByIndex(index := 0).Value.AsDInt(),
	message := "Full dictionary must accept the replacement value"
).ToBe(expected := _OtherScalar);]]></ST>
      </Implementation>
    </Method>
    <Method Name="genericQueryReleaseMatrix" Id="{23b42eb4-0e34-430c-91e3-86218868f215}">
      <Declaration><![CDATA[(*!
<summary>Checks found/missing queries with owned/borrowed payload and explicit release on/off.</summary>
<description>
Exercises seven generic dictionary/set queries over 56 combinations. Universal fixture equality permits
an owned query to match without aliasing any retained allocation. The source counter is persistent and
cleanup never dereferences a caller alias after requested release.
</description>
*)
METHOD PRIVATE genericQueryReleaseMatrix
VAR
	foundCase : DINT;
	ownedCase : DINT;
	releaseCase : DINT;
	operation : DINT;
	position : DINT;
	found : BOOL;
	releaseQuery : BOOL;
	foundValue : TOF_Core.GENERIC_VALUE;
	queryAsInterface : TOF_Core.IObject;
	queryForCall : TOF_Core.GENERIC_VALUE;
	scenarioDescription : WSTRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_Equality.MatchEveryValue := TRUE;

FOR foundCase := 0 TO 1 DO
	FOR ownedCase := 0 TO 1 DO
		FOR releaseCase := 0 TO 1 DO
			FOR operation := 0 TO 6 DO
				_CollisionDictionary.Clear();
				_CollisionSet.Clear();

				IF foundCase = 1 THEN
					_CollisionDictionary.SetCopy(key := _Scalar, value := _OtherScalar);
					_CollisionSet.SetCopy(value := _Scalar);
				END_IF

				_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

				IF ownedCase = 1 THEN
					prepareOwnedValue();
					_Query := _OwnedValue;
					_OwnedValue.Reset();
				ELSE
					_Query := TOF_Core.GenericValueFactory.FromParts(
						genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
						address := _CloneSource.SelfAddress,
						size := _CloneSource.SelfSize,
						memoryManagementBehavior :=
							TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
					);
				END_IF

				scenarioDescription := TOF_Core.WideStrings.Concat255(
					"Operation ",
					TO_WSTRING(operation),
					", found=",
					TO_WSTRING(foundCase),
					", owned=",
					TO_WSTRING(ownedCase),
					", release=",
					TO_WSTRING(releaseCase)
				);

				releaseQuery := releaseCase = 1;
				queryForCall := _Query;

				IF releaseQuery THEN
					// The receiving call is responsible for disposal even when its lookup fails.
					_Query.Reset();
				END_IF

				CASE operation OF
					0:
						found := _CollisionDictionary.ContainsGenericKey(key := queryForCall, releaseKey := releaseQuery);
					1:
						position := _CollisionDictionary.GetGenericKeyPosition(key := queryForCall, releaseKey := releaseQuery);
						found := position >= TOF_Core.SignedInt32.ZERO;
					2:
						found := _CollisionDictionary.TryGetValueByGenericKey(
							key := queryForCall,
							releaseKey := releaseQuery,
							value => foundValue
						);
					3:
						_CollisionDictionary.TryRemoveByGenericKey(
							key := queryForCall,
							releaseKey := releaseQuery,
							removed => found
						);
					4:
						found := _CollisionSet.ContainsGeneric(value := queryForCall, releaseValue := releaseQuery);
					5:
						position := _CollisionSet.GetGenericValuePosition(value := queryForCall, releaseValue := releaseQuery);
						found := position >= TOF_Core.SignedInt32.ZERO;
					6:
						_CollisionSet.TryRemoveGeneric(value := queryForCall, releaseValue := releaseQuery, removed => found);
				END_CASE

				queryForCall.Reset();

				_Assertions.ThatBool(
					actual := found,
					message := TOF_Core.WideStrings.Concat255(
						scenarioDescription,
						": ",
						"Owned and borrowed queries must preserve found and missing outcomes"
					)
				).ToBe(expected := foundCase = 1);
				_Assertions.ThatUDInt(
					actual := _CloneExitCount,
					message := TOF_Core.WideStrings.Concat255(
						scenarioDescription,
						": ",
						"Only an explicitly released owned query may be destroyed by lookup"
					)
				).ToBe(expected := TO_UDINT(ownedCase * releaseCase));

				IF NOT releaseQuery THEN
					IF ownedCase = 1 AND_THEN _CloneExitCount <> TOF_Core.UnsignedInt32.ZERO THEN
						// The count assertion above already reports unexpected destruction.
						_Query.Reset();
					ELSE
						_Assertions.ThatBool(
							actual := _Query.IsNull,
							message := TOF_Core.WideStrings.Concat255(
								scenarioDescription,
								": ",
								"Retained query descriptor must remain valid"
							)
						).IsFalse();
						queryAsInterface := _Query.AsIObject();
						_Assertions.ThatBool(
							actual := queryAsInterface <> 0,
							message := TOF_Core.WideStrings.Concat255(
								scenarioDescription,
								": ",
								"Retained query object must remain alive"
							)
						).IsTrue();
						_Query.Release();
					END_IF
				END_IF

				_Assertions.ThatUDInt(
					actual := _CloneExitCount,
					message := TOF_Core.WideStrings.Concat255(
						scenarioDescription,
						": ",
						"Each owned query must have exactly one disposal owner"
					)
				).ToBe(expected := TO_UDINT(ownedCase));
			END_FOR
		END_FOR
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="hashCollisionGrowth" Id="{67db2ca2-2726-4cfc-ba65-9b0105033495}">
      <Declaration><![CDATA[(*!
<summary>Preserves collision chains through growth, middle removal, reinsertion and reuse.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE hashCollisionGrowth
VAR
	i : DINT;
	removed : BOOL;
	foundValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CollisionDictionary.DefaultDynamicAllocationElementCount := 2;
_CollisionSet.DefaultDynamicAllocationElementCount := 2;

FOR i := 1 TO 25 DO
	_CollisionDictionary.SetCopy(key := i, value := i);
	_CollisionSet.SetCopy(value := i);
END_FOR

_Assertions.ThatDInt(
	actual := _CollisionDictionary.Length,
	message := "All dictionary collisions must fit"
).ToBe(expected := 25);
_Assertions.ThatDInt(
	actual := _CollisionSet.Length,
	message := "All set collisions must fit"
).ToBe(expected := 25);

FOR i := 1 TO 25 DO
	_Assertions.ThatBool(
		actual := _CollisionDictionary.TryGetValueByKey(key := i, value => foundValue),
		message := "Growth must retain each dictionary collision"
	).IsTrue();
	_Assertions.ThatDInt(
		actual := foundValue.AsDInt(),
		message := "Dictionary collision value must match"
	).ToBe(expected := i);
	_Assertions.ThatBool(
		actual := _CollisionSet.Contains(value := i),
		message := "Growth must retain each set collision"
	).IsTrue();
END_FOR

_CollisionDictionary.TryRemoveByKey(key := _MiddleScalar, removed => removed);
_Assertions.ThatBool(
	actual := removed,
	message := "Middle collision must be removed"
).IsTrue();
_CollisionSet.TryRemove(value := _MiddleScalar, removed => removed);
_Assertions.ThatBool(
	actual := removed,
	message := "Middle set collision must be removed"
).IsTrue();
_Assertions.ThatBool(
	actual := _CollisionDictionary.ContainsKey(key := _MiddleScalar),
	message := "Removed key must be absent"
).IsFalse();
_Assertions.ThatBool(
	actual := _CollisionSet.Contains(value := _MiddleScalar),
	message := "Removed value must be absent"
).IsFalse();
_CollisionDictionary.SetCopy(key := _MiddleScalar, value := _OtherScalar);
_CollisionSet.SetCopy(value := _MiddleScalar);

FOR i := 1 TO 25 DO
	_Assertions.ThatBool(
		actual := _CollisionDictionary.ContainsKey(key := i),
		message := "Rebuild must preserve dictionary links"
	).IsTrue();
	_Assertions.ThatBool(
		actual := _CollisionSet.Contains(value := i),
		message := "Rebuild must preserve set links"
	).IsTrue();
END_FOR

_CollisionDictionary.Clear();
_CollisionSet.Clear();
_CollisionDictionary.SetCopy(key := _Scalar, value := _OtherScalar);
_CollisionSet.SetCopy(value := _Scalar);
_Assertions.ThatBool(
	actual := _CollisionDictionary.ContainsKey(key := _Scalar),
	message := "Dictionary comparer must survive Clear"
).IsTrue();
_Assertions.ThatBool(
	actual := _CollisionSet.Contains(value := _Scalar),
	message := "Set comparer must survive Clear"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="hashEqualityRepresentations" Id="{a210a102-9b79-49fb-a454-bf212056ddda}">
      <Declaration><![CDATA[(*!
<summary>Uses matching hashes for cross-width integers, signed zero, NaN and empty descriptors.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE hashEqualityRepresentations]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Dictionary.SetCopy(key := _SignedKey, value := _Scalar);
_Dictionary.SetCopy(key := _UnsignedKey, value := _OtherScalar);
_Set.SetCopy(value := _SignedKey);
_Set.SetCopy(value := _UnsignedKey);
_Assertions.ThatDInt(
	actual := _Dictionary.Length,
	message := "Equal integer widths must share a key"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _Set.Length,
	message := "Equal integer widths must share an entry"
).ToBe(expected := 1);

_RealBits.Raw := TOF_Core.Reals.ZERO_BITS;
_Dictionary.SetCopy(key := _RealBits.Value, value := _Scalar);
_Set.SetCopy(value := _RealBits.Value);
_LongRealBits.Raw := NOT TOF_Core.LongReals.MAGNITUDE_MASK;
_Dictionary.SetCopy(key := _LongRealBits.Value, value := _OtherScalar);
_Set.SetCopy(value := _LongRealBits.Value);
_Assertions.ThatDInt(
	actual := _Dictionary.Length,
	message := "Signed floating zeros must share a key"
).ToBe(expected := 2);
_Assertions.ThatDInt(
	actual := _Set.Length,
	message := "Signed floating zeros must share an entry"
).ToBe(expected := 2);

_RealBits.Raw := TOF_Core.Reals.CANONICAL_NAN_BITS;
_LongRealBits.Raw := TOF_Core.LongReals.CANONICAL_NAN_BITS;
_Dictionary.SetCopy(key := _RealBits.Value, value := _Scalar);
_Dictionary.SetCopy(key := _LongRealBits.Value, value := _OtherScalar);
_Set.SetCopy(value := _RealBits.Value);
_Set.SetCopy(value := _LongRealBits.Value);
_Assertions.ThatDInt(
	actual := _Dictionary.Length,
	message := "Cross-width NaNs must share a key"
).ToBe(expected := 3);
_Assertions.ThatDInt(
	actual := _Set.Length,
	message := "Cross-width NaNs must share an entry"
).ToBe(expected := 3);

_Query.Reset();
_Dictionary.SetGeneric(key := _Query, value := _Query);
_Set.SetGeneric(value := _Query);
_Assertions.ThatBool(
	actual := _Dictionary.ContainsGenericKey(key := _Query),
	message := "Empty key must be searchable"
).IsTrue();
_Assertions.ThatBool(
	actual := _Set.ContainsGeneric(value := _Query),
	message := "Empty entry must be searchable"
).IsTrue();
_Assertions.ThatDInt(
	actual := _Dictionary.Length,
	message := "Empty must remain distinct from nonempty values"
).ToBe(expected := 4);
_Assertions.ThatDInt(
	actual := _Set.Length,
	message := "Empty must remain distinct from nonempty values"
).ToBe(expected := 4);]]></ST>
      </Implementation>
    </Method>
    <Method Name="hashOwnershipAliases" Id="{bc4685aa-c18b-477c-8aa2-07a0b8a69274}">
      <Declaration><![CDATA[(*!
<summary>Disposes shared key/value allocations once and retains same-allocation set ownership.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE hashOwnershipAliases
VAR
	borrowedValue : TOF_Core.GENERIC_VALUE;
	pair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[prepareOwnedValue();
borrowedValue := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := _OwnedValue.TypeClass,
	address := _OwnedValue.Address,
	size := _OwnedValue.Size,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_Dictionary.SetGeneric(key := _OwnedValue, value := _OwnedValue);
_OwnedValue.Reset();
pair := _Dictionary.GetKeyValuePairByIndex(index := 0);
_Assertions.ThatBool(
	actual := pair.Key.IsMemoryOwner,
	message := "Shared pair ownership must belong to key"
).IsTrue();
_Assertions.ThatBool(
	actual := pair.Value.IsMemoryOwner,
	message := "Shared pair value must remain borrowed"
).IsFalse();
_Dictionary.SetGeneric(key := borrowedValue, value := borrowedValue);
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Retained pair storage must stay alive"
).ToBe(expected := 0);
_Dictionary.Clear();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Shared pair must be destroyed once"
).ToBe(expected := 1);

prepareOwnedValue();
borrowedValue := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := _OwnedValue.TypeClass,
	address := _OwnedValue.Address,
	size := _OwnedValue.Size,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_Set.SetGeneric(value := _OwnedValue);
_OwnedValue.Reset();
_Set.SetGeneric(value := borrowedValue);
_Assertions.ThatBool(
	actual := _Set.GetByIndex(index := 0).IsMemoryOwner,
	message := "Set replacement must preserve owner"
).IsTrue();
_Set.Clear();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Retained set storage must be destroyed once"
).ToBe(expected := 2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="listOwnershipReplacement" Id="{df659c96-f5b4-4a47-91de-2a63277579b9}">
      <Declaration><![CDATA[(*!
<summary>Preserves ownership when replacing a stored value with its borrowed same-allocation alias.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE listOwnershipReplacement
VAR
	borrowedValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[prepareOwnedValue();
_List.AppendGeneric(value := _OwnedValue);
_OwnedValue.Reset();
borrowedValue := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := _List.Get(index := 0).TypeClass,
	address := _List.Get(index := 0).Address,
	size := _List.Get(index := 0).Size,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_List.SetGeneric(index := 0, value := borrowedValue);
_Assertions.ThatBool(
	actual := _List.Get(index := 0).IsMemoryOwner,
	message := "Borrowed replacement must preserve owner"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Same allocation must remain alive"
).ToBe(expected := 0);
_List.Clear();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Retained allocation must be destroyed once"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="listRemovalLimits" Id="{d7420509-896a-4f15-8a36-375b455f0596}">
      <Declaration><![CDATA[(*!
<summary>Applies skip and maxRemoved and preserves completed removals after a predicate failure.</summary>
<description>
Checks full-width skip before any predicate call. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE listRemovalLimits
VAR
	i : DINT;
	removedCount : DINT;
	rejected : BOOL;
	found : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 5 DO
	_List.AppendCopy(value := i);
END_FOR

_Predicate.ResetCount();
found := _List.FindSingle(predicate := _Predicate, skip := TOF_Core.UnsignedInt32.MAX_VALUE);
_Assertions.ThatBool(actual := found, message := "Maximum skip cannot select a match").IsFalse();
_Assertions.ThatUDInt(
	actual := _Predicate.CallCount,
	message := "FindSingle must skip the search when skip exceeds Length"
).ToBe(expected := 0);
_Predicate.ResetCount();
_List.RemoveMatched(predicate := _Predicate, skip := TOF_Core.UnsignedInt32.MAX_VALUE, removedCount => removedCount);
_Assertions.ThatDInt(actual := removedCount, message := "Maximum skip cannot remove a match").ToBe(expected := 0);
_Assertions.ThatUDInt(
	actual := _Predicate.CallCount,
	message := "RemoveMatched must skip traversal when skip exceeds Length"
).ToBe(expected := 0);
_Assertions.ThatDInt(actual := _List.Length, message := "Maximum skip must preserve the list").ToBe(expected := 5);

_Predicate.ResetCount();
_List.RemoveMatched(predicate := _Predicate, skip := 1, maxRemoved := 2, removedCount => removedCount);
_Assertions.ThatDInt(
	actual := removedCount,
	message := "Removal must obey the positive limit"
).ToBe(expected := 2);
_Assertions.ThatUDInt(
	actual := _Predicate.CallCount,
	message := "Limit must stop further callbacks"
).ToBe(expected := 3);
_Assertions.ThatDInt(
	actual := _List.Length,
	message := "Two matches must be removed"
).ToBe(expected := 3);
_Assertions.ThatDInt(
	actual := _List.Get(index := 2).AsDInt(),
	message := "Skipped last match must remain"
).ToBe(expected := 5);
_Predicate.ResetCount();
_List.RemoveMatched(predicate := _Predicate, maxRemoved := 0, removedCount => removedCount);
_Assertions.ThatUDInt(
	actual := _Predicate.CallCount,
	message := "Zero limit must not invoke predicate"
).ToBe(expected := 0);
_Assertions.ThatDInt(
	actual := removedCount,
	message := "Zero limit must report no removals"
).ToBe(expected := 0);

_List.Clear();

FOR i := 1 TO 5 DO
	_List.AppendCopy(value := i);
END_FOR

_Predicate.ResetCount();
_Predicate.ThrowOnCall := 2;

__TRY
	_List.RemoveMatched(predicate := _Predicate, removedCount => removedCount);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection predicate rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Predicate failure must propagate"
).IsTrue();
_Assertions.ThatDInt(
	actual := _List.Length,
	message := "Completed removal must not roll back"
).ToBe(expected := 4);
_Assertions.ThatDInt(
	actual := _List.Get(index := 3).AsDInt(),
	message := "Remaining order must be valid"
).ToBe(expected := 4);]]></ST>
      </Implementation>
    </Method>
    <Method Name="missingCursorSources" Id="{86e70691-368c-463b-87c5-cd16a796b09e}">
      <Declaration><![CDATA[(*!
<summary>Diagnoses null constructor sources outside FB_init for all six cursors and concrete current views.</summary>
<description>
All six cursors are constructed with null sources without throwing during FB_init. MoveNext, generic
Current and concrete current views must report configuration failure in the current cyclic task. Reset
remains a local cursor operation that does not access the missing source.
</description>
*)
METHOD PRIVATE missingCursorSources
VAR
	i : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	missingException : TOF_Core.IDataMemberNotSpecifiedException;
	currentValue : TOF_Core.GENERIC_VALUE;
	currentByte : BYTE;
	currentPair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_NullCursors[0] := _NullByteCursor;
_NullCursors[1] := _NullListCursor;
_NullCursors[2] := _NullQueueCursor;
_NullCursors[3] := _NullStackCursor;
_NullCursors[4] := _NullDictionaryCursor;
_NullCursors[5] := _NullSetCursor;

FOR i := 0 TO 5 DO
	rejected := FALSE;

	__TRY
		_NullCursors[i].MoveNext();
	__CATCH(exceptionCode)
		rejected := TRUE;
		caughtException := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		_Assertions.ThatBool(
			actual := __QUERYINTERFACE(caughtException, missingException),
			message := "Missing cursor source must report DataMemberNotSpecifiedException"
		).IsTrue();
	__ENDTRY

	_Assertions.ThatBool(
		actual := rejected,
		message := "MoveNext must reject a missing source"
	).IsTrue();
	rejected := FALSE;

	__TRY
		currentValue := _NullCursors[i].Current;
	__CATCH(exceptionCode)
		rejected := TRUE;
		caughtException := TOF_Core.ExceptionManager.GetLastException(
			exceptionCode := exceptionCode,
			catchPointNamespaceName := NamespaceName,
			catchPointPOUName := __POUNAME(),
			catchPointPosition := __POSITION()
		);
		_Assertions.ThatBool(
			actual := __QUERYINTERFACE(caughtException, missingException),
			message := "Missing cursor source must report DataMemberNotSpecifiedException"
		).IsTrue();
	__ENDTRY

	_Assertions.ThatBool(
		actual := rejected,
		message := "Current must reject a missing source"
	).IsTrue();
	_NullCursors[i].Reset();
END_FOR

rejected := FALSE;

__TRY
	currentByte := _NullByteCursor.CurrentByte;
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, missingException),
		message := "Missing cursor source must report DataMemberNotSpecifiedException"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Concrete CurrentByte must reject a missing source"
).IsTrue();
rejected := FALSE;

__TRY
	currentPair := _NullDictionaryCursor.CurrentKeyValuePair;
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, missingException),
		message := "Missing cursor source must report DataMemberNotSpecifiedException"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Concrete CurrentKeyValuePair must reject a missing source"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="prepareOwnedValue" Id="{d91155de-b00d-493c-bedf-f023f4f8ac57}">
      <Declaration><![CDATA[(*!
<summary>Retains one clone as a fixture-owned descriptor until acceptance or cleanup.</summary>
*)
METHOD PRIVATE prepareOwnedValue]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OwnedObject := _CloneSource.Clone();
_OwnedValue := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
	address := _OwnedObject.SelfAddress,
	size := _OwnedObject.SelfSize,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
);
_OwnedObject := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="prepareResourcesThenReject" Id="{924c7dd0-56c4-4272-8a6b-acfac13af81b}">
      <Declaration><![CDATA[(*!
<summary>Prepares persistent resources and raises before the caller can release them.</summary>
*)
METHOD PRIVATE prepareResourcesThenReject]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Enumerator := _List.CreateEnumerator();
prepareOwnedValue();
TOF_Core.Exceptions.ThrowStandard(
	sourceNamespaceName := NamespaceName,
	sourceClassName := ClassName,
	sourcePOUName := __POUNAME(),
	sourcePosition := __POSITION(),
	message := "Collection fixture rejected"
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="queryFailureCleanup" Id="{401f558f-dd27-455e-be56-1bd570be0ef8}">
      <Declaration><![CDATA[(*!
<summary>Releases owned queries and retains callback diagnostics across cleanup context changes.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE queryFailureCleanup
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_BorrowedSource := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
	address := _CloneSource.SelfAddress,
	size := _CloneSource.SelfSize,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_List.AppendGeneric(value := _BorrowedSource);
_Queue.EnqueueGeneric(value := _BorrowedSource);
_Stack.PushGeneric(value := _BorrowedSource);
_CollisionDictionary.SetCopy(key := _Scalar, value := _Scalar);
_CollisionSet.SetCopy(value := _Scalar);
_CloneSource.ThrowOnEquality := TRUE;
_Equality.ThrowOnEquality := TRUE;

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_List.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection object equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Queue.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection object equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Stack.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection object equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionDictionary.ContainsGenericKey(key := _Query, releaseKey := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionDictionary.GetGenericKeyPosition(key := _Query, releaseKey := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionSet.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionSet.GetGenericValuePosition(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

_Assertions.ThatDInt(
	actual := _List.Length,
	message := "Failed query must not remove list entries"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _CollisionDictionary.Length,
	message := "Failed query must not mutate keys"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _CollisionSet.Length,
	message := "Failed query must not mutate values"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="queueValidationAndGrowth" Id="{00942a04-e7e9-491a-b1fa-70ff9ec4470a}">
      <Declaration><![CDATA[(*!
<summary>Invokes the validator once per enqueue and rejects before growth or adoption.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE queueValidationAndGrowth
VAR
	i : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.DefaultDynamicAllocationElementCount := 2;
_Validator.ResetCount();

FOR i := 1 TO 6 DO
	_Queue.EnqueueCopy(value := i);
END_FOR

_Assertions.ThatUDInt(
	actual := _Validator.CallCount,
	message := "Enqueue must validate exactly once"
).ToBe(expected := 6);
_Assertions.ThatDInt(
	actual := _Queue.Capacity,
	message := "Queue must grow several times"
).ToBe(expected := 6);
_Validator.Reject := TRUE;
prepareOwnedValue();

__TRY
	_Queue.EnqueueGeneric(value := _OwnedValue);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Configured validator must reject"
).IsTrue();
_Assertions.ThatDInt(
	actual := _Queue.Capacity,
	message := "Rejected enqueue must not grow"
).ToBe(expected := 6);
_Assertions.ThatDInt(
	actual := _Queue.Length,
	message := "Rejected enqueue must not insert"
).ToBe(expected := 6);
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected owner must remain caller-owned"
).ToBe(expected := 0);
_OwnedValue.Release();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Caller must retain disposal rights"
).ToBe(expected := 1);
_Validator.Reject := FALSE;

FOR i := 1 TO 6 DO
	_Assertions.ThatDInt(
		actual := _Queue.Peek().AsDInt(),
		message := "Growth must preserve FIFO order"
	).ToBe(expected := i);
	_Queue.RemoveFirst();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="releaseCursors" Id="{edf200c7-708c-4535-b4fb-f19953c2efc7}">
      <Declaration><![CDATA[(*!
<summary>Releases persistent cursor ownership without deleting source collections.</summary>
<description>
Clears interface aliases before best-effort disposal. Latches failed disposal or duplicate ownership.
</description>
*)
METHOD PRIVATE releaseCursors
VAR
	ownedCursor : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Enumerator <> 0 AND_THEN _Enumerator = _SecondEnumerator THEN
	_SecondEnumerator := 0;
	_ReleaseFailed := TRUE;
END_IF

IF _Enumerator <> 0 THEN
	ownedCursor := _Enumerator;
	_Enumerator := 0;

	IF NOT TOF_Core.Memory.TryReleaseDynamicObject(instance := ownedCursor) THEN
		_ReleaseFailed := TRUE;
	END_IF
END_IF

IF _SecondEnumerator <> 0 THEN
	ownedCursor := _SecondEnumerator;
	_SecondEnumerator := 0;

	IF NOT TOF_Core.Memory.TryReleaseDynamicObject(instance := ownedCursor) THEN
		_ReleaseFailed := TRUE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="secondCopyFailureCleanup" Id="{05387444-902c-4477-97ec-535e22b301a0}">
      <Declaration><![CDATA[(*!
<summary>Releases the prepared dictionary key if the second object clone rejects.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE secondCopyFailureCleanup
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FailingCloneSource.ThrowOnClone := TRUE;

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Dictionary.SetCopy(
		key := _CloneSource,
		value := _FailingCloneSource,
		keyIsObject := TRUE,
		valueIsObject := TRUE
	);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection clone rejected");
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Failure must propagate"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Owned temporary must be released exactly once"
).ToBe(expected := 1);

_Assertions.ThatBool(
	actual := _Dictionary.Empty,
	message := "Second clone failure must not insert a pair"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="sortFailurePreservesEntries" Id="{2f096363-0614-4b18-816c-368e0d76e5a3}">
      <Declaration><![CDATA[(*!
<summary>Retains every owned descriptor after comparer failures in both sorting branches.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE sortFailurePreservesEntries
VAR
	i : DINT;
	count : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR count := 16 TO 17 DO
	_List.Clear();

	FOR i := count TO 1 BY -1 DO
		_List.AppendCopy(value := i);
	END_FOR

	_Comparer.ResetCount();
	_Comparer.ThrowOnCall := 3;
	rejected := FALSE;

	__TRY
		_List.Sort(comparer := _Comparer);
	__CATCH(exceptionCode)
		rejected := TRUE;
		assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection comparer rejected");
	__ENDTRY

	_Assertions.ThatBool(
		actual := rejected,
		message := "Comparer failure must propagate"
	).IsTrue();
	_Assertions.ThatDInt(
		actual := _List.Length,
		message := "Failed sort must preserve Length"
	).ToBe(expected := count);
	_Comparer.ThrowOnCall := 0;
	_List.Sort(comparer := _Comparer);

	FOR i := 0 TO count - 1 DO
		_Assertions.ThatDInt(
			actual := _List.Get(index := i).AsDInt(),
			message := "Failed sorting must neither lose nor duplicate entries"
		).ToBe(expected := i + 1);
		_Assertions.ThatBool(
			actual := _List.Get(index := i).IsMemoryOwner,
			message := "Sorting must preserve ownership"
		).IsTrue();
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="staticFullCopyCleanup" Id="{79bd9663-0db2-4bfc-a08f-131939570434}">
      <Declaration><![CDATA[(*!
<summary>Retains static-full diagnostics and disposes prepared copies before adoption.</summary>
<description>
Starts with independent fixture state. The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE staticFullCopyCleanup
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	fullException : TOF_Core.IStaticCollectionFullException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FullList.AppendCopy(value := _Scalar);
_FullQueue.EnqueueCopy(value := _Scalar);
_FullStack.PushCopy(value := _Scalar);
_FullDictionary.SetCopy(key := _Scalar, value := _Scalar);
_FullSet.SetCopy(value := _Scalar);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullList.AppendCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, fullException),
		message := "Static-full diagnostic must survive clone disposal"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Static full must reject Copy"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected copy must be released once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullList.InsertCopy(index := 0, value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, fullException),
		message := "Static-full diagnostic must survive clone disposal"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Static full must reject Copy"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected copy must be released once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullQueue.EnqueueCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, fullException),
		message := "Static-full diagnostic must survive clone disposal"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Static full must reject Copy"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected copy must be released once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullStack.PushCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, fullException),
		message := "Static-full diagnostic must survive clone disposal"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Static full must reject Copy"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected copy must be released once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullDictionary.SetCopy(key := _OtherScalar, value := _CloneSource, valueIsObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, fullException),
		message := "Static-full diagnostic must survive clone disposal"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Static full must reject Copy"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected copy must be released once"
).ToBe(expected := 1);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullSet.SetCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	_Assertions.ThatBool(
		actual := __QUERYINTERFACE(caughtException, fullException),
		message := "Static-full diagnostic must survive clone disposal"
	).IsTrue();
__ENDTRY

_Assertions.ThatBool(
	actual := rejected,
	message := "Static full must reject Copy"
).IsTrue();
_Assertions.ThatUDInt(
	actual := _CloneExitCount,
	message := "Rejected copy must be released once"
).ToBe(expected := 1);

_Assertions.ThatDInt(
	actual := _FullList.Length,
	message := "Full list must retain its entry"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _FullQueue.Length,
	message := "Full queue must retain its entry"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _FullStack.Length,
	message := "Full stack must retain its entry"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _FullDictionary.Length,
	message := "Full dictionary must retain its entry"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _FullSet.Length,
	message := "Full set must retain its entry"
).ToBe(expected := 1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="containsCollectionCallbackFailures" Id="{e743d2ab-92ae-464b-8201-094bef96c4e8}">
      <Declaration><![CDATA[(*!
<summary>Contains hash and equality failures in all six Try methods and still releases owned queries.</summary>
<description>
Each call must reach the selected injection once. Successful lookups after each round verify the stored entries.
The harness clears persistent resources before publication, including
after an aborted call. Terminal OOM injection is reserved for an isolated test.
</description>
*)
METHOD PRIVATE containsCollectionCallbackFailures
VAR
	failureKind : DINT;
	selectedCount : REFERENCE TO UDINT;
	expectedCount : UDINT;
	failureName : WSTRING;
	found : BOOL;
	escaped : BOOL;
	foundValue : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CollisionDictionary.SetCopy(key := _Scalar, value := _OtherScalar);
_CollisionSet.SetCopy(value := _Scalar);

FOR failureKind := 0 TO 1 DO
	_Equality.ThrowOnHash := failureKind = 0;
	_Equality.ThrowOnEquality := failureKind = 1;

	IF _Equality.ThrowOnHash THEN
		selectedCount REF= _Equality.HashFailureCount;
		failureName := "hash";
	ELSE
		selectedCount REF= _Equality.EqualityFailureCount;
		failureName := "equality";
	END_IF

	found := TRUE;
	escaped := FALSE;
	expectedCount := selectedCount + 1;

	__TRY
		found := _CollisionDictionary.TryGetValueByKey(key := _OtherScalar, value => foundValue);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	_Assertions.ThatUDInt(
		actual := selectedCount,
		message := TOF_Core.WideStrings.Concat255("TryGetValueByKey must reach ", failureName, " injection once")
	).ToBe(expected := expectedCount);
	_Assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255("TryGetValueByKey propagated ", failureName, " failure")
	).IsFalse();
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("TryGetValueByKey reported success after ", failureName, " failure")
	).IsFalse();

	prepareOwnedValue();
	_Query := _OwnedValue;
	_OwnedValue.Reset();
	_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;
	found := TRUE;
	escaped := FALSE;
	expectedCount := selectedCount + 1;

	__TRY
		found := _CollisionDictionary.TryGetValueByGenericKey(key := _Query, releaseKey := TRUE, value => foundValue);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	_Assertions.ThatUDInt(
		actual := selectedCount,
		message := TOF_Core.WideStrings.Concat255("TryGetValueByGenericKey must reach ", failureName, " injection once")
	).ToBe(expected := expectedCount);
	_Assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255("TryGetValueByGenericKey propagated ", failureName, " failure")
	).IsFalse();
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("TryGetValueByGenericKey reported success after ", failureName, " failure")
	).IsFalse();
	_Query.Reset();
	_Assertions.ThatUDInt(
		actual := _CloneExitCount,
		message := "Failed Try must dispose its owned query"
	).ToBe(expected := 1);

	found := TRUE;
	escaped := FALSE;
	expectedCount := selectedCount + 1;

	__TRY
		_CollisionDictionary.TryRemoveByKey(key := _OtherScalar, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	_Assertions.ThatUDInt(
		actual := selectedCount,
		message := TOF_Core.WideStrings.Concat255("TryRemoveByKey must reach ", failureName, " injection once")
	).ToBe(expected := expectedCount);
	_Assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255("TryRemoveByKey propagated ", failureName, " failure")
	).IsFalse();
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("TryRemoveByKey reported success after ", failureName, " failure")
	).IsFalse();

	prepareOwnedValue();
	_Query := _OwnedValue;
	_OwnedValue.Reset();
	_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;
	found := TRUE;
	escaped := FALSE;
	expectedCount := selectedCount + 1;

	__TRY
		_CollisionDictionary.TryRemoveByGenericKey(key := _Query, releaseKey := TRUE, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	_Assertions.ThatUDInt(
		actual := selectedCount,
		message := TOF_Core.WideStrings.Concat255("TryRemoveByGenericKey must reach ", failureName, " injection once")
	).ToBe(expected := expectedCount);
	_Assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255("TryRemoveByGenericKey propagated ", failureName, " failure")
	).IsFalse();
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("TryRemoveByGenericKey reported success after ", failureName, " failure")
	).IsFalse();
	_Query.Reset();
	_Assertions.ThatUDInt(
		actual := _CloneExitCount,
		message := "Failed Try must dispose its owned query"
	).ToBe(expected := 1);

	found := TRUE;
	escaped := FALSE;
	expectedCount := selectedCount + 1;

	__TRY
		_CollisionSet.TryRemove(value := _OtherScalar, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	_Assertions.ThatUDInt(
		actual := selectedCount,
		message := TOF_Core.WideStrings.Concat255("TryRemove must reach ", failureName, " injection once")
	).ToBe(expected := expectedCount);
	_Assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255("TryRemove propagated ", failureName, " failure")
	).IsFalse();
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("TryRemove reported success after ", failureName, " failure")
	).IsFalse();

	prepareOwnedValue();
	_Query := _OwnedValue;
	_OwnedValue.Reset();
	_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;
	found := TRUE;
	escaped := FALSE;
	expectedCount := selectedCount + 1;

	__TRY
		_CollisionSet.TryRemoveGeneric(value := _Query, releaseValue := TRUE, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	_Assertions.ThatUDInt(
		actual := selectedCount,
		message := TOF_Core.WideStrings.Concat255("TryRemoveGeneric must reach ", failureName, " injection once")
	).ToBe(expected := expectedCount);
	_Assertions.ThatBool(
		actual := escaped,
		message := TOF_Core.WideStrings.Concat255("TryRemoveGeneric propagated ", failureName, " failure")
	).IsFalse();
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("TryRemoveGeneric reported success after ", failureName, " failure")
	).IsFalse();
	_Query.Reset();
	_Assertions.ThatUDInt(
		actual := _CloneExitCount,
		message := "Failed Try must dispose its owned query"
	).ToBe(expected := 1);
	_Equality.ThrowOnHash := FALSE;
	_Equality.ThrowOnEquality := FALSE;
	found := _CollisionDictionary.TryGetValueByKey(key := _Scalar, value => foundValue);
	_Assertions.ThatBool(
		actual := found,
		message := TOF_Core.WideStrings.Concat255("Dictionary lost the stored key after ", failureName, " failures")
	).IsTrue();

	IF found THEN
		_Assertions.ThatDInt(
			actual := foundValue.AsDInt(),
			message := TOF_Core.WideStrings.Concat255("Dictionary changed the value after ", failureName, " failures")
		).ToBe(expected := _OtherScalar);
	END_IF

	_Assertions.ThatBool(
		actual := _CollisionSet.Contains(value := _Scalar),
		message := TOF_Core.WideStrings.Concat255("Set lost the stored value after ", failureName, " failures")
	).IsTrue();
END_FOR

_Assertions.ThatDInt(
	actual := _CollisionDictionary.Length,
	message := "Failed Try must preserve dictionary"
).ToBe(expected := 1);
_Assertions.ThatDInt(
	actual := _CollisionSet.Length,
	message := "Failed Try must preserve set"
).ToBe(expected := 1);
_Assertions.ThatBool(
	actual := TOF_Core.DynamicMemoryManager.HasAllocationFailed,
	message := "Ordinary rejection is not OOM"
).IsFalse();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{af9c3e36-142d-4cef-b248-d9d1f9f432ca}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete fixture class name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ba040dde-8dd1-48db-9ad1-52fde8717eda}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{a76778b6-eb82-4ade-afff-9fd31047bea2}">
      <Declaration><![CDATA[(*!
<summary>Borrows the test namespace for diagnostic context.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ca11075c-678d-4694-bce8-fef8217a6e02}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{8f03cfc6-f9a8-4435-b30e-2a62d7390fd6}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{02d6656f-98b2-4212-86d8-734a1b42c4cf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
