<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CollectionsContractTestFixture" Id="{8b5b4a57-f628-4a3d-8463-475132104aaf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
