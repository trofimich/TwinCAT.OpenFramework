<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CollectionsContractTestGroup" Id="{1209f4f9-9d28-4683-b15c-94ededbfa210}" SpecialFunc="None">
    <Declaration><![CDATA[(*
