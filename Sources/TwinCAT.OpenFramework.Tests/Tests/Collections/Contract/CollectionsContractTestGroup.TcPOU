(*
Runs the collection contract cases in their original scenario order.

Owns the shared fixture, its child cases and fixed registration array. The cases run sequentially.
Keep the group at a stable address in its owner task.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK CollectionsContractTestGroup EXTENDS TOF_Testing.TestGroup<24>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Fixture : CollectionsContractTestFixture;

	_CopyFailurePreservesException : CollectionsContractTestCase(
		name := "CopyFailurePreservesException",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.COPY_FAILURE_PRESERVES_EXCEPTION
	);
	_SecondCopyFailureCleanup : CollectionsContractTestCase(
		name := "SecondCopyFailureCleanup",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.SECOND_COPY_FAILURE_CLEANUP
	);
	_StaticFullCopyCleanup : CollectionsContractTestCase(
		name := "StaticFullCopyCleanup",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.STATIC_FULL_COPY_CLEANUP
	);
	_ByteOverlapAndBounds : CollectionsContractTestCase(
		name := "ByteOverlapAndBounds",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.BYTE_OVERLAP_AND_BOUNDS
	);
	_ByteSizeRejections : CollectionsContractTestCase(
		name := "ByteSizeRejections",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.BYTE_SIZE_REJECTIONS
	);
	_ListOwnershipReplacement : CollectionsContractTestCase(
		name := "ListOwnershipReplacement",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.LIST_OWNERSHIP_REPLACEMENT
	);
	_ListRemovalLimits : CollectionsContractTestCase(
		name := "ListRemovalLimits",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.LIST_REMOVAL_LIMITS
	);
	_SortFailurePreservesEntries : CollectionsContractTestCase(
		name := "SortFailurePreservesEntries",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.SORT_FAILURE_PRESERVES_ENTRIES
	);
	_QueueValidationAndGrowth : CollectionsContractTestCase(
		name := "QueueValidationAndGrowth",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.QUEUE_VALIDATION_AND_GROWTH
	);
	_HashCollisionGrowth : CollectionsContractTestCase(
		name := "HashCollisionGrowth",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.HASH_COLLISION_GROWTH
	);
	_HashEqualityRepresentations : CollectionsContractTestCase(
		name := "HashEqualityRepresentations",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.HASH_EQUALITY_REPRESENTATIONS
	);
	_HashOwnershipAliases : CollectionsContractTestCase(
		name := "HashOwnershipAliases",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.HASH_OWNERSHIP_ALIASES
	);
	_FullStaticDuplicateUpdates : CollectionsContractTestCase(
		name := "FullStaticDuplicateUpdates",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.FULL_STATIC_DUPLICATE_UPDATES
	);
	_QueryFailureCleanup : CollectionsContractTestCase(
		name := "QueryFailureCleanup",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.QUERY_FAILURE_CLEANUP
	);
	_ContainsCollectionCallbackFailures : CollectionsContractTestCase(
		name := "ContainsCollectionCallbackFailures",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.CONTAINS_COLLECTION_CALLBACK_FAILURES
	);
	_GenericQueryReleaseMatrix : CollectionsContractTestCase(
		name := "GenericQueryReleaseMatrix",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.GENERIC_QUERY_RELEASE_MATRIX
	);
	_AllCursorContracts : CollectionsContractTestCase(
		name := "AllCursorContracts",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.ALL_CURSOR_CONTRACTS
	);
	_FixtureCleanupAfterException : CollectionsContractTestCase(
		name := "FixtureCleanupAfterException",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.FIXTURE_CLEANUP_AFTER_EXCEPTION
	);
	_DefaultSortNumericBranches : CollectionsContractTestCase(
		name := "DefaultSortNumericBranches",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.DEFAULT_SORT_NUMERIC_BRANCHES
	);
	_DefaultSortTextAndObjects : CollectionsContractTestCase(
		name := "DefaultSortTextAndObjects",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.DEFAULT_SORT_TEXT_AND_OBJECTS
	);
	_DefaultSortExplicitAndRejection : CollectionsContractTestCase(
		name := "DefaultSortExplicitAndRejection",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.DEFAULT_SORT_EXPLICIT_AND_REJECTION
	);
	_MissingCursorSources : CollectionsContractTestCase(
		name := "MissingCursorSources",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.MISSING_CURSOR_SOURCES
	);
	_HashTailRemoval : CollectionsContractTestCase(
		name := "HashTailRemoval",
		parent := THIS^,
		fixture := _Fixture,
		scenario := COLLECTIONS_CONTRACT_SCENARIO.HASH_TAIL_REMOVAL
	);
	_OnlineChangeLifecycle : CollectionsOnlineChangeLifecycleTest(
		name := "OnlineChangeLifecycle",
		parent := THIS^
	);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_CopyFailurePreservesException,
		_SecondCopyFailureCleanup,
		_StaticFullCopyCleanup,
		_ByteOverlapAndBounds,
		_ByteSizeRejections,
		_ListOwnershipReplacement,
		_ListRemovalLimits,
		_SortFailurePreservesEntries,
		_QueueValidationAndGrowth,
		_HashCollisionGrowth,
		_HashEqualityRepresentations,
		_HashOwnershipAliases,
		_FullStaticDuplicateUpdates,
		_QueryFailureCleanup,
		_ContainsCollectionCallbackFailures,
		_GenericQueryReleaseMatrix,
		_AllCursorContracts,
		_FixtureCleanupAfterException,
		_DefaultSortNumericBranches,
		_DefaultSortTextAndObjects,
		_DefaultSortExplicitAndRejection,
		_MissingCursorSources,
		_HashTailRemoval,
		_OnlineChangeLifecycle
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{5ca14031-ed35-4c89-937f-25c68a791d41}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{75b74d38-a362-4ae8-8fcc-6896f475c357}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{2d465e61-53e6-415f-bb71-dd626a2ef48d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fbb244e6-3449-41be-ba7e-94f663268872}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{98516ab0-d93a-4bd9-a1df-292b514a0869}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e0f408c9-e036-4a30-936c-8d26ba2fb5b6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{6a939534-ac74-4815-9f23-9e9b565882ca}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{dfa08078-f536-4e43-9d32-08afc1c971a1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
