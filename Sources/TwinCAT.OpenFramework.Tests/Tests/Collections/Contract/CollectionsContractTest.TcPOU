    <Method Name="prepareOwnedValue" Id="{94a5cfa1-a4f4-47f4-a702-9c68d1d7d09b}">
      <Declaration><![CDATA[(*!
<summary>Retains one clone as a suite-owned descriptor until acceptance or cleanup.</summary>
*)
METHOD PRIVATE prepareOwnedValue]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OwnedObject := _CloneSource.Clone();
_OwnedValue := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
	address := _OwnedObject.SelfAddress,
	size := _OwnedObject.SelfSize,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
);
_OwnedObject := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="prepareResourcesThenReject" Id="{ebc32318-fb19-453a-88a7-258899f9ed57}">
      <Declaration><![CDATA[(*!
<summary>Prepares persistent resources and raises before the caller can release them.</summary>
*)
METHOD PRIVATE prepareResourcesThenReject]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Enumerator := _List.CreateEnumerator();
prepareOwnedValue();
TOF_Core.Exceptions.ThrowStandard(
	sourceNamespaceName := NamespaceName,
	sourceClassName := ClassName,
	sourcePOUName := __POUNAME(),
	sourcePosition := __POSITION(),
	message := "Collection fixture rejected"
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="QueryFailureCleanup" Id="{25a0a1a5-f49b-4503-8602-f962fcf0346f}">
      <Declaration><![CDATA[(*!
<summary>Releases owned queries and retains callback diagnostics across cleanup context changes.</summary>
<description>
Prepares an independent initial state. Persistent resources survive an aborted call and are released
by the next testcase or suite destruction. Terminal OOM injection is excluded from this shared task.
</description>
*)
METHOD QueryFailureCleanup
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

_BorrowedSource := TOF_Core.GenericValueFactory.FromParts(
	genericTypeClass := TOF_Core.GENERIC_TYPE_CLASS.OBJECT,
	address := _CloneSource.SelfAddress,
	size := _CloneSource.SelfSize,
	memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
);
_List.AppendGeneric(value := _BorrowedSource);
_Queue.EnqueueGeneric(value := _BorrowedSource);
_Stack.PushGeneric(value := _BorrowedSource);
_CollisionDictionary.SetCopy(key := _Scalar, value := _Scalar);
_CollisionSet.SetCopy(value := _Scalar);
_CloneSource.ThrowOnEquality := TRUE;
_Equality.ThrowOnEquality := TRUE;

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_List.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection object equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Queue.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection object equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Stack.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection object equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionDictionary.ContainsGenericKey(key := _Query, releaseKey := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionDictionary.GetGenericKeyPosition(key := _Query, releaseKey := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionSet.ContainsGeneric(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

prepareOwnedValue();
_Query := _OwnedValue;
_OwnedValue.Reset();

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_CollisionSet.GetGenericValuePosition(value := _Query, releaseValue := TRUE);
	_Query.Reset();
__CATCH(exceptionCode)
	_Query.Reset();
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection equality rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

AssertEquals_DINT(Expected := 1, Actual := _List.Length, Message := 'Failed query must not remove list entries');
AssertEquals_DINT(Expected := 1, Actual := _CollisionDictionary.Length, Message := 'Failed query must not mutate keys');
AssertEquals_DINT(Expected := 1, Actual := _CollisionSet.Length, Message := 'Failed query must not mutate values');

cleanupFixtures();
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="QueueValidationAndGrowth" Id="{ceb33495-1420-4593-8e0b-92638412a698}">
      <Declaration><![CDATA[(*!
<summary>Invokes the validator once per enqueue and rejects before growth or adoption.</summary>
<description>
Prepares an independent initial state. Persistent resources survive an aborted call and are released
by the next testcase or suite destruction. Terminal OOM injection is excluded from this shared task.
</description>
*)
METHOD QueueValidationAndGrowth
VAR
	i : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

_Queue.DefaultDynamicAllocationElementCount := 2;
_Validator.ResetCount();

FOR i := 1 TO 6 DO
	_Queue.EnqueueCopy(value := i);
END_FOR

AssertEquals_UDINT(Expected := 6, Actual := _Validator.CallCount, Message := 'Enqueue must validate exactly once');
AssertEquals_DINT(Expected := 6, Actual := _Queue.Capacity, Message := 'Queue must grow several times');
_Validator.Reject := TRUE;
prepareOwnedValue();

__TRY
	_Queue.EnqueueGeneric(value := _OwnedValue);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection validation rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Configured validator must reject');
AssertEquals_DINT(Expected := 6, Actual := _Queue.Capacity, Message := 'Rejected enqueue must not grow');
AssertEquals_DINT(Expected := 6, Actual := _Queue.Length, Message := 'Rejected enqueue must not insert');
AssertEquals_UDINT(Expected := 0, Actual := _CloneExitCount, Message := 'Rejected owner must remain caller-owned');
_OwnedValue.Release();
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Caller must retain disposal rights');
_Validator.Reject := FALSE;

FOR i := 1 TO 6 DO
	AssertEquals_DINT(Expected := i, Actual := _Queue.Peek().AsDInt(), Message := 'Growth must preserve FIFO order');
	_Queue.RemoveFirst();
END_FOR

cleanupFixtures();
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="releaseCursors" Id="{54f118b4-be9f-4615-948c-91212742aec9}">
      <Declaration><![CDATA[(*!
<summary>Releases persistent cursor ownership without deleting source collections.</summary>
<description>
Clears interface aliases before best-effort disposal; no throwing callbacks or allocation are introduced.
</description>
*)
METHOD PRIVATE releaseCursors
VAR
	ownedCursor : TOF_Core.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Enumerator <> 0 THEN
	ownedCursor := _Enumerator;
	_Enumerator := 0;
	TOF_Core.Memory.TryReleaseDynamicObject(instance := ownedCursor);
END_IF

IF _SecondEnumerator <> 0 THEN
	ownedCursor := _SecondEnumerator;
	_SecondEnumerator := 0;
	TOF_Core.Memory.TryReleaseDynamicObject(instance := ownedCursor);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SecondCopyFailureCleanup" Id="{bb4ab097-b7c4-488b-903f-543dadbc7972}">
      <Declaration><![CDATA[(*!
<summary>Releases the prepared dictionary key if the second object clone rejects.</summary>
<description>
Prepares an independent initial state. Persistent resources survive an aborted call and are released
by the next testcase or suite destruction. Terminal OOM injection is excluded from this shared task.
</description>
*)
METHOD SecondCopyFailureCleanup
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

_FailingCloneSource.ThrowOnClone := TRUE;

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_Dictionary.SetCopy(
		key := _CloneSource,
		value := _FailingCloneSource,
		keyIsObject := TRUE,
		valueIsObject := TRUE
	);
__CATCH(exceptionCode)
	rejected := TRUE;
	assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection clone rejected");
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Failure must propagate');
AssertEquals_UDINT(
	Expected := 1,
	Actual := _CloneExitCount,
	Message := 'Owned temporary must be released exactly once'
);

AssertTrue(Condition := _Dictionary.Empty, Message := 'Second clone failure must not insert a pair');

cleanupFixtures();
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{edd36196-9ccd-4854-9ae1-3d5506ea79c6}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{43d2ba1c-f77a-4a72-b1ae-359401fe6901}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SortFailurePreservesEntries" Id="{f7efe6ff-3e18-4561-b8c8-4b44a929ace0}">
      <Declaration><![CDATA[(*!
<summary>Retains every owned descriptor after comparer failures in both sorting branches.</summary>
<description>
Prepares an independent initial state. Persistent resources survive an aborted call and are released
by the next testcase or suite destruction. Terminal OOM injection is excluded from this shared task.
</description>
*)
METHOD SortFailurePreservesEntries
VAR
	i : DINT;
	count : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

FOR count := 16 TO 17 DO
	_List.Clear();

	FOR i := count TO 1 BY -1 DO
		_List.AppendCopy(value := i);
	END_FOR

	_Comparer.ResetCount();
	_Comparer.ThrowOnCall := 3;
	rejected := FALSE;

	__TRY
		_List.Sort(comparer := _Comparer);
	__CATCH(exceptionCode)
		rejected := TRUE;
		assertOriginalFailure(exceptionCode := exceptionCode, expectedMessage := "Collection comparer rejected");
	__ENDTRY

	AssertTrue(Condition := rejected, Message := 'Comparer failure must propagate');
	AssertEquals_DINT(Expected := count, Actual := _List.Length, Message := 'Failed sort must preserve Length');
	_Comparer.ThrowOnCall := 0;
	_List.Sort(comparer := _Comparer);

	FOR i := 0 TO count - 1 DO
		AssertEquals_DINT(
			Expected := i + 1,
			Actual := _List.Get(index := i).AsDInt(),
			Message := 'Failed sorting must neither lose nor duplicate entries'
		);
		AssertTrue(Condition := _List.Get(index := i).IsMemoryOwner, Message := 'Sorting must preserve ownership');
	END_FOR
END_FOR

cleanupFixtures();
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="StaticFullCopyCleanup" Id="{20ce59d7-26ae-4c1c-a21f-cb8cbf0dad94}">
      <Declaration><![CDATA[(*!
<summary>Retains static-full diagnostics and disposes prepared copies before adoption.</summary>
<description>
Prepares an independent initial state. Persistent resources survive an aborted call and are released
by the next testcase or suite destruction. Terminal OOM injection is excluded from this shared task.
</description>
*)
METHOD StaticFullCopyCleanup
VAR
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	fullException : TOF_Core.IStaticCollectionFullException;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

_FullList.AppendCopy(value := _Scalar);
_FullQueue.EnqueueCopy(value := _Scalar);
_FullStack.PushCopy(value := _Scalar);
_FullDictionary.SetCopy(key := _Scalar, value := _Scalar);
_FullSet.SetCopy(value := _Scalar);

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullList.AppendCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, fullException),
		Message := 'Static-full diagnostic must survive clone disposal'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Static full must reject Copy');
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Rejected copy must be released once');

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullList.InsertCopy(index := 0, value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, fullException),
		Message := 'Static-full diagnostic must survive clone disposal'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Static full must reject Copy');
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Rejected copy must be released once');

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullQueue.EnqueueCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, fullException),
		Message := 'Static-full diagnostic must survive clone disposal'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Static full must reject Copy');
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Rejected copy must be released once');

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullStack.PushCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, fullException),
		Message := 'Static-full diagnostic must survive clone disposal'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Static full must reject Copy');
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Rejected copy must be released once');

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullDictionary.SetCopy(key := _OtherScalar, value := _CloneSource, valueIsObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, fullException),
		Message := 'Static-full diagnostic must survive clone disposal'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Static full must reject Copy');
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Rejected copy must be released once');

rejected := FALSE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

__TRY
	_FullSet.SetCopy(value := _CloneSource, isObject := TRUE);
__CATCH(exceptionCode)
	rejected := TRUE;
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, fullException),
		Message := 'Static-full diagnostic must survive clone disposal'
	);
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Static full must reject Copy');
AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Rejected copy must be released once');

AssertEquals_DINT(Expected := 1, Actual := _FullList.Length, Message := 'Full list must retain its entry');
AssertEquals_DINT(Expected := 1, Actual := _FullQueue.Length, Message := 'Full queue must retain its entry');
AssertEquals_DINT(Expected := 1, Actual := _FullStack.Length, Message := 'Full stack must retain its entry');
AssertEquals_DINT(Expected := 1, Actual := _FullDictionary.Length, Message := 'Full dictionary must retain its entry');
AssertEquals_DINT(Expected := 1, Actual := _FullSet.Length, Message := 'Full set must retain its entry');

cleanupFixtures();
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryCallbackContainment" Id="{fda33962-0fbd-48b7-9aae-aa3a5c793b5d}">
      <Declaration><![CDATA[(*!
<summary>Contains hash and equality failures in all six Try methods and still releases owned queries.</summary>
<description>
Prepares an independent initial state. Persistent resources survive an aborted call and are released
by the next testcase or suite destruction. Terminal OOM injection is excluded from this shared task.
</description>
*)
METHOD TryCallbackContainment
VAR
	failureKind : DINT;
	found : BOOL;
	escaped : BOOL;
	foundValue : TOF_Core.GENERIC_VALUE;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());
cleanupFixtures();
_CloneSource.ObserveExit(counter := _CloneExitCount);
_CloneSource.ClearCloneTransportOnExit := TRUE;
_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;

_CollisionDictionary.SetCopy(key := _Scalar, value := _Scalar);
_CollisionSet.SetCopy(value := _Scalar);

FOR failureKind := 0 TO 1 DO
	_Equality.ThrowOnHash := failureKind = 0;
	_Equality.ThrowOnEquality := failureKind = 1;

	found := TRUE;
	escaped := FALSE;

	__TRY
		found := _CollisionDictionary.TryGetValueByKey(key := _OtherScalar, value => foundValue);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	AssertFalse(Condition := escaped, Message := 'Try callback failure must not escape');
	AssertFalse(Condition := found, Message := 'Try callback failure must report failure');

	prepareOwnedValue();
	_Query := _OwnedValue;
	_OwnedValue.Reset();
	_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;
	found := TRUE;
	escaped := FALSE;

	__TRY
		found := _CollisionDictionary.TryGetValueByGenericKey(key := _Query, releaseKey := TRUE, value => foundValue);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	AssertFalse(Condition := escaped, Message := 'Try callback failure must not escape');
	AssertFalse(Condition := found, Message := 'Try callback failure must report failure');
	_Query.Reset();
	AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Failed Try must dispose its owned query');

	found := TRUE;
	escaped := FALSE;

	__TRY
		_CollisionDictionary.TryRemoveByKey(key := _OtherScalar, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	AssertFalse(Condition := escaped, Message := 'Try callback failure must not escape');
	AssertFalse(Condition := found, Message := 'Try callback failure must report failure');

	prepareOwnedValue();
	_Query := _OwnedValue;
	_OwnedValue.Reset();
	_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;
	found := TRUE;
	escaped := FALSE;

	__TRY
		_CollisionDictionary.TryRemoveByGenericKey(key := _Query, releaseKey := TRUE, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	AssertFalse(Condition := escaped, Message := 'Try callback failure must not escape');
	AssertFalse(Condition := found, Message := 'Try callback failure must report failure');
	_Query.Reset();
	AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Failed Try must dispose its owned query');

	found := TRUE;
	escaped := FALSE;

	__TRY
		_CollisionSet.TryRemove(value := _OtherScalar, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	AssertFalse(Condition := escaped, Message := 'Try callback failure must not escape');
	AssertFalse(Condition := found, Message := 'Try callback failure must report failure');

	prepareOwnedValue();
	_Query := _OwnedValue;
	_OwnedValue.Reset();
	_CloneExitCount := TOF_Core.UnsignedInt32.ZERO;
	found := TRUE;
	escaped := FALSE;

	__TRY
		_CollisionSet.TryRemoveGeneric(value := _Query, releaseValue := TRUE, removed => found);
	__CATCH
		escaped := TRUE;
	__ENDTRY

	AssertFalse(Condition := escaped, Message := 'Try callback failure must not escape');
	AssertFalse(Condition := found, Message := 'Try callback failure must report failure');
	_Query.Reset();
	AssertEquals_UDINT(Expected := 1, Actual := _CloneExitCount, Message := 'Failed Try must dispose its owned query');
END_FOR

AssertEquals_DINT(Expected := 1, Actual := _CollisionDictionary.Length, Message := 'Failed Try must preserve dictionary');
AssertEquals_DINT(Expected := 1, Actual := _CollisionSet.Length, Message := 'Failed Try must preserve set');
AssertFalse(Condition := TOF_Core.DynamicMemoryManager.HasAllocationFailed, Message := 'Ordinary rejection is not OOM');

cleanupFixtures();
testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>