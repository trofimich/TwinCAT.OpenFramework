<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="CollectionEqualityProbe" Id="{1d0c94aa-e2da-44e8-81c6-5e3a689d32d5}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides default value equality with controlled collisions and callback failures.</summary>
<description>
Constant hash codes deliberately exercise chains. Equality delegates to GENERIC_VALUE defaults without
recursively supplying this strategy. MatchEveryValue selects a universal equivalence relation with the same
constant hash. Its value stays fixed while entries are stored. Failure-injection flags do not change
successful equality or hash results.
</description>
*)

FUNCTION_BLOCK CollectionEqualityProbe EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IEqualityComparer
VAR_INPUT
	//! <summary>Selects universal equality before populating a query-matrix container.</summary>
	MatchEveryValue : BOOL;
	//! <summary>Rejects the next and subsequent hash callbacks until cleared.</summary>
	ThrowOnHash : BOOL;
	//! <summary>Rejects equality callbacks until cleared.</summary>
	ThrowOnEquality : BOOL;
END_VAR
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AreEqual" Id="{bbb7dddc-7975-42f7-975a-5b032ae0dfe6}">
      <Declaration><![CDATA[(*!
<summary>Compares borrowed descriptors or raises the configured equality failure.</summary>
*)
METHOD AreEqual : BOOL
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThrowOnEquality THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Collection equality rejected"
	);
END_IF

IF MatchEveryValue THEN
	AreEqual := TRUE;
ELSE
	AreEqual := first.Equals(otherValue := second);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b7c0f758-f554-4cf7-a1c1-3730eda5b583}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete test fixture class name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{627c97f1-73a5-4f2a-b529-cc3308c38598}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetValueHashCode" Id="{94f6e8ad-9149-4da6-a555-3a1bcb68639b}">
      <Declaration><![CDATA[(*!
<summary>Returns one fixed hash for all supported values, or raises the configured hash failure.</summary>
<description>
Equal values therefore always have equal hashes. This fixture intentionally sacrifices distribution.
</description>
*)
METHOD GetValueHashCode : UDINT
VAR_INPUT
	value : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThrowOnHash THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Collection hash rejected"
	);
END_IF

GetValueHashCode := TOF_Core.UnsignedInt32.ZERO;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{a445a73b-9bd9-4ae8-be12-a048d8562ee6}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized test namespace.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9fe59931-afd1-404f-bb02-c1ea4c46d754}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{eec7d6f0-86a5-414e-b74e-7b8b1f8c0912}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{76e91b5f-d4ce-4871-898f-1122ecf0ba46}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>