<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="CollectionValidatorProbe" Id="{ac945079-4a1f-462a-9af2-7b394a844b26}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Counts validation calls and optionally rejects a borrowed descriptor.</summary>
<description>
Used by persistent collection fixtures. Rejection changes only the call counter and propagates StandardException.
</description>
*)

FUNCTION_BLOCK CollectionValidatorProbe EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IGenericValueValidator
VAR_INPUT
	//! <summary>Rejects every value after counting the call.</summary>
	Reject : BOOL;
END_VAR
VAR_OUTPUT
	//! <summary>Number of completed entries to Validate since ResetCount.</summary>
	CallCount : UDINT;
END_VAR
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{6baab6a2-4127-411a-9489-018b0a612093}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete test fixture class name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d068a221-e9d5-48f2-bbc6-73ad6de372a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{8665a001-75c3-450d-a6ad-67c4f1a46125}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized test namespace.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{293b588e-9059-47a8-bc64-54580c59ec43}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetCount" Id="{2af8b74b-3b57-45fa-b052-94dc465280f1}">
      <Declaration><![CDATA[(*!
<summary>Resets only the observed validation call count.</summary>
*)
METHOD ResetCount]]></Declaration>
      <Implementation>
        <ST><![CDATA[CallCount := TOF_Core.UnsignedInt32.ZERO;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{ff28017f-23c6-46e6-aa4d-3d1b69946a6a}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{51589e5d-f72d-4f97-8057-6140e2d26a9e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Validate" Id="{032ae754-262f-4475-a977-427844754c31}">
      <Declaration><![CDATA[(*!
<summary>Counts the call and rejects when configured without adopting the descriptor.</summary>
*)
METHOD Validate
VAR_INPUT
	validatedObjectName : WSTRING;
END_VAR
VAR_IN_OUT CONSTANT
	valueToValidate : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CallCount := CallCount + 1;

IF Reject THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Collection validation rejected"
	);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>