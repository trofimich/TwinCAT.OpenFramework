<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="CollectionComparerProbe" Id="{7918377c-129c-45cb-8fc2-994d1ad69d0c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Counts generic ordering comparisons and raises at a configured call.</summary>
<description>
Operands remain borrowed and unchanged. Default generic ordering is used before and after injection.
</description>
*)

FUNCTION_BLOCK CollectionComparerProbe EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR_INPUT
	//! <summary>One-based comparison number that raises; zero disables injection.</summary>
	ThrowOnCall : UDINT;
END_VAR
VAR_OUTPUT
	//! <summary>Number of comparisons since ResetCount.</summary>
	CallCount : UDINT;
END_VAR
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{ef0560d5-0e3a-4e01-9335-23b307876a53}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete test fixture class name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{004c112e-3d6f-4cbf-b0ea-a2351dc1efff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{6071c708-0042-4607-b46d-b01d44215f02}">
      <Declaration><![CDATA[(*!
<summary>Compares compatible borrowed values or raises on the selected callback.</summary>
*)
METHOD Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CallCount := CallCount + 1;

IF ThrowOnCall <> TOF_Core.UnsignedInt32.ZERO AND_THEN CallCount = ThrowOnCall THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Collection comparer rejected"
	);
END_IF

Compare := first.CompareTo(otherValue := second);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{368ff916-3313-483a-b854-82932c87fd3e}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized test namespace.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{156890cb-37c4-4e9c-a994-fddc190170cd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetCount" Id="{cf1613a8-609b-4df4-878b-9c9bb2da4fbc}">
      <Declaration><![CDATA[(*!
<summary>Resets only the observed comparison count.</summary>
*)
METHOD ResetCount]]></Declaration>
      <Implementation>
        <ST><![CDATA[CallCount := TOF_Core.UnsignedInt32.ZERO;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{03c0c7d9-c85c-4db5-ac41-81e329161b5a}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{1798990f-7e6d-40d4-bdcb-6fef3cecc1a2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>