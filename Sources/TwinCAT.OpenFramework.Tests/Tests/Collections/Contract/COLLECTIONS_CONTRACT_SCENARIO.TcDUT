<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <DUT Name="COLLECTIONS_CONTRACT_SCENARIO" Id="{f89afc4f-6e4f-4a03-96b9-ce888bde56ea}">
    <Declaration><![CDATA[(*
Selects one scenario in the collection contract group.

Each value maps to a separately reported single-cycle case.
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE COLLECTIONS_CONTRACT_SCENARIO :
(
	COPY_FAILURE_PRESERVES_EXCEPTION,
	SECOND_COPY_FAILURE_CLEANUP,
	STATIC_FULL_COPY_CLEANUP,
	BYTE_OVERLAP_AND_BOUNDS,
	BYTE_SIZE_REJECTIONS,
	LIST_OWNERSHIP_REPLACEMENT,
	LIST_REMOVAL_LIMITS,
	SORT_FAILURE_PRESERVES_ENTRIES,
	QUEUE_VALIDATION_AND_GROWTH,
	HASH_COLLISION_GROWTH,
	HASH_EQUALITY_REPRESENTATIONS,
	HASH_OWNERSHIP_ALIASES,
	FULL_STATIC_DUPLICATE_UPDATES,
	QUERY_FAILURE_CLEANUP,
	CONTAINS_COLLECTION_CALLBACK_FAILURES,
	GENERIC_QUERY_RELEASE_MATRIX,
	ALL_CURSOR_CONTRACTS,
	FIXTURE_CLEANUP_AFTER_EXCEPTION,
	DEFAULT_SORT_NUMERIC_BRANCHES,
	DEFAULT_SORT_TEXT_AND_OBJECTS,
	DEFAULT_SORT_EXPLICIT_AND_REJECTION,
	MISSING_CURSOR_SOURCES,
	HASH_TAIL_REMOVAL
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>