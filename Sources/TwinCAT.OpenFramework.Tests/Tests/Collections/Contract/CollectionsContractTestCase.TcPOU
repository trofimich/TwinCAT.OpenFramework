<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CollectionsContractTestCase" Id="{09213e51-3db0-4f04-aaf0-6974e3d0b778}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Runs one contract scenario and reports its own result.

Borrows the group fixture. The owning group serializes its cases in one task. OnAfterTest clears the fixture
after a successful run or an interrupted scenario. Terminal allocation failure uses the task boundary.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK CollectionsContractTestCase EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Fixture : REFERENCE TO CollectionsContractTestFixture;
	_Scenario : COLLECTIONS_CONTRACT_SCENARIO;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{6dcf16ce-b62f-4ce9-a6bc-617a87b0163b}">
      <Declaration><![CDATA[(*
Binds the group fixture and selects this case scenario.

Stores a borrowed reference without invoking the fixture. The owning group keeps it alive and
serializes use. TestElement initializes the name and parent.

name — Display name of this case.
parent — Owning group.
fixture — Live fixture owned by the group.
scenario — Scenario assigned to this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	fixture : REFERENCE TO CollectionsContractTestFixture;
	scenario : COLLECTIONS_CONTRACT_SCENARIO;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_Fixture REF= fixture;
	_Scenario := scenario;
END_IF

FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{47d3479c-a695-4b8c-b216-509704468201}">
      <Declaration><![CDATA[(*
Runs the chosen scenario with the current assertions.

The fixture stays available to OnAfterTest if a call interrupts the scenario.
*)
METHOD PROTECTED ExecuteTest
VAR
	assertions : REFERENCE TO TOF_Testing.Assertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(_Fixture) THEN
	RecordFailure(message := "Missing collection contract fixture");

	RETURN;
END_IF

assertions REF= Assert;
_Fixture.ExecuteScenario(scenario := _Scenario, assertions := assertions);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{8dcf536d-cd16-4e0e-bd03-ed16591b7f88}">
      <Declaration><![CDATA[(*
Clears the shared fixture and reports failed checked releases.

The fixture releases cursors before their sources. Cleanup preserves the first test failure and logs
any subsequent disposal failure.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(_Fixture) THEN
	RETURN;
END_IF

IF NOT _Fixture.FinishScenario() THEN
	IF Outcome = TOF_Testing.TEST_OUTCOME.FAILED THEN
		Tc2_System.ADSLOGSTR(
			msgCtrlMask := Tc2_System.Global_Variables.ADSLOG_MSGTYPE_ERROR,
			msgFmtStr := 'Collection contract fixture cleanup failed in %s',
			strArg := TO_STRING(Name)
		);
	ELSE
		RecordFailure(message := "Collection contract fixture cleanup failed");
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{e331bb1c-f8d3-4996-9297-a6ba3ee1b0b5}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e278a293-b085-49d5-acb3-16d4529832d3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{bb5478b2-db99-4486-957e-938dce74a810}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{044ffc15-d6ea-4cb6-add6-e94baa6c70c7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{93c90dbe-316e-414c-8233-1662d41e079a}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0b411ef9-461e-4216-a527-81a2d74a7392}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
