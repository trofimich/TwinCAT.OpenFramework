(*!
<summary>Exposes a scalar sort key for the collection natural-order fixture.</summary>
<description>
Borrowed interface used to reject unrelated IComparable implementations before reading a sort key.
</description>
*)

INTERFACE ICollectionSortValue EXTENDS TOF_Core.IComparable]]></Declaration>
    <Method Name="GetSortValue" Id="{85a33168-1ff8-4a23-a9a0-cdbbdfe89c4f}">
      <Declaration><![CDATA[(*!
<summary>Returns a copy of the fixture sort key without changing state.</summary>
*)
METHOD GetSortValue : DINT]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
