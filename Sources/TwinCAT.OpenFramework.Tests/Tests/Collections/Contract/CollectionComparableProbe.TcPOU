<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="CollectionComparableProbe" Id="{be1ce13d-533b-447e-b1ca-bc68f369e23c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Provides a scalar natural order for borrowed OBJECT list entries.</summary>
<description>
Supports other ICollectionSortValue objects. Comparisons copy the other scalar key without mutating or
retaining either object. The caller keeps sort keys stable during sorting; no allocation or cleanup is used.
</description>
*)

FUNCTION_BLOCK CollectionComparableProbe EXTENDS TOF_Core.Object IMPLEMENTS ICollectionSortValue
VAR_INPUT
	//! <summary>Scalar key defining the fixture's natural order.</summary>
	SortValue : DINT;
END_VAR
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{524c25fa-effd-47d2-899c-109cd5d7359a}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete test fixture class name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ff64f80e-ffa8-467f-b97b-1226aa0f4865}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CompareTo" Id="{ac7bfd62-7bdb-4ae7-a745-a4778e7bded0}">
      <Declaration><![CDATA[(*!
<summary>Compares supported scalar-key objects and rejects null or unrelated comparable types.</summary>
*)
METHOD CompareTo : TOF_Core.COMPARISON_RESULT
VAR_IN_OUT CONSTANT
	otherValue : TOF_Core.IComparable;
END_VAR
VAR
	otherSortValue : ICollectionSortValue;
	otherKey : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF otherValue = 0 THEN
	TOF_Core.Exceptions.ThrowArgumentNotSpecified(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		argumentName := 'otherValue'
	);
END_IF

IF NOT __QUERYINTERFACE(otherValue, otherSortValue) THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Unsupported collection comparable fixture"
	);
END_IF

otherKey := otherSortValue.GetSortValue();

IF SortValue < otherKey THEN
	CompareTo := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF SortValue > otherKey THEN
	CompareTo := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	CompareTo := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSortValue" Id="{356150dc-a1f2-4d5a-86ce-b5786a3643b8}">
      <Declaration><![CDATA[(*!
<summary>Copies the configured sort key without mutation.</summary>
*)
METHOD GetSortValue : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetSortValue := SortValue;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{362a1566-5de6-4e9b-a852-0a7ebe305c75}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized test namespace.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b0bab4ca-9949-451d-a46c-f9767d6a89d2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a9b46d4f-076e-4d4f-9c98-cab3610a380b}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ccbd9b7a-4d0c-4e74-882b-c762762d444a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>