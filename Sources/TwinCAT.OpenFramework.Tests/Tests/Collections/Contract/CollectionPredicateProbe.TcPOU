<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="CollectionPredicateProbe" Id="{5e3735a0-3613-4bc1-8e1c-0ae678b198ec}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Matches every borrowed value until a configured callback count raises.</summary>
<description>
Counts callbacks without retaining operands. Used to prove skip/limit behavior and partial removal state.
</description>
*)

FUNCTION_BLOCK CollectionPredicateProbe EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IPredicate
VAR_INPUT
	//! <summary>One-based callback number that raises; zero disables injection.</summary>
	ThrowOnCall : UDINT;
END_VAR
VAR_OUTPUT
	//! <summary>Number of Check callbacks since ResetCount.</summary>
	CallCount : UDINT;
END_VAR
VAR_STAT
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Check" Id="{79905830-e391-40db-836f-7dc38eec47fb}">
      <Declaration><![CDATA[(*!
<summary>Counts the callback and returns TRUE unless this call is selected to raise.</summary>
*)
METHOD Check : BOOL
VAR_INPUT
	valueToCompare : __SYSTEM.AnyType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CallCount := CallCount + 1;

IF ThrowOnCall <> TOF_Core.UnsignedInt32.ZERO AND_THEN CallCount = ThrowOnCall THEN
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Collection predicate rejected"
	);
END_IF

Check := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{1f8756c7-6ef7-4068-8a8e-5151047ea9a6}">
      <Declaration><![CDATA[(*!
<summary>Provides the concrete test fixture class name.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fec6afed-a1dc-4983-be60-7ba684925c85}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c0834b5c-bfaf-4b09-8540-f98fed854781}">
      <Declaration><![CDATA[(*!
<summary>Borrows the compiler-initialized test namespace.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e77d9cd1-5a5c-480b-9cec-0936a3ea62cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetCount" Id="{1bc0b299-4a86-466b-96c6-0c0d50e2b6b8}">
      <Declaration><![CDATA[(*!
<summary>Resets only the observed callback count.</summary>
*)
METHOD ResetCount]]></Declaration>
      <Implementation>
        <ST><![CDATA[CallCount := TOF_Core.UnsignedInt32.ZERO;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{8b4dd734-66d8-4a8d-a128-fd683d012330}">
      <Declaration><![CDATA[(*!
<summary>Reports the complete fixture instance size, excluding separately allocated storage.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7509b1cf-f22c-428f-acb3-a4c5d1db05ef}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>