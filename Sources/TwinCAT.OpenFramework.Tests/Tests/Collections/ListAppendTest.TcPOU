<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ListAppendTest" Id="{c20d66f6-2634-4e53-89a2-9c1041f5b57a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks copy append order and independence from the source.</summary>
<description>
Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListAppendTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{2ce6d350-abbd-42ed-a202-9f0f484cc617}">
      <Declaration><![CDATA[(*!
<summary>Binds the list fixture for this case.</summary>
<description>
Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.
</description>
<param name="name">Display name of this case.</param>
<param name="parent">Group that owns this case.</param>
<param name="list">Required live list reserved for this case.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteTest" Id="{6eb487be-1479-4c26-971b-9efe4b9635a1}">
      <Declaration><![CDATA[(*!
<summary>Checks copy append order and independence from the source.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	expected : ARRAY [0..2] OF STRING := ['String0', 'String1', 'String2'];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);

values[2] := 'Changed';

Assert.ThatDInt(
	actual := _List.Length,
	message := "Unexpected sequence after Append length"
).ToBe(expected := DINT#3);

FOR i := 0 TO 2 DO
	Assert.ThatString(
		actual := _List.Get(index := i).AsString255(),
		message := TOF_Core.WideStrings.Concat255("Unexpected sequence after Append at index ", TO_WSTRING(i))
	).ToBe(expected := expected[i]);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{7a905d59-eebc-49f0-8e4b-22cef8ceb228}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{bec8e0ac-0d18-4a45-a4dd-b8853f81a20b}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{20d84057-020b-4145-b395-deb31960b96f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ac2fe574-3e29-4e45-8308-9075da828f55}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{060db0da-0be5-420f-9b80-b4a866ab54cd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{33102976-aa25-46f0-8ef2-3ad22528a109}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4a203217-a2cf-4506-8378-0118704bab21}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
