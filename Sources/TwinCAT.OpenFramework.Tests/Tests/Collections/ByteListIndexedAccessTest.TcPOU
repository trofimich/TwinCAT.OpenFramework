(*!
<summary>Checks appended bytes, replacement and rejected Set indices.</summary>
<description>
Runs against the selected fixture. The base case clears it before publishing the result.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ByteListIndexedAccessTest EXTENDS ByteListTestCase
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{628e5d30-788c-4f50-9e2a-86b8c27ce4a2}">
      <Declaration><![CDATA[(*!
<summary>Checks appended bytes, replacement and rejected Set indices.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF BYTE := [0, 1, 2, 3, 4, 5];
	i : DINT;
	invalidIndex : DINT;

	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	standardException : TOF_Core.IStandardException;
	message : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO 5 DO
	_List.AppendByte(value := values[i]);
END_FOR

_List.AppendAny(data := values);

FOR i := 0 TO 11 DO
	Assert.ThatBool(
		actual := _List.Get(index := i) = values[i MOD 6],
		message := "AppendByte and AppendAny must preserve the input bytes"
	).IsTrue();
END_FOR

_List.Set(index := 5, value := BYTE#50);

Assert.ThatBool(
	actual := _List.Get(index := 5) = BYTE#50,
	message := "Set must replace the requested byte"
).IsTrue();

// Pass the invalid value at runtime so Set can exercise its negative-index guard.
invalidIndex := -1;

__TRY
	_List.Set(index := invalidIndex, value := BYTE#10);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, standardException),
	message := "Set at index -1 must raise StandardException"
).IsTrue();

IF caught <> 0 THEN
	message := caught.GetMessage();
	Assert.ThatBool(
		actual := message = "Index is less then zero",
		message := "Set at index -1 must identify the violated bound"
	).IsTrue();
END_IF

Assert.ThatDInt(
	actual := _List.Length,
	message := "Set at index -1 must preserve length"
).ToBe(expected := DINT#12);

Assert.ThatBool(
	actual := _List.Get(index := 5) = BYTE#50,
	message := "Set at index -1 must preserve the replaced byte"
).IsTrue();

caught := 0;

__TRY
	_List.Set(index := 12, value := BYTE#10);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, standardException),
	message := "Set at index 12 must raise StandardException"
).IsTrue();

IF caught <> 0 THEN
	message := caught.GetMessage();
	Assert.ThatBool(
		actual := message = "Index is too large",
		message := "Set at index 12 must identify the violated bound"
	).IsTrue();
END_IF

Assert.ThatDInt(
	actual := _List.Length,
	message := "Set at index 12 must preserve length"
).ToBe(expected := DINT#12);

Assert.ThatBool(
	actual := _List.Get(index := 5) = BYTE#50,
	message := "Set at index 12 must preserve the replaced byte"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{ee8497a2-8f4f-4bb6-9a6c-4a58b9ae7d35}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c4a601f0-ed6b-4363-b6da-a84da55772ad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f5144830-5f85-40c2-b256-21d365ee3659}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0c96e786-4762-49ad-ae42-061403c8c989}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{61b4504a-0b7b-42e1-8d20-c4ad69764d2e}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{cd66f0dc-02ea-4f84-bd63-4865837b9ea6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
