<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListIndexedAccessTest" Id="{71dbdc59-1497-457f-824d-39d2921a7e16}" SpecialFunc="None">
    <Declaration><![CDATA[(*
