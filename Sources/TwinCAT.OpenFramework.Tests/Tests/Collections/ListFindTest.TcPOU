<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="ListFindTest" Id="{21976fa8-b530-46e1-bf48-990a34f9b32d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks predicate matching, skip, reverse traversal and absence.

Borrows a group-owned list reserved for this case. Use from one task at a stable address.
Teardown clears the list before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ListFindTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.IList;
	_Predicate : ListStringPredicate;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="OnAfterTest" Id="{4208eb5d-a57a-4362-b11a-842efc9eb921}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{547bfcb1-5219-4707-8bc5-96d1115e9543}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ff431ede-7d12-44bd-8b3b-8c64a7c9acbf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{6eaf83e3-fb36-4b41-bdc6-cb0924cb85d6}">
      <Declaration><![CDATA[(* Checks predicate matching, skip, reverse traversal and absence. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
	found : BOOL;
	index : TOF_Core.DINT_INDEX;
	entry : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[4]);
_List.AppendCopy(value := values[5]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);

_Predicate.Expected := 'String2';

found := _List.FindSingle(predicate := _Predicate, skip := 0, index => index, value => entry);

Assert.ThatBool(
	actual := found AND_THEN index = 2 AND_THEN entry.AsString255() = 'String2',
	message := "Find must return the first match and its value"
).IsTrue();

found := _List.FindSingle(predicate := _Predicate, skip := 1, index => index);

Assert.ThatBool(
	actual := found AND_THEN index = 6,
	message := "Skipping one match must return the second match"
).IsTrue();

found := _List.FindSingle(
	predicate := _Predicate,
	searchDirection := TOF_Core.SEARCH_DIRECTION.FROM_END,
	index => index
);

Assert.ThatBool(
	actual := found AND_THEN index = 6,
	message := "Reverse traversal must find the last occurrence first"
).IsTrue();

found := _List.FindSingle(predicate := _Predicate, skip := 2);

Assert.ThatBool(
	actual := found,
	message := "Skipping both matches must report absence"
).IsFalse();

Assert.ThatDInt(
	actual := _List.Length,
	message := "Find must preserve the list length"
).ToBe(expected := DINT#8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{9ed88c82-df5e-4979-b07e-ea28c8f693dc}">
      <Declaration><![CDATA[(*
Binds the list fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
list — Required live list reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	list : TOF_Collections.IList;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List := list;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{bb388751-6825-4574-9d76-95e96d1cc452}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5c759424-53ed-4b30-8416-6e85b4ac3dde}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{c1e63185-e73e-459c-8b07-53c69fd7d671}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d6c6f016-2517-47e5-9ced-b7e696671f4b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>