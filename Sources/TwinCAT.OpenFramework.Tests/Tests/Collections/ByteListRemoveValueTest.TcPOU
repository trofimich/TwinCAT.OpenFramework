(*!
<summary>Checks first-match removal and preservation on a missing value.</summary>
<description>
Runs against the selected fixture. The base case clears it before publishing the result.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK ByteListRemoveValueTest EXTENDS ByteListTestCase
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{2c829e1d-7b2b-430a-9944-5586cd1994fd}">
      <Declaration><![CDATA[(*!
<summary>Checks first-match removal and preservation on a missing value.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	expected : ARRAY [0..4] OF BYTE := [1, 3, 2, 4, 5];
	values : ARRAY [0..5] OF BYTE := [1, 2, 3, 2, 4, 5];
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendAny(data := values);
_List.Remove(value := BYTE#2);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Remove must remove one matching byte"
).ToBe(expected := DINT#5);

_List.Remove(value := BYTE#255);

Assert.ThatDInt(
	actual := _List.Length,
	message := "Removing a missing byte must preserve length"
).ToBe(expected := DINT#5);

FOR i := 0 TO 4 DO
	Assert.ThatBool(
		actual := _List.Get(index := i) = expected[i],
		message := "Removal must preserve survivors in order"
	).IsTrue();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{35727877-993a-4db7-b2a8-030e086f15b4}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{08e94191-8fb3-4e5a-bba6-53a74dd8c730}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{76bd50fb-3557-42bd-bc4d-a524cac3ea15}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{18b8cd37-d377-483d-ac98-784740c1c669}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7c22f14c-77e7-41d9-ac86-f6ec792091e7}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{83aaf95e-5ce8-431b-8be6-96e8c680c4db}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
