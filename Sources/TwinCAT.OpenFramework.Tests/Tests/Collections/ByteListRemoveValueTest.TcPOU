<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteListRemoveValueTest" Id="{920fe667-d6c1-4786-98d8-197a0e7b66b9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
