<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicByteListTestGroup" Id="{e04ef593-b7dd-4488-9412-785966fa705a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Groups byte-list operations with dynamically allocated storage.

Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicByteListTestGroup EXTENDS TOF_Testing.TestGroup<6>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_LoadFromAny : ByteListLoadFromAnyTest(name := "LoadFromAny", parent := THIS^, useDynamicStorage := TRUE);
	_GetAndSet : ByteListIndexedAccessTest(name := "GetAndSet", parent := THIS^, useDynamicStorage := TRUE);
	_Find : ByteListFindTest(name := "Find", parent := THIS^, useDynamicStorage := TRUE);
	_Remove : ByteListRemoveValueTest(name := "Remove", parent := THIS^, useDynamicStorage := TRUE);
	_RemoveAt : ByteListRemoveRangeTest(name := "RemoveAt", parent := THIS^, useDynamicStorage := TRUE);
	_Clear : ByteListClearTest(name := "Clear", parent := THIS^, useDynamicStorage := TRUE);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_LoadFromAny,
		_GetAndSet,
		_Find,
		_Remove,
		_RemoveAt,
		_Clear
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{df27839e-4f32-4539-8f00-f5c5461f5a15}">
      <Declaration><![CDATA[// Borrows the fixed child array. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{d2ec162c-c2c5-4191-8167-107fe406f129}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{3c181f2d-038f-4b79-9680-ada7b1a37c18}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{debc8bae-ff16-4f4d-8657-42c27c3d1eca}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c1411af5-c5a2-4549-a59a-f929ecbe09cd}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e28d5fb1-366c-416d-ab46-9be333361efd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{a54ab3b9-22c9-45d8-ba3b-ebf5ab131295}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{6448cdf5-0c1e-49e6-ad67-246f9aa7809c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
