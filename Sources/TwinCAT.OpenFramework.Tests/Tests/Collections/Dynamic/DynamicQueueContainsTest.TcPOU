<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicQueueContainsTest" Id="{94bb8e6f-b8f9-4f1a-9f04-fb780f2c6c2f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks ANY lookup after growth and head removal.

Owns a dynamic queue and copied payloads at a stable address. Run from one task.
Teardown clears surviving entries and releases dynamic capacity.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicQueueContainsTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{6abcb50c-c270-4be6-9fdc-38cecb20f192}">
      <Declaration><![CDATA[(* Checks ANY lookup after growth and head removal. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.DefaultDynamicAllocationElementCount := BYTE#2;

_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

Assert.ThatBool(
	actual := _Queue.Contains(value := values[1]),
	message := "Lookup must find the original head after growth"
).IsTrue();

Assert.ThatBool(
	actual := _Queue.Contains(value := values[3]),
	message := "Lookup must find the entry appended during growth"
).IsTrue();

Assert.ThatBool(
	actual := _Queue.Contains(value := values[4]),
	message := "Lookup must reject an absent value"
).IsFalse();

_Queue.RemoveFirst();

Assert.ThatBool(
	actual := _Queue.Contains(value := values[1]),
	message := "Lookup must ignore the removed head"
).IsFalse();

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Lookup must preserve the two live entries"
).ToBe(expected := DINT#2);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Lookup must preserve the current head"
).ToBe(expected := values[2]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{fd80e976-1bbf-4965-898d-ce8f0f102452}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{12b793f0-1e39-480d-a6cb-2792b4ed722c}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{916ea62f-9958-496a-bc2f-45e5e60f2863}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{41172de2-f9c3-4d48-bb70-c69023c8c886}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{da090ed5-45ef-445b-bf1d-a68ca2ca3560}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b0b2ced1-f1c5-41a5-8eed-22deb2e8f905}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{ce118f90-d79c-48ea-9623-108ac7594369}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
