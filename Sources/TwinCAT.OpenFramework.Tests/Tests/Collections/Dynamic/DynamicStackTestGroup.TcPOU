<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicStackTestGroup" Id="{7fc229f1-2ad8-47ca-b0a4-981328873275}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups dynamic stack storage, LIFO order, cursors and ownership cases.</summary>
<description>
Owns the cases, their fixed registration array and any fixtures borrowed by the cases.
Each borrowed fixture is reserved for its case throughout the group lifetime. Use from one task at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicStackTestGroup EXTENDS TOF_Testing.TestGroup<11>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Validator : TOF_Core.GenericValueTypeValidator(typeClass := TOF_Core.GENERIC_TYPE_CLASS.INT_16);
	_OwnedObjectCleanupStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_ValidatorRejectionStack : TOF_Collections.Stack<0>(valueValidator := _Validator);
	_IndexedAccessAndEnumerationStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_EmptyAndIndexBoundsStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_CopiedAndBorrowedValuesStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_ContainsStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_ContainsGenericStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_PushAndPeekStack : TOF_Collections.Stack<0>(valueValidator := 0);
	_RemoveLastStack : TOF_Collections.Stack<0>(valueValidator := 0);

	_OwnedObjectCleanup : StackOwnedObjectCleanupTest(
		name := "OwnedObjectCleanup",
		parent := THIS^,
		stack := _OwnedObjectCleanupStack
	);
	_ValidatorRejection : StackValidatorRejectionTest(
		name := "ValidatorRejection",
		parent := THIS^,
		stack := _ValidatorRejectionStack
	);
	_GrowthAndInvalidIncrement : DynamicStackGrowthAndInvalidIncrementTest(
		name := "GrowthAndInvalidIncrement",
		parent := THIS^
	);
	_IndexedAccessAndEnumeration : StackIndexedAccessAndEnumerationTest(
		name := "IndexedAccessAndEnumeration",
		parent := THIS^,
		stack := _IndexedAccessAndEnumerationStack
	);
	_EmptyAndIndexBounds : StackEmptyAndIndexBoundsTest(
		name := "EmptyAndIndexBounds",
		parent := THIS^,
		stack := _EmptyAndIndexBoundsStack
	);
	_CopiedAndBorrowedValues : StackCopiedAndBorrowedValuesTest(
		name := "CopiedAndBorrowedValues",
		parent := THIS^,
		stack := _CopiedAndBorrowedValuesStack
	);
	_Contains : StackContainsTest(name := "Contains", parent := THIS^, stack := _ContainsStack);
	_ContainsGeneric : StackContainsGenericTest(
		name := "ContainsGeneric",
		parent := THIS^,
		stack := _ContainsGenericStack
	);
	_PushAndPeek : StackPushAndPeekTest(name := "PushAndPeek", parent := THIS^, stack := _PushAndPeekStack);
	_Clear : DynamicStackClearTest(name := "Clear", parent := THIS^);
	_RemoveLast : StackRemoveLastTest(name := "RemoveLast", parent := THIS^, stack := _RemoveLastStack);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_OwnedObjectCleanup,
		_ValidatorRejection,
		_GrowthAndInvalidIncrement,
		_IndexedAccessAndEnumeration,
		_EmptyAndIndexBounds,
		_CopiedAndBorrowedValues,
		_Contains,
		_ContainsGeneric,
		_PushAndPeek,
		_Clear,
		_RemoveLast
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{d7df0d1b-b47f-47f4-a8f5-f295b2542ae5}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{6d022260-ba2d-41a9-ac0c-b6a79706a7cb}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{393bc39b-ce24-4249-9036-2c85a5c19562}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{69fce06a-b928-4438-8506-8be4503ae268}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{de81e4b8-ee89-403f-8ce7-1891bfdefa79}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4fcc592c-6996-4080-bd6d-b6219f9bf69f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{c202d289-b112-43fd-b017-7ac596261c6d}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{97c0d1e3-86c5-43cb-a82f-8fda90ae0ed6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
