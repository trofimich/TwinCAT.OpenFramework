<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicQueueRemoveFirstTest" Id="{d55c2538-811e-4016-b51b-d3d1ab54b5f6}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks FIFO compaction through empty, capacity retention and reuse.</summary>
<description>
Owns a dynamic queue and copied payloads at a stable address. Run from one task.
Teardown clears surviving entries and releases dynamic capacity.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicQueueRemoveFirstTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{cf51965e-0fb1-4a30-91a9-27619e3b429f}">
      <Declaration><![CDATA[(*!
<summary>Checks FIFO compaction through empty, capacity retention and reuse.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.DefaultDynamicAllocationElementCount := BYTE#2;

_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

_Queue.RemoveFirst();

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "The second entry must become the head after the first removal"
).ToBe(expected := values[2]);

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Removing the head must leave two entries"
).ToBe(expected := DINT#2);

_Queue.RemoveFirst();

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "The third entry must become the head after the second removal"
).ToBe(expected := values[3]);

_Queue.RemoveFirst();

Assert.ThatBool(
	actual := _Queue.Empty AND_THEN _Queue.Length = 0 AND_THEN _Queue.Capacity = 4,
	message := "Removing the final entry must leave empty storage available for reuse"
).IsTrue();

_Queue.EnqueueCopy(value := values[4]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Reuse after draining must expose the new head"
).ToBe(expected := values[4]);

Assert.ThatDInt(
	actual := _Queue.Capacity,
	message := "Reuse must keep the original capacity until Clear"
).ToBe(expected := DINT#4);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{763580b5-7e41-4666-a116-b149ff391524}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{a11d8d0a-406a-4599-8306-bae740a219d7}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5b684049-a9ef-41c7-b597-67f3d01ac238}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2f017dfb-583d-4cfa-9dc4-107619056fce}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{808a26dd-147f-4666-87e5-244be7a52ce0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{cfa41179-d466-4a23-8653-a7ae0f5de42a}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{21551b35-a578-4509-941e-8b4af0cf7f6d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
