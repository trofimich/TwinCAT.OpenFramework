<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicStackGrowthAndInvalidIncrementTest" Id="{2ab46d4e-94dc-4003-b98c-4e29b05ce716}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks growth, rejection of a zero increment and recovery.

Owns a stack and its copied values at a stable address. Use from one task.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicStackGrowthAndInvalidIncrementTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.Stack<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{52f71a3b-ee48-499c-8a0d-30438d4f91a1}">
      <Declaration><![CDATA[(* Checks growth, rejection of a zero increment and recovery. *)
METHOD PROTECTED ExecuteTest
VAR
	i : DINT;
	value : INT := 99;

	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	rangeException : TOF_Core.IArgumentOutOfRangeException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.DefaultDynamicAllocationElementCount := BYTE#2;

Assert.ThatBool(
	actual := _Stack.Dynamic,
	message := "Zero static capacity must select dynamic storage"
).IsTrue();

FOR i := 1 TO 6 DO
	_Stack.PushCopy(value := i);
END_FOR

Assert.ThatBool(
	actual := _Stack.Length = 6 AND_THEN _Stack.Capacity = 6 AND_THEN NOT _Stack.Full,
	message := "Growth must retain six entries and honor the configured increment"
).IsTrue();

FOR i := 0 TO 5 DO
	Assert.ThatDInt(
		actual := _Stack.GetByIndex(index := i).AsDInt(),
		message := "Growth must preserve LIFO order"
	).ToBe(expected := 6 - i);
END_FOR

_Stack.DefaultDynamicAllocationElementCount := BYTE#0;

__TRY
	_Stack.PushCopy(value := value);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, rangeException),
	message := "Zero growth must raise ArgumentOutOfRangeException"
).IsTrue();

Assert.ThatBool(
	actual := _Stack.Length = 6 AND_THEN _Stack.Capacity = 6,
	message := "Rejected growth must preserve length and capacity"
).IsTrue();

FOR i := 0 TO 5 DO
	Assert.ThatDInt(
		actual := _Stack.GetByIndex(index := i).AsDInt(),
		message := "Rejected growth must preserve every entry"
	).ToBe(expected := 6 - i);
END_FOR

_Stack.DefaultDynamicAllocationElementCount := BYTE#2;
_Stack.PushCopy(value := value);

Assert.ThatDInt(
	actual := _Stack.Capacity,
	message := "A valid increment must allow growth after rejection"
).ToBe(expected := DINT#8);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "Push after rejection must establish the new top"
).ToBe(expected := value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{ff190287-97c4-4bf7-91f6-8a6e7bb3df17}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{c932242a-2cd7-408e-b534-05703575b5cc}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c67356d3-c7a9-4168-b16a-22e84caf0d8e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5949615a-6374-47e9-bfb4-03c9198f06ff}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7c6e50dd-81bd-4d12-ada3-254f9f8ebae8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{967e8faf-8b41-45e3-a338-51b55a04a9f6}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{3459d767-f152-4b5f-bee2-6d0da8544411}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
