(*!
<summary>Exercises the DynamicUniqueDataSetTest collection scenarios.</summary>
<description>
Owns the suite's test collection and runs the existing TcUnit cases.
The collection is initialized explicitly with default value equality and hashing.
Temporary owned query descriptors request explicit release; changing query defaults does not
transfer those allocations to the test suite.
Lookup assertions use equality and current returned positions without assuming sorted order.
</description>
*)

FUNCTION_BLOCK DynamicUniqueDataSetTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	_Values : ARRAY [0..6] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	
	_UniqueSetToTest : TOF_Collections.UniqueDataSet<0>(valueValidator := 0, valueEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SetAndGet();
Remove();
Contains();
Clear();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{7b536d33-e6ce-4551-9c56-53c5bfb0182d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a12a7372-56e7-4c5b-8be9-f2046c051615}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{a1170765-6536-4258-8248-d445d44dd738}">
      <Declaration><![CDATA[METHOD Clear 
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_UniqueSetToTest.Clear();

AssertEquals_DINT(Expected := 0, Actual := _UniqueSetToTest.Capacity, Message := 'Invalid capacity after Clear');
AssertEquals_DINT(Expected := 0, Actual := _UniqueSetToTest.Length, Message := 'Invalid length after Clear');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{c1e32079-7068-4c5d-9984-43b7695c92e8}">
      <Declaration><![CDATA[(*!
<summary>Exercises lookup for present and absent values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
</description>
*)
METHOD Contains
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_UniqueSetToTest
	.SetCopy(_Values[6])
	.SetCopy(_Values[5])
	.SetCopy(_Values[4])
	.SetCopy(_Values[3])
	.SetCopy(_Values[2])
	.SetCopy(_Values[1])
	.SetCopy(_Values[0])
	.SetCopy(_Values[3])
	.SetGeneric(TOF_Core.GenericValueFactory.FromStringValue('String3'))
	.SetGeneric(TOF_Core.GenericValueFactory.FromStringValue('String5'));

AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSetToTest.Contains(_Values[3]), Message := 'Contains did not find the value');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSetToTest.ContainsGeneric(TOF_Core.GenericValueFactory.FromStringValue('String3'), releaseValue := TRUE), Message := 'ContainsGeneric did not find the value');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSetToTest.ContainsGeneric(TOF_Core.GenericValueFactory.FromStringValue('String9'), releaseValue := TRUE), Message := 'Contains found not existing value');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{a24b701e-9a18-4aa6-bb23-055eda938cc4}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6cbef6dd-ac14-4e4b-877f-0239dab9b73b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Remove" Id="{7b58aa08-bdf2-4cb9-baee-21f808829be7}">
      <Declaration><![CDATA[(*!
<summary>Exercises removal and the resulting collection state.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
Removes the intended element using its current position and checks removed/retained membership
rather than sorted ranks.
</description>
*)
METHOD Remove
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_UniqueSetToTest.SetCopy(_Values[6]);
_UniqueSetToTest.SetCopy(_Values[5]);
_UniqueSetToTest.SetCopy(_Values[4]);
_UniqueSetToTest.SetCopy(_Values[3]);
_UniqueSetToTest.SetCopy(_Values[2]);
_UniqueSetToTest.SetCopy(_Values[1]);
_UniqueSetToTest.SetCopy(_Values[0]);
_UniqueSetToTest.SetCopy(_Values[3]);
_UniqueSetToTest.SetGeneric(TOF_Core.GenericValueFactory.FromStringValue('String3'));
_UniqueSetToTest.SetGeneric(TOF_Core.GenericValueFactory.FromStringValue('String5'));

_UniqueSetToTest.RemoveAt(_UniqueSetToTest.GetValuePosition(_Values[3]));

AssertEquals_DINT(Expected := 6, Actual := _UniqueSetToTest.Length, Message := 'Invalid length after RemoveAt');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSetToTest.Contains(_Values[3]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSetToTest.Contains(_Values[4]), Message := 'Removal lost a retained element');

_UniqueSetToTest.TryRemove(_Values[2]);

AssertEquals_DINT(Expected := 5, Actual := _UniqueSetToTest.Length, Message := 'Invalid length after TryRemoveByKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSetToTest.Contains(_Values[2]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSetToTest.Contains(_Values[4]), Message := 'Removal lost a retained element');

_UniqueSetToTest.TryRemoveGeneric(TOF_Core.GenericValueFactory.FromStringValue('String1'), releaseValue := TRUE);

AssertEquals_DINT(Expected := 4, Actual := _UniqueSetToTest.Length, Message := 'Invalid length after TryRemoveByGenericKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _UniqueSetToTest.Contains(_Values[1]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSetToTest.Contains(_Values[4]), Message := 'Removal lost a retained element');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAndGet" Id="{9f649d8a-3840-4874-888b-39568bf44253}">
      <Declaration><![CDATA[(*!
<summary>Exercises storing entries and retrieving their positions or values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
Raw and generic queries must return the same current position; indexed reads use a queried position
without assuming sorted order.
</description>
*)
METHOD SetAndGet
VAR
	genericValue : TOF_Core.GENERIC_VALUE;
	keyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_UniqueSetToTest.SetCopy(_Values[6]);
_UniqueSetToTest.SetCopy(_Values[5]);
_UniqueSetToTest.SetCopy(_Values[4]);
_UniqueSetToTest.SetCopy(_Values[3]);
_UniqueSetToTest.SetCopy(_Values[2]);
_UniqueSetToTest.SetCopy(_Values[1]);
_UniqueSetToTest.SetCopy(_Values[0]);
_UniqueSetToTest.SetCopy(_Values[3]);
_UniqueSetToTest.SetGeneric(TOF_Core.GenericValueFactory.FromStringValue('String3'));
_UniqueSetToTest.SetGeneric(TOF_Core.GenericValueFactory.FromStringValue('String5'));

AssertEquals_DINT(Expected := 7, Actual := _UniqueSetToTest.Length, Message := 'Invalid length after Set');

AssertEquals_BOOL(Expected := TRUE, Actual := _UniqueSetToTest.GetValuePosition(_Values[2]) >= TOF_Core.SignedInt32.ZERO, Message := 'Lookup did not return a valid position');

AssertEquals_DINT(Expected := _UniqueSetToTest.GetValuePosition(_Values[2]), Actual := _UniqueSetToTest.GetGenericValuePosition(TOF_Core.GenericValueFactory.FromStringValue('String2'), releaseValue := TRUE), Message := 'Raw and generic queries returned different positions');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>