<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="DynamicUniqueDataSetTest" Id="{48ddaaaf-04ba-4555-bbf6-ad4d3fedae0f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
