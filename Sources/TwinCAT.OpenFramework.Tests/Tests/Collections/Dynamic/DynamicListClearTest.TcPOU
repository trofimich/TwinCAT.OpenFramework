<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicListClearTest" Id="{4bfc7e56-b24a-4a5e-87fb-d1885d23bb9b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks release of populated storage and fresh allocation on reuse.

Owns a list and its copied entries. Use from one task at a stable address.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicListClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_List : TOF_Collections.List<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{9294a094-db16-493f-8629-acebfd4257b6}">
      <Declaration><![CDATA[(* Checks release of populated storage and fresh allocation on reuse. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..5] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5'];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.AppendCopy(value := values[0]);
_List.AppendCopy(value := values[1]);
_List.AppendCopy(value := values[2]);
_List.AppendCopy(value := values[3]);
_List.AppendCopy(value := values[4]);
_List.AppendCopy(value := values[5]);

Assert.ThatBool(
	actual := _List.Length = 6 AND_THEN _List.Capacity >= 6,
	message := "Clear fixture must contain six live entries"
).IsTrue();

_List.Clear();

Assert.ThatBool(
	actual := _List.Empty AND_THEN _List.Length = 0 AND_THEN _List.Capacity = 0,
	message := "Clear must empty the dynamic list and release its capacity"
).IsTrue();

_List.AppendCopy(value := values[5]);

Assert.ThatBool(
	actual := _List.Length = 1 AND_THEN _List.Get(index := 0).AsString255() = 'String5',
	message := "The cleared list must accept a fresh value"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{449239a7-b620-4796-8be3-f33d80e26b3e}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_List.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6b4de815-251f-404f-a085-0b24fa36e2ef}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{80fb716f-f022-4375-a4c7-4f12b19ff911}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{16bab229-1cec-4012-b352-b05624dd032d}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f726c8d1-1e84-4453-b710-1dee4708deea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{12cbab9f-8e2e-482d-989b-99cb3bb0ca75}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e0a92779-d1f1-4385-a7e1-008ec68132c4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
