<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicQueueContainsGenericTest" Id="{2008bc46-f3be-4150-956f-7cc231fe5a53}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks generic lookup in grown and compacted dynamic storage.</summary>
<description>
Owns a dynamic queue and copied payloads at a stable address. Run from one task.
Teardown clears surviving entries and releases dynamic capacity.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicQueueContainsGenericTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{af1d4cc8-8afc-4610-919b-45e88540f253}">
      <Declaration><![CDATA[(*!
<summary>Checks generic lookup in grown and compacted dynamic storage.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
	query : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.DefaultDynamicAllocationElementCount := BYTE#2;

_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[1]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must find the original head"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[3]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must find the new tail"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[4]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must reject an absent value"
).IsFalse();

_Queue.RemoveFirst();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[1]);
Assert.ThatBool(
	actual := _Queue.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must ignore the removed head"
).IsFalse();

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Generic lookup must preserve the two live entries"
).ToBe(expected := DINT#2);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{c7f4fe49-da24-4c4a-ad2e-4488b7317185}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{cd44e70c-1cc9-4ebf-9740-40fcff48704c}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9604d5ee-efa8-401c-a668-063c679b28a3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{ec648b60-16e0-49ea-a726-cb00e12ee2e1}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c0f1890e-c5dd-44f3-bac8-800313daafab}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{13cdeaa6-2b8a-4365-8132-446c54d962ad}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{2d3528f9-71a0-4bb7-8346-d5bca5758973}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
