<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicQueueEnqueueAndPeekTest" Id="{a0217c3b-0bdc-413f-ae83-eb1b3ef51786}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks FIFO order, copy independence and state through successful and rejected growth.

Owns a dynamic queue and copied payloads at a stable address. Run from one task.
Teardown clears surviving entries and releases dynamic capacity.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicQueueEnqueueAndPeekTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{14841a3b-fe19-4f72-b4f9-ffc04d0ee69f}">
      <Declaration><![CDATA[(* Checks FIFO head, copy independence, and recovery after a rejected growth increment. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..5] OF INT := [11, 22, 33, 44, 55];
	expected : ARRAY [0..3] OF INT := [11, 22, 33, 44];
	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
	rangeException : TOF_Core.IArgumentOutOfRangeException;
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.DefaultDynamicAllocationElementCount := BYTE#2;

_Queue.EnqueueCopy(value := values[1]);
values[1] := 111;

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Changing the source must preserve the copied head"
).ToBe(expected := INT#11);

Assert.ThatDInt(
	actual := _Queue.Capacity,
	message := "First enqueue must allocate two slots"
).ToBe(expected := DINT#2);

_Queue.EnqueueCopy(value := values[2]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Second enqueue must preserve the head"
).ToBe(expected := INT#11);

Assert.ThatBool(
	actual := _Queue.Full,
	message := "A dynamic queue must report not full when length equals capacity"
).IsFalse();

_Queue.EnqueueCopy(value := values[3]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "Growing the descriptor buffer must preserve the head"
).ToBe(expected := INT#11);

Assert.ThatDInt(
	actual := _Queue.Length,
	message := "Three enqueues must produce three entries"
).ToBe(expected := DINT#3);

Assert.ThatDInt(
	actual := _Queue.Capacity,
	message := "Third enqueue must grow to four slots"
).ToBe(expected := DINT#4);

Assert.ThatInt(
	actual := _Queue.GetByIndex(index := 2).AsInt(),
	message := "Third enqueue must append the tail"
).ToBe(expected := values[3]);

_Queue.DefaultDynamicAllocationElementCount := BYTE#0;
_Queue.EnqueueCopy(value := values[4]);

__TRY
	_Queue.EnqueueCopy(value := values[5]);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
__ENDTRY

Assert.ThatBool(
	actual := __QUERYINTERFACE(caught, rangeException),
	message := "Zero growth increment must raise ArgumentOutOfRangeException only when growth is required"
).IsTrue();
Assert.ThatBool(
	actual := _Queue.Capacity = 4 AND_THEN _Queue.Length = 4,
	message := "Rejected growth must preserve length and capacity"
).IsTrue();

FOR i := 0 TO UPPER_BOUND(expected, 1) DO
	Assert.ThatInt(
		actual := _Queue.GetByIndex(index := i).AsInt(),
		message := "Rejected growth must preserve every FIFO entry"
	).ToBe(expected := expected[i]);
END_FOR

_Queue.DefaultDynamicAllocationElementCount := BYTE#2;
_Queue.EnqueueCopy(value := values[5]);
Assert.ThatBool(
	actual := _Queue.Capacity = 6 AND_THEN _Queue.Length = 5,
	message := "Restoring a valid increment must allow growth"
).IsTrue();
Assert.ThatInt(
	actual := _Queue.GetByIndex(index := 4).AsInt(),
	message := "Growth after rejection must append the new tail"
).ToBe(expected := values[5]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{b0e9403f-3ead-4bde-bf0d-4a7c24fad920}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{868ede50-aafa-4496-9b30-8d04a9d0713d}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{30492c36-7025-42dd-b0fc-0ed8e20426bc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{09adc502-8e5c-466e-a379-79f5cfe77ff5}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5e09480d-b4a4-4652-90f7-c403dd41b053}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1a8a9ce2-9303-4de7-80d7-88661c1c24eb}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{fca45f5c-c78f-4919-8b23-1d289f303330}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
