<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicQueueTestGroup" Id="{cbee65a1-aabf-46f0-9064-633534b5a670}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Groups dynamic queue lookup, FIFO, growth and clear cases.</summary>
<description>
Owns the independent child instances and their fixed registration array. Use from one PLC task at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicQueueTestGroup EXTENDS TOF_Testing.TestGroup<5>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Contains : DynamicQueueContainsTest(name := "Contains", parent := THIS^);
	_ContainsGeneric : DynamicQueueContainsGenericTest(name := "ContainsGeneric", parent := THIS^);
	_EnqueueAndPeek : DynamicQueueEnqueueAndPeekTest(name := "EnqueueAndPeek", parent := THIS^);
	_Clear : DynamicQueueClearTest(name := "Clear", parent := THIS^);
	_RemoveFirst : DynamicQueueRemoveFirstTest(name := "RemoveFirst", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_Contains,
		_ContainsGeneric,
		_EnqueueAndPeek,
		_Clear,
		_RemoveFirst
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{afcfda88-6f31-4222-982b-461f2b01ecb2}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{10b7e426-32ba-4746-9605-01f90869ac80}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{101c6f15-63e1-4dfd-a303-c5218a22f3d4}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cdcfabab-f074-4534-91ea-7273c6479985}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{e6fe4fff-c327-4344-8517-e4a1b2902d96}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cbbe4343-11d3-4167-9679-0ac094330f6a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d49dad95-ec13-49e0-b032-5b2de8244ec1}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{1e9fed7d-72ad-4faa-acdf-9dff46279b6c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
