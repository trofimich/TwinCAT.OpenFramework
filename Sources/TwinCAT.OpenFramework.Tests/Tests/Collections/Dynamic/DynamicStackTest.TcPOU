<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="DynamicStackTest" Id="{b21287d9-f4c2-443d-91d4-8258591a4c82}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Exercises dynamic stack storage, LIFO order, borrowed views and ownership.</summary>
<description>
Runs each scenario once through TcUnit. Persistent fixtures retain cursors, probes and borrowed storage after
an aborted call. Explicit cleanup and FB_exit release them; dynamic allocation failures are terminal.
</description>
*)

FUNCTION_BLOCK DynamicStackTest EXTENDS TcUnit.FB_TestSuite
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.Stack<0>(valueValidator := 0);

	_ValueValidator : TOF_Core.GenericValueTypeValidator(typeClass := TOF_Core.GENERIC_TYPE_CLASS.INT_16);
	_ValidatedStack : TOF_Collections.Stack<0>(valueValidator := _ValueValidator);

	//! <summary>Owns cursors and unaccepted probes across aborted test calls.</summary>
	_Enumerator : TOF_Core.IEnumerator;
	_SecondEnumerator : TOF_Core.IEnumerator;
	_OwnedEnumerator : TOF_Core.IObject;
	_Probe : POINTER TO ObjectExitProbe;

	//! <summary>Remains alive for every retained probe until suite cleanup.</summary>
	_ExitCount : UDINT;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[cleanupFixtures();

OwnedObjectCleanup();
ValidatorRejection();
GrowthAndInvalidIncrement();
IndexedAccessAndEnumeration();
EmptyAndIndexBounds();
CopiedAndBorrowedValues();
Contains();
ContainsGeneric();
PushAndPeek();
Clear();
RemoveLast();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{68096495-2ff8-4889-9254-f5cae7df5e8f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d0eda73b-7914-4068-9e47-f454d00129bf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{1cec624e-4b5f-4f94-88d1-30de1861ae89}">
      <Declaration><![CDATA[//!<summary>Checks clearing and reuse while preserving the storage policy.</summary>
METHOD Clear
VAR
	value : INT := 7;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_Stack.Clear();
_Stack.PushCopy(value := value);
_Stack.Clear();
AssertEquals_DINT(Expected := 0, Actual := _Stack.Capacity, Message := 'Clear must restore storage capacity');
AssertTrue(Condition := _Stack.Empty, Message := 'Clear must empty stack');
_Stack.PushCopy(value := value);
AssertEquals_INT(Expected := value, Actual := _Stack.Peek().AsInt(), Message := 'Stack must be reusable after Clear');
_Stack.Clear();

AssertEquals_DINT(Expected := 0, Actual := _Stack.Length, Message := 'Invalid dynamic stack length after Clear');

_Stack.Clear();

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{9c5b67ae-bba3-4684-8f63-79f4e03a44af}">
      <Declaration><![CDATA[//!<summary>Checks membership for present and absent copied values.</summary>
METHOD Contains
VAR
	values : ARRAY [1..5] OF INT := [1, 2, 3, 4, 5];
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_Stack
	.Clear()
	.PushCopy(value := values[1])
	.PushCopy(value := values[2])
	.PushCopy(value := values[3]);

AssertEquals_BOOL(Expected := TRUE, Actual := _Stack.Contains(value := values[1]), Message := 'Value not found');
AssertEquals_BOOL(Expected := TRUE, Actual := _Stack.Contains(value := values[3]), Message := 'Value not found');
AssertEquals_BOOL(Expected := FALSE, Actual := _Stack.Contains(value := values[5]), Message := 'Value found');
 
_Stack.Clear();

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ContainsGeneric" Id="{0cc8799c-6dee-4ed4-b0d8-6ad082e9521b}">
      <Declaration><![CDATA[//!<summary>Checks generic membership with temporary owned queries.</summary>
METHOD ContainsGeneric
VAR
	values : ARRAY [1..5] OF INT := [1, 2, 3, 4, 5];
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_Stack
	.Clear()
	.PushCopy(value := values[1])
	.PushCopy(value := values[2])
	.PushCopy(value := values[3]);

	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := _Stack.ContainsGeneric(value := TOF_Core.GenericValueFactory.FromIntValue(value := values[1])),
		Message := 'Value not found'
	);
	AssertEquals_BOOL(
		Expected := TRUE,
		Actual := _Stack.ContainsGeneric(value := TOF_Core.GenericValueFactory.FromIntValue(value := values[3])),
		Message := 'Value not found'
	);
	AssertEquals_BOOL(
		Expected := FALSE,
		Actual := _Stack.ContainsGeneric(value := TOF_Core.GenericValueFactory.FromIntValue(value := values[5])),
		Message := 'Value found'
	);
 
_Stack.Clear();

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushAndPeek" Id="{982f36a6-ad5f-49e3-8bbc-a56b0d2b400b}">
      <Declaration><![CDATA[//!<summary>Checks that each push makes the newest value the top.</summary>
METHOD PushAndPeek
VAR
	values : ARRAY [1..4] OF INT := [1, 2, 3, 4];
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_Stack.Clear();

_Stack.PushCopy(value := values[1]);
AssertEquals_DINT(Expected := values[1], Actual := _Stack.Peek().AsInt(), Message := 'Wrong value peeked after dynamic stack Push');

_Stack.PushCopy(value := values[2]);
AssertEquals_DINT(Expected := values[2], Actual := _Stack.Peek().AsInt(), Message := 'Wrong value peeked after dynamic stack Push');

_Stack.PushCopy(value := values[3]);
AssertEquals_DINT(Expected := values[3], Actual := _Stack.Peek().AsInt(), Message := 'Wrong value peeked after dynamic stack Push');

AssertEquals_DINT(Expected := 3, Actual := _Stack.Length, Message := 'Wrong dynamic stack length');
 
_Stack.Clear();

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{5d7c2d57-5431-401e-b079-9bddf846d8d5}">
      <Declaration><![CDATA[//!<summary>Provides the test library namespace.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{a62302e4-2d13-4a96-bc0b-499e57fcf599}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RemoveLast" Id="{1821e55b-6aa9-42ab-910c-3c03c2198119}">
      <Declaration><![CDATA[//!<summary>Checks LIFO removal and reuse of a vacated slot.</summary>
METHOD RemoveLast
VAR
	values : ARRAY [1..3] OF INT := [1, 2, 3]; 
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(TestName := __POUNAME());

_Stack
	.Clear()
	.PushCopy(value := values[1])
	.PushCopy(value := values[2])
	.PushCopy(value := values[3]);

_Stack.RemoveLast();
AssertEquals_INT(Expected := values[2], Actual := _Stack.Peek().AsInt(), Message := 'Wrong value peeked after dynamic stack RemoveLast');

_Stack.RemoveLast();
AssertEquals_INT(Expected := values[1], Actual := _Stack.Peek().AsInt(), Message := 'Wrong value peeked after dynamic stack RemoveLast');

_Stack.RemoveLast();
AssertTrue(Condition := _Stack.Empty, Message := 'Stack must be empty after removing all entries');
_Stack.PushCopy(value := values[3]);
AssertEquals_INT(
		Expected := values[3],
		Actual := _Stack.Peek().AsInt(),
		Message := 'Push after draining must reuse storage'
	);
_Stack.Clear();

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="IndexedAccessAndEnumeration" Id="{724b31ba-6490-46e6-9680-f898b96c52e3}">
      <Declaration><![CDATA[(*!
<summary>Checks top-first indexing, independent cursors, reset and repeated exhaustion.</summary>
<description>Runs once. Persistent fixtures keep ownership and borrowed storage valid after an aborted call.</description>
*)
METHOD IndexedAccessAndEnumeration
VAR
	values : ARRAY [1..3] OF INT := [11, 22, 33];
	i : DINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Stack.Clear();
_Stack
	.PushCopy(value := values[1])
	.PushCopy(value := values[2])
	.PushCopy(value := values[3]);

FOR i := 0 TO 2 DO
	AssertEquals_INT(
		Expected := values[3 - i],
		Actual := _Stack.GetByIndex(index := i).AsInt(),
		Message := 'Index order must run from top to bottom'
	);
END_FOR

_Enumerator := _Stack.CreateEnumerator();
_SecondEnumerator := _Stack.CreateEnumerator();
AssertTrue(
		Condition := _Enumerator.Current.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.UNSPECIFIED,
		Message := 'Current before MoveNext must be empty'
	);

FOR i := 3 TO 1 BY -1 DO
	AssertTrue(Condition := _Enumerator.MoveNext(), Message := 'Enumerator must visit each entry');
	AssertEquals_INT(
		Expected := values[i],
		Actual := _Enumerator.Current.AsInt(),
		Message := 'Enumerator must follow LIFO order'
	);
END_FOR

AssertFalse(Condition := _Enumerator.MoveNext(), Message := 'Enumerator must stop at end');
AssertFalse(Condition := _Enumerator.MoveNext(), Message := 'Exhausted enumerator must stay exhausted');
AssertTrue(
		Condition := _Enumerator.Current.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.UNSPECIFIED,
		Message := 'Current after exhaustion must be empty'
	);
AssertTrue(Condition := _SecondEnumerator.MoveNext(), Message := 'Second cursor must be independent');
AssertEquals_INT(
		Expected := values[3],
		Actual := _SecondEnumerator.Current.AsInt(),
		Message := 'Second cursor must start at top'
	);
_Enumerator.Reset();
AssertTrue(
		Condition := _Enumerator.Current.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.UNSPECIFIED,
		Message := 'Current after Reset must be empty'
	);
AssertTrue(Condition := _Enumerator.MoveNext(), Message := 'Reset must restart traversal');
AssertEquals_INT(Expected := values[3], Actual := _Enumerator.Current.AsInt(), Message := 'Reset must restart at top');

_OwnedEnumerator := _Enumerator;
_Enumerator := 0;
AssertTrue(
		Condition := TOF_Core.Memory.TryReleaseDynamicObject(instance := _OwnedEnumerator),
		Message := 'Enumerator must be released'
	);
_OwnedEnumerator := _SecondEnumerator;
_SecondEnumerator := 0;
AssertTrue(
		Condition := TOF_Core.Memory.TryReleaseDynamicObject(instance := _OwnedEnumerator),
		Message := 'Second enumerator must be released'
	);

_Stack.Clear();
_Enumerator := _Stack.CreateEnumerator();
AssertFalse(Condition := _Enumerator.MoveNext(), Message := 'Empty stack must have no current entry');
AssertFalse(Condition := _Enumerator.MoveNext(), Message := 'Empty cursor must stay exhausted');
AssertTrue(
		Condition := _Enumerator.Current.TypeClass = TOF_Core.GENERIC_TYPE_CLASS.UNSPECIFIED,
		Message := 'Empty cursor must expose an empty descriptor'
	);
_OwnedEnumerator := _Enumerator;
_Enumerator := 0;
AssertTrue(
		Condition := TOF_Core.Memory.TryReleaseDynamicObject(instance := _OwnedEnumerator),
		Message := 'Empty enumerator must be released'
	);
_Stack.Clear();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="EmptyAndIndexBounds" Id="{2f506ba0-e4cb-45a6-967f-9912c7b593fc}">
      <Declaration><![CDATA[(*!
<summary>Checks empty access and invalid index rejection without changing entries.</summary>
<description>Runs once. Persistent fixtures keep ownership and borrowed storage valid after an aborted call.</description>
*)
METHOD EmptyAndIndexBounds
VAR
	value : INT := 7;
	result : TOF_Core.GENERIC_VALUE;
	peekRejected : BOOL;
	removeRejected : BOOL;
	indexRejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	expectedEmptyException : TOF_Core.ICollectionEmptyException;
	expectedIndexException : TOF_Core.IArgumentOutOfRangeException;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Stack.Clear();

__TRY
	result := _Stack.Peek();
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedEmptyException),
		Message := 'Rejected stack access must report its expected exception category'
	);
	peekRejected := TRUE;
__ENDTRY

__TRY
	_Stack.RemoveLast();
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedEmptyException),
		Message := 'Rejected stack access must report its expected exception category'
	);
	removeRejected := TRUE;
__ENDTRY

AssertTrue(Condition := peekRejected, Message := 'Peek on empty stack must raise');
AssertTrue(Condition := removeRejected, Message := 'RemoveLast on empty stack must raise');
AssertTrue(Condition := _Stack.Empty, Message := 'Rejected operations must preserve empty stack');

_Stack.PushCopy(value := value);

__TRY
	result := _Stack.GetByIndex(index := _Stack.Length);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedIndexException),
		Message := 'Rejected stack access must report its expected exception category'
	);
	indexRejected := TRUE;
__ENDTRY

AssertTrue(Condition := indexRejected, Message := 'Index equal to Length must be rejected');
AssertEquals_DINT(Expected := 1, Actual := _Stack.Length, Message := 'Rejected access must preserve Length');
AssertEquals_INT(Expected := value, Actual := _Stack.Peek().AsInt(), Message := 'Rejected access must preserve top');
_Stack.Clear();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopiedAndBorrowedValues" Id="{73e310d7-17c8-48cf-b8cd-07331bbde34e}">
      <Declaration><![CDATA[(*!
<summary>Checks copy isolation and borrowed descriptor lifetime without ownership transfer.</summary>
<description>Runs once. Persistent fixtures keep ownership and borrowed storage valid after an aborted call.</description>
*)
METHOD CopiedAndBorrowedValues
VAR
	borrowedValue : TOF_Core.GENERIC_VALUE;
END_VAR
VAR_INST
	//! <summary>Keeps borrowed payload alive after an aborted testcase.</summary>
	value : INT := 7;
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Stack.Clear();
value := 7;
_Stack.PushCopy(value := value);
value := 9;
AssertEquals_INT(Expected := 7, Actual := _Stack.Peek().AsInt(), Message := 'PushCopy must isolate the stored value');
	borrowedValue := TOF_Core.GenericValueFactory.FromAnyType(
		value := value,
		isObject := FALSE,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_NOT_OWNS_MEMORY
	);
_Stack.PushGeneric(value := borrowedValue);
value := 11;
AssertEquals_INT(
		Expected := value,
		Actual := _Stack.Peek().AsInt(),
		Message := 'PushGeneric must retain borrowed storage'
	);
AssertFalse(Condition := _Stack.Peek().IsMemoryOwner, Message := 'Borrowed entry must remain borrowed');
AssertTrue(Condition := _Stack.ContainsGeneric(value := borrowedValue, releaseValue := FALSE), Message := 'Borrowed query must find the top');
_Stack.RemoveLast();
AssertEquals_INT(Expected := 11, Actual := value, Message := 'Removing borrowed entry must preserve source');
AssertEquals_INT(
		Expected := 7,
		Actual := _Stack.Peek().AsInt(),
		Message := 'Removing borrowed entry must reveal copied value'
	);
_Stack.Clear();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OwnedObjectCleanup" Id="{96a3945c-b618-427a-8841-cba655825c69}">
      <Declaration><![CDATA[(*!
<summary>Checks exactly-once destruction on RemoveLast and Clear.</summary>
<description>Runs once. The suite retains probes and their counter across aborted calls until cleanup.</description>
*)
METHOD OwnedObjectCleanup
VAR
	value : TOF_Core.GENERIC_VALUE;
	i : DINT;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Stack.Clear();
_ExitCount := TOF_Core.UnsignedInt32.ZERO;

FOR i := 1 TO 2 DO
	_Probe := __NEW(ObjectExitProbe);

	IF _Probe = 0 THEN
		TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
	END_IF

	_Probe^.ObserveExit(counter := _ExitCount);
	value := TOF_Core.GenericValueFactory.FromAnyType(
		value := _Probe^,
		isObject := TRUE,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
	);
	_Stack.PushGeneric(value := value);
	value.Reset();
	_Probe := 0;
END_FOR

AssertEquals_UDINT(Expected := 0, Actual := _ExitCount, Message := 'Insertion must retain owned objects');
_Stack.RemoveLast();
AssertEquals_UDINT(Expected := 1, Actual := _ExitCount, Message := 'RemoveLast must destroy only the top object');
_Stack.Clear();
AssertEquals_UDINT(Expected := 2, Actual := _ExitCount, Message := 'Clear must destroy the remaining object');
_Stack.Clear();
AssertEquals_UDINT(Expected := 2, Actual := _ExitCount, Message := 'Repeated Clear must not destroy objects twice');

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ValidatorRejection" Id="{4bb6299e-3b28-4497-a098-737da0c597df}">
      <Declaration><![CDATA[(*!
<summary>Checks that validator rejection preserves storage and caller ownership.</summary>
<description>Runs once. The suite retains probes and their counter across aborted calls until cleanup.</description>
*)
METHOD ValidatorRejection
VAR
	value : TOF_Core.GENERIC_VALUE;
	originalCapacity : DINT;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	expectedException : TOF_Core.IIncompatibleGenericValueTypeException;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Stack.Clear();
_ValidatedStack.Clear();
_ExitCount := TOF_Core.UnsignedInt32.ZERO;
originalCapacity := _ValidatedStack.Capacity;
_Probe := __NEW(ObjectExitProbe);

IF _Probe = 0 THEN
	TOF_Core.DynamicMemoryManager.RaiseAllocationFailure();
END_IF

_Probe^.ObserveExit(counter := _ExitCount);
	value := TOF_Core.GenericValueFactory.FromAnyType(
		value := _Probe^,
		isObject := TRUE,
		memoryManagementBehavior := TOF_Core.GENERIC_MEMORY_MANAGEMENT_BEHAVIOR.STORE_ORIGINAL_REFERENCE_AND_OWNS_MEMORY
	);

__TRY
	_ValidatedStack.PushGeneric(value := value);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedException),
		Message := 'Validator must report an incompatible generic value type'
	);
	rejected := TRUE;
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Validator must reject an object when INT is required');
AssertEquals_DINT(
		Expected := originalCapacity,
		Actual := _ValidatedStack.Capacity,
		Message := 'Validation must run before growth'
	);
AssertTrue(Condition := _ValidatedStack.Empty, Message := 'Validation failure must not insert an entry');
AssertEquals_UDINT(Expected := 0, Actual := _ExitCount, Message := 'Rejected owned payload must remain alive');

IF rejected THEN
	value.Release();
ELSE
	value.Reset();
END_IF

_Probe := 0;
_ValidatedStack.Clear();
AssertEquals_UDINT(Expected := 1, Actual := _ExitCount, Message := 'Rejected payload must remain releasable by caller');
_Stack.Clear();

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="GrowthAndInvalidIncrement" Id="{09b97fe9-6c9f-4968-b144-28dbd962c66b}">
      <Declaration><![CDATA[(*!
<summary>Checks several growth steps and rejection of zero growth without changing entries.</summary>
<description>Runs once. The suite retains probes and their counter across aborted calls until cleanup.</description>
*)
METHOD GrowthAndInvalidIncrement
VAR
	i : DINT;
	value : INT := 99;
	rejected : BOOL;
	exceptionCode : __SYSTEM.ExceptionCode;
	caughtException : TOF_Core.IException;
	expectedException : TOF_Core.IArgumentOutOfRangeException;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN
	RETURN;
END_IF

TEST(TestName := __POUNAME());

_Stack.Clear();
_Stack.DefaultDynamicAllocationElementCount := 2;
AssertTrue(Condition := _Stack.Dynamic, Message := 'Zero static capacity must select dynamic storage');

FOR i := 1 TO 6 DO
	_Stack.PushCopy(value := i);
END_FOR

AssertEquals_DINT(Expected := 6, Actual := _Stack.Length, Message := 'Growth must preserve all entries');
AssertEquals_DINT(Expected := 6, Actual := _Stack.Capacity, Message := 'Growth must use the configured increment');
AssertFalse(Condition := _Stack.Full, Message := 'Dynamic storage must not report static Full');

FOR i := 0 TO 5 DO
	AssertEquals_DINT(
		Expected := 6 - i,
		Actual := _Stack.GetByIndex(index := i).AsDInt(),
		Message := 'Growth must preserve LIFO order'
	);
END_FOR

_Stack.DefaultDynamicAllocationElementCount := 0;

__TRY
	_Stack.PushCopy(value := value);
__CATCH(exceptionCode)
	caughtException := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	AssertTrue(
		Condition := __QUERYINTERFACE(caughtException, expectedException),
		Message := 'Zero growth must raise ArgumentOutOfRangeException'
	);
	rejected := TRUE;
__ENDTRY

AssertTrue(Condition := rejected, Message := 'Zero growth increment must be rejected');
AssertEquals_DINT(Expected := 6, Actual := _Stack.Length, Message := 'Rejected growth must preserve Length');
AssertEquals_DINT(Expected := 6, Actual := _Stack.Capacity, Message := 'Rejected growth must preserve Capacity');
AssertEquals_DINT(Expected := 6, Actual := _Stack.Peek().AsDInt(), Message := 'Rejected growth must preserve top');
_Stack.DefaultDynamicAllocationElementCount := 2;
_Stack.PushCopy(value := value);
AssertEquals_DINT(Expected := 8, Actual := _Stack.Capacity, Message := 'Valid growth must work after rejection');
AssertEquals_INT(
		Expected := value,
		Actual := _Stack.Peek().AsInt(),
		Message := 'Push after rejection must establish a new top'
	);
_Stack.Clear();
_Stack.DefaultDynamicAllocationElementCount := 10;

testFinished := TRUE;
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="cleanupFixtures" Id="{a541b562-4c3e-42dd-a1a5-a8cf550ba15e}">
      <Declaration><![CDATA[(*!
<summary>Releases persistent fixtures after normal execution or an aborted call.</summary>
<description>
Releases cursors before source storage. Unaccepted probes remain suite-owned and the exit counter remains
alive. Uses non-throwing disposal without allocation or exception registration.
</description>
*)
METHOD PRIVATE cleanupFixtures]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Enumerator <> 0 THEN
	_OwnedEnumerator := _Enumerator;
	_Enumerator := 0;
	TOF_Core.Memory.TryReleaseDynamicObject(instance := _OwnedEnumerator);
END_IF

IF _SecondEnumerator <> 0 THEN
	_OwnedEnumerator := _SecondEnumerator;
	_SecondEnumerator := 0;
	TOF_Core.Memory.TryReleaseDynamicObject(instance := _OwnedEnumerator);
END_IF

_Stack.Clear();
_ValidatedStack.Clear();

IF _Probe <> 0 THEN
	__DELETE(_Probe);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{7a41e28c-8cb7-4da4-9898-813f10dba9c5}">
      <Declaration><![CDATA[(*!
<summary>Releases suite-owned cursors, entries and unaccepted probes during destruction.</summary>
<description>Uses the non-allocating cleanup path shared with ordinary suite execution.</description>
*)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[cleanupFixtures();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>