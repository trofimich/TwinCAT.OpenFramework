(*!
<summary>Groups dynamic dictionary lookup, update, removal and clear cases.</summary>
<description>
Owns the child cases, their fixed registration array and the dictionaries borrowed by the common cases.
Each borrowed fixture is reserved for its case throughout the group lifetime. Use from one task at a stable address.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicDictionaryTestGroup EXTENDS TOF_Testing.TestGroup<4>
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_SetAndGetDictionary : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
	_RemoveDictionary : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
	_ContainsDictionary : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);

	_SetAndGet : DictionarySetAndGetTest(name := "SetAndGet", parent := THIS^, dictionary := _SetAndGetDictionary);
	_Remove : DictionaryRemoveTest(name := "Remove", parent := THIS^, dictionary := _RemoveDictionary);
	_Contains : DictionaryContainsTest(name := "Contains", parent := THIS^, dictionary := _ContainsDictionary);
	_Clear : DynamicDictionaryClearTest(name := "Clear", parent := THIS^);

	_Children : ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement :=
	[
		_SetAndGet,
		_Remove,
		_Contains,
		_Clear
	];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Children" Id="{1bb476a4-c15a-436d-ba4e-bbdaf79ed74e}">
      <Declaration><![CDATA[//! <summary>Borrows the fixed child array. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY Children : REFERENCE TO ARRAY [0.._ChildCount - 1] OF TOF_Testing.ITestElement]]></Declaration>
      <Get Name="Get" Id="{fd66beb3-2936-4186-a0a4-87d501363c41}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Children REF= _Children;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{b9c34187-da47-4b2f-b8ac-6307074d8086}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{6f31c43d-18ee-4286-99bc-9904fabab7a5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{0c9dafa6-1e3e-43cd-bd38-ac5d46141ae9}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ecf2564d-41c5-4565-a297-00ed2ad76041}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{af0e31e4-639c-4a0e-9c55-a3a17179aa5e}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a5b33f6e-4d8b-4e21-b810-1dc7ca17f93b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
