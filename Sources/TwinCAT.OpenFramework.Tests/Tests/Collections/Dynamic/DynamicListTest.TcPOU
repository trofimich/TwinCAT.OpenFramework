END_IF 

TEST(__POUNAME());

_ListToTest.SetGeneric(1, TOF_Core.GenericValueFactory.FromStringReference(_DynamicStringArray[4]^));
	
AssertEquals_STRING(Expected := 'String4', Actual := _ListToTest.Get(1).AsString255(), Message := 'Invalid generic value set');
 
testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
