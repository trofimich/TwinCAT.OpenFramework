<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicUniqueDataSetClearTest" Id="{bfdf685d-e535-4aa9-8507-e0c8b40fa37a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks clearing grown storage and rebuilding membership on reuse.</summary>
<description>
Owns a dynamic set and copied values at a stable address. Run from one task.
Teardown releases remaining entries and dynamic storage.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicUniqueDataSetClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Set : TOF_Collections.UniqueDataSet<0>(valueValidator := 0, valueEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{6d44540e-23ca-44ff-9fe5-a5c4756afb64}">
      <Declaration><![CDATA[(*!
<summary>Checks clearing grown storage and rebuilding membership on reuse.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [0..6] OF STRING :=
		['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	i : DINT;
	freshValue : STRING := 'String9';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Set.DefaultDynamicAllocationElementCount := BYTE#2;

FOR i := 6 TO 0 BY -1 DO
	_Set.SetCopy(value := values[i]);
END_FOR

Assert.ThatBool(
	actual := _Set.Length = 7 AND_THEN _Set.Capacity = 8,
	message := "The clear fixture must start with grown capacity"
).IsTrue();

FOR i := 0 TO 6 DO
	Assert.ThatBool(
		actual := _Set.Contains(value := values[i]),
		message := TOF_Core.WideStrings.Concat255("Growth must preserve the value at offset ", TO_WSTRING(i))
	).IsTrue();
END_FOR

_Set.Clear();

Assert.ThatBool(
	actual := _Set.Empty AND_THEN _Set.Length = 0 AND_THEN _Set.Capacity = 0,
	message := "Clear must empty the set and release capacity"
).IsTrue();

Assert.ThatBool(
	actual := _Set.Contains(value := values[3]),
	message := "The cleared index must not find an old member"
).IsFalse();

_Set.Clear();
_Set.SetCopy(value := freshValue);

Assert.ThatBool(
	actual := _Set.Contains(value := freshValue),
	message := "Reuse must index the newly inserted member"
).IsTrue();

Assert.ThatBool(
	actual := _Set.Contains(value := values[3]),
	message := "Reuse must keep old membership absent"
).IsFalse();

Assert.ThatBool(
	actual := _Set.Length = 1 AND_THEN _Set.Capacity = 2,
	message := "Reuse must allocate only the initial capacity"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{8b61bfaf-fe13-4e88-8dcd-ae8e71af60c2}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Set.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{6d49cc75-4134-49e3-a464-b206d80d9b4a}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{46cd5668-9a5b-4c64-81cd-c4f58a94eb9e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5c7068a5-2aaa-420c-b57e-8d443a8c95fc}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{25815e0f-12e9-4a67-8ae0-03473a81ede7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{86becb70-c96e-454b-adf7-70e09dc071a6}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{fc3f7b2a-2093-4a45-adc7-6f69eb584fee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
