<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicStackClearTest" Id="{d224f526-aaa8-4720-a59a-bbf9dc719c53}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks populated clear, storage policy and reuse.

Owns a stack and its copied values at a stable address. Use from one task.
Teardown clears surviving entries before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicStackClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.Stack<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{a3099ee5-5dda-425d-8e88-5a36de99e3a0}">
      <Declaration><![CDATA[(* Checks populated clear, storage policy and reuse. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.PushCopy(value := values[1]);
_Stack.PushCopy(value := values[2]);
_Stack.PushCopy(value := values[3]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Clear fixture must start with three entries"
).ToBe(expected := DINT#3);

_Stack.Clear();

Assert.ThatBool(
	actual := _Stack.Empty AND_THEN _Stack.Length = 0,
	message := "Clear must empty the stack"
).IsTrue();

Assert.ThatDInt(
	actual := _Stack.Capacity,
	message := "Clear must restore the expected storage capacity"
).ToBe(expected := DINT#0);

_Stack.Clear();
_Stack.PushCopy(value := values[4]);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "The cleared stack must expose the fresh top"
).ToBe(expected := values[4]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Reuse must leave only one entry"
).ToBe(expected := DINT#1);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAfterTest" Id="{4fc869ed-6178-41e6-8bfe-7f5fa7cc81a9}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED OnAfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{4e3fecc7-52dc-4d60-a602-e17424561fd6}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4441fbdb-329a-4e6b-8b84-7c1191346a0d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{d0967116-36e1-4235-9665-e2773a086d03}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{7ae4f778-a155-40ed-849e-c5390c5183bf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{bc36c316-2fe0-4737-8b82-41bf2f0b7600}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{0ba7fa0d-96dc-45b1-9b71-cac0c3489c2a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
