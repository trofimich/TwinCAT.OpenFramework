(*!
<summary>Exercises the DynamicDictionaryTest collection scenarios.</summary>
<description>
Owns the suite's test collection and runs the existing TcUnit cases.
The collection is initialized explicitly with default key equality and hashing.
Temporary owned query descriptors request explicit release; changing query defaults does not
transfer those allocations to the test suite.
Lookup assertions use equality and current returned positions without assuming sorted order.
</description>
*)

FUNCTION_BLOCK DynamicDictionaryTest EXTENDS TcUnit.FB_TestSuite
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();

	_KeyArray : ARRAY [0..6] OF INT := [0, 1, 2, 3, 4, 5, 6];
	_ValueArray : ARRAY [0..6] OF STRING := ['String0', 'String1', 'String2', 'String3', 'String4', 'String5', 'String6'];
	
	_DictionaryToTest : TOF_Collections.Dictionary<0>(keyValidator := 0, valueValidator := 0, keyEqualityComparer := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SetAndGet();
Remove();
Contains();
Clear();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{ce069e47-828b-4454-96d2-53b1338e2414}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2de47370-aca5-48b6-b477-71de44b52d2b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clear" Id="{3d0356bb-823f-44ba-902f-4d6182578f27}">
      <Declaration><![CDATA[METHOD Clear 
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_DictionaryToTest.Clear();

AssertEquals_DINT(Expected := 0, Actual := _DictionaryToTest.Capacity, Message := 'Invalid capacity after Clear');
AssertEquals_DINT(Expected := 0, Actual := _DictionaryToTest.Length, Message := 'Invalid element count after Clear');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Contains" Id="{d3baf0b9-cf4b-491a-b057-832b3cf2b167}">
      <Declaration><![CDATA[(*!
<summary>Exercises lookup for present and absent values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
</description>
*)
METHOD Contains
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_DictionaryToTest
	.SetCopy(_KeyArray[6], _ValueArray[6])
	.SetCopy(_KeyArray[5], _ValueArray[5])
	.SetCopy(_KeyArray[4], _ValueArray[4])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetCopy(_KeyArray[2], _ValueArray[2])
	.SetCopy(_KeyArray[1], _ValueArray[1])
	.SetCopy(_KeyArray[0], _ValueArray[0])
	.SetCopy(_KeyArray[3], _ValueArray[3]);

AssertEquals_BOOL(Expected := TRUE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[3]), Message := 'ContainsKey did not find the value');
AssertEquals_BOOL(Expected := TRUE, Actual := _DictionaryToTest.ContainsGenericKey(TOF_Core.GenericValueFactory.FromIntValue(3), releaseKey := TRUE), Message := 'ContainsGenericKey did not find the value');
AssertEquals_BOOL(Expected := FALSE, Actual := _DictionaryToTest.ContainsGenericKey(TOF_Core.GenericValueFactory.FromIntValue(9), releaseKey := TRUE), Message := 'ContainsGenericKey found not existing value');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{afdfaabc-dc94-4db8-b93c-6172f2d6efcf}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{29928a97-3bc0-447c-a151-b42f4058241d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Remove" Id="{93d5646e-318b-4558-ad34-b55297d3d003}">
      <Declaration><![CDATA[(*!
<summary>Exercises removal and the resulting collection state.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
Removes the intended element using its current position and checks removed/retained membership
rather than sorted ranks.
</description>
*)
METHOD Remove
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_DictionaryToTest.SetCopy(_KeyArray[6], _ValueArray[6]);
_DictionaryToTest.SetCopy(_KeyArray[5], _ValueArray[5]);
_DictionaryToTest.SetCopy(_KeyArray[4], _ValueArray[4]);
_DictionaryToTest.SetCopy(_KeyArray[3], _ValueArray[3]);
_DictionaryToTest.SetCopy(_KeyArray[2], _ValueArray[2]);
_DictionaryToTest.SetCopy(_KeyArray[1], _ValueArray[1]);
_DictionaryToTest.SetCopy(_KeyArray[0], _ValueArray[0]);
_DictionaryToTest.SetCopy(_KeyArray[3], _ValueArray[3]);

_DictionaryToTest.RemoveAt(_DictionaryToTest.GetKeyPosition(_KeyArray[3]));

AssertEquals_DINT(Expected := 6, Actual := _DictionaryToTest.Length, Message := 'Invalid length after RemoveAt');
AssertEquals_BOOL(Expected := FALSE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[3]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[4]), Message := 'Removal lost a retained element');

_DictionaryToTest.TryRemoveByKey(_KeyArray[2]);

AssertEquals_DINT(Expected := 5, Actual := _DictionaryToTest.Length, Message := 'Invalid length after TryRemoveByKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[2]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[4]), Message := 'Removal lost a retained element');

_DictionaryToTest.TryRemoveByGenericKey(TOF_Core.GenericValueFactory.FromIntValue(1), releaseKey := TRUE);

AssertEquals_DINT(Expected := 4, Actual := _DictionaryToTest.Length, Message := 'Invalid length after TryRemoveByGenericKey');
AssertEquals_BOOL(Expected := FALSE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[1]), Message := 'Removed element is still present');
AssertEquals_BOOL(Expected := TRUE, Actual := _DictionaryToTest.ContainsKey(_KeyArray[4]), Message := 'Removal lost a retained element');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAndGet" Id="{fbd1236e-63ef-48f9-bcb2-74185b7c5660}">
      <Declaration><![CDATA[(*!
<summary>Exercises storing entries and retrieving their positions or values.</summary>
<description>
Runs once per suite instance through the existing testFinished latch.
Owned factory-created query descriptors request explicit release so the test retains its cleanup
behavior with borrowed query defaults.
Raw and generic queries must return the same current position; indexed reads use a queried position
without assuming sorted order.
</description>
*)
METHOD SetAndGet
VAR
	genericValue : TOF_Core.GENERIC_VALUE;
	keyValuePair : TOF_Core.GENERIC_KEY_VALUE_PAIR;
END_VAR
VAR_INST
	testFinished : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF testFinished THEN 
	RETURN; 
END_IF 

TEST(__POUNAME());

_DictionaryToTest
	.SetCopy(_KeyArray[6], _ValueArray[6])
	.SetCopy(_KeyArray[5], _ValueArray[5])
	.SetCopy(_KeyArray[4], _ValueArray[4])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetCopy(_KeyArray[2], _ValueArray[2])
	.SetCopy(_KeyArray[1], _ValueArray[1])
	.SetCopy(_KeyArray[0], _ValueArray[0])
	.SetCopy(_KeyArray[3], _ValueArray[3])
	.SetGeneric(TOF_Core.GenericValueFactory.FromIntValue(5), TOF_Core.GenericValueFactory.FromStringValue('String5'));

AssertEquals_DINT(Expected := 7, Actual := _DictionaryToTest.Length, Message := 'Invalid length after Set');

AssertEquals_BOOL(Expected := TRUE, Actual := _DictionaryToTest.GetKeyPosition(_KeyArray[2]) >= TOF_Core.SignedInt32.ZERO, Message := 'Lookup did not return a valid position');

AssertEquals_DINT(Expected := _DictionaryToTest.GetKeyPosition(_KeyArray[2]), Actual := _DictionaryToTest.GetGenericKeyPosition(TOF_Core.GenericValueFactory.FromIntValue(2), releaseKey := TRUE), Message := 'Raw and generic queries returned different positions');

_DictionaryToTest.TryGetValueByKey(_KeyArray[2], value => genericValue);
AssertEquals_STRING(Expected := 'String2', Actual := genericValue.AsString255(), Message := 'Invalid element found by TryGetValueByKey');

_DictionaryToTest.TryGetValueByGenericKey(TOF_Core.GenericValueFactory.FromIntValue(2), releaseKey := TRUE, value => genericValue);
AssertEquals_STRING(Expected := 'String2', Actual := genericValue.AsString255(), Message := 'Invalid element found by TryGetValueByGenericKey');

keyValuePair := _DictionaryToTest.GetKeyValuePairByIndex(_DictionaryToTest.GetKeyPosition(_KeyArray[3]));
AssertEquals_STRING(Expected := 'String3', Actual := keyValuePair.Value.AsString255(), Message := 'Invalid element position found by GetKeyValuePairByIndex');

testFinished := TRUE; 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>