<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicQueueClearTest" Id="{e7da9397-cf00-4706-b741-1b9c7a4b5649}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks release of populated storage and allocation on reuse.</summary>
<description>
Owns a dynamic queue and copied payloads at a stable address. Run from one task.
Teardown clears surviving entries and releases dynamic capacity.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicQueueClearTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Queue : TOF_Collections.Queue<0>(valueValidator := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ExecuteTest" Id="{e41705b1-8de3-4792-91d4-6072ed99d7b3}">
      <Declaration><![CDATA[(*!
<summary>Checks release of populated storage and allocation on reuse.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.DefaultDynamicAllocationElementCount := BYTE#2;

_Queue
	.EnqueueCopy(value := values[1])
	.EnqueueCopy(value := values[2])
	.EnqueueCopy(value := values[3]);

Assert.ThatBool(
	actual := _Queue.Length = 3 AND_THEN _Queue.Capacity = 4,
	message := "The clear fixture must contain three entries in grown storage"
).IsTrue();

_Queue.Clear();

Assert.ThatBool(
	actual := _Queue.Empty AND_THEN _Queue.Length = 0 AND_THEN _Queue.Capacity = 0,
	message := "Clearing a dynamic queue must release its capacity and empty it"
).IsTrue();

Assert.ThatBool(
	actual := _Queue.Contains(value := values[3]),
	message := "Clearing must hide the previous tail"
).IsFalse();

_Queue.Clear();
_Queue.EnqueueCopy(value := values[4]);

Assert.ThatInt(
	actual := _Queue.Peek().AsInt(),
	message := "The cleared queue must accept a fresh head"
).ToBe(expected := values[4]);

Assert.ThatBool(
	actual := _Queue.Length = 1 AND_THEN _Queue.Capacity = 2,
	message := "The fresh head must allocate only the initial capacity"
).IsTrue();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AfterTest" Id="{1d3024d1-bc21-4721-8d22-d0ae385e6282}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Queue.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{b1175283-46bc-4fa7-9740-0fd6061cd854}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5d01fefd-972d-4d6b-903a-3160252ec217}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{57288c9a-c26c-4a19-988c-3a8b51d528e2}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{92fb7b45-6cca-4c10-9de3-6442fe9c0b93}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1ff2dacb-e1ca-4ad4-87fe-dfc55b36c741}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a38892a9-4edb-49a4-bfe0-3308b6eabbd5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
