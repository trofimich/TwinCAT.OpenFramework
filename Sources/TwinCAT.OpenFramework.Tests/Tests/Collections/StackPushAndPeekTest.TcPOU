<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="StackPushAndPeekTest" Id="{1e0f0d81-b6ea-4997-b2d6-74d7a036653a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Checks the current LIFO top and length after each push.</summary>
<description>
Borrows a group-owned stack reserved for this case. Use from one task at a stable address.
Teardown clears the stack and test-owned resources before publication.
</description>
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StackPushAndPeekTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{4e72989c-514a-4e22-8217-0c61fb5d6269}">
      <Declaration><![CDATA[(*!
<summary>Clears the fixture before the runner publishes the result.</summary>
<description>
Also runs after an unexpected exception interrupts the case.
</description>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{d6843c90-ec27-41dd-ac88-4813e63c8e37}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5bc9100c-800b-4bcb-9d59-97faa9c41aee}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{1f43e591-99f6-449f-bd73-90cdf35f4916}">
      <Declaration><![CDATA[(*!
<summary>Checks the current LIFO top and length after each push.</summary>
*)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.PushCopy(value := values[1]);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "Push 1 must establish the new top"
).ToBe(expected := values[1]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Peeking after push 1 must preserve length"
).ToBe(expected := DINT#1);

_Stack.PushCopy(value := values[2]);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "Push 2 must establish the new top"
).ToBe(expected := values[2]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Peeking after push 2 must preserve length"
).ToBe(expected := DINT#2);

_Stack.PushCopy(value := values[3]);

Assert.ThatInt(
	actual := _Stack.Peek().AsInt(),
	message := "Push 3 must establish the new top"
).ToBe(expected := values[3]);

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Peeking after push 3 must preserve length"
).ToBe(expected := DINT#3);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{883f9d39-5611-4c97-9a4e-52c630b8ee33}">
      <Declaration><![CDATA[(*!
<summary>Binds the stack fixture for this case.</summary>
<description>
Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.
</description>
<param name="name">Display name of this case.</param>
<param name="parent">Group that owns this case.</param>
<param name="stack">Required live stack reserved for this case.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack := stack;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{7b6fc482-d81e-4b1d-b1a2-171c65516c36}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace name. Callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2b2c3a10-b909-47c3-b2a5-3ffd34654e08}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{e137269f-756a-42e8-88e3-b565e12e83de}">
      <Declaration><![CDATA[//! <summary>Reports the concrete instance size in bytes.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b24afb9e-2504-4a59-975a-936af3decb5d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>