<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="StackContainsGenericTest" Id="{e62e0d15-4c09-4c6f-8464-ee19a383eb4a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: c 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Checks generic membership with independent borrowed queries.

Borrows a group-owned stack reserved for this case. Use from one task at a stable address.
Teardown clears the stack and test-owned resources before publication.
*)

{attribute 'no_assign'}
{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StackContainsGenericTest EXTENDS TOF_Testing.SingleCycleTest
VAR_STAT
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	_Stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{284d2fbd-3145-432f-8c4a-c129d33b8eca}">
      <Declaration><![CDATA[(*
Clears the fixture before the runner publishes the result.

Also runs after an unexpected exception interrupts the case.
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.Clear();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{8836ae1b-67aa-4b7c-9f04-dfec30089881}">
      <Declaration><![CDATA[// Borrows the concrete class name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{60e96e51-6ae7-4680-a8cb-7b457511a340}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{6c147a1e-b27b-4cbb-a0d2-4099e4ca71ef}">
      <Declaration><![CDATA[(* Checks generic membership with independent borrowed queries. *)
METHOD PROTECTED ExecuteTest
VAR
	values : ARRAY [1..4] OF INT := [11, 22, 33, 44];
	query : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack.PushCopy(value := values[1]);
_Stack.PushCopy(value := values[2]);
_Stack.PushCopy(value := values[3]);

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[1]);
Assert.ThatBool(
	actual := _Stack.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must find the bottom value"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[3]);
Assert.ThatBool(
	actual := _Stack.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must find the top value"
).IsTrue();

query := TOF_Core.GenericValueFactory.FromIntReference(value := values[4]);
Assert.ThatBool(
	actual := _Stack.ContainsGeneric(value := query, releaseValue := FALSE),
	message := "Generic lookup must reject an absent value"
).IsFalse();

Assert.ThatDInt(
	actual := _Stack.Length,
	message := "Generic lookup must preserve all three entries"
).ToBe(expected := DINT#3);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{4d63b32f-2dcd-42ab-ba61-089d2d63aa22}">
      <Declaration><![CDATA[(*
Binds the stack fixture for this case.

Stores a borrowed interface without invoking the fixture. The owning group keeps it alive and
reserves it for this case. TestElement initializes the name and parent.

name — Display name of this case.
parent — Group that owns this case.
stack — Required live stack reserved for this case.
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Testing.ITestElement;
	stack : TOF_Collections.IStack;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Stack := stack;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{38c2e328-3cac-4969-839f-13b7b925bf16}">
      <Declaration><![CDATA[// Borrows the compiler-initialized namespace name. Callers must not modify it.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c5c70f06-ac4f-4814-9d8a-718176a0cea3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{5b6497b0-b6e0-494f-80bf-0136aad47c65}">
      <Declaration><![CDATA[// Reports the concrete instance size in bytes.
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4cf4eb27-0d43-4057-9f97-addfb307de1d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>