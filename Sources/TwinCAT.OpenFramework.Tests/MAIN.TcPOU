PROGRAM MAIN
VAR_OUTPUT
	TestAutomationUnit : TestAutomationController("TestController");
	
	Runner : TOF_Automation.AutomationRunner;
END_VAR
VAR	
	_AutomationControllers : ARRAY [0..0] OF TOF_Automation.IAutomationComponent := 
	[
		TestAutomationUnit
	];
	
	_LogFilter : LogFilter;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF Runner.State = TOF_Automation.AUTOMATION_RUNNER_STATE.INITIALIZING THEN
	TOF_Core.LogManager.Filter := _LogFilter;	
END_IF

Runner.Execute(_AutomationControllers);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>