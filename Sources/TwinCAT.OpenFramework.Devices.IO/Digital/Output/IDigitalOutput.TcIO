(*!
<summary>Configuration and control contract for a digital output component.</summary>
<description>
Extends IReadOnlyDigitalOutput with hardware IO mapping, contact configuration and state setter.
</description>
*)

INTERFACE IDigitalOutput EXTENDS IReadOnlyDigitalOutput]]></Declaration>
    <Method Name="BindToIO" Id="{1f74b7e9-0c5a-4c8e-bda4-2181c516a55a}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a raw boolean process image output variable.</summary>
<param name="rawValue">Reference to physical boolean output variable '%Q*'.</param>
*)
METHOD BindToIO
VAR_INPUT
	rawValue : REFERENCE TO BOOL;
END_VAR]]></Declaration>
    </Method>
    <Property Name="ContactType" Id="{09905dfc-8018-4375-84e1-641200c96801}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets electrical contact configuration.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ContactType : CONTACT_TYPE]]></Declaration>
      <Get Name="Get" Id="{e93e9ef1-3bf5-44a6-902f-0b36ce6ff60c}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{1c5c83b1-d0cc-4e55-a690-8b326438bbcd}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
    <Property Name="Value" Id="{3b67f288-b0f6-454c-9c40-fb328df7115e}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets logical state to write to the digital output.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Value : BOOL]]></Declaration>
      <Get Name="Get" Id="{544fc4fd-a4c2-41c5-9577-ae84fa28eb42}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{c86cdb0d-c415-43cf-a61d-428f44825b37}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
  </Itf>
</TcPlcObject>