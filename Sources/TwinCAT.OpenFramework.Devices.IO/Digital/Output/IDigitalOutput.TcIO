<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IDigitalOutput" Id="{812c87a7-3073-457d-b4ac-4f59f69ef3e5}">
    <Declaration><![CDATA[(*
