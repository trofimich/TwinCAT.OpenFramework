(*!
<summary>Configuration and binding contract for a digital input component.</summary>
<description>
Extends IReadOnlyDigitalInput with hardware IO mapping and contact type mutator.
</description>
*)

INTERFACE IDigitalInput EXTENDS IReadOnlyDigitalInput]]></Declaration>
    <Method Name="BindToIO" Id="{1605f517-9c92-4d01-9cb9-f5bfa59a0a38}">
      <Declaration><![CDATA[(*!
<summary>Binds the component to a raw boolean process image variable.</summary>
<param name="rawValue">Reference to physical boolean input variable '%I*'.</param>
*)
METHOD BindToIO
VAR_INPUT
	rawValue : REFERENCE TO BOOL;
END_VAR]]></Declaration>
    </Method>
    <Property Name="ContactType" Id="{6ae1258a-1040-45e8-9622-72a56fb0eb7a}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets electrical contact configuration.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ContactType : CONTACT_TYPE]]></Declaration>
      <Get Name="Get" Id="{96d39911-8bb3-49a7-a778-9c9dc0e52a37}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{c9a31045-becf-4bee-89ba-60b48648b28a}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
  </Itf>
</TcPlcObject>