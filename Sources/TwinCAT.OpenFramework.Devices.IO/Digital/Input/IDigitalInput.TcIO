<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IDigitalInput" Id="{3b250580-3a55-494b-88a0-6b2b71c6cc79}">
    <Declaration><![CDATA[(*
