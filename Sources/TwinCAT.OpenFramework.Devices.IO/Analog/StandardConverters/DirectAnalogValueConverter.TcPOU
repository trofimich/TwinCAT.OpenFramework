<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DirectAnalogValueConverter" Id="{8635bf3a-7ddb-4863-847d-060b4774f236}" SpecialFunc="None">
    <Declaration><![CDATA[(*
