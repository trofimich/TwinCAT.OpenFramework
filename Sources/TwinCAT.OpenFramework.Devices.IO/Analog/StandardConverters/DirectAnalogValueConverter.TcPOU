(*!
<summary>Performs direct 1:1 pass-through conversion between raw and engineering analog values.</summary>
<description>
Casts between numeric types without range scaling or boundary clamping.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DirectAnalogValueConverter EXTENDS TOF_Core.Object IMPLEMENTS IAnalogValueConverter
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{2605209c-aa5d-48f1-b5a5-feff1831541d}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the converter.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9ebe162b-ff33-4714-8269-d56b870ef8ba}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ConvertAnalogValueToRawValue" Id="{ce161fc1-4794-449b-a925-96878b653591}">
      <Declaration><![CDATA[(*!
<summary>Directly converts an engineering unit value to raw hardware representation.</summary>
<param name="analogValue">Engineering unit analog value.</param>
<param name="rawValueType">Target raw data representation.</param>
*)
METHOD ConvertAnalogValueToRawValue : RAW_ANALOG_VALUE
VAR_INPUT
	analogValue	: LREAL;
	rawValueType : RAW_ANALOG_VALUE_TYPE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ConvertAnalogValueToRawValue.Int32 := 0;

CASE rawValueType OF
	RAW_ANALOG_VALUE_TYPE.INT16:
		ConvertAnalogValueToRawValue.Int16 := TO_INT(analogValue);
	
	RAW_ANALOG_VALUE_TYPE.INT32:
		ConvertAnalogValueToRawValue.Int32 := TO_DINT(analogValue);
	
	RAW_ANALOG_VALUE_TYPE.REAL32:
		ConvertAnalogValueToRawValue.Real32 := TO_REAL(analogValue);
	
	ELSE
		RETURN;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConvertRawValueToAnalogValue" Id="{c70aaedc-168c-428c-913b-72f86c123b1b}">
      <Declaration><![CDATA[(*!
<summary>Directly converts a raw hardware representation to an engineering unit value.</summary>
<param name="rawValue">Raw process value union.</param>
<param name="rawValueType">Source raw data representation.</param>
*)
METHOD ConvertRawValueToAnalogValue : LREAL
VAR_INPUT
	rawValue : RAW_ANALOG_VALUE;
	rawValueType : RAW_ANALOG_VALUE_TYPE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE rawValueType OF
	RAW_ANALOG_VALUE_TYPE.INT16:
		ConvertRawValueToAnalogValue := TO_LREAL(rawValue.Int16);
	
	RAW_ANALOG_VALUE_TYPE.INT32:
		ConvertRawValueToAnalogValue := TO_LREAL(rawValue.Int32);
	
	RAW_ANALOG_VALUE_TYPE.REAL32:
		ConvertRawValueToAnalogValue := TO_LREAL(rawValue.Real32);
	
	ELSE
		ConvertRawValueToAnalogValue := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{a54ed07f-fbe1-41b5-b5e5-6d50d9fb54b9}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace name of the converter.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{ef8c248a-3c4a-4fbe-be30-475fcbb83200}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{188fe25d-c91b-4d47-a0c2-a9833a8525bc}">
      <Declaration><![CDATA[(*!
<summary>Gets the memory size of the instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{eeaf7768-e212-4a49-8505-97c7a06613c1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>