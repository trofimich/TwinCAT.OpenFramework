<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StaticRangeAnalogValueConverter" Id="{8bfb79ca-38fb-48e6-8fa5-f03902a6c98a}" SpecialFunc="None">
    <Declaration><![CDATA[(*
