(*!
<summary>Range converter with static limits passed at construction and stored in internal fields.</summary>
<description>
Safely preserves configured limits across TwinCAT online change cycles by guarding against bInCopyCode zeroing.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK StaticRangeAnalogValueConverter EXTENDS AbstractRangeAnalogValueConverter
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'} 
	_MinAnalogValueVariable : LREAL;
	{attribute 'hide'} 
	_MaxAnalogValueVariable : LREAL;
	{attribute 'hide'} 
	_MinRawValueVariable : RAW_ANALOG_VALUE;
	{attribute 'hide'} 
	_MaxRawValueVariable : RAW_ANALOG_VALUE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{f225b4c3-3770-4526-8d24-8f9b17c94ac6}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the converter.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{1e40a6f5-8aab-44ae-954a-cfc944f55260}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{c27e589d-53ab-4bd9-9238-65b8df322868}">
      <Declaration><![CDATA[(*!
<summary>Initializes static limits and binds internal references.</summary>
<param name="bInitRetains">TRUE: retain variables are initialized.</param>
<param name="bInCopyCode">TRUE: instance copied to copy code (online change).</param>
<param name="minAnalogValue">Minimum engineering unit value.</param>
<param name="maxAnalogValue">Maximum engineering unit value.</param>
<param name="minRawValue">Minimum raw hardware process value.</param>
<param name="maxRawValue">Maximum raw hardware process value.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	minAnalogValue : LREAL;
	maxAnalogValue : LREAL;
	minRawValue : RAW_ANALOG_VALUE;
	maxRawValue : RAW_ANALOG_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_MinAnalogValueVariable := minAnalogValue;
	_MaxAnalogValueVariable := maxAnalogValue;
	_MinRawValueVariable := minRawValue;
	_MaxRawValueVariable := maxRawValue;
END_IF

_MinAnalogValue REF= _MinAnalogValueVariable;
_MaxAnalogValue REF= _MaxAnalogValueVariable;
_MinRawValue REF= _MinRawValueVariable;
_MaxRawValue REF= _MaxRawValueVariable;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{e456092c-27c0-422b-8aba-c37187fdfff9}">
      <Declaration><![CDATA[(*!
<summary>Gets the memory size of the instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{373d6d1f-2cdd-4f48-96df-937f2f5a9b85}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>