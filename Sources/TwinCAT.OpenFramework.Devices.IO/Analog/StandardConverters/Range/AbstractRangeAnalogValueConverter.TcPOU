<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AbstractRangeAnalogValueConverter" Id="{c2526683-36df-499d-8472-588820322f0f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
