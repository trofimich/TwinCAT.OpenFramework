<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DynamicRangeAnalogValueConverter" Id="{79ca6418-ffb7-4bc0-8693-f2d030e14fc4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: Â© 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
