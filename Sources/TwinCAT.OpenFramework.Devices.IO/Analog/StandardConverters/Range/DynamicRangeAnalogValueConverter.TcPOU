(*!
<summary>Range converter with dynamically referenced limit variables that can change at runtime.</summary>
<description>
Safely handles online changes without resetting dynamic references to zero.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK DynamicRangeAnalogValueConverter EXTENDS AbstractRangeAnalogValueConverter
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'} 
	_ZeroAnalogValue : LREAL;
	{attribute 'hide'} 
	_ZeroRawValue : RAW_ANALOG_VALUE; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{96bdbf4c-0436-465a-8e1f-a066b81a1353}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the converter.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{413e55b9-d883-40c7-bca7-f7b0515c374e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{ab7f4ce1-80c9-4954-b822-1c193f24974f}">
      <Declaration><![CDATA[(*!
<summary>Initializes dynamic limit references.</summary>
<param name="bInitRetains">TRUE: retain variables are initialized.</param>
<param name="bInCopyCode">TRUE: instance copied to copy code (online change).</param>
<param name="minAnalogValue">Reference to minimum engineering unit variable.</param>
<param name="maxAnalogValue">Reference to maximum engineering unit variable.</param>
<param name="minRawValue">Reference to minimum raw process variable.</param>
<param name="maxRawValue">Reference to maximum raw process variable.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	minAnalogValue : REFERENCE TO LREAL;
	maxAnalogValue : REFERENCE TO LREAL;
	minRawValue : REFERENCE TO RAW_ANALOG_VALUE;
	maxRawValue : REFERENCE TO RAW_ANALOG_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	IF __ISVALIDREF(minAnalogValue) THEN
		_MinAnalogValue REF= minAnalogValue;
	ELSE	
		_MinAnalogValue REF= _ZeroAnalogValue;
	END_IF

	IF __ISVALIDREF(maxAnalogValue) THEN
		_MaxAnalogValue REF= maxAnalogValue;
	ELSE	
		_MaxAnalogValue REF= _ZeroAnalogValue;
	END_IF
		
	IF __ISVALIDREF(minRawValue) THEN
		_MinRawValue REF= minRawValue;
	ELSE	
		_MinRawValue REF= _ZeroRawValue;
	END_IF 

	IF __ISVALIDREF(maxRawValue) THEN
		_MaxRawValue REF= maxRawValue;
	ELSE	
		_MaxRawValue REF= _ZeroRawValue;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelfSize" Id="{bf53e70a-49d1-430d-9d85-670b5bb774f5}">
      <Declaration><![CDATA[(*!
<summary>Gets the memory size of the instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{e329fbe1-fe51-40cc-af92-ad03962a1eda}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>