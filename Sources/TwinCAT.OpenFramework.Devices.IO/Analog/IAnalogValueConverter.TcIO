(*!
<summary>Contract for analog signal scaling and engineering unit conversion.</summary>
<description>
Converts raw ADC/DAC values to and from engineering unit LREAL representations.
</description>
*)

INTERFACE IAnalogValueConverter EXTENDS TOF_Core.IObject
]]></Declaration>
    <Method Name="ConvertAnalogValueToRawValue" Id="{7b9f8ba6-8d64-4125-89ee-b6b6b6ab7033}">
      <Declaration><![CDATA[(*!
<summary>Converts an engineering unit value to raw hardware representation.</summary>
<param name="analogValue">Engineering unit analog value.</param>
<param name="rawValueType">Target raw data representation.</param>
*)
METHOD ConvertAnalogValueToRawValue : RAW_ANALOG_VALUE
VAR_INPUT
	analogValue : LREAL;
	rawValueType : RAW_ANALOG_VALUE_TYPE;
END_VAR]]></Declaration>
    </Method>
    <Method Name="ConvertRawValueToAnalogValue" Id="{8ee92332-8449-42df-aea2-819ba3290c45}">
      <Declaration><![CDATA[(*!
<summary>Converts raw hardware representation to an engineering unit value.</summary>
<param name="rawValue">Raw process value union.</param>
<param name="rawValueType">Source raw data representation.</param>
*)
METHOD ConvertRawValueToAnalogValue : LREAL
VAR_INPUT
	rawValue : RAW_ANALOG_VALUE;
	rawValueType : RAW_ANALOG_VALUE_TYPE;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>