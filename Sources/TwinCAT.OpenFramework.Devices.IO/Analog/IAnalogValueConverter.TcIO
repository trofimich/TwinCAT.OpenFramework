<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IAnalogValueConverter" Id="{996c28a6-ed43-435b-bd2d-4a48e125454f}">
    <Declaration><![CDATA[(*
