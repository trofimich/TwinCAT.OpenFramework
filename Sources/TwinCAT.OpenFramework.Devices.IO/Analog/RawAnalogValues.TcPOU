(*!
<summary>Utility program providing factory methods to construct RAW_ANALOG_VALUE unions.</summary>
<description>
Ensures that unused bytes of the 4-byte union are zero-initialized when constructing from 16-bit values.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this POU directly'}
PROGRAM RawAnalogValues
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{b34f30ae-eca8-45b9-88f9-c1b0b9ee84e8}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the program.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d4a4c5c6-9279-4e80-bcb3-1ff73bc61b4c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FromInt16" Id="{32647063-a064-4305-908f-8b4e3f2aa8c3}">
      <Declaration><![CDATA[(*!
<summary>Creates a RAW_ANALOG_VALUE union from a 16-bit signed integer.</summary>
<description>Zeroes upper bytes of the 4-byte union before assigning the 16-bit value.</description>
<param name="value">16-bit signed integer value.</param>
*)
METHOD FromInt16 : RAW_ANALOG_VALUE
VAR_INPUT
	value : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromInt16.Int32 := 0;
FromInt16.Int16 := value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromInt32" Id="{ab5fb223-7868-464d-b37e-4693aa2f3aef}">
      <Declaration><![CDATA[(*!
<summary>Creates a RAW_ANALOG_VALUE union from a 32-bit signed integer.</summary>
<param name="value">32-bit signed integer value.</param>
*)
METHOD FromInt32 : RAW_ANALOG_VALUE
VAR_INPUT
	value : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromInt32.Int32 := value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FromReal32" Id="{1eb223f2-6255-44c9-83fa-26b2a8cc65a0}">
      <Declaration><![CDATA[(*!
<summary>Creates a RAW_ANALOG_VALUE union from a 32-bit single-precision float.</summary>
<param name="value">32-bit float value.</param>
*)
METHOD FromReal32 : RAW_ANALOG_VALUE
VAR_INPUT
	value : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FromReal32.Real32 := value;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{b5f61307-0199-4210-84f3-a3306f1e01dc}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace name of the program.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f506b0a8-306c-4d6b-ac5a-29b295f521d1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>