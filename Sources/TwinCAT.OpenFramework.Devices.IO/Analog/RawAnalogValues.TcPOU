<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RawAnalogValues" Id="{2cbcd7e2-bc1d-44e8-a9a9-a10af65b8b2d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
