(*!
<summary>Configuration and control contract for an analog output component.</summary>
<description>
Extends IReadOnlyAnalogOutput with hardware IO binding methods and value mutator.
</description>
*)

INTERFACE IAnalogOutput EXTENDS IReadOnlyAnalogOutput]]></Declaration>
    <Method Name="BindToInt16IO" Id="{cfafbf5a-28a4-42b6-b6c8-02961a053799}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 16-bit signed integer output process image variable '%Q*'.</summary>
<param name="rawVariable">Reference to physical INT output variable.</param>
*)
METHOD BindToInt16IO
VAR_INPUT
	rawVariable : REFERENCE TO INT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToInt32IO" Id="{7e02e96a-73e2-4dec-9e13-577ec603a62d}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 32-bit signed integer output process image variable '%Q*'.</summary>
<param name="rawVariable">Reference to physical DINT output variable.</param>
*)
METHOD BindToInt32IO
VAR_INPUT
	rawVariable : REFERENCE TO DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToReal32IO" Id="{a4b5116f-4ebc-475d-b011-1b4cb4eacbde}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 32-bit float output process image variable '%Q*'.</summary>
<param name="rawVariable">Reference to physical REAL output variable.</param>
*)
METHOD BindToReal32IO
VAR_INPUT
	rawVariable : REFERENCE TO REAL;
END_VAR]]></Declaration>
    </Method>
    <Property Name="Value" Id="{3698dd6a-f924-4203-b3de-f32a2da4dc57}">
      <Declaration><![CDATA[(*!
<summary>Gets or sets engineering unit value to output.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY Value : LREAL]]></Declaration>
      <Get Name="Get" Id="{7d8b7e41-98a0-4948-a914-df63ea484367}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
      <Set Name="Set" Id="{7c70f7ee-324f-475c-803e-937de0b7d0e0}">
        <Declaration><![CDATA[]]></Declaration>
      </Set>
    </Property>
  </Itf>
</TcPlcObject>