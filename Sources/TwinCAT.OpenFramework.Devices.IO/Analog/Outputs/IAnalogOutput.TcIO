<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IAnalogOutput" Id="{9faf0717-a113-4ecb-80ad-8a4483a7a4ab}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: Â© 2026 Oleksandr Tiutyk <trofimich@gmail.com>
