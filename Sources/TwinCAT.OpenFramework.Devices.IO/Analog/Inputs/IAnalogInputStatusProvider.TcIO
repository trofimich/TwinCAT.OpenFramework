<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IAnalogInputStatusProvider" Id="{df277cb2-906b-4ce9-a953-ac2147150ca5}">
    <Declaration><![CDATA[(*
