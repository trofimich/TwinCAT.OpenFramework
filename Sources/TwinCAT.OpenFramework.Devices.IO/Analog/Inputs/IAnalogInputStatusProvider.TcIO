(*!
<summary>Exposes the sampled analog input channel status by value.</summary>
<description>
A consumer of IReadOnlyAnalogInput can query this separate interface when the input supports snapshots.
</description>
*)
INTERFACE IAnalogInputStatusProvider EXTENDS TOF_Core.IObject]]></Declaration>
    <Property Name="StatusWord" Id="{ecf2b436-354a-4d08-9a67-352b8e16ab40}">
      <Declaration><![CDATA[(*!
<summary>Gets a copy of the channel status word sampled by ProcessInput().</summary>
<description>
Returns zero before the first sample and after processing input without a status binding. Read this value
from the input's owner task. Callers can freely modify their local copy.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY StatusWord : WORD]]></Declaration>
      <Get Name="Get" Id="{528763a1-1fd2-4c59-a1af-201e5d3ba3a0}">
        <Declaration><![CDATA[]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>
