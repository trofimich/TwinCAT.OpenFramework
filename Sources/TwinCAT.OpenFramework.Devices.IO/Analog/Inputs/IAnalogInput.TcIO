(*!
<summary>Contract for an analog input component with channel and scalar binding capabilities.</summary>
<description>
Extends IReadOnlyAnalogInput with hardware binding methods for compound Beckhoff channels
or standalone scalar input variables.
</description>
*)
INTERFACE IAnalogInput EXTENDS IReadOnlyAnalogInput
]]></Declaration>
    <Method Name="BindToInt16IO" Id="{91646975-3b96-4544-903a-5cb97daacb55}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 16-bit analog input channel process image structure.</summary>
<description>
Borrows the channel fields without modifying the process image. The caller keeps the channel alive while bound
and synchronizes rebinding with input processing. An invalid reference clears value and status bindings.
</description>
<param name="rawValues">Reference to channel process structure containing Status and INT Value.</param>
*)
METHOD BindToInt16IO
VAR_INPUT
	rawValues : REFERENCE TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToInt16Value" Id="{d490457d-1154-4800-aa0f-0848d4d7b905}">
      <Declaration><![CDATA[(*!
<summary>Binds component directly to a 16-bit signed integer raw input value.</summary>
<param name="rawValue">Reference to raw INT input variable.</param>
*)
METHOD BindToInt16Value
VAR_INPUT
	rawValue : REFERENCE TO INT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToInt32IO" Id="{8908bf9c-da75-4bc3-9b40-0b980c6b5d4a}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 32-bit analog input channel process image structure.</summary>
<param name="rawValues">Reference to channel process structure containing Status and DINT Value.</param>
*)
METHOD BindToInt32IO
VAR_INPUT
	rawValues : REFERENCE TO TOF_IOModels.ANALOG_INPUT_DINT_CHANNEL;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToInt32Value" Id="{53a160f9-69c7-4acc-9cf8-f2d5f4d77079}">
      <Declaration><![CDATA[(*!
<summary>Binds component directly to a 32-bit signed integer raw input value.</summary>
<param name="rawValue">Reference to raw DINT input variable.</param>
*)
METHOD BindToInt32Value
VAR_INPUT
	rawValue : REFERENCE TO DINT;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToReal32IO" Id="{d7bd9fce-f4ac-40a6-9d39-6d1f6f7810a1}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 32-bit float analog input channel process image structure.</summary>
<param name="rawValues">Reference to channel process structure containing Status and REAL Value.</param>
*)
METHOD BindToReal32IO
VAR_INPUT
	rawValues : REFERENCE TO TOF_IOModels.ANALOG_INPUT_REAL_CHANNEL;
END_VAR]]></Declaration>
    </Method>
    <Method Name="BindToReal32Value" Id="{bc32b8b5-245a-4da3-a75d-4e7b6f9dafe3}">
      <Declaration><![CDATA[(*!
<summary>Binds component directly to a 32-bit single-precision float raw input value.</summary>
<param name="rawValue">Reference to raw REAL input variable.</param>
*)
METHOD BindToReal32Value
VAR_INPUT
	rawValue : REFERENCE TO REAL;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>