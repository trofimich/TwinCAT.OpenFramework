(*!
<summary>Encapsulates and decodes Beckhoff 16-bit EtherCAT analog input status word.</summary>
<description>
Provides decoded boolean properties for Underrange (bit 0), Overrange (bit 1), Limit 1 (bits 2..3),
Limit 2 (bits 4..5), Error (bit 6), TxPDO State (bit 14), and TxPDO Toggle (bit 15).
</description>
*)

FUNCTION_BLOCK ANALOG_INPUT_STATUS
VAR
	_Status : WORD;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Error" Id="{7c14b191-91fd-4588-b67e-152ef5775adb}">
      <Declaration><![CDATA[(*!
<summary>Bit 6: General measurement or hardware error flag.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{7c6a5d0f-e45b-426a-96bb-16e52fdf107d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Status.6;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Overrange" Id="{1bd71454-ce03-40c9-b9ff-7f392a5a4464}">
      <Declaration><![CDATA[(*!
<summary>Bit 1: Upper limit of nominal measuring range exceeded.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Overrange : BOOL]]></Declaration>
      <Get Name="Get" Id="{a7e18e48-4c97-4fdc-b7da-4937dcd6c517}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Overrange := _Status.1;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetStatus" Id="{33141c99-8102-401e-8f13-439953bd0ad2}">
      <Declaration><![CDATA[(*!
<summary>Updates internal raw 16-bit status word.</summary>
<param name="status">Raw 16-bit EtherCAT channel status word.</param>
*)
METHOD SetStatus
VAR_INPUT
	status : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Status := status;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TxPDOState" Id="{8ba45a8e-c734-43a4-a857-140efc9a069b}">
      <Declaration><![CDATA[(*!
<summary>Bit 14: TxPDO data validity (0: valid, 1: invalid / bus error).</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL TxPDOState : BOOL]]></Declaration>
      <Get Name="Get" Id="{b587ce97-fea7-42a8-9823-497421797695}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[TxPDOState := _Status.14;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TxPDOToggle" Id="{72f1f652-ed5c-4665-987b-fec1e74f1009}">
      <Declaration><![CDATA[(*!
<summary>Bit 15: TxPDO communication toggle bit.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL TxPDOToggle : BOOL]]></Declaration>
      <Get Name="Get" Id="{ec9d41ec-d81f-418e-bbd5-1923c72e40b2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[TxPDOToggle := _Status.15;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Underrange" Id="{94d26341-48fe-4af5-9bac-ba53b413d45f}">
      <Declaration><![CDATA[(*!
<summary>Bit 0: Lower limit of calibrated measuring range fallen below.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Underrange : BOOL]]></Declaration>
      <Get Name="Get" Id="{8580446d-3b45-4524-9943-11fece3e42bd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Underrange := _Status.0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ValueBiggerOrEqualLimit1" Id="{60241d05-b62b-4928-a1b0-6d9c586e849c}">
      <Declaration><![CDATA[(*!
<summary>Bit 3: Input value is greater than or equal to Limit 1 threshold.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ValueBiggerOrEqualLimit1 : BOOL]]></Declaration>
      <Get Name="Get" Id="{02fd67d6-7b5c-447a-9326-401d4f7904e5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ValueBiggerOrEqualLimit1 := _Status.3;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ValueBiggerOrEqualLimit2" Id="{a618c40b-e461-4edf-8aa6-54c2a36a5897}">
      <Declaration><![CDATA[(*!
<summary>Bit 5: Input value is greater than or equal to Limit 2 threshold.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ValueBiggerOrEqualLimit2 : BOOL]]></Declaration>
      <Get Name="Get" Id="{5be5185a-52b7-4156-bdae-a3d42f19fb42}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ValueBiggerOrEqualLimit2 := _Status.5;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ValueSmallerOrEqualLimit1" Id="{61e2653f-d07a-4700-8180-3acc5d85f0ad}">
      <Declaration><![CDATA[(*!
<summary>Bit 2: Input value is smaller than or equal to Limit 1 threshold.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ValueSmallerOrEqualLimit1 : BOOL]]></Declaration>
      <Get Name="Get" Id="{39557e1e-71e5-4073-bb39-ce6fa6046d65}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ValueSmallerOrEqualLimit1 := _Status.2;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ValueSmallerOrEqualLimit2" Id="{cf074ec1-302e-4ddb-979a-b16864ffddab}">
      <Declaration><![CDATA[(*!
<summary>Bit 4: Input value is smaller than or equal to Limit 2 threshold.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL ValueSmallerOrEqualLimit2 : BOOL]]></Declaration>
      <Get Name="Get" Id="{91b341a6-a274-4d48-974e-10a462c05eac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ValueSmallerOrEqualLimit2 := _Status.4;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>