(*!
<summary>Analog input automation component providing scaling, status decoding and hardware binding.</summary>
<description>
Performs cyclic conversion of raw process data into engineering units. Supports optional channel status
tracking: functions normally when status is unbound, and reports channel errors when bound.
</description>
*)

FUNCTION_BLOCK AnalogInput EXTENDS TOF_Automation.InputLeafAutomationComponent IMPLEMENTS IAnalogInput
VAR_STAT
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR
VAR	
	{attribute 'hide'} 
	_RawValueType : RAW_ANALOG_VALUE_TYPE;
	
	{attribute 'hide'} 
	_Converter : IAnalogValueConverter;

	_CurrentStatus : ANALOG_INPUT_STATUS;

	_CurrentValue : LREAL;
	_PreviousValue : LREAL;

	_RawInt16Value : REFERENCE TO INT;
	_RawInt32Value : REFERENCE TO DINT;
	_RawReal32Value : REFERENCE TO REAL; 
	
	_RawStatus : REFERENCE TO WORD;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Overriden members" Id="{0e6fc4cc-41dc-4d5b-8f61-5cf6437c59da}" />
    <Folder Name="Service members" Id="{bf5932e5-8724-4b17-946f-965b2da61b5c}" />
    <Method Name="BindToInt16IO" Id="{1796bd33-dc20-4618-92cc-4e8705ae7d78}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 16-bit analog input channel process image structure.</summary>
<description>
Borrows the channel fields without modifying the process image. The caller keeps the channel alive while bound
and synchronizes rebinding with input processing. An invalid reference clears value and status bindings.
</description>
<param name="rawValues">Reference to channel process structure containing Status and INT Value.</param>
*)
METHOD BindToInt16IO
VAR_INPUT
	rawValues : REFERENCE TO TOF_IOModels.ANALOG_INPUT_INT_CHANNEL;
END_VAR
VAR
	rawValueAddress : POINTER TO INT;
	rawStatusAddress : POINTER TO WORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RawValueType := RAW_ANALOG_VALUE_TYPE.INT16;

IF __ISVALIDREF(rawValues) THEN
	// Capture addresses without classifying reference binding as a write to located input fields (SA0004).
	rawValueAddress := ADR(rawValues.Value);
	rawStatusAddress := ADR(rawValues.Status);
	_RawInt16Value REF= rawValueAddress^;
	_RawStatus REF= rawStatusAddress^;
ELSE
	_RawInt16Value REF= 0;
	_RawStatus REF= 0;
END_IF

_RawInt32Value REF= 0;
_RawReal32Value REF= 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindToInt16Value" Id="{f638e7ce-717f-477d-8cce-5109b4f55c3e}">
      <Declaration><![CDATA[(*!
<summary>Binds component directly to a 16-bit signed integer raw input value.</summary>
<param name="rawValue">Reference to raw INT input variable.</param>
*)
METHOD BindToInt16Value
VAR_INPUT
	rawValue : REFERENCE TO INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RawValueType := RAW_ANALOG_VALUE_TYPE.INT16;

_RawInt16Value REF= rawValue;
_RawInt32Value REF= 0;
_RawReal32Value REF= 0;
_RawStatus REF= 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindToInt32IO" Id="{6d7b302f-2636-4d6b-aafd-d64ed03e3e1a}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 32-bit analog input channel process image structure.</summary>
<param name="rawValues">Reference to channel process structure containing Status and DINT Value.</param>
*)
METHOD BindToInt32IO
VAR_INPUT
	rawValues : REFERENCE TO TOF_IOModels.ANALOG_INPUT_DINT_CHANNEL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RawValueType := RAW_ANALOG_VALUE_TYPE.INT32;

_RawInt16Value REF= 0;

IF __ISVALIDREF(rawValues) THEN
	_RawInt32Value REF= rawValues.Value;
	_RawStatus REF= rawValues.Status;
ELSE
	_RawInt32Value REF= 0;
	_RawStatus REF= 0;
END_IF

_RawReal32Value REF= 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindToInt32Value" Id="{a37cdad5-b1f5-4eb3-b48a-b08fa434b4ad}">
      <Declaration><![CDATA[(*!
<summary>Binds component directly to a 32-bit signed integer raw input value.</summary>
<param name="rawValue">Reference to raw DINT input variable.</param>
*)
METHOD BindToInt32Value
VAR_INPUT
	rawValue : REFERENCE TO DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RawValueType := RAW_ANALOG_VALUE_TYPE.INT32;

_RawInt16Value REF= 0;
_RawInt32Value REF= rawValue;
_RawReal32Value REF= 0;
_RawStatus REF= 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindToReal32IO" Id="{2a5af0c4-3c1a-4468-8bbb-47d3cc0a51b3}">
      <Declaration><![CDATA[(*!
<summary>Binds component to a 32-bit float analog input channel process image structure.</summary>
<param name="rawValues">Reference to channel process structure containing Status and REAL Value.</param>
*)
METHOD BindToReal32IO
VAR_INPUT
	rawValues : REFERENCE TO TOF_IOModels.ANALOG_INPUT_REAL_CHANNEL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RawValueType := RAW_ANALOG_VALUE_TYPE.REAL32;

_RawInt16Value REF= 0;
_RawInt32Value REF= 0;

IF __ISVALIDREF(rawValues) THEN
	_RawReal32Value REF= rawValues.Value;
	_RawStatus REF= rawValues.Status;
ELSE
	_RawReal32Value REF= 0;
	_RawStatus REF= 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindToReal32Value" Id="{7885d9ca-57cc-402d-a021-323f922bae32}">
      <Declaration><![CDATA[(*!
<summary>Binds component directly to a 32-bit single-precision float raw input value.</summary>
<param name="rawValue">Reference to raw REAL input variable.</param>
*)
METHOD BindToReal32Value
VAR_INPUT
	rawValue : REFERENCE TO REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RawValueType := RAW_ANALOG_VALUE_TYPE.REAL32;

_RawInt16Value REF= 0;
_RawInt32Value REF= 0;
_RawReal32Value REF= rawValue;
_RawStatus REF= 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="BoundToIO" Id="{68d39643-d345-4ffd-aba3-347061509f77}">
      <Declaration><![CDATA[(*!
<summary>Gets whether the component raw value is bound to a valid physical IO variable.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL BoundToIO : BOOL]]></Declaration>
      <Get Name="Get" Id="{f671bfa8-deb3-40db-a662-9ba3246d06ff}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CASE _RawValueType OF
	RAW_ANALOG_VALUE_TYPE.INT16:
		BoundToIO := __ISVALIDREF(_RawInt16Value);
	
	RAW_ANALOG_VALUE_TYPE.INT32:
		BoundToIO := __ISVALIDREF(_RawInt32Value);
	
	RAW_ANALOG_VALUE_TYPE.REAL32:
		BoundToIO := __ISVALIDREF(_RawReal32Value);
END_CASE]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ClassName" Id="{e2a4d305-0531-4dc9-9542-3658a5b19872}">
      <Declaration><![CDATA[(*!
<summary>Gets the class name of the component.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{af9caee4-ddd3-4939-a2d8-5bfd4ce7ebe4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Converter" Id="{29e25ba3-c9ef-48c3-9e18-28e6a9d8e6a8}">
      <Declaration><![CDATA[(*!
<summary>Gets the assigned analog value converter.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Converter : IAnalogValueConverter]]></Declaration>
      <Get Name="Get" Id="{c0a1c9c8-4deb-4e91-8709-01bb39aa4656}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Converter := _Converter;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{a9f8a040-672b-4a40-a626-054572214b6a}">
      <Declaration><![CDATA[(*!
<summary>Initializes component name, parent and converter dependency.</summary>
<param name="bInitRetains">TRUE: retain variables are initialized.</param>
<param name="bInCopyCode">TRUE: instance copied to copy code (online change).</param>
<param name="name">Component instance name.</param>
<param name="parent">Parent automation component, or zero if root node.</param>
<param name="converter">Mandatory analog value converter dependency.</param>
*)
METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	name : WSTRING;
	parent : TOF_Automation.IParentAutomationComponent;
	converter : IAnalogValueConverter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	_Converter := converter;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="getRawValueUnion" Id="{c5daed8b-935a-4ddb-8aa6-337d42a5a5f4}" FolderPath="Service members\">
      <Declaration><![CDATA[METHOD PRIVATE getRawValueUnion : RAW_ANALOG_VALUE]]></Declaration>
      <Implementation>
        <ST><![CDATA[getRawValueUnion.Int32 := 0;

CASE _RawValueType OF
	RAW_ANALOG_VALUE_TYPE.INT16:
		IF __ISVALIDREF(_RawInt16Value) THEN
			getRawValueUnion.Int16 := _RawInt16Value; 
		END_IF
	
	RAW_ANALOG_VALUE_TYPE.INT32:
		IF __ISVALIDREF(_RawInt32Value) THEN
			getRawValueUnion.Int32 := _RawInt32Value; 
		END_IF
	
	RAW_ANALOG_VALUE_TYPE.REAL32:
		IF __ISVALIDREF(_RawReal32Value) THEN
			getRawValueUnion.Real32 := _RawReal32Value; 
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{93e2582c-007c-4139-bb5b-fd7ff4a69e7f}">
      <Declaration><![CDATA[(*!
<summary>Gets the namespace name of the component.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d61aa72e-f2ca-4417-8a73-2242f7fc129d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnInitializing" Id="{670b4810-54a7-448d-88ce-075759bcc081}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Validates that mandatory converter dependency is configured.</summary>
*)
METHOD PROTECTED OnInitializing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Converter = 0 THEN
	TOF_Core.Exceptions.ThrowClassInitialization(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		errorMessage := "converter not specified"
	);
END_IF

OnInitializing := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnProcessInput" Id="{d00fb5f9-23cb-41c5-931f-ed22dd46f4e9}" FolderPath="Overriden members\">
      <Declaration><![CDATA[(*!
<summary>Reads raw ADC data, updates status if bound, and scales into engineering units.</summary>
*)
METHOD PROTECTED OnProcessInput]]></Declaration>
      <Implementation>
        <ST><![CDATA[_PreviousValue := _CurrentValue;

IF __ISVALIDREF(_RawStatus) THEN
	_CurrentStatus.SetStatus(status := _RawStatus);

	IF _CurrentStatus.Error THEN
		IF NOT HasError THEN
			_Error.SetSource(
				sourceNamespaceName := NamespaceName,
				sourceClassName := ClassName,
				sourcePOUName := __POUNAME()
			);
			_Error.SetSeverity(severity := TOF_Core.ERROR_SEVERITY.ERROR);
			_Error.SetMessage(message := "Analog input channel reports error");
		END_IF
	ELSIF HasError AND_THEN _Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR THEN
		_Error.Clear();
	END_IF
ELSE
	_CurrentStatus.SetStatus(status := 0);

	IF HasError AND_THEN _Error.Severity = TOF_Core.ERROR_SEVERITY.ERROR THEN
		_Error.Clear();
	END_IF
END_IF

_CurrentValue := _Converter.ConvertRawValueToAnalogValue(
	rawValue := getRawValueUnion(),
	rawValueType := _RawValueType
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="RawValue" Id="{f2f3b0ca-2065-4d92-b7dc-f0ed49f1a81e}">
      <Declaration><![CDATA[(*!
<summary>Gets current raw hardware ADC value cast to LREAL.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL RawValue : LREAL]]></Declaration>
      <Get Name="Get" Id="{953f8282-c35f-4a66-b11d-50084a951979}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CASE _RawValueType OF
	RAW_ANALOG_VALUE_TYPE.INT16:
		RawValue := SEL(__ISVALIDREF(_RawInt16Value), 0, TO_LREAL(_RawInt16Value));
	
	RAW_ANALOG_VALUE_TYPE.INT32:
		RawValue := SEL(__ISVALIDREF(_RawInt32Value), 0, TO_LREAL(_RawInt32Value));
	
	RAW_ANALOG_VALUE_TYPE.REAL32:
		RawValue := SEL(__ISVALIDREF(_RawReal32Value), 0, TO_LREAL(_RawReal32Value));
END_CASE]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RawValueType" Id="{693dcc6c-e6f9-4787-abf2-2b262882edb0}">
      <Declaration><![CDATA[(*!
<summary>Gets the raw analog data representation type.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL RawValueType : RAW_ANALOG_VALUE_TYPE]]></Declaration>
      <Get Name="Get" Id="{68967b90-584b-4fac-b444-e16d5552412d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RawValueType := _RawValueType;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{f41fe795-6269-415f-84e0-21e0f708ca3c}">
      <Declaration><![CDATA[(*!
<summary>Gets the memory size of the instance.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d50f06ea-53dd-48a0-94e9-7788d3c6014a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Status" Id="{8dee4244-1695-4a0e-80f3-405b88b016b6}">
      <Declaration><![CDATA[(*!
<summary>Gets reference to the decoded channel status object.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Status : REFERENCE TO ANALOG_INPUT_STATUS]]></Declaration>
      <Get Name="Get" Id="{77fdc709-09f5-4c73-8b5c-68e70c584a44}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Status REF= _CurrentStatus;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Value" Id="{bff835a2-8bf3-4c77-a0ff-361609610603}">
      <Declaration><![CDATA[(*!
<summary>Gets current scaled engineering unit value.</summary>
*)
{attribute 'monitoring' := 'call'}
PROPERTY FINAL Value : LREAL]]></Declaration>
      <Get Name="Get" Id="{8f9bfa97-e392-4cb7-9ce6-53fc7fd6a0c9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Value := _CurrentValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>