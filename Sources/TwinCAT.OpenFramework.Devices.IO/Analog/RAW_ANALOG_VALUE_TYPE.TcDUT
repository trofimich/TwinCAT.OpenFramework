(*!
<summary>Identifies underlying data type of a raw ADC or DAC analog signal.</summary>
<description>
Specifies whether the raw process data is interpreted as signed 16-bit integer, signed 32-bit integer,
or 32-bit single-precision floating point.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE RAW_ANALOG_VALUE_TYPE :
(
	INT16,
	INT32,
	REAL32 
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>