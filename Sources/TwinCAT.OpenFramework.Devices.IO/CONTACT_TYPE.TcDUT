(*!
<summary>Defines electrical contact type for digital input and output signals.</summary>
<description>
Determines whether the physical signal state is inverted when mapped to the logical component Value.
NORMALLY_OPEN: logical TRUE matches physical TRUE.
NORMALLY_CLOSED: logical TRUE matches physical FALSE (inverted).
NORMALY_OPEN / NORMALY_CLOSED are retained for backward compatibility.
</description>
*)

{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE CONTACT_TYPE :
(
	NORMALLY_OPEN := 0,
	NORMALLY_CLOSED := 1,
	NORMALY_OPEN := 0,
	NORMALY_CLOSED := 1
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>