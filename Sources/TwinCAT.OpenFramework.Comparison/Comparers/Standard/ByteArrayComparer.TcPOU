<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteArrayComparer" Id="{2bb53bb7-7d07-4a7a-896e-016e853fd868}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Orders generic storage lexicographically by bytes and then by size.</summary>
<description>
Non-null addresses must reference readable storage of the declared Size.
Two null addresses compare equal; one null address sorts before a non-null address.
Compares the common byte prefix, then Size.
TypeClass does not alter this byte order: string terminators, trailing storage, padding and pointer
fields all participate.
Use StringComparer or WStringComparer for terminated-text ordering.
OBJECT payload is compared as bytes without invoking object methods; padding and pointer fields
participate.
Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or
retained.
IsMemoryOwner does not affect comparison.
</description>
*)
FUNCTION_BLOCK ByteArrayComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{cf39d53b-ed13-4edf-ad55-696c13de665b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{d30e6779-120e-49c2-abe1-17cbfac7965e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{ee7448b3-b623-4697-a6c8-19f6c43d07cb}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>
Non-null addresses must reference readable storage of the declared Size.
Two null addresses compare equal; one null address sorts before a non-null address.
Compares the common byte prefix, then Size.
TypeClass does not alter this byte order: string terminators, trailing storage, padding and pointer
fields all participate.
Use StringComparer or WStringComparer for terminated-text ordering.
OBJECT payload is compared as bytes without invoking object methods; padding and pointer fields
participate.
Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or
retained.
IsMemoryOwner does not affect comparison.
 Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO BYTE;
	rightPointer : POINTER TO BYTE;

	i : ULINT;
	minSize : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;
END_IF

minSize := MIN(first.Size, second.Size);

i := 0;
WHILE i < minSize DO
	leftPointer := first.Address + TO_LWORD(i);
	rightPointer := second.Address + TO_LWORD(i);

	IF leftPointer^ < rightPointer^ THEN
		Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
		RETURN;
	ELSIF leftPointer^ > rightPointer^ THEN
		Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
		RETURN;
	END_IF
	i := i + 1;
END_WHILE

IF first.Size < second.Size THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF first.Size > second.Size THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{9a7e1f84-1d7c-4766-b019-8e9775b5d9ca}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f3eef584-0d20-4a97-ba32-a95b52b6625c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{b1a1240f-8b51-48b9-84a3-3c39c9b5cd85}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{7cf65b52-2f9d-4aa5-9cb0-fb0f5d03a50d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>