<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DIntComparer" Id="{6f6b1783-035a-40b4-89b5-ac160a1b0827}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Orders DINT values described by generic descriptors.</summary>
<description>Non-null addresses must reference live DINT storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison.</description>
*)
FUNCTION_BLOCK DIntComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{374b5435-53bc-4932-b70b-38e881e1c6f7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{76a590ec-af1b-483e-a8e3-daa180c051d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{e1909f95-e808-4498-bb7a-487375d54fdf}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>Non-null addresses must reference live DINT storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison. Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO DINT; 
	rightPointer : POINTER TO DINT; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;	
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;	
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

IF leftPointer^ < rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF leftPointer^ > rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{3fd75425-ec06-4e95-8fa1-e93060f4010f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9cce7960-fe94-43c2-9775-c086106e55fd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{7aa892e9-fb1c-43be-8e33-e9a228036eb9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{d955a826-e34a-46a4-acba-ba5125a28ed7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>