<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ObjectComparer" Id="{9bc01bd8-4f18-41e9-ba92-4f732a0c9b24}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Orders objects through their natural IComparable contract.</summary>
<description>
Non-null descriptors must refer directly to live Object instances, not pointer or interface
variables.
TypeClass and Size are not validated.
Two null addresses compare equal; one null address sorts before a non-null address.
For two non-null operands, both objects must implement IComparable; otherwise NotSupportedException
is raised.
The first object defines compatible counterpart types through CompareTo and must reject unsupported
types.
Callback exceptions propagate without fallback.
No byte or address ordering is used for non-null objects.
Descriptors, objects and interfaces are borrowed only for the call; no payload is modified, cloned,
released or retained.
IsMemoryOwner does not affect comparison.
Equality/hash-based collection lookup does not require this ordering strategy.
</description>
*)

FUNCTION_BLOCK ObjectComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{ed351bfe-f719-420f-b1a7-30ff2202ec1d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4f65975b-a436-4c94-966a-720ac3fc1634}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{a98fd256-691a-44e3-a84d-7ba75aa18eff}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>
Non-null descriptors must refer directly to live Object instances, not pointer or interface
variables.
TypeClass and Size are not validated.
Two null addresses compare equal; one null address sorts before a non-null address.
For two non-null operands, both objects must implement IComparable; otherwise NotSupportedException
is raised.
The first object defines compatible counterpart types through CompareTo and must reject unsupported
types.
Callback exceptions propagate without fallback.
No byte or address ordering is used for non-null objects.
Descriptors, objects and interfaces are borrowed only for the call; no payload is modified, cloned,
released or retained.
IsMemoryOwner does not affect comparison.
Equality/hash-based collection lookup does not require this ordering strategy.
 Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO TOF_Core.Object;
	rightPointer : POINTER TO TOF_Core.Object;

	leftComparable : TOF_Core.IComparable;
	rightComparable : TOF_Core.IComparable;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;	
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;	
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

IF NOT __QUERYINTERFACE(leftPointer^, leftComparable)
	OR_ELSE NOT __QUERYINTERFACE(rightPointer^, rightComparable)
THEN
	TOF_Core.Exceptions.ThrowNotSupported(NamespaceName, ClassName, __POUNAME(), __POSITION(), "Natural object ordering requires IComparable on both operands.");
END_IF

Compare := leftComparable.CompareTo(rightComparable);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{2aa2f48d-4ff6-45d8-97ef-b77829c956b2}">
      <Declaration><![CDATA[(*!
<summary>Returns the library namespace name.</summary>
<description>
The returned reference is borrowed and read-only; its storage belongs to CurrentNamespace.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{437966a0-284d-465f-8bc1-1509ce48e6ea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{2c288733-0ba3-482e-9700-31c10a3731d9}">
      <Declaration><![CDATA[(*!
<summary>Reports the size of this comparer instance in bytes.</summary>
<description>
Includes the inherited Object state and this concrete instance's fields.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{4dfe5d56-cfcf-408b-a042-3ab4c4da2cba}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>