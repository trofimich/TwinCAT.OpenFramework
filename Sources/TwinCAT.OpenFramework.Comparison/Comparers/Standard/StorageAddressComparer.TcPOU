(*!
<summary>Orders the storage addresses carried by generic descriptors.</summary>
<description>Compares Address numerically without dereferencing it. TypeClass, Size and stored pointer values do not participate. This is an address order, not a natural object or payload order; relocation can change the result. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison.</description>
*)

FUNCTION_BLOCK StorageAddressComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{4443a984-857a-4d34-837f-6e53c40830e5}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{55a5042e-bd12-42b3-b093-7992913f0145}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{1dd4a357-57a9-4625-a7f6-5765a5b178a3}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>Compares Address numerically without dereferencing it. TypeClass, Size and stored pointer values do not participate. This is an address order, not a natural object or payload order; relocation can change the result. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison. Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address < second.Address THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF first.Address > second.Address THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{ed1c5593-0e98-4725-8450-ab86c0b2be9c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{f8221be0-963d-4b71-bc79-268f5d736232}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{0af2190f-35da-4e61-91d2-ccf31be2c3e2}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{a88328d5-6e97-456d-934f-346a18c2fbc5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>