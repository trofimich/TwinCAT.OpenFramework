(*!
<summary>Orders LINT values described by generic descriptors.</summary>
<description>Non-null addresses must reference live LINT storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison.</description>
*)

FUNCTION_BLOCK LIntComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{11696811-cbc8-4330-9b9c-34480612a1fd}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9443910c-a564-4f25-a954-0af25c296bce}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{16519cb2-8b2a-4d05-af51-ba14c0acf190}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>Non-null addresses must reference live LINT storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison. Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO LINT; 
	rightPointer : POINTER TO LINT; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;	
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;	
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

IF leftPointer^ < rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF leftPointer^ > rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{08b866a6-e0c1-4fc7-9eca-ea0da6a53d8a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{8bc84db1-d75e-4bbf-af7b-e6873dc30080}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{c25e4d6f-9f0f-4471-9ede-a23224e4040d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{00ea876a-2583-4961-990c-bcb33b2f9770}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>