<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StringComparer" Id="{9c726fdf-1a4d-44c3-a694-6fa04383a38b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Orders STRING(255) values described by generic descriptors.</summary>
<description>Non-null addresses must reference live STRING(255) storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Uses native string comparison through the declared 255-character pointer type; descriptor Size does not bound the read. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison.</description>
*)
FUNCTION_BLOCK StringComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{fe4bc3f2-32a0-40a1-b3b3-dea685049247}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{644dc216-bca1-4e72-ba6f-f860843a5ed1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{0d7b1d55-90a3-4d2d-a335-a5955388a84e}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>Non-null addresses must reference live STRING(255) storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Uses native string comparison through the declared 255-character pointer type; descriptor Size does not bound the read. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison. Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO STRING(255); 
	rightPointer : POINTER TO STRING(255); 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;	
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;	
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

IF leftPointer^ < rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF leftPointer^ > rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{07d1b6fc-9f67-4283-8ebe-80a061b4d741}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{596d2322-a3da-44ef-9d5d-7489c2428071}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{1f2fded0-3ac6-4c18-9f57-98f21354ea79}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{b04e68a1-5183-4935-b706-016997de511e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>