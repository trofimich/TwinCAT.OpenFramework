(*!
<summary>Orders REAL values described by generic descriptors.</summary>
<description>
Non-null addresses must reference live REAL storage.
TypeClass and Size are not validated and no numeric conversion is performed.
Two null addresses compare equal; one null address sorts before a non-null address.
All NaNs compare equal and sort before every number, including negative infinity.
Raw IEEE 754 bits classify NaN before floating-point comparisons.
Remaining values use numeric order; positive and negative zero compare equal.
Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or
retained.
IsMemoryOwner does not affect comparison.
</description>
*)
FUNCTION_BLOCK RealComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{9497660a-7202-4724-9d28-f79cc768c315}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{30daed44-76f5-418f-b8fa-9e65b2895bb4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{ac2db5ce-241e-4ea0-aeb9-5f0871372dcb}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>
Non-null addresses must reference live REAL storage.
TypeClass and Size are not validated and no numeric conversion is performed.
Two null addresses compare equal; one null address sorts before a non-null address.
All NaNs compare equal and sort before every number, including negative infinity.
Raw IEEE 754 bits classify NaN before floating-point comparisons.
Remaining values use numeric order; positive and negative zero compare equal.
Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or
retained.
IsMemoryOwner does not affect comparison.
 Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO TOF_Core.REAL_UNION;
	rightPointer : POINTER TO TOF_Core.REAL_UNION;

	leftIsNaN : BOOL;
	rightIsNaN : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

leftIsNaN := (leftPointer^.Raw AND TOF_Core.Reals.EXPONENT_MASK) = TOF_Core.Reals.EXPONENT_MASK
	AND (leftPointer^.Raw AND TOF_Core.Reals.FRACTION_MASK) <> TOF_Core.UnsignedInt32.MIN_VALUE;
rightIsNaN := (rightPointer^.Raw AND TOF_Core.Reals.EXPONENT_MASK) = TOF_Core.Reals.EXPONENT_MASK
	AND (rightPointer^.Raw AND TOF_Core.Reals.FRACTION_MASK) <> TOF_Core.UnsignedInt32.MIN_VALUE;

IF leftIsNaN THEN
	IF rightIsNaN THEN
		Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	ELSE
		Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	END_IF
	RETURN;
END_IF

IF rightIsNaN THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;
END_IF

IF leftPointer^.Value < rightPointer^.Value THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF leftPointer^.Value > rightPointer^.Value THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{5fc9ac75-1057-419a-8c26-7c0e84fe05e9}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{41763fe9-be15-489e-ab73-1fe84fff559e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{625f2423-8de2-4d29-b598-4e405565f3af}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{43fa830c-884a-45ff-aab6-6eaddf85f4d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>