<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LRealComparer" Id="{f4e21534-0e97-4f45-9e9f-9fc5128a94f9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
