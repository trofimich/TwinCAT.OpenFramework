(*!
<summary>Orders LREAL values described by generic descriptors.</summary>
<description>
Non-null addresses must reference live LREAL storage.
TypeClass and Size are not validated and no numeric conversion is performed.
Two null addresses compare equal; one null address sorts before a non-null address.
All NaNs compare equal and sort before every number, including negative infinity.
Raw IEEE 754 bits classify NaN before floating-point comparisons.
Remaining values use numeric order; positive and negative zero compare equal.
Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or
retained.
IsMemoryOwner does not affect comparison.
</description>
*)

FUNCTION_BLOCK LRealComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{c7b91571-bf88-48e0-bcfa-79b7189f7876}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{07b7f3e7-f1b8-4851-80cc-39e5356991ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{4c67832f-1632-413f-a01f-80ee0feddaaa}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>
Non-null addresses must reference live LREAL storage.
TypeClass and Size are not validated and no numeric conversion is performed.
Two null addresses compare equal; one null address sorts before a non-null address.
All NaNs compare equal and sort before every number, including negative infinity.
Raw IEEE 754 bits classify NaN before floating-point comparisons.
Remaining values use numeric order; positive and negative zero compare equal.
Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or
retained.
IsMemoryOwner does not affect comparison.
 Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO TOF_Core.LREAL_UNION;
	rightPointer : POINTER TO TOF_Core.LREAL_UNION;

	leftIsNaN : BOOL;
	rightIsNaN : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

leftIsNaN := (leftPointer^.Raw AND TOF_Core.LongReals.EXPONENT_MASK) = TOF_Core.LongReals.EXPONENT_MASK
	AND (leftPointer^.Raw AND TOF_Core.LongReals.FRACTION_MASK) <> TOF_Core.UnsignedInt64.MIN_VALUE;
rightIsNaN := (rightPointer^.Raw AND TOF_Core.LongReals.EXPONENT_MASK) = TOF_Core.LongReals.EXPONENT_MASK
	AND (rightPointer^.Raw AND TOF_Core.LongReals.FRACTION_MASK) <> TOF_Core.UnsignedInt64.MIN_VALUE;

IF leftIsNaN THEN
	IF rightIsNaN THEN
		Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	ELSE
		Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	END_IF
	RETURN;
END_IF

IF rightIsNaN THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;
END_IF

IF leftPointer^.Value < rightPointer^.Value THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF leftPointer^.Value > rightPointer^.Value THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{7d021b4c-48f3-451e-9acf-a79b40f33fc3}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{3d9f8b41-6f16-4baa-bb99-51498652d57b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{d9d53921-7b08-48ef-888d-d76d25d2b4e7}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{c2f8c3a5-7acc-4512-ad96-cf0a19ce7b60}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>