(*!
<summary>Orders LDATE_AND_TIME values described by generic descriptors.</summary>
<description>Non-null addresses must reference live LDATE_AND_TIME storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison.</description>
*)

FUNCTION_BLOCK LDateAndTimeComparer EXTENDS TOF_Core.Object IMPLEMENTS TOF_Core.IComparer
VAR
	{attribute 'hide'} 
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{6a172a3e-6ac1-4314-af2e-4424d3c35c1b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b4eba27d-4bc5-4c2e-b8a0-5d518f0c785f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Compare" Id="{e7e5d810-46d5-4fcb-94f6-62ec678dbe03}">
      <Declaration><![CDATA[(*!
<summary>Compares the first operand with the second using this ordering strategy.</summary>
<description>Non-null addresses must reference live LDATE_AND_TIME storage. TypeClass and Size are not validated and no numeric conversion is performed. Two null addresses compare equal; one null address sorts before a non-null address. Descriptors are passed by value; payload remains borrowed and is not modified, cloned, released or retained. IsMemoryOwner does not affect comparison. Descendants cannot replace this standard ordering; implement IComparer separately for a different ordering strategy.</description>
*)
//!<param name="first">First descriptor; referenced storage is borrowed for the call.</param>
//!<param name="second">Second descriptor; referenced storage is borrowed for the call.</param>
{attribute "object_name" := "Compare"}
METHOD FINAL Compare : TOF_Core.COMPARISON_RESULT
VAR_INPUT
	first : TOF_Core.GENERIC_VALUE;
	second : TOF_Core.GENERIC_VALUE;
END_VAR
VAR
	leftPointer : POINTER TO LDATE_AND_TIME; 
	rightPointer : POINTER TO LDATE_AND_TIME; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF first.Address = 0 AND_THEN second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;
	RETURN;
END_IF

IF first.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
	RETURN;	
END_IF

IF second.Address = 0 THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
	RETURN;	
END_IF

leftPointer := first.Address;
rightPointer := second.Address;

IF leftPointer^ < rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_LESS_THAN_SECOND;
ELSIF leftPointer^ > rightPointer^ THEN
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_GREATER_THAN_SECOND;
ELSE
	Compare := TOF_Core.COMPARISON_RESULT.FIRST_EQUAL_TO_SECOND;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{91e1ec84-f31b-48f5-bc7f-f80fa042348b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{bf4f6d30-1d31-4f2d-b984-bcca3a393db4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{882030fc-f4fd-46cb-a838-4aecc885012e}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{27df7169-6dfa-499a-aa6f-6fbe36a27ad8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>