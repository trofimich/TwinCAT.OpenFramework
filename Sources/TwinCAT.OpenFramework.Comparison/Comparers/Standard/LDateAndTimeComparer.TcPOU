<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LDateAndTimeComparer" Id="{7fd75ce0-7a6c-46e2-a88f-f44cb5458480}" SpecialFunc="None">
    <Declaration><![CDATA[(*
