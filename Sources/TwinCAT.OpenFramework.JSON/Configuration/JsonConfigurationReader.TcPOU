<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="JsonConfigurationReader" Id="{236a8e5c-23da-49c0-8af5-0fa696e16ceb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
