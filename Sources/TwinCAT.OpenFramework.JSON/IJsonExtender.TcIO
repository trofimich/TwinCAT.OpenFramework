<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="IJsonExtender" Id="{4855e1bf-29d3-434d-ad18-57cfe564a05a}">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Extends serialization by writing around the structure's JSON value.</summary>
<description>
AutomaticJsonSerializer calls these hooks synchronously on its own SAX writer. The writer belongs to the
serializer; callbacks do not acquire ownership. The combined hook output and structure value must form
the intended JSON document. The writer is borrowed only for the duration of each callback and must not be
retained or handed to another task. Hooks execute in the serializer's owner task. Do not call methods or
access properties of the active serializer, directly or indirectly; a nested conversion needs a separate
serializer and separate buffers. Stateful extenders must not be used concurrently by different tasks.
Implementations handle failures reported by the native methods they invoke.
Callback exceptions propagate from Create methods and are contained by TryCreate methods; prior writes
and external callback effects are not rolled back. ExtendAtFinish is not a cleanup or finally callback.
</description>
*)
INTERFACE IJsonExtender]]></Declaration>
    <Method Name="ExtendAtFinish" Id="{3bd84534-1712-40b5-9503-1fc6ee164105}">
      <Declaration><![CDATA[(*!
<summary>Writes the suffix after successful serialization of the structure value.</summary>
<description>Called before copying the document to the caller's buffer. May finish a container opened by
ExtendAtStart. It is skipped if the start hook or structure serialization fails; later copy failure
does not roll back its effects.</description>
<param name="jsonSaxWriter">Serializer-owned writer containing the prefix and structure value.</param>
*)
METHOD ExtendAtFinish
VAR_IN_OUT CONSTANT
	jsonSaxWriter : Tc3_JsonXml.FB_JsonSaxWriter;	
END_VAR]]></Declaration>
    </Method>
    <Method Name="ExtendAtStart" Id="{9509cef5-06c5-4632-a66c-dbe1c085047e}">
      <Declaration><![CDATA[(*!
<summary>Writes the prefix before serialization of the structure value.</summary>
<description>Called after ResetDocument, before AddJsonValueFromSymbol. Leave the writer ready to receive
the structure as a JSON value, for example after an enclosing container's key. A later failure does not
guarantee an ExtendAtFinish call or roll back callback effects.</description>
<param name="jsonSaxWriter">Serializer-owned writer reset for the current conversion.</param>
*)
METHOD ExtendAtStart
VAR_IN_OUT CONSTANT
	jsonSaxWriter : Tc3_JsonXml.FB_JsonSaxWriter;	
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>