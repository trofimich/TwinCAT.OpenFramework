(*!
<summary>Holds namespace text initialized through the init_namespace attribute.</summary>
<description>The compiler supplies the initial text; this block performs no runtime extraction or allocation.
The owning CurrentNamespace program exposes the stored text as borrowed metadata.</description>
*)
FUNCTION_BLOCK INTERNAL NamespaceExtractor
VAR_OUTPUT
	//! <summary>Compiler-initialized namespace storage; consumers must not modify it.</summary>
	{attribute 'init_namespace'} 
	CurrentNamespace : STRING; 	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>