(*
Maps Core configuration value types and byte sizes to Tc3_JsonXml symbol datatype names.

Delegates byte-size validation to TOF_Core.ConfigurationValueTypes.IsValidSize before constructing the native
datatype string for FB_JsonReadWriteDatatype. Uses TwinCAT symbol datatype names for time-of-day and datetime values.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM INTERNAL JsonDatatypes
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{768baa66-e94b-4aae-8652-043567335253}">
      <Declaration><![CDATA[(* Returns the program class name for diagnostic reporting. *)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{c28f7123-fd38-4f36-be52-e7816bcbf286}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{dfd2b351-f60b-4e0e-a7d6-d9fc52d83078}">
      <Declaration><![CDATA[(* Returns the library namespace name for diagnostic reporting. *)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2daddb85-f9f3-4d9b-b8d7-830cfe83b76c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToDatatypeName" Id="{abf83bc4-46b7-43be-a406-0167b4772cad}">
      <Declaration><![CDATA[(*
Maps a CONFIGURATION_VALUE_TYPE and buffer byte size to a Tc3_JsonXml symbol datatype name.

Validates size via TOF_Core.ConfigurationValueTypes.IsValidSize. Returns an empty string when the type or size
is invalid; no exception is raised. Uses the names emitted in TwinCAT symbol metadata for time-of-day and datetime.

valueType — Elementary configuration value type.
size — Buffer size in bytes.
*)
METHOD ToDatatypeName : STRING
VAR_INPUT
	valueType : TOF_Core.CONFIGURATION_VALUE_TYPE;
	size : UDINT;
END_VAR
VAR
	capacity : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT TOF_Core.ConfigurationValueTypes.IsValidSize(valueType := valueType, size := size) THEN
	RETURN;
END_IF

CASE valueType OF
	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BOOL:
		ToDatatypeName := 'BOOL';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_BYTE:
		ToDatatypeName := 'BYTE';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WORD:
		ToDatatypeName := 'WORD';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DWORD:
		ToDatatypeName := 'DWORD';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LWORD:
		ToDatatypeName := 'LWORD';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_SINT:
		ToDatatypeName := 'SINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_INT:
		ToDatatypeName := 'INT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT:
		ToDatatypeName := 'DINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LINT:
		ToDatatypeName := 'LINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_USINT:
		ToDatatypeName := 'USINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UINT:
		ToDatatypeName := 'UINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_UDINT:
		ToDatatypeName := 'UDINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_ULINT:
		ToDatatypeName := 'ULINT';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_REAL:
		ToDatatypeName := 'REAL';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LREAL:
		ToDatatypeName := 'LREAL';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TIME:
		ToDatatypeName := 'TIME';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTIME:
		ToDatatypeName := 'LTIME';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DATE:
		ToDatatypeName := 'DATE';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDATE:
		ToDatatypeName := 'LDATE';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_TOD:
		ToDatatypeName := 'TIME_OF_DAY';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LTOD:
		ToDatatypeName := 'LTIME_OF_DAY';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DT:
		ToDatatypeName := 'DATE_AND_TIME';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_LDT:
		ToDatatypeName := 'LDATE_AND_TIME';

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_STRING:
		capacity := size - 1;
		ToDatatypeName := TOF_Core.Strings.Concat255('STRING(', TO_STRING(capacity), ')');

	TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_WSTRING:
		capacity := (size / 2) - 1;
		ToDatatypeName := TOF_Core.Strings.Concat255('WSTRING(', TO_STRING(capacity), ')');
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

