<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="JsonDatatypes" Id="{74b8f395-1030-4baf-a2c2-e52a51b8fa48}" SpecialFunc="None">
    <Declaration><![CDATA[(*
