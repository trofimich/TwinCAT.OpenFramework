<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CurrentNamespace" Id="{854fbc94-0db6-49d9-8a60-90c06f0f7dd9}" SpecialFunc="None">
    <Declaration><![CDATA[(*
