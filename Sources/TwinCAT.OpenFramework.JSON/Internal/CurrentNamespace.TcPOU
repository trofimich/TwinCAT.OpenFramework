SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

{attribute 'no_explicit_call' := 'do not call this POU directly'}
(*!
<summary>Provides this library's namespace text to object metadata getters.</summary>
<description>Owns the namespace extractor for the program instance's lifetime; no cyclic execution is required.</description>
*)
PROGRAM INTERNAL CurrentNamespace
VAR
	{attribute 'hide'} 
	_NamespaceExtractor : NamespaceExtractor;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Name" Id="{6b1c9bdb-8aa7-4256-9b24-56ad206a67aa}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*!
<summary>Returns a borrowed reference to the stored namespace text.</summary>
<description>The reference belongs to this program instance and remains valid while it exists.
Callers must treat the text as read-only; reading does not copy or allocate storage.</description>
*)
PROPERTY Name : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{b68ad8ff-4ba6-4dc6-8546-24d751d26175}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name REF= _NamespaceExtractor.CurrentNamespace;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>