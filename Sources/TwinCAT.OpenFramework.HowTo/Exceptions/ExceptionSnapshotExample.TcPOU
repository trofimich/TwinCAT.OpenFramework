(*!
<summary>Catches a framework exception and copies its diagnostic into an ERROR snapshot.</summary>
<description>
Write _RunRequested once. The sample deliberately raises a standard exception, captures it in the same scan,
and keeps the copied diagnostic after transient exception cleanup. Watch _Error.TopMessage.
Map this program to one dedicated cyclic task. The program performs cleanup for that task.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM ExceptionSnapshotExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
	_RunRequested : BOOL;
	_Error : TOF_Core.ERROR;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _RunRequested THEN
	_RunRequested := FALSE;
	captureExampleError();
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
TOF_Core.DynamicMemoryManager.CleanupMemory();]]></ST>
    </Implementation>
    <Method Name="captureExampleError" Id="{4294fd11-78cb-4baa-9406-6a6a107d1559}">
      <Declaration><![CDATA[//! <summary>Copies the demonstration failure before the task cleans up the exception.</summary>
METHOD PRIVATE captureExampleError
VAR
	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Error.Clear();

__TRY
	TOF_Core.Exceptions.ThrowStandard(
		sourceNamespaceName := NamespaceName,
		sourceClassName := ClassName,
		sourcePOUName := __POUNAME(),
		sourcePosition := __POSITION(),
		message := "Example operation failed"
	);
__CATCH(exceptionCode)
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught.ToError(targetError := _Error, severity := TOF_Core.ERROR_SEVERITY.ERROR);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{afed3e86-f5e7-41a5-925e-7ec67182d41e}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized program name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e49c0505-45bb-4fdd-aad6-9f2b8fc427ac}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{337e7e3f-18e7-4454-aaff-7329285bb44e}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized namespace name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fba8a079-ae65-424d-894c-451cd5143b84}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
