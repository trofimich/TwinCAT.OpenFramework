<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="BuildDiagnosticMessageExample" Id="{f621db74-40ed-41a1-baf1-21266d9b67ff}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Builds a station status message from several text fragments.

Change _StationName, _StationNumber or _StatusText in Watch. Both messages update on the next scan.
Each result holds up to 255 bytes. If the combined text exceeds that capacity, _Message is cut at the
limit and _MessageWithEllipsis ends in '...'. Use ASCII input to make the cut easy to see in Watch.
Map this program to a dedicated cyclic task.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM BuildDiagnosticMessageExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();

	_StationName : STRING(255) := 'Station';
	_StationNumber : UINT := 3;
	_StatusText : STRING(255) := 'Waiting for part';
	_Message : STRING(255);
	_MessageWithEllipsis : STRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_Message := TOF_Core.Strings.Concat255(_StationName, ' ', TO_STRING(_StationNumber), ': ', _StatusText);
_MessageWithEllipsis := TOF_Core.Strings.ConcatFit255(_StationName, ' ', TO_STRING(_StationNumber), ': ', _StatusText);

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{58811e82-0306-4b7c-9ac1-709b12eadca1}">
      <Declaration><![CDATA[// Borrows the initialized program name. Treat it as read-only.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{2f74f5e1-756b-4feb-acb4-480deee6e26a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{5c32974e-4320-4a78-9075-46d60cfa8d7b}">
      <Declaration><![CDATA[// Borrows the initialized namespace name. Treat it as read-only.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e476a8e5-0e68-4471-802e-4145c9d2f673}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>