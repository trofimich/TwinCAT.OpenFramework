(*!
<summary>Reads a fixed-capacity list whose entries borrow live PLC values.</summary>
<description>
Edit _SourceValue in Watch. The list stores one descriptor for that variable and _Value follows subsequent edits.
The persistent source must outlive the list's use of the entry. No payload ownership is transferred.
Map this program to one dedicated cyclic task. The program performs cleanup for that task.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM BorrowedListExample
VAR
	_ClassName : STRING := __POUNAME();
	_List : TOF_Collections.List<3>(valueValidator := 0);
	_SourceValue : INT := 42;
	_Value : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _List.Empty THEN
	_List.AppendGeneric(value := TOF_Core.GenericValueFactory.FromIntReference(value := _SourceValue));
END_IF

_Value := _List.Get(index := 0).AsInt();

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
TOF_Core.DynamicMemoryManager.CleanupMemory();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{7bd129b2-3ed5-42ac-ac8b-5f5ed325e353}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized program name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{9cef1d48-4e7c-4a91-a336-fd027e4531b6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{2e4901ec-414a-4385-b751-4b67d97dfbd5}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized namespace name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{73293a31-2884-40de-b37d-66ea963eae41}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
