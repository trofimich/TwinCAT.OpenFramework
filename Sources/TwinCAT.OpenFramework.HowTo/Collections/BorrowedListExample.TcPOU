<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="BorrowedListExample" Id="{e35842cc-8f85-485d-b26c-0f85ad126b3d}" SpecialFunc="None">
    <Declaration><![CDATA[(*
