<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CheckDirectoryExample" Id="{ce93ccee-4532-442c-b35a-be2da83ffb1c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
