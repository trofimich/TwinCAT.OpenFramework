(*!
<summary>Checks a configured local directory without creating or changing files.</summary>
<description>
Set _DirectoryPath and write _CheckRequested once. Read _DirectoryExists only when _Completed and _Succeeded
are TRUE. The task advances once per PLC cycle and preserves the result until the next accepted request.
Map this program to one dedicated cyclic task. The program performs cleanup for that task.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM CheckDirectoryExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
	_CheckDirectory : TOF_FileSystem.CheckDirectoryExists(name := "Check directory example");
	_DirectoryPath : Tc2_System.T_MaxString;
	_CheckRequested : BOOL;
	_Completed : BOOL;
	_Succeeded : BOOL;
	_DirectoryExists : BOOL;
	_StopMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _CheckRequested THEN
	_CheckRequested := FALSE;

	IF NOT _CheckDirectory.State.Running THEN
		_Completed := FALSE;
		_Succeeded := FALSE;
		_DirectoryExists := FALSE;
		_StopMessage := "";

		IF _DirectoryPath = '' THEN
			_StopMessage := "Set the directory path before requesting a check";
			_Completed := TRUE;
		ELSIF _CheckDirectory.Reset(refuseReason => _StopMessage) THEN
			_CheckDirectory.DirectoryPath := _DirectoryPath;
			_CheckDirectory.Timeout := T#2S;
			_Completed := NOT _CheckDirectory.Start(refuseReason => _StopMessage);
		ELSE
			_Completed := TRUE;
		END_IF
	END_IF
END_IF

IF _CheckDirectory.State.Running THEN
	_CheckDirectory.Execute();

	IF _CheckDirectory.State.Stopped THEN
		_Succeeded := _CheckDirectory.FinalStopReason.WorkDone;
		_DirectoryExists := _Succeeded AND_THEN _CheckDirectory.DirectoryExists;
		_StopMessage := _CheckDirectory.FinalStopReason.Message;
		_Completed := TRUE;
	END_IF
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
TOF_Core.DynamicMemoryManager.CleanupMemory();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{385e053f-46cf-47a9-b4ac-fc0b8b7c6db5}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized program name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0c061e15-81ff-48a8-8bc4-1c34120849b2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{fca50280-1ae7-4c49-8036-fbf5b53e2dbc}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized namespace name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fa22e902-5259-46d5-911a-0f3c38519fad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
