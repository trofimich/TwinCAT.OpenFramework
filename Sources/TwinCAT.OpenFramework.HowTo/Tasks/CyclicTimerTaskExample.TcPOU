<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CyclicTimerTaskExample" Id="{2dd776c1-a2c6-4729-a628-eac9f3ab4976}" SpecialFunc="None">
    <Declaration><![CDATA[(*
