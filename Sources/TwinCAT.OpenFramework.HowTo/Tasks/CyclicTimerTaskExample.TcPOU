(*!
<summary>Starts, advances, cancels and reuses a timer as a cyclic task.</summary>
<description>
Write _StartRequested or _CancelRequested once. A start while running is ignored. The timer advances once
per cycle and its final reason is copied when it stops. _Completed becomes TRUE on completion or start refusal.
Map this program to one dedicated cyclic task. The program performs cleanup for that task.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM CyclicTimerTaskExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
	_Timer : TOF_Timers.Timer(name := "Example timer");
	_StartRequested : BOOL;
	_CancelRequested : BOOL;
	_Interval : TIME := T#1S;
	_Completed : BOOL;
	_WorkDone : BOOL;
	_StopMessage : TOF_Core.ERROR_MESSAGE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _StartRequested THEN
	_StartRequested := FALSE;

	IF NOT _Timer.State.Running THEN
		_Completed := FALSE;
		_WorkDone := FALSE;
		_StopMessage := "";

		IF _Timer.Reset(refuseReason => _StopMessage) THEN
			_Timer.Interval := _Interval;
			_Completed := NOT _Timer.Start(refuseReason => _StopMessage);
		ELSE
			_Completed := TRUE;
		END_IF
	END_IF
END_IF

IF _CancelRequested THEN
	_CancelRequested := FALSE;

	IF _Timer.State.Running THEN
		_Timer.Cancel();
	END_IF
END_IF

IF _Timer.State.Running THEN
	_Timer.Execute();

	IF _Timer.State.Stopped THEN
		_WorkDone := _Timer.FinalStopReason.WorkDone;
		_StopMessage := _Timer.FinalStopReason.Message;
		_Completed := TRUE;
	END_IF
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
TOF_Core.DynamicMemoryManager.CleanupMemory();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{c40b26e6-7ce6-40b1-94b6-717058f89c62}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized program name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{5fd948f1-0e0d-49ae-9ce3-a97a5dafd7e0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{f2980349-9a4c-4a35-b523-adba768f5b06}">
      <Declaration><![CDATA[//! <summary>Borrows the initialized namespace name. Treat it as read-only.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fd4b56f3-3746-40fc-812f-2b55bb8c1e8f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
