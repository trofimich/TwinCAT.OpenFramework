<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ScaleAnalogInputExample" Id="{943fc5c5-20c8-408e-be36-6e9346a09026}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Scales a simulated signed 16-bit input to degrees Celsius.

Write _RawInput in Watch. The converter maps raw counts 0 to 20000 to a range of 0 to 100 degrees Celsius.
Read _TemperatureCelsius on the next scan. Values outside the raw range are clamped to the nearest
endpoint. The scale belongs to this example. Map the program to a dedicated cyclic task. No I/O links are needed.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM ScaleAnalogInputExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();

	_Converter : TOF_Devices_IO.StaticRangeAnalogValueConverter(
		minAnalogValue := 0.0,
		maxAnalogValue := 100.0,
		minRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 0),
		maxRawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := 20000)
	);
	_RawInput : INT := 5000;
	_TemperatureCelsius : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_TemperatureCelsius := _Converter.ConvertRawValueToAnalogValue(
	rawValue := TOF_Devices_IO.RawAnalogValues.FromInt16(value := _RawInput),
	rawValueType := TOF_Devices_IO.RAW_ANALOG_VALUE_TYPE.INT16
);

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
TOF_Core.DynamicMemoryManager.CleanupMemory();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{1b5e7cf1-215b-4798-8295-ecf6c00c04c0}">
      <Declaration><![CDATA[// Borrows the initialized program name. Treat it as read-only.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{cb6a3045-8cde-43ac-b695-a93ea82609ec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{982a1d6c-18a9-48b7-bf47-38991f69fdfc}">
      <Declaration><![CDATA[// Borrows the initialized namespace name. Treat it as read-only.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{90f00656-6f7f-491a-b44b-f86fb224e222}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>