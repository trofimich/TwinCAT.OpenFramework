<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="JsonConfigurationExample" Id="{3ae77843-7ee7-41c2-98d2-bab4a36a928f}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*
Round-trips an integer field through a JSON configuration document.

Edit _InputValue and write _RunRequested once. The reader and writer belong to this task. Read _OutputValue
only when _Succeeded is TRUE. A failed operation clears the visible document and exposes copied diagnostics.
Map this program to one dedicated cyclic task. The program performs cleanup for that task.
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM JsonConfigurationExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
	_RunRequested : BOOL;
	_InputValue : DINT := 42;
	_OutputValue : DINT;
	_Document : TOF_Core.JSON_DOCUMENT;
	_Writer : TOF_JSON.JsonConfigurationWriter;
	_Reader : TOF_JSON.JsonConfigurationReader;
	_Succeeded : BOOL;
	_Error : TOF_Core.ERROR;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _RunRequested THEN
	_RunRequested := FALSE;
	runRoundTrip();
END_IF

TOF_Core.DynamicMemoryManager.RaiseIfAllocationFailed();
TOF_Core.DynamicMemoryManager.CleanupMemory();]]></ST>
    </Implementation>
    <Method Name="runRoundTrip" Id="{39ceb5ab-ab29-48b5-be1f-c2e80178791f}">
      <Declaration><![CDATA[// Writes a fresh document and reads a field before its node expires.
METHOD PRIVATE runRoundTrip
VAR
	root : TOF_Core.CONFIGURATION_NODE;
	field : TOF_Core.CONFIGURATION_NODE;
	exceptionCode : __SYSTEM.ExceptionCode;
	caught : TOF_Core.IException;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Succeeded := FALSE;
_Error.Clear();
_Document := '';

__TRY
	_Writer.BeginDocument();
	_Writer.WriteValue(
		name := 'value',
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
		data := ADR(_InputValue),
		size := SIZEOF(_InputValue)
	);
	_Writer.EndDocument(document := _Document);

	root := _Reader.Parse(document := _Document);
	field := _Reader.GetField(node := root, name := 'value');
	_Reader.ReadValue(
		node := field,
		valueType := TOF_Core.CONFIGURATION_VALUE_TYPE.TYPE_DINT,
		data := ADR(_OutputValue),
		size := SIZEOF(_OutputValue)
	);
	_Succeeded := TRUE;
__CATCH(exceptionCode)
	_Document := '';
	caught := TOF_Core.ExceptionManager.GetLastException(
		exceptionCode := exceptionCode,
		catchPointNamespaceName := NamespaceName,
		catchPointPOUName := __POUNAME(),
		catchPointPosition := __POSITION()
	);
	caught.ToError(targetError := _Error, severity := TOF_Core.ERROR_SEVERITY.ERROR);
__ENDTRY]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{da1f8b8c-2ad8-4e80-89f8-3dc8e22c78e2}">
      <Declaration><![CDATA[// Borrows the initialized program name. Treat it as read-only.
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{da873c11-0ee6-46c4-9299-d18d0ab541b8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{c1a460ba-4251-45f3-96df-ed30ae2c422a}">
      <Declaration><![CDATA[// Borrows the initialized namespace name. Treat it as read-only.
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{0d0e7d8d-e250-44fd-93d5-f58a4a936d5a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
