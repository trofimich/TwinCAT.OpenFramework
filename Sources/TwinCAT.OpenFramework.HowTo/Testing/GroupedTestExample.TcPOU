<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="GroupedTestExample" Id="{a5344317-2cc6-457a-905b-ee9f58b2a693}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Runs a single-cycle and a multi-cycle test through nested sequential groups.</summary>
<description>
Map this program to one cyclic PLC task or call its Execute method once per cycle from that task.
The concrete runner owns the tests; the program owns the reporter and performs task
cleanup at the end of every scan. Inspect _Runner.IsFinished, AllPassed and counts, then _Report.IsReady.
For independent task execution, assign SingleCycleTestExample and MultiCycleTestExample to different tasks.
They share no instances or mutable buffers. Do not assign the same program instance to multiple tasks.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM GroupedTestExample
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();

	_Runner : BasicTestRunner;
	_Report : TOF_Testing.JUnitXmlReporter;
	_Configured : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Execute();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{2b8104d0-481f-4b86-ac47-c1b1c13c4c5d}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete program name for its lifetime; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{855d257b-31cb-49d1-98be-e9330d651e9f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{865d0f18-9f67-4895-a978-0e63f972906c}">
      <Declaration><![CDATA[(*!
<summary>Advances this example and performs standalone task-boundary memory cleanup.</summary>
<description>
Call once per cycle from the owning task, either through this method or by mapping this PROGRAM to that task.
Do not drive both entry paths or share the instance between tasks. Use as the standalone example in its task;
hosts with additional transient-exception consumers must provide a shared boundary instead.
</description>
*)
METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Configured THEN
	_Runner.Reporter := _Report;
	_Configured := TRUE;
END_IF

_Runner.Execute(cleanupTaskMemory := TRUE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{61775c89-8ecd-466f-be18-0660952ebd5c}">
      <Declaration><![CDATA[(*!
<summary>Provides the library namespace used in diagnostics.</summary>
<description>
Borrowed read-only reference to the compiler-initialized library namespace; no ownership transfer.
</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{36d21fbb-1a58-4573-928d-4d3d9dee237a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
