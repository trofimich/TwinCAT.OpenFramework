<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TimerDelayTest" Id="{cd433af5-d402-4ee8-9653-3926847fc34b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
SPDX-FileCopyrightText: © 2026 Oleksandr Tiutyk <trofimich@gmail.com>
SPDX-License-Identifier: MIT
License: https://opensource.org/license/mit
*)

(*!
<summary>Shows persistent state and explicit completion in a multi-cycle test.</summary>
<description>
The inherited one-second deadline bounds waiting for a twenty-millisecond timer.
</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
FUNCTION_BLOCK TimerDelayTest EXTENDS TOF_Testing.MultiCycleTest
VAR
	_Timer : Tc2_Standard.TON;
END_VAR
VAR_STAT
	//! <summary>Class name shared by all instances of this function block.</summary>
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR
VAR
	{attribute 'hide'}
	{attribute 'init_namespace'}
	_NamespaceName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AfterTest" Id="{a02925e1-ca3a-43ed-aa48-a1e77943db32}">
      <Declaration><![CDATA[(*!
<summary>Resets the timer after completion or failure.</summary>
*)
METHOD PROTECTED AfterTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer(IN := FALSE, PT := T#20MS);]]></ST>
      </Implementation>
    </Method>
    <Method Name="BeforeTest" Id="{1fffb62e-3ff8-4dab-bea5-2e1b700ea458}">
      <Declaration><![CDATA[(*!
<summary>Resets the timer before each run.</summary>
*)
METHOD PROTECTED BeforeTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer(IN := FALSE, PT := T#20MS);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ClassName" Id="{e1288ff1-f89f-4e4f-8572-1a2c2b3c2399}">
      <Declaration><![CDATA[//! <summary>Borrows the concrete class name for the lifetime of this instance; callers must not modify it.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{fd30ec40-82f2-46fd-b19a-41ead01746f5}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ExecuteTest" Id="{2d63cec9-66bb-42e7-9663-67955156f562}">
      <Declaration><![CDATA[(*!
<summary>Advances the timer once and completes after its delay.</summary>
*)
METHOD PROTECTED ExecuteTest]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Timer(IN := TRUE, PT := T#20MS);

IF _Timer.Q THEN
	Assert.ThatTime(actual := _Timer.ET).IsGreaterThanOrEquals(expected := T#20MS);
	Complete();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="NamespaceName" Id="{5acb7858-beb4-4c21-9cf1-c04ff08037e7}">
      <Declaration><![CDATA[//! <summary>Borrows the compiler-initialized namespace; callers must not modify the returned reference.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{e8fd79a6-aa2d-411b-8914-8623223ccac0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SelfSize" Id="{85250524-f16c-403c-a03f-bacf37110259}">
      <Declaration><![CDATA[//! <summary>Reports the complete concrete instance size, excluding separately allocated storage.</summary>
{attribute 'monitoring' := 'call'}
PROPERTY SelfSize : ULINT]]></Declaration>
      <Get Name="Get" Id="{533f8421-6453-4219-83ce-4e92f8ae4469}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelfSize := XSIZEOF(THIS^);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>