(*!
<summary>Runs the standalone single-cycle testing example through its explicit execution method.</summary>
<description>Mapped by PlcTask. Do not also map SingleCycleTestExample to a task while this entry is used.</description>
*)

{attribute 'no_explicit_call' := 'do not call this function block directly'}
PROGRAM MAIN
VAR
	{attribute 'hide'}
	_ClassName : STRING := __POUNAME();
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SingleCycleTestExample.Execute();]]></ST>
    </Implementation>
    <Property Name="ClassName" Id="{6d7c6616-4297-46b6-aa4a-1e73b2ca69f7}">
      <Declaration><![CDATA[(*!
<summary>Borrows the concrete program name for its lifetime.</summary>
<description>Borrowed read-only storage; callers must not modify it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY ClassName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{4eb4aea7-21a2-45ca-860e-c094ca9105d6}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClassName REF= _ClassName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NamespaceName" Id="{087a421e-7c23-4e22-bbb7-d0f04d268682}">
      <Declaration><![CDATA[(*!
<summary>Borrows the project namespace for the program lifetime.</summary>
<description>Borrowed read-only storage; callers must not modify it.</description>
*)
{attribute 'monitoring' := 'call'}
PROPERTY NamespaceName : REFERENCE TO STRING]]></Declaration>
      <Get Name="Get" Id="{300ec138-e024-492d-8f0f-5f185307c522}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NamespaceName REF= CurrentNamespace.Name;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
