<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{836b2867-dd37-46e9-a853-915ecc0f3ee4}" SpecialFunc="None">
    <Declaration><![CDATA[(*
