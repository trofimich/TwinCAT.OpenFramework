# Auto-detect text files and normalize line endings
* text=auto

# TwinCAT source files (require CRLF in working copy)
*.TcPOU text eol=crlf
*.TcDUT text eol=crlf
*.TcIO text eol=crlf
*.TcGVL text eol=crlf
*.TcGTLO text eol=crlf
*.TcIPO text eol=crlf
*.TcTTO text eol=crlf
*.TcVIS text eol=crlf
*.TcVMO text eol=crlf

# TwinCAT and Visual Studio project/solution files
*.plcproj text eol=crlf
*.tsproj text eol=crlf
*.sln text eol=crlf
*.xml text eol=crlf

# Documentation and text files
*.md text eol=crlf
*.txt text eol=crlf

# Binary files
*.library binary
*.compiled-library binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.odt binary
